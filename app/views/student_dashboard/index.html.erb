<!-- =====================================================
     FAST CLIENT-SIDE TAB JAVASCRIPT
====================================================== -->

<script nonce="<%= content_security_policy_nonce %>">

  (() => {

    const initializeStudentDashboard = () => {

      const tabs =
        document.querySelectorAll(
          "[data-dashboard-tab]"
        );

      const panels =
        document.querySelectorAll(
          "[data-dashboard-panel]"
        );

      if (!tabs.length || !panels.length) {
        return;
      }


      /*
       * TAB SWITCHING
       * Pure client-side.
       * No Rails request.
       * No page reload.
       */

      tabs.forEach((tab) => {

        if (tab.dataset.dashboardBound === "true") {
          return;
        }

        tab.dataset.dashboardBound = "true";


        tab.addEventListener("click", () => {

          const target =
            tab.dataset.dashboardTab;


          tabs.forEach((item) => {

            item.classList.toggle(
              "active",
              item === tab
            );

          });


          panels.forEach((panel) => {

            panel.classList.toggle(
              "active",
              panel.dataset.dashboardPanel === target
            );

          });


          /*
           * Remember selected tab.
           */

          try {

            sessionStorage.setItem(
              "student-dashboard-tab",
              target
            );

          } catch (error) {

            // Ignore storage errors.

          }

        });

      });


      /*
       * RESTORE LAST TAB
       */

      let savedTab = null;

      try {

        savedTab =
          sessionStorage.getItem(
            "student-dashboard-tab"
          );

      } catch (error) {

        savedTab = null;

      }


      if (savedTab) {

        const savedButton =
          document.querySelector(
            `[data-dashboard-tab="${savedTab}"]`
          );

        if (savedButton) {
          savedButton.click();
        }

      }


      /*
       * COUNTER ANIMATION
       */

      document
        .querySelectorAll(".student-counter")
        .forEach((counter) => {

          if (counter.dataset.counterAnimated === "true") {
            return;
          }

          counter.dataset.counterAnimated = "true";


          const target =
            Number(
              counter.dataset.count || 0
            );


          let current = 0;


          if (target <= 0) {

            counter.textContent = "0";

            return;

          }


          const duration = 700;

          const startTime =
            performance.now();


          const animateCounter =
            (currentTime) => {

              const elapsed =
                currentTime - startTime;

              const progress =
                Math.min(
                  elapsed / duration,
                  1
                );


              const eased =
                1 - Math.pow(
                  1 - progress,
                  3
                );


              current =
                Math.floor(
                  target * eased
                );


              counter.textContent =
                current.toLocaleString();


              if (progress < 1) {

                requestAnimationFrame(
                  animateCounter
                );

              } else {

                counter.textContent =
                  target.toLocaleString();

              }

            };


          requestAnimationFrame(
            animateCounter
          );

        });

    };


    /*
     * Normal page load
     */

    if (
      document.readyState === "loading"
    ) {

      document.addEventListener(
        "DOMContentLoaded",
        initializeStudentDashboard,
        { once: true }
      );

    } else {

      initializeStudentDashboard();

    }


    /*
     * Rails Turbo navigation
     */

    document.addEventListener(
      "turbo:load",
      initializeStudentDashboard
    );

  })();

</script>