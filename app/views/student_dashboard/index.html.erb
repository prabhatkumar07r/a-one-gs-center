<%# =========================================================
    STUDENT DASHBOARD
    app/views/student_dashboard/index.html.erb
========================================================= %>

<style>
  /* =========================================================
     DASHBOARD BASE
  ========================================================= */

  :root {
    --student-primary: #4f46e5;
    --student-primary-dark: #3730a3;
    --student-secondary: #7c3aed;
    --student-success: #10b981;
    --student-warning: #f59e0b;
    --student-danger: #ef4444;
    --student-heading: #111827;
    --student-text: #374151;
    --student-muted: #6b7280;
    --student-border: #e5e7eb;
    --student-bg: #f8fafc;
    --student-card: #ffffff;
  }

  .student-dashboard {
    max-width: 1400px;
    margin: 0 auto;
    padding: 24px 18px 50px;
    padding-top: 100px;
  }

  /* =========================================================
     WELCOME
  ========================================================= */

  .student-welcome {
    position: relative;
    overflow: hidden;
    padding: 28px;
    margin-bottom: 22px;
    border-radius: 22px;
    color: #fff;
    background:
      linear-gradient(
        135deg,
        var(--student-primary-dark),
        var(--student-primary),
        var(--student-secondary)
      );
    box-shadow: 0 14px 35px rgba(79, 70, 229, .18);
  }

  .student-welcome::after {
    content: "";
    position: absolute;
    width: 230px;
    height: 230px;
    right: -80px;
    top: -110px;
    border-radius: 50%;
    background: rgba(255,255,255,.08);
  }

  .student-welcome-content {
    position: relative;
    z-index: 2;
  }

  .student-welcome h1 {
    margin: 0 0 8px;
    font-size: clamp(23px, 4vw, 34px);
    font-weight: 800;
  }

  .student-welcome p {
    margin: 0;
    color: rgba(255,255,255,.88);
    font-size: 14px;
  }

  .student-welcome-user {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 15px;
    padding: 8px 13px;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 30px;
    background: rgba(255,255,255,.10);
    font-size: 12px;
    font-weight: 700;
  }

  /* =========================================================
     TAB NAVIGATION
  ========================================================= */

  .student-tabs-wrapper {
    position: sticky;
    top: 10px;
    z-index: 50;
    margin-bottom: 22px;
  }

  .student-tabs {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px;
    overflow-x: auto;
    border: 1px solid var(--student-border);
    border-radius: 15px;
    background: rgba(255,255,255,.96);
    box-shadow: 0 8px 25px rgba(15,23,42,.07);
    scrollbar-width: none;
  }

  .student-tabs::-webkit-scrollbar {
    display: none;
  }

  .student-tab {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 42px;
    padding: 0 16px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--student-muted);
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    transition:
      background .16s ease,
      color .16s ease,
      transform .16s ease;
  }

  .student-tab:hover {
    color: var(--student-primary);
    background: #f5f3ff;
  }

  .student-tab.active {
    color: #fff;
    background: linear-gradient(
      135deg,
      var(--student-primary),
      var(--student-secondary)
    );
    box-shadow: 0 5px 14px rgba(79,70,229,.22);
  }

  .student-tab:active {
    transform: scale(.97);
  }

  /* =========================================================
     TAB PANELS
  ========================================================= */

  .dashboard-tab-panel {
    display: none;
  }

  .dashboard-tab-panel.active {
    display: block;
    animation: studentTabIn .16s ease;
  }

  @keyframes studentTabIn {
    from {
      opacity: .65;
      transform: translateY(3px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =========================================================
     SECTION
  ========================================================= */

  .student-section {
    margin-bottom: 25px;
  }

  .student-section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 13px;
  }

  .student-section-heading h2 {
    margin: 0;
    color: var(--student-heading);
    font-size: 18px;
    font-weight: 800;
  }

  .student-section-heading a {
    color: var(--student-primary);
    font-size: 11px;
    font-weight: 800;
    text-decoration: none;
  }

  .student-section-heading a:hover {
    text-decoration: underline;
  }

  /* =========================================================
     STATISTICS
  ========================================================= */

  .student-stat-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 25px;
  }

  .student-stat-card {
    padding: 17px;
    border: 1px solid var(--student-border);
    border-radius: 16px;
    background: var(--student-card);
    box-shadow: 0 7px 23px rgba(15,23,42,.055);
  }

  .student-stat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    margin-bottom: 11px;
    border-radius: 10px;
    color: var(--student-primary);
    background: #eef2ff;
    font-size: 17px;
  }

  .student-stat-card h6 {
    margin: 0 0 4px;
    color: var(--student-muted);
    font-size: 10px;
    font-weight: 700;
  }

  .student-stat-card h3 {
    margin: 0;
    color: var(--student-heading);
    font-size: 25px;
    font-weight: 850;
  }

  /* =========================================================
     MAIN GRID
  ========================================================= */

  .student-main-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 20px;
  }

  .student-card {
    margin-bottom: 20px;
    padding: 20px;
    border: 1px solid var(--student-border);
    border-radius: 17px;
    background: var(--student-card);
    box-shadow: 0 7px 23px rgba(15,23,42,.055);
  }

  .student-card:last-child {
    margin-bottom: 0;
  }

  /* =========================================================
     CONTINUE LEARNING
  ========================================================= */

  .continue-learning-card {
    padding: 20px;
    border-radius: 17px;
    color: #fff;
    background:
      linear-gradient(
        135deg,
        #312e81,
        #4f46e5,
        #7c3aed
      );
    box-shadow: 0 12px 30px rgba(79,70,229,.17);
  }

  .continue-learning-card h3 {
    margin: 0 0 7px;
    font-size: 17px;
    font-weight: 800;
  }

  .continue-learning-card p {
    margin: 0 0 15px;
    color: rgba(255,255,255,.82);
    font-size: 12px;
  }

  .continue-learning-card .btn {
    border: 0;
    background: #fff;
    color: var(--student-primary-dark);
    font-weight: 800;
  }

  /* =========================================================
     COURSE GRID
  ========================================================= */

  .course-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
  }

  .course-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 17px;
    border: 1px solid var(--student-border);
    border-radius: 15px;
    background: #fff;
    transition:
      transform .18s ease,
      box-shadow .18s ease;
  }

  .course-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(79,70,229,.10);
  }

  .course-card h4 {
    margin: 0 0 8px;
    color: var(--student-heading);
    font-size: 14px;
    font-weight: 800;
    line-height: 1.4;
  }

  .course-card p {
    margin: 0 0 13px;
    color: var(--student-muted);
    font-size: 10px;
  }

  .course-progress {
    margin-bottom: 14px;
  }

  .course-progress-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 6px;
    color: var(--student-muted);
    font-size: 9px;
    font-weight: 700;
  }

  .course-progress-bar {
    width: 100%;
    height: 6px;
    overflow: hidden;
    border-radius: 10px;
    background: #e5e7eb;
  }

  .course-progress-fill {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      var(--student-primary),
      var(--student-secondary)
    );
  }

  .course-card-actions {
    margin-top: auto;
    display: flex;
    gap: 7px;
  }

  .course-card-actions .btn {
    flex: 1;
    min-height: 36px;
    font-size: 10px;
    font-weight: 700;
  }

  /* =========================================================
     TEST SERIES
  ========================================================= */

  .test-series-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
  }

  .test-series-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 17px;
    border: 1px solid var(--student-border);
    border-radius: 15px;
    background: #fff;
    transition:
      transform .18s ease,
      box-shadow .18s ease;
  }

  .test-series-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(79,70,229,.10);
  }

  .test-series-card h4 {
    margin: 0 0 8px;
    color: var(--student-heading);
    font-size: 14px;
    font-weight: 800;
  }

  .test-series-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 13px;
  }

  .test-series-meta span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 8px;
    border-radius: 20px;
    background: #f3f4f6;
    color: var(--student-muted);
    font-size: 9px;
    font-weight: 700;
  }

  .test-series-card p {
    margin: 0 0 14px;
    color: var(--student-muted);
    font-size: 10px;
  }

  .test-series-actions {
    margin-top: auto;
    display: flex;
    gap: 7px;
  }

  .test-series-actions .btn {
    flex: 1;
    min-height: 36px;
    font-size: 10px;
    font-weight: 700;
  }

  /* =========================================================
     E-BOOKS
  ========================================================= */

  .ebook-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .ebook-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--student-border);
    border-radius: 17px;
    background: #fff;
    box-shadow: 0 7px 23px rgba(15,23,42,.055);
    transition:
      transform .2s ease,
      box-shadow .2s ease;
  }

  .ebook-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(79,70,229,.12);
  }

  .ebook-cover {
    position: relative;
    height: 180px;
    overflow: hidden;
    background: linear-gradient(
      135deg,
      #312e81,
      #7c3aed
    );
  }

  .ebook-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .35s ease;
  }

  .ebook-card:hover .ebook-cover img {
    transform: scale(1.04);
  }

  .ebook-cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #fff;
    font-size: 48px;
  }

  .ebook-purchased-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 9px;
    border-radius: 20px;
    background: rgba(16,185,129,.95);
    color: #fff;
    font-size: 9px;
    font-weight: 800;
  }

  .ebook-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 16px;
  }

  .ebook-body h4 {
    margin: 0 0 7px;
    color: var(--student-heading);
    font-size: 14px;
    font-weight: 800;
    line-height: 1.4;
  }

  .ebook-meta {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 14px;
    color: var(--student-muted);
    font-size: 10px;
  }

  .ebook-actions {
    margin-top: auto;
    display: flex;
    gap: 8px;
  }

  .ebook-actions .btn {
    width: 100%;
    min-height: 37px;
    border-radius: 8px;
    font-size: 10px;
    font-weight: 700;
  }

  /* =========================================================
     RESOURCES
  ========================================================= */

  .resource-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resource-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--student-border);
  }

  .resource-item:last-child {
    border-bottom: 0;
  }

  .resource-info {
    min-width: 0;
  }

  .resource-info strong {
    display: block;
    overflow: hidden;
    color: var(--student-heading);
    font-size: 12px;
    font-weight: 750;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .resource-info small {
    color: var(--student-muted);
    font-size: 9px;
  }

  /* =========================================================
     NOTIFICATIONS
  ========================================================= */

  .notification-item {
    display: flex;
    gap: 11px;
    padding: 12px 0;
    border-bottom: 1px solid var(--student-border);
  }

  .notification-item:last-child {
    border-bottom: 0;
  }

  .notification-icon {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    color: var(--student-primary);
    background: #eef2ff;
  }

  .notification-content {
    min-width: 0;
  }

  .notification-content strong {
    display: block;
    color: var(--student-heading);
    font-size: 11px;
    font-weight: 800;
  }

  .notification-content p {
    margin: 3px 0 0;
    color: var(--student-muted);
    font-size: 10px;
  }

  /* =========================================================
     PROFILE
  ========================================================= */

  .profile-card {
    text-align: center;
  }

  .profile-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 75px;
    height: 75px;
    margin: 0 auto 12px;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(
      135deg,
      var(--student-primary),
      var(--student-secondary)
    );
    font-size: 30px;
  }

  .profile-card h3 {
    margin: 0 0 4px;
    color: var(--student-heading);
    font-size: 16px;
    font-weight: 800;
  }

  .profile-card p {
    margin: 0 0 15px;
    color: var(--student-muted);
    font-size: 10px;
    word-break: break-word;
  }

  /* =========================================================
     EMPTY STATE
  ========================================================= */

  .student-empty {
    padding: 35px 15px;
    text-align: center;
  }

  .student-empty-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    margin: 0 auto 12px;
    border-radius: 50%;
    color: var(--student-primary);
    background: #eef2ff;
    font-size: 25px;
  }

  .student-empty p {
    margin: 0 0 14px;
    color: var(--student-muted);
    font-size: 12px;
  }

  /* =========================================================
     QUICK ACTIONS
  ========================================================= */

  .quick-actions {
    display: grid;
    gap: 9px;
  }

  .quick-action {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px 12px;
    border: 1px solid var(--student-border);
    border-radius: 10px;
    color: var(--student-heading);
    background: #fff;
    text-decoration: none;
    font-size: 10px;
    font-weight: 750;
    transition: .16s ease;
  }

  .quick-action:hover {
    color: var(--student-primary);
    border-color: #c7d2fe;
    background: #f5f3ff;
  }

  .quick-action i {
    color: var(--student-primary);
    font-size: 15px;
  }

  /* =========================================================
     PROGRESS
  ========================================================= */

  .progress-item {
    margin-bottom: 14px;
  }

  .progress-item:last-child {
    margin-bottom: 0;
  }

  .progress-item-top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 5px;
    font-size: 9px;
    color: var(--student-muted);
    font-weight: 700;
  }

  .progress-track {
    height: 6px;
    overflow: hidden;
    border-radius: 10px;
    background: #e5e7eb;
  }

  .progress-value {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      var(--student-primary),
      var(--student-secondary)
    );
  }

  /* =========================================================
     MOBILE
  ========================================================= */

  @media (max-width: 1200px) {
    .student-stat-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 1000px) {
    .student-main-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .student-dashboard {
      padding: 16px 12px 35px;
    }

    .student-welcome {
      padding: 22px 18px;
      border-radius: 17px;
    }

    .student-stat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .course-grid,
    .test-series-grid,
    .ebook-grid {
      grid-template-columns: 1fr;
    }

    .student-tabs-wrapper {
      top: 5px;
    }

    .student-tab {
      min-height: 39px;
      padding: 0 12px;
      font-size: 10px;
    }
  }

  @media (max-width: 430px) {
    .student-stat-grid {
      grid-template-columns: 1fr;
    }

    .course-card-actions,
    .test-series-actions,
    .ebook-actions {
      flex-direction: column;
    }

    .student-section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 5px;
    }
  }


  /* =========================
   E-BOOK CARD
   CARD FITS COVER
   ========================= */

.student-ebook-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  align-items: flex-start;
}

.student-ebook-card {
  display: inline-block;
  width: fit-content;
  max-width: 100%;
  overflow: hidden;

  background: #fff;
  border-radius: 18px;

  box-shadow: 0 12px 30px rgba(45, 55, 100, 0.10);
}

/* Cover controls the card width */
.student-ebook-cover {
  position: relative;
  display: block;
  width: fit-content;
  max-width: 100%;
  overflow: hidden;
  background: #f1f3f8;
}

.student-ebook-cover img {
  display: block;

  /* Image keeps its original aspect ratio */
  width: auto;
  height: auto;

  /* Don't become larger than the screen */
  max-width: 100%;
  max-height: 320px;

  object-fit: contain;
}

/* Purchased badge */
.student-ebook-badge {
  position: absolute;
  top: 12px;
  right: 12px;

  padding: 7px 11px;
  border-radius: 999px;

  background: #20c997;
  color: #fff;

  font-size: 11px;
  font-weight: 700;
}

/* Body follows the cover width */
.student-ebook-body {
  width: 100%;
  box-sizing: border-box;
  padding: 14px 16px 16px;
}

.student-ebook-title {
  margin: 0 0 7px;

  font-size: 18px;
  font-weight: 800;
  color: #111827;
}

.student-ebook-date {
  margin: 0 0 14px;

  color: #667085;
  font-size: 13px;
}

/* Read button */
.student-ebook-button {
  width: 100%;
  min-height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  border-radius: 10px;

  background: linear-gradient(90deg, #6d16d9, #286df5);
  color: #fff;

  text-decoration: none;
  font-size: 13px;
  font-weight: 700;

  box-sizing: border-box;
}

.student-ebook-button:hover {
  color: #fff;
  transform: translateY(-1px);
}


/* =========================
   MOBILE
   ========================= */

@media (max-width: 700px) {

  .student-ebook-grid {
    display: block;
  }

  .student-ebook-card {
    width: 100%;
    max-width: 100%;
  }

  .student-ebook-cover {
    width: 100%;
  }

  .student-ebook-cover img {
    width: 100%;
    height: auto;
    max-height: none;
  }
}
</style>





<div class="student-dashboard">

  <!-- =====================================================
       WELCOME
  ====================================================== -->

  <section class="student-welcome">

    <div class="student-welcome-content">

      <h1>
        Welcome,
        <%= current_user.name.presence || current_user.email %> 👋
      </h1>

      <p>
        Continue your learning journey and access everything you have purchased.
      </p>

      <div class="student-welcome-user">
        <i class="bi bi-person-circle"></i>

        <%= current_user.email %>
      </div>

    </div>

  </section>


  <!-- =====================================================
       FAST DASHBOARD TABS
  ====================================================== -->

  <div class="student-tabs-wrapper">

    <nav
      class="student-tabs"
      aria-label="Student Dashboard Navigation">

      <!-- OVERVIEW -->

      <button
        type="button"
        class="student-tab active"
        data-dashboard-tab="overview">

        <i class="bi bi-grid-1x2-fill"></i>

        Overview

      </button>


      <!-- COURSES -->

      <button
        type="button"
        class="student-tab"
        data-dashboard-tab="courses">

        <i class="bi bi-mortarboard-fill"></i>

        My Courses

        <span>
          (<%= @courses.count %>)
        </span>

      </button>


      <!-- TEST SERIES -->

      <button
        type="button"
        class="student-tab"
        data-dashboard-tab="test-series">

        <i class="bi bi-journal-check"></i>

        Test Series

        <span>
          (<%= @test_series_purchases.count %>)
        </span>

      </button>


      <!-- E-BOOKS -->

      <button
        type="button"
        class="student-tab"
        data-dashboard-tab="ebooks">

        <i class="bi bi-book-half"></i>

