<%# =========================================================
    RESOURCE FORM
========================================================= %>

<style nonce="<%= content_security_policy_nonce %>">

.resource-form-page,
.resource-form-page * {
  box-sizing: border-box;
}

.resource-form-page {
  --rf-bg-1: #f5f3ff;
  --rf-bg-2: #ebe7ff;
  --rf-text: #18152c;
  --rf-muted: #716b83;
  --rf-card: rgba(255,255,255,.66);
  --rf-border: rgba(255,255,255,.75);
  --rf-primary: #7c3aed;
  --rf-primary-dark: #5b21b6;
  --rf-shadow: 0 25px 70px rgba(76,48,150,.16);

  min-height: 100vh;
  padding: 35px 20px 70px;

  position: relative;
  overflow: hidden;

  color: var(--rf-text);

  background:
    radial-gradient(
      circle at 10% 10%,
      rgba(124,58,237,.17),
      transparent 28%
    ),
    radial-gradient(
      circle at 90% 80%,
      rgba(37,99,235,.12),
      transparent 28%
    ),
    linear-gradient(
      135deg,
      var(--rf-bg-1),
      var(--rf-bg-2)
    );

  transition:
    background .35s ease,
    color .35s ease;
}

/* =========================================================
   NIGHT
========================================================= */

.resource-form-page.night-mode {
  --rf-bg-1: #080611;
  --rf-bg-2: #17112a;
  --rf-text: #f8f5ff;
  --rf-muted: #aaa3bd;
  --rf-card: rgba(28,23,48,.72);
  --rf-border: rgba(255,255,255,.10);
  --rf-primary: #a78bfa;
  --rf-primary-dark: #8b5cf6;
  --rf-shadow: 0 30px 90px rgba(0,0,0,.48);

  background:
    radial-gradient(
      circle at 10% 10%,
      rgba(124,58,237,.25),
      transparent 28%
    ),
    radial-gradient(
      circle at 90% 80%,
      rgba(59,130,246,.15),
      transparent 28%
    ),
    linear-gradient(
      135deg,
      var(--rf-bg-1),
      var(--rf-bg-2)
    );
}

/* =========================================================
   FLOATING OBJECTS
========================================================= */

.resource-form-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(2px);
}

.resource-form-orb.one {
  width: 280px;
  height: 280px;
  top: 80px;
  left: -120px;
  background: rgba(124,58,237,.12);
}

.resource-form-orb.two {
  width: 350px;
  height: 350px;
  right: -160px;
  bottom: 20px;
  background: rgba(59,130,246,.09);
}

.resource-form-floating {
  position: absolute;
  z-index: 1;

  opacity: .20;

  font-size: 55px;

  pointer-events: none;

  animation:
    resourceFormFloat
    6s
    ease-in-out
    infinite;
}

.resource-form-floating.one {
  top: 150px;
  left: 5%;
}

.resource-form-floating.two {
  top: 370px;
  right: 5%;
  animation-delay: 2s;
}

.resource-form-floating.three {
  bottom: 90px;
  left: 8%;
  animation-delay: 4s;
}

@keyframes resourceFormFloat {

  0%,100% {
    transform:
      translateY(0)
      rotate(-4deg);
  }

  50% {
    transform:
      translateY(-18px)
      rotate(5deg);
  }

}

/* =========================================================
   CONTAINER
========================================================= */

.resource-form-container {
  width: min(850px, 100%);
  margin: auto;

  position: relative;
  z-index: 3;
}

/* =========================================================
   TOP BAR
========================================================= */

.resource-form-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  margin-bottom: 20px;
}

.resource-form-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.resource-form-brand-icon {
  width: 50px;
  height: 50px;

  border-radius: 16px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 24px;

  background: var(--rf-card);

  border: 1px solid var(--rf-border);

  box-shadow:
    8px 8px 22px rgba(60,40,110,.14),
    inset 1px 1px 0 rgba(255,255,255,.5);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.resource-form-brand-title {
  font-size: 13px;
  font-weight: 900;
  letter-spacing: .12em;
}

.resource-form-brand-subtitle {
  margin-top: 3px;

  color: var(--rf-muted);

  font-size: 11px;
}

/* =========================================================
   THEME BUTTON
========================================================= */

.resource-form-theme {
  border: 1px solid var(--rf-border);

  background: var(--rf-card);

  color: var(--rf-text);

  height: 45px;
  min-width: 105px;

  border-radius: 999px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 5px 7px;

  cursor: pointer;

  box-shadow:
    0 12px 30px rgba(50,30,100,.13),
    inset 0 1px 0 rgba(255,255,255,.35);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.resource-form-theme-icon {
  width: 33px;
  height: 33px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: var(--rf-primary);

  color: white;

  box-shadow:
    0 6px 18px rgba(124,58,237,.30);
}

.resource-form-theme-label {
  font-size: 11px;
  font-weight: 800;
  padding-right: 6px;
}

/* =========================================================
   MAIN GLASS CARD
========================================================= */

.resource-form-card {
  padding: 34px;

  border-radius: 30px;

  background: var(--rf-card);

  border: 1px solid var(--rf-border);

  box-shadow: var(--rf-shadow);

  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);

  position: relative;

  overflow: hidden;
}

.resource-form-card::before {
  content: "";

  position: absolute;

  width: 230px;
  height: 230px;

  right: -100px;
  top: -110px;

  border-radius: 50%;

  background: rgba(124,58,237,.12);
}

.resource-form-content {
  position: relative;
  z-index: 2;
}

/* =========================================================
   HEADER
========================================================= */

.resource-form-header {
  margin-bottom: 28px;
}

.resource-form-kicker {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  color: var(--rf-primary);

  font-size: 10px;
  font-weight: 900;

  letter-spacing: .15em;

  text-transform: uppercase;

  margin-bottom: 9px;
}

.resource-form-header h1 {
  margin: 0;

  font-size: clamp(27px, 5vw, 40px);

  line-height: 1.1;

  font-weight: 900;

  letter-spacing: -.04em;
}

.resource-form-header p {
  color: var(--rf-muted);

  margin: 10px 0 0;

  font-size: 13px;

  line-height: 1.7;
}

/* =========================================================
   BREADCRUMB
========================================================= */

.resource-form-breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 7px;

  margin-top: 18px;

  font-size: 12px;

  color: var(--rf-muted);
}

.resource-form-breadcrumb strong {
  color: var(--rf-text);
}

.resource-form-arrow {
  opacity: .45;
}

/* =========================================================
   ERROR BOX
========================================================= */

.resource-form-errors {
  margin-bottom: 22px;

  padding: 15px 17px;

  border-radius: 17px;

  background: rgba(220,38,38,.08);

  border: 1px solid rgba(220,38,38,.18);

  color: #dc2626;

  font-size: 13px;
}

.resource-form-errors-title {
  font-weight: 900;
  margin-bottom: 7px;
}

.resource-form-errors ul {
  margin: 0;
  padding-left: 20px;
}

/* =========================================================
   FORM GROUP
========================================================= */

.resource-form-group {
  margin-bottom: 21px;
}

.resource-form-label {
  display: block;

  margin-bottom: 8px;

  font-size: 11px;

  font-weight: 900;

  letter-spacing: .08em;

  text-transform: uppercase;

  color: var(--rf-muted);
}

.resource-form-input,
.resource-form-select,
.resource-form-textarea {

  width: 100%;

  border: 1px solid var(--rf-border);

  border-radius: 16px;

  padding: 13px 15px;

  color: var(--rf-text);

  background: rgba(255,255,255,.34);

  box-shadow:
    inset 2px 2px 7px rgba(50,30,100,.05),
    0 7px 18px rgba(50,30,100,.05);

  outline: none;

  transition:
    border-color .2s ease,
    box-shadow .2s ease,
    transform .2s ease;
}

.night-mode .resource-form-input,
.night-mode .resource-form-select,
.night-mode .resource-form-textarea {
  background: rgba(255,255,255,.045);
}

.resource-form-input:focus,
.resource-form-select:focus,
.resource-form-textarea:focus {

  border-color: var(--rf-primary);

  box-shadow:
    0 0 0 4px rgba(124,58,237,.11),
    inset 2px 2px 7px rgba(50,30,100,.05);

  transform: translateY(-1px);
}

.resource-form-textarea {
  min-height: 125px;
  resize: vertical;
}

.resource-form-select {
  appearance: auto;
}

/* =========================================================
   FILE UPLOAD
========================================================= */

.resource-file-box {
  position: relative;

  padding: 25px 20px;

  border-radius: 21px;

  border: 1.5px dashed rgba(124,58,237,.35);

  background:
    linear-gradient(
      145deg,
      rgba(124,58,237,.07),
      rgba(255,255,255,.12)
    );

  text-align: center;

  transition:
    border-color .2s ease,
    transform .2s ease;
}

.night-mode .resource-file-box {
  background: rgba(124,58,237,.055);
}

.resource-file-box:hover {
  border-color: var(--rf-primary);
  transform: translateY(-2px);
}

.resource-file-icon {
  width: 55px;
  height: 55px;

  margin: 0 auto 10px;

  border-radius: 17px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 27px;

  background: rgba(124,58,237,.12);

  box-shadow:
    7px 7px 17px rgba(60,40,110,.10),
    inset 1px 1px 0 rgba(255,255,255,.45);
}

.resource-file-title {
  font-size: 14px;
  font-weight: 900;
}

.resource-file-help {
  margin: 5px 0 14px;

  color: var(--rf-muted);

  font-size: 11px;
}

.resource-file-input {
  display: block;

  width: 100%;

  font-size: 12px;

  color: var(--rf-muted);
}

.resource-file-input::file-selector-button {
  margin-right: 10px;

  padding: 9px 13px;

  border: none;

  border-radius: 10px;

  background: var(--rf-primary);

  color: white;

  font-weight: 800;

  cursor: pointer;
}

/* =========================================================
   BUTTONS
========================================================= */

.resource-form-actions {
  display: flex;

  gap: 11px;

  margin-top: 27px;

  padding-top: 22px;

  border-top: 1px solid var(--rf-border);
}

.resource-submit,
.resource-back {
  min-height: 46px;

  padding: 11px 20px;

  border-radius: 14px;

  font-size: 13px;

  font-weight: 850;

  text-decoration: none;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  cursor: pointer;

  transition:
    transform .2s ease,
    box-shadow .2s ease;
}

.resource-submit {
  border: none;

  color: white;

  background:
    linear-gradient(
      135deg,
      #8b5cf6,
      #6d28d9
    );

  box-shadow:
    0 12px 28px rgba(109,40,217,.27),
    inset 0 1px 0 rgba(255,255,255,.25);
}

.resource-back {
  border: 1px solid var(--rf-border);

  color: var(--rf-text);

  background: rgba(255,255,255,.20);

  box-shadow:
    0 8px 20px rgba(50,30,100,.07);
}

.night-mode .resource-back {
  background: rgba(255,255,255,.045);
}

.resource-submit:hover,
.resource-back:hover {
  transform: translateY(-2px);
}

.resource-submit:hover {
  color: white;

  box-shadow:
    0 17px 35px rgba(109,40,217,.35);
}

.resource-back:hover {
  color: var(--rf-primary);
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {

  .resource-form-page {
    padding: 20px 13px 45px;
  }

  .resource-form-card {
    padding: 24px 17px;
    border-radius: 23px;
  }

  .resource-form-topbar {
    align-items: flex-start;
  }

  .resource-form-brand-icon {
    width: 44px;
    height: 44px;
  }

  .resource-form-theme {
    min-width: 92px;
  }

  .resource-form-actions {
    flex-direction: column;
  }

  .resource-submit,
  .resource-back {
    width: 100%;
  }

}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

  .resource-form-floating {
    animation: none;
  }

}

</style>


<div
  class="resource-form-page"
  id="resourceFormPage"
>

  <!-- Floating objects -->

  <div class="resource-form-orb one"></div>
  <div class="resource-form-orb two"></div>

  <div class="resource-form-floating one">
    📚
  </div>

  <div class="resource-form-floating two">
    📄
  </div>

  <div class="resource-form-floating three">
    💾
  </div>


  <div class="resource-form-container">

    <!-- =====================================================
         TOP BAR
    ====================================================== -->

    <div class="resource-form-topbar">

      <div class="resource-form-brand">

        <div class="resource-form-brand-icon">
          📚
        </div>

        <div>

          <div class="resource-form-brand-title">
            A ONE GS CENTER
          </div>

          <div class="resource-form-brand-subtitle">
            Learning Resource Manager
          </div>

        </div>

      </div>


      <!-- DAY / NIGHT -->

      <button
        type="button"
        id="resourceFormTheme"
        class="resource-form-theme"
        aria-label="Toggle day and night mode"
      >

        <span
          class="resource-form-theme-icon"
          id="resourceFormThemeIcon"
        >
          ☀️
        </span>

        <span
          class="resource-form-theme-label"
          id="resourceFormThemeLabel"
        >
          Day
        </span>

      </button>

    </div>


    <!-- =====================================================
         CARD
    ====================================================== -->

    <div class="resource-form-card">

      <div class="resource-form-content">

        <!-- HEADER -->

        <div class="resource-form-header">

          <div class="resource-form-kicker">
            <span>✦</span>
            STUDY MATERIAL
          </div>


          <h1>
            <%= @resource.new_record? ?
                  "Add New Resource" :
                  "Edit Resource" %>
          </h1>


          <p>
            Upload and manage learning material for this
            playlist.
          </p>


          <!-- Breadcrumb -->

          <div class="resource-form-breadcrumb">

            <span>
              Course
            </span>

            <span class="resource-form-arrow">
              →
            </span>

            <strong>
              <%= @course.Course_name %>
            </strong>

            <span class="resource-form-arrow">
              →
            </span>

            <span>
              Playlist
            </span>

            <span class="resource-form-arrow">
              →
            </span>

            <strong>
              <%= @playlist.title %>
            </strong>

          </div>

        </div>


        <!-- =================================================
             FORM
        ================================================== -->

        <%= form_with(
              model: [@course, @playlist, @resource],
              local: true,
              multipart: true
            ) do |form| %>


          <!-- ERRORS -->

          <% if @resource.errors.any? %>

            <div class="resource-form-errors">

              <div class="resource-form-errors-title">
                ⚠ Please correct the following:
              </div>

              <ul>

                <% @resource.errors.full_messages.each do |message| %>

                  <li>
                    <%= message %>
                  </li>

                <% end %>

              </ul>

            </div>

          <% end %>


          <!-- TITLE -->

          <div class="resource-form-group">

            <%= form.label(
                  :title,
                  "Resource Title",
                  class: "resource-form-label"
                ) %>

            <%= form.text_field(
                  :title,
                  class: "resource-form-input",
                  placeholder: "Example: Indian Polity Chapter 1 Notes",
                  required: true
                ) %>

          </div>


          <!-- DESCRIPTION -->

          <div class="resource-form-group">

            <%= form.label(
                  :description,
                  "Description",
                  class: "resource-form-label"
                ) %>

            <%= form.text_area(
                  :description,
                  rows: 5,
                  class: "resource-form-textarea",
                  placeholder: "Write a short description about this resource..."
                ) %>

          </div>


          <!-- RESOURCE TYPE -->

          <div class="resource-form-group">

            <%= form.label(
                  :resource_type,
                  "Resource Type",
                  class: "resource-form-label"
                ) %>

            <%= form.select(
                  :resource_type,
                  Resource.resource_types.keys.map do |type|
                    [
                      case type
                      when "pdf"
                        "📕 PDF"
                      when "assignment"
                        "📝 Assignment"
                      when "ppt"
                        "📊 PowerPoint"
                      when "zip_file"
                        "🗜 ZIP File"
                      else
                        type.upcase
                      end,
                      type
                    ]
                  end,
                  {},
                  class: "resource-form-select",
                  required: true
                ) %>

          </div>


          <!-- FILE -->

          <div class="resource-form-group">

            <label class="resource-form-label">
              Resource File
            </label>


            <div class="resource-file-box">

              <div class="resource-file-icon">
                📤
              </div>


              <div class="resource-file-title">
                Upload Learning Material
              </div>


              <div class="resource-file-help">
                PDF, PPT, Assignment or ZIP file
              </div>


              <%= form.file_field(
                    :file,
                    class: "resource-file-input",
                    required: @resource.new_record?
                  ) %>

            </div>

          </div>


          <!-- ACTIONS -->

          <div class="resource-form-actions">

            <%= form.submit(
                  @resource.new_record? ?
                    "🚀 Upload Resource" :
                    "💾 Update Resource",
                  class: "resource-submit"
                ) %>


            <%= link_to(
                  "← Back to Resources",
                  course_playlist_resources_path(
                    @course,
                    @playlist
                  ),
                  class: "resource-back"
                ) %>

          </div>


        <% end %>

      </div>

    </div>

  </div>

</div>


<script nonce="<%= content_security_policy_nonce %>">

(function () {

  function initializeResourceFormTheme() {

    const page =
      document.getElementById(
        "resourceFormPage"
      );

    const toggle =
      document.getElementById(
        "resourceFormTheme"
      );

    const icon =
      document.getElementById(
        "resourceFormThemeIcon"
      );

    const label =
      document.getElementById(
        "resourceFormThemeLabel"
      );


    if (
      !page ||
      !toggle ||
      !icon ||
      !label
    ) {
      return;
    }


    if (
      page.dataset.themeInitialized ===
      "true"
    ) {
      return;
    }


    page.dataset.themeInitialized =
      "true";


    function applyTheme(theme) {

      if (theme === "night") {

        page.classList.add(
          "night-mode"
        );

        icon.textContent = "🌙";
        label.textContent = "Night";

      } else {

        page.classList.remove(
          "night-mode"
        );

        icon.textContent = "☀️";
        label.textContent = "Day";

      }

    }


    let savedTheme =
      localStorage.getItem(
        "aone_resource_theme"
      );


    if (
      savedTheme !== "day" &&
      savedTheme !== "night"
    ) {

      savedTheme = "day";

    }


    applyTheme(savedTheme);


    toggle.addEventListener(
      "click",
      function () {

        const currentIsNight =
          page.classList.contains(
            "night-mode"
          );


        const newTheme =
          currentIsNight
            ? "day"
            : "night";


        localStorage.setItem(
          "aone_resource_theme",
          newTheme
        );


        applyTheme(newTheme);

      }
    );

  }


  document.addEventListener(
    "turbo:load",
    initializeResourceFormTheme
  );


  document.addEventListener(
    "DOMContentLoaded",
    initializeResourceFormTheme
  );

})();

</script>