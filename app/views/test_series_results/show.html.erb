<%# ============================================================
    TEST SERIES RESULT PAGE
============================================================ %>

<% total_questions = @test.test_series_questions.count %>

<% answered_count =
     @attempt.test_series_answers.count %>

<% correct_count =
     @attempt.test_series_answers
             .where(is_correct: true)
             .count %>

<% incorrect_count =
     @attempt.test_series_answers
             .where(is_correct: false)
             .count %>

<% unanswered_count =
     [total_questions - answered_count, 0].max %>

<% obtained_marks =
     @attempt.test_series_answers
             .sum(:marks_obtained)
             .to_f %>

<% total_marks =
     @test.test_series_questions
          .sum(:marks)
          .to_f %>

<% percentage =
     if total_marks > 0
       ((obtained_marks / total_marks) * 100).round(2)
     else
       0
     end %>

<% accuracy =
     if answered_count > 0
       ((correct_count.to_f / answered_count) * 100).round(2)
     else
       0
     end %>

<% result_class =
     if percentage >= 80
       "excellent"
     elsif percentage >= 60
       "good"
     elsif percentage >= 40
       "average"
     else
       "poor"
     end %>

<% result_message =
     case result_class
     when "excellent"
       "Excellent Performance!"
     when "good"
       "Great Job!"
     when "average"
       "Good Attempt!"
     else
       "Keep Practicing!"
     end %>


<style>

/* =========================================================
   RESULT PAGE
========================================================= */

.test-result-page {
  min-height: 100vh;
  padding: 40px 20px 70px;

  background:
    radial-gradient(
      circle at top left,
      rgba(124, 58, 237, 0.14),
      transparent 32%
    ),
    radial-gradient(
      circle at bottom right,
      rgba(59, 130, 246, 0.12),
      transparent 30%
    ),
    #f6f7fb;
}

.result-container {
  max-width: 1180px;
  margin: auto;
}


/* =========================================================
   TOP BAR
========================================================= */

.result-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.result-breadcrumb {
  color: #7c3aed;
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 6px;
}

.result-title {
  margin: 0;
  color: #111827;
  font-size: 30px;
  font-weight: 800;
  letter-spacing: -0.5px;
}

.result-subtitle {
  margin: 6px 0 0;
  color: #6b7280;
  font-size: 14px;
}

.completed-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  border-radius: 999px;
  background: #ecfdf5;
  color: #047857;
  border: 1px solid #a7f3d0;
  font-size: 13px;
  font-weight: 700;
}


/* =========================================================
   HERO RESULT CARD
========================================================= */

.result-hero {
  position: relative;
  overflow: hidden;

  border-radius: 28px;
  padding: 42px;
  margin-bottom: 24px;

  color: white;

  background:
    linear-gradient(
      135deg,
      #4f46e5 0%,
      #7c3aed 50%,
      #9333ea 100%
    );

  box-shadow:
    0 25px 60px rgba(79, 70, 229, 0.22);
}

.result-hero::before {
  content: "";

  position: absolute;

  width: 280px;
  height: 280px;

  border-radius: 50%;

  right: -100px;
  top: -130px;

  background: rgba(255,255,255,.10);
}

.result-hero::after {
  content: "";

  position: absolute;

  width: 220px;
  height: 220px;

  border-radius: 50%;

  left: 35%;
  bottom: -170px;

  background: rgba(255,255,255,.08);
}

.result-hero-content {
  position: relative;
  z-index: 2;

  display: grid;

  grid-template-columns: 1fr 330px;

  align-items: center;

  gap: 45px;
}

.result-series-name {
  font-size: 15px;
  font-weight: 700;
  opacity: .82;
  margin-bottom: 10px;
}

.result-hero h2 {
  margin: 0;

  font-size: 34px;
  font-weight: 800;

  letter-spacing: -.7px;
}

.result-message {
  margin: 12px 0 0;

  font-size: 18px;
  font-weight: 600;

  opacity: .95;
}

.result-completed-time {
  margin-top: 18px;

  font-size: 13px;

  opacity: .75;
}


/* =========================================================
   SCORE CIRCLE
========================================================= */

.score-circle-wrapper {
  display: flex;
  justify-content: center;
}

.score-circle {
  width: 230px;
  height: 230px;

  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  background:
    conic-gradient(
      #ffffff var(--progress),
      rgba(255,255,255,.20) var(--progress)
    );

  position: relative;
}

.score-circle::before {
  content: "";

  position: absolute;

  inset: 15px;

  border-radius: 50%;

  background: #6d28d9;
}

.score-circle-content {
  position: relative;

  z-index: 2;

  text-align: center;
}

.score-percentage {
  display: block;

  font-size: 44px;

  line-height: 1;

  font-weight: 900;
}

.score-label {
  display: block;

  margin-top: 8px;

  font-size: 12px;

  text-transform: uppercase;

  letter-spacing: 1.5px;

  opacity: .75;
}


/* =========================================================
   SUMMARY GRID
========================================================= */

.summary-grid {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 16px;

  margin-bottom: 24px;
}

.summary-card {
  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 20px;

  padding: 22px;

  box-shadow:
    0 8px 25px rgba(15,23,42,.05);
}

.summary-icon {
  width: 42px;
  height: 42px;

  border-radius: 12px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 14px;

  font-size: 18px;
}

.summary-icon.blue {
  background: #eff6ff;
  color: #2563eb;
}

.summary-icon.green {
  background: #ecfdf5;
  color: #059669;
}

.summary-icon.red {
  background: #fef2f2;
  color: #dc2626;
}

.summary-icon.orange {
  background: #fff7ed;
  color: #ea580c;
}

.summary-value {
  display: block;

  font-size: 26px;

  color: #111827;

  font-weight: 800;
}

.summary-label {
  display: block;

  margin-top: 4px;

  color: #6b7280;

  font-size: 13px;
}


/* =========================================================
   MAIN GRID
========================================================= */

.result-main-grid {
  display: grid;

  grid-template-columns:
    1fr 350px;

  gap: 24px;

  align-items: start;
}

.result-card {
  background: white;

  border: 1px solid #e5e7eb;

  border-radius: 22px;

  box-shadow:
    0 8px 25px rgba(15,23,42,.05);

  overflow: hidden;
}

.result-card-header {
  padding: 22px 24px;

  border-bottom:
    1px solid #eef0f4;
}

.result-card-header h3 {
  margin: 0;

  color: #111827;

  font-size: 18px;

  font-weight: 800;
}

.result-card-header p {
  margin: 5px 0 0;

  color: #6b7280;

  font-size: 13px;
}


/* =========================================================
   DETAILED QUESTION REVIEW
========================================================= */

.question-review {
  padding: 10px 20px 20px;
}

.question-review-card {
  margin: 16px 0;

  border: 1px solid #e5e7eb;

  border-radius: 18px;

  overflow: hidden;

  background: #ffffff;

  transition: .2s ease;
}

.question-review-card:hover {
  box-shadow:
    0 8px 25px rgba(15,23,42,.07);
}

.review-correct {
  border-left: 4px solid #10b981;
}

.review-incorrect {
  border-left: 4px solid #ef4444;
}

.review-unanswered {
  border-left: 4px solid #9ca3af;
}


/* =========================================================
   QUESTION HEADER
========================================================= */

.review-question-header {
  display: flex;

  align-items: center;

  gap: 14px;

  padding: 16px 18px;

  background: #f8fafc;

  border-bottom:
    1px solid #eef0f4;
}

.review-question-number {
  width: 40px;
  height: 40px;

  flex: 0 0 40px;

  border-radius: 11px;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 14px;

  font-weight: 900;
}

.review-question-number.correct {
  background: #dcfce7;
  color: #15803d;
}

.review-question-number.incorrect {
  background: #fee2e2;
  color: #b91c1c;
}

.review-question-number.unanswered {
  background: #f3f4f6;
  color: #6b7280;
}

.review-question-title {
  flex: 1;

  display: flex;

  align-items: center;

  gap: 10px;

  flex-wrap: wrap;
}

.review-question-title > span:first-child {
  color: #111827;

  font-size: 14px;

  font-weight: 800;
}

.review-status {
  display: inline-flex;

  align-items: center;

  gap: 5px;

  padding: 4px 9px;

  border-radius: 999px;

  font-size: 11px;

  font-weight: 800;
}

.review-status.correct {
  background: #ecfdf5;
  color: #047857;
}

.review-status.incorrect {
  background: #fef2f2;
  color: #b91c1c;
}

.review-status.unanswered {
  background: #f3f4f6;
  color: #6b7280;
}

.review-marks {
  color: #374151;

  font-size: 13px;

  font-weight: 900;

  white-space: nowrap;
}


/* =========================================================
   QUESTION BODY
========================================================= */

.review-question-body {
  padding: 20px;
}

.review-question-text {
  color: #111827;

  font-size: 15px;

  line-height: 1.7;

  font-weight: 700;

  margin-bottom: 20px;
}


/* =========================================================
   ANSWER BLOCK
========================================================= */

.review-answer-block {
  margin-top: 14px;

  padding: 14px 16px;

  border-radius: 12px;

  background: #f8fafc;

  border: 1px solid #eef0f4;
}

.review-answer-label {
  display: flex;

  align-items: center;

  gap: 7px;

  margin-bottom: 8px;

  font-size: 11px;

  font-weight: 900;

  text-transform: uppercase;

  letter-spacing: .05em;
}

.your-answer-label {
  color: #475569;
}

.correct-answer-label {
  color: #15803d;
}

.review-answer-value {
  display: flex;

  align-items: center;

  gap: 8px;

  font-size: 14px;

  line-height: 1.5;

  font-weight: 700;
}

.answer-correct {
  color: #15803d;
}

.answer-incorrect {
  color: #dc2626;
}

.answer-unanswered {
  color: #6b7280;
}


/* =========================================================
   EXPLANATION
========================================================= */

.review-explanation {
  margin-top: 16px;

  padding: 18px;

  border-radius: 14px;

  background: #faf5ff;

  border: 1px solid #e9d5ff;
}

.review-explanation-title {
  display: flex;

  align-items: center;

  gap: 8px;

  margin-bottom: 10px;

  color: #6d28d9;

  font-size: 13px;

  font-weight: 900;
}

.review-explanation-title i {
  color: #7c3aed;

  font-size: 15px;
}

.review-explanation-content {
  color: #475569;

  font-size: 14px;

  line-height: 1.75;
}

.review-explanation-content p {
  margin-bottom: 8px;
}

.review-explanation-content p:last-child {
  margin-bottom: 0;
}


/* =========================================================
   PERFORMANCE CARD
========================================================= */

.performance-card {
  padding: 24px;
}

.performance-title {
  margin: 0 0 20px;

  font-size: 17px;

  font-weight: 800;

  color: #111827;
}

.performance-item {
  margin-bottom: 20px;
}

.performance-top {
  display: flex;

  justify-content: space-between;

  margin-bottom: 8px;

  font-size: 13px;

  font-weight: 700;
}

.performance-top span:first-child {
  color: #374151;
}

.performance-top span:last-child {
  color: #6b7280;
}

.progress-bar {
  width: 100%;

  height: 9px;

  border-radius: 999px;

  background: #eef0f4;

  overflow: hidden;
}

.progress-fill {
  height: 100%;

  border-radius: inherit;
}

.progress-green {
  background: #10b981;
}

.progress-red {
  background: #ef4444;
}

.progress-gray {
  background: #9ca3af;
}


/* =========================================================
   SCORE DETAILS
========================================================= */

.score-detail-list {
  margin-top: 24px;

  border-top:
    1px solid #eef0f4;

  padding-top: 18px;
}

.score-detail {
  display: flex;

  justify-content: space-between;

  padding: 9px 0;

  font-size: 14px;
}

.score-detail span:first-child {
  color: #6b7280;
}

.score-detail span:last-child {
  color: #111827;

  font-weight: 700;
}


/* =========================================================
   ACTIONS
========================================================= */

.result-actions {
  display: flex;

  gap: 12px;

  margin-top: 24px;
}

.result-action {
  flex: 1;

  min-height: 46px;

  border-radius: 13px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  text-decoration: none;

  font-size: 13px;

  font-weight: 800;

  transition: .2s ease;
}

.result-action:hover {
  transform: translateY(-2px);
}

.primary-action {
  background: #4f46e5;
  color: white;
}

.primary-action:hover {
  color: white;
  background: #4338ca;
}

.secondary-action {
  background: #f3f4f6;
  color: #374151;
}

.secondary-action:hover {
  color: #111827;
  background: #e5e7eb;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {

  .result-hero-content {
    grid-template-columns: 1fr;

    text-align: center;
  }

  .score-circle-wrapper {
    order: -1;
  }

  .summary-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .result-main-grid {
    grid-template-columns: 1fr;
  }

}


@media (max-width: 600px) {

  .test-result-page {
    padding: 25px 12px 50px;
  }

  .result-topbar {
    align-items: flex-start;

    flex-direction: column;
  }

  .result-title {
    font-size: 24px;
  }

  .result-hero {
    padding: 28px 20px;

    border-radius: 22px;
  }

  .result-hero h2 {
    font-size: 25px;
  }

  .score-circle {
    width: 190px;
    height: 190px;
  }

  .score-percentage {
    font-size: 36px;
  }

  .summary-grid {
    grid-template-columns: 1fr 1fr;

    gap: 10px;
  }

  .summary-card {
    padding: 16px;
  }

  .summary-value {
    font-size: 22px;
  }

  .review-question-header {
    padding: 13px;
  }

  .review-question-body {
    padding: 16px;
  }

  .review-question-text {
    font-size: 14px;
  }

  .review-marks {
    font-size: 12px;
  }

  .result-actions {
    flex-direction: column;
  }

}

</style>


<div class="test-result-page">

  <div class="result-container">


    <!-- ======================================================
         TOP BAR
    ======================================================= -->

    <div class="result-topbar">

      <div>

        <div class="result-breadcrumb">
          Test Series / Result
        </div>

        <h1 class="result-title">
          Test Result
        </h1>

        <p class="result-subtitle">
          Review your performance and answers
        </p>

      </div>


      <div class="completed-badge">

        <span>✓</span>

        Test Completed

      </div>

    </div>


    <!-- ======================================================
         HERO
    ======================================================= -->

    <div class="result-hero">

      <div class="result-hero-content">


        <div>

          <div class="result-series-name">

            <%= @test_series.exam_name.presence ||
                @test_series.title %>

          </div>

          <h2>

            <%= @test.title.presence ||
                "Test #{@test.test_number}" %>

          </h2>

          <div class="result-message">

            <%= result_message %>

          </div>

          <div class="result-completed-time">

            Completed

            <% if @attempt.completed_at.present? %>
        <%= @attempt.completed_at.in_time_zone.strftime("%d %b %Y, %I:%M %p") %>
       <% end %>

          </div>

        </div>


        <!-- SCORE -->

        <div class="score-circle-wrapper">

          <div
            class="score-circle"
            style="--progress: <%= percentage %>%">

            <div class="score-circle-content">

              <span class="score-percentage">

                <%= percentage %>%

              </span>

              <span class="score-label">

                Score

              </span>

            </div>

          </div>

        </div>


      </div>

    </div>


    <!-- ======================================================
         SUMMARY CARDS
    ======================================================= -->

    <div class="summary-grid">


      <!-- SCORE -->

      <div class="summary-card">

        <div class="summary-icon blue">
          ★
        </div>

        <span class="summary-value">

          <%= obtained_marks %>

        </span>

        <span class="summary-label">

          Marks Obtained /
          <%= total_marks %>

        </span>

      </div>


      <!-- CORRECT -->

      <div class="summary-card">

        <div class="summary-icon green">
          ✓
        </div>

        <span class="summary-value">

          <%= correct_count %>

        </span>

        <span class="summary-label">

          Correct Answers

        </span>

      </div>


      <!-- INCORRECT -->

      <div class="summary-card">

        <div class="summary-icon red">
          ✕
        </div>

        <span class="summary-value">

          <%= incorrect_count %>

        </span>

        <span class="summary-label">

          Incorrect Answers

        </span>

      </div>


      <!-- UNANSWERED -->

      <div class="summary-card">

        <div class="summary-icon orange">
          —
        </div>

        <span class="summary-value">

          <%= unanswered_count %>

        </span>

        <span class="summary-label">

          Unanswered

        </span>

      </div>

    </div>


    <!-- ======================================================
         MAIN CONTENT
    ======================================================= -->

    <div class="result-main-grid">


      <!-- ====================================================
           QUESTION REVIEW
      ===================================================== -->

      <div class="result-card">

        <div class="result-card-header">

          <h3>

            Question-wise Review

          </h3>

          <p>

            Review your answers, correct answers and explanations.

          </p>

        </div>


        <div class="question-review">


          <% @test.test_series_questions
               .includes(:test_series_options)
               .order(position: :asc)
               .each_with_index do |question, index| %>


            <% answer =
                 @attempt.test_series_answers.find_by(
                   test_series_question: question
                 ) %>


            <% selected_option =
                 answer&.test_series_option %>


            <% correct_option =
                 question.test_series_options.find_by(
                   is_correct: true
                 ) %>


            <% correct =
                 answer.present? &&
                 answer.is_correct? %>


            <!-- ==================================================
                 QUESTION CARD
            =================================================== -->

            <div class="question-review-card
                        <%= if answer.nil?
                              'review-unanswered'
                            elsif correct
                              'review-correct'
                            else
                              'review-incorrect'
                            end %>">


              <!-- =================================================
                   QUESTION HEADER
              ================================================== -->

              <div class="review-question-header">


                <div class="review-question-number
                            <%= if answer.nil?
                                  'unanswered'
                                elsif correct
                                  'correct'
                                else
                                  'incorrect'
                                end %>">

                  <%= index + 1 %>

                </div>


                <div class="review-question-title">

                  <span>

                    Question <%= index + 1 %>

                  </span>


                  <% if answer.nil? %>

                    <span class="review-status unanswered">

                      <i class="fas fa-minus-circle"></i>

                      Not Answered

                    </span>


                  <% elsif correct %>

                    <span class="review-status correct">

                      <i class="fas fa-check-circle"></i>

                      Correct

                    </span>


                  <% else %>

                    <span class="review-status incorrect">

                      <i class="fas fa-times-circle"></i>

                      Incorrect

                    </span>

                  <% end %>

                </div>


                <div class="review-marks">

                  <% if answer.present? %>

                    <%= answer.marks_obtained.to_f %>

                  <% else %>

                    0

                  <% end %>

                  /

                  <%= question.marks.to_f %>

                </div>


              </div>


              <!-- =================================================
                   QUESTION BODY
              ================================================== -->

              <div class="review-question-body">


                <!-- QUESTION -->

                <div class="review-question-text">

                  <%= question.question_text %>

                </div>


                <!-- =================================================
                     YOUR ANSWER
                ================================================== -->

                <div class="review-answer-block">

                  <div class="review-answer-label your-answer-label">

                    <i class="fas fa-user-check"></i>

                    Your Answer

                  </div>


                  <% if selected_option.present? %>

                    <div class="review-answer-value
                                <%= correct ?
                                    'answer-correct' :
                                    'answer-incorrect' %>">

                      <% if correct %>

                        <i class="fas fa-check-circle"></i>

                      <% else %>

                        <i class="fas fa-times-circle"></i>

                      <% end %>

                      <%= selected_option.option_text %>

                    </div>

                  <% else %>

                    <div class="review-answer-value answer-unanswered">

                      <i class="fas fa-minus-circle"></i>

                      Not Answered

                    </div>

                  <% end %>

                </div>


                <!-- =================================================
                     CORRECT ANSWER
                ================================================== -->

                <% if correct_option.present? %>

                  <div class="review-answer-block">

                    <div class="review-answer-label correct-answer-label">

                      <i class="fas fa-circle-check"></i>

                      Correct Answer

                    </div>


                    <div class="review-answer-value answer-correct">

                      <i class="fas fa-check-circle"></i>

                      <%= correct_option.option_text %>

                    </div>

                  </div>

                <% end %>


                <!-- =================================================
                     EXPLANATION
                ================================================== -->

                <% if question.explanation.present? %>

                  <div class="review-explanation">

                    <div class="review-explanation-title">

                      <i class="fas fa-lightbulb"></i>

                      Explanation

                    </div>


                    <div class="review-explanation-content">

                      <%= simple_format(
                            question.explanation
                          ) %>

                    </div>

                  </div>

                <% else %>

                  <div class="review-explanation">

                    <div class="review-explanation-title">

                      <i class="fas fa-lightbulb"></i>

                      Explanation

                    </div>

                    <div class="review-explanation-content">

                      Explanation has not been added for this question yet.

                    </div>

                  </div>

                <% end %>


              </div>

            </div>


          <% end %>

        </div>

      </div>


      <!-- ====================================================
           PERFORMANCE
      ===================================================== -->

      <div>


        <div class="result-card">

          <div class="performance-card">

            <h3 class="performance-title">

              Performance Summary

            </h3>


            <!-- CORRECT -->

            <div class="performance-item">

              <div class="performance-top">

                <span>
                  Correct
                </span>

                <span>

                  <%= correct_count %>
                  /
                  <%= total_questions %>

                </span>

              </div>


              <div class="progress-bar">

                <div
                  class="progress-fill progress-green"
                  style="width: <%= total_questions > 0 ? (correct_count.to_f / total_questions * 100) : 0 %>%">
                </div>

              </div>

            </div>


            <!-- INCORRECT -->

            <div class="performance-item">

              <div class="performance-top">

                <span>
                  Incorrect
                </span>

                <span>

                  <%= incorrect_count %>
                  /
                  <%= total_questions %>

                </span>

              </div>


              <div class="progress-bar">

                <div
                  class="progress-fill progress-red"
                  style="width: <%= total_questions > 0 ? (incorrect_count.to_f / total_questions * 100) : 0 %>%">
                </div>

              </div>

            </div>


            <!-- UNANSWERED -->

            <div class="performance-item">

              <div class="performance-top">

                <span>
                  Unanswered
                </span>

                <span>

                  <%= unanswered_count %>
                  /
                  <%= total_questions %>

                </span>

              </div>


              <div class="progress-bar">

                <div
                  class="progress-fill progress-gray"
                  style="width: <%= total_questions > 0 ? (unanswered_count.to_f / total_questions * 100) : 0 %>%">
                </div>

              </div>

            </div>


            <!-- =================================================
                 DETAILS
            ================================================== -->

            <div class="score-detail-list">


              <div class="score-detail">

                <span>
                  Total Questions
                </span>

                <span>
                  <%= total_questions %>
                </span>

              </div>


              <div class="score-detail">

                <span>
                  Total Marks
                </span>

                <span>
                  <%= total_marks %>
                </span>

              </div>


              <div class="score-detail">

                <span>
                  Marks Obtained
                </span>

                <span>
                  <%= obtained_marks %>
                </span>

              </div>


              <div class="score-detail">

                <span>
                  Accuracy
                </span>

                <span>
                  <%= accuracy %>%
                </span>

              </div>


              <div class="score-detail">

                <span>
                  Status
                </span>

                <span>
                  Completed
                </span>

              </div>


            </div>

          </div>

        </div>


        <!-- ==================================================
             ACTION BUTTONS
        =================================================== -->

        <div class="result-actions">


          <%= link_to test_series_path(@test_series),
              class: "result-action secondary-action" do %>

            <i class="fas fa-arrow-left me-2"></i>

            Test Series

          <% end %>


          <%= link_to test_series_path(@test_series),
              class: "result-action primary-action" do %>

            Back to Tests

            <i class="fas fa-arrow-right ms-2"></i>

          <% end %>


        </div>


      </div>

    </div>

  </div>

</div>