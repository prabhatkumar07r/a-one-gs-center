<style>
  .btn-sm {
  padding: 4px 10px !important;
  font-size: 13px !important;
  border-radius: 6px !important;
}
</style>

<div class="container-fluid py-4">

  <!-- Page Heading -->
 <div class="d-flex justify-content-between align-items-start mb-4">

  <div>

    <h2 class="fw-bold text-primary">
      <i class="bi bi-cash-stack"></i>
      Fee Management
    </h2>

    <p class="text-muted mb-3">
      Manage all students fee records.
    </p>

    <div class="d-flex gap-2">

      <%= link_to report_fees_path,
          class: "btn btn-dark btn-sm" do %>
        <i class="bi bi-bar-chart-fill"></i>
        Report
      <% end %>

      <%= link_to export_fees_path(format: :xlsx),
          class: "btn btn-success btn-sm" do %>
        <i class="bi bi-file-earmark-excel-fill"></i>
        Export Excel
      <% end %>

      <%= link_to new_fee_path,
          class: "btn btn-primary btn-sm" do %>
        <i class="bi bi-plus-circle-fill"></i>
        Add Fee
      <% end %>

    </div>

  </div>

</div>

  <!-- Dashboard Cards -->
  <div class="row mb-4">

    <div class="col-md-4">
      <div class="card shadow border-0 border-start border-primary border-4">
        <div class="card-body text-center">

          <i class="bi bi-cash-stack fs-1 text-primary"></i>

          <h6 class="mt-2">
            Total Fees
          </h6>

          <h3>
            ₹<%= @total_fee %>
          </h3>

        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow border-0 border-start border-success border-4">
        <div class="card-body text-center">

          <i class="bi bi-check-circle-fill fs-1 text-success"></i>

          <h6 class="mt-2">
            Collected
          </h6>

          <h3 class="text-success">
            ₹<%= @paid_fee %>
          </h3>

        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow border-0 border-start border-danger border-4">
        <div class="card-body text-center">

          <i class="bi bi-exclamation-circle-fill fs-1 text-danger"></i>

          <h6 class="mt-2">
            Due Amount
          </h6>

          <h3 class="text-danger">
            ₹<%= @due_fee %>
          </h3>

        </div>
      </div>
    </div>

  </div>

  <!-- Search -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">

      <%= form_with url: fees_path,
            method: :get,
            local: true do %>

        <div class="row">

          <div class="col-md-10">

            <%= text_field_tag :search,
                  params[:search],
                  class: "form-control",
                  placeholder: "Search Student Name..." %>

          </div>

          <div class="col-md-2">

            <%= submit_tag "Search",
                  class: "btn btn-primary w-100" %>

          </div>

        </div>

      <% end %>

    </div>
  </div>

  <!-- Fee Table -->
  <div class="card shadow">

    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">
        Fee Records
      </h5>
    </div>

    <div class="table-responsive">

      <table class="table table-hover align-middle mb-0">

        <thead class="table-light">

          <tr>

            <th>#</th>
            <th>Student</th>
            <th>Course</th>
            <th>Total</th>
            <th>Paid</th>
            <th>Due</th>
            <th>Status</th>
            <th>Date</th>
            <th>Mode</th>
            <th>Receipt</th>
            <th width="180">Action</th>

          </tr>

        </thead>

        <tbody>

          <% if @fees.any? %>

            <% @fees.each_with_index do |fee, index| %>

              <tr>

                <td>
                  <%= index + 1 %>
                </td>

                <td>
                  <strong>
                    <%= fee.enrollment.user.name %>
                  </strong>
                </td>

                <td>
                  <%= fee.enrollment.course.Course_name %>
                </td>

                <td>
                  ₹<%= fee.total_fee %>
                </td>

                <td class="text-success fw-bold">
                  ₹<%= fee.paid_amount %>
                </td>

                <td class="text-danger fw-bold">
                  ₹<%= fee.due_amount %>
                </td>

                          <td>

                   <% if fee.status == "Paid" %>

                 <span class="badge bg-success">
                 Paid
                </span>

               <% elsif fee.status == "Partial" %>

             <span class="badge bg-warning text-dark">
             Partial
            </span>

           <% else %>

           <span class="badge bg-danger">
          Due
         </span>

       <% end %>

          </td>

                <td>
                  <%= fee.payment_date&.strftime("%d %b %Y") %>
                </td>

                <td>
                  <%= fee.payment_mode %>
                </td>

                <td>
                  <%= fee.receipt_no %>
                </td>

                <td>

                  <%= link_to fee_path(fee),
                        class: "btn btn-info btn-sm" do %>

                    <i class="bi bi-eye-fill"></i>

                  <% end %>

                  <%= link_to edit_fee_path(fee),
                        class: "btn btn-warning btn-sm" do %>

                    <i class="bi bi-pencil-fill"></i>

                  <% end %>

                  <%= button_to fee_path(fee),
                        method: :delete,
                        form: {
                          data: {
                            turbo_confirm: "Delete this fee?"
                          }
                        },
                        class: "btn btn-danger btn-sm d-inline" do %>

                    <i class="bi bi-trash-fill"></i>

                  <% end %>

                </td>

              </tr>

            <% end %>

          <% else %>

            <tr>

              <td colspan="11" class="text-center py-5">

                <i class="bi bi-database fs-1 text-muted"></i>

                <h5 class="mt-3">
                  No Fee Records Found
                </h5>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>

</div>
