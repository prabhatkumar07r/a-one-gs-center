<%= form_with(model: @fee, local: true) do |f| %>

  <% if @fee.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% @fee.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

         <%= f.select :enrollment_id,
      Enrollment.includes(:user, :course).map { |e|
        [
          e.display_name,
          e.id,
          { "data-fee": e.course.fee }
        ]
      },
      { prompt: "Select Student" },
      {
        class: "form-select",
        id: "enrollment_select"
      } %>

         <div class="mb-3">
  <%= f.label :total_fee %>
  <%= f.number_field :total_fee,
        class: "form-control",
        readonly: true,
        id: "total_fee" %>
</div>

  <div class="mb-3">
    <%= f.label :paid_amount %>
    <%= f.number_field :paid_amount, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :payment_date %>
    <%= f.date_field :payment_date, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :payment_mode %>
    <%= f.select :payment_mode,
          ["Cash","UPI","Card","Bank Transfer"],
          {},
          class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :receipt_no %>
    <%= f.text_field :receipt_no, class: "form-control" %>
  </div>

  <%= f.submit class: "btn btn-primary" %>

<% end %>
<script nonce="<%= content_security_policy_nonce %>">

(function () {

  function initializeEnrollmentFee() {

    const enrollment =
      document.getElementById("enrollment_select");

    const totalFee =
      document.getElementById("total_fee");


    if (!enrollment || !totalFee) {
      return;
    }


    /* =====================================================
       PREVENT DUPLICATE INITIALIZATION
    ===================================================== */

    if (enrollment.dataset.feeInitialized === "true") {
      return;
    }

    enrollment.dataset.feeInitialized = "true";


    /* =====================================================
       UPDATE TOTAL FEE
    ===================================================== */

    function updateFee() {

      const option =
        enrollment.options[
          enrollment.selectedIndex
        ];

      totalFee.value =
        option ? (option.dataset.fee || "") : "";

    }


    /* =====================================================
       CHANGE EVENT
    ===================================================== */

    enrollment.addEventListener(
      "change",
      updateFee
    );


    /* =====================================================
       INITIAL FEE
    ===================================================== */

    updateFee();

  }


  /* =======================================================
     TURBO PAGE LOAD
  ======================================================= */

  document.addEventListener(
    "turbo:load",
    initializeEnrollmentFee
  );


  /* =======================================================
     INITIAL NORMAL PAGE LOAD
  ======================================================= */

  if (document.readyState !== "loading") {

    initializeEnrollmentFee();

  } else {

    document.addEventListener(
      "DOMContentLoaded",
      initializeEnrollmentFee,
      { once: true }
    );

  }

})();

</script>