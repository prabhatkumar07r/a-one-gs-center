<style>
.card{
    border-radius:15px;
}

.card-header{
    background:#2563eb !important;
    color:#fff;
    border-radius:15px 15px 0 0;
}

.table thead th{
    background:#2563eb !important;
    color:#fff !important;
    text-align:center;
    vertical-align:middle;
}

.table td{
    vertical-align:middle;
}

.rounded-circle{
    object-fit:cover;
}

.search-box{
    width:400px;
    max-width:100%;
}

.add-teacher-btn{
    width:180px;
    padding:10px 20px;
    font-size:16px;
    border-radius:8px;
    display:inline-block;
    text-align:center;
}
</style>

<!-- Page Heading -->
<div class="d-flex justify-content-end mb-3">
  <%= link_to "➕ Add Teacher",
        new_teacher_path,
        class: "btn btn-success add-teacher-btn" %>
</div>

<!-- Search -->
<%= form_with url: teachers_path, method: :get, local: true, class: "mb-4" do %>

  <div class="input-group search-box">
    <%= text_field_tag :search,
          params[:search],
          class: "form-control",
          placeholder: "Search Teacher..." %>

    <%= submit_tag "🔍 Search", class: "btn btn-primary" %>
  </div>

<% end %>

<!-- Teacher Card -->
<div class="card shadow">

  <div class="card-header">
    <h4 class="mb-0">Teacher Details</h4>
  </div>

  <div class="card-body p-0">

    <div class="table-responsive">

      <table class="table table-bordered table-hover mb-0 align-middle">

        <thead>

          <tr>
            <th>#</th>
            <th>Photo</th>
            <th>Name</th>
            <th>Email</th>
            <th>Mobile</th>
            <th>Subject</th>
            <th>Qualification</th>
            <th>Status</th>
            <th width="220">Action</th>
          </tr>

        </thead>

        <tbody>

          <% if @teachers.any? %>

            <% @teachers.each_with_index do |teacher, index| %>

              <tr>

                <td><%= index + 1 %></td>

                <td>
                  <% if teacher.photo.attached? %>
                    <%= image_tag teacher.photo,
                          width: 70,
                          height: 70,
                          class: "rounded-circle img-thumbnail" %>
                  <% else %>
                    <span class="text-danger">No Image</span>
                  <% end %>
                </td>

                <td><%= teacher.name %></td>
                <td><%= teacher.email %></td>
                <td><%= teacher.mobile %></td>
                <td><%= teacher.subject %></td>
                <td><%= teacher.qualification %></td>

                <td>
                  <% if teacher.status == "Active" %>
                    <span class="badge bg-success">Active</span>
                  <% else %>
                    <span class="badge bg-danger">Inactive</span>
                  <% end %>
                </td>

                <td>
                  <%= link_to "View",
                        teacher_path(teacher),
                        class: "btn btn-info btn-sm" %>

                  <%= link_to "Edit",
                        edit_teacher_path(teacher),
                        class: "btn btn-warning btn-sm" %>

                  <%= button_to "Delete",
                        teacher_path(teacher),
                        method: :delete,
                        form: {
                          data: {
                            turbo_confirm: "Delete this teacher?"
                          }
                        },
                        class: "btn btn-danger btn-sm d-inline" %>
                </td>

              </tr>

            <% end %>

          <% else %>

            <tr>
              <td colspan="9" class="text-center text-danger py-4">
                No Teachers Found
              </td>
            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>

  <div class="card-footer">
    <strong>Total Teachers :</strong>
    <%= @teachers.count %>
  </div>

</div>