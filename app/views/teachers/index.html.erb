<%= render "layouts/header" %>

<div class="container mt-4">

<h2 class="mb-4">Teacher Management</h2>

<!-- Dashboard Cards -->

<div class="row mb-4">

  <div class="col-md-4">
    <div class="card shadow border-start border-primary border-4">
      <div class="card-body text-center">
        <h6>Total Teachers</h6>
        <h3><%= @total_teachers %></h3>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow border-start border-success border-4">
      <div class="card-body text-center">
        <h6>Active</h6>
        <h3><%= @active_teachers %></h3>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow border-start border-danger border-4">
      <div class="card-body text-center">
        <h6>Inactive</h6>
        <h3><%= @inactive_teachers %></h3>
      </div>
    </div>
  </div>

</div>

<!-- Search + Add Teacher -->

<div class="row mb-4">

  <div class="col-md-9">

    <%= form_with url: teachers_path, method: :get, local: true do %>

      <div class="input-group">

        <%= text_field_tag :search,
              params[:search],
              class: "form-control",
              placeholder: "Search Teacher..." %>

        <%= submit_tag "🔍 Search",
              class: "btn btn-primary" %>

      </div>

    <% end %>

  </div>

  <div class="col-md-3 text-end">

    <%= link_to "➕ Add Teacher",
          new_teacher_path,
          class: "btn btn-success" %>

  </div>

</div>

<!-- Teacher Table -->

<div class="table-responsive">

<table class="table table-bordered table-hover align-middle">

<thead class="table-dark">

<tr>

<th>#</th>
<th>Name</th>
<th>Email</th>
<th>Mobile</th>
<th>Subject</th>
<th>Qualification</th>
<th>Status</th>
<th>Action</th>

</tr>

</thead>

<tbody>

<% @teachers.each_with_index do |teacher, index| %>

<tr>

<td><%= index + 1 %></td>

<td><%= teacher.name %></td>

<td><%= teacher.email %></td>

<td><%= teacher.mobile %></td>

<td><%= teacher.subject %></td>

<td><%= teacher.qualification %></td>

<td>

<% if teacher.status == "Active" %>

<span class="badge bg-success">
Active
</span>

<% elsif teacher.status == "Inactive" %>

<span class="badge bg-danger">
Inactive
</span>

<% else %>

<span class="badge bg-secondary">
<%= teacher.status %>
</span>

<% end %>

</td>

<td>

<%= link_to "View",
      teacher_path(teacher),
      class: "btn btn-info btn-sm me-1" %>

<%= link_to "Edit",
      edit_teacher_path(teacher),
      class: "btn btn-warning btn-sm me-1" %>

<%= button_to "Delete",
      teacher_path(teacher),
      method: :delete,
      form: {
        data: {
          turbo_confirm: "Delete this teacher?"
        }
      },
      class: "btn btn-danger btn-sm d-inline" %>

</td>

</tr>

<% end %>

<% if @teachers.empty? %>

<tr>

<td colspan="8" class="text-center text-danger">

No Teachers Found

</td>

</tr>

<% end %>

</tbody>

</table>

</div>

<p class="text-muted mt-3">

Total Teachers :
<strong><%= @teachers.count %></strong>

</p>

</div>

<%= render "layouts/footer" %>