<% content_for :show_layout, true %>

<div class="student-profile-page">

  <!-- =========================================================
       PROFILE HEADER
  ========================================================== -->

  <section class="student-profile-header">

    <div class="student-profile-header-inner">

      <!-- PROFILE IMAGE -->

      <div class="student-profile-avatar">

        <% if @student.image.attached? %>

          <%= image_tag @student.image,
              alt: @student.name.presence || "Student" %>

        <% else %>

          <div class="student-profile-avatar-placeholder">
            <i class="bi bi-person-fill"></i>
          </div>

        <% end %>

      </div>


      <!-- PROFILE INFORMATION -->

      <div class="student-profile-info">

        <h1>
          <%= @student.name.presence || "Student" %>
        </h1>

        <p>
          <i class="bi bi-envelope"></i>
          <%= @student.email %>
        </p>

      </div>


      <!-- PROFILE ACTIONS -->

      <div class="student-profile-actions">

        <%= link_to student_edit_profile_path,
            class: "student-profile-action-btn" do %>

          <i class="bi bi-pencil-square"></i>
          Update Profile

        <% end %>


        <%= link_to student_profile_password_path,
            class: "student-profile-action-btn secondary" do %>

          <i class="bi bi-shield-lock"></i>
          Change Password

        <% end %>

      </div>

    </div>

  </section>



  <!-- =========================================================
       PROFILE STATS
  ========================================================== -->

  <section class="student-profile-stats">

    <!-- TOTAL COURSES -->

    <div class="student-stat-card">

      <div class="student-stat-icon">
        <i class="bi bi-book"></i>
      </div>

      <div class="student-stat-content">

        <span>Total Courses</span>

        <strong>
          <%= @total_courses || 0 %>
        </strong>

      </div>

    </div>


    <!-- COMPLETED COURSES -->

    <div class="student-stat-card">

      <div class="student-stat-icon">
        <i class="bi bi-check-circle"></i>
      </div>

      <div class="student-stat-content">

        <span>Completed Courses</span>

        <strong>
          <%= @completed_courses || 0 %>
        </strong>

      </div>

    </div>


    <!-- LECTURES -->

    <div class="student-stat-card">

      <div class="student-stat-icon">
        <i class="bi bi-play-circle"></i>
      </div>

      <div class="student-stat-content">

        <span>Lectures Done</span>

        <strong>
          <%= @lectures_done || 0 %>
        </strong>

      </div>

    </div>


    <!-- MODULES -->

    <div class="student-stat-card">

      <div class="student-stat-icon">
        <i class="bi bi-grid"></i>
      </div>

      <div class="student-stat-content">

        <span>Total Modules</span>

        <strong>
          <%= @total_modules || 0 %>
        </strong>

      </div>

    </div>


    <!-- TEST SERIES -->

    <div class="student-stat-card">

      <div class="student-stat-icon">
        <i class="bi bi-journal-check"></i>
      </div>

      <div class="student-stat-content">

        <span>My Test Series</span>

        <strong>
          <%= @total_test_series || 0 %>
        </strong>

      </div>

    </div>


    <!-- COMPLETED TESTS -->

    <div class="student-stat-card">

      <div class="student-stat-icon">
        <i class="bi bi-trophy"></i>
      </div>

      <div class="student-stat-content">

        <span>Tests Completed</span>

        <strong>
          <%= @completed_test_series_tests || 0 %>
        </strong>

      </div>

    </div>

  </section>



  <!-- =========================================================
       PROFILE CONTENT
  ========================================================== -->

  <section class="student-profile-content">


    <!-- =======================================================
         TABS
    ======================================================== -->

    <div class="student-profile-tabs">

      <%= link_to student_profile_path,
          class: "student-profile-tab active" do %>

        <i class="bi bi-grid-1x2"></i>
        Overview

      <% end %>


      <%= link_to "#",
          class: "student-profile-tab" do %>

        <i class="bi bi-award"></i>
        Certificates

      <% end %>


      <%= link_to "#",
          class: "student-profile-tab" do %>

        <i class="bi bi-clock-history"></i>
        Activity

      <% end %>

    </div>



    <!-- =======================================================
         MY COURSES
    ======================================================== -->

    <div class="student-content-card">

      <div class="student-content-title">

        <div>

          <i class="bi bi-book-half"></i>

          My Courses

        </div>

        <span class="student-section-count">

          <%= @courses&.count || 0 %>

          <%= (@courses&.count || 0) == 1 ? "Course" : "Courses" %>

        </span>

      </div>


      <% if @courses.present? %>

        <div class="student-courses-grid">

          <% @courses.each do |course| %>

            <div class="student-course-card">


              <!-- COURSE IMAGE -->

              <div class="student-course-image">

                <% if course.image.attached? %>

                  <%= image_tag course.image,
                      alt: course.Course_name %>

                <% else %>

                  <div class="student-course-placeholder">

                    <i class="bi bi-book"></i>

                  </div>

                <% end %>

              </div>



              <!-- COURSE CONTENT -->

              <div class="student-course-content">

                <h3>
                  <%= course.Course_name %>
                </h3>


                <% if course.respond_to?(:description) &&
                      course.description.present? %>

                  <p>
                    <%= truncate(
                          course.description,
                          length: 120
                        ) %>
                  </p>

                <% end %>


                <div class="student-course-meta">

                  <span>

                    <i class="bi bi-play-circle"></i>

                    Course

                  </span>


                  <span>

                    <i class="bi bi-check-circle"></i>

                    Access Granted

                  </span>

                </div>


                <%= link_to learning_course_path(course),
                    class: "student-course-button" do %>

                  Continue Learning

                  <i class="bi bi-arrow-right"></i>

                <% end %>

              </div>

            </div>

          <% end %>

        </div>


      <% else %>


        <!-- EMPTY COURSE STATE -->

        <div class="student-empty-state">

          <div class="student-empty-icon">

            <i class="bi bi-book"></i>

          </div>


          <h3>
            No Courses Yet
          </h3>


          <p>
            You haven't enrolled in any course yet.
          </p>


          <%= link_to courses_path,
              class: "student-empty-button" do %>

            Browse Courses

            <i class="bi bi-arrow-right"></i>

          <% end %>

        </div>

      <% end %>

    </div>



    <!-- =======================================================
         MY TEST SERIES
    ======================================================== -->

    <div class="student-content-card student-test-series-section">

      <div class="student-content-title">

        <div>

          <i class="bi bi-journal-check"></i>

          My Test Series

        </div>


        <span class="student-section-count">

          <%= @total_test_series || 0 %>

          <%= (@total_test_series || 0) == 1 ? "Series" : "Series" %>

        </span>

      </div>



      <% if @test_series_purchases.present? %>

        <div class="student-test-series-list">


          <% @test_series_purchases.each do |purchase| %>

            <% series = purchase.test_series %>

            <% next unless series %>


            <% tests =
                 series
                   .test_series_tests
                   .active
                   .to_a %>


            <% total_tests = tests.length %>


            <% completed_tests = tests.count do |test| %>

              <% current_user
                   .test_series_attempts
                   .where(
                     test_series_test: test,
                     status: "Completed"
                   )
                   .exists? %>

            <% end %>


            <% progress =
                 if total_tests > 0
                   (
                     completed_tests.to_f /
                     total_tests *
                     100
                   ).round
                 else
                   0
                 end %>


            <div class="student-test-series-card">


              <!-- SERIES IMAGE -->

              <div class="student-test-series-image">

                <% if series.image.attached? %>

                  <%= image_tag series.image,
                      alt: series.exam_name.presence || "Test Series" %>

                <% else %>

                  <div class="student-test-series-placeholder">

                    <i class="bi bi-journal-text"></i>

                  </div>

                <% end %>

              </div>



              <!-- SERIES CONTENT -->

              <div class="student-test-series-content">


                <!-- TOP -->

                <div class="student-test-series-top">

                  <div>

                    <h3 class="student-test-series-name">

                      <%= series.exam_name.presence || "Test Series" %>

                    </h3>


                    <% if series.respond_to?(:description) &&
                          series.description.present? %>

                      <p class="student-test-series-description">

                        <%= truncate(
                              series.description,
                              length: 140
                            ) %>

                      </p>

                    <% end %>

                  </div>


                  <span class="student-access-badge">

                    <i class="bi bi-check-circle-fill"></i>

                    Purchased

                  </span>

                </div>



                <!-- SERIES INFORMATION -->

                <div class="student-test-series-stats">


                  <span>

                    <i class="bi bi-file-earmark-text"></i>

                    <%= total_tests %>

                    <%= total_tests == 1 ? "Test" : "Tests" %>

                  </span>


                  <span>

                    <i class="bi bi-check2-circle"></i>

                    <%= completed_tests %>

                    Completed

                  </span>


                  <% if series.respond_to?(:language) &&
                        series.language.present? %>

                    <span>

                      <i class="bi bi-translate"></i>

                      <%= series.language %>

                    </span>

                  <% end %>


                </div>



                <!-- PROGRESS -->

                <div class="student-test-series-progress-header">

                  <span>
                    Your Progress
                  </span>

                  <strong>
                    <%= progress %>%
                  </strong>

                </div>


                <div class="student-test-series-progress">

                  <div
                    class="student-test-series-progress-fill"
                    style="width: <%= progress %>%">
                  </div>

                </div>



                <!-- BUTTON -->

                <div class="student-test-series-actions">

                  <%= link_to test_series_path(series),
                      class: "student-test-series-button" do %>


                    <% if progress > 0 && progress < 100 %>

                      Continue Test Series

                    <% elsif progress >= 100 %>

                      View Test Series

                    <% else %>

                      Start Test Series

                    <% end %>


                    <i class="bi bi-arrow-right"></i>

                  <% end %>

                </div>

              </div>

            </div>

          <% end %>

        </div>


      <% else %>


        <!-- EMPTY TEST SERIES STATE -->

        <div class="student-empty-test-series">

          <div class="student-empty-test-series-icon">

            <i class="bi bi-journal-x"></i>

          </div>


          <h3>
            No Test Series Yet
          </h3>


          <p>
            You haven't purchased any test series yet.
          </p>


          <%= link_to test_series_index_path,
              class: "student-browse-test-series" do %>

            Browse Test Series

            <i class="bi bi-arrow-right"></i>

          <% end %>

        </div>

      <% end %>

    </div>



    <!-- =======================================================
         LEARNING STATISTICS
    ======================================================== -->

    <div class="student-content-card">

      <div class="student-content-title">

        <div>

          <i class="bi bi-bar-chart-line"></i>

          Learning Statistics

        </div>

      </div>


      <div class="student-learning-stats">


        <!-- TOTAL LECTURES -->

        <div class="student-learning-stat">

          <div class="student-learning-stat-icon">

            <i class="bi bi-play-circle"></i>

          </div>

          <div>

            <span>
              Total Lectures
            </span>

            <strong>
              <%= @total_lectures || 0 %>
            </strong>

          </div>

        </div>



        <!-- COMPLETED LECTURES -->

        <div class="student-learning-stat">

          <div class="student-learning-stat-icon">

            <i class="bi bi-check2-circle"></i>

          </div>

          <div>

            <span>
              Completed Lectures
            </span>

            <strong>
              <%= @lectures_done || 0 %>
            </strong>

          </div>

        </div>



        <!-- COURSES -->

        <div class="student-learning-stat">

          <div class="student-learning-stat-icon">

            <i class="bi bi-book"></i>

          </div>

          <div>

            <span>
              My Courses
            </span>

            <strong>
              <%= @total_courses || 0 %>
            </strong>

          </div>

        </div>



        <!-- TEST SERIES -->

        <div class="student-learning-stat">

          <div class="student-learning-stat-icon">

            <i class="bi bi-journal-check"></i>

          </div>

          <div>

            <span>
              Test Series
            </span>

            <strong>
              <%= @total_test_series || 0 %>
            </strong>

          </div>

        </div>



        <!-- TESTS COMPLETED -->

        <div class="student-learning-stat">

          <div class="student-learning-stat-icon">

            <i class="bi bi-trophy"></i>

          </div>

          <div>

            <span>
              Tests Completed
            </span>

            <strong>
              <%= @completed_test_series_tests || 0 %>
            </strong>

          </div>

        </div>


      </div>

    </div>

  </section>

</div>



<style>

/* =========================================================
   PAGE
========================================================= */

.student-profile-page {
  min-height: 100vh;

  background:
    radial-gradient(
      circle at top right,
      rgba(124, 58, 237, 0.15),
      transparent 35%
    ),
    #0b0f19;

  color: #f8fafc;

  padding-bottom: 60px;
}



/* =========================================================
   PROFILE HEADER
========================================================= */

.student-profile-header {
  padding: 45px 30px 30px;
}

.student-profile-header-inner {
  max-width: 1250px;

  margin: auto;

  display: flex;

  align-items: center;

  gap: 25px;

  padding: 30px;

  background: rgba(255,255,255,.055);

  border: 1px solid rgba(255,255,255,.08);

  border-radius: 20px;

  backdrop-filter: blur(15px);
}



/* =========================================================
   AVATAR
========================================================= */

.student-profile-avatar {
  width: 100px;

  height: 100px;

  flex-shrink: 0;

  border-radius: 50%;

  overflow: hidden;

  border: 3px solid rgba(139,92,246,.7);

  box-shadow:
    0 0 0 6px rgba(139,92,246,.08);
}

.student-profile-avatar img {
  width: 100%;

  height: 100%;

  object-fit: cover;
}

.student-profile-avatar-placeholder {
  width: 100%;

  height: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #1e293b;

  font-size: 42px;

  color: #94a3b8;
}



/* =========================================================
   PROFILE INFO
========================================================= */

.student-profile-info {
  flex: 1;
}

.student-profile-info h1 {
  margin: 0 0 8px;

  font-size: 30px;

  font-weight: 800;
}

.student-profile-info p {
  margin: 0;

  color: #94a3b8;
}

.student-profile-info p i {
  margin-right: 7px;
}



/* =========================================================
   ACTION BUTTONS
========================================================= */

.student-profile-actions {
  display: flex;

  gap: 10px;

  flex-wrap: wrap;
}

.student-profile-action-btn {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  padding: 11px 16px;

  border-radius: 10px;

  background: #7c3aed;

  color: white;

  text-decoration: none;

  font-size: 14px;

  font-weight: 600;

  transition: .25s;
}

.student-profile-action-btn:hover {
  transform: translateY(-2px);

  color: white;

  background: #8b5cf6;
}

.student-profile-action-btn.secondary {
  background: rgba(255,255,255,.07);

  border:
    1px solid rgba(255,255,255,.1);
}



/* =========================================================
   PROFILE STATS
========================================================= */

.student-profile-stats {
  max-width: 1250px;

  margin: 0 auto;

  padding: 0 30px 25px;

  display: grid;

  grid-template-columns:
    repeat(6, minmax(0, 1fr));

  gap: 15px;
}

.student-stat-card {
  padding: 20px;

  display: flex;

  align-items: center;

  gap: 14px;

  background: rgba(255,255,255,.045);

  border:
    1px solid rgba(255,255,255,.07);

  border-radius: 16px;

  transition: .25s;
}

.student-stat-card:hover {
  transform: translateY(-3px);

  border-color:
    rgba(139,92,246,.35);
}

.student-stat-icon {
  width: 45px;

  height: 45px;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 12px;

  background: rgba(124,58,237,.15);

  color: #a78bfa;

  font-size: 20px;
}

.student-stat-content {
  min-width: 0;
}

.student-stat-content span {
  display: block;

  color: #94a3b8;

  font-size: 12px;

  margin-bottom: 4px;
}

.student-stat-content strong {
  font-size: 22px;
}



/* =========================================================
   CONTENT
========================================================= */

.student-profile-content {
  max-width: 1250px;

  margin: auto;

  padding: 0 30px;
}



/* =========================================================
   TABS
========================================================= */

.student-profile-tabs {
  display: flex;

  gap: 8px;

  margin-bottom: 20px;

  border-bottom:
    1px solid rgba(255,255,255,.08);
}

.student-profile-tab {
  display: inline-flex;

  align-items: center;

  gap: 8px;

  padding: 13px 18px;

  color: #94a3b8;

  text-decoration: none;

  border-bottom:
    2px solid transparent;

  transition: .25s;
}

.student-profile-tab:hover,
.student-profile-tab.active {
  color: #c4b5fd;

  border-bottom-color:
    #8b5cf6;
}



/* =========================================================
   CONTENT CARD
========================================================= */

.student-content-card {
  margin-bottom: 22px;

  padding: 25px;

  background: rgba(255,255,255,.045);

  border:
    1px solid rgba(255,255,255,.07);

  border-radius: 18px;
}

.student-content-title {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  margin-bottom: 22px;

  font-size: 20px;

  font-weight: 700;
}

.student-content-title > div {
  display: flex;

  align-items: center;

  gap: 10px;
}

.student-content-title i {
  color: #a78bfa;
}

.student-section-count {
  padding: 5px 10px;

  border-radius: 20px;

  background: rgba(139,92,246,.12);

  color: #c4b5fd;

  font-size: 12px;

  font-weight: 600;
}



/* =========================================================
   COURSES
========================================================= */

.student-courses-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 18px;
}

.student-course-card {
  display: flex;

  overflow: hidden;

  background: rgba(15,23,42,.7);

  border:
    1px solid rgba(255,255,255,.07);

  border-radius: 15px;

  transition: .25s;
}

.student-course-card:hover {
  transform: translateY(-3px);

  border-color:
    rgba(139,92,246,.35);
}

.student-course-image {
  width: 170px;

  min-height: 190px;

  flex-shrink: 0;

  overflow: hidden;
}

.student-course-image img {
  width: 100%;

  height: 100%;

  object-fit: cover;
}

.student-course-placeholder {
  width: 100%;

  height: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #1e293b;

  color: #64748b;

  font-size: 42px;
}

.student-course-content {
  padding: 20px;

  flex: 1;
}

.student-course-content h3 {
  margin: 0 0 8px;

  font-size: 18px;
}

.student-course-content p {
  color: #94a3b8;

  font-size: 13px;

  line-height: 1.6;

  margin-bottom: 12px;
}

.student-course-meta {
  display: flex;

  gap: 15px;

  flex-wrap: wrap;

  color: #94a3b8;

  font-size: 12px;

  margin-bottom: 16px;
}

.student-course-meta i {
  color: #a78bfa;

  margin-right: 4px;
}

.student-course-button {
  display: inline-flex;

  align-items: center;

  gap: 7px;

  padding: 9px 13px;

  background: #7c3aed;

  color: white;

  text-decoration: none;

  border-radius: 8px;

  font-size: 12px;

  font-weight: 600;

  transition: .25s;
}

.student-course-button:hover {
  color: white;

  background: #8b5cf6;

  transform: translateX(2px);
}



/* =========================================================
   TEST SERIES
========================================================= */

.student-test-series-list {
  display: flex;

  flex-direction: column;

  gap: 16px;
}

.student-test-series-card {
  display: flex;

  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      rgba(124,58,237,.08),
      rgba(15,23,42,.7)
    );

  border:
    1px solid rgba(255,255,255,.08);

  border-radius: 16px;

  transition: .25s;
}

.student-test-series-card:hover {
  transform: translateY(-3px);

  border-color:
    rgba(139,92,246,.4);

  box-shadow:
    0 15px 40px rgba(0,0,0,.2);
}



/* SERIES IMAGE */

.student-test-series-image {
  width: 220px;

  min-height: 210px;

  flex-shrink: 0;

  overflow: hidden;
}

.student-test-series-image img {
  width: 100%;

  height: 100%;

  object-fit: cover;
}

.student-test-series-placeholder {
  width: 100%;

  height: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

  background:
    linear-gradient(
      135deg,
      #312e81,
      #1e1b4b
    );

  color: #c4b5fd;

  font-size: 55px;
}



/* SERIES CONTENT */

.student-test-series-content {
  flex: 1;

  padding: 22px 24px;
}

.student-test-series-top {
  display: flex;

  align-items: flex-start;

  justify-content: space-between;

  gap: 20px;
}

.student-test-series-name {
  margin: 0 0 6px;

  font-size: 21px;

  font-weight: 750;

  color: #f8fafc;
}

.student-test-series-description {
  margin: 0;

  color: #94a3b8;

  font-size: 13px;

  line-height: 1.6;
}

.student-access-badge {
  flex-shrink: 0;

  display: inline-flex;

  align-items: center;

  gap: 5px;

  padding: 6px 11px;

  border-radius: 20px;

  background: rgba(34,197,94,.1);

  color: #86efac;

  border:
    1px solid rgba(34,197,94,.2);

  font-size: 11px;

  font-weight: 700;
}



/* SERIES STATS */

.student-test-series-stats {
  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 20px;

  margin-top: 18px;

  color: #94a3b8;

  font-size: 12px;
}

.student-test-series-stats span {
  display: inline-flex;

  align-items: center;

  gap: 6px;
}

.student-test-series-stats i {
  color: #a78bfa;
}



/* PROGRESS */

.student-test-series-progress-header {
  display: flex;

  justify-content: space-between;

  margin-top: 20px;

  margin-bottom: 7px;

  font-size: 12px;

  color: #94a3b8;
}

.student-test-series-progress-header strong {
  color: #c4b5fd;
}

