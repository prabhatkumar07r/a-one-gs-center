<style>
  .student-password-page {
    min-height: 100vh;
    background: #08090d;
    color: #f5f5f7;
    padding: 35px 40px 70px;
  }

  .password-header {
    background: #0d0f15;
    border: 1px solid #20232d;
    border-radius: 22px;
    padding: 30px 35px;
    margin-bottom: 30px;
  }

  .password-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .password-title {
    margin: 0;
    font-size: 32px;
    font-weight: 800;
  }

  .password-subtitle {
    margin: 8px 0 0;
    color: #9299ad;
    font-size: 15px;
  }

  .back-profile-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    padding: 11px 18px;

    border: 1px solid #292d38;
    border-radius: 10px;

    background: #11131a;
    color: #c9ceda;

    text-decoration: none;
    font-size: 14px;
    font-weight: 600;

    transition: .25s;
  }

  .back-profile-button:hover {
    color: #fff;
    border-color: #7137e8;
    background: #17121f;
  }

  .password-card {
    max-width: 850px;
    margin: 0 auto;

    background: #0d0f15;
    border: 1px solid #20232d;
    border-radius: 20px;
    padding: 35px;

    box-shadow: 0 10px 35px rgba(0,0,0,.20);
  }

  .password-card-title {
    display: flex;
    align-items: center;
    gap: 12px;

    margin-bottom: 30px;

    font-size: 24px;
    font-weight: 700;
  }

  .password-card-title i {
    color: #7137e8;
  }

  .password-form-group {
    margin-bottom: 22px;
  }

  .password-form-group label {
    display: block;

    margin-bottom: 9px;

    color: #c9ceda;

    font-size: 14px;
    font-weight: 600;
  }

  .password-form-control {
    width: 100%;
    box-sizing: border-box;

    padding: 14px 16px;

    background: #11131a;
    border: 1px solid #292d38;
    border-radius: 10px;

    color: #f5f5f7;

    font-size: 15px;

    outline: none;

    transition: .25s;
  }

  .password-form-control::placeholder {
    color: #626a7d;
  }

  .password-form-control:focus {
    border-color: #7137e8;

    box-shadow:
      0 0 0 3px rgba(113,55,232,.12);
  }

  .password-requirements {
    margin-top: 25px;

    padding: 16px 18px;

    background: #11131a;
    border: 1px solid #222632;
    border-radius: 12px;
  }

  .password-requirements-title {
    margin-bottom: 8px;

    color: #c9ceda;

    font-size: 13px;
    font-weight: 700;
  }

  .password-requirements ul {
    margin: 0;
    padding-left: 18px;

    color: #777f94;

    font-size: 12px;
    line-height: 1.8;
  }

  .password-actions {
    display: flex;
    align-items: center;
    gap: 12px;

    margin-top: 30px;
  }

  .change-password-button {
    border: none;

    padding: 13px 25px;

    border-radius: 10px;

    background: linear-gradient(
      135deg,
      #7137e8,
      #9148f5
    );

    color: white;

    font-size: 15px;
    font-weight: 700;

    cursor: pointer;

    transition: .25s;
  }

  .change-password-button:hover {
    transform: translateY(-2px);

    box-shadow:
      0 8px 22px rgba(113,55,232,.28);
  }

  .cancel-password-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 13px 23px;

    border-radius: 10px;

    background: #11131a;

    border: 1px solid #292d38;

    color: #9ba3b7;

    text-decoration: none;

    font-size: 15px;
    font-weight: 600;

    transition: .25s;
  }

  .cancel-password-button:hover {
    color: white;

    border-color: #7137e8;

    background: #17121f;
  }

  @media (max-width: 600px) {

    .student-password-page {
      padding: 20px 15px 40px;
    }

    .password-header {
      padding: 25px 20px;
    }

    .password-header-top {
      flex-direction: column;
      align-items: flex-start;
    }

    .password-title {
      font-size: 27px;
    }

    .password-card {
      padding: 22px 18px;
    }

    .password-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .change-password-button,
    .cancel-password-button {
      width: 100%;
    }
  }
</style>


<div class="student-password-page">

  <!-- HEADER -->

  <div class="password-header">

    <div class="password-header-top">

      <div>

        <h1 class="password-title">
          Change Password
        </h1>

        <p class="password-subtitle">
          Keep your account secure by using a strong password.
        </p>

      </div>

      <%= link_to student_profile_path,
          class: "back-profile-button" do %>

        <i class="bi bi-arrow-left"></i>
        Back to Profile

      <% end %>

    </div>

  </div>


  <!-- PASSWORD CARD -->

  <div class="password-card">

    <div class="password-card-title">

      <i class="bi bi-shield-lock"></i>

      Update Password

    </div>


    <%= form_with url: student_change_password_profile_path,
                  method: :patch,
                  local: true do |f| %>


      <!-- CURRENT PASSWORD -->

      <div class="password-form-group">

        <%= label_tag :current_password,
            "Current Password" %>

        <%= password_field_tag :current_password,
            nil,
            class: "password-form-control",
            placeholder: "Enter your current password",
            required: true %>

      </div>


      <!-- NEW PASSWORD -->

      <div class="password-form-group">

        <%= label_tag :password,
            "New Password" %>

        <%= password_field_tag :password,
            nil,
            class: "password-form-control",
            placeholder: "Enter your new password",
            minlength: 8,
            required: true %>

      </div>


      <!-- CONFIRM -->

      <div class="password-form-group">

        <%= label_tag :password_confirmation,
            "Confirm New Password" %>

        <%= password_field_tag :password_confirmation,
            nil,
            class: "password-form-control",
            placeholder: "Confirm your new password",
            minlength: 8,
            required: true %>

      </div>


      <!-- REQUIREMENTS -->

      <div class="password-requirements">

        <div class="password-requirements-title">
          Password requirements
        </div>

        <ul>
          <li>Password must be at least 8 characters.</li>
          <li>New password and confirmation must match.</li>
          <li>Your current password must be correct.</li>
        </ul>

      </div>


      <!-- BUTTONS -->

      <div class="password-actions">

        <%= f.submit "Change Password",
            class: "change-password-button" %>

        <%= link_to "Cancel",
            student_profile_path,
            class: "cancel-password-button" %>

      </div>

    <% end %>

  </div>

</div>