<% content_for :show_layout, true %>

<style nonce="<%= content_security_policy_nonce %>">
/* =========================================================
   STUDENT ENROLLMENT - NEW
========================================================= */
/* =========================================================
   STUDENT ENROLLMENT — SOFT 3D / PREMIUM UI
========================================================= */

.student-enrollment-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50px 20px;

  background:
    radial-gradient(
      circle at 15% 15%,
      rgba(99, 102, 241, 0.10),
      transparent 30%
    ),
    radial-gradient(
      circle at 85% 85%,
      rgba(14, 165, 233, 0.09),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      #eef2f7 0%,
      #f4f6fa 50%,
      #e9eef5 100%
    );

  font-family: "Poppins", Arial, sans-serif;
}


/* =========================================================
   WRAPPER
========================================================= */

.student-enrollment-wrapper {
  width: 100%;
  max-width: 590px;
  perspective: 1200px;
}


/* =========================================================
   MAIN CARD
========================================================= */

.student-enrollment-card {
  position: relative;

  padding: 34px;

  background:
    linear-gradient(
      145deg,
      #f8fafc,
      #edf1f6
    );

  border: 1px solid rgba(255, 255, 255, 0.75);

  border-radius: 26px;

  box-shadow:
    18px 18px 40px rgba(15, 23, 42, 0.12),
    -10px -10px 25px rgba(255, 255, 255, 0.80),
    inset 1px 1px 0 rgba(255, 255, 255, 0.80);

  transform: translateZ(0);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.student-enrollment-card:hover {
  transform: translateY(-4px);

  box-shadow:
    22px 24px 50px rgba(15, 23, 42, 0.15),
    -12px -12px 28px rgba(255, 255, 255, 0.85),
    inset 1px 1px 0 rgba(255, 255, 255, 0.90);
}


/* =========================================================
   HEADER
========================================================= */

.student-enrollment-header {
  display: flex;
  align-items: center;
  gap: 17px;
  margin-bottom: 28px;
}


/* ICON */

.student-enrollment-icon {
  width: 62px;
  height: 62px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      #edf4ff,
      #dce8f8
    );

  color: #2563eb;

  font-size: 25px;

  border: 1px solid rgba(255, 255, 255, 0.8);

  box-shadow:
    7px 7px 14px rgba(30, 64, 175, 0.12),
    -5px -5px 12px rgba(255, 255, 255, 0.85),
    inset 1px 1px 2px rgba(255, 255, 255, 0.9);
}

.student-enrollment-header h2 {
  margin: 0;

  font-size: 25px;
  font-weight: 750;

  letter-spacing: -0.3px;

  color: #172033;
}

.student-enrollment-header p {
  margin: 5px 0 0;

  color: #687386;

  font-size: 13px;
}


/* =========================================================
   COURSE BOX
========================================================= */

.student-course-box {
  display: flex;
  align-items: center;
  gap: 16px;

  padding: 19px;

  margin-bottom: 27px;

  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      #f5f8fc,
      #e8edf4
    );

  border: 1px solid rgba(255, 255, 255, 0.8);

  box-shadow:
    8px 8px 18px rgba(15, 23, 42, 0.09),
    -6px -6px 15px rgba(255, 255, 255, 0.9),
    inset 1px 1px 0 rgba(255, 255, 255, 0.7);
}


/* COURSE ICON */

.student-course-icon {
  width: 53px;
  height: 53px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 15px;

  background:
    linear-gradient(
      145deg,
      #3b82f6,
      #1d4ed8
    );

  color: #fff;

  font-size: 21px;

  box-shadow:
    7px 8px 15px rgba(37, 99, 235, 0.25),
    inset 1px 1px 1px rgba(255, 255, 255, 0.35);
}

.student-course-details {
  min-width: 0;
}

.student-course-label {
  display: block;

  font-size: 10px;
  font-weight: 800;

  letter-spacing: 1.2px;

  color: #7a8495;
}

.student-course-details h3 {
  margin: 4px 0;

  font-size: 18px;
  font-weight: 700;

  line-height: 1.4;

  color: #172033;

  word-break: break-word;
}

.student-course-details p {
  margin: 0;

  color: #737d8d;

  font-size: 12px;
}

.student-course-details p i {
  margin-right: 4px;
  color: #64748b;
}


/* =========================================================
   FORM
========================================================= */

.student-form-group {
  margin-bottom: 20px;
}

.student-form-label {
  display: block;

  margin-bottom: 8px;

  font-size: 13px;
  font-weight: 700;

  color: #394457;
}

.student-form-label i {
  margin-right: 6px;
  color: #2563eb;
}


/* =========================================================
   INPUT
========================================================= */

.student-form-control {
  width: 100%;

  min-height: 51px;

  padding: 12px 15px;

  box-sizing: border-box;

  border: 1px solid #dce2ea;

  border-radius: 13px;

  outline: none;

  background:
    linear-gradient(
      145deg,
      #edf1f6,
      #f6f8fa
    );

  color: #172033;

  font-family: inherit;

  font-size: 14px;

  box-shadow:
    inset 4px 4px 8px rgba(15, 23, 42, 0.06),
    inset -4px -4px 8px rgba(255, 255, 255, 0.75);

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.student-form-control:focus {
  border-color: #7aa7f7;

  box-shadow:
    inset 3px 3px 7px rgba(15, 23, 42, 0.05),
    inset -3px -3px 7px rgba(255, 255, 255, 0.8),
    0 0 0 3px rgba(37, 99, 235, 0.09);
}


/* STATUS */

.student-status-input {
  color: #8a6200;

  background:
    linear-gradient(
      145deg,
      #fff8df,
      #f8edc5
    );

  border-color: #f1d77b;

  font-weight: 700;

  box-shadow:
    inset 4px 4px 8px rgba(120, 80, 0, 0.06),
    inset -4px -4px 8px rgba(255, 255, 255, 0.65);
}


/* =========================================================
   FEE
========================================================= */

.student-fee-box {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 19px;

  margin: 5px 0 24px;

  border-radius: 16px;

  background:
    linear-gradient(
      145deg,
      #eaf8f0,
      #dcefe5
    );

  border: 1px solid #c9e6d5;

  box-shadow:
    7px 7px 15px rgba(25, 135, 84, 0.10),
    -5px -5px 12px rgba(255, 255, 255, 0.75),
    inset 1px 1px 0 rgba(255, 255, 255, 0.7);
}

.student-fee-box span {
  color: #52625a;

  font-size: 13px;
  font-weight: 600;
}

.student-fee-box strong {
  color: #16804d;

  font-size: 22px;
  font-weight: 800;

  letter-spacing: 0.2px;
}


/* =========================================================
   CONFIRM BUTTON
========================================================= */

.student-confirm-button {
  width: 100%;

  min-height: 56px;

  border: none;

  border-radius: 15px;

  background:
    linear-gradient(
      145deg,
      #22a968,
      #137b4c
    );

  color: #fff;

  font-family: inherit;

  font-size: 15px;
  font-weight: 750;

  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 10px;

  box-shadow:
    8px 10px 20px rgba(21, 115, 71, 0.24),
    inset 1px 1px 1px rgba(255, 255, 255, 0.35),
    inset -1px -1px 1px rgba(0, 0, 0, 0.10);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    opacity 0.2s ease;
}

.student-confirm-button:hover {
  transform: translateY(-3px);

  box-shadow:
    10px 14px 25px rgba(21, 115, 71, 0.28),
    inset 1px 1px 1px rgba(255, 255, 255, 0.4);
}

.student-confirm-button:active {
  transform: translateY(1px);

  box-shadow:
    4px 5px 10px rgba(21, 115, 71, 0.20),
    inset 2px 2px 5px rgba(0, 0, 0, 0.12);
}

.student-confirm-button.loading {
  opacity: 0.78;
  cursor: wait;
  transform: none;
}

.student-confirm-button:disabled {
  cursor: wait;
}


/* =========================================================
   BACK BUTTON
========================================================= */

.student-back-button {
  width: 100%;

  min-height: 48px;

  margin-top: 12px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 7px;

  border-radius: 13px;

  color: #697586;

  text-decoration: none;

  font-size: 13px;
  font-weight: 650;

  transition:
    color 0.2s ease,
    background 0.2s ease,
    transform 0.2s ease;
}

.student-back-button:hover {
  color: #172033;

  background:
    linear-gradient(
      145deg,
      #edf1f6,
      #f7f9fb
    );

  transform: translateY(-1px);

  box-shadow:
    5px 5px 12px rgba(15, 23, 42, 0.07),
    -4px -4px 10px rgba(255, 255, 255, 0.8);
}


/* =========================================================
   FOOTER
========================================================= */

.student-enrollment-footer {
  margin-top: 23px;

  padding-top: 18px;

  border-top: 1px solid #dfe5ec;

  text-align: center;

  color: #929baa;

  font-size: 11px;
}

.student-enrollment-footer i {
  margin-right: 5px;
  color: #198754;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 576px) {

  .student-enrollment-page {
    padding: 25px 12px;

    align-items: flex-start;
  }

  .student-enrollment-wrapper {
    margin-top: 15px;
  }

  .student-enrollment-card {
    padding: 23px 18px;

    border-radius: 21px;
  }

  .student-enrollment-header {
    gap: 13px;
    margin-bottom: 22px;
  }

  .student-enrollment-icon {
    width: 51px;
    height: 51px;

    border-radius: 15px;

    font-size: 21px;
  }

  .student-enrollment-header h2 {
    font-size: 20px;
  }

  .student-enrollment-header p {
    font-size: 12px;
  }

  .student-course-box {
    padding: 15px;

    gap: 12px;

    border-radius: 16px;
  }

  .student-course-icon {
    width: 45px;
    height: 45px;

    border-radius: 13px;

    font-size: 18px;
  }

  .student-course-details h3 {
    font-size: 15px;
  }

  .student-fee-box {
    padding: 16px;
  }

  .student-fee-box strong {
    font-size: 19px;
  }

  .student-confirm-button {
    min-height: 53px;

    font-size: 14px;
  }
}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

  .student-enrollment-card,
  .student-confirm-button,
  .student-back-button {
    transition: none;
  }

}
</style>


<div class="student-enrollment-page">

  <div class="student-enrollment-wrapper">

    <div class="student-enrollment-card">

      <!-- HEADER -->

      <div class="student-enrollment-header">

        <div class="student-enrollment-icon">
          <i class="bi bi-person-plus-fill"></i>
        </div>

        <div>
          <h2>
            Confirm Enrollment
          </h2>

          <p>
            Review your enrollment details
          </p>
        </div>

      </div>


      <!-- COURSE -->

      <div class="student-course-box">

        <div class="student-course-icon">
          <i class="bi bi-book-fill"></i>
        </div>

        <div class="student-course-details">

          <span class="student-course-label">
            COURSE
          </span>

          <h3>
            <%= @course.Course_name %>
          </h3>

          <% if @course.respond_to?(:duration) &&
                @course.duration.present? %>

            <p>
              <i class="bi bi-clock"></i>
              <%= @course.duration %>
            </p>

          <% end %>

        </div>

      </div>


      <!-- FORM -->

      <%= form_with model: [:student, @enrollment],
                    local: true,
                    id: "student-enrollment-form" do |f| %>


        <!-- STUDENT -->

        <div class="student-form-group">

          <label class="student-form-label">
            <i class="bi bi-person-fill"></i>
            Student
          </label>

          <input
            type="text"
            class="student-form-control"
            value="<%= current_user.name %>"
            readonly>

        </div>


        <!-- COURSE -->

        <div class="student-form-group">

          <label class="student-form-label">
            <i class="bi bi-book"></i>
            Selected Course
          </label>

          <input
            type="text"
            class="student-form-control"
            value="<%= @course.Course_name %>"
            readonly>

          <%= f.hidden_field :course_id,
                value: @course.id %>

        </div>


        <!-- STATUS -->

        <div class="student-form-group">

          <label class="student-form-label">
            <i class="bi bi-info-circle"></i>
            Enrollment Status
          </label>

          <input
            type="text"
            class="student-form-control student-status-input"
            value="Pending"
            readonly>

          <%= f.hidden_field :status,
                value: "Pending" %>

        </div>


        <!-- FEE -->

        <div class="student-fee-box">

          <span>
            Course Fee
          </span>

          <strong>

            <% if @course.free? %>

              FREE

            <% else %>

              ₹<%= number_with_precision(
                    @course.fee,
                    precision: 2
                  ) %>

            <% end %>

          </strong>

        </div>


        <!-- SUBMIT -->

        <button
          type="submit"
          class="student-confirm-button"
          id="student-confirm-button">

          <span id="student-confirm-icon">
            <i class="bi bi-check-circle-fill"></i>
          </span>

          <span id="student-confirm-text">
            Confirm Enrollment
          </span>

        </button>


        <!-- BACK -->

        <%= link_to course_details_path(@course),
              class: "student-back-button",
              id: "student-back-button" do %>

          <i class="bi bi-arrow-left"></i>

          Back to Course

        <% end %>


      <% end %>


      <!-- FOOTER -->

      <div class="student-enrollment-footer">

        <i class="bi bi-shield-check"></i>

        Your enrollment information is secure

      </div>

    </div>

  </div>

</div>


<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener("DOMContentLoaded", function () {

  const form = document.getElementById(
    "student-enrollment-form"
  );

  const button = document.getElementById(
    "student-confirm-button"
  );

  const icon = document.getElementById(
    "student-confirm-icon"
  );

  const text = document.getElementById(
    "student-confirm-text"
  );

  if (!form || !button) {
    return;
  }

  let submitted = false;

  form.addEventListener("submit", function (event) {

    if (submitted) {
      event.preventDefault();
      return;
    }

    submitted = true;

    button.disabled = true;

    button.classList.add("loading");

    if (icon) {
      icon.innerHTML =
        '<i class="bi bi-arrow-repeat"></i>';
    }

    if (text) {
      text.textContent =
        "Processing Enrollment...";
    }

  });

});
</script>