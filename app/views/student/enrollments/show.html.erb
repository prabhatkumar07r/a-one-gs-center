/* =========================================================
   MAIN CARD
========================================================= */

.enrollment-card {

  position: relative;

  background:
    linear-gradient(
      145deg,
      #fdfefe 0%,
      #f5f8fc 48%,
      #edf2f8 100%
    );

  border: 1px solid rgba(255,255,255,0.95);

  border-radius: 26px;

  padding: 36px;

  /*
   * Strong 3D depth
   */
  box-shadow:
    18px 20px 40px rgba(37, 50, 73, 0.14),
