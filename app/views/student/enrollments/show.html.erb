  border: 1px solid rgba(255,255,255,0.85);

  text-decoration: none;

  font-size: 14px;

  font-weight: 600;

  /*
   * 3D raised button
   */
  box-shadow:
    5px 5px 11px rgba(37, 50, 73, 0.12),
    -4px -4px 10px rgba(255,255,255,0.95);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
