<% content_for :show_layout, true %>

<div class="student-enrollment-page">

  <div class="student-enrollment-wrapper">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="enrollment-topbar">

      <%= link_to student_enrollments_path,
          class: "back-link" do %>

        <i class="bi bi-arrow-left"></i>
        My Enrollments

      <% end %>

    </div>


    <!-- =====================================================
         MAIN CARD
    ====================================================== -->

    <div class="enrollment-card">

      <!-- HEADER -->

      <div class="enrollment-header">

        <div class="enrollment-icon">
          <i class="bi bi-journal-check"></i>
        </div>

        <div class="enrollment-heading">

          <span class="small-label">
            ENROLLMENT DETAILS
          </span>

          <h1>
            <%= @enrollment.course.Course_name %>
          </h1>

          <p>
            Enrollment #<%= @enrollment.id %>
          </p>

        </div>

      </div>


      <!-- ===================================================
           STATUS
      ==================================================== -->
<div class="status-section">

  <span class="status-label">
    Enrollment Status
  </span>

  <% if @enrollment.status == "Approved" %>

    <span class="status-badge approved">
      <i class="bi bi-check-circle-fill"></i>
      Approved
    </span>

  <% elsif @enrollment.status == "Pending" %>

    <span class="status-badge pending">
      <i class="bi bi-clock-fill"></i>
      Pending
    </span>

  <% else %>

    <span class="status-badge cancelled">
      <i class="bi bi-x-circle-fill"></i>
      <%= @enrollment.status.presence || "Cancelled" %>
    </span>

  <% end %>

</div>

      <!-- ===================================================
           COURSE INFORMATION
      ==================================================== -->

      <div class="course-section">

        <div class="section-title">

          <i class="bi bi-book-fill"></i>

          <span>
            Course Information
          </span>

        </div>


        <div class="course-card">

          <div class="course-icon">
            <i class="bi bi-mortarboard-fill"></i>
          </div>

          <div class="course-info">

            <span class="course-label">
              COURSE
            </span>

            <h2>
              <%= @enrollment.course.Course_name %>
            </h2>

            <% if @enrollment.course.respond_to?(:duration) &&
                  @enrollment.course.duration.present? %>

              <p>
                <i class="bi bi-clock"></i>

                <%= @enrollment.course.duration %>
              </p>

            <% end %>

          </div>

        </div>

      </div>


      <!-- ===================================================
           ENROLLMENT INFORMATION
      ==================================================== -->

      <div class="details-section">

        <div class="section-title">

          <i class="bi bi-info-circle-fill"></i>

          <span>
            Enrollment Information
          </span>

        </div>


        <div class="details-grid">

          <!-- ENROLLMENT ID -->

          <div class="detail-item">

            <span class="detail-label">
              Enrollment ID
            </span>

            <strong>
              #<%= @enrollment.id %>
            </strong>

          </div>


          <!-- STUDENT -->

          <div class="detail-item">

            <span class="detail-label">
              Student
            </span>

            <strong>
              <%= current_user.name %>
            </strong>

          </div>


          <!-- EMAIL -->

          <div class="detail-item">

            <span class="detail-label">
              Email
            </span>

            <strong>
              <%= current_user.email %>
            </strong>

          </div>


          <!-- ENROLLED DATE -->

          <div class="detail-item">

            <span class="detail-label">
              Enrolled On
            </span>

            <strong>
              <%= @enrollment.created_at.strftime("%d %B %Y") %>
            </strong>

          </div>


          <!-- UPDATED DATE -->

          <div class="detail-item">

            <span class="detail-label">
              Last Updated
            </span>

            <strong>
              <%= @enrollment.updated_at.strftime("%d %B %Y") %>
            </strong>

          </div>


          <!-- COURSE FEE -->

          <div class="detail-item">

            <span class="detail-label">
              Course Fee
            </span>

            <strong class="fee-value">

              <% if @enrollment.course.free? %>

                FREE

              <% else %>

                ₹<%= number_with_precision(
                      @enrollment.course.fee,
                      precision: 2
                    ) %>

              <% end %>

            </strong>

          </div>

        </div>

      </div>


      <!-- ===================================================
           APPROVED MESSAGE
      ==================================================== -->

      <% if @enrollment.status == "Approved" %>

        <div class="message-box approved-message">

          <div class="message-icon">
            <i class="bi bi-check-circle-fill"></i>
          </div>

          <div>

            <h3>
              Course Access Granted
            </h3>

            <p>
              Your enrollment has been approved.
              You can now start learning this course.
            </p>

          </div>

        </div>


        <%= link_to learning_course_path(@enrollment.course),
            class: "primary-button" do %>

          <i class="bi bi-play-circle-fill"></i>

          Start Learning

        <% end %>


      <% elsif @enrollment.status == "Pending" %>


        <!-- =================================================
             PENDING MESSAGE
        ================================================== -->

        <div class="message-box pending-message">

          <div class="message-icon">
            <i class="bi bi-clock-fill"></i>
          </div>

          <div>

            <h3>
              Enrollment Pending
            </h3>

            <p>
              Your enrollment is currently pending.
              Please complete the payment or wait for
              administrator approval.
            </p>

          </div>

        </div>


        <%= link_to payment_path(@enrollment),
            class: "primary-button pending-button" do %>

          <i class="bi bi-credit-card-fill"></i>

          Continue Payment

        <% end %>


      <% else %>


        <!-- =================================================
             CANCELLED / REJECTED MESSAGE
        ================================================== -->

        <div class="message-box cancelled-message">

          <div class="message-icon">
            <i class="bi bi-x-circle-fill"></i>
          </div>

          <div>

            <h3>
              Enrollment Not Active
            </h3>

            <p>
              This enrollment is no longer active.
              You can return to the course and try again.
            </p>

          </div>

        </div>


        <%= link_to course_details_path(@enrollment.course),
            class: "primary-button" do %>

          <i class="bi bi-book-fill"></i>

          View Course

        <% end %>

      <% end %>


      <!-- ===================================================
           FOOTER
      ==================================================== -->

      <div class="enrollment-footer">

        <i class="bi bi-shield-check"></i>

        Your enrollment information is secure.

      </div>

    </div>

  </div>

</div>


<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script nonce="<%= content_security_policy_nonce %>">

(function () {

  "use strict";


  /* =========================================================
     ENROLLMENT PAGE INITIALIZATION
  ========================================================== */

  function initializeEnrollmentPage() {

    const card =
      document.querySelector(".enrollment-card");


    if (!card) {
      return;
    }


    /*
     * Prevent duplicate initialization
     */

    if (
      card.dataset.enrollmentInitialized === "true"
    ) {
      return;
    }


    card.dataset.enrollmentInitialized = "true";


    /* =======================================================
       ENTRANCE ANIMATION
    ======================================================== */

    card.classList.add(
      "enrollment-loaded"
    );


    /* =======================================================
       PREVENT ACCIDENTAL DOUBLE CLICK
    ======================================================== */

    const buttons =
      card.querySelectorAll(
        ".primary-button"
      );


    buttons.forEach(function (button) {

      if (
        button.dataset.loadingInitialized === "true"
      ) {
        return;
      }


      button.dataset.loadingInitialized = "true";


      button.addEventListener(
        "click",
        function () {

          /*
           * Do not interfere with disabled buttons.
           */

          if (button.disabled) {
            return;
          }


          button.classList.add(
            "button-loading"
          );

        }
      );

    });

  }


  /* =========================================================
     TURBO NAVIGATION
  ========================================================== */

  document.addEventListener(
    "turbo:load",
    initializeEnrollmentPage
  );


  /* =========================================================
     NORMAL PAGE LOAD
  ========================================================== */

  if (
    document.readyState !== "loading"
  ) {

    initializeEnrollmentPage();

  } else {

    document.addEventListener(
      "DOMContentLoaded",
      initializeEnrollmentPage,
      { once: true }
    );

  }

})();

</script>

<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   STUDENT ENROLLMENT — PREMIUM 3D SOFT WHITE THEME
========================================================= */

.student-enrollment-page {

  min-height: 100vh;

  padding: 42px 20px 65px;
  padding-top: 100px;

  /*
   * Soft white background.
   * Not pure white.
   */
  background:
    radial-gradient(
      circle at 15% 10%,
      rgba(219, 231, 255, 0.55),
      transparent 30%
    ),
    radial-gradient(
      circle at 85% 85%,
      rgba(226, 235, 255, 0.50),
      transparent 32%
    ),
    linear-gradient(
      135deg,
      #f4f7fc 0%,
      #edf2f8 48%,
      #f7f9fc 100%
    );

  font-family:
    "Poppins",
    Arial,
    sans-serif;

  box-sizing: border-box;

  color: #263247;

  position: relative;

  overflow: hidden;
}


.student-enrollment-page::before {

  content: "";

  position: absolute;

  width: 320px;

  height: 320px;

  top: -150px;

  right: -100px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(255,255,255,0.75),
      rgba(255,255,255,0)
    );

  pointer-events: none;
}


.student-enrollment-page::after {

  content: "";

  position: absolute;

  width: 260px;

  height: 260px;

  bottom: -120px;

  left: -100px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(255,255,255,0.65),
      rgba(255,255,255,0)
    );

  pointer-events: none;
}


/* =========================================================
   WRAPPER
========================================================= */

.student-enrollment-wrapper {

  position: relative;

  z-index: 2;

  width: 100%;

  max-width: 850px;

  margin: 0 auto;
}


/* =========================================================
   TOP BAR
========================================================= */

.enrollment-topbar {

