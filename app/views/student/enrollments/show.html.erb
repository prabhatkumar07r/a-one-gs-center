<% content_for :show_layout, true %>

<div class="student-enrollment-page">

  <div class="student-enrollment-wrapper">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="enrollment-topbar">

      <%= link_to student_enrollments_path,
          class: "back-link" do %>

        <i class="bi bi-arrow-left"></i>
        My Enrollments

      <% end %>

    </div>


    <!-- =====================================================
         MAIN CARD
    ====================================================== -->

    <div class="enrollment-card">

      <!-- HEADER -->

      <div class="enrollment-header">

        <div class="enrollment-icon">
          <i class="bi bi-journal-check"></i>
        </div>

        <div class="enrollment-heading">

          <span class="small-label">
            ENROLLMENT DETAILS
          </span>

          <h1>
            <%= @enrollment.course.Course_name %>
          </h1>

          <p>
            Enrollment #<%= @enrollment.id %>
          </p>

        </div>

      </div>


      <!-- ===================================================
           STATUS
      ==================================================== -->

      <div class="status-section">

        <span class="status-label">
          Enrollment Status
        </span>

        <% case @enrollment.status %>

        <% when "Approved" %>

          <span class="status-badge approved">
            <i class="bi bi-check-circle-fill"></i>
            Approved
          </span>

        <% when "Pending" %>

          <span class="status-badge pending">
            <i class="bi bi-clock-fill"></i>
            Pending
          </span>

        <% else %>

          <span class="status-badge cancelled">
            <i class="bi bi-x-circle-fill"></i>
            <%= @enrollment.status.presence || "Cancelled" %>
          </span>

        <% end %>

      </div>


      <!-- ===================================================
           COURSE INFORMATION
      ==================================================== -->

      <div class="course-section">

        <div class="section-title">

          <i class="bi bi-book-fill"></i>

          <span>
            Course Information
          </span>

        </div>


        <div class="course-card">

          <div class="course-icon">
            <i class="bi bi-mortarboard-fill"></i>
          </div>

          <div class="course-info">

            <span class="course-label">
              COURSE
            </span>

            <h2>
              <%= @enrollment.course.Course_name %>
            </h2>

            <% if @enrollment.course.respond_to?(:duration) &&
                  @enrollment.course.duration.present? %>

              <p>
                <i class="bi bi-clock"></i>

                <%= @enrollment.course.duration %>
              </p>

            <% end %>

          </div>

        </div>

      </div>


      <!-- ===================================================
           ENROLLMENT INFORMATION
      ==================================================== -->

      <div class="details-section">

        <div class="section-title">

          <i class="bi bi-info-circle-fill"></i>

          <span>
            Enrollment Information
          </span>

        </div>


        <div class="details-grid">

          <!-- ENROLLMENT ID -->

          <div class="detail-item">

            <span class="detail-label">
              Enrollment ID
            </span>

            <strong>
              #<%= @enrollment.id %>
            </strong>

          </div>


          <!-- STUDENT -->

          <div class="detail-item">

            <span class="detail-label">
              Student
            </span>

            <strong>
              <%= current_user.name %>
            </strong>

          </div>


          <!-- EMAIL -->

          <div class="detail-item">

            <span class="detail-label">
              Email
            </span>

            <strong>
              <%= current_user.email %>
            </strong>

          </div>


          <!-- ENROLLED DATE -->

          <div class="detail-item">

            <span class="detail-label">
              Enrolled On
            </span>

            <strong>
              <%= @enrollment.created_at.strftime("%d %B %Y") %>
            </strong>

          </div>


          <!-- UPDATED DATE -->

          <div class="detail-item">

            <span class="detail-label">
              Last Updated
            </span>

            <strong>
              <%= @enrollment.updated_at.strftime("%d %B %Y") %>
            </strong>

          </div>


          <!-- COURSE FEE -->

          <div class="detail-item">

            <span class="detail-label">
              Course Fee
            </span>

            <strong class="fee-value">

              <% if @enrollment.course.free? %>

                FREE

              <% else %>

                ₹<%= number_with_precision(
                      @enrollment.course.fee,
                      precision: 2
                    ) %>

              <% end %>

            </strong>

          </div>

        </div>

      </div>


      <!-- ===================================================
           APPROVED MESSAGE
      ==================================================== -->

      <% if @enrollment.status == "Approved" %>

        <div class="message-box approved-message">

          <div class="message-icon">
            <i class="bi bi-check-circle-fill"></i>
          </div>

          <div>

            <h3>
              Course Access Granted
            </h3>

            <p>
              Your enrollment has been approved.
              You can now start learning this course.
            </p>

          </div>

        </div>


        <%= link_to learning_course_path(@enrollment.course),
            class: "primary-button" do %>

          <i class="bi bi-play-circle-fill"></i>

          Start Learning

        <% end %>


      <% elsif @enrollment.status == "Pending" %>


        <!-- =================================================
             PENDING MESSAGE
        ================================================== -->

        <div class="message-box pending-message">

          <div class="message-icon">
            <i class="bi bi-clock-fill"></i>
          </div>

          <div>

            <h3>
              Enrollment Pending
            </h3>

            <p>
              Your enrollment is currently pending.
              Please complete the payment or wait for
              administrator approval.
            </p>

          </div>

        </div>


        <%= link_to payment_path(@enrollment),
            class: "primary-button pending-button" do %>

          <i class="bi bi-credit-card-fill"></i>

          Continue Payment

        <% end %>


      <% else %>


        <!-- =================================================
             CANCELLED / REJECTED MESSAGE
        ================================================== -->

        <div class="message-box cancelled-message">

          <div class="message-icon">
            <i class="bi bi-x-circle-fill"></i>
          </div>

          <div>

            <h3>
              Enrollment Not Active
            </h3>

            <p>
              This enrollment is no longer active.
              You can return to the course and try again.
            </p>

          </div>

        </div>


        <%= link_to course_details_path(@enrollment.course),
            class: "primary-button" do %>

          <i class="bi bi-book-fill"></i>

          View Course

        <% end %>

      <% end %>


      <!-- ===================================================
           FOOTER
      ==================================================== -->

      <div class="enrollment-footer">

        <i class="bi bi-shield-check"></i>

        Your enrollment information is secure.

      </div>

    </div>

  </div>

</div>


<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

document.addEventListener("DOMContentLoaded", function () {

  const card =
    document.querySelector(".enrollment-card");

  if (!card) {
    return;
  }


  /*
   * Small entrance animation
   */

  card.classList.add("enrollment-loaded");


  /*
   * Prevent accidental double-click
   */

  const buttons =
    document.querySelectorAll(".primary-button");

  buttons.forEach(function (button) {

    button.addEventListener("click", function () {

      button.classList.add("button-loading");

    });

  });

});

</script>


<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   PAGE
========================================================= */

.student-enrollment-page {

  min-height: 100vh;

  padding: 40px 20px 60px;

  background:
    linear-gradient(
      135deg,
      #f4f7fb 0%,
      #eef3ff 100%
    );

  font-family:
    "Poppins",
    Arial,
    sans-serif;

  box-sizing: border-box;
}


/* =========================================================
   WRAPPER
========================================================= */

.student-enrollment-wrapper {

  width: 100%;

  max-width: 850px;

  margin: 0 auto;
}


/* =========================================================
   TOP BAR
========================================================= */

.enrollment-topbar {

  margin-bottom: 18px;
}


.back-link {

  display: inline-flex;

  align-items: center;

  gap: 8px;

  padding: 9px 15px;

  border-radius: 10px;

  color: #4b5563;

  background: #ffffff;

  border: 1px solid #e5eaf2;

  text-decoration: none;

  font-size: 14px;

  font-weight: 600;

  transition: all 0.2s ease;
}


.back-link:hover {

  color: #0d6efd;

  border-color: #b9d3ff;

  transform: translateX(-2px);
}


/* =========================================================
   CARD
========================================================= */

.enrollment-card {

  background: #ffffff;

  border: 1px solid #e5eaf2;

  border-radius: 24px;

  padding: 34px;

  box-shadow:
    0 18px 55px
    rgba(15, 23, 42, 0.10);

  opacity: 0;

  transform: translateY(12px);

  transition:
    opacity 0.35s ease,
    transform 0.35s ease;
}


.enrollment-card.enrollment-loaded {

  opacity: 1;

  transform: translateY(0);
}


/* =========================================================
   HEADER
========================================================= */

.enrollment-header {

  display: flex;

  align-items: center;

  gap: 18px;

  padding-bottom: 26px;

  border-bottom: 1px solid #edf0f5;
}


.enrollment-icon {

  width: 64px;

  height: 64px;

  display: flex;

  align-items: center;

  justify-content: center;

  flex-shrink: 0;

  border-radius: 17px;

  background: #e8f1ff;

  color: #0d6efd;

  font-size: 26px;
}


.enrollment-heading {

  min-width: 0;
}


.small-label {

  display: block;

  margin-bottom: 4px;

  color: #6b7280;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: 1.3px;
}


.enrollment-heading h1 {

  margin: 0;

  color: #172033;

  font-size: 25px;

  font-weight: 750;

  line-height: 1.3;

  word-break: break-word;
}


.enrollment-heading p {

  margin: 5px 0 0;

  color: #8a93a3;

  font-size: 13px;
}


/* =========================================================
   STATUS
========================================================= */

.status-section {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  padding: 20px 0;

  border-bottom: 1px solid #edf0f5;
}


.status-label {

  color: #4b5563;

  font-size: 14px;

  font-weight: 600;
}


.status-badge {

  display: inline-flex;

  align-items: center;

  gap: 7px;

  padding: 8px 14px;

  border-radius: 999px;

  font-size: 13px;

  font-weight: 700;
}


.status-badge.approved {

  color: #146c43;

  background: #d1e7dd;
}


.status-badge.pending {

  color: #856404;

  background: #fff3cd;
}


.status-badge.cancelled {

  color: #842029;

  background: #f8d7da;
}


/* =========================================================
   SECTIONS
========================================================= */

.course-section,
.details-section {

  padding-top: 27px;
}


.section-title {

  display: flex;

  align-items: center;

  gap: 9px;

  margin-bottom: 15px;

  color: #172033;

  font-size: 16px;

  font-weight: 700;
}


.section-title i {

  color: #0d6efd;

  font-size: 17px;
}


/* =========================================================
   COURSE CARD
========================================================= */

.course-card {

  display: flex;

  align-items: center;

  gap: 16px;

  padding: 19px;

  background: #f8fafc;

  border: 1px solid #e8edf4;

  border-radius: 16px;
}


.course-icon {

  width: 56px;

  height: 56px;

  display: flex;

  align-items: center;

  justify-content: center;

  flex-shrink: 0;

  border-radius: 14px;

  background: #0d6efd;

  color: #ffffff;

  font-size: 23px;
}


.course-info {

  min-width: 0;
}


.course-label {

  display: block;

  margin-bottom: 3px;

  color: #8992a2;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: 1px;
}


.course-info h2 {

  margin: 0;

  color: #172033;

  font-size: 19px;

  font-weight: 700;

  line-height: 1.35;

  word-break: break-word;
}


.course-info p {

  margin: 5px 0 0;

  color: #6b7280;

  font-size: 13px;
}


.course-info p i {

  margin-right: 4px;

  color: #0d6efd;
}


/* =========================================================
   DETAILS GRID
========================================================= */

.details-grid {

  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 12px;
}


.detail-item {

  padding: 16px;

  border: 1px solid #e8edf4;

  border-radius: 13px;

  background: #fbfcfe;
}


.detail-label {

  display: block;

  margin-bottom: 5px;

  color: #8a93a3;

  font-size: 11px;

  font-weight: 600;

  text-transform: uppercase;

  letter-spacing: 0.5px;
}


.detail-item strong {

  display: block;

  color: #273246;

  font-size: 14px;

  word-break: break-word;
}


.detail-item .fee-value {

  color: #198754;

  font-size: 16px;
}


/* =========================================================
   MESSAGE BOX
========================================================= */

.message-box {

  display: flex;

  align-items: flex-start;

  gap: 13px;

  margin-top: 27px;

  padding: 18px;

  border-radius: 15px;

  border: 1px solid;
}


.message-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 40px;

  height: 40px;

  flex-shrink: 0;

  border-radius: 11px;

  font-size: 18px;
}


.message-box h3 {

  margin: 0 0 4px;

  font-size: 15px;

  font-weight: 700;
}


.message-box p {

  margin: 0;

  font-size: 13px;

  line-height: 1.6;
}


/* APPROVED */

.approved-message {

  background: #f0fdf4;

  border-color: #d1fae5;

  color: #166534;
}


.approved-message .message-icon {

  background: #dcfce7;

  color: #198754;
}


/* PENDING */

.pending-message {

  background: #fffaf0;

  border-color: #ffe8a1;

  color: #856404;
}


.pending-message .message-icon {

  background: #fff3cd;

  color: #856404;
}


/* CANCELLED */

.cancelled-message {

  background: #fff5f5;

  border-color: #f5c2c7;

  color: #842029;
}


.cancelled-message .message-icon {

  background: #f8d7da;

  color: #842029;
}


/* =========================================================
   PRIMARY BUTTON
========================================================= */

.primary-button {

  width: 100%;

  min-height: 54px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 9px;

  margin-top: 17px;

  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      #0d6efd,
      #0a58ca
    );

  color: #ffffff;

  text-decoration: none;

  font-size: 15px;

  font-weight: 700;

  box-shadow:
    0 8px 20px
    rgba(13, 110, 253, 0.20);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    opacity 0.2s ease;
}


.primary-button:hover {

  color: #ffffff;

  transform: translateY(-2px);

  box-shadow:
    0 12px 25px
    rgba(13, 110, 253, 0.28);
}


.primary-button.pending-button {

  background:
    linear-gradient(
      135deg,
      #198754,
      #157347
    );

  box-shadow:
    0 8px 20px
    rgba(25, 135, 84, 0.20);
}


.primary-button.pending-button:hover {

  box-shadow:
    0 12px 25px
    rgba(25, 135, 84, 0.28);
}


.primary-button.button-loading {

  opacity: 0.65;

  pointer-events: none;
}


/* =========================================================
   FOOTER
========================================================= */

.enrollment-footer {

  margin-top: 25px;

  padding-top: 18px;

  border-top: 1px solid #edf0f5;

  text-align: center;

  color: #9ca3af;

  font-size: 12px;
}


.enrollment-footer i {

  margin-right: 5px;

  color: #198754;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 768px) {

  .student-enrollment-page {

    padding: 30px 15px 45px;
  }


  .enrollment-card {

    padding: 25px;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 576px) {

  .student-enrollment-page {

    padding: 20px 10px 35px;
  }


  .enrollment-card {

    padding: 20px 17px;

    border-radius: 18px;
  }


  .enrollment-header {

    gap: 13px;

    padding-bottom: 21px;
  }


  .enrollment-icon {

    width: 51px;

    height: 51px;

    border-radius: 14px;

    font-size: 21px;
  }


  .enrollment-heading h1 {

    font-size: 19px;
  }


  .status-section {

    align-items: flex-start;

    flex-direction: column;
  }


  .course-card {

    padding: 14px;
  }


  .course-icon {

    width: 47px;

    height: 47px;

    font-size: 20px;
  }


  .course-info h2 {

    font-size: 16px;
  }


  .details-grid {

    grid-template-columns: 1fr;
  }


  .message-box {

    padding: 14px;
  }


  .primary-button {

    min-height: 51px;
  }

}

</style>