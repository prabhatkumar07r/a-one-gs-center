<%= render "layouts/header" %>
  <div class="card shadow">

    <div class="card-header bg-primary text-white">
      <h3>Demo Request Details</h3>
    </div>

    <div class="card-body">

      <p><strong>Name:</strong> <%= @demo.name %></p>

      <p><strong>Phone:</strong> <%= @demo.phone %></p>

      <p><strong>Email:</strong> <%= @demo.email %></p>

      <p><strong>Course:</strong> <%= @demo.course %></p>

      <p><strong>Batch:</strong> <%= @demo.batch %></p>

      <p><strong>City:</strong> <%= @demo.city %></p>

      <p><strong>Preferred Time:</strong> <%= @demo.preferred_time %></p>

      <p><strong>Status:</strong> <%= @demo.status %></p>

    </div>
    <div class="d-flex justify-content-between mt-4">

  <%= link_to "← Back", demos_path, class: "btn btn-outline-secondary" %>

  <%= link_to "✏ Edit",
      edit_demo_path(@demo),
      class: "btn btn-warning" %>

</div>

  </div>
  <%= render "layouts/footer" %>

<%# </div> %>