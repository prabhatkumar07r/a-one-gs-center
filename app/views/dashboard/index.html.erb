<div class="container-fluid">

  <!-- Page Heading -->
  <div class="d-flex justify-content-between align-items-center mb-4">

    <h2 class="fw-bold">Dashboard</h2>

    <div>
      <%= link_to new_student_path, class: "btn btn-primary me-2" do %>
        <i class="bi bi-person-plus-fill"></i>
        Add Student
      <% end %>

      <%= link_to new_course_path, class: "btn btn-success" do %>
        <i class="bi bi-book-fill"></i>
        Add Course
      <% end %>
    </div>

  </div>

  <!-- Statistics -->
  <div class="row g-4">

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card bg-primary text-white border-0 shadow">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h6>Total Students</h6>
            <h2><%= @students %></h2>
          </div>
          <i class="bi bi-mortarboard-fill display-4"></i>
        </div>
      </div>
    </div>

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card bg-success text-white border-0 shadow">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h6>Total Teachers</h6>
            <h2><%= @teachers %></h2>
          </div>
          <i class="bi bi-person-workspace display-4"></i>
        </div>
      </div>
    </div>

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card bg-warning text-dark border-0 shadow">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h6>Total Courses</h6>
            <h2><%= @courses %></h2>
          </div>
          <i class="bi bi-book-fill display-4"></i>
        </div>
      </div>
    </div>

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card bg-danger text-white border-0 shadow">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h6>Total Videos</h6>
            <h2><%= @videos %></h2>
          </div>
          <i class="bi bi-play-circle-fill display-4"></i>
        </div>
      </div>
    </div>

  </div>

  <!-- Second Row -->
  <div class="row g-4 mt-2">

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card bg-info text-white border-0 shadow">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h6>Playlists</h6>
            <h2><%= @playlists %></h2>
          </div>
          <i class="bi bi-collection-play-fill display-4"></i>
        </div>
      </div>
    </div>

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card bg-secondary text-white border-0 shadow">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h6>Resources</h6>
            <h2><%= @resources %></h2>
          </div>
          <i class="bi bi-file-earmark-fill display-4"></i>
        </div>
      </div>
    </div>

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card bg-dark text-white border-0 shadow">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h6>Enrollments</h6>
            <h2><%= @enrollments %></h2>
          </div>
          <i class="bi bi-person-check-fill display-4"></i>
        </div>
      </div>
    </div>

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card bg-primary text-white border-0 shadow">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h6>Demo Requests</h6>
            <h2><%= @demos %></h2>
          </div>
          <i class="bi bi-people-fill display-4"></i>
        </div>
      </div>
    </div>

  </div>

  <!-- Quick Actions -->
  <div class="row mt-4">

    <div class="col-lg-12">

      <div class="card shadow border-0">

        <div class="card-header bg-white">
          <h5 class="mb-0">Quick Actions</h5>
        </div>

        <div class="card-body">

          <div class="row g-3">

            <div class="col-md-3">
              <%= link_to new_student_path, class: "btn btn-primary w-100 py-3" do %>
                <i class="bi bi-person-plus-fill"></i><br>
                Add Student
              <% end %>
            </div>

            <div class="col-md-3">
              <%= link_to new_teacher_path, class: "btn btn-success w-100 py-3" do %>
                <i class="bi bi-person-workspace"></i><br>
                Add Teacher
              <% end %>
            </div>

            <div class="col-md-3">
              <%= link_to new_course_path, class: "btn btn-warning w-100 py-3" do %>
                <i class="bi bi-book-fill"></i><br>
                Add Course
              <% end %>
            </div>

            <div class="col-md-3">
              <%= link_to new_notification_path, class: "btn btn-danger w-100 py-3" do %>
                <i class="bi bi-bell-fill"></i><br>
                Send Notification
              <% end %>
            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

  <!-- Charts -->
  <div class="row mt-4">

    <div class="col-lg-6">

      <div class="card shadow border-0">

        <div class="card-header bg-white">
          Student & Teacher Ratio
        </div>

        <div class="card-body">
          <%= pie_chart({
            "Students" => @students,
            "Teachers" => @teachers
          }) %>
        </div>

      </div>

    </div>

    <div class="col-lg-6">

      <div class="card shadow border-0">

        <div class="card-header bg-white">
          System Statistics
        </div>

        <div class="card-body">
          <%= column_chart({
            "Courses" => @courses,
            "Enrollments" => @enrollments,
            "Payments" => @payments,
            "Demo" => @demos
          }) %>
        </div>

      </div>

    </div>

  </div>

  <!-- Recent Students -->
  <div class="card shadow border-0 mt-4">

    <div class="card-header bg-white">
      <h5 class="mb-0">Recent Students</h5>
    </div>

    <div class="table-responsive">

      <table class="table table-hover mb-0">

        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Mobile</th>
          </tr>
        </thead>

        <tbody>

          <% @recent_students.each do |student| %>

            <tr>
              <td><%= student.name %></td>
              <td><%= student.email %></td>
              <td><%= student.mobile %></td>
            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>

  <!-- Recent Payments -->
  <div class="card shadow border-0 mt-4">

    <div class="card-header bg-white">
      <h5 class="mb-0">Recent Payments</h5>
    </div>

    <div class="table-responsive">

      <table class="table table-hover mb-0">

        <thead class="table-light">
          <tr>
            <th>Student</th>
            <th>Amount</th>
            <th>Date</th>
          </tr>
        </thead>

        <tbody>

          <% @recent_payments.each do |payment| %>

            <tr>
              <td><%= payment.enrollment.user.name %></td>
              <td>₹ <%= payment.amount %></td>
              <td><%= payment.created_at.strftime("%d %b %Y") %></td>
            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>

</div>