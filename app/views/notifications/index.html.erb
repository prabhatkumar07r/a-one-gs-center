<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   NOTIFICATIONS PAGE
   Override Admin Layout Styling
========================================================= */

.admin-notifications-page {
  width: 100%;
  min-height: calc(100vh - 110px);

  padding: 0;
  margin: 0;

  color: #1f2937;
}


/* =========================================================
   PAGE HEADER
========================================================= */

.notification-page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 28px;
}

.notification-header-left {
  min-width: 0;
}

.notification-kicker {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  margin-bottom: 8px;

  color: #7c3aed;

  font-size: 12px;
  font-weight: 800;

  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.notification-page-title {
  margin: 0;

  color: #17121f;

  font-size: clamp(28px, 3vw, 40px);
  font-weight: 800;

  letter-spacing: -0.8px;
}

.notification-page-description {
  margin: 7px 0 0;

  color: #6b7280;

  font-size: 15px;
}


/* =========================================================
   HEADER ICON
========================================================= */

.notification-header-icon {
  width: 58px;
  height: 58px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f1e8ff
    );

  color: #7c3aed;

  font-size: 23px;

  box-shadow:
    0 12px 28px rgba(91, 33, 182, 0.13),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  transform: perspective(500px) rotateX(2deg);
}


/* =========================================================
   NEW NOTIFICATION BUTTON
========================================================= */

.notification-new-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  padding: 12px 19px;

  border: 0;
  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #9333ea
    );

  color: #ffffff !important;

  font-size: 14px;
  font-weight: 700;

  text-decoration: none;

  box-shadow:
    0 10px 22px rgba(124, 58, 237, 0.25),
    0 3px 6px rgba(124, 58, 237, 0.12);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.notification-new-button:hover {
  color: #ffffff !important;

  transform: translateY(-2px);

  box-shadow:
    0 15px 30px rgba(124, 58, 237, 0.30);
}

.notification-new-button:active {
  transform: translateY(0);
}


/* =========================================================
   NOTICE ALERT
========================================================= */

.notification-notice {
  display: flex;
  align-items: center;
  gap: 10px;

  margin-bottom: 22px;

  padding: 13px 17px;

  border: 1px solid rgba(16, 185, 129, 0.15);
  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      rgba(236, 253, 245, 0.95),
      rgba(255, 255, 255, 0.95)
    );

  color: #047857;

  box-shadow:
    0 8px 22px rgba(16, 185, 129, 0.08);
}


/* =========================================================
   NOTIFICATION GRID
========================================================= */

.notifications-list {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 20px;
}


/* =========================================================
   NOTIFICATION CARD
========================================================= */

.notification-card {
  position: relative;

  overflow: hidden;

  border: 1px solid rgba(124, 58, 237, 0.09);
  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #ffffff 0%,
      #fcfaff 55%,
      #f8f4ff 100%
    );

  box-shadow:
    0 12px 30px rgba(31, 41, 55, 0.07),
    0 3px 8px rgba(124, 58, 237, 0.04);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.notification-card::before {
  content: "";

  position: absolute;

  top: 0;
  left: 0;

  width: 100%;
  height: 4px;

  background:
    linear-gradient(
      90deg,
      #7c3aed,
      #a855f7,
      #c084fc
    );
}

.notification-card:hover {
  transform: translateY(-4px);

  box-shadow:
    0 20px 40px rgba(31, 41, 55, 0.10),
    0 8px 18px rgba(124, 58, 237, 0.08);
}

.notification-card-body {
  padding: 24px;
}


/* =========================================================
   CARD TOP
========================================================= */

.notification-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 15px;

  margin-bottom: 16px;
}

.notification-icon {
  width: 48px;
  height: 48px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      #f3e8ff,
      #ede9fe
    );

  color: #7c3aed;

  font-size: 20px;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.9),
    0 7px 15px rgba(124,58,237,0.08);
}


/* =========================================================
   VIEW BUTTON
========================================================= */

.notification-view-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 7px;

  padding: 9px 13px;

  border: 1px solid rgba(124, 58, 237, 0.15);
  border-radius: 10px;

  background: #ffffff;

  color: #6d28d9 !important;

  font-size: 13px;
  font-weight: 700;

  text-decoration: none;

  box-shadow:
    0 4px 10px rgba(91, 33, 182, 0.06);

  transition: all 0.2s ease;
}

.notification-view-button:hover {
  background: #f7f1ff;

  color: #5b21b6 !important;

  transform: translateY(-1px);

  box-shadow:
    0 7px 15px rgba(91, 33, 182, 0.10);
}


/* =========================================================
   EMPTY STATE
========================================================= */

.notification-empty {
  grid-column: 1 / -1;

  padding: 65px 25px;

  text-align: center;

  border: 1px solid rgba(124, 58, 237, 0.08);
  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #faf7ff
    );

  box-shadow:
    0 12px 30px rgba(31, 41, 55, 0.06);
}

.notification-empty-icon {
  width: 70px;
  height: 70px;

  margin: 0 auto 18px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 20px;

  background: #f3e8ff;

  color: #7c3aed;

  font-size: 30px;
}

.notification-empty h3 {
  margin: 0 0 7px;

  color: #1f2937;

  font-size: 20px;
  font-weight: 800;
}

.notification-empty p {
  margin: 0 0 20px;

  color: #6b7280;

  font-size: 14px;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 991px) {

  .notifications-list {
    grid-template-columns: 1fr;
  }

}


@media (max-width: 768px) {

  .notification-page-header {
    align-items: flex-start;

    flex-direction: column;
  }

  .notification-header-icon {
    display: none;
  }

  .notification-new-button {
    width: 100%;
  }

  .notification-card-body {
    padding: 19px;
  }

}


@media (max-width: 480px) {

  .notification-page-title {
    font-size: 27px;
  }

  .notification-page-description {
    font-size: 13px;
  }

  .notification-card-top {
    flex-direction: column;
  }

  .notification-view-button {
    width: 100%;
  }

}

</style>


<% content_for :title, "Notifications" %>

<div class="admin-notifications-page">

  <!-- =====================================================
       BACK BUTTON
  ====================================================== -->

  <%= render "admin/shared/back_button" %>


  <!-- =====================================================
       NOTICE
  ====================================================== -->

  <% if notice.present? %>

    <div class="notification-notice">
      <i class="bi bi-check-circle-fill"></i>

      <span>
        <%= notice %>
      </span>
    </div>

  <% end %>


  <!-- =====================================================
       PAGE HEADER
  ====================================================== -->

  <div class="notification-page-header">

    <div class="notification-header-left">

      <span class="notification-kicker">
        <i class="bi bi-bell-fill"></i>
        NOTIFICATIONS
      </span>

      <h1 class="notification-page-title">
        Notifications
      </h1>

      <p class="notification-page-description">
        Manage notifications for students and users.
      </p>

    </div>


    <div>

      <%= link_to new_notification_path,
                  class: "notification-new-button" do %>

        <i class="bi bi-plus-circle"></i>

        New Notification

      <% end %>

    </div>

  </div>


  <!-- =====================================================
       NOTIFICATIONS
  ====================================================== -->

  <div id="notifications" class="notifications-list">

    <% if @notifications.any? %>

      <% @notifications.each do |notification| %>

        <div class="notification-card">

          <div class="notification-card-body">

            <div class="notification-card-top">

              <div class="notification-icon">
                <i class="bi bi-bell-fill"></i>
              </div>

              <%= link_to notification,
                          class: "notification-view-button" do %>

                <i class="bi bi-eye"></i>

                View Notification

              <% end %>

            </div>


            <%= render notification %>

          </div>

        </div>

      <% end %>

    <% else %>

      <div class="notification-empty">

        <div class="notification-empty-icon">
          <i class="bi bi-bell"></i>
        </div>

        <h3>
          No notifications yet
        </h3>

        <p>
          Create your first notification for students.
        </p>

        <%= link_to new_notification_path,
                    class: "notification-new-button" do %>

          <i class="bi bi-plus-circle"></i>

          Create Notification

        <% end %>

      </div>

    <% end %>

  </div>

</div>