<style>
  css
.admin-layout {
  display: flex;
  min-height: 100vh;
}

.admin-main {
  flex: 1;
  margin-left: 260px;
  min-width: 0;
  background: #f8f9fa;
}

@media (max-width: 991px) {
  .admin-main {
    margin-left: 0;
  }
}


</style>
<% content_for :title, "Notifications" %>

<div class="admin-layout">
  <%= render "layouts/admin_sidebar" %>

  <main class="admin-main">
    <div class="container-fluid py-4">

      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="fw-bold mb-1">Notifications</h1>
          <p class="text-muted mb-0">
            Manage notifications for students and users.
          </p>
        </div>

        <%= link_to new_notification_path, class: "btn btn-primary" do %>
          <i class="bi bi-plus-circle me-1"></i>
          New Notification
        <% end %>
      </div>

      <div id="notifications">
        <% if @notifications.any? %>
          <% @notifications.each do |notification| %>
            <div class="card border-0 shadow-sm mb-3">
              <div class="card-body">
                <%= render notification %>

                <div class="mt-3">
                  <%= link_to notification, class: "btn btn-outline-primary btn-sm" do %>
                    <i class="bi bi-eye me-1"></i>
                    View Notification
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
              <i class="bi bi-bell fs-1 text-muted"></i>
              <h5 class="mt-3">No notifications yet</h5>
              <p class="text-muted">
                Create your first notification for students.
              </p>

              <%= link_to "Create Notification",
                          new_notification_path,
                          class: "btn btn-primary" %>
            </div>
          </div>
        <% end %>
      </div>

    </div>
  </main>
</div>
