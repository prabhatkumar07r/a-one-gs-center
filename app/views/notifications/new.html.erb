
<% content_for :title, "New Notification" %>

<div class="admin-layout">

  <%= render "layouts/admin_sidebar" %>

  <main class="admin-main">
    <div class="container-fluid py-4">

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="fw-bold mb-1">New Notification</h1>
          <p class="text-muted mb-0">
            Create a new notification for students.
          </p>
        </div>

        <%= link_to notifications_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>
          Back to Notifications
        <% end %>
      </div>

      <!-- Notification Form -->
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

          <%= render "form", notification: @notification %>

        </div>
      </div>

    </div>
  </main>

</div>
