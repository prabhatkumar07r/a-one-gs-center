```erb
<% content_for :title, "Notification Details" %>

<div class="admin-layout">

  <%= render "layouts/admin_sidebar" %>

  <main class="admin-main">
    <div class="container-fluid py-4">

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="fw-bold mb-1">Notification Details</h1>
          <p class="text-muted mb-0">
            View and manage this notification.
          </p>
        </div>

        <%= link_to notifications_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>
          Back to Notifications
        <% end %>
      </div>

      <!-- Success Message -->
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class="bi bi-check-circle me-2"></i>
          <%= notice %>

          <button type="button"
                  class="btn-close"
                  data-bs-dismiss="alert">
          </button>
        </div>
      <% end %>

      <!-- Notification Details -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

          <%= render @notification %>

        </div>
      </div>

      <!-- Actions -->
      <div class="d-flex gap-2">

        <%= link_to edit_notification_path(@notification),
                    class: "btn btn-primary" do %>
          <i class="bi bi-pencil-square me-1"></i>
          Edit Notification
        <% end %>

        <%= link_to notifications_path,
                    class: "btn btn-outline-secondary" do %>
          <i class="bi bi-list me-1"></i>
          All Notifications
        <% end %>

        <%= button_to @notification,
                      method: :delete,
                      class: "btn btn-outline-danger",
                      data: {
                        turbo_confirm: "Are you sure you want to delete this notification?"
                      } do %>
          <i class="bi bi-trash me-1"></i>
          Delete Notification
        <% end %>

      </div>

    </div>
  </main>

</div>
```
