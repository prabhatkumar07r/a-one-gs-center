<% content_for :hide_footer, true %>

<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   A ONE GS CENTER
   E-BOOK LIBRARY — MODERN PREMIUM UI
   ROUTES / CONTROLLER / MODEL UNCHANGED
========================================================= */

:root {
  --eb-primary: #6d28d9;
  --eb-primary-2: #7c3aed;
  --eb-primary-dark: #3b0764;
  --eb-purple: #9333ea;
  --eb-pink: #c026d3;

  --eb-gold: #f4b400;
  --eb-gold-soft: #fff7dc;

  --eb-text: #171329;
  --eb-muted: #716b83;

  --eb-bg: #f7f6fb;
  --eb-white: #ffffff;
  --eb-border: #e9e5f1;

  --eb-green: #149447;

  --eb-radius: 18px;

  --eb-shadow:
    0 12px 35px rgba(42, 20, 74, .08);

  --eb-shadow-hover:
    0 25px 55px rgba(67, 30, 110, .18);
}


/* =========================================================
   PAGE
========================================================= */

.public-ebooks-page {
  min-height: 100vh;

  padding:
    28px 22px 70px;
  padding-top: 100px;  

  background:
    radial-gradient(
      circle at 10% 0%,
      rgba(124, 58, 237, .08),
      transparent 28%
    ),
    radial-gradient(
      circle at 95% 20%,
      rgba(192, 38, 211, .06),
      transparent 25%
    ),
    linear-gradient(
      180deg,
      #faf9fd 0%,
      #f7f5fb 100%
    );

  color: var(--eb-text);

  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  overflow-x: hidden;
}


/* =========================================================
   CONTAINER
========================================================= */

.ebooks-container {
  position: relative;

  width:
    min(1380px, 100%);

  margin:
    0 auto;
}


/* =========================================================
   TOP BRAND STRIP
========================================================= */

.ebooks-topbar {
  display: flex;

  align-items: center;
  justify-content: space-between;

  margin-bottom: 22px;
}


.ebooks-brand {
  display: flex;

  align-items: center;

  gap: 12px;
  
}


.ebooks-brand-icon {
  width: 44px;
  height: 44px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      var(--eb-primary),
      var(--eb-pink)
    );

  color: white;

  font-size: 22px;

  box-shadow:
    0 10px 25px rgba(109,40,217,.22);
}


.ebooks-brand-text strong {
  display: block;

  color:
    var(--eb-primary-dark);

  font-size: 15px;

  font-weight: 900;
}


.ebooks-brand-text span {
  display: block;

  margin-top: 2px;

  color: var(--eb-muted);

  font-size: 11px;
}


/* =========================================================
   HERO
========================================================= */

.ebooks-hero {
  position: relative;

  display: grid;

  grid-template-columns:
    1.25fr .75fr;

  align-items: center;

  min-height: 270px;

  margin-bottom: 24px;

  padding:
    40px 48px;

  overflow: hidden;

  border-radius: 26px;

  background:
    radial-gradient(
      circle at 90% 10%,
      rgba(255,255,255,.20),
      transparent 24%
    ),
    radial-gradient(
      circle at 65% 100%,
      rgba(244,180,0,.20),
      transparent 32%
    ),
    linear-gradient(
      120deg,
      #32105f 0%,
      #5b21b6 48%,
      #7e22ce 100%
    );

  box-shadow:
    0 24px 55px rgba(59,7,100,.20);

  color: white;
}


.ebooks-hero::before {
  content: "";

  position: absolute;

  width: 390px;
  height: 390px;

  right: -150px;
  top: -190px;

  border-radius: 50%;

  border:
    1px solid rgba(255,255,255,.12);
}


.ebooks-hero::after {
  content: "";

  position: absolute;

  width: 240px;
  height: 240px;

  right: 140px;
  bottom: -180px;

  border-radius: 50%;

  border:
    1px solid rgba(255,255,255,.08);
}


/* =========================================================
   HERO CONTENT
========================================================= */

.ebooks-hero-content {
  position: relative;

  z-index: 2;
}


.ebooks-kicker {
  display: inline-flex;

  align-items: center;

  gap: 7px;

  margin-bottom: 13px;

  padding:
    7px 12px;

  border-radius: 30px;

  background:
    rgba(255,255,255,.12);

  border:
    1px solid rgba(255,255,255,.16);

  color:
    #fff4c7;

  font-size: 11px;

  font-weight: 800;

  letter-spacing: .6px;
}


.ebooks-hero h1 {
  margin:
    0 0 12px;

  font-size:
    clamp(34px, 4vw, 54px);

  line-height: 1.05;

  letter-spacing: -1.7px;

  font-weight: 950;

  color: white;
}


.ebooks-hero h1 span {
  color:
    #ffd95a;
}


.ebooks-hero-description {
  max-width: 650px;

  margin: 0;

  color:
    rgba(255,255,255,.78);

  font-size: 15px;

  line-height: 1.7;
}


/* =========================================================
   HERO STATS
========================================================= */

.ebooks-hero-stats {
  display: flex;

  flex-wrap: wrap;

  gap: 10px;

  margin-top: 24px;
}


.ebooks-stat {
  min-width: 105px;

  padding:
    10px 14px;

  border-radius: 12px;

  background:
    rgba(255,255,255,.09);

  border:
    1px solid rgba(255,255,255,.12);
}


.ebooks-stat strong {
  display: block;

  color: white;

  font-size: 17px;

  font-weight: 900;
}


.ebooks-stat span {
  display: block;

  margin-top: 2px;

  color:
    rgba(255,255,255,.62);

  font-size: 9px;

  text-transform: uppercase;

  letter-spacing: .6px;
}


/* =========================================================
   HERO BOOK VISUAL
========================================================= */

.ebooks-hero-visual {
  position: relative;

  min-height: 210px;

  display: flex;

  align-items: center;
  justify-content: center;
}


.hero-book {
  position: relative;

  width: 180px;
  height: 135px;

  border-radius: 8px 14px 14px 8px;

  background:
    linear-gradient(
      135deg,
      #ffffff,
      #eee8ff
    );

  transform:
    rotate(-8deg)
    perspective(700px)
    rotateY(-15deg);

  box-shadow:
    -12px 15px 0 #4c1d95,
    -20px 25px 35px rgba(0,0,0,.25);

  z-index: 3;
}


.hero-book::before {
  content: "";

  position: absolute;

  left: 50%;

  top: 8px;
  bottom: 8px;

  width: 1px;

  background:
    rgba(76,29,149,.14);
}


.hero-book::after {
  content: "A ONE GS CENTER";

  white-space: pre;

  position: absolute;

  inset: 20px;

  display: flex;

  align-items: center;
  justify-content: center;

  text-align: center;

  color:
    var(--eb-primary-dark);

  font-size: 18px;

  font-weight: 950;

  line-height: 1.2;
}


/* =========================================================
   FLOATING BOOK
========================================================= */

.hero-floating-book {
  position: absolute;

  width: 95px;
  height: 70px;

  right: 8%;
  top: 25px;

  border-radius: 6px 9px 9px 6px;

  background:
    linear-gradient(
      135deg,
      #ffd866,
      #f4b400
    );

  transform:
    rotate(14deg);

  box-shadow:
    0 15px 25px rgba(0,0,0,.20);

  z-index: 2;
}


.hero-floating-book::after {
  content: "NOTES";

  position: absolute;

  inset: 0;

  display: flex;

  align-items: center;
  justify-content: center;

  color:
    #5a3d00;

  font-size: 12px;

  font-weight: 900;
}


/* =========================================================
   FILTER AREA
========================================================= */

.ebooks-filter-wrapper {
  margin-bottom: 28px;
}


.ebooks-filter {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    220px
    110px;

  gap: 10px;

  padding: 10px;

  border:
    1px solid var(--eb-border);

  border-radius: 16px;

  background:
    rgba(255,255,255,.94);

  box-shadow:
    var(--eb-shadow);
}


/* =========================================================
   SEARCH
========================================================= */

.ebooks-search,
.ebooks-category {

  width: 100%;

  height: 48px;

  border:
    1px solid var(--eb-border);

  border-radius: 11px;

  background:
    #faf9fc;

  color:
    var(--eb-text);

  outline: none;

  padding:
    0 14px;

  font-size: 13px;

  transition:
    .2s ease;
}


.ebooks-search:focus,
.ebooks-category:focus {

  background: white;

  border-color:
    var(--eb-primary);

  box-shadow:
    0 0 0 3px rgba(124,58,237,.10);
}


.ebooks-search::placeholder {
  color:
    #9992a7;
}


.ebooks-category {
  cursor: pointer;

  font-weight: 650;
}


/* =========================================================
   SEARCH BUTTON
========================================================= */

.ebooks-search-btn {

  height: 48px;

  border: 0;

  border-radius: 11px;

  background:
    linear-gradient(
      135deg,
      var(--eb-primary),
      var(--eb-pink)
    );

  color: white;

  font-size: 13px;

  font-weight: 850;

  cursor: pointer;

  box-shadow:
    0 8px 18px rgba(109,40,217,.20);

  transition:
    .2s ease;
}


.ebooks-search-btn:hover {

  transform:
    translateY(-2px);

  box-shadow:
    0 12px 25px rgba(109,40,217,.28);
}


/* =========================================================
   LIBRARY HEADER
========================================================= */

.ebooks-library-header {

  display: flex;

  align-items: end;
  justify-content: space-between;

  gap: 20px;

  margin:
    0 2px 18px;
}


.ebooks-library-title {
  display: flex;

  align-items: center;

  gap: 12px;
}


.ebooks-library-icon {

  width: 42px;
  height: 42px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 12px;

  background:
    #f0e8ff;

  color:
    var(--eb-primary);

  font-size: 20px;
}


.ebooks-library-title h2 {

  margin: 0;

  color:
    var(--eb-text);

  font-size: 23px;

  font-weight: 900;
}


.ebooks-library-title p {

  margin:
    3px 0 0;

  color:
    var(--eb-muted);

  font-size: 11px;
}


.ebooks-total {

  color:
    var(--eb-muted);

  font-size: 12px;

  font-weight: 700;
}


.ebooks-total strong {
  color:
    var(--eb-primary);
}


/* =========================================================
   BOOK GRID
========================================================= */

.ebooks-grid {

  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 20px;
}


/* =========================================================
   CARD
========================================================= */

.public-ebook-card {

  position: relative;

  display: flex;

  flex-direction: column;

  min-width: 0;

  overflow: hidden;

  border:
    1px solid var(--eb-border);

  border-radius:
    var(--eb-radius);

  background:
    white;

  box-shadow:
    var(--eb-shadow);

  transform-style:
    preserve-3d;

  transition:
    border-color .3s ease,
    box-shadow .3s ease;
}


.public-ebook-card:hover {

  border-color:
    rgba(124,58,237,.22);

  box-shadow:
    var(--eb-shadow-hover);
}


/* =========================================================
   COVER
========================================================= */

.public-ebook-cover {

  position: relative;

  width: 100%;

  aspect-ratio:
    3 / 2;

  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      #ede5ff,
      #f8eaff
    );

  transform:
    translateZ(12px);
}


.public-ebook-cover img {

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  object-position: center;

  transition:
    transform .5s ease;
}


.public-ebook-card:hover
.public-ebook-cover img {

  transform:
    scale(1.055);
}


/* =========================================================
   COVER GRADIENT
========================================================= */

.public-ebook-cover::after {

  content: "";

  position: absolute;

  inset: 0;

  pointer-events: none;

  background:
    linear-gradient(
      180deg,
      rgba(0,0,0,0) 45%,
      rgba(28,10,55,.20) 100%
    );
}


/* =========================================================
   PLACEHOLDER
========================================================= */

.public-ebook-placeholder {

  width: 100%;
  height: 100%;

  display: flex;

  align-items: center;
  justify-content: center;

  background:
    linear-gradient(
      135deg,
      #5b21b6,
      #a21caf
    );

  color: white;

  font-size: 55px;
}


/* =========================================================
   BADGE
========================================================= */

.public-ebook-badge {

  position: absolute;

  z-index: 5;

  top: 12px;
  left: 12px;

  padding:
    6px 10px;

  border-radius:
    30px;

  background:
    linear-gradient(
      135deg,
      #ffe18a,
      #f4b400
    );

  color:
    #553c00;

  font-size: 9px;

  font-weight: 950;

  letter-spacing: .7px;

  box-shadow:
    0 5px 15px rgba(0,0,0,.15);
}


.public-ebook-badge.paid {

  background:
    rgba(50,17,95,.88);

  color: white;

  border:
    1px solid rgba(255,255,255,.20);
}


/* =========================================================
   CARD BODY
========================================================= */

.public-ebook-body {

  display: flex;

  flex: 1;

  flex-direction: column;

  padding:
    16px;

  min-width: 0;
}


/* =========================================================
   TITLE
========================================================= */

.public-ebook-title {

  margin:
    0 0 7px;

  color:
    var(--eb-text);

  font-size:
    16px;

  line-height:
    1.35;

  font-weight:
    850;

  display:
    -webkit-box;

  -webkit-line-clamp:
    2;

  -webkit-box-orient:
    vertical;

  overflow:
    hidden;
}


/* =========================================================
   DESCRIPTION
========================================================= */

.public-ebook-description {

  margin-bottom:
    9px;

  color:
    var(--eb-muted);

  font-size:
    11px;

  line-height:
    1.55;

  display:
    -webkit-box;

  -webkit-line-clamp:
    2;

  -webkit-box-orient:
    vertical;

  overflow:
    hidden;
}


/* =========================================================
   AUTHOR
========================================================= */

.public-ebook-author {

  margin-bottom:
    10px;

  color:
    var(--eb-muted);

  font-size:
    10px;

  font-weight:
    650;
}


/* =========================================================
   META
========================================================= */

.public-ebook-meta {

  display:
    flex;

  flex-wrap:
    wrap;

  gap:
    5px;

  margin-bottom:
    9px;
}


.public-ebook-pill {

  max-width:
    100%;

  padding:
    5px 7px;

  overflow:
    hidden;

  white-space:
    nowrap;

  text-overflow:
    ellipsis;

  border-radius:
    6px;

  background:
    #f6f2fc;

  border:
    1px solid #eee7f7;

  color:
    #6b4a93;

  font-size:
    9px;

  font-weight:
    700;
}


/* =========================================================
   PDF INFO
========================================================= */

.public-ebook-file-info {

  display:
    inline-flex;

  align-items:
    center;

  gap:
    5px;

  width:
    fit-content;

  margin-bottom:
    10px;

  padding:
    6px 8px;

  border-radius:
    7px;

  background:
    var(--eb-gold-soft);

  color:
    #806000;

  font-size:
    9px;

  font-weight:
    750;
}


/* =========================================================
   PRICE
========================================================= */

.public-ebook-price {

  display:
    flex;

  align-items:
    center;

  flex-wrap:
    wrap;

  gap:
    7px;

  min-height:
    34px;

  margin-top:
    auto;

  margin-bottom:
    12px;
}


.ebook-current-price {

  color:
    var(--eb-primary-dark);

  font-size:
    20px;

  font-weight:
    950;
}


.ebook-original-price {

  color:
    #aaa2b2;

  font-size:
    10px;

  text-decoration:
    line-through;
}


.ebook-discount {

  padding:
    4px 6px;

  border-radius:
    5px;

  background:
    #f5ecff;

  color:
    var(--eb-primary);

  font-size:
    8px;

  font-weight:
    900;
}


/* =========================================================
   BUTTON
========================================================= */

.public-ebook-btn {

  position:
    relative;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  width:
    100%;

  min-height:
    43px;

  padding:
    9px 12px;

  border-radius:
    10px;

  background:
    linear-gradient(
      135deg,
      var(--eb-primary),
      var(--eb-pink)
    );

  color:
    white;

  text-decoration:
    none;

  font-size:
    11px;

  font-weight:
    850;

  box-shadow:
    0 8px 18px rgba(109,40,217,.18);

  overflow:
    hidden;

  transition:
    transform .2s ease,
    box-shadow .2s ease;
}


.public-ebook-btn:hover {

  color:
    white;

  transform:
    translateY(-2px);

  box-shadow:
    0 12px 25px rgba(109,40,217,.28);
}


/* =========================================================
   BUTTON SHINE
========================================================= */

.public-ebook-btn::before {

  content:
    "";

  position:
    absolute;

  top:
    0;

  left:
    -120%;

  width:
    70%;

  height:
    100%;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,.28),
      transparent
    );

  transform:
    skewX(-20deg);

  transition:
    left .55s ease;
}


.public-ebook-btn:hover::before {

  left:
    140%;
}


/* =========================================================
   EMPTY STATE
========================================================= */

.ebooks-empty {

  margin:
    30px auto;

  max-width:
    600px;

  padding:
    60px 25px;

  text-align:
    center;

  border:
    1px solid var(--eb-border);

  border-radius:
    22px;

  background:
    white;

  box-shadow:
    var(--eb-shadow);
}


.ebooks-empty-icon {

  width:
    70px;

  height:
    70px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  margin:
    0 auto 16px;

  border-radius:
    20px;

  background:
    #f1eaff;

  font-size:
    34px;
}


.ebooks-empty h2 {

  margin:
    0 0 7px;

  color:
    var(--eb-primary-dark);

  font-size:
    22px;

  font-weight:
    900;
}


.ebooks-empty p {

  margin:
    0;

  color:
    var(--eb-muted);

  font-size:
    13px;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1100px) {

  .ebooks-grid {

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

  }

}


/* =========================================================
   SMALL TABLET
========================================================= */

@media (max-width: 850px) {

  .ebooks-hero {

    grid-template-columns:
      1fr;

    padding:
      35px 30px;

  }


  .ebooks-hero-visual {

    display:
      none;

  }


  .ebooks-filter {

    grid-template-columns:
      1fr 180px;

  }


  .ebooks-search-btn {

    grid-column:
      1 / -1;

  }


  .ebooks-grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .public-ebooks-page {

    padding:
      18px 11px 50px;

  }


  .ebooks-topbar {

    margin-bottom:
      15px;

  }


  .ebooks-brand-icon {

    width:
      39px;

    height:
      39px;

    font-size:
      19px;

  }


  .ebooks-brand-text strong {

    font-size:
      13px;

  }


  .ebooks-brand-text span {

    font-size:
      9px;

  }


  .ebooks-hero {

    min-height:
      auto;

    padding:
      28px 22px;

    margin-bottom:
      15px;

    border-radius:
      20px;

  }


  .ebooks-kicker {

    font-size:
      9px;

    padding:
      6px 9px;

  }


  .ebooks-hero h1 {

    font-size:
      32px;

    letter-spacing:
      -1px;

  }


  .ebooks-hero-description {

    font-size:
      12px;

    line-height:
      1.6;

  }


  .ebooks-hero-stats {

    margin-top:
      18px;

  }


  .ebooks-stat {

    min-width:
      85px;

    padding:
      8px 10px;

  }


  .ebooks-stat strong {

    font-size:
      14px;

  }


  .ebooks-stat span {

    font-size:
      8px;

  }


  .ebooks-filter {

    display:
      flex;

    flex-direction:
      column;

    padding:
      8px;

    gap:
      8px;

  }


  .ebooks-search,
  .ebooks-category,
  .ebooks-search-btn {

    height:
      45px;

  }


  .ebooks-library-header {

    align-items:
      center;

    margin-bottom:
      13px;

  }


  .ebooks-library-icon {

    width:
      36px;

    height:
      36px;

    font-size:
      17px;

  }


  .ebooks-library-title h2 {

    font-size:
      18px;

  }


  .ebooks-library-title p {

    font-size:
      9px;

  }


  .ebooks-total {

    font-size:
      9px;

  }


  .ebooks-grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap:
      10px;

  }


  .public-ebook-card {

    border-radius:
      13px;

  }


  .public-ebook-body {

    padding:
      10px;

  }


  .public-ebook-title {

