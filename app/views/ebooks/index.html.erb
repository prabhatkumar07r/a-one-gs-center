========================================================= */

@media (max-width: 380px) {

  .ebooks-grid {

    grid-template-columns:
      1fr;

  }


  .public-ebook-cover {

    aspect-ratio:
      3 / 2;

  }


  .public-ebook-title {

    font-size:
      16px;

  }


  .public-ebook-description {

    font-size:
      10px;

  }


  .public-ebook-author {

    font-size:
      10px;

  }


  .public-ebook-pill {

    font-size:
      9px;

  }


  .public-ebook-file-info {

    font-size:
      9px;

  }


  .ebook-current-price {

    font-size:
      20px;

  }


  .public-ebook-btn {

    min-height:
      43px;

    font-size:
      11px;

  }

}


/* =========================================================
   ACCESSIBILITY
========================================================= */

.public-ebook-btn:focus-visible,
.ebooks-search-btn:focus-visible,
.ebooks-search:focus-visible,
.ebooks-category:focus-visible {

  outline:
    3px solid
    rgba(244,180,0,.65);

  outline-offset:
    3px;

}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {

    animation-duration:
      .01ms !important;

    animation-iteration-count:
      1 !important;

    transition-duration:
      .01ms !important;

  }

}


/* =========================================================
   CATEGORY SCROLL
========================================================= */

.ebooks-category-scroll {

  width: 100%;

  margin:
    -10px 0 28px;

  overflow-x: auto;

  overflow-y: hidden;

  scrollbar-width: none;

  -webkit-overflow-scrolling: touch;
}


.ebooks-category-scroll::-webkit-scrollbar {
  display: none;
}


/* =========================================================
   CATEGORY PILLS
========================================================= */

.ebooks-category-pills {

  display: flex;

  align-items: center;

  gap: 8px;

  width: max-content;

  min-width: 100%;
}


/* =========================================================
   CATEGORY PILL
========================================================= */

.ebooks-category-pill {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-height: 36px;

  padding:
    8px 14px;

  border:
    1px solid #e8e2f1;

  border-radius:
    999px;

  background:
    rgba(255,255,255,.92);

  color:
    #625a70;

  text-decoration:
    none;

  white-space:
    nowrap;

  font-size:
    11px;

  font-weight:
    750;

  box-shadow:
    0 4px 12px rgba(45,20,70,.05);

  transition:
    all .22s ease;
}


/* =========================================================
   HOVER
========================================================= */

.ebooks-category-pill:hover {

  color:
    #6d28d9;

  border-color:
    rgba(109,40,217,.25);

  background:
    #faf7ff;

  transform:
    translateY(-2px);

  box-shadow:
    0 7px 18px rgba(109,40,217,.10);
}


/* =========================================================
   ACTIVE
========================================================= */

.ebooks-category-pill.active {

  color:
    white;

  border-color:
    transparent;

  background:
    linear-gradient(
      135deg,
      #6d28d9,
      #c026d3
    );

  box-shadow:
    0 7px 18px rgba(109,40,217,.24);
}


/* =========================================================
   ACTIVE HOVER
========================================================= */

.ebooks-category-pill.active:hover {

  color:
    white;

  transform:
    translateY(-2px);

  box-shadow:
    0 10px 23px rgba(109,40,217,.30);
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .ebooks-category-scroll {

    margin:
      -4px 0 20px;

  }


  .ebooks-category-pills {

    gap:
      6px;

  }


  .ebooks-category-pill {

    min-height:
      32px;

    padding:
      7px 11px;

    font-size:
      9px;

  }

}

</style>


<div class="public-ebooks-page">

  <div class="ebooks-container">


    <!-- =====================================================
         BRAND
    ====================================================== -->

    <div class="ebooks-topbar">

      <div class="ebooks-brand">

        <div class="ebooks-brand-icon">
          📖
        </div>

        <div class="ebooks-brand-text">

          <strong>
            A ONE GS CENTER
          </strong>

          <span>
            Digital Learning Library
          </span>

        </div>

      </div>

    </div>


    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="ebooks-hero">

      <div class="ebooks-hero-content">

        <div class="ebooks-kicker">
          📚 DIGITAL LIBRARY
        </div>

        <h1>
          Learn Smarter.
          <span>Prepare Better.</span>
        </h1>

        <p class="ebooks-hero-description">
          Explore our collection of digital study materials,
          notes, preparation books and exam resources —
          all in one place.
        </p>


        <div class="ebooks-hero-stats">

          <div class="ebooks-stat">

            <strong>
              <%= @ebooks.size %>
            </strong>

            <span>
              E-Books
            </span>

          </div>


          <div class="ebooks-stat">

            <strong>
              PDF
            </strong>

            <span>
              Study Material
            </span>

          </div>


          <div class="ebooks-stat">

            <strong>
              24×7
            </strong>

            <span>
              Access
            </span>

          </div>

        </div>

      </div>


      <div class="ebooks-hero-visual">

        <div class="hero-floating-book"></div>

        <div class="hero-book"></div>

      </div>

    </section>


    <!-- =====================================================
         SEARCH / FILTER
    ====================================================== -->
    <!-- =====================================================
     SEARCH
====================================================== -->

<div class="ebooks-filter-wrapper">

  <%= form_with url: ebooks_path,
                method: :get,
                local: true,
                class: "ebooks-filter" do |form| %>

    <%= form.search_field :q,
        value: params[:q],
        placeholder:
          "🔎  Search books, authors, exams or topics...",
        class:
          "ebooks-search" %>


    <%= form.select :category,

        options_for_select(

          Ebook.published
               .where.not(category: [nil, ""])
               .distinct
               .order(:category)
               .pluck(:category),

          params[:category]

        ),

        {
          include_blank:
            "📂  All Categories"
        },

        class:
          "ebooks-category" %>


    <%= form.submit "Search",
        class:
          "ebooks-search-btn" %>

  <% end %>

</div>


<!-- =====================================================
     CATEGORY PILLS
====================================================== -->

<div class="ebooks-category-scroll">

  <div class="ebooks-category-pills">

    <%= link_to "All",
        ebooks_path(
          q: params[:q]
        ),
        class:
          "ebooks-category-pill #{params[:category].blank? ? 'active' : ''}" %>


    <% [

      "Class 11",
      "Class 12",
      "11th Arts",
      "12th Arts",
      "SSC",
      "Bihar Police",
      "Bihar SI",
      "Bihar GK",
      "UPSC",
      "History",
      "Geography",
      "Polity",
      "Economics",
      "Science",
      "Others"

    ].each do |category| %>


      <%= link_to category,

          ebooks_path(
            q: params[:q],
            category: category
          ),

          class:
            "ebooks-category-pill #{params[:category].to_s.downcase == category.downcase ? 'active' : ''}" %>


    <% end %>

  </div>

</div>


    <!-- =====================================================
         LIBRARY HEADER
    ====================================================== -->

    <% if @ebooks.any? %>

      <div class="ebooks-library-header">

        <div class="ebooks-library-title">

          <div class="ebooks-library-icon">
            📚
          </div>

          <div>

            <h2>
              E-Book Collection
            </h2>

            <p>
              Study material for your preparation
            </p>

          </div>

        </div>


        <div class="ebooks-total">

          Showing
          <strong>
            <%= @ebooks.size %>
          </strong>
          books

        </div>

      </div>


      <!-- ===================================================
           BOOK GRID
      ==================================================== -->

      <div class="ebooks-grid">

        <% @ebooks.each do |ebook| %>

          <article
            class="public-ebook-card"
            data-ebook-card="true">


            <!-- =============================================
                 COVER
            ============================================== -->

            <div class="public-ebook-cover">

              <% if ebook.cover_image.attached? %>

                <%= image_tag ebook.cover_image,

                    alt:
                      ebook.title,

                    loading:
                      "lazy" %>

              <% else %>

                <div class="public-ebook-placeholder">
                  📖
                </div>

              <% end %>


              <% if ebook.free? %>

                <span class="public-ebook-badge">
                  FREE
                </span>

              <% else %>

                <span class="public-ebook-badge paid">
                  PREMIUM
                </span>

              <% end %>

            </div>


            <!-- =============================================
                 BODY
            ============================================== -->

            <div class="public-ebook-body">


              <!-- TITLE -->

              <h2 class="public-ebook-title">

                <%= ebook.title %>

              </h2>


              <!-- DESCRIPTION -->

              <% if ebook.description.present? %>

                <div class="public-ebook-description">

                  <%= truncate(
                        ebook.description,
                        length: 110
                      ) %>

                </div>

              <% end %>


              <!-- AUTHOR -->

              <% if ebook.author.present? %>

                <div class="public-ebook-author">

                  ✍️
                  <strong>
                    <%= ebook.author %>
                  </strong>

                </div>

              <% end %>


              <!-- META -->

              <div class="public-ebook-meta">

                <% if ebook.category.present? %>

                  <span class="public-ebook-pill">

                    📂
                    <%= ebook.category %>

                  </span>

                <% end %>


                <% if ebook.language.present? %>

                  <span class="public-ebook-pill">

                    🌐
                    <%= ebook.language %>

                  </span>

                <% end %>


                <% if ebook.exam_name.present? %>

                  <span class="public-ebook-pill">

                    🎯
                    <%= ebook.exam_name %>

                  </span>

                <% end %>

              </div>


              <!-- PDF -->

              <% active_pdf_count =
                   ebook
                     .ebook_files
                     .count {
                       |file|
                       file.status == "active"
                     } %>


              <div class="public-ebook-file-info">

                📄

                <strong>
                  <%= active_pdf_count %>
                </strong>

                PDF
                <%= active_pdf_count == 1 ? "File" : "Files" %>

              </div>


              <!-- PRICE -->

              <% unless ebook.free? %>

                <div class="public-ebook-price">

                  <span class="ebook-current-price">

                    ₹<%= ebook.price.to_i %>

                  </span>


                  <% if ebook.original_price.to_f >
                             ebook.price.to_f %>

                    <span class="ebook-original-price">

                      ₹<%= ebook.original_price.to_i %>

                    </span>

                  <% end %>


                  <% if ebook.discount_percentage.to_f > 0 %>

                    <span class="ebook-discount">

                      <%= ebook.discount_percentage.to_i %>%
                      OFF

                    </span>

                  <% end %>

                </div>

              <% else %>

                <div class="public-ebook-price">

                  <span class="ebook-current-price">

                    FREE

                  </span>

                </div>

              <% end %>


              <!-- BUTTON -->

              <%= link_to ebook_path(ebook),

                  class:
                    "public-ebook-btn",

                  aria: {
                    label:
                      "View details for #{ebook.title}"
                  } do %>

                📖 View Book Details →

              <% end %>


            </div>

          </article>

        <% end %>

      </div>


    <% else %>


      <!-- ===================================================
           EMPTY
      ==================================================== -->

      <div class="ebooks-empty">

        <div class="ebooks-empty-icon">
          📚
        </div>

        <h2>
          No E-Books Found
        </h2>

        <p>
          Try searching with another keyword or select
          a different category.
        </p>

      </div>

    <% end %>


  </div>

</div>


<!-- =========================================================
     3D CARD EFFECT
========================================================= -->

<script nonce="<%= content_security_policy_nonce %>">

(function () {

  function initializePublicEbooks() {

    const cards =
      document.querySelectorAll(
        '[data-ebook-card="true"]'
      );


    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;


    if (reducedMotion) {
      return;
    }


    cards.forEach(function (card) {

      if (
        card.dataset.tiltInitialized === "true"
      ) {
        return;
      }


      card.dataset.tiltInitialized = "true";


      card.addEventListener(
        "mousemove",
        function (event) {

          const rect =
            card.getBoundingClientRect();


          const x =
            event.clientX - rect.left;


          const y =
            event.clientY - rect.top;


          const centerX =
            rect.width / 2;


          const centerY =
            rect.height / 2;


          const rotateX =
            ((centerY - y) / centerY) * 3.5;


          const rotateY =
            ((x - centerX) / centerX) * 3.5;


          card.style.transform =
            "perspective(1200px) " +
            "rotateX(" +
            rotateX +
            "deg) " +
            "rotateY(" +
            rotateY +
            "deg) " +
            "translateY(-5px)";

        }
      );


      card.addEventListener(
        "mouseleave",
        function () {

          card.style.transform =
            "";

        }
      );


      card.addEventListener(
        "touchstart",
        function () {

          card.style.transform =
            "";

        },
        {
          passive: true
        }
      );

    });

  }


  document.addEventListener(
    "turbo:load",
    initializePublicEbooks
  );


  if (
    document.readyState !== "loading"
  ) {

    initializePublicEbooks();

  } else {

    document.addEventListener(
      "DOMContentLoaded",
      initializePublicEbooks,
      {
        once: true
      }
    );

  }

})();

</script>