<% content_for :hide_footer, true %>

<%
  # =========================================================
  # E-BOOK ACCESS STATE
  # =========================================================

  ebook_owned =
    user_signed_in? &&
    current_user
      .ebook_purchases
      .paid
      .exists?(ebook_id: @ebook.id)

  ebook_access_granted =
    @ebook.free? || ebook_owned
%>


<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   A ONE GS CENTER
   E-BOOK SHOW PAGE
   REFERENCE IMAGE STYLE
========================================================= */

* {
  box-sizing: border-box;
}

html {
  overflow-x: hidden;
}

body {
  margin: 0;

  font-family:
    "Poppins",
    Arial,
    sans-serif;

  color: #182653;

  background:
    radial-gradient(
      circle at 8% 12%,
      rgba(124, 58, 237, .13),
      transparent 24%
    ),

    radial-gradient(
      circle at 92% 22%,
      rgba(236, 72, 153, .12),
      transparent 22%
    ),

    radial-gradient(
      circle at 88% 88%,
      rgba(59, 130, 246, .08),
      transparent 25%
    ),

    linear-gradient(
      135deg,
      #f8f5ff 0%,
      #ffffff 48%,
      #faf6ff 100%
    );
}


/* =========================================================
   PAGE
========================================================= */

.ebook-show-page {
  min-height: 100vh;

  padding:
    92px 18px 70px;

  position: relative;

  overflow: hidden;
}


/* =========================================================
   DECORATIVE BACKGROUND
========================================================= */

.ebook-bg-decoration {
  position: fixed;

  inset: 0;

  pointer-events: none;

  overflow: hidden;

  z-index: 0;
}

.ebook-bg-decoration span {
  position: absolute;

  display: block;

  border-radius: 50%;

  filter: blur(.2px);

  opacity: .55;

  animation:
    ebookFloat
    9s
    ease-in-out
    infinite;
}


/* top right */

.ebook-bg-decoration span:nth-child(1) {
  width: 145px;
  height: 145px;

  top: -45px;
  right: 9%;

  background:
    rgba(245, 158, 11, .14);

  animation-delay: 0s;
}


/* left */

.ebook-bg-decoration span:nth-child(2) {
  width: 70px;
  height: 70px;

  top: 31%;
  left: -25px;

  background:
    rgba(124, 58, 237, .11);

  animation-delay: 1.5s;
}


/* right */

.ebook-bg-decoration span:nth-child(3) {
  width: 105px;
  height: 105px;

  top: 49%;
  right: -40px;

  background:
    rgba(236, 72, 153, .10);

  animation-delay: 3s;
}


/* bottom */

.ebook-bg-decoration span:nth-child(4) {
  width: 125px;
  height: 125px;

  bottom: -55px;
  left: 4%;

  background:
    rgba(59, 130, 246, .08);

  animation-delay: 4.5s;
}


@keyframes ebookFloat {

  0%,
  100% {
    transform:
      translateY(0)
      translateX(0);
  }

  50% {
    transform:
      translateY(-18px)
      translateX(8px);
  }
}


/* =========================================================
   CONTAINER
========================================================= */

.ebook-container {
  width:
    min(1090px, 100%);

  margin:
    0 auto;

  position:
    relative;

  z-index:
    2;
}


/* =========================================================
   BACK BUTTON
========================================================= */

.back-btn {
  display:
    inline-flex;

  align-items:
    center;

  gap:
    9px;

  padding:
    9px 18px;

  margin-bottom:
    18px;

  border-radius:
    999px;

  color:
    #5b21b6;

  background:
    rgba(255,255,255,.88);

  border:
    1px solid
    rgba(124,58,237,.16);

  box-shadow:
    0 7px 20px
    rgba(76,29,149,.08);

  text-decoration:
    none;

  font-size:
    13px;

  font-weight:
    800;

  transition:
    all .22s ease;

  backdrop-filter:
    blur(12px);
}


.back-btn:hover {
  color:
    #4c1d95;

  transform:
    translateY(-2px);

  box-shadow:
    0 10px 24px
    rgba(76,29,149,.13);
}


/* =========================================================
   MAIN HERO CARD
========================================================= */

.ebook-hero {
  display:
    grid;

  grid-template-columns:
    48%
    52%;

  min-height:
    660px;

  border-radius:
    25px;

  overflow:
    hidden;

  background:
    rgba(255,255,255,.92);

  border:
    1px solid
    rgba(255,255,255,.95);

  box-shadow:
    0 25px 55px
    rgba(31,41,55,.10),

    0 5px 18px
    rgba(124,58,237,.06);

  backdrop-filter:
    blur(16px);

  transition:
    transform .2s ease;
}


/* =========================================================
   LEFT SIDE
========================================================= */

.ebook-visual-side {
  position:
    relative;

  padding:
    26px;

  display:
    flex;

  flex-direction:
    column;

  align-items:
    center;

  justify-content:
    flex-start;

  background:
    linear-gradient(
      145deg,
      #dbeafe 0%,
      #ede9fe 48%,
      #fce7f3 100%
    );
}


/* =========================================================
   PREMIUM BADGE
========================================================= */

.cover-badge {
  position:
    absolute;

  top:
    12px;

  right:
    12px;

  z-index:
    4;

  padding:
    9px 16px;

  border-radius:
    999px;

  color:
    #ffffff;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #c026d3
    );

  box-shadow:
    0 8px 20px
    rgba(124,58,237,.25);

  font-size:
    12px;

  font-weight:
    900;

  letter-spacing:
    .3px;
}


.cover-badge.free {
  background:
    linear-gradient(
      135deg,
      #16a34a,
      #22c55e
    );
}


/* =========================================================
   COVER PLATFORM
========================================================= */

.cover-platform {
  width:
    88%;

  max-width:
    410px;

  height:
    475px;

  margin-top:
    20px;

  display:
    flex;

  align-items:
    flex-end;

  justify-content:
    center;

  position:
    relative;
}


.cover-platform::after {
  content:
    "";

  position:
    absolute;

  left:
    50%;

  bottom:
    2px;

  transform:
    translateX(-50%);

  width:
    92%;

  height:
    70px;

  border-radius:
    50%;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.82),
      rgba(224,211,255,.75)
    );

  box-shadow:
    0 14px 25px
    rgba(91,33,182,.12);

  z-index:
    0;
}


/* =========================================================
   COVER
========================================================= */

.ebook-cover {
  position:
    relative;

  z-index:
    2;

  width:
    72%;

  max-width:
    295px;

  height:
    410px;

  display:
    block;

  object-fit:
    cover;

  object-position:
    center;

  border-radius:
    4px;

  box-shadow:
    18px 25px 32px
    rgba(15,23,42,.25);

  transform:
    perspective(900px)
    rotateY(-3deg);

  transition:
    transform .35s ease,
    box-shadow .35s ease;
}


.cover-platform:hover .ebook-cover {
  transform:
    perspective(900px)
    rotateY(0deg)
    translateY(-5px);

  box-shadow:
    20px 30px 38px
    rgba(15,23,42,.28);
}


/* =========================================================
   NO COVER
========================================================= */

.no-cover {
  position:
    relative;

  z-index:
    2;

  width:
    72%;

  max-width:
    295px;

  height:
    410px;

  display:
    flex;

  flex-direction:
    column;

  align-items:
    center;

  justify-content:
    center;

  padding:
    25px;

  text-align:
    center;

  color:
    #ffffff;

  background:
    linear-gradient(
      145deg,
      #6d28d9,
      #db2777
    );

  border-radius:
    8px;

  box-shadow:
    18px 25px 32px
    rgba(15,23,42,.22);
}


.book-icon {
  font-size:
    64px;

  margin-bottom:
    15px;
}


/* =========================================================
   WHY CHOOSE SECTION
========================================================= */

.why-book {
