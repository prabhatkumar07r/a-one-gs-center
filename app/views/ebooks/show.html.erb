</style>


<!-- =========================================================
     PAGE
========================================================= -->

<div class="ebook-show-page">


  <!-- =======================================================
       BACKGROUND DECORATION
  ======================================================== -->

  <div class="ebook-bg-decoration" aria-hidden="true">

    <span></span>
    <span></span>
    <span></span>
    <span></span>

  </div>


  <div class="ebook-container">


    <!-- =====================================================
         BACK
    ====================================================== -->

    <%= link_to ebooks_path,
        class: "back-btn" do %>

      <span>←</span>
      <span>Back to E-Books</span>

    <% end %>


    <!-- =====================================================
         MAIN HERO
    ====================================================== -->

    <section class="ebook-hero" id="ebook3dCard">


      <!-- ===================================================
           LEFT VISUAL
      ==================================================== -->

      <div class="ebook-visual-side">


        <!-- BADGE -->

        <div class="cover-badge <%= 'free' if @ebook.free? %>">

          <% if @ebook.free? %>
            🆓 FREE E-BOOK
          <% else %>
            💎 PREMIUM
          <% end %>

        </div>


        <!-- COVER -->

        <div class="cover-platform">

          <% if @ebook.cover_image.attached? %>

            <%= image_tag @ebook.cover_image,
                          class: "ebook-cover",
                          alt: @ebook.title %>

          <% else %>

            <div class="no-cover">

              <div class="book-icon">
                📖
              </div>

              <div>
                <%= @ebook.title %>
              </div>

            </div>

          <% end %>

        </div>


        <!-- =================================================
             WHY CHOOSE
        ================================================== -->

        <div class="why-book">

          <h2 class="why-book-title">
            <span>📖</span>
            <span>Why Choose This Book?</span>
          </h2>


          <ul class="why-book-list">

            <li>
              Chapter-wise organized content
            </li>

            <li>
              Important maps and diagrams
            </li>

            <li>
              Exam-oriented study material
            </li>

            <li>
              Practice questions with solutions
            </li>

            <li>
              Easy to understand language
            </li>

          </ul>

        </div>


      </div>


      <!-- ===================================================
           RIGHT INFORMATION
      ==================================================== -->

      <div class="ebook-info-side">


        <!-- BADGE -->

        <div class="info-badge <%= 'free' if @ebook.free? %>">

          <% if @ebook.free? %>
            🆓 FREE E-BOOK
          <% else %>
            💎 PREMIUM E-BOOK
          <% end %>

        </div>


        <!-- TITLE -->

        <h1 class="ebook-title">
          <%= @ebook.title %>
        </h1>


        <!-- DESCRIPTION -->

        <% if @ebook.description.present? %>

          <div class="ebook-description">

            <%= simple_format(
                  @ebook.description
                ) %>

          </div>

        <% end %>


        <!-- =================================================
             META
        ================================================== -->

        <div class="ebook-meta">


          <% if @ebook.author.present? %>

            <div class="meta-item">

              <div class="meta-icon">
                ♙
              </div>

              <div class="meta-content">

                <span class="meta-label">
                  Author
                </span>

                <span class="meta-value">
                  <%= @ebook.author %>
                </span>

              </div>

            </div>

          <% end %>


          <% if @ebook.category.present? %>

            <div class="meta-item">

              <div class="meta-icon">
                📁
              </div>

              <div class="meta-content">

                <span class="meta-label">
                  Category
                </span>

                <span class="meta-value">
                  <%= @ebook.category %>
                </span>

              </div>

            </div>

          <% end %>


          <% if @ebook.language.present? %>

            <div class="meta-item">

              <div class="meta-icon">
                🌐
              </div>

              <div class="meta-content">

                <span class="meta-label">
                  Language
                </span>

                <span class="meta-value">
                  <%= @ebook.language %>
                </span>

              </div>

            </div>

          <% end %>


          <% if @ebook.exam_name.present? %>

            <div class="meta-item">

              <div class="meta-icon">
                🎯
              </div>

              <div class="meta-content">

                <span class="meta-label">
                  Exam
                </span>

                <span class="meta-value">
                  <%= @ebook.exam_name %>
                </span>

              </div>

            </div>

          <% end %>


        </div>


        <!-- =================================================
             PRICE
        ================================================== -->

        <% if ebook_owned %>


          <div class="price-box purchased-price-box">

            <span class="purchased-badge">
              ✓ Purchased
            </span>

            <span class="purchased-message">
              You already own this E-Book.
            </span>

          </div>


        <% elsif @ebook.free? %>


          <div class="price-box">

            <span class="free-price">
              FREE
            </span>

          </div>


        <% else %>


          <div class="price-box">

            <span class="current-price">

              ₹<%= number_with_precision(
                    @ebook.price,
                    precision: 0
                  ) %>

            </span>


            <% if @ebook.original_price.to_f >
                       @ebook.price.to_f %>

              <span class="original-price">

                ₹<%= number_with_precision(
                      @ebook.original_price,
                      precision: 0
                    ) %>

              </span>

            <% end %>


            <% if @ebook.discount_percentage.to_f > 0 %>

              <span class="discount">

                <%= @ebook.discount_percentage.to_i %>% OFF

              </span>

            <% end %>

          </div>


        <% end %>


        <!-- =================================================
             ACTION
        ================================================== -->

        <div class="action-row">


          <% if ebook_access_granted %>


            <%= link_to access_ebook_path(@ebook),
                class: "ebook-action primary-action" do %>

              📖
              <span>Read E-Book</span>
              <span>→</span>

            <% end %>


          <% elsif user_signed_in? %>


            <%= button_to buy_ebook_path(@ebook),
                method: :post,
                class: "ebook-action primary-action",
                form: {
                  data: {
                    turbo_confirm:
                      "Buy #{@ebook.title} for ₹#{number_with_precision(@ebook.price, precision: 0)}?"
                  }
                } do %>

              💳
              <span>Buy Now</span>
              <span>→</span>

            <% end %>


          <% else %>


            <%= link_to new_user_session_path,
                class: "ebook-action login-action" do %>

              🔐
              <span>Login to Buy</span>
              <span>→</span>

            <% end %>


          <% end %>


        </div>


        <!-- =================================================
             SECURITY
        ================================================== -->

        <% if ebook_owned %>

          <div class="security-note purchased-security-note">

            🔒 Payment verified.
            Your E-Book reading access is active.

          </div>


        <% elsif @ebook.free? %>

          <div class="security-note">

            📚 This E-Book is available for free reading.

          </div>


        <% else %>

          <div class="security-note">

            🔒 Purchase this E-Book to unlock
            the complete reading experience.

          </div>

        <% end %>


      </div>

    </section>


    <!-- =====================================================
         PDF FILES
    ====================================================== -->

    <section class="ebook-files-section">


      <!-- HEADER -->

      <div class="files-header">


        <div class="files-heading">

          <div class="files-heading-icon">
            PDF
          </div>

          <div>

            <h2 class="files-title">
              E-Book PDF Files
            </h2>

            <p class="files-subtitle">
              Get access to chapter-wise PDF files after purchase.
            </p>

          </div>

        </div>


        <div class="files-count">

          📁
          <%= @active_ebook_files.size %>
          PDF Files

        </div>


      </div>


      <!-- =================================================
           ACCESS GRANTED
      ================================================== -->

      <% if ebook_access_granted %>


        <% if @active_ebook_files.any? %>


           <% @active_ebook_files.each_with_index do |ebook_file, index| %>

            <div class="ebook-file-row">


              <!-- NUMBER -->

              <div class="file-number">

                <%= index + 1 %>

              </div>


              <!-- PDF ICON -->

              <div class="pdf-icon">

                PDF

              </div>


              <!-- FILE NAME -->

              <div class="file-name"
                   title="<%= ebook_file.title %>">

                <%= ebook_file.title %>

              </div>


              <!-- TYPE -->

              <div class="file-type">

                PDF

              </div>


              <!-- STATUS -->

              <div class="file-status">

                Available

              </div>


              <!-- READ -->

              <%= link_to access_ebook_path(@ebook),
                  class: "file-btn file-read-btn" do %>

                📖
                Read

              <% end %>


              <!-- DOWNLOAD -->

              <% if ebook_file.respond_to?(:pdf) &&
                    ebook_file.pdf.attached? %>

                <%= link_to rails_blob_path(
                      ebook_file.pdf,
                      disposition: "attachment"
                    ),
                    class: "file-btn file-download-btn" do %>

                  ↓
                  Download

                <% end %>

              <% end %>


            </div>


          <% end %>


        <% else %>


          <div class="no-files">

            📚 No PDF chapters have been added yet.

          </div>


        <% end %>


      <!-- =================================================
           LOCKED
      ================================================== -->

      <% else %>


        <div class="files-locked">

          <div class="files-locked-icon">
            🔒
          </div>

          <h3 class="files-locked-title">
            Chapter PDFs Locked
          </h3>

          <p class="files-locked-text">
            Purchase this E-Book to unlock
            all chapter-wise PDF files,
            reading and downloading.
          </p>

        </div>


      <% end %>


    </section>


  </div>

</div>


<!-- =========================================================
     3D EFFECT
========================================================= -->

<script nonce="<%= content_security_policy_nonce %>">

(function () {

  function initializeEbookShow() {

    const card =
      document.getElementById("ebook3dCard");


    if (
      !card ||
      card.dataset.initialized === "true"
    ) {
      return;
    }


    card.dataset.initialized =
      "true";


    /*
      Disable stronger 3D effect
      on touch devices.
    */

    const isTouchDevice =
      window.matchMedia(
        "(hover: none)"
      ).matches;


    if (isTouchDevice) {
      return;
    }


    card.addEventListener(
      "mousemove",
      function (event) {

        const rect =
          card.getBoundingClientRect();


        const x =
          event.clientX -
          rect.left;


        const y =
          event.clientY -
          rect.top;


        const rotateY =
          ((x / rect.width) - .5) * 2.5;


        const rotateX =
          ((y / rect.height) - .5) * -2.5;


        card.style.transform =
          "perspective(1400px)" +
          " rotateX(" +
          rotateX +
          "deg)" +
          " rotateY(" +
          rotateY +
          "deg)";

      }
    );


    card.addEventListener(
      "mouseleave",
      function () {

        card.style.transform =
          "perspective(1400px)" +
          " rotateX(0deg)" +
          " rotateY(0deg)";

      }
    );

  }


  document.addEventListener(
    "turbo:load",
    initializeEbookShow
  );


  if (
    document.readyState !==
    "loading"
  ) {

    initializeEbookShow();

  } else {

    document.addEventListener(
      "DOMContentLoaded",
      initializeEbookShow,
      { once: true }
    );

  }

})();

</script>