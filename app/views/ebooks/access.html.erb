<% content_for :hide_footer, true %>

<style nonce="<%= content_security_policy_nonce %>">

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;

    font-family:
      "Poppins",
      Arial,
      sans-serif;

    color: #24133d;

    background:
      radial-gradient(
        circle at 5% 10%,
        rgba(124, 58, 237, .12),
        transparent 25%
      ),
      radial-gradient(
        circle at 95% 85%,
        rgba(219, 39, 119, .12),
        transparent 25%
      ),
      #f8f5ff;
  }


  /* =========================================================
     PAGE
  ========================================================= */

  .ebook-read-page {
    min-height: 100vh;

    padding:
      105px 20px 70px;

    position: relative;

    overflow: hidden;
  }


  .ebook-read-container {
    width:
      min(1180px, 100%);

    margin:
      0 auto;

    position: relative;

    z-index: 2;
  }


  /* =========================================================
     BACK BUTTON
  ========================================================= */

  .reader-back {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      9px;

    text-decoration:
      none;

    color:
      #6d28d9;

    background:
      rgba(255,255,255,.94);

    border:
      1px solid
      rgba(124,58,237,.15);

    padding:
      11px 18px;

    border-radius:
      14px;

    font-weight:
      800;

    box-shadow:
      0 8px 25px
      rgba(31,41,55,.08);

    margin-bottom:
      25px;

    transition:
      .2s ease;
  }


  .reader-back:hover {
    color:
      #4c1d95;

    transform:
      translateY(-2px);
  }


  /* =========================================================
     HEADER
  ========================================================== */

  .reader-header {
    position: relative;

    display:
      grid;

    grid-template-columns:
      190px
      1fr;

    gap:
      30px;

    align-items:
      center;

    padding:
      28px;

    background:
      rgba(255,255,255,.96);

    border:
      1px solid
      rgba(124,58,237,.12);

    border-radius:
      28px;

    box-shadow:
      0 25px 60px
      rgba(31,41,55,.11);

    overflow:
      hidden;

    margin-bottom:
      30px;
  }


  .reader-header::before {
    content:
      "";

    position:
      absolute;

    width:
      280px;

    height:
      280px;

    right:
      -110px;

    top:
      -150px;

    border-radius:
      50%;

    background:
      rgba(124,58,237,.09);
  }


  .reader-header::after {
    content:
      "";

    position:
      absolute;

    width:
      220px;

    height:
      220px;

    left:
      -120px;

    bottom:
      -150px;

    border-radius:
      50%;

    background:
      rgba(219,39,119,.08);
  }


  /* =========================================================
     COVER
  ========================================================== */

  .reader-cover {
    width:
      170px;

    height:
      230px;

    position:
      relative;

    z-index:
      1;

    margin:
      0 auto;

    border-radius:
      13px;

    overflow:
      hidden;

    background:
      linear-gradient(
        145deg,
        #f3e8ff,
        #fce7f3
      );

    box-shadow:
      12px 18px 30px
      rgba(0,0,0,.20);
  }


  .reader-cover img {
    width:
      100%;

    height:
      100%;

    display:
      block;

    object-fit:
      contain;

    background:
      #ffffff;
  }


  .reader-no-cover {
    width:
      100%;

    height:
      100%;

    display:
      flex;

    flex-direction:
      column;

    justify-content:
      center;

    align-items:
      center;

    text-align:
      center;

    padding:
      15px;

    color:
      #ffffff;

    background:
      linear-gradient(
        145deg,
        #7c3aed,
        #db2777
      );
  }


  .reader-no-cover-icon {
    font-size:
      45px;

    margin-bottom:
      10px;
  }


  /* =========================================================
     HEADER INFORMATION
  ========================================================== */

  .reader-header-info {
    position:
      relative;

    z-index:
      2;
  }


  .reader-badge {
    display:
      inline-flex;

    padding:
      7px 13px;

    border-radius:
      999px;

    background:
      #f3e8ff;

    color:
      #7c3aed;

    font-size:
      12px;

    font-weight:
      900;

    margin-bottom:
      12px;
  }


  .reader-title {
    margin:
      0 0 10px;

    font-size:
      clamp(28px, 4vw, 44px);

    line-height:
      1.15;

    font-weight:
      900;

    color:
      #29143f;
  }


  .reader-description {
    margin:
      0 0 18px;

    color:
      #6b6477;

    font-size:
      15px;

    line-height:
      1.7;
  }


  .reader-stats {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      10px;
  }


  .reader-stat {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      7px;

    padding:
      8px 13px;

    border-radius:
      10px;

    background:
      #faf7ff;

    border:
      1px solid
      #eadff7;

    color:
      #5b476d;

    font-size:
      13px;

    font-weight:
      700;
  }


  /* =========================================================
     CHAPTER SECTION
  ========================================================== */

  .chapters-section {
    background:
      rgba(255,255,255,.95);

    border:
      1px solid
      rgba(124,58,237,.12);

    border-radius:
      28px;

    padding:
      30px;

    box-shadow:
      0 22px 55px
      rgba(31,41,55,.09);
  }


  .chapters-heading {
    display:
      flex;

    justify-content:
      space-between;

    align-items:
      center;

    gap:
      15px;

    margin-bottom:
      25px;
  }


  .chapters-heading h2 {
    margin:
      0;

    font-size:
      25px;

    font-weight:
      900;

    color:
      #30154b;
  }


  .chapter-count {
    padding:
      8px 14px;

    border-radius:
      999px;

    background:
      linear-gradient(
        135deg,
        #f3e8ff,
        #fce7f3
      );

    color:
      #7c3aed;

    font-size:
      13px;

    font-weight:
      900;
  }


  /* =========================================================
     CHAPTER CARD
  ========================================================== */

  .chapter-list {
    display:
      flex;

    flex-direction:
      column;

    gap:
      14px;
  }


  .chapter-card {
    display:
      grid;

    grid-template-columns:
      58px
      1fr
      auto;

    align-items:
      center;

    gap:
      18px;

    padding:
      17px 18px;

    border:
      1px solid
      #eadff7;

    border-radius:
      18px;

    background:
      linear-gradient(
        135deg,
        #ffffff,
        #fcfaff
      );

    box-shadow:
      0 8px 22px
      rgba(31,41,55,.055);

    transition:
      transform .2s ease,
      box-shadow .2s ease,
      border-color .2s ease;
  }


  .chapter-card:hover {
    transform:
      translateY(-3px);

    border-color:
      rgba(124,58,237,.30);

    box-shadow:
      0 15px 30px
      rgba(124,58,237,.10);
  }


  /* =========================================================
     NUMBER
  ========================================================== */

  .chapter-number {
    width:
      50px;

    height:
      50px;

    border-radius:
      15px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    color:
      #ffffff;

    background:
      linear-gradient(
        135deg,
        #7c3aed,
        #db2777
      );

    font-size:
      17px;

    font-weight:
      900;

    box-shadow:
      0 8px 18px
      rgba(124,58,237,.20);
  }


  /* =========================================================
     CHAPTER CONTENT
  ========================================================== */

  .chapter-content {
    min-width:
      0;
  }


  .chapter-title {
    margin:
      0 0 5px;

    color:
      #2f1c43;

    font-size:
      16px;

    font-weight:
      900;
  }


  .chapter-description {
    margin:
      0;

    color:
      #81788d;

    font-size:
      13px;

    line-height:
      1.5;
  }


  .chapter-pdf-status {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      6px;

    margin-top:
      8px;

    color:
      #15803d;

    font-size:
      12px;

    font-weight:
      800;
  }


  /* =========================================================
     ACTIONS
  ========================================================== */

  .chapter-actions {
    display:
      flex;

    align-items:
      center;

    gap:
      9px;
  }


  .chapter-btn {
    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    gap:
      7px;

    min-width:
      105px;

    padding:
      11px 15px;

    border-radius:
      12px;

    text-decoration:
      none;

    font-size:
      13px;

    font-weight:
      900;

    transition:
      .2s ease;
  }


  .chapter-read {
    color:
      #ffffff;

    background:
      linear-gradient(
        135deg,
        #7c3aed,
        #db2777
      );

    box-shadow:
      0 8px 18px
      rgba(124,58,237,.20);
  }


  .chapter-read:hover {
    color:
      #ffffff;

    transform:
      translateY(-2px);
  }


  .chapter-download {
    color:
      #6d28d9;

    background:
      #f3e8ff;

    border:
      1px solid
      #e9d5ff;
  }


  .chapter-download:hover {
    color:
      #4c1d95;

    transform:
      translateY(-2px);
  }


  /* =========================================================
     EMPTY STATE
  ========================================================== */

  .empty-chapters {
    text-align:
      center;

    padding:
      55px 20px;
  }


  .empty-icon {
    font-size:
      55px;

    margin-bottom:
      12px;
  }


  .empty-title {
    margin:
      0 0 7px;

    font-size:
      22px;

    font-weight:
      900;

    color:
      #342445;
  }


  .empty-text {
    margin:
      0;

    color:
      #7a7184;

    font-size:
      14px;
  }


  /* =========================================================
     SECURITY
  ========================================================== */

  .reader-security {
    margin-top:
      20px;

    padding:
      15px 18px;

    border-radius:
      14px;

    background:
      rgba(34,197,94,.08);

    border:
      1px solid
      rgba(34,197,94,.20);

    color:
      #15803d;

    font-size:
      13px;

    font-weight:
      700;
  }


  /* =========================================================
     RESPONSIVE
  ========================================================== */

  @media (max-width: 800px) {

    .reader-header {
      grid-template-columns:
        1fr;

      text-align:
        center;
    }


    .reader-stats {
      justify-content:
        center;
    }


    .reader-cover {
      width:
        190px;

      height:
        255px;
    }


    .chapters-heading {
      align-items:
        flex-start;

      flex-direction:
        column;
    }


    .chapter-card {
      grid-template-columns:
        52px
        1fr;
      }


    .chapter-actions {
      grid-column:
        2;

      justify-content:
        flex-start;
    }

  }


  @media (max-width: 520px) {

    .ebook-read-page {
      padding:
        95px 12px 40px;
    }


    .reader-header {
      padding:
        20px;

      border-radius:
        22px;
    }


    .reader-cover {
      width:
        180px;

      height:
        240px;
    }


    .chapters-section {
      padding:
        20px;

      border-radius:
        22px;
    }


    .chapter-card {
      grid-template-columns:
        45px
        1fr;

      gap:
        12px;

      padding:
        14px;
    }


    .chapter-number {
      width:
        42px;

      height:
        42px;

      border-radius:
        12px;

      font-size:
        15px;
    }


    .chapter-actions {
      grid-column:
        1 / -1;

      width:
        100%;

      display:
        grid;

      grid-template-columns:
        1fr 1fr;
    }


    .chapter-btn {
      width:
        100%;

      min-width:
        0;
    }

  }


  /* =========================================================
     ACCESSIBILITY
  ========================================================== */

  .reader-back:focus-visible,
  .chapter-btn:focus-visible {
    outline:
      3px solid
      rgba(219,39,119,.35);

    outline-offset:
      3px;
  }


  @media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
      animation-duration:
        .01ms !important;

      transition-duration:
        .01ms !important;
    }

  }

</style>


<div class="ebook-read-page">

  <div class="ebook-read-container">

    <!-- =====================================================
         BACK
    ====================================================== -->

    <%= link_to ebook_path(@ebook),
        class: "reader-back" do %>

      ← Back to E-Book Details

    <% end %>


    <!-- =====================================================
         BOOK HEADER
    ====================================================== -->

    <section class="reader-header">

      <div class="reader-cover">

        <% if @ebook.cover_image.attached? %>

          <%= image_tag @ebook.cover_image,
                        alt: @ebook.title %>

        <% else %>

          <div class="reader-no-cover">

            <div class="reader-no-cover-icon">
              📖
            </div>

            <strong>
              <%= @ebook.title %>
            </strong>

          </div>

        <% end %>

      </div>


      <div class="reader-header-info">

        <div class="reader-badge">
          📚 E-BOOK READER
        </div>


        <h1 class="reader-title">
          <%= @ebook.title %>
        </h1>


        <% if @ebook.description.present? %>

          <div class="reader-description">
            <%= simple_format(@ebook.description) %>
          </div>

        <% end %>


        <div class="reader-stats">

          <div class="reader-stat">
            📄
            <%= @ebook_files.length %>
            Chapters
          </div>


          <% if @ebook.author.present? %>

            <div class="reader-stat">
              ✍️
              <%= @ebook.author %>
            </div>

          <% end %>


          <% if @ebook.language.present? %>

            <div class="reader-stat">
              🌐
              <%= @ebook.language %>
            </div>

          <% end %>


          <% if @ebook.exam_name.present? %>

            <div class="reader-stat">
              🎯
              <%= @ebook.exam_name %>
            </div>

          <% end %>

        </div>

      </div>

    </section>


    <!-- =====================================================
         CHAPTERS
    ====================================================== -->

    <section class="chapters-section">

      <div class="chapters-heading">

        <h2>
          📖 Chapter Index
        </h2>

        <div class="chapter-count">
          <%= @ebook_files.length %>
          PDF Files
        </div>

      </div>


      <% if @ebook_files.present? %>

        <div class="chapter-list">

          <% @ebook_files.each_with_index do |ebook_file, index| %>

            <article class="chapter-card">


              <div class="chapter-number">
                <%= ebook_file.position || index + 1 %>
              </div>


              <div class="chapter-content">

                <h3 class="chapter-title">
                  <%= ebook_file.title %>
                </h3>


                <% if ebook_file.description.present? %>

                  <p class="chapter-description">
                    <%= ebook_file.description %>
                  </p>

                <% else %>

                  <p class="chapter-description">
                    Chapter-wise study material
                  </p>

                <% end %>


                <% if ebook_file.pdf.attached? %>

                  <div class="chapter-pdf-status">
                    ✓ PDF Available
                  </div>

                <% end %>

              </div>


              <div class="chapter-actions">

                <% if ebook_file.pdf.attached? %>

                  <%= link_to ebook_file_path(ebook_file),
                      class: "chapter-btn chapter-read" do %>

                    📖 Read

                  <% end %>


                  <%= link_to download_ebook_file_path(ebook_file),
                      class: "chapter-btn chapter-download" do %>

                    ⬇ Download

                  <% end %>

                <% end %>

              </div>

            </article>

          <% end %>

        </div>


        <div class="reader-security">

          🔒 Your E-Book access is protected.
          Only active purchased E-Book users can open
          these PDF files.

        </div>


      <% else %>

        <div class="empty-chapters">

          <div class="empty-icon">
            📂
          </div>

          <h3 class="empty-title">
            No Chapters Available
          </h3>

          <p class="empty-text">
            PDF chapters have not been added to this E-Book yet.
          </p>

        </div>

      <% end %>

    </section>

  </div>

</div>