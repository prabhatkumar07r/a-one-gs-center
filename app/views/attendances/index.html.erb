    </strong>
  </div>

</div>
```

  </div>

  <!-- =====================================================
       FILTERS
  ====================================================== -->

  <div class="attendance-filter-card">

```
<div class="attendance-filter-header">

  <h3 class="attendance-filter-title">
    <i class="bi bi-funnel"></i>
    Attendance Filters
  </h3>

</div>


<%= form_with url: attendances_path,
              method: :get,
              local: true,
              class: "attendance-filter-form" do |form| %>


  <!-- SEARCH -->

  <div class="attendance-field">

    <label for="attendance_search">
      Search Student
    </label>

    <%= text_field_tag :search,
          params[:search],
          id: "attendance_search",
          class: "form-control",
          placeholder: "Search by student name..." %>

  </div>


  <!-- COURSE -->

  <div class="attendance-field">

    <label for="attendance_course">
      Course
    </label>

    <%= select_tag :course_id,
          options_from_collection_for_select(
            @courses,
            :id,
            :Course_name,
            params[:course_id]
          ),
          include_blank: "All Courses",
          id: "attendance_course",
          class: "form-select" %>

  </div>


  <!-- STUDENT -->

  <div class="attendance-field">

    <label for="attendance_student">
      Student
    </label>

    <%= select_tag :student_id,
          options_from_collection_for_select(
            @students,
            :id,
            :name,
            params[:student_id]
          ),
          include_blank: "All Students",
          id: "attendance_student",
          class: "form-select" %>

  </div>


  <!-- DATE -->

  <div class="attendance-field">

    <label for="attendance_date">
      Date
    </label>

    <%= date_field_tag :date,
          params[:date],
          id: "attendance_date",
          class: "form-control" %>

  </div>


  <!-- STATUS -->

  <div class="attendance-field">

    <label for="attendance_status">
      Status
    </label>

    <%= select_tag :status,
          options_for_select(
            [
              ["Present", "Present"],
              ["Absent", "Absent"],
              ["Leave", "Leave"]
            ],
            params[:status]
          ),
          include_blank: "All Status",
          id: "attendance_status",
          class: "form-select" %>

  </div>


  <!-- BUTTONS -->

  <div class="attendance-filter-actions">

    <button type="submit"
            class="attendance-btn-apply">
      <i class="bi bi-search me-1"></i>
      Apply
    </button>

    <%= link_to attendances_path,
          class: "attendance-btn-reset text-decoration-none d-flex align-items-center justify-content-center" do %>

      <i class="bi bi-arrow-counterclockwise me-1"></i>
      Reset

    <% end %>

  </div>

<% end %>


<!-- ACTIVE FILTERS -->

<% if params[:course_id].present? ||
      params[:student_id].present? ||
      params[:date].present? ||
      params[:status].present? ||
      params[:search].present? %>

  <div class="attendance-active-filters">

    <span class="active-filter-label">
      Active:
    </span>


    <% if params[:search].present? %>

      <span class="active-filter-badge">
        <i class="bi bi-search"></i>
        <%= params[:search] %>
      </span>

    <% end %>


    <% if params[:course_id].present? %>

      <% selected_course =
           @courses.find_by(id: params[:course_id]) %>

      <% if selected_course %>

        <span class="active-filter-badge">
          <i class="bi bi-book"></i>
         <%= selected_course.Course_name %>
        </span>

      <% end %>

    <% end %>


    <% if params[:student_id].present? %>

      <% selected_student =
           @students.find_by(id: params[:student_id]) %>

      <% if selected_student %>

        <span class="active-filter-badge">
          <i class="bi bi-person"></i>
          <%= selected_student.name %>
        </span>

      <% end %>

    <% end %>


    <% if params[:date].present? %>

      <span class="active-filter-badge">
        <i class="bi bi-calendar"></i>
        <%= params[:date] %>
      </span>

    <% end %>


    <% if params[:status].present? %>

      <span class="active-filter-badge">
        <i class="bi bi-circle-fill"></i>
        <%= params[:status] %>
      </span>

    <% end %>

  </div>

<% end %>
```

  </div>

  <!-- =====================================================
       ATTENDANCE TABLE
  ====================================================== -->

  <div class="attendance-table-card">

```
<div class="attendance-table-header">

  <h3 class="attendance-table-title">
    Attendance Records
  </h3>

  <span class="attendance-record-count">
    <i class="bi bi-list-check"></i>

    <%= @attendances.count %>
    Records
  </span>

</div>


<% if @attendances.present? %>

  <div class="attendance-table-wrapper">

    <table class="attendance-table">

      <thead>

        <tr>

          <th>#</th>

          <th>Student</th>

          <th>Course</th>

          <th>Date</th>

          <th>Status</th>

          <th>Action</th>

        </tr>

      </thead>


      <tbody>

        <% @attendances.each_with_index do |attendance, index| %>

          <tr>

            <!-- NUMBER -->

            <td class="attendance-number">
              <%= index + 1 %>
            </td>


            <!-- STUDENT -->

            <td>

              <div class="attendance-student">

                <div class="attendance-avatar">

                  <%= attendance.user&.name
                        .to_s
                        .first
                        .upcase
                        .presence || "S" %>

                </div>


                <div>

                  <div class="attendance-student-name">

                    <%= attendance.user&.name.presence ||
                        "Unknown Student" %>

                  </div>


                  <% if attendance.user&.email.present? %>

                    <span class="attendance-student-email">

                      <%= attendance.user.email %>

                    </span>

                  <% end %>

                </div>

              </div>

            </td>


            <!-- COURSE -->

            <td>

              <div class="attendance-course">

                <div class="attendance-course-icon">
                  <i class="bi bi-book"></i>
                </div>

                <span class="attendance-course-name">

                  <%= attendance.course&.Course_name.presence ||
                      "No Course" %>

                </span>

              </div>

            </td>


            <!-- DATE -->

            <td>

              <div class="attendance-date">

                <i class="bi bi-calendar3"></i>

                <%= attendance.date.present? ?
                    attendance.date.strftime("%d %b %Y") :
                    "—" %>

              </div>

            </td>


            <!-- STATUS -->

            <td>

              <% status_class =
                   case attendance.status.to_s.downcase
                   when "present"
                     "present"
                   when "absent"
                     "absent"
                   when "leave"
                     "leave"
                   else
                     "other"
                   end %>


              <span class="attendance-status <%= status_class %>">

                <% if attendance.status.to_s.downcase == "present" %>

                  <i class="bi bi-check-circle-fill"></i>

                <% elsif attendance.status.to_s.downcase == "absent" %>

                  <i class="bi bi-x-circle-fill"></i>

                <% elsif attendance.status.to_s.downcase == "leave" %>

                  <i class="bi bi-calendar-minus-fill"></i>

                <% else %>

                  <i class="bi bi-circle-fill"></i>

                <% end %>

                <%= attendance.status.presence || "Unknown" %>

              </span>

            </td>


            <!-- ACTION -->

            <td>

              <%= link_to attendance_path(attendance),
                    class: "attendance-view-btn",
                    title: "View Attendance" do %>

                <i class="bi bi-eye"></i>

              <% end %>

            </td>

          </tr>

        <% end %>

      </tbody>

    </table>

  </div>


<% else %>

  <!-- EMPTY -->

  <div class="attendance-empty">

    <div class="attendance-empty-icon">

      <i class="bi bi-calendar-x"></i>

    </div>

    <h5>
      No Attendance Records Found
    </h5>

    <p>
      There are no attendance records matching the selected filters.
    </p>

  </div>

<% end %>
```

  </div>

</div>

<script>
document.addEventListener("turbo:load", function () {

  const searchInput =
    document.getElementById("attendance_search");

  const courseSelect =
    document.getElementById("attendance_course");

  const studentSelect =
    document.getElementById("attendance_student");

  const dateInput =
    document.getElementById("attendance_date");

  const statusSelect =
    document.getElementById("attendance_status");


  /* =====================================================
     SEARCH CLEAR
  ====================================================== */

  if (searchInput) {

    searchInput.addEventListener("keydown", function(event) {

      if (event.key === "Escape") {

        this.value = "";

      }

    });

  }


  /* =====================================================
     COURSE -> STUDENT VISUAL HINT
  ====================================================== */

  if (courseSelect && studentSelect) {

    courseSelect.addEventListener("change", function () {

      if (this.value) {

        studentSelect.setAttribute(
          "title",
          "Students enrolled in the selected course"
        );

      } else {

        studentSelect.removeAttribute("title");

      }

    });

  }


  /* =====================================================
     ENTER TO SUBMIT SEARCH
  ====================================================== */

  if (searchInput) {

    searchInput.addEventListener("keydown", function(event) {

      if (event.key === "Enter") {

        event.preventDefault();

        const form = this.closest("form");

        if (form) {
          form.submit();
        }

      }

    });

  }


  /* =====================================================
     DATE PICKER
  ====================================================== */

  if (dateInput) {

    dateInput.addEventListener("change", function () {

      this.classList.toggle(
        "has-value",
        this.value !== ""
      );

    });

  }


  /* =====================================================
     TOOLTIP
  ====================================================== */

  if (typeof bootstrap !== "undefined") {

    document
      .querySelectorAll('[title]')
      .forEach(function (element) {

        new bootstrap.Tooltip(element);

      });

  }

});
</script>
