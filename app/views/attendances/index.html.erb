<% content_for :page_title, "Attendance Management" %>

<style>
/* =========================================================
   ADMIN ATTENDANCE DASHBOARD
   Scoped to .admin-attendance-page
========================================================= */

.admin-attendance-page {
  padding: 28px;
  background: #f5f7fb;
  min-height: calc(100vh - 75px);
}


/* =========================================================
   HEADER
========================================================= */

.attendance-page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.attendance-page-title {
  margin: 0;
  font-size: 28px;
  font-weight: 800;
  color: #182230;
}

.attendance-page-subtitle {
  margin: 6px 0 0;
  color: #6b7280;
  font-size: 14px;
}

.attendance-header-icon {
  width: 58px;
  height: 58px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #245187;
  color: #fff;
  font-size: 25px;
  box-shadow: 0 8px 20px rgba(36, 81, 135, .20);
}


/* =========================================================
   STATISTICS
========================================================= */

.attendance-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 25px;
}

.attendance-stat-card {
  background: #fff;
  border: 1px solid #e7ebf2;
  border-radius: 16px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 15px;
  box-shadow: 0 5px 20px rgba(15, 23, 42, .05);
  transition: transform .2s ease, box-shadow .2s ease;
}

.attendance-stat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 28px rgba(15, 23, 42, .08);
}

.attendance-stat-icon {
  width: 48px;
  height: 48px;
  min-width: 48px;
  border-radius: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21px;
}

.stat-total .attendance-stat-icon {
  background: #eaf1fb;
  color: #245187;
}

.stat-present .attendance-stat-icon {
  background: #e9f8ef;
  color: #198754;
}

.stat-absent .attendance-stat-icon {
  background: #fdecec;
  color: #dc3545;
}

.stat-leave .attendance-stat-icon {
  background: #fff5df;
  color: #d99000;
}

.attendance-stat-label {
  display: block;
  font-size: 13px;
  color: #6b7280;
  margin-bottom: 4px;
}

.attendance-stat-value {
  display: block;
  font-size: 25px;
  line-height: 1;
  font-weight: 800;
  color: #182230;
}


/* =========================================================
   FILTER CARD
========================================================= */

.attendance-filter-card {
  background: #fff;
  border: 1px solid #e7ebf2;
  border-radius: 16px;
  padding: 22px;
  margin-bottom: 25px;
  box-shadow: 0 5px 20px rgba(15, 23, 42, .05);
}

.attendance-filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.attendance-filter-title {
  margin: 0;
  font-size: 17px;
  font-weight: 750;
  color: #182230;
}

.attendance-filter-title i {
  color: #245187;
  margin-right: 7px;
}

.attendance-filter-form {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr auto;
  gap: 13px;
  align-items: end;
}

.attendance-field label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: #4b5563;
  margin-bottom: 7px;
}

.attendance-field .form-control,
.attendance-field .form-select {
  height: 44px;
  border: 1px solid #dfe4ec;
  border-radius: 10px;
  font-size: 13px;
  box-shadow: none;
}

.attendance-field .form-control:focus,
.attendance-field .form-select:focus {
  border-color: #245187;
  box-shadow: 0 0 0 3px rgba(36, 81, 135, .10);
}

.attendance-filter-actions {
  display: flex;
  gap: 8px;
}

.attendance-btn-apply {
  height: 44px;
  border: none;
  border-radius: 10px;
  background: #245187;
  color: #fff;
  padding: 0 18px;
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  transition: .2s;
}

.attendance-btn-apply:hover {
  background: #1d426f;
  color: #fff;
}

.attendance-btn-reset {
  height: 44px;
  border: 1px solid #dfe4ec;
  border-radius: 10px;
  background: #fff;
  color: #4b5563;
  padding: 0 15px;
  font-size: 13px;
  font-weight: 650;
  white-space: nowrap;
}

.attendance-btn-reset:hover {
  background: #f5f7fb;
  color: #182230;
}


/* =========================================================
   ACTIVE FILTERS
========================================================= */

.attendance-active-filters {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 16px;
}

.active-filter-label {
  font-size: 12px;
  font-weight: 700;
  color: #6b7280;
}

.active-filter-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: #eef4fb;
  color: #245187;
  border-radius: 20px;
  padding: 6px 10px;
  font-size: 11px;
  font-weight: 700;
}


/* =========================================================
   TABLE CARD
========================================================= */

.attendance-table-card {
  background: #fff;
  border: 1px solid #e7ebf2;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 5px 20px rgba(15, 23, 42, .05);
}

.attendance-table-header {
  padding: 20px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  border-bottom: 1px solid #edf0f5;
}

.attendance-table-title {
  margin: 0;
  font-size: 17px;
  font-weight: 750;
  color: #182230;
}

.attendance-record-count {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: #f1f5f9;
  color: #475569;
  padding: 6px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
}

.attendance-table-wrapper {
  overflow-x: auto;
}

.attendance-table {
  width: 100%;
  margin: 0;
  border-collapse: collapse;
  min-width: 850px;
}

.attendance-table thead th {
  background: #f8fafc;
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .5px;
  padding: 14px 18px;
  border-bottom: 1px solid #e8edf3;
  white-space: nowrap;
}

.attendance-table tbody td {
  padding: 15px 18px;
  border-bottom: 1px solid #edf0f5;
  vertical-align: middle;
  font-size: 13px;
  color: #334155;
}

.attendance-table tbody tr:last-child td {
  border-bottom: none;
}

.attendance-table tbody tr {
  transition: background .15s ease;
}

.attendance-table tbody tr:hover {
  background: #f8fbff;
}


/* =========================================================
   RECORD NUMBER
========================================================= */

.attendance-number {
  width: 40px;
  color: #94a3b8;
  font-size: 12px;
  font-weight: 700;
}


/* =========================================================
   STUDENT
========================================================= */

.attendance-student {
  display: flex;
  align-items: center;
  gap: 11px;
}

.attendance-avatar {
  width: 38px;
  height: 38px;
  min-width: 38px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eaf1fb;
  color: #245187;
  font-size: 15px;
  font-weight: 800;
}

.attendance-student-name {
  font-weight: 750;
  color: #1e293b;
}

.attendance-student-email {
  display: block;
  color: #94a3b8;
  font-size: 11px;
  margin-top: 2px;
}


/* =========================================================
   COURSE
========================================================= */

.attendance-course {
  display: flex;
  align-items: center;
  gap: 9px;
}

.attendance-course-icon {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background: #f0f4f9;
  color: #245187;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}

.attendance-course-name {
  font-weight: 650;
  color: #334155;
}


/* =========================================================
   DATE
========================================================= */

.attendance-date {
  display: flex;
  align-items: center;
  gap: 7px;
  white-space: nowrap;
}

.attendance-date i {
  color: #94a3b8;
}


/* =========================================================
   STATUS
========================================================= */

.attendance-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 11px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 800;
}

.attendance-status.present {
  background: #e9f8ef;
  color: #16804b;
}

.attendance-status.absent {
  background: #fdecec;
  color: #c92a2a;
}

.attendance-status.leave {
  background: #fff5df;
  color: #b87900;
}

.attendance-status.other {
  background: #eef2f7;
  color: #64748b;
}


/* =========================================================
   VIEW BUTTON
========================================================= */

.attendance-view-btn {
  width: 35px;
  height: 35px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #dfe5ed;
  border-radius: 9px;
  background: #fff;
  color: #64748b;
  text-decoration: none;
  transition: .2s;
}

.attendance-view-btn:hover {
  background: #245187;
  color: #fff;
  border-color: #245187;
}


/* =========================================================
   EMPTY STATE
========================================================= */

.attendance-empty {
  text-align: center;
  padding: 65px 20px;
}

.attendance-empty-icon {
  width: 72px;
  height: 72px;
  margin: 0 auto 16px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef4fb;
  color: #245187;
  font-size: 30px;
}

.attendance-empty h5 {
  margin: 0 0 7px;
  color: #334155;
  font-weight: 750;
}

.attendance-empty p {
  margin: 0;
  color: #94a3b8;
  font-size: 13px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1300px) {
  .attendance-filter-form {
    grid-template-columns: repeat(3, 1fr);
  }

  .attendance-filter-actions {
    grid-column: span 3;
  }
}

@media (max-width: 992px) {
  .admin-attendance-page {
    padding: 22px;
  }

  .attendance-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .attendance-filter-form {
    grid-template-columns: repeat(2, 1fr);
  }

  .attendance-filter-actions {
    grid-column: span 2;
  }
}

@media (max-width: 576px) {
  .admin-attendance-page {
    padding: 15px;
  }

  .attendance-page-header {
    align-items: flex-start;
  }

  .attendance-page-title {
    font-size: 22px;
  }

  .attendance-header-icon {
    width: 48px;
    height: 48px;
    font-size: 20px;
  }

  .attendance-stats {
    grid-template-columns: 1fr;
  }

  .attendance-filter-card {
    padding: 16px;
  }

  .attendance-filter-form {
    grid-template-columns: 1fr;
  }

  .attendance-filter-actions {
    grid-column: auto;
    width: 100%;
  }

  .attendance-btn-apply,
  .attendance-btn-reset {
    flex: 1;
  }

  .attendance-table-header {
    padding: 16px;
  }
}
</style>

<div class="admin-attendance-page">

  <!-- =====================================================
       PAGE HEADER
  ====================================================== -->

  <div class="attendance-page-header">

```
