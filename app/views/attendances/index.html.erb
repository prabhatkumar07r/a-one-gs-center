<%= render "layouts/header" %>

<div class="container-fluid py-4">

  <!-- Page Heading -->
  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h2 class="fw-bold text-primary">
        <i class="bi bi-calendar-check-fill"></i>
        Attendance Management
      </h2>

      <p class="text-muted">
        Track and manage daily student attendance.
      </p>
    </div>

    <%= link_to new_attendance_path,
        class: "btn btn-success shadow" do %>

      <i class="bi bi-plus-circle"></i>
      Take Attendance

    <% end %>

  </div>

  <!-- Dashboard Cards -->

  <div class="row g-4 mb-4">

    <div class="col-lg-3 col-md-6">

      <div class="card shadow border-0 attendance-card">

        <div class="card-body text-center">

          <i class="bi bi-calendar2-check display-5 text-primary"></i>

          <h6 class="mt-3">Total Attendance</h6>

          <h2><%= @total_attendance %></h2>

        </div>

      </div>

    </div>

    <div class="col-lg-3 col-md-6">

      <div class="card shadow border-0 attendance-card">

        <div class="card-body text-center">

          <i class="bi bi-check-circle-fill display-5 text-success"></i>

          <h6 class="mt-3">Present</h6>

          <h2 class="text-success">
            <%= @present %>
          </h2>

        </div>

      </div>

    </div>

    <div class="col-lg-3 col-md-6">

      <div class="card shadow border-0 attendance-card">

        <div class="card-body text-center">

          <i class="bi bi-x-circle-fill display-5 text-danger"></i>

          <h6 class="mt-3">Absent</h6>

          <h2 class="text-danger">
            <%= @absent %>
          </h2>

        </div>

      </div>

    </div>

    <div class="col-lg-3 col-md-6">

      <div class="card shadow border-0 attendance-card">

        <div class="card-body text-center">

          <i class="bi bi-clock-history display-5 text-warning"></i>

          <h6 class="mt-3">Leave</h6>

          <h2 class="text-warning">
            <%= @leave %>
          </h2>

        </div>

      </div>

    </div>

  </div>

  <!-- Search -->

  <div class="card shadow border-0 mb-4">

    <div class="card-body">

      <%= form_with url: attendances_path,
            method: :get,
            local: true do %>

        <div class="row">

          <div class="col-md-10">

            <%= text_field_tag :search,
                  params[:search],
                  class: "form-control",
                  placeholder: "Search Student..." %>

          </div>

          <div class="col-md-2">

            <%= submit_tag "Search",
                  class: "btn btn-primary w-100" %>

          </div>

        </div>

      <% end %>

    </div>

  </div>

  <!-- Attendance Table -->

  <div class="card shadow border-0">

    <div class="card-header bg-primary text-white">

      <h5 class="mb-0">
        Attendance Records
      </h5>

    </div>

    <div class="table-responsive">

      <table class="table table-hover align-middle mb-0">

        <thead class="table-light">

          <tr>

            <th>#</th>
            <th>Student</th>
            <th>Course</th>
            <th>Date</th>
            <th>Status</th>
            <th width="220">Action</th>

          </tr>

        </thead>

        <tbody>

          <% @attendances.each_with_index do |attendance,index| %>

            <tr>

              <td><%= index+1 %></td>

              <td>
                <strong><%= attendance.user.name %></strong>
              </td>

              <td>
                <%= attendance.course.Course_name %>
              </td>

              <td>
                <%= attendance.date.strftime("%d %b %Y") %>
              </td>

               <td>
                 <% if attendance.status == "Present" %>

                 <span class="badge bg-success">
                 Present
                </span>

                <% elsif attendance.status == "Absent" %>

               <span class="badge bg-danger">
                Absent
               </span>

               <% else %>

                <span class="badge bg-warning text-dark">
               Leave
               </span>

           <% end %>
           </td>
              <td>

                <%= link_to attendance,
                    class:"btn btn-info btn-sm" do %>

                  <i class="bi bi-eye"></i>

                <% end %>

                <%= link_to edit_attendance_path(attendance),
                    class:"btn btn-warning btn-sm" do %>

                  <i class="bi bi-pencil-square"></i>

                <% end %>

                <%= button_to attendance,
                    method: :delete,
                    form:{data:{turbo_confirm:"Delete Attendance?"}},
                    class:"btn btn-danger btn-sm d-inline" do %>

                  <i class="bi bi-trash"></i>

                <% end %>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>

</div>

<%= render "layouts/footer" %>