  </p>
</div>

<div class="attendance-header-icon">
  <i class="bi bi-calendar-check"></i>
</div>
```

  </div>

  <!-- =====================================================
       STATISTICS
  ====================================================== -->

  <div class="attendance-stats">

```
<!-- TOTAL -->

