<%= render "layouts/header" %>

<div class="container py-5">

  <div class="row justify-content-center">

    <div class="col-lg-8">

      <div class="card shadow-lg border-0">

        <div class="card-header bg-primary text-white">

          <h3 class="mb-0">
            <i class="bi bi-calendar-check-fill"></i>
            Take Attendance
          </h3>

        </div>

        <div class="card-body">

          <%= form_with model: @attendance do |f| %>

            <% if @attendance.errors.any? %>

              <div class="alert alert-danger">

                <h6>Please fix the following errors:</h6>

                <ul class="mb-0">

                  <% @attendance.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>

                </ul>

              </div>

            <% end %>

            <div class="row">

              <div class="col-md-6 mb-3">

                <%= f.label :user_id, "Student", class: "form-label fw-bold" %>

                           <%= f.collection_select :user_id,
      User.where(role: "student"),
      :id,
      :name,
      { prompt: "Select Student" },
      { class: "form-select" } %>

              </div>

              <div class="col-md-6 mb-3">

                <%= f.label :course_id, "Course", class: "form-label fw-bold" %>

                <%= f.collection_select :course_id,
                      Course.all,
                      :id,
                      :Course_name,
                      { prompt: "Select Course" },
                      class: "form-select" %>

              </div>

            </div>

            <div class="row">

              <div class="col-md-6 mb-3">

                <%= f.label :date, class: "form-label fw-bold" %>

                <%= f.date_field :date,
                      value: Date.today,
                      class: "form-control" %>

              </div>

              <div class="col-md-6 mb-3">

                <%= f.label :status, class: "form-label fw-bold" %>

                <%= f.select :status,
                      ["Present", "Absent", "Leave"],
                      {},
                      class: "form-select" %>

              </div>

            </div>

            <div class="d-flex justify-content-end mt-4">

              <%= link_to attendances_path,
                    class: "btn btn-secondary me-2" do %>

                <i class="bi bi-arrow-left"></i>
                Back

              <% end %>

              <%= f.submit "Save Attendance",
                    class: "btn btn-success" %>

            </div>

          <% end %>

        </div>

      </div>

    </div>

  </div>

</div>

<%= render "layouts/footer" %>