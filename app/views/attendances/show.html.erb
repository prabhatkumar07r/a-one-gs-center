
<style>
/* =========================================================
   ADMIN ATTENDANCE SHOW PAGE
   Scoped only to .admin-attendance-show
========================================================= */

.admin-attendance-show {
  padding: 28px;
  min-height: calc(100vh - 75px);
  background: #f5f7fb;
}

/* =========================================================
   PAGE HEADER
========================================================= */

.admin-attendance-show .attendance-page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 25px;
}

.admin-attendance-show .attendance-title-area {
  display: flex;
  align-items: center;
  gap: 15px;
}

.admin-attendance-show .attendance-title-icon {
  width: 55px;
  height: 55px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15px;
  background: linear-gradient(135deg, #245187, #356ca8);
  color: #fff;
  font-size: 25px;
  box-shadow: 0 8px 20px rgba(36, 81, 135, .18);
}

.admin-attendance-show .attendance-page-title {
  margin: 0;
  color: #172033;
  font-size: 26px;
  font-weight: 750;
}

.admin-attendance-show .attendance-page-subtitle {
  margin: 4px 0 0;
  color: #7a8496;
  font-size: 14px;
}

/* =========================================================
   MAIN CARD
========================================================= */

.admin-attendance-show .attendance-detail-card {
  max-width: 1000px;
  margin: 0 auto;
  background: #fff;
  border: 1px solid #e7ebf2;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 10px 35px rgba(22, 34, 51, .07);
}

/* =========================================================
   CARD TOP
========================================================= */

.admin-attendance-show .attendance-card-top {
  padding: 28px;
  background: linear-gradient(135deg, #245187, #356ca8);
  color: #fff;
}

.admin-attendance-show .student-section {
  display: flex;
  align-items: center;
  gap: 18px;
}

.admin-attendance-show .student-avatar {
  width: 68px;
  height: 68px;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,.18);
  border: 2px solid rgba(255,255,255,.4);
  font-size: 27px;
}

.admin-attendance-show .student-name {
  margin: 0;
  font-size: 23px;
  font-weight: 700;
}

.admin-attendance-show .student-email {
  display: block;
  margin-top: 4px;
  color: rgba(255,255,255,.8);
  font-size: 14px;
}

/* =========================================================
   STATUS
========================================================= */

.admin-attendance-show .status-badge {
  margin-left: auto;
  padding: 9px 16px;
  border-radius: 50px;
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
}

.admin-attendance-show .status-present {
  background: #dcfce7;
  color: #15803d;
}

.admin-attendance-show .status-absent {
  background: #fee2e2;
  color: #b91c1c;
}

.admin-attendance-show .status-leave {
  background: #fef3c7;
  color: #92400e;
}

.admin-attendance-show .status-default {
  background: #e5e7eb;
  color: #374151;
}

/* =========================================================
   DETAILS
========================================================= */

.admin-attendance-show .attendance-card-body {
  padding: 30px;
}

.admin-attendance-show .detail-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}

.admin-attendance-show .detail-box {
  padding: 20px;
  border: 1px solid #e7ebf2;
  border-radius: 14px;
  background: #fafbfc;
  transition: all .25s ease;
}

.admin-attendance-show .detail-box:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(20, 30, 50, .06);
}

.admin-attendance-show .detail-label {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #8a94a6;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .6px;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.admin-attendance-show .detail-label i {
  color: #245187;
}

.admin-attendance-show .detail-value {
  color: #202938;
  font-size: 16px;
  font-weight: 650;
}

.admin-attendance-show .detail-value small {
  display: block;
  margin-top: 4px;
  color: #8a94a6;
  font-size: 12px;
  font-weight: 400;
}

/* =========================================================
   ACTIONS
========================================================= */

.admin-attendance-show .attendance-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 10px;
  margin-top: 28px;
  padding-top: 22px;
  border-top: 1px solid #edf0f5;
}

.admin-attendance-show .attendance-action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 42px;
  padding: 9px 17px;
  border-radius: 9px;
  font-size: 14px;
  font-weight: 650;
  text-decoration: none;
  transition: all .2s ease;
}

.admin-attendance-show .back-btn {
  color: #4b5563;
  background: #f3f4f6;
  border: 1px solid #e5e7eb;
}

.admin-attendance-show .back-btn:hover {
  background: #e5e7eb;
  color: #111827;
}

.admin-attendance-show .edit-btn {
  color: #fff;
  background: #245187;
  border: 1px solid #245187;
}

.admin-attendance-show .edit-btn:hover {
  background: #1c416e;
  transform: translateY(-1px);
}

.admin-attendance-show .delete-btn {
  color: #dc2626;
  background: #fff;
  border: 1px solid #fecaca;
}

.admin-attendance-show .delete-btn:hover {
  color: #fff;
  background: #dc2626;
}

/* =========================================================
   DELETE FORM
========================================================= */

.admin-attendance-show .delete-form {
  margin: 0;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 768px) {

  .admin-attendance-show {
    padding: 18px;
  }

  .admin-attendance-show .attendance-page-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-attendance-show .attendance-page-title {
    font-size: 22px;
  }

  .admin-attendance-show .attendance-card-top {
    padding: 22px;
  }

  .admin-attendance-show .student-section {
    align-items: flex-start;
  }

  .admin-attendance-show .status-badge {
    margin-left: 0;
    margin-top: 12px;
  }

  .admin-attendance-show .detail-grid {
    grid-template-columns: 1fr;
  }

  .admin-attendance-show .attendance-card-body {
    padding: 20px;
  }

  .admin-attendance-show .attendance-actions {
    flex-direction: column;
  }

  .admin-attendance-show .attendance-action-btn,
  .admin-attendance-show .delete-form {
    width: 100%;
  }

  .admin-attendance-show .delete-form button {
    width: 100%;
  }
}
</style>


<div class="admin-attendance-show">

  <!-- =====================================================
       PAGE HEADER
  ====================================================== -->

  <div class="attendance-page-header">

    <div class="attendance-title-area">

      <div class="attendance-title-icon">
        <i class="bi bi-calendar-check"></i>
      </div>

      <div>
        <h1 class="attendance-page-title">
          Attendance Details
        </h1>

        <p class="attendance-page-subtitle">
          Complete information about this attendance record
        </p>
      </div>

    </div>


    <%= link_to attendances_path,
          class: "attendance-action-btn back-btn" do %>

      <i class="bi bi-arrow-left"></i>
      Back to Attendance

    <% end %>

  </div>


  <!-- =====================================================
       ATTENDANCE DETAIL CARD
  ====================================================== -->

  <div class="attendance-detail-card">


    <!-- Student Header -->

    <div class="attendance-card-top">

      <div class="student-section">

        <div class="student-avatar">
          <i class="bi bi-person"></i>
        </div>

        <div>

          <h2 class="student-name">
            <%= @attendance.user&.name.presence || "Unknown Student" %>
          </h2>

          <% if @attendance.user&.email.present? %>

            <span class="student-email">
              <i class="bi bi-envelope me-1"></i>
              <%= @attendance.user.email %>
            </span>

          <% end %>

        </div>


        <!-- Status -->
             <!-- Status -->

<% if @attendance.status == "Present" %>

  <span class="status-badge status-present">
    <i class="bi bi-check-circle me-1"></i>
    Present
  </span>

<% elsif @attendance.status == "Absent" %>

  <span class="status-badge status-absent">
    <i class="bi bi-x-circle me-1"></i>
    Absent
  </span>

<% elsif @attendance.status == "Leave" %>

  <span class="status-badge status-leave">
    <i class="bi bi-calendar-x me-1"></i>
    Leave
  </span>

<% else %>

  <span class="status-badge status-default">
    <%= @attendance.status.presence || "Unknown" %>
  </span>

<% end %>

    <!-- Details -->

    <div class="attendance-card-body">

      <div class="detail-grid">


        <!-- Course -->

        <div class="detail-box">

          <div class="detail-label">
            <i class="bi bi-book"></i>
            Course
          </div>

          <div class="detail-value">

            <%= @attendance.course&.Course_name.presence ||
                "No Course" %>

          </div>

        </div>


        <!-- Attendance Date -->

        <div class="detail-box">

          <div class="detail-label">
            <i class="bi bi-calendar-event"></i>
            Attendance Date
          </div>

          <div class="detail-value">

            <%= @attendance.date&.strftime("%d %B %Y") || "—" %>

          </div>

        </div>


        <!-- Status -->

        <div class="detail-box">

          <div class="detail-label">
            <i class="bi bi-clipboard-check"></i>
            Attendance Status
          </div>

          <div class="detail-value">

            <%= @attendance.status.presence || "Unknown" %>

          </div>

        </div>


        <!-- Created -->

        <div class="detail-box">

          <div class="detail-label">
            <i class="bi bi-clock"></i>
            Record Created
          </div>

          <div class="detail-value">

            <%= @attendance.created_at&.strftime(
                  "%d %B %Y, %I:%M %p"
                ) || "—" %>

          </div>

        </div>


        <!-- Updated -->

        <div class="detail-box">

          <div class="detail-label">
            <i class="bi bi-arrow-repeat"></i>
            Last Updated
          </div>

          <div class="detail-value">

            <%= @attendance.updated_at&.strftime(
                  "%d %B %Y, %I:%M %p"
                ) || "—" %>

          </div>

        </div>


        <!-- Student Email -->

        <div class="detail-box">

          <div class="detail-label">
            <i class="bi bi-envelope"></i>
            Student Email
          </div>

          <div class="detail-value">

            <%= @attendance.user&.email.presence ||
                "No email available" %>

          </div>

        </div>

      </div>


      <!-- =================================================
           ACTIONS
      ================================================== -->

      <div class="attendance-actions">

        <%= link_to attendances_path,
              class: "attendance-action-btn back-btn" do %>

          <i class="bi bi-arrow-left"></i>
          Back

        <% end %>


        <%= link_to edit_attendance_path(@attendance),
              class: "attendance-action-btn edit-btn" do %>

          <i class="bi bi-pencil"></i>
          Edit

        <% end %>


        <%= button_to attendance_path(@attendance),
              method: :delete,
              class: "attendance-action-btn delete-btn delete-form",
              form_class: "delete-form",
              data: {
                attendance_delete: true
              } do %>

          <i class="bi bi-trash"></i>
          Delete

        <% end %>

      </div>

    </div>

  </div>

</div>


<script>
document.addEventListener("turbo:load", function () {

  /*
   * Admin Attendance Show Page
   * Delete confirmation
   */

  const deleteButton =
    document.querySelector(
      '[data-attendance-delete="true"]'
    );

  if (!deleteButton) return;


  deleteButton.addEventListener("click", function (event) {

    const student =
      "<%= j(@attendance.user&.name.presence || 'this student') %>";

    const course =
      "<%= j(@attendance.course&.Course_name.presence || 'this course') %>";

    const status =
      "<%= j(@attendance.status.presence || 'attendance record') %>";

    const message =
      `Delete attendance for ${student} from ${course} (${status})?`;

    if (!confirm(message)) {
      event.preventDefault();
    }

  });

});
</script>
