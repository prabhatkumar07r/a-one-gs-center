<div class="aone-forgot-page">

  <div class="auth-container">

    <!-- =====================================================
         LEFT — BRANDING
    ====================================================== -->

    <section class="auth-image" aria-label="A ONE GS CENTER">

      <div class="auth-glow auth-glow-one"></div>
      <div class="auth-glow auth-glow-two"></div>

      <div class="auth-image-content">

        <div class="brand-logo-wrap">

          <%= image_tag "logo.jpeg",
              alt: "A ONE GS CENTER Logo",
              class: "brand-logo" %>

        </div>

        <h1>A ONE GS CENTER</h1>

        <div class="brand-line"></div>

        <p>
          Reset your password securely and continue
          your learning journey with us.
        </p>

        <div class="security-badge">

          <i class="bi bi-shield-check"></i>

          <span>
            Secure Password Recovery
          </span>

        </div>

      </div>

    </section>


    <!-- =====================================================
         RIGHT — FORGOT PASSWORD
    ====================================================== -->

    <section class="auth-forms">

      <div class="auth-form-wrapper">


        <!-- =================================================
             AUTH TABS
        ================================================== -->

        <div class="auth-tabs" role="tablist">

          <div class="auth-tab active"
               role="tab"
               aria-selected="true">

            <i class="bi bi-key"></i>

            <span>
              Forgot Password
            </span>

          </div>


          <%= link_to new_user_session_path,
              class: "auth-tab auth-tab-link" do %>

            <i class="bi bi-box-arrow-in-right"></i>

            <span>
              Login
            </span>

          <% end %>

        </div>


        <!-- =================================================
             FORM CARD
        ================================================== -->

        <div class="auth-form active">


          <!-- HEADER -->

          <div class="forgot-header">

            <div class="forgot-icon">

              <i class="bi bi-lock"></i>

            </div>

            <div>

              <h2 class="form-title">
                Reset Password
              </h2>

              <p class="form-subtitle">
                Enter your registered email address and
                we'll send you instructions to reset your
                password.
              </p>

            </div>

          </div>


          <!-- =================================================
               DEVise FORM
          ================================================== -->

          <%= form_for(
                resource,
                as: resource_name,
                url: password_path(resource_name),
                html: {
                  method: :post,
                  class: "forgot-password-form"
                }
              ) do |f| %>


            <!-- DEVise ERRORS -->

            <% if resource.errors.any? %>

              <div class="forgot-error">

                <div class="forgot-error-icon">

                  <i class="bi bi-exclamation-triangle-fill"></i>

                </div>

                <div>

                  <strong>
                    Please check your email address.
                  </strong>

                  <%= render "devise/shared/error_messages",
                      resource: resource %>

                </div>

              </div>

            <% end %>


            <!-- EMAIL -->

            <div class="form-group">

              <%= f.label :email,
                  "Email Address",
                  class: "form-label" %>


              <div class="input-wrapper">

                <i class="bi bi-envelope form-icon"
                   aria-hidden="true"></i>


                <%= f.email_field :email,
                      autofocus: true,
                      autocomplete: "email",
                      class: "form-control",
                      placeholder: "Enter your registered email",
                      required: true,
                      inputmode: "email",
                      spellcheck: false,
                      autocapitalize: "none" %>

              </div>


              <div class="email-help">

                <i class="bi bi-info-circle"></i>

                <span>
                  Use the email address linked to your account.
                </span>

              </div>

            </div>


            <!-- =================================================
                 SUBMIT
            ================================================== -->

            <%= f.submit "Send Reset Instructions",
                  class: "btn forgot-submit",
                  data: {
                    disable_with: "Sending Instructions..."
                  } %>


          <% end %>


          <!-- =================================================
               FOOTER
          ================================================== -->

          <div class="auth-footer">

            <span>
              Remember your password?
            </span>

            <%= link_to new_user_session_path do %>

              Login

              <i class="bi bi-arrow-right"></i>

            <% end %>

          </div>


          <!-- SECURITY NOTE -->

          <div class="forgot-security">

            <i class="bi bi-shield-lock"></i>

            <span>
              Your password reset link will be sent
              securely to your registered email.
            </span>

          </div>


        </div>

      </div>

    </section>

  </div>

</div>


<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   A ONE GS CENTER
   DEVISE FORGOT PASSWORD
   PROFESSIONAL RESPONSIVE AUTH UI
========================================================= */


/* =========================================================
   1. GLOBAL SAFETY
========================================================= */

html,
body {
  overflow-x: hidden;
}


.aone-forgot-page,
.aone-forgot-page *,
.aone-forgot-page *::before,
.aone-forgot-page *::after {
  box-sizing: border-box;
}


.aone-forgot-page {
  isolation: isolate;
}


/* =========================================================
   2. PAGE
========================================================= */

.aone-forgot-page {
  --auth-bg: #080a12;
  --auth-panel: #0d101a;
  --auth-card: #101522;

  --auth-primary: #7c3aed;
  --auth-secondary: #2563eb;

  --auth-text: #f8fafc;
  --auth-muted: #94a3b8;

  --auth-border: rgba(255, 255, 255, 0.08);

  /*
   * GLOBAL NAVBAR SAFE AREA
   *
   * Navbar fixed/sticky hone ki wajah se
   * page content navbar ke neeche start hoga.
   */
  min-height: 100dvh;

  width: 100%;

  display: flex;

  align-items: flex-start;
  justify-content: center;

  padding: 135px 20px 40px;

  overflow-x: hidden;

  background:
    radial-gradient(
      circle at 10% 15%,
      rgba(124, 58, 237, 0.14),
      transparent 35%
    ),
    radial-gradient(
      circle at 90% 85%,
      rgba(37, 99, 235, 0.12),
      transparent 35%
    ),
    var(--auth-bg);

  color: var(--auth-text);
}


/* =========================================================
   3. MAIN CONTAINER
========================================================= */

.aone-forgot-page .auth-container {
  width: min(1180px, 100%);

  min-height: 640px;

  display: grid;

  grid-template-columns:
    minmax(360px, 0.92fr)
    minmax(470px, 1.08fr);

  overflow: hidden;

  border:
    1px solid rgba(255, 255, 255, 0.08);

  border-radius: 28px;

  background: #0d101a;

  box-shadow:
    0 30px 90px rgba(0, 0, 0, 0.45),
    0 8px 30px rgba(0, 0, 0, 0.20);
}


/* =========================================================
   4. LEFT BRANDING
========================================================= */

.aone-forgot-page .auth-image {
  position: relative;

  min-height: 640px;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 55px 45px;

  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      #28104b 0%,
      #52158a 48%,
      #2563eb 125%
    );
}


/* =========================================================
   5. DECORATIVE GLOWS
========================================================= */

.aone-forgot-page .auth-glow {
  position: absolute;

  border-radius: 50%;

  pointer-events: none;
}


.aone-forgot-page .auth-glow-one {
  width: 430px;
  height: 430px;

  top: -200px;
  left: -180px;

  background:
    rgba(255, 255, 255, 0.08);
}


.aone-forgot-page .auth-glow-two {
  width: 370px;
  height: 370px;

  right: -180px;
  bottom: -190px;

  background:
    rgba(255, 255, 255, 0.07);
}


/* =========================================================
   6. BRAND CONTENT
========================================================= */

.aone-forgot-page .auth-image-content {
  position: relative;

  z-index: 2;

  width: 100%;

  max-width: 430px;

  text-align: center;
}


.aone-forgot-page .brand-logo-wrap {
  width: 128px;
  height: 128px;

  margin: 0 auto 25px;

  padding: 7px;

  border-radius: 30px;

  background:
    rgba(255, 255, 255, 0.14);

  border:
    1px solid rgba(255, 255, 255, 0.25);

  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.25);

  backdrop-filter: blur(12px);
}


.aone-forgot-page .brand-logo {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: contain;

  border-radius: 23px;

  background: #ffffff;
}


.aone-forgot-page .auth-image-content h1 {
  margin: 0;

  color: #ffffff;

  font-size:
    clamp(27px, 3vw, 40px);

  font-weight: 800;

  letter-spacing: 0.4px;
}


.aone-forgot-page .brand-line {
  width: 58px;
  height: 4px;

  margin:
    16px auto 19px;

  border-radius: 999px;

  background:
    rgba(255, 255, 255, 0.9);
}


.aone-forgot-page .auth-image-content > p {
  max-width: 370px;

  margin: 0 auto;

  color:
    rgba(255, 255, 255, 0.82);

  font-size: 14px;

  line-height: 1.8;
}


.aone-forgot-page .security-badge {
  display: inline-flex;

  align-items: center;

  gap: 8px;

  margin-top: 26px;

  padding:
    10px 16px;

  border:
    1px solid rgba(255, 255, 255, 0.18);

  border-radius: 999px;

  background:
    rgba(255, 255, 255, 0.10);

  color:
    rgba(255, 255, 255, 0.94);

  font-size: 11px;

  font-weight: 600;
}


/* =========================================================
   7. RIGHT SIDE
========================================================= */

.aone-forgot-page .auth-forms {
  min-width: 0;

  display: flex;

  align-items: center;
  justify-content: center;

  padding:
    50px 60px;

  background:
    var(--auth-panel);
}


.aone-forgot-page .auth-form-wrapper {
  width: 100%;

  max-width: 520px;
}


/* =========================================================
   8. AUTH TABS
========================================================= */

.aone-forgot-page .auth-tabs {
  display: flex;

  gap: 7px;

  margin-bottom: 28px;

  padding: 5px;

  border:
    1px solid rgba(255, 255, 255, 0.07);

  border-radius: 14px;

  background:
    rgba(255, 255, 255, 0.035);
}


.aone-forgot-page .auth-tab {
  min-height: 42px;

  flex: 1;

  display: flex;

  align-items: center;
  justify-content: center;

  gap: 7px;

  border-radius: 10px;

  color:
    var(--auth-muted);

  font-size: 12px;

  font-weight: 650;

  text-decoration: none;
}


.aone-forgot-page .auth-tab.active {
  color: #ffffff;

  background:
    rgba(124, 58, 237, 0.16);

  box-shadow:
    inset 0 0 0 1px
    rgba(124, 58, 237, 0.18);
}


.aone-forgot-page .auth-tab-link {
  transition:
    color 0.2s ease,
    background 0.2s ease;
}


.aone-forgot-page .auth-tab-link:hover {
  color: #ffffff;

  background:
    rgba(255, 255, 255, 0.05);
}


/* =========================================================
   9. FORM CARD
========================================================= */

.aone-forgot-page .auth-form {
  padding:
    36px;

  border:
    1px solid rgba(255, 255, 255, 0.07);

  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      #111625,
      #0e131f
    );

  box-shadow:
    0 25px 70px rgba(0, 0, 0, 0.30);
}


/* =========================================================
   10. HEADER
========================================================= */

.aone-forgot-page .forgot-header {
  display: flex;

  align-items: flex-start;

  gap: 15px;

  margin-bottom: 29px;
}


.aone-forgot-page .forgot-icon {
  flex: 0 0 50px;

  width: 50px;
  height: 50px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 15px;

  background:
    rgba(124, 58, 237, 0.14);

  color:
    #a78bfa;

  font-size: 21px;

  box-shadow:
    inset 0 0 0 1px
    rgba(124, 58, 237, 0.12);
}


/* =========================================================
   11. TITLE
========================================================= */

.aone-forgot-page .form-title {
  margin: 0 0 7px;

  color: #ffffff;

  font-size:
    clamp(23px, 3vw, 30px);

  line-height: 1.25;

  font-weight: 800;
}


.aone-forgot-page .form-subtitle {
  margin: 0;

  color:
    var(--auth-muted);

  font-size: 12px;

  line-height: 1.7;
}


/* =========================================================
   12. FORM GROUP
========================================================= */

.aone-forgot-page .form-group {
  margin-bottom: 22px;
}


.aone-forgot-page .form-label {
  display: block;

  margin-bottom: 9px;

  color:
    #e2e8f0;

  font-size: 12px;

  font-weight: 650;
}


/* =========================================================
   13. INPUT WRAPPER
========================================================= */

.aone-forgot-page .input-wrapper {
  position: relative;

  width: 100%;
}


/* =========================================================
   14. INPUT
========================================================= */

.aone-forgot-page .form-control {
  width: 100%;

  min-height: 55px;

  padding:
    14px 16px 14px 47px !important;

  border:
    1px solid rgba(148, 163, 184, 0.18) !important;

  border-radius: 13px !important;

  outline: none !important;

  background:
    #0b0f19 !important;

  color:
    #ffffff !important;

  font-size:
    13px !important;

  box-shadow: none !important;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}


.aone-forgot-page .form-control::placeholder {
  color:
    #64748b;
}


.aone-forgot-page .form-control:hover {
  border-color:
    rgba(167, 139, 250, 0.45) !important;
}


.aone-forgot-page .form-control:focus {
  background:
    #0d1220 !important;

  border-color:
    #8b5cf6 !important;

  box-shadow:
    0 0 0 4px
    rgba(124, 58, 237, 0.12) !important;
}


/* =========================================================
   15. EMAIL ICON
========================================================= */

.aone-forgot-page .form-icon {
  position: absolute;

  left: 16px;

  top: 50%;

  z-index: 2;

  transform:
    translateY(-50%);

  color:
    #64748b;

  font-size: 17px;

  pointer-events: none;

  transition:
    color 0.2s ease;
}


.aone-forgot-page
.input-wrapper:focus-within
.form-icon {
  color:
    #a78bfa;
}


/* =========================================================
   16. EMAIL HELP
========================================================= */

.aone-forgot-page .email-help {
  display: flex;

  align-items: center;

  gap: 6px;

  margin-top: 8px;

  color:
    #64748b;

  font-size: 10px;

  line-height: 1.5;
}


.aone-forgot-page .email-help i {
  color:
    #8b5cf6;
}


/* =========================================================
   17. DEVISE ERROR
========================================================= */

.aone-forgot-page .forgot-error {
  display: flex;

  align-items: flex-start;

  gap: 11px;

  margin-bottom: 20px;

  padding:
    13px 14px;

  border:
    1px solid rgba(239, 68, 68, 0.25);

  border-radius: 12px;

  background:
    rgba(239, 68, 68, 0.07);

  color:
    #fca5a5;

  font-size: 11px;

  line-height: 1.6;
}


.aone-forgot-page .forgot-error-icon {
  flex:
    0 0 25px;

  color:
    #f87171;

  font-size: 14px;
}


.aone-forgot-page .forgot-error strong {
  display: block;

  margin-bottom: 4px;

  color:
    #fecaca;

  font-size: 11px;
}


/* =========================================================
   DEVISE ERROR LIST
========================================================= */

.aone-forgot-page .forgot-error ul {
  margin: 4px 0 0;

  padding-left: 17px;
}


.aone-forgot-page .forgot-error li {
  margin-bottom: 2px;
}


/* =========================================================
   18. SUBMIT BUTTON
========================================================= */

.aone-forgot-page .forgot-submit {
  width: 100%;

  min-height: 54px;

  margin-top: 3px;

  border: 0 !important;

  border-radius: 13px !important;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #2563eb
    ) !important;

  color:
    #ffffff !important;

  font-size:
    13px !important;

  font-weight:
    700 !important;

  cursor: pointer;

  box-shadow:
    0 12px 28px
    rgba(37, 99, 235, 0.20);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    filter 0.2s ease;
}


.aone-forgot-page .forgot-submit:hover {
  transform:
    translateY(-1px);

  filter:
    brightness(1.08);

  box-shadow:
    0 16px 34px
    rgba(37, 99, 235, 0.28);
}


.aone-forgot-page .forgot-submit:active {
  transform:
    translateY(0);
}


.aone-forgot-page .forgot-submit:focus-visible {
  outline:
    3px solid
    rgba(139, 92, 246, 0.25);

  outline-offset:
    3px;
}


/* =========================================================
   19. FOOTER
========================================================= */

.aone-forgot-page .auth-footer {
  margin-top: 24px;

  text-align: center;

  color:
    var(--auth-muted);

  font-size: 11px;

  line-height: 1.6;
}


.aone-forgot-page .auth-footer a {
