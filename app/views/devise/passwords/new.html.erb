<style>
  /* =========================================================
   A ONE GS CENTER
   DEVISE - FORGOT PASSWORD / RESET PASSWORD
   BLUE-VIOLET DARK THEME
========================================================= */


/* =========================================================
   1. AUTH PAGE SAFETY
========================================================= */

.auth-container,
.auth-container *,
.auth-container *::before,
.auth-container *::after {
  box-sizing: border-box;
}

.auth-container {
  --auth-bg: #080a12;
  --auth-panel: #0d101a;
  --auth-card: #101522;
  --auth-border: rgba(255, 255, 255, 0.08);

  --auth-primary: #7c3aed;
  --auth-secondary: #2563eb;

  --auth-text: #f8fafc;
  --auth-muted: #94a3b8;

  min-height: 100vh;
  width: 100%;
  display: flex;

  background:
    radial-gradient(
      circle at 15% 20%,
      rgba(124, 58, 237, 0.16),
      transparent 35%
    ),
    radial-gradient(
      circle at 85% 80%,
      rgba(37, 99, 235, 0.14),
      transparent 35%
    ),
    var(--auth-bg);

  color: var(--auth-text);
}


/* =========================================================
   2. LEFT BRANDING SECTION
========================================================= */

.auth-image {
  width: 50%;
  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 60px;

  position: relative;
  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      rgba(124, 58, 237, 0.95),
      rgba(37, 99, 235, 0.85)
    );
}


/* Decorative glow */

.auth-image::before {
  content: "";

  position: absolute;

  width: 420px;
  height: 420px;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.08);

  top: -180px;
  left: -180px;
}

.auth-image::after {
  content: "";

  position: absolute;

  width: 350px;
  height: 350px;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.06);

  bottom: -160px;
  right: -140px;
}


/* Branding content */

.auth-image-content {
  position: relative;
  z-index: 2;

  width: 100%;
  max-width: 500px;

  text-align: center;
}


/* Logo */

.auth-image-content img {
  width: 145px;
  height: 145px;

  object-fit: cover;

  border-radius: 50%;

  display: block;

  margin: 0 auto 28px;

  background: #ffffff;

  padding: 6px;

  box-shadow:
    0 15px 45px rgba(0, 0, 0, 0.25);
}


/* Brand title */

.auth-image-content h2 {
  margin: 0 0 16px;

  color: #ffffff;

  font-size: clamp(28px, 3vw, 42px);

  font-weight: 800;

  letter-spacing: 0.5px;
}


/* Brand description */

.auth-image-content p {
  margin: 0 auto;

  max-width: 430px;

  color: rgba(255, 255, 255, 0.88);

  font-size: 16px;

  line-height: 1.8;
}


/* =========================================================
   3. RIGHT AUTH SECTION
========================================================= */

.auth-forms {
  width: 50%;
  min-height: 100vh;

  display: flex;
  flex-direction: column;

  justify-content: center;

  padding: 50px;

  background: var(--auth-panel);
}


/* =========================================================
   4. AUTH CARD / FORM WIDTH
========================================================= */

.auth-tabs,
.auth-form {
  width: 100%;
  max-width: 520px;

  margin-left: auto;
  margin-right: auto;
}


/* =========================================================
   5. TABS
========================================================= */

.auth-tabs {
  display: flex;

  margin-bottom: 35px;

  border-bottom: 1px solid var(--auth-border);
}


/* Individual tab */

.auth-tab {
  flex: 1;

  position: relative;

  padding: 15px 10px;

  text-align: center;

  color: var(--auth-muted);

  font-size: 15px;

  font-weight: 600;
}


/* Tab links */

.auth-tab a {
  color: inherit;

  text-decoration: none;

  transition: color 0.25s ease;
}

.auth-tab a:hover {
  color: #ffffff;
}


/* Active tab */

.auth-tab.active {
  color: #ffffff;
}


/* Active underline */

.auth-tab.active::after {
  content: "";

  position: absolute;

  left: 10%;
  right: 10%;

  bottom: -1px;

  height: 3px;

  border-radius: 10px;

  background:
    linear-gradient(
      90deg,
      var(--auth-primary),
      var(--auth-secondary)
    );

  box-shadow:
    0 0 15px rgba(124, 58, 237, 0.55);
}


/* =========================================================
   6. FORM
========================================================= */

.auth-form {
  background: var(--auth-card);

  border: 1px solid var(--auth-border);

  border-radius: 20px;

  padding: 40px;

  box-shadow:
    0 25px 70px rgba(0, 0, 0, 0.35);
}


/* =========================================================
   7. FORM TITLE
========================================================= */

.form-title {
  margin: 0 0 10px;

  color: #ffffff;

  font-size: 30px;

  font-weight: 800;

  text-align: center;
}


/* =========================================================
   8. FORM SUBTITLE
========================================================= */

.form-subtitle {
  margin: 0 auto 30px;

  max-width: 430px;

  color: var(--auth-muted);

  font-size: 14px;

  line-height: 1.7;

  text-align: center;
}


/* =========================================================
   9. FORM GROUP
========================================================= */

.form-group {
  position: relative;

  margin-bottom: 24px;
}


/* =========================================================
   10. LABEL
========================================================= */

.form-group label {
  display: block;

  margin-bottom: 9px;

  color: #e2e8f0;

  font-size: 14px;

  font-weight: 600;
}


/* =========================================================
   11. INPUT
========================================================= */

.auth-container .form-control {
  width: 100%;

  min-height: 54px;

  padding: 14px 48px 14px 16px;

  border: 1px solid rgba(148, 163, 184, 0.18);

  border-radius: 12px;

  outline: none;

  background: #0b0f19;

  color: #ffffff;

  font-size: 15px;

  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}


/* Placeholder */

.auth-container .form-control::placeholder {
  color: #64748b;
}


/* Focus */

.auth-container .form-control:focus {
  background: #0d1220;

  border-color: var(--auth-primary);

  box-shadow:
    0 0 0 3px rgba(124, 58, 237, 0.15),
    0 0 20px rgba(124, 58, 237, 0.08);

  color: #ffffff;
}


/* =========================================================
   12. EMAIL ICON
========================================================= */

.auth-container .form-icon {
  position: absolute;

  right: 17px;

  bottom: 17px;

  z-index: 3;

  color: #64748b;

  font-size: 18px;

  pointer-events: none;
}


/* =========================================================
   13. SUBMIT BUTTON
========================================================= */

.auth-container .btn {
  width: 100%;

  min-height: 54px;

  margin-top: 4px;

  border: none;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      var(--auth-primary),
      var(--auth-secondary)
    );

  color: #ffffff;

  font-size: 15px;

  font-weight: 700;

  letter-spacing: 0.2px;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    filter 0.2s ease;
}


/* Button hover */

.auth-container .btn:hover {
  color: #ffffff;

  transform: translateY(-2px);

  filter: brightness(1.08);

  box-shadow:
    0 12px 30px rgba(37, 99, 235, 0.25),
    0 8px 25px rgba(124, 58, 237, 0.25);
}


/* Button active */

.auth-container .btn:active {
  transform: translateY(0);
}


/* =========================================================
   14. DEVISE ERROR MESSAGES
========================================================= */

.auth-container #error_explanation {
  margin-bottom: 22px;

  padding: 15px 17px;

  border: 1px solid rgba(239, 68, 68, 0.25);

  border-radius: 12px;

  background: rgba(239, 68, 68, 0.08);

  color: #fca5a5;

  font-size: 14px;
}

.auth-container #error_explanation h2 {
  margin: 0 0 8px;

  font-size: 14px;

  font-weight: 700;
}

.auth-container #error_explanation ul {
  margin: 0;

  padding-left: 20px;
}


/* =========================================================
   15. FOOTER
========================================================= */

.auth-footer {
  margin-top: 28px;

  text-align: center;

  color: var(--auth-muted);

  font-size: 14px;

  line-height: 1.6;
}


/* Footer link */

.auth-footer a {
  margin-left: 4px;

  color: #a78bfa;

  font-weight: 700;

  text-decoration: none;

  transition: color 0.2s ease;
}

.auth-footer a:hover {
  color: #c4b5fd;

  text-decoration: underline;
}


/* =========================================================
   16. MOBILE
========================================================= */

@media (max-width: 900px) {

  .auth-container {
    display: block;

    min-height: 100vh;
  }


  .auth-image {
    width: 100%;

    min-height: auto;

    padding: 50px 25px;
  }


  .auth-image-content img {
    width: 110px;
    height: 110px;

    margin-bottom: 20px;
  }


  .auth-image-content h2 {
    font-size: 28px;
  }


  .auth-image-content p {
    font-size: 14px;
  }


  .auth-forms {
    width: 100%;

    min-height: auto;

    padding: 40px 20px 50px;
  }


  .auth-form {
    padding: 30px 22px;

    border-radius: 16px;
  }


  .form-title {
    font-size: 26px;
  }

}


/* =========================================================
   17. SMALL MOBILE
========================================================= */

@media (max-width: 480px) {

  .auth-image {
    padding: 40px 20px;
  }


  .auth-image-content img {
    width: 95px;
    height: 95px;
  }


  .auth-image-content h2 {
    font-size: 24px;
  }


  .auth-image-content p {
    font-size: 13px;

    line-height: 1.6;
  }


  .auth-forms {
    padding: 30px 14px 40px;
  }


  .auth-tabs {
    margin-bottom: 25px;
  }


  .auth-tab {
    padding: 13px 6px;

    font-size: 14px;
  }


  .auth-form {
    padding: 26px 18px;
  }


  .form-title {
    font-size: 24px;
  }


  .form-subtitle {
    font-size: 13px;
  }


  .auth-container .form-control {
    min-height: 52px;

    font-size: 14px;
  }


  .auth-container .btn {
    min-height: 52px;
  }

}
</style>

<div class="auth-container">

  <!-- =====================================================
       LEFT SIDE - BRANDING
  ====================================================== -->

  <div class="auth-image">

    <div class="auth-image-content">

      <%= image_tag "logo.jpeg",
          alt: "A ONE GS CENTER" %>

      <h2>A ONE GS CENTER</h2>

      <p>
        Reset your password securely and continue your learning journey.
      </p>

    </div>

  </div>


  <!-- =====================================================
       RIGHT SIDE - FORGOT PASSWORD
  ====================================================== -->

  <div class="auth-forms">

    <!-- AUTH TABS -->
    <div class="auth-tabs">

      <div class="auth-tab active">
        Forgot Password
      </div>

      <div class="auth-tab">
        <%= link_to "Login", new_user_session_path %>
      </div>

    </div>


    <!-- FORM -->
    <div class="auth-form active">

      <h2 class="form-title">
        Reset Password
      </h2>

      <p class="form-subtitle">
        Enter your registered email address and we'll send you
        instructions to reset your password.
      </p>


      <%= form_for(
            resource,
            as: resource_name,
            url: password_path(resource_name),
            html: { method: :post }
          ) do |f| %>

        <!-- DEVise ERRORS -->
        <%= render "devise/shared/error_messages",
            resource: resource %>


        <!-- EMAIL -->
        <div class="form-group">

          <%= f.label :email, "Email Address" %>

          <i class="bi bi-envelope form-icon"></i>

          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                class: "form-control",
                placeholder: "Enter your registered email",
                required: true %>

        </div>


        <!-- SUBMIT -->
        <%= f.submit "Send Reset Instructions",
              class: "btn" %>

      <% end %>


      <!-- FOOTER -->
      <div class="auth-footer">

        Remember your password?

        <%= link_to "Login",
            new_user_session_path %>

      </div>

    </div>

  </div>

</div>