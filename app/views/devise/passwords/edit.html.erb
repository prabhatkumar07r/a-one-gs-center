<script nonce="<%= content_security_policy_nonce %>">

document.addEventListener("DOMContentLoaded", function () {

  /* =======================================================
     PASSWORD SHOW / HIDE
  ======================================================== */

  document
    .querySelectorAll("[data-password-toggle]")
    .forEach(function (button) {

      button.addEventListener("click", function () {

        const wrapper = button.closest(".password-input-wrapper");
        const input = wrapper?.querySelector("input");

        if (!input) return;

        const icon = button.querySelector("i");

        const showing = input.type === "text";

        input.type = showing ? "password" : "text";

        button.setAttribute(
          "aria-label",
          showing ? "Show password" : "Hide password"
        );

        button.setAttribute(
          "aria-pressed",
          String(!showing)
        );

        if (icon) {

          icon.classList.toggle(
            "bi-eye",
            showing
          );

          icon.classList.toggle(
            "bi-eye-slash",
            !showing
          );

        }

      });

    });


  /* =======================================================
     PASSWORD STRENGTH
  ======================================================== */

  const password =
    document.querySelector("#user_password");

  const strength =
    document.querySelector("[data-password-strength]");

  if (password && strength) {

    const bars =
      strength.querySelectorAll(".strength-bar");

    const text =
      strength.querySelector(".strength-text");


    password.addEventListener("input", function () {

      const value = password.value;

      let score = 0;

      if (value.length >= 8) score++;

      if (/[a-z]/.test(value)) score++;

      if (/[A-Z]/.test(value)) score++;

      if (/[0-9!@#$%^&*]/.test(value)) score++;


      bars.forEach(function (bar, index) {

        bar.style.background =
          index < score
            ? "#8b5cf6"
            : "#e5e7eb";

      });


      const labels = [
        "Enter a password",
        "Weak password",
        "Fair password",
        "Good password",
        "Strong password"
      ];

      text.textContent =
        labels[score];

    });

  }


  /* =======================================================
     PASSWORD MATCH
  ======================================================== */

  const confirmation =
    document.querySelector("#user_password_confirmation");

  const match =
    document.querySelector("[data-password-match]");


  if (password && confirmation && match) {

    function checkPasswordMatch() {

      if (!confirmation.value) {

        match.textContent = "";

        match.className =
          "password-match";

        return;

      }


      if (password.value === confirmation.value) {

        match.innerHTML =
          '<i class="bi bi-check-circle-fill"></i> Passwords match';

        match.className =
          "password-match match";

      } else {

        match.innerHTML =
          '<i class="bi bi-x-circle-fill"></i> Passwords do not match';

        match.className =
          "password-match no-match";

      }

    }


    password.addEventListener(
      "input",
      checkPasswordMatch
    );

    confirmation.addEventListener(
      "input",
      checkPasswordMatch
    );

  }

});

</script>