<% content_for :hide_header, true %>
<% content_for :hide_footer, true %>

<style>
/* =========================================================
   TEST SERIES DETAIL PAGE
========================================================= */

.test-series-detail-page {
  min-height: 100vh;

  background:
    radial-gradient(
      circle at top right,
      rgba(124, 58, 237, .12),
      transparent 35%
    ),
    radial-gradient(
      circle at bottom left,
      rgba(37, 99, 235, .10),
      transparent 35%
    ),
    #f8f9ff;

  color: #1f2937;
}


/* =========================================================
   TOP BAR
========================================================= */

.ts-detail-topbar {
  background: #ffffff;

  border-bottom: 1px solid #e5e7eb;

  padding: 18px 35px;

  position: sticky;

  top: 0;

  z-index: 100;
}

.ts-detail-topbar-inner {
  max-width: 1250px;

  margin: auto;

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 20px;
}

.ts-detail-brand {
  display: flex;

  align-items: center;

  gap: 12px;

  color: #4f46e5;

  font-size: 21px;

  font-weight: 800;
}

.ts-detail-brand-icon {
  width: 42px;

  height: 42px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      #4f46e5,
      #7c3aed
    );

  color: #ffffff;

  box-shadow:
    0 6px 16px rgba(79, 70, 229, .25);
}


/* =========================================================
   BACK BUTTON
========================================================= */

.ts-back-btn {
  border: none;

  background: #f3f4f6;

  color: #374151;

  padding: 10px 18px;

  border-radius: 10px;

  font-weight: 700;

  transition: .2s ease;

  cursor: pointer;
}

.ts-back-btn:hover {
  background: #ede9fe;

  color: #6d28d9;

  transform: translateX(-2px);
}


/* =========================================================
   MAIN CONTAINER
========================================================= */

.ts-detail-container {
  max-width: 1250px;

  margin: auto;

  padding: 45px 25px 70px;
}


/* =========================================================
   MAIN GRID
========================================================= */

.ts-detail-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.7fr)
    minmax(320px, .8fr);

  gap: 30px;

  align-items: start;
}


/* =========================================================
   INFORMATION CARD
========================================================= */

.ts-info-card {
  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 22px;

  overflow: hidden;

  box-shadow:
    0 10px 35px rgba(79, 70, 229, .08);
}


/* =========================================================
   IMAGE
========================================================= */

.ts-detail-image {
  height: 280px;

  background:
    linear-gradient(
      135deg,
      #ede9fe,
      #dbeafe,
      #fce7f3
    );

  overflow: hidden;

  position: relative;
}

.ts-detail-image img {
  width: 100%;

  height: 100%;

  object-fit: cover;
}

.ts-detail-placeholder {
  height: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 75px;

  color: #7c3aed;
}


/* =========================================================
   BADGE
========================================================= */

.ts-detail-badge {
  position: absolute;

  top: 20px;

  left: 20px;

  padding: 9px 15px;

  border-radius: 9px;

  font-size: 13px;

  font-weight: 800;

  text-transform: uppercase;

  backdrop-filter: blur(8px);
}

.ts-detail-badge.free {
  background: #dcfce7;

  color: #166534;
}

.ts-detail-badge.premium {
  background: #fee2e2;

  color: #991b1b;
}


/* =========================================================
   INFORMATION BODY
========================================================= */

.ts-info-body {
  padding: 32px;
}

.ts-info-body h1 {
  color: #1e1b4b;

  font-size: 36px;

  font-weight: 850;

  margin-bottom: 15px;

  line-height: 1.2;
}

.ts-description {
  color: #64748b;

  line-height: 1.8;

  font-size: 16px;

  margin-bottom: 25px;
}


/* =========================================================
   META
========================================================= */

.ts-series-meta {
  display: flex;

  flex-wrap: wrap;

  gap: 10px;

  margin-bottom: 25px;
}

.ts-meta-item {
  display: inline-flex;

  align-items: center;

  gap: 7px;

  padding: 8px 12px;

  border-radius: 9px;

  background: #f8fafc;

  border: 1px solid #e2e8f0;

  color: #475569;

  font-size: 13px;

  font-weight: 700;
}

.ts-meta-item i {
  color: #6d28d9;
}


/* =========================================================
   STATISTICS
========================================================= */

.ts-stats {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 14px;

  margin-bottom: 5px;
}

.ts-stat {
  padding: 18px;

  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      #f5f3ff,
      #eff6ff
    );

  border: 1px solid #ddd6fe;

  text-align: center;
}

.ts-stat i {
  color: #6d28d9;

  font-size: 20px;

  margin-bottom: 8px;
}

.ts-stat strong {
  display: block;

  color: #312e81;

  font-size: 22px;
}

.ts-stat span {
  color: #64748b;

  font-size: 12px;

  font-weight: 600;
}


/* =========================================================
   TEST LIST
========================================================= */

.ts-test-list {
  margin-top: 30px;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 22px;

  padding: 28px;

  box-shadow:
    0 8px 25px rgba(79, 70, 229, .06);
}

.ts-test-list h2 {
  color: #312e81;

  font-size: 24px;

  font-weight: 850;

  margin-bottom: 20px;
}


/* =========================================================
   TEST ROW
========================================================= */

.ts-test-row {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

  padding: 20px 0;

  border-bottom: 1px solid #f1f5f9;
}

.ts-test-row:last-child {
  border-bottom: none;

  padding-bottom: 5px;
}

.ts-test-number {
  width: 44px;

  height: 44px;

  display: flex;

  align-items: center;

  justify-content: center;

  flex-shrink: 0;

  border-radius: 12px;

  background: #ede9fe;

  color: #6d28d9;

  font-weight: 800;

  font-size: 16px;
}

.ts-test-info {
  flex: 1;

  min-width: 0;
}

.ts-test-info h5 {
  margin: 0;

  color: #1e293b;

  font-weight: 750;

  font-size: 16px;
}

.ts-test-info small {
  display: block;

  color: #64748b;

  margin-top: 7px;

  line-height: 1.7;
}


/* =========================================================
   TEST DESCRIPTION
========================================================= */

.ts-test-description {
  color: #94a3b8;

  font-size: 12px;

  margin-top: 4px;
}


/* =========================================================
   TEST STATUS
========================================================= */

.ts-test-status {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  margin-top: 8px;

  font-size: 12px;

  font-weight: 700;
}

.ts-test-status.completed {
  color: #15803d;
}

.ts-test-status.progress {
  color: #d97706;
}


/* =========================================================
   START TEST BUTTON
========================================================= */

.ts-test-start {
  white-space: nowrap;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  padding: 10px 16px;

  border-radius: 9px;

  background: #ede9fe;

  color: #6d28d9 !important;

  text-decoration: none;

  font-size: 13px;

  font-weight: 800;

  transition: .2s ease;
}

.ts-test-start:hover {
  background: #6d28d9;

  color: #ffffff !important;

  transform: translateY(-1px);
}


/* =========================================================
   RIGHT ACTION CARD
========================================================= */

.ts-action-card {
  background: #ffffff;

  border: 1px solid #ddd6fe;

  border-radius: 22px;

  padding: 28px;

  box-shadow:
    0 12px 35px rgba(79, 70, 229, .10);

  position: sticky;

  top: 90px;
}


/* =========================================================
   ACTION LABEL
========================================================= */

.ts-action-label {
  color: #64748b;

  font-size: 13px;

  font-weight: 700;

  text-transform: uppercase;

  margin-bottom: 8px;
}


/* =========================================================
   PRICE
========================================================= */

.ts-action-price {
  color: #312e81;

  font-size: 38px;

  font-weight: 900;

  margin-bottom: 5px;
}

.ts-free-price {
  color: #15803d;
}

.ts-action-note {
  color: #64748b;

  font-size: 13px;

  line-height: 1.6;

  margin-bottom: 25px;
}


/* =========================================================
   FEATURES
========================================================= */

.ts-action-features {
  border-top: 1px solid #e5e7eb;

  border-bottom: 1px solid #e5e7eb;

  padding: 20px 0;

  margin-bottom: 22px;
}

.ts-action-feature {
  display: flex;

  align-items: center;

  gap: 10px;

  margin-bottom: 13px;

  color: #475569;

  font-size: 14px;
}

.ts-action-feature:last-child {
  margin-bottom: 0;
}

.ts-action-feature i {
  color: #16a34a;
}


/* =========================================================
   MAIN ACTION BUTTON
========================================================= */

.ts-start-btn {
  width: 100%;

  min-height: 50px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 9px;

  padding: 14px 20px;

  border: none;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #6d28d9,
      #ec4899
    );

  color: #ffffff !important;

  text-decoration: none;

  font-weight: 800;

  font-size: 16px;

  box-shadow:
    0 8px 20px rgba(109, 40, 217, .25);

  transition: .2s ease;

  cursor: pointer;
}

.ts-start-btn:hover {
  color: #ffffff !important;

  transform: translateY(-2px);

  box-shadow:
    0 12px 25px rgba(109, 40, 217, .35);
}

.ts-start-btn.disabled {
  opacity: .55;

  cursor: not-allowed;

  pointer-events: none;
}


/* =========================================================
   PURCHASED
========================================================= */

.ts-purchased-box {
  padding: 13px 15px;

  margin-bottom: 15px;

  border-radius: 11px;

  background: #ecfdf5;

  border: 1px solid #bbf7d0;

  color: #166534;

  font-size: 13px;

  font-weight: 700;

  text-align: center;
}


/* =========================================================
   EMPTY
========================================================= */

.ts-empty {
  text-align: center;

  padding: 45px 20px;

  color: #64748b;
}

.ts-empty i {
  color: #c4b5fd;

  margin-bottom: 15px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {

  .ts-detail-grid {
    grid-template-columns: 1fr;
  }

  .ts-action-card {
    position: static;
  }

}


@media (max-width: 600px) {

  .ts-detail-topbar {
    padding: 15px 18px;
  }

  .ts-detail-topbar-inner {
    align-items: flex-start;

    flex-direction: column;
  }

  .ts-detail-container {
    padding: 25px 15px 50px;
  }

  .ts-info-body {
    padding: 22px;
  }

  .ts-info-body h1 {
    font-size: 28px;
  }

  .ts-detail-image {
    height: 220px;
  }

  .ts-stats {
    grid-template-columns: 1fr;
  }

  .ts-action-card {
    padding: 22px;
  }

  .ts-test-row {
    align-items: flex-start;

    flex-wrap: wrap;
  }

  .ts-test-number {
    width: 40px;

    height: 40px;
  }

  .ts-test-info {
    width: calc(100% - 60px);
  }

  .ts-test-start {
    width: 100%;
  }

  .ts-series-meta {
    flex-direction: column;
  }

}
</style>


<div class="test-series-detail-page">

  <!-- =====================================================
       TOP BAR
  ====================================================== -->

  <div class="ts-detail-topbar">

    <div class="ts-detail-topbar-inner">

      <div class="ts-detail-brand">

        <div class="ts-detail-brand-icon">
          <i class="fas fa-file-alt"></i>
        </div>

        <span>
          Test Series
        </span>

      </div>


      <button
        type="button"
        class="ts-back-btn"
        id="tsBackBtn">

        ← Back

      </button>

    </div>

  </div>


  <!-- =====================================================
       CONTENT
  ====================================================== -->

  <div class="ts-detail-container">

    <div class="ts-detail-grid">


      <!-- =================================================
           LEFT SIDE
      ================================================== -->

      <div>


        <!-- =================================================
             SERIES INFORMATION
        ================================================== -->

        <div class="ts-info-card">


          <!-- IMAGE -->

          <div class="ts-detail-image">

            <% if @test_series.image.attached? %>

              <%= image_tag @test_series.image %>

            <% else %>

              <div class="ts-detail-placeholder">

                <i class="fas fa-graduation-cap"></i>

              </div>

            <% end %>


            <!-- BADGE -->

            <% if @test_series.respond_to?(:free?) &&
                  @test_series.free? %>

              <span class="ts-detail-badge free">

                Free

              </span>

            <% else %>

              <span class="ts-detail-badge premium">

                Premium

              </span>

            <% end %>

          </div>


          <!-- BODY -->

          <div class="ts-info-body">

            <h1>
              <%= @test_series.title %>
            </h1>


            <% if @test_series.description.present? %>

              <p class="ts-description">

                <%= @test_series.description %>

              </p>

            <% end %>


            <!-- SERIES META -->

            <div class="ts-series-meta">


              <% if @test_series.exam_name.present? %>

                <div class="ts-meta-item">

                  <i class="fas fa-graduation-cap"></i>

                  <span>
                    <%= @test_series.exam_name %>
                  </span>

                </div>

              <% end %>


              <% if @test_series.mode.present? %>

                <div class="ts-meta-item">

                  <i class="fas fa-desktop"></i>

                  <span>
                    <%= @test_series.mode %>
                  </span>

                </div>

              <% end %>


              <% if @test_series.language.present? %>

                <div class="ts-meta-item">

                  <i class="fas fa-language"></i>

                  <span>
                    <%= @test_series.language %>
                  </span>

                </div>

              <% end %>


            </div>


            <!-- =================================================
                 STATISTICS
            ================================================== -->

            <div class="ts-stats">


              <!-- TOTAL TESTS -->

              <div class="ts-stat">

                <i class="fas fa-layer-group"></i>

                <strong>
                  <%= @quizzes.count %>
                </strong>

                <span>
                  Total Tests
                </span>

              </div>


              <!-- TOTAL QUESTIONS -->

              <div class="ts-stat">

                <i class="fas fa-question-circle"></i>

                <strong>
                  <%= @quizzes.sum {
                    |test|
                    test.test_series_questions.size
                  } %>
                </strong>

                <span>
                  Total Questions
                </span>

              </div>


              <!-- TOTAL MINUTES -->

              <div class="ts-stat">

                <i class="fas fa-clock"></i>

                <strong>
                  <%= @quizzes.sum {
                    |test|
                    test.duration.to_i
                  } %>
                </strong>

                <span>
                  Minutes
                </span>

              </div>


            </div>

          </div>

        </div>


        <!-- =================================================
             TESTS INCLUDED
        ================================================== -->

        <div class="ts-test-list">

          <h2>
            Tests Included
          </h2>


          <% if @quizzes.any? %>


            <% @quizzes.each_with_index do |test, index| %>

              <div class="ts-test-row">


                <!-- NUMBER -->

                <div class="ts-test-number">

                  <%= index + 1 %>

                </div>


                <!-- INFORMATION -->

                <div class="ts-test-info">

                  <h5>

                    <%= test.title %>

                  </h5>


                  <small>

                    <i class="fas fa-question-circle"></i>

                    <%= test.test_series_questions.size %>

                    Questions


                    <% if test.duration.present? %>

                      &nbsp; • &nbsp;

                      <i class="fas fa-clock"></i>

                      <%= test.duration %>

                      Minutes

                    <% end %>


                    <% if test.total_marks.present? &&
                          test.total_marks.to_f > 0 %>

                      &nbsp; • &nbsp;

                      <i class="fas fa-star"></i>

                      <%= test.total_marks %>

                      Marks

                    <% end %>

                  </small>


                  <% if test.description.present? %>

                    <small class="ts-test-description">

                      <%= truncate(
                        test.description,
                        length: 100
                      ) %>

                    </small>

                  <% end %>


                  <!-- ATTEMPT STATUS -->

                  <% if current_user.respond_to?(:test_series_attempts) %>

                    <% attempt =
                      current_user
                        .test_series_attempts
                        .where(
                          test_series_test: test
                        )
                        .order(
                          created_at: :desc
                        )
                        .first %>


                    <% if attempt.present? %>


                      <% if attempt.respond_to?(:completed?) &&
                            attempt.completed? %>

                        <div class="ts-test-status completed">

                          <i class="fas fa-check-circle"></i>

                          Test Completed

                        </div>


                      <% elsif attempt.status.to_s.downcase == "in progress" %>

                        <div class="ts-test-status progress">

                          <i class="fas fa-clock"></i>

                          Test In Progress

                        </div>

                      <% end %>

                    <% end %>

                  <% end %>

                </div>


                <!-- =================================================
                     START / CONTINUE
                ================================================== -->

                <%= link_to(
                  test_series_test_series_test_path(
                    @test_series,
                    test
                  ),
                  class: "ts-test-start"
                ) do %>


                  <% existing_attempt = nil %>


                  <% if current_user.respond_to?(:test_series_attempts) %>

                    <% existing_attempt =
                      current_user
                        .test_series_attempts
                        .where(
                          test_series_test: test,
                          status: "In Progress"
                        )
                        .order(
                          created_at: :desc
                        )
                        .first %>

                  <% end %>


                  <% if existing_attempt.present? %>

                    <i class="fas fa-play-circle"></i>

                    Continue

                  <% else %>

                    <i class="fas fa-play"></i>

                    Start Test

                  <% end %>


                <% end %>

              </div>

            <% end %>


          <% else %>

            <div class="ts-empty">

              <i class="fas fa-clipboard-list fa-2x"></i>

              <p class="mb-0">

                No tests have been added
                to this series yet.

              </p>

            </div>

          <% end %>

        </div>

      </div>


      <!-- =================================================
           RIGHT ACTION CARD
      ================================================== -->

      <aside class="ts-action-card">


        <div class="ts-action-label">

          Test Series Access

        </div>


        <!-- =================================================
             PRICE
        ================================================== -->

        <% if @test_series.respond_to?(:free?) &&
              @test_series.free? %>


          <div class="ts-action-price ts-free-price">

            FREE

          </div>


          <div class="ts-action-note">

            Start practicing without
            any payment.

          </div>


        <% else %>


          <div class="ts-action-price">

            ₹<%= number_with_delimiter(
              @test_series.price.to_i
            ) %>

          </div>


          <div class="ts-action-note">

            One-time access to this
            test series.

          </div>


        <% end %>


        <!-- =================================================
             FEATURES
        ================================================== -->

        <div class="ts-action-features">


          <div class="ts-action-feature">

            <i class="fas fa-check-circle"></i>

            <span>

              <%= @quizzes.count %>

              Tests

            </span>

          </div>


          <div class="ts-action-feature">

            <i class="fas fa-check-circle"></i>

            <span>

              <%= @quizzes.sum {
                |test|
                test.test_series_questions.size
              } %>

              Questions

            </span>

          </div>


          <div class="ts-action-feature">

            <i class="fas fa-check-circle"></i>

            <span>

              Instant access

            </span>

          </div>


          <div class="ts-action-feature">

            <i class="fas fa-check-circle"></i>

            <span>

              Track your performance

            </span>

          </div>


        </div>


        <!-- =================================================
             FREE TEST SERIES
        ================================================== -->

        <% if @test_series.respond_to?(:free?) &&
              @test_series.free? %>


          <% first_test = @quizzes.first %>


          <% if first_test.present? %>


            <%= link_to(
              test_series_test_series_test_path(
                @test_series,
                first_test
              ),
              class: "ts-start-btn"
            ) do %>

              <i class="fas fa-play"></i>

              Start Test Series

            <% end %>


          <% else %>


            <div class="ts-start-btn disabled">

              <i class="fas fa-lock"></i>

              No Test Available

            </div>


          <% end %>


        <!-- =================================================
             PAID TEST SERIES
        ================================================== -->

        <% else %>


          <% if @purchase.present? %>


            <div class="ts-purchased-box">

              <i class="fas fa-check-circle"></i>

              You have access to this
              test series.

            </div>


            <% first_test = @quizzes.first %>


            <% if first_test.present? %>


              <%= link_to(
                test_series_test_series_test_path(
                  @test_series,
                  first_test
                ),
                class: "ts-start-btn"
              ) do %>

                <i class="fas fa-play"></i>

                Start Test Series

              <% end %>


            <% else %>


              <div class="ts-start-btn disabled">

                <i class="fas fa-lock"></i>

                No Test Available

              </div>


            <% end %>


          <% else %>


            <%= button_to(
              purchase_test_series_path(
                @test_series
              ),
              method: :post,
              class: "ts-start-btn"
            ) do %>

              <i class="fas fa-lock"></i>

              Buy Test Series

            <% end %>


          <% end %>


        <% end %>


      </aside>

    </div>

  </div>

</div>


<script>
document.addEventListener("DOMContentLoaded", function () {

  const backBtn =
    document.getElementById("tsBackBtn");

  if (!backBtn) return;


  backBtn.addEventListener("click", function () {

    window.location.href = "/test_series";

  });

});
</script>