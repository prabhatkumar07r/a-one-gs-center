<style>
  .current-course{
    margin:15px;
    padding:30px 20px;
    background:rgba(255,255,255,.12);
    border-left:4px solid #ffc107;
    border-radius:10px;
}

.current-course small{
    display:block;
    color:#d1d5db;
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:.5px;
    margin-bottom:4px;
}

.current-course h6{
    color:#fff;
    font-size:15px;
    font-weight:600;
    display:flex;
    align-items:center;
    gap:8px;
}

.current-course i{
    color:#ffc107;
}
</style>

<div class="admin-sidebar">

  <div class="sidebar-logo text-center py-4">
    <%= image_tag "logo.jpeg", width: 70, class: "rounded-circle mb-2" %>

    <h4>A ONE GS CENTER</h4>
    <small>Teacher Panel</small>
  </div>

  <hr>

 <ul class="nav flex-column">

  <!-- Dashboard -->
  <li class="nav-item">
    <%= link_to teacher_dashboard_path, class: "nav-link" do %>
      <i class="bi bi-speedometer2"></i>
      Dashboard
    <% end %>
  </li>

  <!-- My Courses -->
  <li class="nav-item">
    <%= link_to teacher_panel_courses_path, class: "nav-link" do %>
      <i class="bi bi-book-fill"></i>
      My Courses
    <% end %>
  </li>

  <% if @course.present? %>

    <div class="current-course">
  <small>Current Course</small>
  <h6 class="mb-0">
    <i class="bi bi-book-fill"></i>
    <%= @course.Course_name %>
  </h6>
</div>

    <!-- Students -->
    <li class="nav-item">
      <%= link_to teacher_panel_course_students_path(@course), class: "nav-link" do %>
        <i class="bi bi-people-fill"></i>
        Students
      <% end %>
    </li>

    <!-- Playlists -->
    <li class="nav-item">
      <%= link_to teacher_panel_course_playlists_path(@course), class: "nav-link" do %>
        <i class="bi bi-collection-play-fill"></i>
        Playlists
      <% end %>
    </li>

    <!-- Videos -->
    <li class="nav-item">
      <%= link_to teacher_panel_course_videos_path(@course), class: "nav-link" do %>
        <i class="bi bi-camera-video-fill"></i>
        Videos
      <% end %>
    </li>

    <!-- Resources -->
    <li class="nav-item">
      <%= link_to teacher_panel_course_resources_path(@course), class: "nav-link" do %>
        <i class="bi bi-file-earmark-text-fill"></i>
        Resources
      <% end %>
    </li>

  <% end %>

  <!-- Profile -->
  <li class="nav-item">
    <%= link_to teacher_profile_path ,class: "nav-link" do %>
      <i class="bi bi-person-circle"></i>
      My Profile
    <% end %>
  </li>

  <!-- Logout -->
  <li class="nav-item mt-4">
    <%= button_to destroy_user_session_path,
          method: :delete,
          class: "nav-link text-danger logout-form" do %>

      <i class="bi bi-box-arrow-right"></i>
      Logout

    <% end %>
  </li>

</ul>

</div>