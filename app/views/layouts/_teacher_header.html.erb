<style>
  /* =========================================================
     TEACHER NAVBAR
  ========================================================== */

  .teacher-navbar {
    position: fixed;
    top: 0;
    left: 260px;
    right: 0;

    width: auto;
    height: 75px;

    background: #245187;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 30px;

    box-shadow: 0 3px 15px rgba(0, 0, 0, .08);

    /* IMPORTANT:
       Navbar must be above mobile sidebar */
    z-index: 3000;

    box-sizing: border-box;
  }


  /* =========================================================
     LEFT SIDE
  ========================================================== */

  .teacher-navbar-left {
    display: flex;
    align-items: center;

    gap: 18px;

    min-width: 0;
  }


  /* =========================================================
     PAGE TITLE
  ========================================================== */

  .page-title {
    font-size: 24px;
    font-weight: 700;

    color: #fff;

    margin: 0;

    white-space: nowrap;
  }


  /* =========================================================
     WELCOME TEXT
  ========================================================== */

  .welcome-text {
    color: #eef7ee;

    font-size: 14px;
  }


  /* =========================================================
     RIGHT SIDE
  ========================================================== */

  .teacher-navbar-right {
    display: flex;
    align-items: center;

    gap: 18px;
  }


  /* =========================================================
     DATE ITEM
  ========================================================== */

  .header-item {
    display: flex;
    align-items: center;

    gap: 8px;

    background: rgba(255, 255, 255, .15);

    color: #fff;

    padding: 10px 18px;

    border-radius: 50px;
  }


  /* =========================================================
     HEADER ICON
  ========================================================== */

  .header-icon {
    width: 45px;
    height: 45px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: rgba(255, 255, 255, .15);

    color: #fff;

    transition: .3s;
  }


  .header-icon:hover {
    background: #fff;

    color: #45BA38;
  }


  /* =========================================================
     HAMBURGER BUTTON
  ========================================================== */

  .menu-btn {
    display: none;

    width: 44px;
    height: 44px;

    padding: 0;

    border: 0;
    outline: none;

    background: transparent;

    color: #fff;

    font-size: 30px;
    line-height: 1;

    cursor: pointer;

    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    position: relative;

    z-index: 3100;
  }


  .menu-btn:hover {
    color: #fff;

    background: rgba(255, 255, 255, .10);

    border-radius: 8px;
  }


  /* =========================================================
     MOBILE
  ========================================================== */

  @media (max-width: 768px) {

    .teacher-navbar {
      position: fixed;

      top: 0;
      left: 0;
      right: 0;

      width: 100%;

      height: 65px;

      padding: 0 12px;

      /*
       * IMPORTANT:
       * Navbar must be above sidebar.
       */
      z-index: 3000;
    }


    /* =======================================================
       HAMBURGER
    ======================================================== */

    .menu-btn {
      display: flex !important;

      visibility: visible !important;

      opacity: 1 !important;

      width: 44px;
      height: 44px;

      color: #fff !important;

      background: transparent !important;

      cursor: pointer !important;

      flex-shrink: 0;

      position: relative;

      /*
       * Higher than navbar contents.
       */
      z-index: 3100;
    }


    /* =======================================================
       LEFT SECTION
    ======================================================== */

    .teacher-navbar-left {
      display: flex;

      align-items: center;

      gap: 8px;

      min-width: 0;
    }


    /* =======================================================
       PAGE TITLE
    ======================================================== */

    .page-title {
      font-size: 18px;

      white-space: nowrap;

      overflow: hidden;

      text-overflow: ellipsis;
    }


    /* =======================================================
       WELCOME
    ======================================================== */

    .welcome-text {
      display: block;

      font-size: 11px;

      max-width: 160px;

      overflow: hidden;

      text-overflow: ellipsis;

      white-space: nowrap;
    }


    /* =======================================================
       RIGHT SIDE
    ======================================================== */

    .teacher-navbar-right {
      gap: 5px;
    }


    /* Hide date on mobile */

    .header-item {
      display: none;
    }


    /* Notification */

    .header-icon {
      width: 38px;
      height: 38px;
    }

  }


  /* =========================================================
   DAY / NIGHT TOGGLE
========================================================= */

.header-icon {
  width: 46px;
  height: 46px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #315f91;
  color: #ffffff;

  cursor: pointer;

  transition:
    background .25s ease,
    color .25s ease,
    transform .2s ease;
}

.header-icon:hover {
  transform: scale(1.05);
}

.header-icon i {
  font-size: 20px;
  line-height: 1;
}


/* =========================================================
   LIGHT MODE
========================================================= */

html.teacher-day-mode body {
  background: #f5f7fb !important;
  color: #1f2937 !important;
}

html.teacher-day-mode .teacher-body,
html.teacher-day-mode .teacher-main,
html.teacher-day-mode .teacher-content {
  background: #f5f7fb !important;
  color: #1f2937 !important;
}


/* Sidebar */

html.teacher-day-mode .teacher-sidebar {
  background: #ffffff !important;
  color: #1f2937 !important;

  border-right: 1px solid #e5e7eb !important;
}


/* Navbar */

html.teacher-day-mode .teacher-navbar,
html.teacher-day-mode .teacher-header,
html.teacher-day-mode .teacher-topbar {
  background: #ffffff !important;
  color: #1f2937 !important;

  border-bottom: 1px solid #e5e7eb !important;
}


/* Cards */

html.teacher-day-mode .card,
html.teacher-day-mode .teacher-card,
html.teacher-day-mode .videos-card {
  background: #ffffff !important;
  color: #1f2937 !important;

  border-color: #e5e7eb !important;

  box-shadow:
    0 8px 25px rgba(15, 23, 42, .08) !important;
}


/* Table */

html.teacher-day-mode .videos-table tbody td {
  background: #ffffff !important;
  color: #374151 !important;
  border-color: #e5e7eb !important;
}


/* Titles */

html.teacher-day-mode .video-title,
html.teacher-day-mode h1,
html.teacher-day-mode h2,
html.teacher-day-mode h3,
html.teacher-day-mode h4,
html.teacher-day-mode h5 {
  color: #111827 !important;
}


/* Paragraph */

html.teacher-day-mode p {
  color: #6b7280 !important;
}


/* =========================================================
   TOGGLE IN DAY MODE
========================================================= */

html.teacher-day-mode .header-icon {
  background: #e5e7eb;
  color: #374151;
}


/* =========================================================
   SMOOTH TRANSITION
========================================================= */

body,
.teacher-body,
.teacher-main,
.teacher-content,
.teacher-sidebar,
.teacher-navbar,
.teacher-header,
.teacher-topbar,
.card,
.teacher-card,
.videos-card,
.videos-table tbody td {
  transition:
    background-color .25s ease,
    color .25s ease,
    border-color .25s ease;
}

</style>


<!-- =========================================================
     TEACHER NAVBAR
========================================================== -->

<nav class="teacher-navbar">

  <!-- =======================================================
       LEFT SIDE
  ======================================================== -->

  <div class="teacher-navbar-left">

    <!-- MOBILE MENU -->

    <button
      type="button"
      class="menu-btn"
      id="teacherMenuBtn"
      aria-label="Open teacher menu"
      aria-expanded="false"
    >
      ☰
    </button>


    <!-- TITLE -->

    <div>

      <h4 class="page-title">

        <%= content_for?(:page_title) ?
              yield(:page_title) :
              "Teacher Dashboard" %>

      </h4>

      <small class="welcome-text">

        Welcome,

        <strong>
          <%= current_user.name.presence || current_user.email %>
        </strong>

      </small>

    </div>

  </div>


  <!-- =======================================================
       RIGHT SIDE
  ======================================================== -->

  <div class="teacher-navbar-right">

    <!-- DATE -->

    <div class="header-item">

      <i class="bi bi-calendar-event"></i>

      <span>
        <%= Date.today.strftime("%d %b %Y") %>
      </span>

    </div>


    <!-- =====================================================
         DAY / NIGHT TOGGLE
         ONLY SHOW ON SELECTED PAGES
    ====================================================== -->

    <% if content_for?(:enable_theme_toggle) %>

      <button
        type="button"
        class="header-icon theme-toggle"
        id="themeToggle"
        title="Switch to Day Mode"
        aria-label="Toggle Day/Night Mode"
      >

        <i
          class="bi bi-sun-fill"
          id="themeIcon"
        ></i>

      </button>

    <% end %>

  </div>

</nav>


<!-- =========================================================
     TEACHER MENU JAVASCRIPT
========================================================== -->

<script nonce="<%= content_security_policy_nonce %>">

(function () {

  /* =====================================================
     PREVENT DUPLICATE INITIALIZATION
  ===================================================== */

  if (window.teacherHeaderInitialized) {
    return;
  }

  window.teacherHeaderInitialized = true;


  /* =====================================================
     CLOSE SIDEBAR
  ===================================================== */

  function closeSidebar() {

    const sidebar =
      document.querySelector(
        ".teacher-sidebar"
      );

    const button =
      document.getElementById(
        "teacherMenuBtn"
      );


    if (sidebar) {

      sidebar.classList.remove(
        "open"
      );

    }


    if (button) {

      button.classList.remove(
        "active"
      );


      button.setAttribute(
        "aria-expanded",
        "false"
      );


      button.setAttribute(
        "aria-label",
        "Open teacher menu"
      );


      button.textContent = "☰";

    }

  }


  /* =====================================================
     MENU BUTTON
  ===================================================== */

  document.addEventListener(
    "click",
    function (event) {

      const button =
        event.target.closest(
          "#teacherMenuBtn"
        );


      if (!button) {
        return;
      }


      event.preventDefault();

      event.stopPropagation();


      const sidebar =
        document.querySelector(
          ".teacher-sidebar"
        );


      if (!sidebar) {

        console.error(
          "Teacher sidebar not found."
        );

        return;

      }


      const isOpen =
        sidebar.classList.contains(
          "open"
        );


      if (isOpen) {

        closeSidebar();

      } else {

        sidebar.classList.add(
          "open"
        );


        button.classList.add(
          "active"
        );


        button.setAttribute(
          "aria-expanded",
          "true"
        );


        button.setAttribute(
          "aria-label",
          "Close teacher menu"
        );


        button.textContent = "×";


        console.log(
          "Teacher sidebar: OPEN"
        );

      }

    },
    true
  );


  /* =====================================================
     CLICK OUTSIDE SIDEBAR
  ===================================================== */

  document.addEventListener(
    "click",
    function (event) {

      const sidebar =
        event.target.closest(
          ".teacher-sidebar"
        );


      const button =
        event.target.closest(
          "#teacherMenuBtn"
        );


      /*
       * Do not close when clicking
       * inside sidebar or menu button.
       */

      if (sidebar || button) {
        return;
      }


      closeSidebar();

    }
  );


  /* =====================================================
     SIDEBAR LINKS
  ===================================================== */

  document.addEventListener(
    "click",
    function (event) {

      const link =
        event.target.closest(
          ".teacher-sidebar a"
        );


      if (!link) {
        return;
      }


      if (window.innerWidth <= 768) {

        closeSidebar();

      }

    }
  );


  /* =====================================================
     ESCAPE KEY
  ===================================================== */

  document.addEventListener(
    "keydown",
    function (event) {

      if (event.key !== "Escape") {
        return;
      }


      closeSidebar();

    }
  );


  /* =====================================================
     RESIZE
  ===================================================== */

  window.addEventListener(
    "resize",
    function () {

      if (window.innerWidth > 768) {

        closeSidebar();

      }

    }
  );

})();

document.addEventListener("DOMContentLoaded", function () {

  const themeToggle =
    document.getElementById("themeToggle");

  const themeIcon =
    document.getElementById("themeIcon");


  /* =====================================================
     LOAD SAVED THEME
  ===================================================== */

  const savedTheme =
    localStorage.getItem("teacherTheme");


  if (savedTheme === "day") {

    document.documentElement.classList.add(
      "teacher-day-mode"
    );

    themeIcon.className =
      "bi bi-moon-stars-fill";

  } else {

    document.documentElement.classList.remove(
      "teacher-day-mode"
    );

    themeIcon.className =
      "bi bi-sun-fill";

  }


  /* =====================================================
     TOGGLE
  ===================================================== */

  themeToggle.addEventListener("click", function () {

    const isDay =
      document.documentElement.classList.toggle(
        "teacher-day-mode"
      );


    if (isDay) {

      /* WHITE / DAY MODE */

      localStorage.setItem(
        "teacherTheme",
        "day"
      );

      themeIcon.className =
        "bi bi-moon-stars-fill";

      themeToggle.title =
        "Switch to Night Mode";

    } else {

      /* DARK / NIGHT MODE */

      localStorage.setItem(
        "teacherTheme",
        "night"
      );

      themeIcon.className =
        "bi bi-sun-fill";

      themeToggle.title =
        "Switch to Day Mode";

    }

  });

});
</script>