

<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   A ONE GS CENTER
   PREMIUM 3D WHITE / PURPLE GLASS HEADER
========================================================= */

:root {
    --aone-purple: #6d28d9;
    --aone-purple-2: #8b5cf6;
    --aone-purple-3: #a855f7;

    --aone-text: #21145f;
    --aone-muted: #687099;

    --aone-white: rgba(255, 255, 255, 0.86);

    --aone-shadow:
        0 18px 45px rgba(72, 54, 150, 0.15),
        0 5px 15px rgba(72, 54, 150, 0.08);

    --aone-inner:
        inset 0 1px 0 rgba(255, 255, 255, 0.95),
        inset 0 -1px 0 rgba(120, 90, 200, 0.05);
}


/* =========================================================
   PAGE BACKGROUND
========================================================= */

html,
body {
    transition:
        background-color .35s ease,
        color .35s ease;
}


/* =========================================================
   HEADER OUTER
========================================================= */

.header {
    position: fixed;

    top: 0;
    left: 0;

    width: 100%;
    height: 86px;

    background: transparent !important;

    border: 0 !important;

    box-shadow: none !important;

    z-index: 99999;

    pointer-events: auto;
}


/* =========================================================
   CONTAINER
========================================================= */

.header .container {
    width: 100%;
    max-width: 1500px;

    height: 100%;

    margin: 0 auto;

    padding: 0 24px;
}


/* =========================================================
   MAIN FLOATING HEADER
========================================================= */

.header-content {
    position: relative;

    width: 100%;
    max-width: 1450px;

    height: 68px;

    margin: 9px auto 0;

    padding: 6px 9px;

    display: flex;
    align-items: center;

    gap: 20px;

    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.92),
            rgba(247,245,255,.82)
        );

    border: 1px solid rgba(255,255,255,.90);

    border-radius: 25px;

    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);

    box-shadow:
        0 20px 50px rgba(69,48,145,.13),
        0 5px 15px rgba(69,48,145,.07),
        inset 0 1px 0 rgba(255,255,255,.98),
        inset 0 -1px 0 rgba(110,80,190,.06);

    overflow: visible;

    pointer-events: auto;

    transition:
        box-shadow .3s ease,
        background .3s ease,
        border-color .3s ease;
}


/* =========================================================
   SUBTLE HEADER GLOW
========================================================= */

.header-content::before {
    content: "";

    position: absolute;

    top: -1px;
    left: 10%;

    width: 40%;
    height: 2px;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(139,92,246,.65),
            transparent
        );

    filter: blur(2px);

    pointer-events: none;
}


/* =========================================================
   LOGO
========================================================= */

.header .logo {
    display: flex;
    align-items: center;

    flex-shrink: 0;

    width: auto;

    padding-left: 5px;

    text-decoration: none;

    pointer-events: auto;
}

.header .logo img {
    display: block;

    width: 155px;

    max-width: 100%;

    height: auto;

    max-height: 56px;

    object-fit: contain;

    border-radius: 10px;

    transition:
        transform .25s ease,
        filter .25s ease;
}

.header .logo:hover img {
    transform: translateY(-1px) scale(1.015);

    filter:
        drop-shadow(
            0 7px 12px
            rgba(109,40,217,.18)
        );
}


/* =========================================================
   DESKTOP NAV
========================================================= */

.header nav {
    flex: 1;

    min-width: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    pointer-events: auto;
}

.header nav ul {
    display: flex;

    align-items: center;
    justify-content: center;

    gap: 4px;

    margin: 0;
    padding: 5px;

    list-style: none;

    background:
        rgba(242,239,252,.72);

    border: 1px solid rgba(255,255,255,.95);

    border-radius: 22px;

    box-shadow:
        inset 2px 2px 5px rgba(94,72,155,.05),
        inset -2px -2px 5px rgba(255,255,255,.90);

    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
}

.header nav ul li {
    margin: 0;
    padding: 0;
}


/* =========================================================
   NAV LINKS
========================================================= */

.header nav ul li a {
    position: relative;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 44px;

    padding: 0 17px;

    border-radius: 17px;

    color: #40377d;

    background: transparent;

    text-decoration: none;

    font-family: "Poppins", sans-serif;

    font-size: 13px;

    font-weight: 600;

    white-space: nowrap;

    transition:
        color .25s ease,
        background .25s ease,
        transform .25s ease,
        box-shadow .25s ease;
}


/* =========================================================
   NAV HOVER
========================================================= */

.header nav ul li a:hover {
    color: var(--aone-purple);

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.96),
            rgba(239,234,255,.86)
        );

    transform: translateY(-1px);

    box-shadow:
        0 7px 15px rgba(90,60,170,.10),
        inset 0 1px 0 rgba(255,255,255,.95);
}


/* =========================================================
   ACTIVE CONTACT
========================================================= */

.header nav ul li.contact-nav-item a {
    color: #ffffff;

    background:
        linear-gradient(
            145deg,
            #7c3aed 0%,
            #8b5cf6 52%,
            #a855f7 100%
        );

    border: 1px solid rgba(255,255,255,.22);

    box-shadow:
        0 8px 20px rgba(109,40,217,.27),
        0 3px 6px rgba(109,40,217,.14),
        inset 0 1px 0 rgba(255,255,255,.28),
        inset 0 -2px 4px rgba(72,28,150,.12);
}

.header nav ul li.contact-nav-item a:hover {
    color: #ffffff;

    transform:
        translateY(-2px);

    box-shadow:
        0 12px 25px rgba(109,40,217,.34),
        inset 0 1px 0 rgba(255,255,255,.30);
}


/* =========================================================
   RIGHT SIDE
========================================================= */

.student-header-right {
    margin-left: auto;

    display: flex;
    align-items: center;

    flex-shrink: 0;

    gap: 8px;

    pointer-events: auto;
}


/* =========================================================
   PROFILE WRAPPER
========================================================= */

.student-profile-dropdown {
    position: relative;

    z-index: 100001;

    pointer-events: auto;
}


/* =========================================================
   PROFILE BUTTON
========================================================= */

.student-profile-button {
    position: relative;

    display: flex;
    align-items: center;

    gap: 9px;

    width: auto;

    min-width: 175px;

    height: 48px;

    padding: 4px 11px 4px 5px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.96),
            rgba(244,241,255,.86)
        );

    border: 1px solid rgba(255,255,255,.95);

    border-radius: 25px;

    color: #34276f;

    cursor: pointer;

    font-family: "Poppins", sans-serif;

    appearance: none;
    -webkit-appearance: none;

    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);

    box-shadow:
        7px 7px 18px rgba(83,64,150,.10),
        -4px -4px 12px rgba(255,255,255,.90),
        inset 0 1px 0 rgba(255,255,255,.98);

    touch-action: manipulation;

    pointer-events: auto;

    transition:
        transform .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
}

.student-profile-button:hover {
    transform: translateY(-1px);

    border-color: rgba(139,92,246,.25);

    box-shadow:
        8px 10px 22px rgba(83,64,150,.14),
        -4px -4px 12px rgba(255,255,255,.95);
}

.student-profile-button:active {
    transform: translateY(1px);

    box-shadow:
        inset 3px 3px 7px rgba(90,70,150,.10),
        inset -3px -3px 7px rgba(255,255,255,.85);
}

.student-profile-button:focus {
    outline: none;
}


/* =========================================================
   AVATAR
========================================================= */

.student-header-avatar {
    width: 39px;
    height: 39px;

    min-width: 39px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 50%;

    background:
        linear-gradient(
            145deg,
            #6d28d9,
            #a855f7
        );

    border: 2px solid rgba(255,255,255,.75);

    color: #ffffff;

    font-size: 17px;

    box-shadow:
        0 5px 12px rgba(109,40,217,.25),
        inset 0 1px 2px rgba(255,255,255,.30);
}

.student-header-avatar-image {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
}


/* =========================================================
   USER NAME
========================================================= */

.student-header-name {
    max-width: 105px;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

    color: #322568;

    font-family: "Poppins", sans-serif;

    font-size: 13px;

    font-weight: 700;
}


/* =========================================================
   ARROW
========================================================= */

.student-dropdown-arrow {
    margin-left: auto;

    color: #7569a0;

    font-size: 10px;

    transition:
        transform .25s ease,
        color .2s ease;
}

.student-profile-button:hover
.student-dropdown-arrow {
    color: var(--aone-purple);
}

.student-profile-button.active
.student-dropdown-arrow {
    transform: rotate(180deg);
}


/* =========================================================
   PROFILE DROPDOWN
========================================================= */

.student-dropdown-menu {
    position: absolute;

    top: calc(100% + 12px);
    right: 0;

    width: 315px;
    max-width: calc(100vw - 20px);

    padding: 9px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.98),
            rgba(246,243,255,.96)
        );

    border: 1px solid rgba(255,255,255,.95);

    border-radius: 20px;

    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);

    box-shadow:
        0 25px 55px rgba(57,40,120,.20),
        0 8px 20px rgba(57,40,120,.10),
        inset 0 1px 0 rgba(255,255,255,1);

    z-index: 100003;

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transform:
        translateY(-8px)
        scale(.98);

    transform-origin: top right;

    transition:
        opacity .2s ease,
        transform .2s ease,
        visibility .2s ease;
}

.student-dropdown-menu.open {
    opacity: 1;

    visibility: visible;

    pointer-events: auto;

    transform:
        translateY(0)
        scale(1);
}


/* =========================================================
   DROPDOWN USER
========================================================= */

.student-dropdown-user {
    display: flex;
    align-items: center;

    gap: 12px;

    padding: 13px 12px;

    border-radius: 15px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.80),
            rgba(239,234,255,.55)
        );
}


/* =========================================================
   DROPDOWN AVATAR
========================================================= */

.student-dropdown-avatar {
    width: 51px;
    height: 51px;

    min-width: 51px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 50%;

    background:
        linear-gradient(
            145deg,
            #6d28d9,
            #a855f7
        );

    border: 2px solid rgba(255,255,255,.85);

    color: #ffffff;

    font-size: 20px;

    box-shadow:
        0 7px 15px rgba(109,40,217,.22),
        inset 0 1px 2px rgba(255,255,255,.30);
}

.student-dropdown-avatar img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
}


/* =========================================================
   DROPDOWN INFO
========================================================= */

.student-dropdown-info {
    min-width: 0;

    display: flex;

    flex-direction: column;
}

.student-dropdown-info strong {
    color: #26185f;

    font-family: "Poppins", sans-serif;

    font-size: 15px;

    font-weight: 700;

    line-height: 1.3;
}

.student-dropdown-info small {
    margin-top: 3px;

    color: #747093;

    font-family: "Poppins", sans-serif;

    font-size: 12px;

    line-height: 1.3;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}


/* =========================================================
   ROLE
========================================================= */

.student-role {
    width: fit-content;

    margin-top: 6px;

    padding: 3px 10px;

    background:
        linear-gradient(
            135deg,
            #7c3aed,
            #a855f7
        );

    color: #ffffff !important;

    border-radius: 20px;

    font-size: 9px;

    font-weight: 700;

    line-height: 1.3;

    box-shadow:
        0 4px 10px rgba(109,40,217,.18);
}


/* =========================================================
   DIVIDER
========================================================= */

.student-dropdown-divider {
    height: 1px;

    margin: 8px 5px;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(103,78,160,.15),
            transparent
        );
}


/* =========================================================
   DROPDOWN ITEMS
========================================================= */

.student-dropdown-item {
    display: flex;
    align-items: center;

    gap: 12px;

    width: 100%;

    padding: 12px 13px;

    border: 0;

    border-radius: 12px;

    background: transparent;

    color: #514878;

    text-decoration: none;

    font-family: "Poppins", sans-serif;

    font-size: 13px;

    font-weight: 600;

    cursor: pointer;

    text-align: left;

    transition:
        background .2s ease,
        color .2s ease,
        transform .2s ease;
}

.student-dropdown-item:hover {
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.95),
            rgba(237,232,255,.80)
        );

    color: var(--aone-purple);

    transform: translateX(2px);

    box-shadow:
        0 5px 12px rgba(80,60,150,.07);
}

.student-dropdown-item i {
    width: 22px;

    flex-shrink: 0;

    color: #7567a5;

    font-size: 18px;

    text-align: center;

    transition: color .2s ease;
}

.student-dropdown-item:hover i {
    color: var(--aone-purple);
}


/* =========================================================
   LOGOUT
========================================================= */

.student-logout {
    color: #dc3545;
}

.student-logout i {
    color: #dc3545;
}

.student-logout:hover {
    background:
        rgba(220,53,69,.08);

    color: #dc3545;
}

.student-logout:hover i {
    color: #dc3545;
}

.student-logout-form {
    width: 100%;

    margin: 0;
}


/* =========================================================
   LOGIN BUTTON
========================================================= */

.auth-btn {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 44px;

    padding: 0 18px;

    border-radius: 22px;

    background:
        linear-gradient(
            145deg,
            #6d28d9,
            #8b5cf6 55%,
            #a855f7
        );

    border: 1px solid rgba(255,255,255,.28);

    color: #ffffff;

    text-decoration: none;

    font-family: "Poppins", sans-serif;

    font-size: 13px;

    font-weight: 700;

    white-space: nowrap;

    box-shadow:
        0 8px 20px rgba(109,40,217,.25),
        inset 0 1px 0 rgba(255,255,255,.25);

    transition:
        transform .2s ease,
        box-shadow .2s ease;
}

.auth-btn:hover {
    color: #ffffff;

    transform: translateY(-2px);

    box-shadow:
        0 12px 27px rgba(109,40,217,.34),
        inset 0 1px 0 rgba(255,255,255,.30);
}

.auth-btn:active {
    transform: translateY(0);
}


/* =========================================================
   THEME TOGGLE
========================================================= */

.header-icon.theme-toggle {
    position: relative;

    z-index: 100005;

    width: 44px;
    height: 44px;

    flex-shrink: 0;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    margin-right: 3px;

    padding: 0;

    border: 1px solid rgba(255,255,255,.90);

    border-radius: 50%;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.96),
            rgba(241,237,255,.90)
        );

    color: #f59e0b;

    cursor: pointer;

    font-size: 16px;

    line-height: 1;

    text-decoration: none;

    appearance: none;
    -webkit-appearance: none;

    user-select: none;

    pointer-events: auto !important;

    touch-action: manipulation;

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    box-shadow:
        6px 6px 14px rgba(79,60,145,.10),
        -4px -4px 10px rgba(255,255,255,.95),
        inset 0 1px 0 rgba(255,255,255,.95);

    transition:
        background .25s ease,
        color .25s ease,
        border-color .25s ease,
        transform .25s ease,
        box-shadow .25s ease;
}

.header-icon.theme-toggle:hover {
    background:
        linear-gradient(
            145deg,
            #ffffff,
            #eee9ff
        );

    border-color: rgba(139,92,246,.30);

    color: #f59e0b;

    transform:
        translateY(-2px)
        rotate(4deg);

    box-shadow:
        7px 9px 18px rgba(79,60,145,.13),
        -4px -4px 10px rgba(255,255,255,.95);
}

.header-icon.theme-toggle:active {
    transform: scale(.93);
}

.header-icon.theme-toggle:focus {
    outline: none;

    box-shadow:
        0 0 0 3px rgba(139,92,246,.15),
        6px 6px 14px rgba(79,60,145,.10);
}

#themeIcon {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    pointer-events: none;

    line-height: 1;
}


/* =========================================================
   MOBILE MENU BUTTON
========================================================= */

.mobile-menu-button {
    display: none;

    position: relative;

    z-index: 100000;

    width: 43px;
    height: 43px;

    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    padding: 0;

    border: 1px solid rgba(255,255,255,.90);

    border-radius: 13px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.96),
            rgba(240,236,255,.90)
        );

    color: #4c3a91;

    font-size: 19px;

    line-height: 1;

    cursor: pointer;

    appearance: none;
    -webkit-appearance: none;

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    box-shadow:
        5px 5px 13px rgba(79,60,145,.10),
        -3px -3px 9px rgba(255,255,255,.95);

    pointer-events: auto;

    transition:
        background .2s ease,
        color .2s ease,
        border-color .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
}

.mobile-menu-button:hover,
.mobile-menu-button.active {
    color: #ffffff;

    background:
        linear-gradient(
            145deg,
            #6d28d9,
            #a855f7
        );

    border-color: rgba(255,255,255,.25);

    transform: translateY(-1px);

    box-shadow:
        0 8px 18px rgba(109,40,217,.25),
        inset 0 1px 0 rgba(255,255,255,.25);
}

.mobile-menu-button:active {
    transform: scale(.94);
}

.mobile-menu-button:focus {
    outline: none;
}


/* =========================================================
   MOBILE NAVIGATION
========================================================= */

.mobile-navigation {
    display: none;

    position: fixed;

    top: 84px;

    left: 12px;

    width: calc(100% - 24px);

    max-height: calc(100dvh - 96px);

    overflow-x: hidden;
    overflow-y: auto;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.98),
            rgba(245,242,255,.96)
        );

    border: 1px solid rgba(255,255,255,.95);

    border-radius: 20px;

    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);

    box-shadow:
        0 25px 55px rgba(57,40,120,.18),
        0 8px 20px rgba(57,40,120,.08),
        inset 0 1px 0 rgba(255,255,255,1);

    z-index: 99998;

    pointer-events: auto;
}

.mobile-navigation.open {
    display: block;

    animation:
        mobileNavIn .2s ease both;
}

@keyframes mobileNavIn {
    from {
        opacity: 0;
        transform: translateY(-8px) scale(.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}


.mobile-navigation ul {
    display: flex;

    flex-direction: column;

    gap: 4px;

    margin: 0;

    padding: 10px;

    list-style: none;
}

.mobile-navigation ul li {
    width: 100%;

    margin: 0;
    padding: 0;
}

.mobile-navigation ul li a {
    display: flex;

    align-items: center;

    width: 100%;

    min-height: 46px;

    padding: 10px 15px;

    border-radius: 12px;

    color: #514878;

    text-decoration: none;

    font-family: "Poppins", sans-serif;

    font-size: 14px;

    font-weight: 600;

    transition:
        color .2s ease,
        background .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
}

.mobile-navigation ul li a:hover {
    color: var(--aone-purple);

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #eeeaff
        );

    transform: translateX(2px);

    box-shadow:
        0 5px 12px rgba(80,60,150,.08);
}


/* =========================================================
   MOBILE CONTACT ACTIVE
========================================================= */

.mobile-navigation
li.contact-mobile-item a {
    color: #ffffff;

    background:
        linear-gradient(
            145deg,
            #6d28d9,
            #8b5cf6,
            #a855f7
        );

    box-shadow:
        0 8px 18px rgba(109,40,217,.22),
        inset 0 1px 0 rgba(255,255,255,.25);
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1150px) {

    .header .container {
        padding: 0 15px;
    }

    .header-content {
        gap: 12px;
    }

    .header .logo img {
        width: 135px;
    }

    .header nav ul li a {
        padding: 0 11px;

        font-size: 12px;
    }

    .student-profile-button {
        min-width: 155px;
    }

    .student-header-name {
        max-width: 80px;
    }

    .header-icon.theme-toggle {
        width: 42px;
        height: 42px;
    }
}


/* =========================================================
   MOBILE / TABLET
========================================================= */

@media (max-width: 850px) {

    .header {
        height: 76px;
    }

    .header .container {
        padding: 0 10px;
    }

    .header-content {
        width: 100%;

        height: 60px;

        margin-top: 7px;

        padding: 5px 7px;

        gap: 7px;

        border-radius: 22px;
    }

