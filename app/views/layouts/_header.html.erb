<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   TRANSPARENT FLOATING GLASS HEADER
========================================================= */

.header {
    position: fixed;

    top: 0;
    left: 0;

    width: 100%;
    height: 82px;

    background: transparent !important;

    border: none !important;
    box-shadow: none !important;

    z-index: 99999;

    /* IMPORTANT:
       Header and all controls must remain clickable */
    pointer-events: auto;
}


/* =========================================================
   OUTER CONTAINER
========================================================= */

.header .container {
    width: 100%;
    max-width: 1400px;

    height: 100%;

    margin: 0 auto;

    padding: 0 18px;
}


/* =========================================================
   MAIN GLASS BAR
========================================================= */

.header-content {
    position: relative;

    width: 100%;
    max-width: 1250px;

    height: 64px;

    margin: 8px auto 0;

    padding: 5px 8px;

    display: flex;
    align-items: center;

    gap: 18px;

    background: rgba(8, 10, 16, 0.42);

    border: 1px solid rgba(255, 255, 255, 0.09);

    border-radius: 36px;

    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);

    box-shadow:
        0 10px 40px rgba(0, 0, 0, 0.24),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);

    pointer-events: auto;

    transition:
        background 0.3s ease,
        border-color 0.3s ease,
        box-shadow 0.3s ease;
}


/* =========================================================
   LOGO
========================================================= */

.header .logo {
    display: flex;
    align-items: center;

    flex-shrink: 0;

    width: auto;

    padding-left: 6px;

    text-decoration: none;

    pointer-events: auto;
}

.header .logo img {
    display: block;

    width: 145px;

    max-width: 100%;

    height: auto;

    max-height: 52px;

    object-fit: contain;

    border-radius: 4px;
}


/* =========================================================
   DESKTOP NAVIGATION
========================================================= */

.header nav {
    flex: 1;

    min-width: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    pointer-events: auto;
}

.header nav ul {
    display: flex;

    align-items: center;
    justify-content: center;

    gap: 3px;

    margin: 0;
    padding: 4px;

    list-style: none;

    background: rgba(0, 0, 0, 0.17);

    border: 1px solid rgba(255, 255, 255, 0.07);

    border-radius: 32px;

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
}

.header nav ul li {
    margin: 0;
    padding: 0;
}


/* =========================================================
   NAV LINKS
========================================================= */

.header nav ul li a {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 44px;

    padding: 0 18px;

    border-radius: 25px;

    color: #9da9bc;

    background: transparent;

    text-decoration: none;

    font-family: "Poppins", sans-serif;

    font-size: 14px;

    font-weight: 600;

    white-space: nowrap;

    transition:
        color 0.25s ease,
        background 0.25s ease,
        box-shadow 0.25s ease,
        transform 0.25s ease;
}


/* =========================================================
   NAV HOVER
========================================================= */

.header nav ul li a:hover {
    color: #ffffff;

    background: rgba(255, 255, 255, 0.07);
}


/* =========================================================
   CONTACT US ACTIVE
========================================================= */

.header nav ul li.contact-nav-item a {
    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            #7135e8 0%,
            #9655f7 100%
        );

    box-shadow:
        0 8px 25px rgba(124, 58, 237, 0.38);
}

.header nav ul li.contact-nav-item a:hover {
    color: #ffffff;

    transform: translateY(-1px);

    box-shadow:
        0 10px 30px rgba(124, 58, 237, 0.50);
}


/* =========================================================
   RIGHT SIDE
========================================================= */

.student-header-right {
    margin-left: auto;

    display: flex;
    align-items: center;

    flex-shrink: 0;

    pointer-events: auto;
}


/* =========================================================
   PROFILE WRAPPER
========================================================= */

.student-profile-dropdown {
    position: relative;

    z-index: 100001;

    pointer-events: auto;
}


/* =========================================================
   PROFILE BUTTON
========================================================= */

.student-profile-button {
    position: relative;

    display: flex;
    align-items: center;

    gap: 9px;

    width: auto;
    min-width: 170px;

    height: 46px;

    padding: 4px 10px 4px 5px;

    background: rgba(255, 255, 255, 0.035);

    border: 1px solid rgba(255, 255, 255, 0.09);

    border-radius: 28px;

    color: #d8deea;

    cursor: pointer;

    font-family: "Poppins", sans-serif;

    appearance: none;
    -webkit-appearance: none;

    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);

    box-shadow:
        0 6px 20px rgba(0, 0, 0, 0.16);

    touch-action: manipulation;

    pointer-events: auto;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.student-profile-button:hover {
    background: rgba(255, 255, 255, 0.07);

    border-color: rgba(168, 85, 247, 0.38);

    box-shadow:
        0 8px 24px rgba(0, 0, 0, 0.20);
}

.student-profile-button:focus {
    outline: none;

    border-color: rgba(168, 85, 247, 0.45);
}


/* =========================================================
   HEADER AVATAR
========================================================= */

.student-header-avatar {
    width: 38px;
    height: 38px;

    min-width: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.08);

    border: 2px solid rgba(255, 255, 255, 0.13);

    color: #aab4c5;

    font-size: 17px;
}

.student-header-avatar-image {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
}


/* =========================================================
   USER NAME
========================================================= */

.student-header-name {
    max-width: 100px;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

    color: #dce2ec;

    font-family: "Poppins", sans-serif;

    font-size: 13px;

    font-weight: 600;
}


/* =========================================================
   ARROW
========================================================= */

.student-dropdown-arrow {
    margin-left: auto;

    color: #94a0b4;

    font-size: 10px;

    transition: transform 0.2s ease;
}

.student-profile-button.active
.student-dropdown-arrow {
    transform: rotate(180deg);
}


/* =========================================================
   PROFILE DROPDOWN
========================================================= */

.student-dropdown-menu {
    position: absolute;

    top: calc(100% + 10px);
    right: 0;

    width: 310px;
    max-width: calc(100vw - 20px);

    padding: 8px;

    background: rgba(10, 13, 21, 0.94);

    border: 1px solid rgba(255, 255, 255, 0.10);

    border-radius: 18px;

    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);

    box-shadow:
        0 20px 50px rgba(0, 0, 0, 0.38);

    z-index: 100003;

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transform: translateY(-8px);

    transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0.2s ease;
}

.student-dropdown-menu.open {
    opacity: 1;

    visibility: visible;

    pointer-events: auto;

    transform: translateY(0);
}


/* =========================================================
   DROPDOWN USER
========================================================= */

.student-dropdown-user {
    display: flex;
    align-items: center;

    gap: 12px;

    padding: 13px 12px;
}


/* =========================================================
   DROPDOWN AVATAR
========================================================= */

.student-dropdown-avatar {
    width: 50px;
    height: 50px;

    min-width: 50px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.08);

    border: 2px solid rgba(255, 255, 255, 0.12);

    color: #aab4c5;

    font-size: 20px;
}

.student-dropdown-avatar img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
}


/* =========================================================
   DROPDOWN USER INFORMATION
========================================================= */

.student-dropdown-info {
    min-width: 0;

    display: flex;

    flex-direction: column;
}

.student-dropdown-info strong {
    color: #ffffff;

    font-size: 15px;

    font-weight: 700;

    line-height: 1.3;
}

.student-dropdown-info small {
    margin-top: 3px;

    color: #9da9bc;

    font-size: 12px;

    line-height: 1.3;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}


/* =========================================================
   ROLE
========================================================= */

.student-role {
    width: fit-content;

    margin-top: 6px;

    padding: 3px 9px;

    background:
        linear-gradient(
            135deg,
            #7135e8,
            #9558f7
        );

    color: #ffffff;

    border-radius: 20px;

    font-size: 10px;

    font-weight: 700;

    line-height: 1.3;
}


/* =========================================================
   DROPDOWN DIVIDER
========================================================= */

.student-dropdown-divider {
    height: 1px;

    margin: 7px 4px;

    background: rgba(255, 255, 255, 0.09);
}


/* =========================================================
   DROPDOWN ITEMS
========================================================= */

.student-dropdown-item {
    display: flex;
    align-items: center;

    gap: 12px;

    width: 100%;

    padding: 11px 13px;

    border: 0;

    border-radius: 10px;

    background: transparent;

    color: #c5cedc;

    text-decoration: none;

    font-family: "Poppins", sans-serif;

    font-size: 14px;

    font-weight: 500;

    cursor: pointer;

    text-align: left;

    transition:
        background 0.2s ease,
        color 0.2s ease;
}

.student-dropdown-item:hover {
    background: rgba(255, 255, 255, 0.07);

    color: #ffffff;
}

.student-dropdown-item i {
    width: 20px;

    flex-shrink: 0;

    color: #9da9bc;

    font-size: 18px;

    text-align: center;
}

.student-dropdown-item:hover i {
    color: #a855f7;
}


/* =========================================================
   LOGOUT
========================================================= */

.student-logout {
    color: #f87171;
}

.student-logout i {
    color: #f87171;
}

.student-logout:hover {
    background: rgba(239, 68, 68, 0.10);

    color: #f87171;
}

.student-logout:hover i {
    color: #f87171;
}

.student-logout-form {
    width: 100%;

    margin: 0;
}


/* =========================================================
   LOGIN BUTTON
========================================================= */

.auth-btn {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 44px;

    padding: 0 18px;

    border-radius: 25px;

    background:
        linear-gradient(
            135deg,
            #7135e8,
            #9558f7
        );

    border: 1px solid rgba(255, 255, 255, 0.08);

    color: #ffffff;

    text-decoration: none;

    font-family: "Poppins", sans-serif;

    font-size: 13px;

    font-weight: 600;

    white-space: nowrap;

    box-shadow:
        0 7px 22px rgba(124, 58, 237, 0.30);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.auth-btn:hover {
    color: #ffffff;

    transform: translateY(-1px);

    box-shadow:
        0 10px 28px rgba(124, 58, 237, 0.45);
}


/* =========================================================
   MOBILE MENU BUTTON
========================================================= */

.mobile-menu-button {
    display: none;

    position: relative;

    z-index: 100000;

    width: 42px;
    height: 42px;

    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    padding: 0;

    border: 1px solid rgba(255, 255, 255, 0.10);

    border-radius: 11px;

    background: rgba(255, 255, 255, 0.035);

    color: #e5e7eb;

    font-size: 20px;

    line-height: 1;

    cursor: pointer;

    appearance: none;
    -webkit-appearance: none;

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    pointer-events: auto;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease;
}

.mobile-menu-button:hover,
.mobile-menu-button.active {
    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            rgba(113, 53, 232, 0.8),
            rgba(149, 88, 247, 0.8)
        );

    border-color: rgba(168, 85, 247, 0.45);
}

.mobile-menu-button:focus {
    outline: none;
}


/* =========================================================
   MOBILE NAVIGATION
========================================================= */

.mobile-navigation {
    display: none;

    position: fixed;

    top: 76px;

    left: 10px;

    width: calc(100% - 20px);

    max-height: calc(100dvh - 88px);

    overflow-x: hidden;
    overflow-y: auto;

    background: rgba(8, 10, 16, 0.88);

    border: 1px solid rgba(255, 255, 255, 0.10);

    border-radius: 18px;

    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);

    box-shadow:
        0 20px 45px rgba(0, 0, 0, 0.38);

    z-index: 99998;

    pointer-events: auto;
}

.mobile-navigation.open {
    display: block;
}

.mobile-navigation ul {
    display: flex;

    flex-direction: column;

    gap: 3px;

    margin: 0;

    padding: 9px;

    list-style: none;
}

.mobile-navigation ul li {
    width: 100%;

    margin: 0;
    padding: 0;
}

.mobile-navigation ul li a {
    display: flex;

    align-items: center;

    width: 100%;

    min-height: 45px;

    padding: 10px 14px;

    border-radius: 10px;

    color: #aeb8c9;

    text-decoration: none;

    font-family: "Poppins", sans-serif;

    font-size: 14px;

    font-weight: 600;

    transition:
        color 0.2s ease,
        background 0.2s ease;
}

.mobile-navigation ul li a:hover {
    color: #ffffff;

    background: rgba(255, 255, 255, 0.07);
}


/* =========================================================
   MOBILE CONTACT ACTIVE
========================================================= */

.mobile-navigation
li.contact-mobile-item a {
    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            #7135e8,
            #9558f7
        );

    box-shadow:
        0 7px 20px rgba(124, 58, 237, 0.30);
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1100px) {

    .header .container {
        padding: 0 14px;
    }

    .header-content {
        max-width: 100%;

        gap: 12px;
    }

    .header .logo img {
        width: 130px;
    }

    .header nav ul li a {
        padding: 0 13px;

        font-size: 13px;
    }

    .student-profile-button {
        min-width: 150px;
    }

    .student-header-name {
        max-width: 75px;
    }
}


/* =========================================================
   MOBILE / TABLET
========================================================= */

@media (max-width: 850px) {

    .header {
        height: 74px;
    }

    .header .container {
        padding: 0 10px;
    }

    .header-content {
        width: 100%;

        height: 58px;

        margin-top: 7px;

        padding: 5px 7px;

        gap: 7px;

        border-radius: 30px;
    }

    .header .logo {
        min-width: 0;

        flex: 0 1 auto;
    }

    .header .logo img {
        width: 125px;

        max-height: 48px;
    }

    .header nav {
        display: none;
    }

    .mobile-menu-button {
        display: flex;

        margin-left: auto;
    }

    .student-header-right {
        margin-left: 0;
    }

    .student-profile-button {
        width: 43px;

        min-width: 43px;

        height: 43px;

        padding: 3px;

        justify-content: center;
    }

    .student-header-avatar {
        width: 36px;
        height: 36px;

        min-width: 36px;
    }

    .student-header-name,
    .student-dropdown-arrow {
        display: none;
    }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 576px) {

    .header {
        height: 68px;
    }

    .header .container {
        padding: 0 8px;
    }

    .header-content {
        height: 54px;

        margin-top: 7px;

        gap: 5px;

        border-radius: 28px;
    }

    .header .logo img {
        width: 110px;

        max-height: 44px;
    }

    .mobile-menu-button {
        width: 39px;
        height: 39px;

        font-size: 18px;
    }

    .student-profile-button {
        width: 39px;
        min-width: 39px;

        height: 39px;
    }

    .student-header-avatar {
        width: 33px;
        height: 33px;

        min-width: 33px;
    }

    .mobile-navigation {
        top: 68px;

        left: 8px;

        width: calc(100% - 16px);

        max-height: calc(100dvh - 78px);
    }

    .auth-btn {
        min-height: 39px;

        padding: 0 10px;

        font-size: 11px;
    }

    .student-dropdown-menu {
        position: fixed;

        top: 72px;

        right: 8px;

        width: 300px;

        max-width: calc(100vw - 16px);
    }
}


/* =========================================================
   STUDENT HEADER THEME TOGGLE
========================================================= */

.header-icon.theme-toggle {
    position: relative;

    z-index: 100005;

    width: 44px;
    height: 44px;

    flex-shrink: 0;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    margin-right: 4px;

    padding: 0;

    border: 1px solid rgba(255,255,255,.10);

    border-radius: 50%;

    background: rgba(255,255,255,.05);

    color: #facc15;

    cursor: pointer;

    font-size: 17px;

    line-height: 1;

    text-decoration: none;

    appearance: none;
    -webkit-appearance: none;

    user-select: none;

    pointer-events: auto !important;

    touch-action: manipulation;

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    box-shadow:
        0 5px 18px rgba(0,0,0,.15);

    transition:
        background .25s ease,
        color .25s ease,
        border-color .25s ease,
        transform .25s ease,
        box-shadow .25s ease;
}

.header-icon.theme-toggle:hover {
    background: rgba(255,255,255,.10);

    border-color: rgba(168,85,247,.45);

    transform: translateY(-1px);

    box-shadow:
        0 7px 22px rgba(124,58,237,.20);
}

.header-icon.theme-toggle:active {
    transform: scale(.94);
}

.header-icon.theme-toggle:focus {
    outline: none;

    box-shadow:
        0 0 0 3px rgba(168,85,247,.18);
}


/* =========================================================
   THEME ICON
========================================================= */

#themeIcon {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    pointer-events: none;

    line-height: 1;
}


/* =========================================================
   VERY SMALL MOBILE
========================================================= */

@media (max-width: 400px) {

    .header .logo img {
        width: 100px;
    }

    .header-content {
        gap: 4px;
    }

    .mobile-menu-button {
        width: 37px;
        height: 37px;
    }

    .student-profile-button {
        width: 37px;
        min-width: 37px;

        height: 37px;
    }

    .student-header-avatar {
        width: 31px;
        height: 31px;

        min-width: 31px;
    }

    .student-dropdown-menu {
        top: 70px;

        right: 7px;

        width: calc(100vw - 14px);

        max-width: calc(100vw - 14px);
    }
}


/* =========================================================
   THEME TOGGLE - TABLET
========================================================= */

@media (max-width: 850px) {

    .header-icon.theme-toggle {
        width: 42px;
        height: 42px;

        margin-right: 0;

        font-size: 16px;
    }
}


/* =========================================================
   THEME TOGGLE - MOBILE
========================================================= */

@media (max-width: 576px) {

    .header-icon.theme-toggle {
        width: 39px;
        height: 39px;

        font-size: 15px;
    }
}


/* =========================================================
   FORCE MOBILE NAV HIDDEN ON DESKTOP
========================================================= */

@media (min-width: 851px) {

    .mobile-navigation,
    .mobile-navigation.open {
        display: none !important;
    }
}


/* =========================================================
   DAY / NIGHT MODE
========================================================= */

html,
body {
    transition:
        background-color 0.35s ease,
        color 0.35s ease;
}


/* =========================================================
   NIGHT MODE - PAGE
========================================================= */

html.night-mode,
html.night-mode body {
    background: #080b12 !important;

    color: #e5e7eb !important;
}


/* =========================================================
   COMMON PAGE CONTAINERS
========================================================= */

html.night-mode main,
html.night-mode section,
html.night-mode .student-course-details,
html.night-mode .course-details-page,
html.night-mode .course-details-container {
    color: #e5e7eb;
}


/* =========================================================
   COURSE CONTENT CARDS
========================================================= */

html.night-mode .course-details-card,
html.night-mode .course-info-card,
html.night-mode .course-content-card,
html.night-mode .course-action-card {
    background: rgba(17, 20, 30, 0.88) !important;

    border-color: rgba(255,255,255,.10) !important;

    color: #e5e7eb !important;

    box-shadow:
        0 15px 40px rgba(0,0,0,.25);
}


/* =========================================================
   TEXT
========================================================= */

html.night-mode h1,
html.night-mode h2,
html.night-mode h3,
html.night-mode h4,
html.night-mode h5,
html.night-mode h6 {
    color: #ffffff !important;
}

html.night-mode p,
html.night-mode span,
html.night-mode li {
    color: #cbd5e1;
}


/* =========================================================
   HEADER - NIGHT
========================================================= */

html.night-mode .header-content {
    background: rgba(5, 7, 13, 0.90) !important;

    border-color: rgba(255,255,255,.12) !important;

    box-shadow:
        0 10px 40px rgba(0,0,0,.40),
        inset 0 1px 0 rgba(255,255,255,.06);
}


/* =========================================================
   HEADER NAV - NIGHT
========================================================= */

html.night-mode .header nav ul {
    background: rgba(0,0,0,.38);

    border-color: rgba(255,255,255,.08);
}

html.night-mode .header nav ul li a {
    color: #aeb8c9;
}

html.night-mode .header nav ul li a:hover {
    color: #ffffff;

    background: rgba(255,255,255,.08);
}


/* =========================================================
   THEME BUTTON - NIGHT
========================================================= */

html.night-mode .header-icon.theme-toggle {
    background: rgba(124,58,237,.25) !important;

    border-color: rgba(168,85,247,.45) !important;

    color: #facc15 !important;

    box-shadow:
        0 5px 20px rgba(124,58,237,.20);
}


/* =========================================================
   PROFILE BUTTON - NIGHT
========================================================= */

html.night-mode .student-profile-button {
    background: rgba(255,255,255,.06) !important;

    border-color: rgba(255,255,255,.12) !important;

    color: #e5e7eb !important;
}

html.night-mode .student-profile-button:hover {
    background: rgba(255,255,255,.10) !important;

    border-color: rgba(168,85,247,.40) !important;
}


/* =========================================================
   PROFILE DROPDOWN - NIGHT
========================================================= */

html.night-mode .student-dropdown-menu {
    background: rgba(8,10,17,.97) !important;

    border-color: rgba(255,255,255,.12) !important;

    box-shadow:
        0 20px 55px rgba(0,0,0,.55);
}

html.night-mode .student-dropdown-info strong {
    color: #ffffff !important;
}

html.night-mode .student-dropdown-info small {
    color: #94a3b8 !important;
}

html.night-mode .student-dropdown-divider {
    background: rgba(255,255,255,.10);
}

html.night-mode .student-dropdown-item {
    color: #cbd5e1;
}

html.night-mode .student-dropdown-item:hover {
    background: rgba(255,255,255,.07);

    color: #ffffff;
}


/* =========================================================
   MOBILE NAV - NIGHT
========================================================= */

html.night-mode .mobile-navigation {
    background: rgba(8,10,16,.96) !important;

    border-color: rgba(255,255,255,.12) !important;

    box-shadow:
        0 20px 50px rgba(0,0,0,.50);
}

html.night-mode .mobile-navigation ul li a {
    color: #aeb8c9;
}

html.night-mode .mobile-navigation ul li a:hover {
    color: #ffffff;

    background: rgba(255,255,255,.08);
}


/* =========================================================
   MOBILE MENU BUTTON - NIGHT
========================================================= */

html.night-mode .mobile-menu-button {
    background: rgba(255,255,255,.06) !important;

    border-color: rgba(255,255,255,.12) !important;

    color: #e5e7eb !important;
}


/* =========================================================
   FORM / INPUTS - NIGHT
========================================================= */

html.night-mode input,
html.night-mode textarea,
html.night-mode select {
    background: #11151f !important;

    color: #ffffff !important;

    border-color: rgba(255,255,255,.12) !important;
}

html.night-mode input::placeholder,
html.night-mode textarea::placeholder {
    color: #64748b !important;
}


/* =========================================================
   LINKS - NIGHT
========================================================= */

html.night-mode a {
    color: #c4b5fd;
}


/* =========================================================
   BOOTSTRAP CARD SUPPORT
========================================================= */

html.night-mode .card {
    background: rgba(17,20,30,.90) !important;

    color: #e5e7eb !important;

    border-color: rgba(255,255,255,.10) !important;
}

html.night-mode .card-body,
html.night-mode .card-header,
html.night-mode .card-footer {
    background: transparent !important;

    color: #e5e7eb !important;
}


/* =========================================================
   REDUCE MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    .header-content,
    .header nav ul li a,
    .student-profile-button,
    .student-dropdown-menu,
    .mobile-menu-button,
    .header-icon.theme-toggle {
        transition: none !important;
    }
}

</style>
<!-- =========================================================
     HEADER
========================================================= -->

<header class="header">

  <div class="container">

    <div class="header-content">


      <!-- =====================================================
           LOGO
      ====================================================== -->

      <%= link_to homepage_path, class: "logo" do %>

        <%= image_tag "logo.jpeg",
            alt: "A One GS Center" %>

      <% end %>


      <!-- =====================================================
           DESKTOP NAVIGATION
      ====================================================== -->

      <nav>

        <ul>

          <li>
            <%= link_to "Home",
                homepage_path %>
          </li>

          <li>
            <%= link_to "Courses",
                homepage_path(anchor: "courses") %>
          </li>
          <li>
            <%= link_to "Test Series", test_series_index_path %>
          </li>

          <li class="contact-nav-item">
            <%= link_to "Contact Us",
                homepage_path(anchor: "contact") %>
          </li>

          <li>
            <%= link_to "Gallery",
                homepage_path(anchor: "gallery") %>
          </li>

          <li>
            <%= link_to "Teachers",
                homepage_path(anchor: "teachers") %>
          </li>

        </ul>

      </nav>



      <!-- =====================================================
           MOBILE MENU
      ====================================================== -->

      <button
        type="button"
        class="mobile-menu-button"
        id="mobileMenuButton"
        aria-label="Open navigation menu"
        aria-expanded="false">

        <i class="bi bi-list"></i>

      </button>
      <% if content_for?(:enable_theme_toggle) %>

  <button
    type="button"
    class="header-icon theme-toggle"
    id="themeToggle"
    title="Switch to Night Mode"
    aria-label="Toggle Day/Night Mode">

    <i
      class="bi bi-moon-stars-fill"
      id="themeIcon">
    </i>

  </button>

<% end %>


      <!-- =====================================================
           RIGHT SIDE
      ====================================================== -->

      <% if user_signed_in? %>

        <div class="student-header-right">

          <div class="student-profile-dropdown">

            <button
              type="button"
              class="student-profile-button"
              id="studentProfileButton"
              aria-expanded="false"
              aria-controls="studentProfileMenu">

              <span class="student-header-avatar">

                <% if current_user.image.attached? %>

                  <%= image_tag current_user.image,
                      class: "student-header-avatar-image",
                      alt: current_user.name %>

                <% else %>

                  <i class="bi bi-person-fill"></i>

                <% end %>

              </span>

              <span class="student-header-name">
                <%= truncate(current_user.name, length: 16) %>
              </span>

              <i class="bi bi-chevron-down student-dropdown-arrow"></i>

            </button>


            <!-- =================================================
                 PROFILE DROPDOWN
            ================================================== -->

            <div
              class="student-dropdown-menu"
              id="studentProfileMenu">

              <div class="student-dropdown-user">

                <div class="student-dropdown-avatar">

                  <% if current_user.image.attached? %>

                    <%= image_tag current_user.image,
                        alt: current_user.name %>

                  <% else %>

                    <i class="bi bi-person-fill"></i>

                  <% end %>

                </div>

                <div class="student-dropdown-info">

                  <strong>
                    <%= current_user.name %>
                  </strong>

                  <small>
                    <%= truncate(current_user.email, length: 28) %>
                  </small>

                  <span class="student-role">
                    <%= current_user.role.to_s.upcase %>
                  </span>

                </div>

              </div>


              <div class="student-dropdown-divider"></div>


              <%= link_to student_profile_path,
                  class: "student-dropdown-item" do %>

                <i class="bi bi-person-circle"></i>

                <span>My Profile</span>

              <% end %>


              <%= link_to student_dashboard_path,
                  class: "student-dropdown-item" do %>

                <i class="bi bi-grid-1x2"></i>

                <span>Dashboard</span>

              <% end %>


              <div class="student-dropdown-divider"></div>


              <%= button_to destroy_user_session_path,
                  method: :delete,
                  class: "student-dropdown-item student-logout",
                  form_class: "student-logout-form" do %>

                <i class="bi bi-box-arrow-right"></i>

                <span>Sign Out</span>

              <% end %>

            </div>
          </div>

        </div>


      <% else %>

        <%= link_to "Login / Register",
            new_user_session_path,
            class: "auth-btn" %>

      <% end %>

    </div>

  </div>

</header>


<!-- =========================================================
     MOBILE NAVIGATION
========================================================= -->

<nav
  class="mobile-navigation"
  id="mobileNavigation">

  <ul>

    <li>
      <%= link_to "Home",
          homepage_path %>
    </li>

    <li>
      <%= link_to "Courses",
          homepage_path(anchor: "courses") %>
    </li>

    <li class="contact-mobile-item">
      <%= link_to "Contact Us",
          homepage_path(anchor: "contact") %>
    </li>

    <li>
      <%= link_to "Gallery",
          homepage_path(anchor: "gallery") %>
    </li>

    <li>
      <%= link_to "Teachers",
          homepage_path(anchor: "teachers") %>
    </li>

  </ul>

</nav>


<script nonce="<%= content_security_policy_nonce %>">

(function () {

    /* =====================================================
       PREVENT DUPLICATE INITIALIZATION
    ===================================================== */

    if (window.studentHeaderInitialized) {
        return;
    }

    window.studentHeaderInitialized = true;


    /* =====================================================
       ELEMENTS
    ===================================================== */

    function getElements() {

        return {

            profileButton:
                document.getElementById(
                    "studentProfileButton"
                ),

            profileMenu:
                document.getElementById(
                    "studentProfileMenu"
                ),

            mobileButton:
                document.getElementById(
                    "mobileMenuButton"
                ),

            mobileNavigation:
                document.getElementById(
                    "mobileNavigation"
                )

        };

    }


    /* =====================================================
       CLOSE PROFILE
    ===================================================== */

    function closeProfile() {

        const {
            profileButton,
            profileMenu
        } = getElements();

        if (!profileButton || !profileMenu) {
            return;
        }

        profileMenu.classList.remove("open");

        profileButton.classList.remove("active");

        profileButton.setAttribute(
            "aria-expanded",
            "false"
        );

    }


    /* =====================================================
       CLOSE MOBILE
    ===================================================== */

    function closeMobile() {

        const {
            mobileButton,
            mobileNavigation
        } = getElements();

        if (!mobileButton || !mobileNavigation) {
            return;
        }

        mobileNavigation.classList.remove("open");

        mobileButton.classList.remove("active");

        mobileButton.setAttribute(
            "aria-expanded",
            "false"
        );

        mobileButton.setAttribute(
            "aria-label",
            "Open navigation menu"
        );

        const icon =
            mobileButton.querySelector("i");

        if (icon) {

            icon.className =
                "bi bi-list";

        }

    }


    /* =====================================================
       PROFILE BUTTON
    ===================================================== */

    document.addEventListener(
        "click",
        function (event) {

            const button =
                event.target.closest(
                    "#studentProfileButton"
                );

            if (!button) {
                return;
            }

            event.preventDefault();

            event.stopPropagation();

            const menu =
                document.getElementById(
                    "studentProfileMenu"
                );

            if (!menu) {
                return;
            }

            const isOpen =
                menu.classList.contains("open");

            closeMobile();

            if (isOpen) {

                closeProfile();

            } else {

                menu.classList.add("open");

                button.classList.add("active");

                button.setAttribute(
                    "aria-expanded",
                    "true"
                );

            }

        },
        true
    );


    /* =====================================================
       MOBILE MENU
    ===================================================== */

    document.addEventListener(
        "click",
        function (event) {

            const button =
                event.target.closest(
                    "#mobileMenuButton"
                );

            if (!button) {
                return;
            }

            event.preventDefault();

            event.stopPropagation();

            const navigation =
                document.getElementById(
                    "mobileNavigation"
                );

            if (!navigation) {
                return;
            }

            const isOpen =
                navigation.classList.contains(
                    "open"
                );

            closeProfile();

            if (isOpen) {

                closeMobile();

            } else {

                navigation.classList.add("open");

                button.classList.add("active");

                button.setAttribute(
                    "aria-expanded",
                    "true"
                );

                button.setAttribute(
                    "aria-label",
                    "Close navigation menu"
                );

                const icon =
                    button.querySelector("i");

                if (icon) {

                    icon.className =
                        "bi bi-x-lg";

                }

            }

        },
        true
    );


    /* =====================================================
       CLICK OUTSIDE
    ===================================================== */

    document.addEventListener(
        "click",
        function (event) {

            const profile =
                event.target.closest(
                    ".student-profile-dropdown"
                );

            const mobile =
                event.target.closest(
                    "#mobileNavigation"
                );

            const mobileButton =
                event.target.closest(
                    "#mobileMenuButton"
                );


            if (!profile) {
                closeProfile();
            }


            if (!mobile && !mobileButton) {
                closeMobile();
            }

        }
    );


    /* =====================================================
       ESCAPE
    ===================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key !== "Escape") {
                return;
            }

            closeProfile();

            closeMobile();

        }
    );


    /* =====================================================
       MOBILE LINKS
    ===================================================== */

    document.addEventListener(
        "click",
        function (event) {

            const link =
                event.target.closest(
                    "#mobileNavigation a"
                );

            if (!link) {
                return;
            }

            closeMobile();

        }
    );


    /* =====================================================
       RESIZE
    ===================================================== */

    window.addEventListener(
        "resize",
        function () {

            if (window.innerWidth > 850) {
                closeMobile();
            }

        }
    );

})();


(function () {

    const toggle = document.getElementById("themeToggle");
    const icon = document.getElementById("themeIcon");

    if (!toggle || !icon) {
        return;
    }

    const savedTheme =
        localStorage.getItem("student-theme") || "day";

    applyTheme(savedTheme);


    toggle.addEventListener("click", function () {

        const currentTheme =
            document.documentElement.classList.contains("night-mode")
                ? "night"
                : "day";

        const newTheme =
            currentTheme === "night"
                ? "day"
                : "night";

        applyTheme(newTheme);

        localStorage.setItem(
            "student-theme",
            newTheme
        );

    });


    function applyTheme(theme) {

        if (theme === "night") {

            document.documentElement.classList.add(
                "night-mode"
            );

            icon.className =
                "bi bi-sun-fill";

            toggle.title =
                "Switch to Day Mode";

            toggle.setAttribute(
                "aria-label",
                "Switch to Day Mode"
            );

        } else {

            document.documentElement.classList.remove(
                "night-mode"
            );

            icon.className =
                "bi bi-moon-stars-fill";

            toggle.title =
                "Switch to Night Mode";

            toggle.setAttribute(
                "aria-label",
                "Switch to Night Mode"
            );

        }

    }

})();


</script>