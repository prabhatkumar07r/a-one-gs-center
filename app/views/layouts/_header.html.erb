<script nonce="<%= content_security_policy_nonce %>">

(function () {

    /* =====================================================
       STUDENT HEADER
       TURBO SAFE + DUPLICATE SAFE
    ===================================================== */

    if (window.studentHeaderInitialized) {
        return;
    }

    window.studentHeaderInitialized = true;


    /* =====================================================
       GET CURRENT ELEMENTS
    ===================================================== */

    function getElements() {

        return {
            profileButton:
                document.getElementById("studentProfileButton"),

            profileMenu:
                document.getElementById("studentProfileMenu"),

            mobileButton:
                document.getElementById("mobileMenuButton"),

            mobileNavigation:
                document.getElementById("mobileNavigation")
        };

    }


    /* =====================================================
       CLOSE PROFILE
    ===================================================== */

    function closeProfile() {

        const {
            profileButton,
            profileMenu
        } = getElements();

        if (!profileButton || !profileMenu) {
            return;
        }

        profileMenu.classList.remove("open");

        profileButton.classList.remove("active");

        profileButton.setAttribute(
            "aria-expanded",
            "false"
        );

    }


    /* =====================================================
       CLOSE MOBILE NAV
    ===================================================== */

    function closeMobile() {

        const {
            mobileButton,
            mobileNavigation
        } = getElements();

        if (!mobileButton || !mobileNavigation) {
            return;
        }

        mobileNavigation.classList.remove("open");

        mobileButton.classList.remove("active");

        mobileButton.setAttribute(
            "aria-expanded",
            "false"
        );

        mobileButton.setAttribute(
            "aria-label",
            "Open navigation menu"
        );

        const icon =
            mobileButton.querySelector("i");

        if (icon) {

            icon.className =
                "bi bi-list";

        }

    }


    /* =====================================================
       PROFILE BUTTON
    ===================================================== */

    document.addEventListener(
        "click",
        function (event) {

            const button =
                event.target.closest(
                    "#studentProfileButton"
                );

            if (!button) {
                return;
            }

            event.preventDefault();
            event.stopPropagation();

            const menu =
                document.getElementById(
                    "studentProfileMenu"
                );

            if (!menu) {
                return;
            }

            const isOpen =
                menu.classList.contains("open");

            closeMobile();

            if (isOpen) {

                closeProfile();

            } else {

                menu.classList.add("open");

                button.classList.add("active");

                button.setAttribute(
                    "aria-expanded",
                    "true"
                );

            }

        },
        true
    );


    /* =====================================================
       MOBILE MENU BUTTON
    ===================================================== */

    document.addEventListener(
        "click",
        function (event) {

            const button =
                event.target.closest(
                    "#mobileMenuButton"
                );

            if (!button) {
                return;
            }

            event.preventDefault();
            event.stopPropagation();

            const navigation =
                document.getElementById(
                    "mobileNavigation"
                );

            if (!navigation) {
                return;
            }

            const isOpen =
                navigation.classList.contains("open");

            closeProfile();

            if (isOpen) {

                closeMobile();

            } else {

                navigation.classList.add("open");

                button.classList.add("active");

                button.setAttribute(
                    "aria-expanded",
                    "true"
                );

                button.setAttribute(
                    "aria-label",
                    "Close navigation menu"
                );

                const icon =
                    button.querySelector("i");

                if (icon) {

                    icon.className =
                        "bi bi-x-lg";

                }

            }

        },
        true
    );


    /* =====================================================
       CLICK OUTSIDE
    ===================================================== */

    document.addEventListener(
        "click",
        function (event) {

            const profile =
                event.target.closest(
                    ".student-profile-dropdown"
                );

            const mobile =
                event.target.closest(
                    "#mobileNavigation"
                );

            const mobileButton =
                event.target.closest(
                    "#mobileMenuButton"
                );

            const themeToggle =
                event.target.closest(
                    "#themeToggle"
                );


            /*
             * Theme toggle is NOT treated as outside
             * header interaction.
             */

            if (!profile && !themeToggle) {
                closeProfile();
            }

            if (!mobile && !mobileButton && !themeToggle) {
                closeMobile();
            }

        }
    );


    /* =====================================================
       ESCAPE KEY
    ===================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key !== "Escape") {
                return;
            }

            closeProfile();

            closeMobile();

        }
    );


    /* =====================================================
       MOBILE NAVIGATION LINKS
    ===================================================== */

    document.addEventListener(
        "click",
        function (event) {

            const link =
                event.target.closest(
                    "#mobileNavigation a"
                );

            if (!link) {
                return;
            }

            closeMobile();

        }
    );


    /* =====================================================
       RESIZE
    ===================================================== */

    window.addEventListener(
        "resize",
        function () {

            if (window.innerWidth > 850) {

                closeMobile();

            }

        }
    );

})();


/* =========================================================
   DAY / NIGHT THEME
   TURBO SAFE + DELEGATED CLICK
========================================================= */

(function () {

    /* =====================================================
       APPLY THEME
    ===================================================== */

    function applyTheme(theme) {

        const isNight =
            theme === "night";

        document.documentElement.classList.toggle(
            "night-mode",
            isNight
        );


        const toggle =
            document.getElementById(
                "themeToggle"
            );

        const icon =
            document.getElementById(
                "themeIcon"
            );


        if (!toggle || !icon) {
            return;
        }


        /* =================================================
           NIGHT
        ================================================= */

        if (isNight) {

            icon.className =
                "bi bi-sun-fill";

            toggle.title =
                "Switch to Day Mode";

            toggle.setAttribute(
                "aria-label",
                "Switch to Day Mode"
            );

        }


        /* =================================================
           DAY
        ================================================= */

        else {

            icon.className =
                "bi bi-moon-stars-fill";

            toggle.title =
                "Switch to Night Mode";

            toggle.setAttribute(
                "aria-label",
                "Switch to Night Mode"
            );

        }

    }


    /* =====================================================
       INITIALIZE THEME
    ===================================================== */

    function initializeTheme() {

        let savedTheme =
            localStorage.getItem(
                "student-theme"
            );


        if (
            savedTheme !== "night" &&
            savedTheme !== "day"
        ) {

            savedTheme = "day";

        }


        applyTheme(savedTheme);

    }


    /* =====================================================
       INSTALL CLICK HANDLER ONLY ONCE
    ===================================================== */

    if (!window.studentThemeHandlerInitialized) {

        window.studentThemeHandlerInitialized = true;


        document.addEventListener(
            "click",
            function (event) {

                const toggle =
                    event.target.closest(
                        "#themeToggle"
                    );


                if (!toggle) {
                    return;
                }


                event.preventDefault();

                event.stopPropagation();


                const currentTheme =
                    document.documentElement.classList.contains(
                        "night-mode"
                    )
                        ? "night"
                        : "day";


                const newTheme =
                    currentTheme === "night"
                        ? "day"
                        : "night";


                applyTheme(newTheme);


                localStorage.setItem(
                    "student-theme",
                    newTheme
                );

            },
            true
        );

    }


    /* =====================================================
       TURBO PAGE LOAD
    ===================================================== */

    document.addEventListener(
        "turbo:load",
        initializeTheme
    );


    /* =====================================================
       INITIAL PAGE LOAD
    ===================================================== */

    initializeTheme();

})();

</script>