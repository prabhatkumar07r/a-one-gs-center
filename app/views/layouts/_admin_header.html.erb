<style>
/* =========================================================
   ADMIN HEADER
========================================================= */

.admin-navbar {
  position: fixed;

  top: 0;
  right: 0;
  left: 260px;

  width: auto;
  height: 80px;

  display: flex !important;
  align-items: center;
  justify-content: space-between;

  padding: 0 30px;

  /* Transparent Glass Header */
  background: rgba(15, 23, 42, 0.72);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  border-bottom: 1px solid rgba(255, 255, 255, 0.12);

  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);

  z-index: 9999;

  visibility: visible !important;
  opacity: 1 !important;
}


/* =========================================================
   LEFT SIDE
========================================================= */

.admin-navbar-left {
  display: flex;
  align-items: center;

  min-width: 0;
}

.admin-navbar-left h4 {
  margin: 0;

  color: #ffffff !important;

  font-size: 20px;
  font-weight: 700;

  white-space: nowrap;

  overflow: hidden;
  text-overflow: ellipsis;
}


/* =========================================================
   MOBILE MENU BUTTON
========================================================= */

.admin-mobile-menu {
  display: none;

  width: 42px;
  height: 42px;

  align-items: center;
  justify-content: center;

  padding: 0;

  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;

  background: rgba(255, 255, 255, 0.10);

  color: #ffffff;

  cursor: pointer;

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  transition: all 0.25s ease;
}

.admin-mobile-menu:hover {
  background: rgba(255, 255, 255, 0.18);

  transform: scale(1.05);
}

.admin-mobile-menu i {
  font-size: 19px;
}


/* =========================================================
   RIGHT SIDE
========================================================= */

.admin-navbar-right {
  display: flex;
  align-items: center;

  gap: 12px;

  flex-shrink: 0;
}


/* =========================================================
   SEARCH
========================================================= */

.admin-search {
  width: 250px;
  height: 42px;

  display: flex;
  align-items: center;

  background: rgba(255, 255, 255, 0.08);

  border: 1px solid rgba(255, 255, 255, 0.12);

  border-radius: 12px;

  padding: 0 14px;

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  transition: all 0.2s ease;
}

.admin-search:focus-within {
  background: rgba(255, 255, 255, 0.14);

  border-color: rgba(255, 255, 255, 0.25);

  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.06);
}

.admin-search i {
  margin-right: 10px;

  color: rgba(255, 255, 255, 0.65);

  font-size: 14px;

  flex-shrink: 0;
}

.admin-search input {
  width: 100%;

  border: none;
  outline: none;

  background: transparent;

  color: #ffffff;

  font-size: 14px;
}

.admin-search input::placeholder {
  color: rgba(255, 255, 255, 0.55);
}


/* =========================================================
   NOTIFICATION
========================================================= */

.admin-notification {
  position: relative;

  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 12px;

  cursor: pointer;

  background: rgba(255, 255, 255, 0.07);

  border: 1px solid rgba(255, 255, 255, 0.10);

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  transition: all 0.2s ease;

  flex-shrink: 0;
}

.admin-notification:hover {
  background: rgba(255, 255, 255, 0.15);

  transform: scale(1.04);
}

.admin-notification i {
  color: #ffffff;

  font-size: 18px;
}


/* =========================================================
   NOTIFICATION BADGE
========================================================= */

.notification-badge {
  position: absolute;

  top: -2px;
  right: -2px;

  min-width: 17px;
  height: 17px;

  padding: 0 4px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #ef4444;

  color: #ffffff;

  border: 2px solid #0f172a;

  border-radius: 50%;

  font-size: 9px;
  font-weight: 700;

  line-height: 1;
}


/* =========================================================
   PROFILE WRAPPER
========================================================= */

.admin-profile-wrapper {
  position: relative;
}


/* =========================================================
   PROFILE BUTTON
========================================================= */

.admin-profile {
  display: flex;
  align-items: center;

  gap: 10px;

  min-height: 52px;

  padding: 5px 9px 5px 6px;

  border: 1px solid transparent;

  border-radius: 12px;

  background: transparent;

  color: #ffffff;

  cursor: pointer;

  transition: all 0.2s ease;
}

.admin-profile:hover {
  background: rgba(255, 255, 255, 0.08);

  border-color: rgba(255, 255, 255, 0.12);
}

.admin-profile:focus {
  outline: none;

  background: rgba(255, 255, 255, 0.10);

  border-color: rgba(255, 255, 255, 0.18);

  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.06);
}

.admin-profile::after {
  margin-left: 3px;

  color: rgba(255, 255, 255, 0.65);
}


/* =========================================================
   AVATAR
========================================================= */

.admin-avatar {
  width: 42px;
  height: 42px;

  min-width: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.12);

  color: #ffffff;

  font-size: 17px;

  border: 1px solid rgba(255, 255, 255, 0.14);
}

.admin-avatar-image {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}

.admin-avatar i {
  font-size: 18px;
}


/* =========================================================
   USER INFORMATION
========================================================= */

.admin-user-info {
  min-width: 0;

  display: flex;
  flex-direction: column;

  align-items: flex-start;

  line-height: 1.2;
}

.admin-user-name {
  max-width: 130px;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;

  color: #ffffff !important;

  font-size: 14px;
  font-weight: 600;
}

.admin-user-info small {
  margin-top: 3px;

  color: rgba(255, 255, 255, 0.60);

  font-size: 11px;

  white-space: nowrap;
}


/* =========================================================
   DROPDOWN
========================================================= */

.admin-dropdown {
  min-width: 220px;

  margin-top: 8px !important;

  padding: 8px;

  border: 1px solid #e9ecef;

  border-radius: 12px;

  background: rgba(255, 255, 255, 0.98);

  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.18);

  overflow: hidden;

  z-index: 10000;
}


/* =========================================================
   DROPDOWN ITEMS
========================================================= */

.admin-dropdown .dropdown-item {
  display: flex;
  align-items: center;

  gap: 12px;

  width: 100%;

  padding: 11px 12px;

  border-radius: 8px;

  color: #343a40;

  font-size: 14px;

  transition: all 0.2s ease;
}

.admin-dropdown .dropdown-item i {
  width: 18px;

  flex-shrink: 0;

  color: #6c757d;

  text-align: center;
}

.admin-dropdown .dropdown-item:hover {
  background: #f4f6f8;

  color: #4f46e5;
}

.admin-dropdown .dropdown-item:hover i {
  color: #4f46e5;
}


/* =========================================================
   DIVIDER
========================================================= */

.admin-dropdown .dropdown-divider {
  margin: 7px 4px;

  border-color: #e9ecef;
}


/* =========================================================
   LOGOUT
========================================================= */

.admin-dropdown .logout-item {
  color: #dc3545;
}

.admin-dropdown .logout-item i {
  color: #dc3545;
}

.admin-dropdown .logout-item:hover {
  background: #fff1f2;

  color: #dc3545;
}

.admin-dropdown .logout-item:hover i {
  color: #dc3545;
}


/* =========================================================
   LOGOUT FORM
========================================================= */

.admin-dropdown form {
  margin: 0;
}

.admin-dropdown form .dropdown-item {
  border: none;

  background: transparent;

  text-align: left;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1100px) {

  .admin-navbar {
    padding: 0 20px;
  }

  .admin-navbar-right {
    gap: 8px;
  }

  .admin-search {
    width: 210px;
  }

  .admin-user-name {
    max-width: 100px;
  }
}


/* =========================================================
   SMALL TABLET
========================================================= */

@media (max-width: 850px) {

  .admin-navbar {
    height: 72px;

    padding: 0 15px;
  }

  .admin-navbar-left h4 {
    font-size: 18px;
  }

  .admin-navbar-right {
    gap: 6px;
  }

  .admin-search {
    width: 180px;
  }

  .admin-user-info {
    display: none;
  }

  .admin-profile {
    min-height: auto;

    padding: 4px;
  }

  .admin-profile::after {
    display: none;
  }

  .admin-avatar {
    width: 40px;
    height: 40px;

    min-width: 40px;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

  .admin-navbar {
    position: fixed;

    top: 0;
    left: 0;
    right: 0;

    width: 100%;
    height: 68px;

    padding: 0 12px;

    background: rgba(15, 23, 42, 0.78);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    border-bottom: 1px solid rgba(255, 255, 255, 0.12);

    z-index: 9999;
  }


  /* =======================================================
     MOBILE MENU
  ======================================================== */

  .admin-mobile-menu {
    position: absolute;

    left: 12px;
    top: 50%;

    display: flex;

    transform: translateY(-50%);
  }

  .admin-mobile-menu:hover {
    transform: translateY(-50%) scale(1.05);
  }


  /* =======================================================
     LEFT
  ======================================================== */

  .admin-navbar-left {
    flex: 1;

    min-width: 0;

    padding-left: 55px;
  }

  .admin-navbar-left h4 {
    max-width: 150px;

    font-size: 17px;

    color: #ffffff !important;
  }


  /* =======================================================
     RIGHT
  ======================================================== */

  .admin-navbar-right {
    gap: 5px;

    flex-shrink: 0;
  }


  /* =======================================================
     SEARCH
  ======================================================== */

  .admin-search {
    display: none;
  }


  /* =======================================================
     NOTIFICATION
  ======================================================== */

  .admin-notification {
    width: 38px;
    height: 38px;
  }

  .admin-notification i {
    font-size: 17px;
  }


  /* =======================================================
     BADGE
  ======================================================== */

  .notification-badge {
    top: 0;
    right: 0;

    min-width: 16px;
    height: 16px;

    font-size: 8px;
  }


  /* =======================================================
     PROFILE
  ======================================================== */

  .admin-profile {
    width: 40px;
    height: 40px;

    min-height: 40px;

    padding: 2px;

    justify-content: center;
  }

  .admin-avatar {
    width: 36px;
    height: 36px;

    min-width: 36px;
  }


  /* =======================================================
     DROPDOWN
  ======================================================== */

  .admin-dropdown {
    position: absolute;

    top: 100%;
    right: 0;

    min-width: 210px;

    max-width: calc(100vw - 24px);

    margin-top: 8px !important;
  }
}


/* =========================================================
   VERY SMALL MOBILE
========================================================= */

@media (max-width: 400px) {

  .admin-navbar {
    padding: 0 9px;
  }

  .admin-navbar-left {
    padding-left: 52px;
  }

  .admin-navbar-left h4 {
    max-width: 125px;

    font-size: 15px;
  }

  .admin-navbar-right {
    gap: 2px;
  }

  .admin-mobile-menu {
    left: 9px;
  }

  .admin-notification {
    width: 36px;
    height: 36px;
  }

  .admin-profile {
    width: 38px;
    height: 38px;
  }

  .admin-avatar {
    width: 34px;
    height: 34px;

    min-width: 34px;
  }

  .admin-dropdown {
    right: -3px;

    width: 205px;
  }
}

</style>


<!-- =========================================================
     ADMIN NAVBAR
========================================================= -->

<nav class="admin-navbar">


  <!-- =======================================================
       MOBILE MENU BUTTON
  ======================================================== -->

  <button
    type="button"
    class="admin-mobile-menu"
    id="adminMobileMenuButton"
    aria-label="Toggle menu"
    aria-expanded="false">

    <i class="fas fa-bars"></i>

  </button>


  <!-- =======================================================
       LEFT
  ======================================================== -->

  <div class="admin-navbar-left">

    <h4 class="mb-0 fw-bold">

      <% if controller_path.start_with?("admin/settings") %>

        Settings

      <% elsif controller_path.start_with?("admin/profile") %>

        Profile

      <% else %>

        Dashboard

      <% end %>

    </h4>

  </div>


  <!-- =======================================================
       RIGHT
  ======================================================== -->

  <div class="admin-navbar-right">


    <!-- =====================================================
         SEARCH
    ====================================================== -->

    <form class="admin-search">

      <i class="fas fa-search"></i>

      <input
        type="text"
        placeholder="Search..."
        aria-label="Search">

    </form>


    <!-- =====================================================
         NOTIFICATION
    ====================================================== -->

    <div
      class="admin-notification"
      role="button"
      aria-label="Notifications">

      <i class="fas fa-bell"></i>

      <span class="notification-badge">
        5
      </span>

    </div>


    <!-- =====================================================
         PROFILE
    ====================================================== -->

    <% if user_signed_in? %>

      <div class="dropdown admin-profile-wrapper">

        <button
          class="admin-profile dropdown-toggle"
          type="button"
          data-bs-toggle="dropdown"
          data-bs-auto-close="outside"
          aria-expanded="false">

          <!-- Avatar -->

          <div class="admin-avatar">

            <% if current_user.image.attached? %>

              <%= image_tag current_user.image,
                  class: "admin-avatar-image",
                  alt: current_user.name %>

            <% else %>

              <i class="fas fa-user"></i>

            <% end %>

          </div>


          <!-- User Information -->

          <div class="admin-user-info">

            <span class="admin-user-name">
              <%= current_user.name %>
            </span>

            <small>
              Administrator
            </small>

          </div>

        </button>


        <!-- =================================================
             DROPDOWN MENU
        ================================================== -->

        <ul class="dropdown-menu dropdown-menu-end admin-dropdown">


          <!-- Profile -->

          <li>

            <%= link_to admin_profile_path,
                class: "dropdown-item" do %>

              <i class="fas fa-user-edit"></i>

              <span>
                Profile
              </span>

            <% end %>

          </li>


          <!-- Settings -->

          <li>

            <%= link_to admin_settings_path,
                class: "dropdown-item" do %>

              <i class="fas fa-cog"></i>

              <span>
                Settings
              </span>

            <% end %>

          </li>


          <!-- Divider -->

          <li>

            <hr class="dropdown-divider">

          </li>


          <!-- Logout -->

          <li>

            <%= button_to destroy_user_session_path,
                method: :delete,
                class: "dropdown-item logout-item" do %>

              <i class="fas fa-sign-out-alt"></i>

              <span>
                Logout
              </span>

            <% end %>

          </li>

        </ul>

      </div>

    <% end %>

  </div>

</nav>