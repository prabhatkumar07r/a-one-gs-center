<style>
/* =========================================================
   ADMIN SIDEBAR
========================================================= */

.admin-sidebar {
  position: fixed;
  top: 0;
  left: 0;

  width: 260px;
  height: 100dvh;

  background: blueviolet;

  border-right: 1px solid rgba(255, 255, 255, 0.25);

  box-shadow: 4px 0 20px rgba(0, 0, 0, 0.12);

  z-index: 3000;

  overflow-y: auto;
  overflow-x: hidden;

  transition: transform 0.3s ease, width 0.3s ease;
}


/* =========================================================
   SCROLLBAR
========================================================= */

.admin-sidebar::-webkit-scrollbar {
  width: 5px;
}

.admin-sidebar::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.35);
  border-radius: 10px;
}

.admin-sidebar::-webkit-scrollbar-track {
  background: transparent;
}


/* =========================================================
   LOGO AREA
========================================================= */

.sidebar-logo {
  min-height: 90px;

  display: flex;
  align-items: center;

  gap: 12px;

  padding: 18px 18px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.25);

  box-sizing: border-box;
}

.sidebar-logo-img {
  width: 48px;
  height: 48px;

  object-fit: contain;

  flex: 0 0 48px;

  border-radius: 10px;

  background: #ffffff;
}

.sidebar-title {
  min-width: 0;
  flex: 1;

  overflow: hidden;
}

.sidebar-title h3 {
  margin: 0;

  color: #ffffff;

  font-size: 15px;
  font-weight: 900;

  line-height: 1.3;

  white-space: normal;
  word-break: normal;
}

.sidebar-title small {
  display: block;

  margin-top: 4px;

  color: #fff200;

  font-size: 11px;
  font-weight: 600;

  white-space: nowrap;
}


/* =========================================================
   NAVIGATION
========================================================= */

.admin-sidebar > .nav {
  padding: 15px 12px 30px;

  margin: 0;
}

.admin-sidebar .nav > li {
  margin-bottom: 5px;
}


/* =========================================================
   MAIN NAV LINK
========================================================= */

.admin-sidebar .nav-link {
  position: relative;

  display: flex;
  align-items: center;

  gap: 12px;

  width: 100%;

  min-height: 44px;

  padding: 10px 13px;

  border-radius: 9px;

  color: #ffffff;

  text-decoration: none;

  font-size: 14px;
  font-weight: 700;

  box-sizing: border-box;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.admin-sidebar .nav-link span {
  min-width: 0;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;
}

.admin-sidebar .nav-link i:first-child {
  width: 20px;

  flex: 0 0 20px;

  text-align: center;

  font-size: 16px;

  color: #ffffff;

  transition: color 0.2s ease;
}


/* =========================================================
   CHEVRON
========================================================= */

.admin-sidebar .nav-link .fa-chevron-down {
  margin-left: auto;

  width: auto !important;

  flex: 0 0 auto;

  font-size: 10px !important;

  color: rgba(255, 255, 255, 0.65) !important;

  transition: transform 0.25s ease;
}


/* =========================================================
   HOVER
========================================================= */

.admin-sidebar .nav-link:hover {
  background: rgba(255, 255, 255, 0.14);

  color: #ffffff;

  transform: translateX(2px);
}

.admin-sidebar .nav-link:hover i:first-child {
  color: #ffffff;
}


/* =========================================================
   ACTIVE LINK
========================================================= */

.admin-sidebar .nav-link.active,
.admin-sidebar .nav-link.parent-active {
  background: rgba(255, 255, 255, 0.20);

  color: #ffffff;
}

.admin-sidebar .nav-link.active i:first-child,
.admin-sidebar .nav-link.parent-active i:first-child {
  color: #ffffff;
}


/* =========================================================
   OPEN CHEVRON
========================================================= */

.admin-sidebar .nav-link[aria-expanded="true"] .fa-chevron-down {
  transform: rotate(180deg);
}


/* =========================================================
   SUBMENU
========================================================= */

.admin-sidebar .collapse {
  padding: 4px 0 6px 20px;
}

.admin-sidebar .submenu {
  position: relative;

  display: flex;
  align-items: center;

  width: 100%;

  min-height: 40px;

  padding: 8px 12px 8px 35px;

  box-sizing: border-box;

  color: rgba(255, 255, 255, 0.90);

  text-decoration: none;

  border-radius: 8px;

  font-size: 13px;
  font-weight: 600;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    padding-left 0.2s ease;
}

.admin-sidebar .submenu::before {
  content: "";

  position: absolute;

  left: 18px;

  width: 5px;
  height: 5px;

  background: rgba(255, 255, 255, 0.55);

  border-radius: 50%;
}

.admin-sidebar .submenu:hover {
  background: rgba(255, 255, 255, 0.13);

  color: #ffffff;

  padding-left: 39px;
}

.admin-sidebar .submenu:hover::before {
  background: #ffffff;
}


/* =========================================================
   ACTIVE SUBMENU
========================================================= */

.admin-sidebar .submenu.active {
  background: rgba(255, 255, 255, 0.20);

  color: #ffffff;

  font-weight: 700;
}

.admin-sidebar .submenu.active::before {
  background: #ffffff;
}


/* =========================================================
   SUBMENU ICON
========================================================= */

.admin-sidebar .submenu i {
  width: 18px;

  margin-right: 8px;

  text-align: center;
}


/* =========================================================
   MOBILE OVERLAY
========================================================= */

.admin-sidebar-overlay {
  display: none;

  position: fixed;

  inset: 0;

  background: rgba(15, 23, 42, 0.55);

  backdrop-filter: blur(2px);

  z-index: 2990;
}

.admin-sidebar-overlay.show {
  display: block;
}


/* =========================================================
   MOBILE MENU BUTTON
========================================================= */

.admin-sidebar-toggle {
  display: none;

  position: fixed;

  top: 15px;
  left: 15px;

  width: 42px;
  height: 42px;

  align-items: center;
  justify-content: center;

  padding: 0;

  border: 1px solid #e5e7eb;

  border-radius: 9px;

  background: #ffffff;

  color: #374151;

  cursor: pointer;

  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.10);

  z-index: 3100;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.admin-sidebar-toggle:hover {
  background: #f5f7fb;

  color: #4f46e5;

  transform: translateY(-1px);
}

.admin-sidebar-toggle i {
  font-size: 18px;
}


/* =========================================================
   CLOSE BUTTON
========================================================= */

.admin-sidebar-close {
  display: none;

  position: absolute;

  top: 18px;
  right: 14px;

  width: 35px;
  height: 35px;

  align-items: center;
  justify-content: center;

  padding: 0;

  border: 0;

  border-radius: 8px;

  background: rgba(255, 255, 255, 0.15);

  color: #ffffff;

  cursor: pointer;

  z-index: 3101;

  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.admin-sidebar-close:hover {
  background: rgba(255, 255, 255, 0.25);

  color: #ffffff;
}


/* =========================================================
   TABLET / MOBILE
========================================================= */

@media (max-width: 991px) {

  .admin-sidebar {
    width: 280px;

    max-width: calc(100vw - 45px);

    transform: translateX(-105%);
  }

  .admin-sidebar.mobile-open {
    transform: translateX(0);
  }

  .admin-sidebar-toggle {
    display: flex;
  }

  .admin-sidebar-close {
    display: flex;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .admin-sidebar {
    width: min(290px, 86vw);

    max-width: 86vw;
  }

  .sidebar-logo {
    min-height: 82px;

    padding: 16px;
  }

  .sidebar-logo-img {
    width: 44px;
    height: 44px;

    flex-basis: 44px;
  }

  .sidebar-title h3 {
    font-size: 14px;
  }

  .sidebar-title small {
    font-size: 10px;
  }

  .admin-sidebar .nav {
    padding: 12px 10px 25px;
  }

  .admin-sidebar .nav-link {
    min-height: 46px;

    padding: 11px 12px;

    font-size: 14px;
  }

  .admin-sidebar .submenu {
    min-height: 42px;

    padding-top: 10px;
    padding-bottom: 10px;
  }

}


/* =========================================================
   VERY SMALL MOBILE
========================================================= */

@media (max-width: 360px) {

  .admin-sidebar {
    width: 88vw;

    max-width: 88vw;
  }

  .sidebar-logo {
    padding: 15px;
  }

  .sidebar-logo-img {
    width: 42px;
    height: 42px;

    flex-basis: 42px;
  }

  .sidebar-title h3 {
    font-size: 13px;
  }

  .admin-sidebar .nav-link {
    font-size: 13px;
  }

}
</style>


<!-- =========================================================
     MOBILE TOGGLE
========================================================= -->

<button
  type="button"
  class="admin-sidebar-toggle"
  id="adminSidebarToggle"
  aria-label="Open admin menu">

  <i class="fas fa-bars"></i>

</button>


<!-- =========================================================
     OVERLAY
========================================================= -->

<div
  class="admin-sidebar-overlay"
  id="adminSidebarOverlay">
</div>


<!-- =========================================================
     SIDEBAR
========================================================= -->

<div
  class="admin-sidebar"
  id="adminSidebar">


  <!-- =======================================================
       CLOSE BUTTON
  ======================================================== -->

  <button
    type="button"
    class="admin-sidebar-close"
    id="adminSidebarClose"
    aria-label="Close menu">

    <i class="fas fa-times"></i>

  </button>


  <!-- =======================================================
       LOGO
  ======================================================== -->

  <div class="sidebar-logo">

    <%= image_tag "logo.jpeg",
        class: "sidebar-logo-img",
        alt: "A One GS Center" %>

    <div class="sidebar-title">

      <h3>
        A ONE GS CENTER
      </h3>

      <small>
        Admin Panel
      </small>

    </div>

  </div>


  <!-- =======================================================
       NAVIGATION
  ======================================================== -->

  <ul class="nav flex-column">


    <!-- =====================================================
         DASHBOARD
    ====================================================== -->

    <li>

      <%= link_to dashboard_path,
          class: "nav-link #{'active' if controller_path == 'admin/dashboard'}" do %>

        <i class="fas fa-home"></i>

        <span>Dashboard</span>

      <% end %>

    </li>


    <!-- =====================================================
         STUDENT MANAGEMENT
    ====================================================== -->

    <li>

      <a
        class="nav-link #{'parent-active' if controller_path.start_with?('admin/students') || controller_path.start_with?('admin/enrollments') || controller_path.start_with?('admin/attendances') || controller_path.start_with?('admin/fees')}"
        data-bs-toggle="collapse"
        href="#studentMenu"
        role="button"
        aria-expanded="true"
        aria-controls="studentMenu">

        <i class="fas fa-user-graduate"></i>

        <span>Student Management</span>

        <i class="fas fa-chevron-down"></i>

      </a>

      <div
        class="collapse show"
        id="studentMenu">

        <%= link_to students_path,
            class: "submenu #{'active' if controller_path == 'admin/students'}" do %>

          Students

        <% end %>

        <%= link_to enrollments_path,
            class: "submenu #{'active' if controller_path == 'admin/enrollments'}" do %>

          Enrollments

        <% end %>

        <%= link_to attendances_path,
            class: "submenu #{'active' if controller_path == 'admin/attendances'}" do %>

          Attendance

        <% end %>

        <%= link_to fees_path,
            class: "submenu #{'active' if controller_path == 'admin/fees'}" do %>

          Fees

        <% end %>

      </div>

    </li>


    <!-- =====================================================
         ACADEMIC
    ====================================================== -->

    <li>

      <a
        class="nav-link #{'parent-active' if controller_path.start_with?('admin/teachers') || controller_path.start_with?('admin/courses') || controller_path.start_with?('admin/batches') || controller_path.start_with?('admin/study_notes')}"
        data-bs-toggle="collapse"
        href="#academicMenu"
        role="button"
        aria-expanded="false"
        aria-controls="academicMenu">

        <i class="fas fa-book"></i>

        <span>Academic</span>

        <i class="fas fa-chevron-down"></i>

      </a>

      <div
        class="collapse"
        id="academicMenu">

        <%= link_to teachers_path,
            class: "submenu #{'active' if controller_path == 'admin/teachers'}" do %>

          Teachers

        <% end %>

        <%= link_to courses_path,
            class: "submenu #{'active' if controller_path == 'admin/courses'}" do %>

          Courses

        <% end %>

        <%= link_to batches_path,
            class: "submenu #{'active' if controller_path == 'admin/batches'}" do %>

          Batches

        <% end %>

        <%= link_to study_notes_path,
            class: "submenu #{'active' if controller_path == 'admin/study_notes'}" do %>

          <i class="fas fa-file-pdf me-2"></i>

          Study Notes

        <% end %>

      </div>

    </li>


    <!-- =====================================================
         WEBSITE
    ====================================================== -->

    <li>

      <a
        class="nav-link #{'parent-active' if controller_path.start_with?('admin/galleries') || controller_path.start_with?('admin/achievements') || controller_path.start_with?('admin/notifications') || controller_path.start_with?('admin/demos')}"
        data-bs-toggle="collapse"
        href="#websiteMenu"
        role="button"
        aria-expanded="false"
        aria-controls="websiteMenu">

        <i class="fas fa-globe"></i>

        <span>Website</span>

        <i class="fas fa-chevron-down"></i>

      </a>

      <div
        class="collapse"
        id="websiteMenu">

        <%= link_to galleries_path,
            class: "submenu #{'active' if controller_path == 'admin/galleries'}" do %>

          Gallery

        <% end %>

        <%= link_to achievements_path,
            class: "submenu #{'active' if controller_path == 'admin/achievements'}" do %>

          Achievements

        <% end %>

        <%= link_to notifications_path,
            class: "submenu #{'active' if controller_path == 'admin/notifications'}" do %>

          Notifications

        <% end %>

        <%= link_to demos_path,
            class: "submenu #{'active' if controller_path == 'admin/demos'}" do %>

          Demo Requests

        <% end %>

      </div>

    </li>

  </ul>

</div>


<!-- =========================================================
     MOBILE SIDEBAR SCRIPT
========================================================= -->

<script>

(function () {

  function initAdminSidebar() {

    const sidebar =
      document.getElementById("adminSidebar");

    const toggle =
      document.getElementById("adminSidebarToggle");

    const close =
      document.getElementById("adminSidebarClose");

    const overlay =
      document.getElementById("adminSidebarOverlay");


    if (!sidebar || !toggle || !close || !overlay) {
      return;
    }


    /* Prevent duplicate initialization */
    if (sidebar.dataset.initialized === "true") {
      return;
    }

    sidebar.dataset.initialized = "true";


    /* =======================================================
       OPEN
    ======================================================== */

    function openSidebar() {

      sidebar.classList.add("mobile-open");

      overlay.classList.add("show");

      document.body.style.overflow = "hidden";

    }


    /* =======================================================
       CLOSE
    ======================================================== */

    function closeSidebar() {

      sidebar.classList.remove("mobile-open");

      overlay.classList.remove("show");

      document.body.style.overflow = "";

    }


    /* =======================================================
       TOGGLE
    ======================================================== */

    toggle.addEventListener("click", function () {

      if (
        sidebar.classList.contains("mobile-open")
      ) {

        closeSidebar();

      } else {

        openSidebar();

      }

    });


    /* =======================================================
       CLOSE BUTTON
    ======================================================== */

    close.addEventListener("click", function () {

      closeSidebar();

    });


    /* =======================================================
       OVERLAY
    ======================================================== */

    overlay.addEventListener("click", function () {

      closeSidebar();

    });


    /* =======================================================
       CLOSE AFTER SUBMENU CLICK
    ======================================================== */

    sidebar
      .querySelectorAll("a.submenu")
      .forEach(function (link) {

        link.addEventListener("click", function () {

          if (window.innerWidth <= 991) {

            closeSidebar();

          }

        });

      });


    /* =======================================================
       ESCAPE KEY
    ======================================================== */

    document.addEventListener("keydown", function (event) {

      if (
        event.key === "Escape" &&
        sidebar.classList.contains("mobile-open")
      ) {

        closeSidebar();

      }

    });


    /* =======================================================
       RESIZE
    ======================================================== */

    window.addEventListener("resize", function () {

      if (window.innerWidth > 991) {

        closeSidebar();

      }

    });

  }


  /* ===========================================================
     TURBO
  ============================================================ */

  document.addEventListener(
    "turbo:load",
    initAdminSidebar
  );


  /* ===========================================================
     NORMAL PAGE LOAD
  ============================================================ */

  document.addEventListener(
    "DOMContentLoaded",
    initAdminSidebar
  );

})();

</script>