<style>

/* =========================================================
   ADMIN SIDEBAR
========================================================= */

.admin-sidebar,
.admin-sidebar * {
  box-sizing: border-box;
}


/* =========================================================
   SIDEBAR MAIN
========================================================= */

.admin-sidebar {
  position: fixed;

  top: 0;
  left: 0;

  width: 260px;
  height: 100dvh;

   background:
    linear-gradient(
      135deg,
      rgba(15, 23, 42, 0.92),
      rgba(30, 27, 75, 0.94)
    ) !

  backdrop-filter: blur(20px);

  border-right: 1px solid rgba(255,255,255,0.08);

  box-shadow:
    4px 0 30px rgba(0,0,0,0.25);

  overflow-y: auto;
  overflow-x: hidden;

  /*
     IMPORTANT:
     Keep sidebar below navbar.
  */
  z-index: 3000;

  transform: translateX(0);

  transition:
    transform .3s ease;
}


/* =========================================================
   SCROLLBAR
========================================================= */

.admin-sidebar::-webkit-scrollbar {
  width: 5px;
}

.admin-sidebar::-webkit-scrollbar-track {
  background: transparent;
}

.admin-sidebar::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.15);
  border-radius: 10px;
}


/* =========================================================
   OVERLAY
========================================================= */

.admin-sidebar-overlay {
  display: none;

  position: fixed;

  inset: 0;

  background: rgba(2,6,23,0.58);

  backdrop-filter: blur(3px);

  /*
     Below sidebar and navbar.
  */
  z-index: 2990;
}

.admin-sidebar-overlay.show {
  display: block;
}


/* =========================================================
   SIDEBAR HEADER
========================================================= */

.admin-sidebar-header {
  min-height: 80px;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 15px;

  border-bottom: 1px solid rgba(255,255,255,0.08);
}


/* =========================================================
   LOGO
========================================================= */

.admin-sidebar-logo {
  max-width: 100%;
  max-height: 55px;

  object-fit: contain;
}


/* =========================================================
   NAVIGATION
========================================================= */

.admin-sidebar .nav {
  padding: 15px 10px;
}

.admin-sidebar .nav-item {
  margin-bottom: 5px;
}


/* =========================================================
   NAV LINKS
========================================================= */

.admin-sidebar .nav-link {
  display: flex;

  align-items: center;

  width: 100%;

  min-height: 46px;

  padding: 11px 14px;

  border-radius: 10px;

  color: rgba(255,255,255,0.78);

  text-decoration: none;

  font-size: 14px;
  font-weight: 500;

  transition:
    background .2s ease,
    color .2s ease,
    transform .2s ease;
}

.admin-sidebar .nav-link:hover {
  color: #ffffff;

  background: rgba(255,255,255,0.08);

  transform: translateX(2px);
}

.admin-sidebar .nav-link.active {
  color: #ffffff;

  background:
    linear-gradient(
      135deg,
      rgba(99,102,241,0.35),
      rgba(79,70,229,0.25)
    );

  border: 1px solid rgba(129,140,248,0.15);
}


/* =========================================================
   ICON
========================================================= */

.admin-sidebar .nav-link i {
  width: 25px;

  margin-right: 10px;

  font-size: 17px;

  flex-shrink: 0;
}


/* =========================================================
   COLLAPSE ARROW
========================================================= */

.admin-sidebar .collapse-arrow {
  margin-left: auto;

  font-size: 12px;

  transition: transform .25s ease;
}

.admin-sidebar .nav-link[aria-expanded="true"] .collapse-arrow {
  transform: rotate(180deg);
}


/* =========================================================
   SUB MENU
========================================================= */

.admin-sidebar .submenu {
  padding-left: 15px;
}

.admin-sidebar .submenu .nav-link {
  min-height: 40px;

  padding: 9px 12px;

  font-size: 13px;

  color: rgba(255,255,255,0.65);
}

.admin-sidebar .submenu .nav-link:hover {
  color: #ffffff;
}


/* =========================================================
   MOBILE SIDEBAR
========================================================= */

@media (max-width: 991px) {

  .admin-sidebar {
    width: 280px;

    max-width: calc(100vw - 45px);

    /*
       Closed state.
    */
    transform: translateX(-105%);

    z-index: 3000;
  }

  .admin-sidebar.mobile-open {
    /*
       Open state.
    */
    transform: translateX(0);
  }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 600px) {

  .admin-sidebar {

    width: min(290px, 86vw);

    max-width: 86vw;
  }

  .admin-sidebar-header {
    min-height: 68px;

    padding: 10px;
  }

  .admin-sidebar .nav {
    padding: 12px 8px;
  }

  .admin-sidebar .nav-link {
    min-height: 44px;

    padding: 10px 12px;
  }

}

</style>


<!-- =========================================================
     MOBILE OVERLAY
========================================================= -->

<div
  class="admin-sidebar-overlay"
  id="adminSidebarOverlay">
</div>


<!-- =========================================================
     ADMIN SIDEBAR
========================================================= -->

<div
  class="admin-sidebar"
  id="adminSidebar">


  <!-- =======================================================
       SIDEBAR HEADER
  ======================================================== -->

  <div class="admin-sidebar-header">

    <%= image_tag "logo.jpeg",
        class: "admin-sidebar-logo",
        alt: "A One GS Center Admin" %>

  </div>


  <!-- =======================================================
       NAVIGATION
  ======================================================== -->

  <ul class="nav flex-column">


    <!-- =====================================================
         DASHBOARD
    ====================================================== -->

    <li class="nav-item">

      <%= link_to dashboard_path,
          class: "nav-link #{'active' if controller_path == 'dashboard'}" do %>

        <i class="bi bi-speedometer2"></i>

        <span>Dashboard</span>

      <% end %>

    </li>


    <!-- =====================================================
         STUDENT MANAGEMENT
    ====================================================== -->

    <li class="nav-item">

      <a
        href="#studentMenu"
        class="nav-link"
        data-bs-toggle="collapse"
        role="button"
        aria-expanded="<%= controller_path.start_with?('students', 'admin/enrollments', 'attendances', 'fees') %>"
        aria-controls="studentMenu">

        <i class="bi bi-people"></i>

        <span>Student Management</span>

        <i class="bi bi-chevron-down collapse-arrow"></i>

      </a>


      <div
        class="collapse <%= 'show' if controller_path.start_with?('students', 'admin/enrollments', 'attendances', 'fees') %>"
        id="studentMenu">

        <ul class="nav flex-column submenu">


          <!-- Students -->

          <li class="nav-item">

            <%= link_to students_path,
                class: "nav-link #{'active' if controller_path == 'students'}" do %>

              <i class="bi bi-person"></i>

              <span>Students</span>

            <% end %>

          </li>


          <!-- Enrollments -->

          <li class="nav-item">

            <%= link_to admin_enrollments_path,
                class: "nav-link #{'active' if controller_path == 'admin/enrollments'}" do %>

              <i class="bi bi-journal-check"></i>

              <span>Enrollments</span>

            <% end %>

          </li>


          <!-- Attendance -->

          <li class="nav-item">

            <%= link_to attendances_path,
                class: "nav-link #{'active' if controller_path == 'attendances'}" do %>

              <i class="bi bi-calendar-check"></i>

              <span>Attendance</span>

            <% end %>

          </li>


          <!-- Fees -->

          <li class="nav-item">

            <%= link_to fees_path,
                class: "nav-link #{'active' if controller_path == 'fees'}" do %>

              <i class="bi bi-cash-stack"></i>

              <span>Fees</span>

            <% end %>

          </li>


        </ul>

      </div>

    </li>


    <!-- =====================================================
         ACADEMIC
    ====================================================== -->

    <li class="nav-item">

      <a
        href="#academicMenu"
        class="nav-link"
        data-bs-toggle="collapse"
        role="button"
        aria-expanded="<%= controller_path.start_with?('teachers', 'admin/courses', 'batches', 'study_notes', 'admin/test_series') %>"
        aria-controls="academicMenu">

        <i class="bi bi-mortarboard"></i>

        <span>Academic</span>

        <i class="bi bi-chevron-down collapse-arrow"></i>

      </a>


      <div
        class="collapse <%= 'show' if controller_path.start_with?('teachers', 'admin/courses', 'batches', 'study_notes', 'admin/test_series') %>"
        id="academicMenu">

        <ul class="nav flex-column submenu">


          <!-- Teachers -->

          <li class="nav-item">

            <%= link_to teachers_path,
                class: "nav-link #{'active' if controller_path == 'teachers'}" do %>

              <i class="bi bi-person-badge"></i>

              <span>Teachers</span>

            <% end %>

          </li>


          <!-- Courses -->

          <li class="nav-item">

            <%= link_to admin_courses_path,
                class: "nav-link #{'active' if controller_path.start_with?('admin/courses')}" do %>

              <i class="bi bi-book"></i>

              <span>Courses</span>

            <% end %>

          </li>


          <!-- Test Series -->

          <li class="nav-item">

            <%= link_to admin_test_series_index_path,
                class: "nav-link #{'active' if controller_path.start_with?('admin/test_series')}" do %>

              <i class="bi bi-journal-check"></i>

              <span>Test Series</span>

            <% end %>

          </li>


          <!-- Batches -->

          <li class="nav-item">

            <%= link_to batches_path,
                class: "nav-link #{'active' if controller_path == 'batches'}" do %>

              <i class="bi bi-people-fill"></i>

              <span>Batches</span>

            <% end %>

          </li>


          <!-- Study Notes -->

          <li class="nav-item">

            <%= link_to study_notes_path,
                class: "nav-link #{'active' if controller_path == 'study_notes'}" do %>

              <i class="bi bi-file-earmark-pdf"></i>

              <span>Study Notes</span>

            <% end %>

          </li>


        </ul>

      </div>

    </li>


    <!-- =====================================================
         WEBSITE
    ====================================================== -->

    <li class="nav-item">

      <a
        href="#websiteMenu"
        class="nav-link"
        data-bs-toggle="collapse"
        role="button"
        aria-expanded="<%= controller_path.start_with?('galleries', 'achievements', 'notifications', 'demos') %>"
        aria-controls="websiteMenu">

        <i class="bi bi-globe"></i>

        <span>Website</span>

        <i class="bi bi-chevron-down collapse-arrow"></i>

      </a>


      <div
        class="collapse <%= 'show' if controller_path.start_with?('galleries', 'achievements', 'notifications', 'demos') %>"
        id="websiteMenu">

        <ul class="nav flex-column submenu">


          <!-- Gallery -->

          <li class="nav-item">

            <%= link_to galleries_path,
                class: "nav-link #{'active' if controller_path == 'galleries'}" do %>

              <i class="bi bi-images"></i>

              <span>Gallery</span>

            <% end %>

          </li>


          <!-- Achievements -->

          <li class="nav-item">

            <%= link_to achievements_path,
                class: "nav-link #{'active' if controller_path == 'achievements'}" do %>

              <i class="bi bi-trophy"></i>

              <span>Achievements</span>

            <% end %>

          </li>


          <!-- Notifications -->

          <li class="nav-item">

            <%= link_to notifications_path,
                class: "nav-link #{'active' if controller_path == 'notifications'}" do %>

              <i class="bi bi-bell"></i>

              <span>Notifications</span>

            <% end %>

          </li>


          <!-- Demo Requests -->

          <li class="nav-item">

            <%= link_to demos_path,
                class: "nav-link #{'active' if controller_path == 'demos'}" do %>

              <i class="bi bi-camera-video"></i>

              <span>Demo Requests</span>

            <% end %>

          </li>


        </ul>

      </div>

    </li>


  </ul>

</div>

<!-- =========================================================
     SIDEBAR JAVASCRIPT
========================================================= -->

<script>

(function () {

  function initAdminSidebar() {

    const sidebar =
      document.getElementById("adminSidebar");

    const toggle =
      document.getElementById("adminMobileMenuButton");

    const overlay =
      document.getElementById("adminSidebarOverlay");

    const close =
      document.getElementById("adminSidebarClose");


    /*
       Make sure all required elements exist.
    */

    if (!sidebar || !toggle || !overlay) {
      return;
    }


    /*
       Prevent duplicate event listeners.
    */

    if (sidebar.dataset.initialized === "true") {
      return;
    }

    sidebar.dataset.initialized = "true";


    /* =====================================================
       UPDATE MENU ICON
    ====================================================== */

    function updateMenuIcon(open) {

      const icon =
        toggle.querySelector(".menu-icon");

      if (!icon) {
        return;
      }


      if (open) {

        icon.textContent = "✕";

        toggle.setAttribute(
          "aria-label",
          "Close admin menu"
        );

        toggle.setAttribute(
          "aria-expanded",
          "true"
        );

      } else {

        icon.textContent = "☰";

        toggle.setAttribute(
          "aria-label",
          "Open admin menu"
        );

        toggle.setAttribute(
          "aria-expanded",
          "false"
        );

      }

    }


    /* =====================================================
       OPEN SIDEBAR
    ====================================================== */

    function openSidebar() {

      sidebar.classList.add(
        "mobile-open"
      );

      overlay.classList.add(
        "show"
      );

      updateMenuIcon(true);

      document.body.style.overflow =
        "hidden";
    }


    /* =====================================================
       CLOSE SIDEBAR
    ====================================================== */

    function closeSidebar() {

      sidebar.classList.remove(
        "mobile-open"
      );

      overlay.classList.remove(
        "show"
      );

      updateMenuIcon(false);

      document.body.style.overflow =
        "";
    }


    /* =====================================================
       HAMBURGER CLICK
    ====================================================== */

    toggle.addEventListener(
      "click",
      function (event) {

        event.preventDefault();
        event.stopPropagation();

        const isOpen =
          sidebar.classList.contains(
            "mobile-open"
          );


        if (isOpen) {

          closeSidebar();

        } else {

          openSidebar();

        }

      }
    );


    /* =====================================================
       OPTIONAL CLOSE BUTTON
    ====================================================== */

    if (close) {

      close.addEventListener(
        "click",
        closeSidebar
      );

    }


    /* =====================================================
       OVERLAY CLICK
    ====================================================== */

    overlay.addEventListener(
      "click",
      closeSidebar
    );


    /* =====================================================
       ESCAPE KEY
    ====================================================== */

    document.addEventListener(
      "keydown",
      function (event) {

        if (event.key === "Escape") {

          closeSidebar();

        }

      }
    );


    /* =====================================================
       SIDEBAR LINK CLICK
    ====================================================== */

    sidebar
      .querySelectorAll("a")
      .forEach(function (link) {

        link.addEventListener(
          "click",
          function () {

            if (
              window.innerWidth <= 991
            ) {

              closeSidebar();

            }

          }
        );

      });


    /* =====================================================
       WINDOW RESIZE
    ====================================================== */

    window.addEventListener(
      "resize",
      function () {

        if (
          window.innerWidth > 991
        ) {

          closeSidebar();

        }

      }
    );


    /* =====================================================
       INITIAL STATE
    ====================================================== */

    updateMenuIcon(false);

  }


  /* =======================================================
     NORMAL PAGE LOAD
  ======================================================== */

  document.addEventListener(
    "DOMContentLoaded",
    initAdminSidebar
  );


  /* =======================================================
     TURBO LOAD
  ======================================================== */

  document.addEventListener(
    "turbo:load",
    initAdminSidebar
  );


})();

</script>