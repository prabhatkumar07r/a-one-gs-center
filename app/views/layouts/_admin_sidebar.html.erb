<style>
/* =========================================================
   ADMIN SIDEBAR
========================================================= */

.admin-sidebar {
  position: fixed;
  top: 0;
  left: 0;

  width: 260px;
  height: 100vh;

  background: blueviolet;

  border-right: 1px solid #e5e7eb;

  box-shadow: 4px 0 20px rgba(0, 0, 0, 0.05);

  z-index: 1900;

  overflow-y: auto;
  overflow-x: hidden;

  transition: transform 0.3s ease, width 0.3s ease;
}


/* =========================================================
   SCROLLBAR
========================================================= */

.admin-sidebar::-webkit-scrollbar {
  width: 5px;
}

.admin-sidebar::-webkit-scrollbar-thumb {
  background: #d1d5db;
  border-radius: 10px;
}

.admin-sidebar::-webkit-scrollbar-track {
  background: transparent;
}


/* =========================================================
   LOGO
========================================================= */

.sidebar-logo {
  min-height: 90px;

  display: flex;
  align-items: center;

  gap: 12px;

  padding: 18px 20px;

  border-bottom: 1px solid #edf0f3;
}

.sidebar-logo-img {
  width: 48px;
  height: 48px;

  object-fit: contain;

  flex-shrink: 0;

  border-radius: 10px;
}

.sidebar-title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
}

.sidebar-title h3 {
  margin: 0;

  color: whitesmoke;

  font-size: 15px;
  font-weight: 900;

  line-height: 1.3;

  white-space: normal;
  word-break: normal;

  overflow: visible;
}

.sidebar-title small {
  display: block;

  margin-top: 3px;

  color: yellow;

  font-size: 11px;
  font-weight: 500;

  white-space: nowrap;
}


/* =========================================================
   NAVIGATION
========================================================= */

.admin-sidebar > .nav {
  padding: 15px 12px 30px;
}

.admin-sidebar .nav > li {
  margin-bottom: 5px;
}


/* =========================================================
   MAIN NAV LINK
========================================================= */

.admin-sidebar .nav-link {
  position: relative;

  display: flex;
  align-items: center;

  gap: 12px;

  width: 100%;

  padding: 11px 13px;

  border-radius: 9px;

  color: #4b5563;

  text-decoration: none;

  font-size: 14px;
  font-weight: 600;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.admin-sidebar .nav-link i:first-child {
  width: 20px;

  flex-shrink: 0;

  text-align: center;

  font-size: 16px;

  color: #6b7280;

  transition: color 0.2s ease;
}


/* Chevron */

.admin-sidebar .nav-link .fa-chevron-down {
  margin-left: auto;

  width: auto !important;

  font-size: 10px !important;

  color: #9ca3af !important;

  transition: transform 0.25s ease;
}


/* =========================================================
   HOVER
========================================================= */

.admin-sidebar .nav-link:hover {
  background: #f5f7fb;

  color: #4f46e5;

  transform: translateX(2px);
}

.admin-sidebar .nav-link:hover i:first-child {
  color: #4f46e5;
}


/* =========================================================
   ACTIVE LINK
========================================================= */

.admin-sidebar .nav-link.active {
  background: #eef2ff;

  color: #4f46e5;
}

.admin-sidebar .nav-link.active i:first-child {
  color: #4f46e5;
}


/* =========================================================
   SUBMENU
========================================================= */

.admin-sidebar .collapse {
  padding: 4px 0 5px 20px;
}

.admin-sidebar .submenu {
  position: relative;

  display: flex;
  align-items: center;

  width: 100%;

  padding: 9px 12px 9px 35px;

  color: #whitesmoke;

  text-decoration: none;

  border-radius: 8px;

  font-size: 13px;
  font-weight: 800;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    padding-left 0.2s ease;
}

.admin-sidebar .submenu::before {
  content: "";

  position: absolute;

  left: 18px;

  width: 5px;
  height: 5px;

  background: #cbd5e1;

  border-radius: 50%;
}

.admin-sidebar .submenu:hover {
  background: #f8fafc;

  color: #4f46e5;

  padding-left: 39px;
}

.admin-sidebar .submenu:hover::before {
  background: #4f46e5;
}


/* =========================================================
   ACTIVE SUBMENU
========================================================= */

.admin-sidebar .submenu.active {
  background: #eef2ff;

  color: #4f46e5;

  font-weight: 600;
}

.admin-sidebar .submenu.active::before {
  background: #4f46e5;
}


/* =========================================================
   STUDY NOTES ICON
========================================================= */

.admin-sidebar .submenu i {
  width: 18px;

  text-align: center;
}


/* =========================================================
   MOBILE OVERLAY
========================================================= */

.admin-sidebar-overlay {
  display: none;

  position: fixed;

  inset: 0;

  background: rgba(15, 23, 42, 0.45);

  backdrop-filter: blur(2px);

  z-index: 1050;
}

.admin-sidebar-overlay.show {
  display: block;
}


/* =========================================================
   MOBILE MENU BUTTON
========================================================= */

.admin-sidebar-toggle {
  display: none;

  position: fixed;

  top: 18px;
  left: 15px;

  width: 42px;
  height: 42px;

  align-items: center;
  justify-content: center;

  border: 1px solid #e5e7eb;

  border-radius: 9px;

  background: #ffffff;

  color: #374151;

  cursor: pointer;

  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);

  z-index: 2000;

  transition: 0.2s ease;
}

.admin-sidebar-toggle:hover {
  background: #f5f7fb;

  color: #4f46e5;
}

.admin-sidebar-toggle i {
  font-size: 18px;
}


/* =========================================================
   SIDEBAR CLOSE BUTTON
========================================================= */

.admin-sidebar-close {
  display: none;

  position: absolute;

  top: 22px;
  right: 15px;

  width: 35px;
  height: 35px;

  border: 0;

  border-radius: 8px;

  background: #f3f4f6;

  color: #6b7280;

  cursor: pointer;
}

.admin-sidebar-close:hover {
  background: #fee2e2;

  color: #dc2626;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1100px) {

  .admin-sidebar {
    width: 235px;
  }

  .sidebar-logo {
    padding: 16px;
  }

  .sidebar-title h3 {
    font-size: 14px;
  }

  .admin-sidebar .nav-link {
    font-size: 13px;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 991px) {

  .admin-sidebar {
    width: 270px;
    transform: translateX(-100%);
    z-index: 3000;
  }

  .admin-sidebar.mobile-open {
    transform: translateX(0);
  }

  .admin-sidebar-toggle {
    display: flex;
    z-index: 3100;
  }

  .admin-sidebar-close {
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3101;
  }

}

/* =========================================================
   SMALL MOBILE
========================================================= */

/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 480px) {

  .admin-sidebar {
    width: 82%;
    max-width: 290px;
  }

  .admin-sidebar .nav-link {
    padding: 12px;
    min-height: 46px;
  }

  .admin-sidebar .submenu {
    padding-top: 10px;
    padding-bottom: 10px;
    min-height: 42px;
  }

  .sidebar-logo {
    padding: 16px;
  }

  .sidebar-logo-img {
    width: 44px;
    height: 44px;
  }

  .sidebar-title h3 {
    font-size: 14px;
  }

  .sidebar-title small {
    font-size: 10px;
  }

}


/* =========================================================
   VERY SMALL SCREEN
========================================================= */

@media (max-width: 360px) {

  .admin-sidebar {
    width: 88%;
  }

  .sidebar-logo-img {
    width: 42px;
    height: 42px;
  }

  .sidebar-title h3 {
    font-size: 13px;
  }

}






/* =========================================================
   ACTIVE PARENT MENU
========================================================= */

.admin-sidebar .nav-link.parent-active {
  background: #eef2ff;
  color: #4f46e5;
}

.admin-sidebar .nav-link.parent-active i:first-child {
  color: #4f46e5;
}

.admin-sidebar .nav-link[aria-expanded="true"] .fa-chevron-down {
  transform: rotate(180deg);
}

/* Smooth submenu appearance */
.admin-sidebar .collapse {
  transition: height 0.25s ease;
}

/* Better mobile touch area */
@media (max-width: 768px) {

  .admin-sidebar .nav-link {
    min-height: 46px;
  }

  .admin-sidebar .submenu {
    min-height: 42px;
  }

}
</style>


<!-- =========================================================
     MOBILE TOGGLE
========================================================= -->

<button
  type="button"
  class="admin-sidebar-toggle"
  id="adminSidebarToggle"
  aria-label="Open admin menu">

  <i class="fas fa-bars"></i>

</button>


<!-- =========================================================
     OVERLAY
========================================================= -->

<div
  class="admin-sidebar-overlay"
  id="adminSidebarOverlay">
</div>


<!-- =========================================================
     SIDEBAR
========================================================= -->

<div class="admin-sidebar" id="adminSidebar">


  <!-- =======================================================
       CLOSE BUTTON
  ======================================================== -->

  <button
    type="button"
    class="admin-sidebar-close"
    id="adminSidebarClose"
    aria-label="Close menu">

    <i class="fas fa-times"></i>

  </button>


  <!-- =======================================================
       LOGO
  ======================================================== -->

  <div class="sidebar-logo">

    <%= image_tag "logo.jpeg",
        class: "sidebar-logo-img",
        alt: "A One GS Center" %>

    <div class="sidebar-title">

      <h3>
        A ONE GS CENTER
      </h3>

      <small>
        Admin Panel
      </small>

    </div>

  </div>


  <!-- =======================================================
       NAVIGATION
  ======================================================== -->

  <ul class="nav flex-column">


    <!-- =====================================================
         DASHBOARD
    ====================================================== -->

    <li>

      <%= link_to dashboard_path,
          class: "nav-link #{'active' if controller_path == 'admin/dashboard'}" do %>

        <i class="fas fa-home"></i>

        <span>
          Dashboard
        </span>

      <% end %>

    </li>


    <!-- =====================================================
         STUDENT MANAGEMENT
    ====================================================== -->

    <li>

      <a
        class="nav-link"
        data-bs-toggle="collapse"
        href="#studentMenu"
        role="button"
        aria-expanded="true"
        aria-controls="studentMenu">

        <i class="fas fa-user-graduate"></i>

        <span>
          Student Management
        </span>

        <i class="fas fa-chevron-down"></i>

      </a>


      <div
        class="collapse show"
        id="studentMenu">

        <%= link_to students_path,
            class: "submenu #{'active' if controller_path == 'admin/students'}" do %>

          Students

        <% end %>


        <%= link_to enrollments_path,
            class: "submenu #{'active' if controller_path == 'admin/enrollments'}" do %>

          Enrollments

        <% end %>


        <%= link_to attendances_path,
            class: "submenu #{'active' if controller_path == 'admin/attendances'}" do %>

          Attendance

        <% end %>


        <%= link_to fees_path,
            class: "submenu #{'active' if controller_path == 'admin/fees'}" do %>

          Fees

        <% end %>

      </div>

    </li>


    <!-- =====================================================
         ACADEMIC
    ====================================================== -->

    <li>

      <a
        class="nav-link"
        data-bs-toggle="collapse"
        href="#academicMenu"
        role="button"
        aria-expanded="false"
        aria-controls="academicMenu">

        <i class="fas fa-book"></i>

        <span>
          Academic
        </span>

        <i class="fas fa-chevron-down"></i>

      </a>


      <div
        class="collapse"
        id="academicMenu">


        <%= link_to teachers_path,
            class: "submenu #{'active' if controller_path == 'admin/teachers'}" do %>

          Teachers

        <% end %>


        <%= link_to courses_path,
            class: "submenu #{'active' if controller_path == 'admin/courses'}" do %>

          Courses

        <% end %>


        <%= link_to batches_path,
            class: "submenu #{'active' if controller_path == 'admin/batches'}" do %>

          Batches

        <% end %>


        <%= link_to study_notes_path,
            class: "submenu #{'active' if controller_path == 'admin/study_notes'}" do %>

          <i class="fas fa-file-pdf me-2 text-danger"></i>

          Study Notes

        <% end %>

      </div>

    </li>


    <!-- =====================================================
         WEBSITE
    ====================================================== -->

    <li>

      <a
        class="nav-link"
        data-bs-toggle="collapse"
        href="#websiteMenu"
        role="button"
        aria-expanded="false"
        aria-controls="websiteMenu">

        <i class="fas fa-globe"></i>

        <span>
          Website
        </span>

        <i class="fas fa-chevron-down"></i>

      </a>


      <div
        class="collapse"
        id="websiteMenu">


        <%= link_to galleries_path,
            class: "submenu #{'active' if controller_path == 'admin/galleries'}" do %>

          Gallery

        <% end %>


        <%= link_to achievements_path,
            class: "submenu #{'active' if controller_path == 'admin/achievements'}" do %>

          Achievements

        <% end %>


        <%= link_to notifications_path,
            class: "submenu #{'active' if controller_path == 'admin/notifications'}" do %>

          Notifications

        <% end %>


        <%= link_to demos_path,
            class: "submenu #{'active' if controller_path == 'admin/demos'}" do %>

          Demo Requests

        <% end %>


      </div>

    </li>


  </ul>

</div>


<!-- =========================================================
     MOBILE SIDEBAR SCRIPT
========================================================= -->

<script>

document.addEventListener("turbo:load", function () {

  const sidebar =
    document.getElementById("adminSidebar");

  const toggle =
    document.getElementById("adminSidebarToggle");

  const close =
    document.getElementById("adminSidebarClose");

  const overlay =
    document.getElementById("adminSidebarOverlay");


  if (!sidebar || !toggle || !close || !overlay) {
    return;
  }


  /* =========================================================
     OPEN SIDEBAR
  ========================================================= */

  function openSidebar() {

    sidebar.classList.add("mobile-open");

    overlay.classList.add("show");

    document.body.style.overflow = "hidden";

  }


  /* =========================================================
     CLOSE SIDEBAR
  ========================================================= */

  function closeSidebar() {

    sidebar.classList.remove("mobile-open");

    overlay.classList.remove("show");

    document.body.style.overflow = "";

  }


  /* =========================================================
     TOGGLE
  ========================================================= */

  toggle.onclick = function () {

    if (sidebar.classList.contains("mobile-open")) {

      closeSidebar();

    } else {

      openSidebar();

    }

  };


  /* =========================================================
     CLOSE BUTTON
  ========================================================= */

  close.onclick = function () {

    closeSidebar();

  };


  /* =========================================================
     OVERLAY
  ========================================================= */

  overlay.onclick = function () {

    closeSidebar();

  };


  /* =========================================================
     CLOSE AFTER LINK CLICK ON MOBILE
  ========================================================= */

  sidebar.querySelectorAll("a.submenu").forEach(function (link) {

    link.addEventListener("click", function () {

      if (window.innerWidth <= 768) {

        closeSidebar();

      }

    });

  });


  /* =========================================================
     ESCAPE KEY
  ========================================================= */

  document.addEventListener("keydown", function (event) {

    if (
      event.key === "Escape" &&
      sidebar.classList.contains("mobile-open")
    ) {

      closeSidebar();

    }

  });


  /* =========================================================
     RESET WHEN SCREEN BECOMES DESKTOP
  ========================================================= */

  window.addEventListener("resize", function () {

    if (window.innerWidth > 768) {

      sidebar.classList.remove("mobile-open");

      overlay.classList.remove("show");

      document.body.style.overflow = "";

    }

  });

});

</script>