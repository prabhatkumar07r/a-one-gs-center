<style>
/* =========================================================
   A ONE GS CENTER
   ADMIN SIDEBAR
   DARK GLASS / BLUE-VIOLET THEME
========================================================= */

.admin-sidebar,
.admin-sidebar *,
.admin-sidebar *::before,
.admin-sidebar *::after {
  box-sizing: border-box;
}

.admin-sidebar {

  position: fixed;

  top: 0;
  left: 0;

  width: 260px;
  height: 100dvh;

  background:
    linear-gradient(
      180deg,
      rgba(15, 23, 42, 0.28),
      rgba(30, 27, 75, 0.22)
    ) !important;

  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);

  border-right: 1px solid rgba(255, 255, 255, 0.16);

  box-shadow:
    4px 0 30px rgba(0, 0, 0, 0.15);

  z-index: 3000;

  overflow-y: auto;
  overflow-x: hidden;

  transition:
    transform 0.3s ease,
    width 0.3s ease;
}


/* =========================================================
   SCROLLBAR
========================================================= */

.admin-sidebar::-webkit-scrollbar {
  width: 5px;
}

.admin-sidebar::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.18);
  border-radius: 10px;
}

.admin-sidebar::-webkit-scrollbar-track {
  background: transparent;
}


/* =========================================================
   LOGO
========================================================= */

.sidebar-logo {
  min-height: 90px;

  display: flex;
  align-items: center;

  gap: 12px;

  padding: 18px;

  background: rgba(255, 255, 255, 0.025);

  border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}

.sidebar-logo-img {
  width: 48px;
  height: 48px;

  flex: 0 0 48px;

  object-fit: contain;

  border-radius: 12px;

  background: #ffffff;

  padding: 2px;

  box-shadow:
    0 5px 18px rgba(0, 0, 0, 0.20);
}

.sidebar-title {
  min-width: 0;

  flex: 1;

  overflow: hidden;
}

.sidebar-title h3 {
  margin: 0;

  color: #ffffff;

  font-size: 15px;

  font-weight: 800;

  line-height: 1.3;

  white-space: normal;
}

.sidebar-title small {
  display: block;

  margin-top: 4px;

  color: #c4b5fd;

  font-size: 11px;

  font-weight: 600;

  white-space: nowrap;
}


/* =========================================================
   NAVIGATION
========================================================= */

.admin-sidebar > .nav {
  padding: 15px 12px 30px;

  margin: 0;
}

.admin-sidebar .nav > li {
  margin-bottom: 5px;
}


/* =========================================================
   NAV LINK
========================================================= */

.admin-sidebar .nav-link {
  position: relative;

  display: flex;

  align-items: center;

  gap: 12px;

  width: 100%;

  min-height: 44px;

  padding: 10px 13px;

  border: 1px solid transparent;

  border-radius: 10px;

  color: #e2e8f0;

  text-decoration: none;

  font-size: 14px;

  font-weight: 650;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.admin-sidebar .nav-link span {
  min-width: 0;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;
}

.admin-sidebar .nav-link > i:first-child {
  width: 20px;

  flex: 0 0 20px;

  text-align: center;

  font-size: 16px;

  color: #c4b5fd;

  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.admin-sidebar .nav-link .sidebar-chevron {
  margin-left: auto;

  width: auto !important;

  flex: 0 0 auto;

  font-size: 10px;

  color: rgba(255, 255, 255, 0.45);

  transition:
    transform 0.25s ease,
    color 0.2s ease;
}

.admin-sidebar .nav-link:hover {
  background: rgba(255, 255, 255, 0.08);

  border-color: rgba(255, 255, 255, 0.06);

  color: #ffffff;

  transform: translateX(2px);
}

.admin-sidebar .nav-link:hover > i:first-child {
  color: #ffffff;

  transform: scale(1.05);
}

.admin-sidebar .nav-link.active,
.admin-sidebar .nav-link.parent-active {
  background:
    linear-gradient(
      90deg,
      rgba(124, 58, 237, 0.32),
      rgba(37, 99, 235, 0.16)
    );

  border-color: rgba(167, 139, 250, 0.14);

  color: #ffffff;

  box-shadow:
    inset 3px 0 0 rgba(167, 139, 250, 0.90);
}

.admin-sidebar .nav-link.active > i:first-child,
.admin-sidebar .nav-link.parent-active > i:first-child {
  color: #ffffff;
}

.admin-sidebar
.nav-link[aria-expanded="true"]
.sidebar-chevron {
  transform: rotate(180deg);

  color: #c4b5fd;
}


/* =========================================================
   SUBMENU
========================================================= */

.admin-sidebar .collapse {
  padding: 4px 0 6px 20px;
}

.admin-sidebar .submenu {
  position: relative;

  display: flex;

  align-items: center;

  width: 100%;

  min-height: 40px;

  padding: 8px 12px 8px 35px;

  color: rgba(226, 232, 240, 0.82);

  text-decoration: none;

  border: 1px solid transparent;

  border-radius: 8px;

  font-size: 13px;

  font-weight: 600;

  transition:
    background 0.2s ease,
    color 0.2s ease,
    padding-left 0.2s ease,
    border-color 0.2s ease;
}

.admin-sidebar .submenu::before {
  content: "";

  position: absolute;

  left: 18px;

  width: 5px;
  height: 5px;

  background: rgba(255, 255, 255, 0.40);

  border-radius: 50%;

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.admin-sidebar .submenu:hover {
  background: rgba(255, 255, 255, 0.07);

  border-color: rgba(255, 255, 255, 0.05);

  color: #ffffff;

  padding-left: 39px;
}

.admin-sidebar .submenu:hover::before {
  background: #a78bfa;

  transform: scale(1.25);
}

.admin-sidebar .submenu.active {
  background:
    linear-gradient(
      90deg,
      rgba(124, 58, 237, 0.25),
      rgba(37, 99, 235, 0.10)
    );

  border-color: rgba(167, 139, 250, 0.10);

  color: #ffffff;

  font-weight: 700;

  box-shadow:
    inset 2px 0 0 #a78bfa;
}

.admin-sidebar .submenu.active::before {
  background: #a78bfa;

  transform: scale(1.2);
}

.admin-sidebar .submenu i {
  width: 18px;

  margin-right: 8px;

  text-align: center;

  color: #a78bfa;
}


/* =========================================================
   MOBILE OVERLAY
========================================================= */

.admin-sidebar-overlay {
  display: none;

  position: fixed;

  inset: 0;

  background: rgba(2, 6, 23, 0.58);

  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);

  z-index: 2990;
}

.admin-sidebar-overlay.show {
  display: block;
}


/* =========================================================
   MOBILE TOGGLE
========================================================= */

.admin-sidebar-toggle {
  display: none;

  position: fixed;

  top: 15px;
  left: 15px;

  width: 42px;
  height: 42px;

  align-items: center;
  justify-content: center;

  padding: 0;

  border: 1px solid rgba(255, 255, 255, 0.12);

  border-radius: 12px;

  background: rgba(15, 23, 42, 0.75);

  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);

  color: #ffffff;

  cursor: pointer;

  box-shadow:
    0 8px 25px rgba(0, 0, 0, 0.20);

  z-index: 3100;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.admin-sidebar-toggle:hover {
  background: rgba(124, 58, 237, 0.30);

  border-color: rgba(167, 139, 250, 0.30);

  color: #ffffff;

  transform: translateY(-1px);
}

.admin-sidebar-toggle i {
  font-size: 19px;
}


/* =========================================================
   CLOSE BUTTON
========================================================= */

.admin-sidebar-close {
  display: none;

  position: absolute;

  top: 18px;
  right: 14px;

  width: 35px;
  height: 35px;

  align-items: center;
  justify-content: center;

  padding: 0;

  border: 1px solid rgba(255, 255, 255, 0.10);

  border-radius: 9px;

  background: rgba(255, 255, 255, 0.08);

  color: #ffffff;

  cursor: pointer;

  z-index: 3101;
}

.admin-sidebar-close:hover {
  background: rgba(239, 68, 68, 0.20);

  transform: rotate(4deg);
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 991px) {

  .admin-sidebar {
    width: 280px;

    max-width: calc(100vw - 45px);

    background:
      linear-gradient(
        145deg,
        rgba(15, 23, 42, 0.90),
        rgba(30, 27, 75, 0.88)
      );

    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);

    box-shadow:
      8px 0 40px rgba(0, 0, 0, 0.35);

    transform: translateX(-105%);
  }

  .admin-sidebar.mobile-open {
    transform: translateX(0);
  }

  .admin-sidebar-toggle {
    display: flex;
  }

  .admin-sidebar-close {
    display: flex;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .admin-sidebar {
    width: min(290px, 86vw);

    max-width: 86vw;
  }

  .sidebar-logo {
    min-height: 82px;

    padding: 16px;
  }

  .sidebar-logo-img {
    width: 44px;
    height: 44px;

    flex-basis: 44px;
  }

  .sidebar-title h3 {
    font-size: 14px;
  }

  .sidebar-title small {
    font-size: 10px;
  }

  .admin-sidebar .nav {
    padding: 12px 10px 25px;
  }

  .admin-sidebar .nav-link {
    min-height: 46px;

    padding: 11px 12px;

    font-size: 14px;
  }

  .admin-sidebar .submenu {
    min-height: 42px;

    padding-top: 10px;
    padding-bottom: 10px;
  }
}


/* =========================================================
   VERY SMALL MOBILE
========================================================= */

@media (max-width: 360px) {

  .admin-sidebar {
    width: 88vw;

    max-width: 88vw;
  }

  .sidebar-logo {
    padding: 15px;
  }

  .sidebar-logo-img {
    width: 42px;
    height: 42px;

    flex-basis: 42px;
  }

  .sidebar-title h3 {
    font-size: 13px;
  }

  .admin-sidebar .nav-link {
    font-size: 13px;
  }
}
</style>


<!-- =========================================================
     MOBILE TOGGLE
========================================================= -->

<button
  type="button"
  class="admin-sidebar-toggle"
  id="adminSidebarToggle"
  aria-label="Open admin menu"
  aria-expanded="false">

  <i class="bi bi-list"></i>

</button>


<!-- =========================================================
     OVERLAY
========================================================= -->

<div
  class="admin-sidebar-overlay"
  id="adminSidebarOverlay">
</div>


<!-- =========================================================
     SIDEBAR
========================================================= -->

<div
  class="admin-sidebar"
  id="adminSidebar">


  <!-- CLOSE -->

  <button
    type="button"
    class="admin-sidebar-close"
    id="adminSidebarClose"
    aria-label="Close menu">

    <i class="bi bi-x-lg"></i>

  </button>


  <!-- LOGO -->

  <div class="sidebar-logo">

    <%= image_tag "logo.jpeg",
        class: "sidebar-logo-img",
        alt: "A One GS Center" %>

    <div class="sidebar-title">

      <h3>A ONE GS CENTER</h3>

      <small>Admin Panel</small>

    </div>

  </div>


  <!-- =======================================================
       NAVIGATION
  ======================================================== -->

  <ul class="nav flex-column">


    <!-- =====================================================
         DASHBOARD
    ====================================================== -->

    <li>

      <%= link_to dashboard_path,
          class: "nav-link #{'active' if controller_path == 'dashboard'}" do %>

        <i class="bi bi-grid-1x2"></i>

        <span>Dashboard</span>

      <% end %>

    </li>


    <!-- =====================================================
         STUDENT MANAGEMENT
    ====================================================== -->

    <li>

      <a
        class="nav-link #{'parent-active' if controller_path.start_with?('students') || controller_path.start_with?('admin/enrollments') || controller_path.start_with?('attendances') || controller_path.start_with?('fees')}"
        data-bs-toggle="collapse"
        href="#studentMenu"
        role="button"
        aria-expanded="true"
        aria-controls="studentMenu">

        <i class="bi bi-mortarboard"></i>

        <span>Student Management</span>

        <i class="bi bi-chevron-down sidebar-chevron"></i>

      </a>


      <div
        class="collapse show"
        id="studentMenu">


        <!-- STUDENTS -->

        <%= link_to students_path,
            class: "submenu #{'active' if controller_path == 'students'}" do %>

          Students

        <% end %>


        <!-- ADMIN ENROLLMENTS -->

        <%= link_to admin_enrollments_path,
            class: "submenu #{'active' if controller_path == 'admin/enrollments'}" do %>

          Enrollments

        <% end %>


        <!-- ATTENDANCE -->

        <%= link_to attendances_path,
            class: "submenu #{'active' if controller_path == 'attendances'}" do %>

          Attendance

        <% end %>


        <!-- FEES -->

        <%= link_to fees_path,
            class: "submenu #{'active' if controller_path == 'fees'}" do %>

          Fees

        <% end %>

      </div>

    </li>


    <!-- =====================================================
         ACADEMIC
    ====================================================== -->

    <li>

      <a
        class="nav-link #{'parent-active' if controller_path.start_with?('teachers') || controller_path.start_with?('admin/courses') || controller_path.start_with?('batches') || controller_path.start_with?('study_notes')}"
        data-bs-toggle="collapse"
        href="#academicMenu"
        role="button"
        aria-expanded="false"
        aria-controls="academicMenu">

        <i class="bi bi-book"></i>

        <span>Academic</span>

        <i class="bi bi-chevron-down sidebar-chevron"></i>

      </a>


      <div
        class="collapse"
        id="academicMenu">


        <%= link_to teachers_path,
            class: "submenu #{'active' if controller_path == 'teachers'}" do %>

          Teachers

        <% end %>


        <%= link_to admin_courses_path,
            class: "submenu #{'active' if controller_path.start_with?('admin/courses')}" do %>

          Courses

        <% end %>


        <%= link_to batches_path,
            class: "submenu #{'active' if controller_path == 'batches'}" do %>

          Batches

        <% end %>


        <%= link_to study_notes_path,
            class: "submenu #{'active' if controller_path == 'study_notes'}" do %>

          <i class="bi bi-file-earmark-pdf"></i>

          <span>Study Notes</span>

        <% end %>

      </div>

    </li>


    <!-- =====================================================
         WEBSITE
    ====================================================== -->

    <li>

      <a
        class="nav-link #{'parent-active' if controller_path.start_with?('galleries') || controller_path.start_with?('achievements') || controller_path.start_with?('notifications') || controller_path.start_with?('demos')}"
        data-bs-toggle="collapse"
        href="#websiteMenu"
        role="button"
        aria-expanded="false"
        aria-controls="websiteMenu">

        <i class="bi bi-globe2"></i>

        <span>Website</span>

        <i class="bi bi-chevron-down sidebar-chevron"></i>

      </a>


      <div
        class="collapse"
        id="websiteMenu">


        <%= link_to galleries_path,
            class: "submenu #{'active' if controller_path == 'galleries'}" do %>

          Gallery

        <% end %>


        <%= link_to achievements_path,
            class: "submenu #{'active' if controller_path == 'achievements'}" do %>

          Achievements

        <% end %>


        <%= link_to notifications_path,
            class: "submenu #{'active' if controller_path == 'notifications'}" do %>

          Notifications

        <% end %>


        <%= link_to demos_path,
            class: "submenu #{'active' if controller_path == 'demos'}" do %>

          Demo Requests

        <% end %>

      </div>

    </li>


  </ul>

</div>


<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

  function initAdminSidebar() {

    const sidebar =
      document.getElementById("adminSidebar");

    const toggle =
      document.getElementById("adminSidebarToggle");

    const close =
      document.getElementById("adminSidebarClose");

    const overlay =
      document.getElementById("adminSidebarOverlay");


    if (!sidebar || !toggle || !close || !overlay) {
      return;
    }


    if (sidebar.dataset.initialized === "true") {
      return;
    }

    sidebar.dataset.initialized = "true";


    function openSidebar() {

      sidebar.classList.add("mobile-open");

      overlay.classList.add("show");

      toggle.setAttribute(
        "aria-expanded",
        "true"
      );

      document.body.style.overflow = "hidden";
    }


    function closeSidebar() {

      sidebar.classList.remove("mobile-open");

      overlay.classList.remove("show");

      toggle.setAttribute(
        "aria-expanded",
        "false"
      );

      document.body.style.overflow = "";
    }


    toggle.addEventListener(
      "click",
      function () {

        if (
          sidebar.classList.contains("mobile-open")
        ) {

          closeSidebar();

        } else {

          openSidebar();

        }

      }
    );


    close.addEventListener(
      "click",
      closeSidebar
    );


    overlay.addEventListener(
      "click",
      closeSidebar
    );


    sidebar
      .querySelectorAll("a.submenu")
      .forEach(function (link) {

        link.addEventListener(
          "click",
          function () {

            if (window.innerWidth <= 991) {
              closeSidebar();
            }

          }
        );

      });


    document.addEventListener(
      "keydown",
      function (event) {

        if (
          event.key === "Escape" &&
          sidebar.classList.contains("mobile-open")
        ) {

          closeSidebar();

        }

      }
    );


    window.addEventListener(
      "resize",
      function () {

        if (window.innerWidth > 991) {
          closeSidebar();
        }

      }
    );

  }


  document.addEventListener(
    "turbo:load",
    initAdminSidebar
  );


  document.addEventListener(
    "DOMContentLoaded",
    initAdminSidebar
  );


})();

</script>