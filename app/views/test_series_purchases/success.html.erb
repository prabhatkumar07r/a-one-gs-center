<% content_for :hide_header, true %>
<% content_for :hide_footer, true %>

<style>
.ts-payment-result-page {
  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 30px 15px;

  background:
    radial-gradient(
      circle at top right,
      rgba(124, 58, 237, .12),
      transparent 35%
    ),
    radial-gradient(
      circle at bottom left,
      rgba(37, 99, 235, .10),
      transparent 35%
    ),
    #f8f9ff;
}

.ts-result-card {
  width: 100%;
  max-width: 600px;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 24px;

  padding: 45px 35px;

  text-align: center;

  box-shadow:
    0 20px 50px rgba(79, 70, 229, .10);
}

.ts-result-icon {
  width: 82px;
  height: 82px;

  margin: 0 auto 22px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #dcfce7;

  color: #16a34a;

  font-size: 38px;
}

.ts-result-card h1 {
  color: #1e1b4b;

  font-size: 32px;

  font-weight: 900;

  margin-bottom: 10px;
}

.ts-result-card p {
  color: #64748b;

  line-height: 1.7;

  margin-bottom: 25px;
}

.ts-result-series {
  padding: 18px;

  margin-bottom: 25px;

  border-radius: 14px;

  background: #f8fafc;

  border: 1px solid #e5e7eb;
}

.ts-result-series small {
  display: block;

  color: #64748b;

  margin-bottom: 5px;
}

.ts-result-series strong {
  color: #312e81;

  font-size: 20px;
}

.ts-result-details {
  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 12px;

  margin-bottom: 25px;
}

.ts-result-detail {
  padding: 14px;

  border-radius: 12px;

  background: #f5f3ff;
}

.ts-result-detail span {
  display: block;

  color: #64748b;

  font-size: 12px;

  margin-bottom: 4px;
}

.ts-result-detail strong {
  color: #312e81;

  font-size: 15px;
}

.ts-result-btn {
  width: 100%;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 9px;

  padding: 14px 20px;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #6d28d9,
      #ec4899
    );

  color: #ffffff !important;

  text-decoration: none;

  font-weight: 800;

  transition: .2s ease;
}

.ts-result-btn:hover {
  color: #ffffff !important;

  transform: translateY(-2px);
}

@media (max-width: 600px) {

  .ts-result-card {
    padding: 35px 22px;
  }

  .ts-result-card h1 {
    font-size: 27px;
  }

  .ts-result-details {
    grid-template-columns: 1fr;
  }

}
</style>


<div class="ts-payment-result-page">

  <div class="ts-result-card">

    <div class="ts-result-icon">
      <i class="fas fa-check"></i>
    </div>


    <h1>
      Payment Successful
    </h1>


    <p>
      Your payment has been successfully verified.
      You now have access to this Test Series.
    </p>


    <div class="ts-result-series">

      <small>
        Test Series
      </small>

      <strong>
        <%= @test_series.title %>
      </strong>

    </div>


    <div class="ts-result-details">

      <div class="ts-result-detail">

        <span>
          Amount Paid
        </span>

        <strong>
          ₹<%= number_with_precision(
            @purchase.amount,
            precision: 2
          ) %>
        </strong>

      </div>


      <div class="ts-result-detail">

        <span>
          Payment Status
        </span>

        <strong>
          Paid
        </strong>

      </div>

    </div>


    <%= link_to test_series_path(@test_series),
                class: "ts-result-btn" do %>

      <i class="fas fa-file-alt"></i>

      Open Test Series

    <% end %>

  </div>

</div>