<% content_for :title, "#{@course.Course_name} Playlists" %>

<div class="container-fluid mt-4">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2>📚 Playlist Management</h2>
      <p class="text-muted mb-0">
        Course: <strong><%= @course.Course_name %></strong>
      </p>
    </div>

    <%= link_to "➕ Add Playlist",
        new_course_playlist_path(@course),
        class: "btn btn-success" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">

      <% if @playlists.any? %>

        <table class="table table-hover align-middle">

          <thead class="table-dark">
            <tr>
              <th>#</th>
              <th>Title</th>
              <th>Position</th>
              <th>Videos</th>
              <th>Resources</th>
              <th width="320">Actions</th>
            </tr>
          </thead>

          <tbody>

            <% @playlists.each_with_index do |playlist, index| %>

              <tr>

                <td><%= index + 1 %></td>

                <td>
                  <strong><%= playlist.title %></strong>

                  <% if playlist.description.present? %>
                    <br>
                    <small class="text-muted">
                      <%= truncate(playlist.description, length: 60) %>
                    </small>
                  <% end %>
                </td>

                <td>
                  <span class="badge bg-primary">
                    <%= playlist.position %>
                  </span>
                </td>

                <td>
                  <span class="badge bg-success">
                    <%= playlist.videos.count %>
                  </span>
                </td>

                <td>
                  <span class="badge bg-info">
                    <%= playlist.resources.count %>
                  </span>
                </td>

                <td>

                  <%= link_to "🎥 Videos",
                      course_playlist_videos_path(@course, playlist),
                      class: "btn btn-info btn-sm" %>

                  <%= link_to "✏️ Edit",
                      edit_course_playlist_path(@course, playlist),
                      class: "btn btn-warning btn-sm" %>

                  <%= link_to "🗑 Delete",
                      course_playlist_path(@course, playlist),
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "Delete this playlist?"
                      },
                      class: "btn btn-danger btn-sm" %>

                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

      <% else %>

        <div class="text-center py-5">
          <h5>No playlists found.</h5>

          <%= link_to "➕ Create First Playlist",
              new_course_playlist_path(@course),
              class: "btn btn-primary mt-2" %>
        </div>

      <% end %>

    </div>
  </div>

</div>