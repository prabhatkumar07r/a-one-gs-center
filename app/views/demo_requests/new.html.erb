<style>
/* =========================================================
   DEMO PAGE
========================================================= */

.demo-page {
  min-height: 100vh;
  padding: 50px 20px;

  display: flex;
  align-items: center;
  justify-content: center;

  background:
    radial-gradient(
      circle at top left,
      rgba(79, 70, 229, 0.12),
      transparent 35%
    ),
    radial-gradient(
      circle at bottom right,
      rgba(124, 58, 237, 0.10),
      transparent 35%
    ),
    #f8fafc;

  box-sizing: border-box;
}


/* =========================================================
   MAIN CONTAINER
========================================================= */

.demo-container {
  width: min(1200px, 100%);
  min-height: 700px;

  display: grid;
  grid-template-columns: 1fr 1fr;

  overflow: hidden;

  background: #ffffff;

  border-radius: 24px;

  box-shadow:
    0 25px 60px rgba(15, 23, 42, 0.12);
}


/* =========================================================
   LEFT BRANDING
========================================================= */

.demo-brand-section {
  position: relative;

  min-height: 700px;

  display: flex;
  align-items: center;

  padding: 60px;

  color: #ffffff;

  background:
    linear-gradient(
      145deg,
      #312e81,
      #4f46e5 55%,
      #6d28d9
    );

  overflow: hidden;
}


/* Decorative circles */

.demo-brand-section::before {
  content: "";

  position: absolute;

  width: 320px;
  height: 320px;

  top: -130px;
  right: -130px;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.07);
}

.demo-brand-section::after {
  content: "";

  position: absolute;

  width: 250px;
  height: 250px;

  bottom: -120px;
  left: -100px;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.06);
}


.demo-brand-content {
  position: relative;

  z-index: 2;

  width: 100%;

  max-width: 500px;
}


/* =========================================================
   LOGO
========================================================= */

.demo-logo-wrapper {
  width: 125px;
  height: 125px;

  margin-bottom: 28px;
  padding: 10px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #ffffff;

  border-radius: 24px;

  box-shadow:
    0 15px 35px rgba(0, 0, 0, 0.20);

  box-sizing: border-box;
}


.demo-logo {
  width: 100%;
  height: 100%;

  object-fit: contain;

  border-radius: 16px;

  display: block;
}


/* =========================================================
   BRAND TEXT
========================================================= */

.demo-brand-content h1 {
  margin: 0;

  font-size: 40px;
  font-weight: 800;

  letter-spacing: -1px;

  line-height: 1.15;
}


.demo-brand-content h2 {
  margin: 12px 0 18px;

  font-size: 24px;
  font-weight: 600;

  line-height: 1.3;
}


.demo-brand-content > p {
  margin: 0;

  max-width: 470px;

  font-size: 15px;
  line-height: 1.8;

  color: rgba(255, 255, 255, 0.86);
}


/* =========================================================
   FEATURES
========================================================= */

.demo-features {
  margin-top: 35px;

  display: flex;
  flex-direction: column;

  gap: 18px;
}


.demo-feature {
  display: flex;
  align-items: center;

  gap: 14px;
}


.demo-feature > span {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.15);

  font-size: 16px;
  font-weight: 800;
}


.demo-feature strong {
  display: block;

  font-size: 14px;
  font-weight: 700;
}


.demo-feature small {
  display: block;

  margin-top: 3px;

  font-size: 12px;

  color: rgba(255, 255, 255, 0.70);
}


/* =========================================================
   RIGHT FORM
========================================================= */

.demo-form-section {
  padding: 55px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #ffffff;

  box-sizing: border-box;
}


.demo-form-card {
  width: 100%;

  max-width: 460px;
}


/* =========================================================
   FORM HEADER
========================================================= */

.demo-form-header {
  display: flex;
  align-items: center;

  gap: 14px;

  margin-bottom: 28px;
}


.demo-form-icon {
  width: 52px;
  height: 52px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 14px;

  background: #eef2ff;

  font-size: 25px;
}


.demo-form-header h2 {
  margin: 0;

  font-size: 26px;
  font-weight: 800;

  color: #111827;
}


.demo-form-header p {
  margin: 5px 0 0;

  font-size: 13px;

  color: #6b7280;
}


/* =========================================================
   FORM FIELDS
========================================================= */

.demo-field {
  margin-bottom: 16px;
}


.demo-field label {
  display: block;

  margin-bottom: 7px;

  font-size: 13px;
  font-weight: 700;

  color: #374151;
}


.demo-input,
.demo-select {
  width: 100%;
  height: 47px;

  padding: 0 14px;

  box-sizing: border-box;

  border: 1px solid #d1d5db;

  border-radius: 10px;

  outline: none;

  background: #ffffff;

  color: #111827;

  font-size: 14px;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}


.demo-input::placeholder {
  color: #9ca3af;
}


.demo-input:focus,
.demo-select:focus {
  border-color: #6366f1;

  box-shadow:
    0 0 0 4px rgba(99, 102, 241, 0.10);
}


/* =========================================================
   SUBMIT
========================================================= */

.demo-submit-wrapper {
  margin-top: 22px;
}


.demo-submit-btn {
  width: 100%;
  height: 50px;

  border: none;

  border-radius: 11px;

  background:
    linear-gradient(
      135deg,
      #4f46e5,
      #7c3aed
    );

  color: #ffffff;

  font-size: 15px;
  font-weight: 700;

  cursor: pointer;

  box-shadow:
    0 8px 20px rgba(79, 70, 229, 0.22);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}


.demo-submit-btn:hover {
  transform: translateY(-2px);

  box-shadow:
    0 12px 25px rgba(79, 70, 229, 0.30);
}


/* =========================================================
   SECURITY NOTE
========================================================= */

.demo-security-note {
  margin-top: 16px;

  text-align: center;

  font-size: 11px;

  color: #9ca3af;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {

  .demo-container {
    grid-template-columns: 1fr;
  }

  .demo-brand-section {
    min-height: auto;

    padding: 50px 45px;
  }

  .demo-form-section {
    padding: 50px 45px;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 576px) {

  .demo-page {
    padding: 20px 10px;
  }

  .demo-container {
    border-radius: 18px;
  }

  .demo-brand-section {
    padding: 40px 25px;
  }

  .demo-form-section {
    padding: 35px 22px;
  }

  .demo-logo-wrapper {
    width: 90px;
    height: 90px;

    padding: 7px;

    border-radius: 18px;
  }

  .demo-logo {
    border-radius: 12px;
  }

  .demo-brand-content h1 {
    font-size: 29px;
  }

  .demo-brand-content h2 {
    font-size: 20px;
  }

  .demo-brand-content > p {
    font-size: 14px;
  }

  .demo-form-header h2 {
    font-size: 22px;
  }

}
</style>


<div class="demo-page">

  <div class="demo-container">


    <!-- =====================================================
         LEFT SIDE - BRANDING
    ====================================================== -->

    <div class="demo-brand-section">

      <div class="demo-brand-content">


        <!-- LOGO -->

        <div class="demo-logo-wrapper">

          <%= image_tag "logo.jpeg",
              alt: "A One GS Center",
              class: "demo-logo" %>

        </div>


        <!-- BRAND -->

        <h1>A One GS Center</h1>

        <h2>Build Your Future With Us</h2>

        <p>
          Join our expert-led classes and start your preparation
          with the right guidance, quality education and structured
          learning.
        </p>


        <!-- FEATURES -->

        <div class="demo-features">


          <div class="demo-feature">

            <span>✓</span>

            <div>

              <strong>Expert Faculty</strong>

              <small>
                Learn from experienced teachers
              </small>

            </div>

          </div>


          <div class="demo-feature">

            <span>✓</span>

            <div>

              <strong>Quality Study Material</strong>

              <small>
                Structured and exam-focused content
              </small>

            </div>

          </div>


          <div class="demo-feature">

            <span>✓</span>

            <div>

              <strong>Free Demo Class</strong>

              <small>
                Experience our teaching before joining
              </small>

            </div>

          </div>


        </div>

      </div>

    </div>


    <!-- =====================================================
         RIGHT SIDE - FORM
    ====================================================== -->

    <div class="demo-form-section">

      <div class="demo-form-card">


        <!-- FORM HEADER -->

        <div class="demo-form-header">

          <span class="demo-form-icon">
            🎓
          </span>

          <div>

            <h2>Book Your Free Demo</h2>

            <p>
              Fill in your details and reserve your demo class.
            </p>

          </div>

        </div>


        <!-- =================================================
             FORM
        ================================================== -->

        <%= form_with model: @demo,
            url: demo_requests_path,
            local: true do |f| %>


          <!-- FULL NAME -->

          <div class="demo-field">

            <%= f.label :name, "Full Name" %>

            <%= f.text_field :name,
                class: "demo-input",
                placeholder: "Enter your full name",
                required: true %>

          </div>


          <!-- PHONE -->

          <div class="demo-field">

            <%= f.label :phone, "Contact Number" %>

            <%= f.telephone_field :phone,
                class: "demo-input",
                placeholder: "Enter mobile number",
                required: true %>

          </div>


          <!-- EMAIL -->

          <div class="demo-field">

            <%= f.label :email, "Email Address" %>

            <%= f.email_field :email,
                class: "demo-input",
                placeholder: "Enter your email address",
                required: true %>

          </div>


          <!-- COURSE -->

          <div class="demo-field">

            <%= f.label :course, "Select Course" %>

            <%= f.collection_select :course,
                @courses,
                :Course_name,
                :Course_name,
                { prompt: "Choose a course" },
                {
                  class: "demo-select",
                  required: true
                } %>

          </div>


          <!-- BATCH -->

          <div class="demo-field">

            <%= f.label :batch, "Preferred Batch" %>

            <%= f.select :batch,
                [
                  ["Morning", "Morning"],
                  ["Afternoon", "Afternoon"],
                  ["Evening", "Evening"]
                ],
                { prompt: "Select preferred batch" },
                {
                  class: "demo-select",
                  required: true
                } %>

          </div>


          <!-- BATCH TIME -->

          <div class="demo-field">

            <%= f.label :batch_time, "Batch Time" %>

            <%= f.select :batch_time,
                [
                  ["8:00 AM – 10:00 AM", "8:00 AM - 10:00 AM"],
                  ["10:00 AM – 12:00 PM", "10:00 AM - 12:00 PM"],
                  ["2:00 PM – 4:00 PM", "2:00 PM - 4:00 PM"],
                  ["4:00 PM – 6:00 PM", "4:00 PM - 6:00 PM"],
                  ["6:00 PM – 8:00 PM", "6:00 PM - 8:00 PM"]
                ],
                { prompt: "Select batch time" },
                {
                  class: "demo-select",
                  required: true
                } %>

          </div>


          <!-- PREFERRED TIME -->

          <div class="demo-field">

            <%= f.label :preferred_time, "Preferred Time" %>

            <%= f.time_field :preferred_time,
                class: "demo-input",
                required: true %>

          </div>


          <!-- SUBMIT -->

          <div class="demo-submit-wrapper">

            <%= f.submit "Book Free Demo",
                class: "demo-submit-btn" %>

          </div>


        <% end %>


        <div class="demo-security-note">
          Your information is safe with us.
        </div>


      </div>

    </div>

  </div>

</div>