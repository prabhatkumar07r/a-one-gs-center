<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - A ONE GS CENTER</title>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #dfe6ef;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .register-container {
            width: 100%;
            max-width: 1100px;
            min-height: 650px;
            background: white;
            border-radius: 20px;
            overflow: hidden;
            display: flex;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        /* LEFT SIDE */

        .left-side {
            width: 50%;
            background: linear-gradient(135deg, #7b1fe0, #2d6df6);
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
            text-align: center;
        }

        .left-content img {
            width: 120px;
            margin-bottom: 20px;
        }

        .left-content h1 {
            font-size: 48px;
            margin-bottom: 20px;
            font-weight: 700;
        }

        .left-content p {
            font-size: 22px;
            line-height: 1.7;
        }

        /* RIGHT SIDE */

        .right-side {
            width: 50%;
            padding: 50px;
            position: relative;
        }

        .close-btn {
            position: absolute;
            top: 25px;
            right: 25px;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #f1f1f1;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            font-size: 20px;
        }

        .tabs {
            display: flex;
            justify-content: center;
            gap: 40px;
            margin-bottom: 40px;
            border-bottom: 2px solid #eee;
            padding-bottom: 15px;
        }

        .tabs a {
            text-decoration: none;
            font-size: 28px;
            font-weight: 600;
            color: #888;
        }

        .tabs .active {
            color: #7b1fe0;
            border-bottom: 3px solid #7b1fe0;
            padding-bottom: 10px;
        }

        .form-title {
            text-align: center;
            font-size: 52px;
            margin-bottom: 40px;
            background: linear-gradient(135deg, #ff0080, #7b1fe0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 700;
        }

        .form-group {
            margin-bottom: 50px;
            position: relative;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-size: 22px;
            font-weight: 500;
        }

        .form-control {
            width: 100%;
            padding: 70px;
            border: none;
            background: #edf2fb;
            border-radius: 15px;
            font-size: 18px;
        }

        .form-control:focus {
            outline: 2px solid #7b1fe0;
        }

        .form-icon {
            position: absolute;
            top: 55px;
            left: 0px;
            color: #7b1fe0;
            font-size: 18px;
           }

        .btn {
            width: 100%;
            padding: 18px;
            border: none;
            border-radius: 15px;
            background: linear-gradient(135deg, #7b1fe0, #2d6df6);
            color: white;
            font-size: 22px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 15px;
        }

        .btn:hover {
            transform: translateY(-3px);
        }

        .footer-text {
            text-align: center;
            margin-top: 25px;
            font-size: 18px;
        }

        .footer-text a {
            color: #7b1fe0;
            text-decoration: none;
            font-weight: 600;
        }

        @media(max-width: 900px) {

            .register-container {
                flex-direction: column;
            }

            .left-side,
            .right-side {
                width: 100%;
            }

            .left-content h1 {
                font-size: 36px;
            }

            .form-title {
                font-size: 40px;
            }
        }
    </style>
</head>

<body>

    <div class="register-container">

        <!-- LEFT -->

        <div class="left-side">
            <div class="left-content">

            <%= image_tag "logo.jpeg",class:"coaching-icon", alt:"Coaching Icon" %>


                <h1>A ONE GS CENTER</h1>

                <p>
                    Empowering students to excel in
                    Arts through quality education
                    and competitive preparation
                </p>

            </div>
        </div>

        <!-- RIGHT -->

        <div class="right-side">

            <div class="close-btn">
                <i class="fas fa-times"></i>
            </div>

            <div class="tabs">
    <a href="/sample/login">Login</a>
    <a href="/sample/registration" class="active">Register</a>
</div>

            <%# <h2 class="form-title">Create Account</h2> %>
           <h2 class="form-title">Create Account</h2>

<% if @student && @student.errors.any? %>

  <% @student.errors.full_messages.each do |message| %>

    <p><%= message %></p>

  <% end %>

<% end %>


            <form action="/sample/create" method="post">

                <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

                <div class="form-group">
                    <label>Full Name</label>
                    <i class="fas fa-user form-icon"></i>

                    <input type="text"
                        name="name"
                        class="form-control"
                        placeholder="Enter your full name"
                        required>
                </div>

                <div class="form-group">
                    <label>Email Address</label>
                    <i class="fas fa-envelope form-icon"></i>

                    <input type="email"
                        name="email"
                        class="form-control"
                        placeholder="Enter your email"
                        required>
                </div>
                 <div class="form-group">
                      <label>Mobile Number</label>

                   <i class="fas fa-phone form-icon"></i>

                  <input type="tel"
                   name="mobile"
                   class="form-control"
                   placeholder="Enter your Mobile Number"
                   required>
                   </div>



                <div class="form-group">
                    <label>Password</label>
                    <i class="fas fa-lock form-icon"></i>

                    <input type="password"
                        name="password"
                        class="form-control"
                        placeholder="Create password"
                        required>
                </div>
                <div class="form-group">
                    <label>Confirm_Password</label>
                    <i class="fas fa-lock form-icon"></i>
                    <input type="password"name="confirm_password" class="form-control" placeholder=" Confirm Password">
                </div>
<%# 
                <!-- YAHAN PE ROLE FIELD ADD KARO -->
               <div class="form-group">
                   <label>Select Role</label>
                   <i class="fas fa-user-tag form-icon"></i>
                   <select name="role" class="form-control" required>
                   <option value="student">Student</option>
                   <option value="teacher">Teacher</option>
                   <option value="admin">Admin</option>
              </select>
             </div> %>

                <button type="submit" class="btn">
                    Create Account
                </button>

            </form>

            <div class="footer-text">
                Already have an account?
                <a href="/sample/login">Login now</a>
            </div>

        </div>

    </div>

</body>

</html>