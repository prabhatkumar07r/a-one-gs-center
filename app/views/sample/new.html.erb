<% if notice %>
  <p style="color: green;">
    <%= notice %>
  </p>
<% end %>
<% if alert %>
  <p style="color: red;"><%= alert %></p>
<% end %>

<h1>Login Page</h1>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
  }

  .f2{
    margin-bottom: 15px;
    width: 300px;
    margin: auto;
  }

  .L1{
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
  }

  input{
    width: 100%;
    padding: 10px;
    border: 1px solid oklch(84.522% 0.0001 271.152);
    border-radius: 5px;
  }

  button{
    width: 100px;
    padding: 10px;
    border: none;
    background: hsl(221, 83%, 53%);
    color: #fff;
    border-radius: 5px;
    cursor: pointer;
  }
</style>

<%= form_with url: user_session_path, scope: :user, local: true, class: "f2" do |f| %>

  <label class="L1">Email</label>
  <%= f.email_field :email, required: true %>

  <label class="L1">Password</label>
  <%= f.password_field :password, required: true %>

  <div style="margin-bottom:15px;">
    <%= f.check_box :remember_me %>
    <%= f.label :remember_me %>
  </div>

  <%= f.submit "Login", class: "btn" %>

  <br><br>

  <%= link_to "Forgot Password?", new_user_password_path %>

  <br><br>

  <%= link_to "Create Account", new_user_registration_path %>

<% end %>