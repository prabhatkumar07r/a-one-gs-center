        Empowering Students to Learn, Prepare & Succeed
      </p>

<div class="hero-features">
    <span>🎓 Expert Faculty</span>
    <span>📚 Weekly Test Series</span>
    <span>💻 Online & Offline Classes</span>
</div>
      <div class="hero-social">

 <%#  <a href="https://www.linkedin.com/in/YOUR_LINKEDIN"
     target="_blank"
     class="linkedin">
      <i class="fab fa-linkedin-in"></i>
  </a> %>

  <a href="https://youtube.com/@aonegs77?si=eYbHZlwjBYCkezd8"
     target="_blank"
     class="youtube">
      <i class="fab fa-youtube"></i>
  </a>

  <a href="https://www.instagram.com/atsirshorts?igsh=M2dlZ3p6dnB2cDd1"
     target="_blank"
     class="instagram">
      <i class="fab fa-instagram"></i>
  </a>

</div>

      <div class="hero-buttons">
        <%= link_to "Explore Courses", "#courses", class: "btn" %>
        <%= link_to "Contact Us", "#contact", class: "btn btn-outline" %>
      </div>

    </div>
  </div>
</section>

    <!-- Features  -->
    <section class="features" id="features">
        <div class="container">
            <h2 class="section-title">Why Choose Us</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <i class="fas fa-chalkboard-teacher feature-icon"></i>
                    <h3>Expert Faculty</h3>
                    <p>Learn from highly qualified and experienced teachers who have successfully guided students in many competitive exams like  SSC, Bihar Police, Railway, Banking, and NDA.</p>
                </div>
                <div class="feature-card">
                    <i class="fas fa-book-open feature-icon"></i>
                    <h3>Study Materials</h3>
                    <p>Comprehensive study materials and practice problems.</p>
                </div>
                <div class="feature-card">
                    <i class="fas fa-clipboard-check feature-icon"></i>
                    <h3>Regular Tests</h3>
                    <p>Weekly tests and performance analysis to track progress.</p>
                </div>
                <div class="feature-card">
                    <i class="fas fa-laptop feature-icon"></i>
                    <h3>Online Portal</h3>
                    <p>Access lessons, assignments and tests through our online portal.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- About  -->
    <section class="about-section" id="about">
        <div class="container">
            <h2 class="section-title">Our Achievements</h2>
           <div class="toppers-container">

  <% if @achievements.present? %>

    <% @achievements.each do |achievement| %>

      <div class="topper-card">

        <% if achievement.photo.attached? %>
          <%= image_tag achievement.photo, class: "topper-image" %>
        <% end %>

        <div class="topper-info">
          <h4><%= achievement.title %></h4>
          <p><%= achievement.rank %></p>
          <small><%= achievement.year %></small>
          <p><%= achievement.description %></p>
        </div>

      </div>
    <% end %>

  <% else %>

    <p class="text-center">No achievements available.</p>

  <% end %>

</div>
             <div class="collage">
              <% @events.limit(6).each do |event| %>
              <div class="event-card">
              <% if event.photo.attached? %>
              <%= image_tag event.photo, alt: event.title %>
           <% else %>
             <%= image_tag "default-event.jpg", alt: "No Image" %>
           <% end %>

          <h5><%= event.title %></h5>
         </div>
       <% end %>
        </div>
            <div class="goal-quote">
                <strong>🎯 Our Goal</strong>
                <p>"Har student ko strong foundation ke sath unke sapne ke career tak pahunchana."</p>
                <p>"Agle saalon me aur zyada district aur state toppers dena."</p>
            </div>
            <div class="about-cta">
                <div class="highlight-box">
                    <h3>Quick Facts</h3>
                    <ul>
                        <li>Founded: 2017</li>
                        <li>Batch Size: Limited seats</li>
                        <li>Test Series: Weekly + Monthly</li>
                        <li>Subjects: History • Geography • Political Science • Economics</li>
                    </ul>
                      <%= link_to "Join a Demo Class",
    new_demo_request_path,
    class: "btn demo-btn" %>
                </div>
                <div class="highlight-img">
                    <img src="Coaching_logo.jpeg" alt="Highlight Image">
                </div>
            </div>
        </div>
    </section>


  <!-- Notification  -->

<!-- Notification -->
<section class="notifications" id="notifications">
  <div class="container">

    <h2 class="section-title">
      <i class="fas fa-bell"></i> Latest Notifications
    </h2>

    <div class="notif-showcase">
      <div class="ticker-glass-panel">

        <div class="notification-ticker-container">
          <div class="notification-ticker">

            <% if @notifications.present? %>

              <% @notifications.each do |notification| %>

                <div class="notification-card">

                  <h5>
                    <i class="fas fa-bullhorn text-danger"></i>
                    <%= notification.title %>
                  </h5>

                  <p>
                    <%= truncate(notification.description, length: 120) %>
                  </p>

                  <p>
                    <strong>📅 Start:</strong>
                    <%= notification.start_date.strftime("%d %b %Y") if notification.start_date.present? %>
                  </p>

                  <p>
                    <strong>📅 End:</strong>
                    <%= notification.end_date.strftime("%d %b %Y") if notification.end_date.present? %>
                  </p>

                 <%#  <p>
                    <span class="badge bg-success">
                      <%= notification.status %>
                    <%# </span> %>
                  <%# </p>  %>

                  <small class="text-muted">
                    <i class="fas fa-calendar-alt"></i>
                    Posted:
                    <%= notification.created_at.strftime("%d %b %Y") %>
                  </small>

                </div>

              <% end %>

            <% else %>

              <div class="alert alert-info text-center">
                No latest notifications available.
              </div>

            <% end %>

          </div>
        </div>

      </div>
    </div>

  </div>
</section>

  <!-- Gallery  -->
    <section class="gallery" id="gallery">

  <div class="container">

    <h2 class="section-title">Gallery</h2>

    <div class="gallery-container">

      <div class="gallery-slider">

       <% @galleries.each_with_index do |gallery, index| %>

      <% if gallery.photos.attached? %>
      <% gallery.photos.each do |photo| %>
      <%= image_tag photo,
        width: 200,
        class: "img-thumbnail" %>
     <% end %>
   <% else %>
  <p>No photos uploaded.</p>
<% end %>
<% end %>

      </div>

      <button class="gallery-nav gallery-prev">
        <i class="fas fa-chevron-left"></i>
      </button>

      <button class="gallery-nav gallery-next">
        <i class="fas fa-chevron-right"></i>
      </button>

      <div class="gallery-dots"></div>

    </div>

  </div>

</section>



<!-- Courses -->
<section class="courses" id="courses">
  <div class="container">

    <h2 class="section-title">Our Courses</h2>

    <div class="course-grid">

      <% @courses.each do |course| %>

       <div class="course-card">

  <!-- Course Image -->
     <% if course.respond_to?(:image) && course.image.attached? %>

  <%= image_tag course.image, class: "course-image" %>

<% else %>

  <div class="course-placeholder">
    <h3><%= course.Course_name %></h3>
  </div>

<% end %>

  <div class="course-info">

    <!-- Course Name -->
    <h3 class="course-title">
      <%= course.Course_name %>
    </h3>

    <!-- Rating -->
    <div class="course-rating">
      ⭐ 4.8
      <span>(250 Students)</span>
    </div>

    <!-- Duration -->
    <div class="course-meta">

      <span>
        <i class="fas fa-clock"></i>
        <%= course.duration %>
      </span>

      <span>
        <i class="fas fa-users"></i>
        Limited Seats
      </span>

    </div>

    <!-- Price -->
    <!-- Price -->
<div class="course-price-container">

  <% if course.original_fee.present? && course.original_fee > course.fee %>

    <span class="original-price">
      ₹<%= number_with_delimiter(course.original_fee) %>
    </span>

    <span class="discounted-price">
      ₹<%= number_with_delimiter(course.fee) %>
    </span>

    <span class="discount-badge">
      <%= course.discount_percentage %>% OFF
    </span>

  <% else %>

    <span class="discounted-price">
      ₹<%= number_with_delimiter(course.fee) %>
    </span>

  <% end %>

</div>

    <!-- Buttons -->
    <div class="course-buttons">

  <%= link_to "📖 View Course",
      course_details_path(course),
      class: "btn btn-primary w-100 mb-2" %>


  <%= link_to "📝 Enroll Now",
      new_enrollment_path(course_id: course.id),
      class: "btn btn-success w-100" %>

</div>

  </div>

</div>

      <% end %>

    </div>

  </div>
</section>
    <!-- Teachers  -->
   <section class="teachers" id="teachers">

  <div class="container">

    <h2 class="section-title">Our Expert Faculty</h2>

    <div class="teacher-grid">

      <% @teachers.each do |teacher| %>

        <div class="teacher-card">

          <% if teacher.photo.attached? %>

           <%= image_tag teacher.photo, class: "teacher-img" %>

           <% else %>

             <img src="https://placehold.co/300x300?text=Teacher"
              class="teacher-img">

           <% end %>

          <div class="teacher-info">

            <h3><%= teacher.name %></h3>

            <p class="subject">
              <%= teacher.subject %>
            </p>

            <p>

              <strong>Qualification:</strong>

              <%= teacher.qualification %>

            </p>

            <p>

              <strong>Designation:</strong>

              <%= teacher.designation %>

            </p>

            <p>

              <strong>Experience:</strong>

              <%= teacher.experience %> Years

            </p>

            <p>

              <%= truncate(teacher.bio, length: 100) %>

            </p>

            <div class="social-links">

              <% if teacher.facebook.present? %>
                <%= link_to teacher.facebook, target: "_blank" do %>
                  <i class="fab fa-facebook-f"></i>
                <% end %>
              <% end %>

              <% if teacher.instagram.present? %>
                <%= link_to teacher.instagram, target: "_blank" do %>
                  <i class="fab fa-instagram"></i>
                <% end %>
              <% end %>

              <% if teacher.linkedin.present? %>
                <%= link_to teacher.linkedin, target: "_blank" do %>
                  <i class="fab fa-linkedin-in"></i>
                <% end %>
              <% end %>

              <% if teacher.gmail.present? %>
                <%= mail_to teacher.gmail do %>
                  <i class="fas fa-envelope"></i>
                <% end %>
              <% end %>

            </div>

          </div>

        </div>

      <% end %>

    </div>

  </div>

</section>

