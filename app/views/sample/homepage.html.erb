                    <p>Learn from highly qualified and experienced teachers who have successfully guided students in many competitive exams like  SSC, Bihar Police, Railway, Banking, and NDA.</p>
                </div>
                <div class="feature-card">
                    <i class="fas fa-book-open feature-icon"></i>
                    <h3>Study Materials</h3>
                    <p>Comprehensive study materials and practice problems.</p>
                </div>
                <div class="feature-card">
                    <i class="fas fa-clipboard-check feature-icon"></i>
                    <h3>Regular Tests</h3>
                    <p>Weekly tests and performance analysis to track progress.</p>
                </div>
                <div class="feature-card">
                    <i class="fas fa-laptop feature-icon"></i>
                    <h3>Online Portal</h3>
                    <p>Access lessons, assignments and tests through our online portal.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- About  -->
    <section class="about-section" id="about">
        <div class="container">
            <h2 class="section-title">Our Achievements</h2>
           <div class="toppers-container">

  <% if @achievements.present? %>

    <% @achievements.each do |achievement| %>

      <div class="topper-card">

        <% if achievement.photo.attached? %>
          <%= image_tag achievement.photo, class: "topper-image" %>
        <% end %>

        <div class="topper-info">
          <h4><%= achievement.title %></h4>
          <p><%= achievement.rank %></p>
          <small><%= achievement.year %></small>
          <p><%= achievement.description %></p>
        </div>

      </div>
    <% end %>

  <% else %>

    <p class="text-center">No achievements available.</p>

  <% end %>

</div>
             <div class="collage">
              <% @events.limit(6).each do |event| %>
              <div class="event-card">
              <% if event.photo.attached? %>
              <%= image_tag event.photo, alt: event.title %>
           <% else %>
             <%= image_tag "default-event.jpg", alt: "No Image" %>
           <% end %>

          <h5><%= event.title %></h5>
         </div>
       <% end %>
        </div>
            <div class="goal-quote">
