<style>
/* =========================================================
   A ONE GS CENTER
   HOMEPAGE - COMPLETE MASTER CSS
   PURPLE GLASS THEME
   MAIN BACKGROUND: #8009e2
========================================================= */

/* =========================================================
   1. GLOBAL VARIABLES
========================================================= */

:root {
    --page-bg: #8009e2;

    --purple: #8009e2;
    --purple-dark: #5b08a8;
    --purple-light: #b86cff;

    --blue: #2563eb;
    --blue-light: #60a5fa;

    --orange: #ff8c00;
    --green: #10b981;

    --white: #ffffff;
    --text: #ffffff;
    --text-soft: rgba(255, 255, 255, 0.88);
    --text-muted: rgba(255, 255, 255, 0.70);

    --glass: rgba(255, 255, 255, 0.10);
    --glass-light: rgba(255, 255, 255, 0.14);
    --glass-dark: rgba(30, 0, 55, 0.22);

    --border: rgba(255, 255, 255, 0.20);

    --shadow:
        0 20px 60px rgba(30, 0, 50, 0.25);

    --shadow-heavy:
        0 30px 80px rgba(30, 0, 50, 0.35);
}


/* =========================================================
   2. GLOBAL RESET
========================================================= */

html,
body {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;

    overflow-x: hidden;

    scroll-behavior: smooth;

    background: var(--page-bg);

    color: var(--text);

    font-family: "Poppins", sans-serif;
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

body {
    min-height: 100vh;

    background:
        radial-gradient(
            circle at 15% 10%,
            rgba(255, 255, 255, 0.12),
            transparent 28%
        ),
        radial-gradient(
            circle at 85% 30%,
            rgba(255, 255, 255, 0.08),
            transparent 30%
        ),
        #8009e2;
}

img {
    max-width: 100%;
    height: auto;
}

section {
    width: 100%;
    max-width: 100%;

    position: relative;

    overflow: hidden;

    background: transparent;
}

button,
input,
textarea,
select {
    font: inherit;
}

a {
    text-decoration: none;
}

.container {
    width: 100%;
    max-width: 1250px;

    margin-left: auto;
    margin-right: auto;

    padding-left: 20px;
    padding-right: 20px;
}


/* =========================================================
   3. COMMON GLASS
========================================================= */

.glass {
    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    box-shadow: var(--shadow);
}


/* =========================================================
   4. SECTION TITLE
========================================================= */

.section-title {
    position: relative;

    width: 100%;

    margin: 0 0 50px;

    text-align: center;

    color: #ffffff;

    font-size: clamp(32px, 4vw, 48px);

    font-weight: 800;

    line-height: 1.2;

    text-shadow:
        0 4px 20px rgba(40, 0, 70, 0.35);
}

.section-title::after {
    content: "";

    display: block;

    width: 75px;
    height: 4px;

    margin: 16px auto 0;

    border-radius: 20px;

    background:
        linear-gradient(
            90deg,
            #ffffff,
            #d8b4fe
        );

    box-shadow:
        0 0 15px rgba(255, 255, 255, 0.45);
}


/* =========================================================
   5. HERO
========================================================= */

.hero {
    position: relative;

    width: 100%;

    min-height: 100vh;
    min-height: 100svh;

    display: flex;

    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 80px 24px;

    background:
        radial-gradient(
            circle at 50% 20%,
            rgba(255, 255, 255, 0.15),
            transparent 35%
        ),
        linear-gradient(
            180deg,
            rgba(80, 0, 140, 0.18),
            rgba(128, 9, 226, 0.02)
        );
}

.hero::before {
    content: "";

    position: absolute;

    width: 500px;
    height: 500px;

    top: -250px;
    left: -180px;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.08);

    filter: blur(80px);

    pointer-events: none;
}

.hero::after {
    content: "";

    position: absolute;

    width: 500px;
    height: 500px;

    right: -220px;
    bottom: -250px;

    border-radius: 50%;

    background: rgba(30, 0, 70, 0.18);

    filter: blur(90px);

    pointer-events: none;
}

.hero .container {
    position: relative;

    z-index: 2;

    width: 100%;
    max-width: 1400px;
}

.hero-content {
    width: 100%;
    max-width: 1400px;

    margin: 0 auto;
}


/* =========================================================
   6. HERO LOGO
========================================================= */

.hero-logo {
    display: block;

    width: min(90vw, 1100px);

    max-width: 100%;

    height: auto;

    margin: 0 auto;

    object-fit: contain;

    background: transparent;

    border: none;

    border-radius: 0;

    filter:
        drop-shadow(
            0 20px 40px rgba(35, 0, 65, 0.40)
        );

    animation: floatLogo 5s ease-in-out infinite;

    transition: transform 0.4s ease;
}

.hero-logo:hover {
    transform: scale(1.03);
}

@keyframes floatLogo {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }
}


/* =========================================================
   7. HERO SUBTITLE
========================================================= */

.hero-subtitle {
    width: 100%;
    max-width: 900px;

    margin: 28px auto 0;

    color: #ffffff;

    font-size: clamp(18px, 2.2vw, 28px);

    font-weight: 600;

    line-height: 1.5;

    letter-spacing: 1px;

    text-shadow:
        0 4px 15px rgba(30, 0, 60, 0.30);
}


/* =========================================================
   8. HERO FEATURES
========================================================= */

.hero-features {
    width: 100%;
    max-width: 1000px;

    display: flex;

    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 12px;

    margin: 32px auto;
}

.hero-features span {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    max-width: 100%;

    padding: 11px 18px;

    color: #ffffff;

    background: rgba(255, 255, 255, 0.12);

    border: 1px solid rgba(255, 255, 255, 0.24);

    border-radius: 50px;

    font-size: 14px;

    font-weight: 600;

    line-height: 1.4;

    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);

    box-shadow:
        0 8px 25px rgba(30, 0, 60, 0.16);

    transition:
        background 0.3s ease,
        transform 0.3s ease;
}

.hero-features span:hover {
    background: rgba(255, 255, 255, 0.20);

    transform: translateY(-3px);
}


/* =========================================================
   9. HERO SOCIAL
========================================================= */

.hero-social {
    display: flex;

    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 18px;

    margin: 32px 0;
}

.hero-social a {
    width: 56px;
    height: 56px;

    flex: 0 0 56px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    font-size: 24px;

    color: #ffffff;

    background: rgba(255, 255, 255, 0.10);

    border: 2px solid rgba(255, 255, 255, 0.30);

    backdrop-filter: blur(10px);

    transition:
        transform 0.35s ease,
        background 0.35s ease,
        box-shadow 0.35s ease;
}

.hero-social a:hover {
    transform: translateY(-6px) scale(1.08);

    background: rgba(255, 255, 255, 0.20);

    box-shadow:
        0 15px 35px rgba(30, 0, 60, 0.25);
}

.hero-social .youtube {
    color: #ffdddd;

    border-color: #ff5c5c;
}

.hero-social .instagram {
    color: #ffd2e2;

    border-color: #ff6b9a;
}


/* =========================================================
   10. HERO BUTTONS
========================================================= */

.hero-buttons {
    width: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 15px;

    margin-top: 35px;
}

.hero-buttons .btn {
    min-width: 170px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 14px 30px;

    color: #ffffff;

    background: #ff8c00;

    border: 2px solid transparent;

    border-radius: 10px;

    font-size: 15px;

    font-weight: 700;

    box-shadow:
        0 12px 30px rgba(60, 0, 90, 0.18);

    transition:
        background 0.3s ease,
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.hero-buttons .btn:hover {
    background: #ff6b00;

    color: #ffffff;

    transform: translateY(-3px);

    box-shadow:
        0 15px 35px rgba(255, 140, 0, 0.30);
}

.hero-buttons .btn-outline {
    background: rgba(255, 255, 255, 0.08);

    border: 2px solid rgba(255, 255, 255, 0.75);

    backdrop-filter: blur(8px);
}

.hero-buttons .btn-outline:hover {
    background: #ffffff;

    color: #8009e2;
}


/* =========================================================
   11. FEATURES
========================================================= */

.features {
    width: 100%;

    padding: 100px 0;

    background:
        linear-gradient(
            180deg,
            rgba(91, 8, 168, 0.10),
            rgba(255, 255, 255, 0.04)
        );
}

.features-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 24px;
}

.feature-card {
    min-width: 0;

    padding: 32px 25px;

    text-align: center;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 20px;

    box-shadow: var(--shadow);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    transition:
        transform 0.3s ease,
        background 0.3s ease,
        border-color 0.3s ease;
}

.feature-card:hover {
    transform: translateY(-8px);

    background: rgba(255, 255, 255, 0.15);

    border-color: rgba(255, 255, 255, 0.35);
}

.feature-icon {
    display: block;

    margin-bottom: 20px;

    color: #ffffff;

    font-size: 42px;

    text-shadow:
        0 5px 20px rgba(30, 0, 60, 0.30);
}

.feature-card h3 {
    margin: 0 0 14px;

    color: #ffffff;

    font-size: 20px;

    font-weight: 700;
}

.feature-card p {
    margin: 0;

    color: rgba(255, 255, 255, 0.78);

    font-size: 14px;

    line-height: 1.8;
}


/* =========================================================
   12. ABOUT / ACHIEVEMENTS
========================================================= */

.about-section {
    padding: 100px 0;

    background:
        linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.04),
            rgba(91, 8, 168, 0.12)
        );
}

.toppers-container {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 25px;

    margin-bottom: 50px;
}

.topper-card {
    overflow: hidden;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 20px;

    box-shadow: var(--shadow);

    backdrop-filter: blur(14px);

    transition:
        transform 0.3s ease,
        background 0.3s ease;
}

.topper-card:hover {
    transform: translateY(-6px);

    background: rgba(255, 255, 255, 0.15);
}

.topper-image {
    display: block;

    width: 100%;

    height: 260px;

    object-fit: cover;
}

.topper-info {
    padding: 22px;
}

.topper-info h4 {
    margin: 0 0 8px;

    color: #ffffff;

    font-size: 20px;
}

.topper-info p {
    margin: 7px 0;

    color: rgba(255, 255, 255, 0.80);

    font-size: 14px;

    line-height: 1.6;
}

.topper-info small {
    color: #ead7ff;
}


/* =========================================================
   13. EVENTS
========================================================= */

.collage {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 20px;

    margin-bottom: 45px;
}

.event-card {
    overflow: hidden;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 18px;

    backdrop-filter: blur(12px);

    box-shadow: var(--shadow);
}

.event-card img {
    display: block;

    width: 100%;

    height: 220px;

    object-fit: cover;
}

.event-card h5 {
    margin: 0;

    padding: 15px;

    color: #ffffff;

    font-size: 15px;
}


/* =========================================================
   14. GOAL
========================================================= */

.goal-quote {
    max-width: 850px;

    margin: 0 auto 45px;

    padding: 35px;

    text-align: center;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.22);

    border-radius: 20px;

    backdrop-filter: blur(14px);

    box-shadow: var(--shadow);
}

.goal-quote strong {
    display: block;

    margin-bottom: 15px;

    color: #ffffff;

    font-size: 20px;
}

.goal-quote p {
    margin: 10px 0;

    color: rgba(255, 255, 255, 0.82);

    font-size: 16px;

    line-height: 1.7;
}


/* =========================================================
   15. ABOUT CTA
========================================================= */

.about-cta {
    display: grid;

    grid-template-columns:
        1fr
        1fr;

    gap: 35px;

    align-items: center;
}

.highlight-box {
    padding: 30px;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 20px;

    backdrop-filter: blur(14px);

    box-shadow: var(--shadow);
}

.highlight-box h3 {
    margin: 0 0 20px;

    color: #ffffff;

    font-size: 24px;
}

.highlight-box ul {
    margin: 0 0 25px;

    padding-left: 20px;
}

.highlight-box li {
    margin-bottom: 12px;

    color: rgba(255, 255, 255, 0.78);

    line-height: 1.6;
}

.demo-btn {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 12px 22px;

    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            #5b08a8,
            #9c27ff
        );

    border-radius: 10px;

    font-weight: 700;

    box-shadow:
        0 10px 25px rgba(50, 0, 90, 0.25);

    transition:
        transform 0.25s ease;
}

.demo-btn:hover {
    color: #ffffff;

    transform: translateY(-2px);
}

.highlight-img {
    display: flex;

    align-items: center;
    justify-content: center;

    min-height: 300px;

    padding: 30px;

    background: rgba(255, 255, 255, 0.08);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 20px;

    backdrop-filter: blur(14px);

    box-shadow: var(--shadow);
}

.highlight-img img {
    max-width: 450px;

    width: 100%;

    object-fit: contain;
}


/* =========================================================
   16. NOTIFICATIONS
========================================================= */

.notifications {
    padding: 100px 0;

    background:
        linear-gradient(
            180deg,
            rgba(91, 8, 168, 0.12),
            rgba(255, 255, 255, 0.04)
        );
}

.notif-showcase {
    width: 100%;
}

.ticker-glass-panel {
    position: relative;

    width: 100%;

    padding: 25px;

    overflow: hidden;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.22);

    border-radius: 22px;

    box-shadow: var(--shadow-heavy);

    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
}

.notification-ticker-container {
    width: 100%;

    overflow: hidden;

    position: relative;
}

.notification-ticker-container::before,
.notification-ticker-container::after {
    content: "";

    position: absolute;

    top: 0;

    bottom: 0;

    width: 90px;

    z-index: 5;

    pointer-events: none;
}

.notification-ticker-container::before {
    left: 0;

    background:
        linear-gradient(
            90deg,
            rgba(104, 4, 180, 0.75),
            transparent
        );
}

.notification-ticker-container::after {
    right: 0;

    background:
        linear-gradient(
            270deg,
            rgba(104, 4, 180, 0.75),
            transparent
        );
}

.notification-ticker {
    width: max-content;

    display: flex;

    align-items: stretch;

    gap: 20px;

    will-change: transform;

    animation:
        notificationScroll 35s linear infinite;
}

.notification-ticker:hover {
    animation-play-state: paused;
}

.notification-card {
    width: 330px;

    min-width: 330px;

    padding: 24px;

    background: rgba(255, 255, 255, 0.12);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 17px;

    box-shadow:
        0 15px 40px rgba(40, 0, 80, 0.20);

    backdrop-filter: blur(12px);

    transition:
        transform 0.3s ease,
        background 0.3s ease;
}

.notification-card:hover {
    transform: translateY(-5px);

    background: rgba(255, 255, 255, 0.18);
}

.notification-card h5 {
    margin: 0 0 14px;

    color: #ffffff;

    font-size: 17px;
}

.notification-card h5 i {
    margin-right: 7px;

    color: #ffd166;
}

.notification-card p {
    margin: 9px 0;

    color: rgba(255, 255, 255, 0.78);

    font-size: 13px;

    line-height: 1.7;
}

.notification-card strong {
    color: #ffffff;
}

.notification-card small {
    display: block;

    margin-top: 15px;

    color: rgba(255, 255, 255, 0.58) !important;
}

@keyframes notificationScroll {

    0% {
        transform: translateX(0);
    }

    100% {
        transform: translateX(-50%);
    }
}


/* =========================================================
   17. GALLERY
========================================================= */

.gallery {
    padding: 100px 0;

    background:
        linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.04),
            rgba(91, 8, 168, 0.10)
        );
}

.gallery-container {
    position: relative;

    width: 100%;

    padding: 20px;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 22px;

    backdrop-filter: blur(14px);

    box-shadow: var(--shadow);

    overflow: hidden;
}

.gallery-slider {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 18px;
}

.gallery-slider img {
    display: block;

    width: 100%;

    height: 220px;

    object-fit: cover;

    padding: 0 !important;

    background: rgba(255, 255, 255, 0.05);

    border: 1px solid rgba(255, 255, 255, 0.20) !important;

    border-radius: 14px !important;

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.gallery-slider img:hover {
    transform: scale(1.03);

    box-shadow:
        0 15px 35px rgba(30, 0, 60, 0.30);
}

.gallery-nav {
    position: absolute;

    top: 50%;

    width: 45px;
    height: 45px;

    display: flex;

    align-items: center;
    justify-content: center;

    transform: translateY(-50%);

    color: #ffffff;

    background: rgba(70, 0, 120, 0.65);

    border: 1px solid rgba(255, 255, 255, 0.25);

    border-radius: 50%;

    cursor: pointer;

    z-index: 10;

    backdrop-filter: blur(10px);

    transition:
        background 0.25s ease,
        transform 0.25s ease;
}

.gallery-nav:hover {
    background: rgba(255, 255, 255, 0.20);

    transform:
        translateY(-50%)
        scale(1.08);
}

.gallery-prev {
    left: 10px;
}

.gallery-next {
    right: 10px;
}

.gallery-dots {
    display: flex;

    justify-content: center;

    gap: 7px;

    margin-top: 20px;
}


/* =========================================================
   18. COURSES
========================================================= */

.courses {
    position: relative;

    width: 100%;

    padding: 100px 0;

    background:
        radial-gradient(
            circle at 50% 0%,
            rgba(255, 255, 255, 0.10),
            transparent 35%
        );
}

.course-grid {
    width: 100%;

    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 30px;

    align-items: stretch;
}

.course-card {
    min-width: 0;

    display: flex;

    flex-direction: column;

    overflow: hidden;

    background: rgba(255, 255, 255, 0.11);

    border: 1px solid rgba(255, 255, 255, 0.22);

    border-radius: 21px;

    box-shadow:
        0 20px 50px rgba(40, 0, 80, 0.25);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    transition:
        transform 0.3s ease,
        border-color 0.3s ease,
        background 0.3s ease;
}

.course-card:hover {
    transform: translateY(-7px);

    border-color: rgba(255, 255, 255, 0.40);

    background: rgba(255, 255, 255, 0.16);
}

.course-image {
    display: block;

    width: 100%;

    height: 285px;

    object-fit: cover;

    background: rgba(0, 0, 0, 0.10);

    border: none;

    margin: 0;

    padding: 0;
}

.course-placeholder {
    width: 100%;

    height: 285px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 30px;

    text-align: center;

    background:
        radial-gradient(
            circle at center,
            rgba(255, 255, 255, 0.13),
            transparent 65%
        ),
        rgba(70, 0, 120, 0.20);
}

.course-placeholder h3 {
    margin: 0;

    color: #ffffff;

    font-size: 25px;

    font-weight: 700;

    line-height: 1.4;
}

.course-info {
    flex: 1;

    display: flex;

    flex-direction: column;

    padding: 30px;
}

.course-title {
    min-height: 78px;

    margin: 0 0 16px;

    color: #ffffff;

    font-size: 27px;

    font-weight: 800;

    line-height: 1.35;
}

.course-rating {
    margin-bottom: 20px;

    color: #ffd166;

    font-size: 15px;

    font-weight: 700;
}

.course-rating span {
    color: rgba(255, 255, 255, 0.72);

    font-weight: 500;
}

.course-meta {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 15px;

    padding: 18px 0;

    border-top: 1px solid rgba(255, 255, 255, 0.20);

    border-bottom: 1px solid rgba(255, 255, 255, 0.20);
}

.course-meta span {
    color: rgba(255, 255, 255, 0.72);

    font-size: 14px;

    white-space: nowrap;
}

.course-meta i {
    margin-right: 6px;

    color: #ffffff;
}

.course-price-container {
    min-height: 70px;

    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 14px;

    padding: 15px 0;
}

.original-price {
    color: rgba(255, 255, 255, 0.50);

    font-size: 15px;

    text-decoration: line-through;
}

.discounted-price {
    color: #ffffff;

    font-size: 28px;

    font-weight: 800;
}

.discount-badge {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 8px 10px;

    color: #ffffff;

    background: rgba(16, 185, 129, 0.30);

    border: 1px solid rgba(255, 255, 255, 0.12);

    border-radius: 7px;

    font-size: 12px;

    font-weight: 700;
}

.course-buttons {
    margin-top: auto;

    padding-top: 15px;
}

.course-buttons .btn {
    min-height: 52px;

    display: flex;

    align-items: center;
    justify-content: center;

    width: 100%;

    border: none !important;

    border-radius: 10px !important;

    font-size: 15px;

    font-weight: 700;

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.course-buttons .btn:hover {
    transform: translateY(-2px);
}

.course-buttons .btn-primary {
    background:
        linear-gradient(
            135deg,
            #5b08a8,
            #9c27ff
        ) !important;

    color: #ffffff !important;

    box-shadow:
        0 10px 25px rgba(60, 0, 100, 0.25);
}

.course-buttons .btn-success {
    background:
        linear-gradient(
            135deg,
            #059669,
            #10b981
        ) !important;

    color: #ffffff !important;
}


/* =========================================================
   19. TEACHERS
========================================================= */

.teachers {
    padding: 100px 0;

    background:
        linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.04),
            rgba(91, 8, 168, 0.10)
        );
}

.teacher-grid {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 28px;
}

.teacher-card {
    overflow: hidden;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 20px;

    box-shadow: var(--shadow);

    backdrop-filter: blur(14px);

    transition:
        transform 0.3s ease,
        background 0.3s ease;
}

.teacher-card:hover {
    transform: translateY(-7px);

    background: rgba(255, 255, 255, 0.15);
}

.teacher-img {
    display: block;

    width: 100%;

    height: 300px;

    object-fit: cover;

    background: rgba(0, 0, 0, 0.10);
}

.teacher-info {
    padding: 25px;
}

.teacher-info h3 {
    margin: 0 0 5px;

    color: #ffffff;

    font-size: 22px;
}

.teacher-info .subject {
    margin: 0 0 18px;

    color: #ead7ff;

    font-weight: 600;
}

.teacher-info p {
    color: rgba(255, 255, 255, 0.75);

    font-size: 13px;

    line-height: 1.7;
}

.teacher-info strong {
    color: #ffffff;
}

.social-links {
    display: flex;

    flex-wrap: wrap;

    gap: 10px;

    margin-top: 20px;
}

.social-links a {
    width: 38px;
    height: 38px;

    display: flex;

    align-items: center;
    justify-content: center;

    color: #ffffff;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 50%;

    transition:
        background 0.25s ease,
        transform 0.25s ease;
}

.social-links a:hover {
    background: rgba(255, 255, 255, 0.22);

    transform: translateY(-3px);
}


/* =========================================================
   20. FOUNDER
========================================================= */

.founder {
    padding: 100px 0;

    background:
        radial-gradient(
            circle at 20% 50%,
            rgba(255, 255, 255, 0.08),
            transparent 35%
        );
}

.founder-grid {
    display: grid;

    grid-template-columns:
        minmax(300px, 0.8fr)
        minmax(0, 1.2fr);

    gap: 60px;

    align-items: center;
}

.founder-image {
    display: flex;

    justify-content: center;

    padding: 20px;
}

.founder-photo {
    width: 100%;

    max-width: 450px;

    border-radius: 22px;

    object-fit: cover;

    border: 1px solid rgba(255, 255, 255, 0.25);

    box-shadow: var(--shadow-heavy);
}

.founder-content h3 {
    margin: 0 0 20px;

    color: #ffffff;

    font-size: 42px;

    font-weight: 800;
}

.founder-content p {
    color: rgba(255, 255, 255, 0.78);

    font-size: 15px;

    line-height: 1.8;
}

.founder-quote {
    margin: 20px 0;

    padding: 20px;

    background: rgba(255, 255, 255, 0.09);

    border-left: 4px solid #ffffff;

    border-radius: 8px;

    backdrop-filter: blur(10px);
}

.founder-contact {
    display: flex;

    flex-wrap: wrap;

    gap: 20px;

    margin-top: 25px;
}

.contact-item {
    display: flex;

    align-items: center;

    gap: 10px;
}

.contact-item i {
    color: #ffffff;

    font-size: 20px;
}

.contact-item p {
    margin: 0;

    color: #ffffff;
}


/* =========================================================
   21. TESTIMONIALS
========================================================= */

.testimonials {
    padding: 100px 0;

    background:
        linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.04),
            rgba(91, 8, 168, 0.10)
        );
}

.testimonial-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 28px;
}

.testimonial-card {
    padding: 30px;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 20px;

    box-shadow: var(--shadow);

    backdrop-filter: blur(14px);
}

.testimonial-text p {
    margin: 0;

    color: rgba(255, 255, 255, 0.82);

    font-size: 15px;

    line-height: 1.8;
}

.testimonial-author {
    display: flex;

    align-items: center;

    gap: 15px;

    margin-top: 25px;

    padding-top: 20px;

    border-top: 1px solid rgba(255, 255, 255, 0.14);
}

.testimonial-author img {
    width: 60px;
    height: 60px;

    border-radius: 50%;

    object-fit: cover;

    border: 2px solid rgba(255, 255, 255, 0.25);
}

.author-details h4 {
    margin: 0 0 5px;

    color: #ffffff;

    font-size: 16px;
}

.author-details p {
    margin: 0;

    color: #ead7ff;

    font-size: 12px;
}


/* =========================================================
   22. CONTACT
========================================================= */

.contact-section {
    position: relative;

    width: 100%;

    padding: 100px 20px 90px;

    background:
        radial-gradient(
            circle at 20% 20%,
            rgba(255, 255, 255, 0.10),
            transparent 35%
        ),
        radial-gradient(
            circle at 80% 45%,
            rgba(50, 0, 90, 0.15),
            transparent 38%
        );

    color: #ffffff;
}

.contact-section::before,
.contact-section::after {
    content: "";

    position: absolute;

    border-radius: 50%;

    filter: blur(100px);

    pointer-events: none;
}

.contact-section::before {
    width: 500px;
    height: 500px;

    top: -180px;
    right: -150px;

    background: rgba(255, 255, 255, 0.08);
}

.contact-section::after {
    width: 450px;
    height: 450px;

    bottom: -200px;
    left: -150px;

    background: rgba(40, 0, 80, 0.18);
}

.contact-section * {
    box-sizing: border-box;
}

.contact-container {
    position: relative;

    z-index: 2;

    width: 100%;

    max-width: 1380px;

    margin: 0 auto;
}

.contact-heading {
    width: 100%;

    max-width: 900px;

    margin: 0 0 55px;
}

.contact-eyebrow {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-bottom: 18px;

    padding: 7px 14px;

    border: 1px solid rgba(255, 255, 255, 0.25);

    border-radius: 50px;

    background: rgba(255, 255, 255, 0.10);

    color: #ffffff;

    font-size: 12px;

    font-weight: 600;

    backdrop-filter: blur(10px);
}

.contact-heading h2 {
    margin: 0;

    color: #ffffff;

    font-size: clamp(48px, 6vw, 76px);

    font-weight: 800;

    line-height: 1.05;

    letter-spacing: -2px;
}

.contact-heading h2 span {
    display: inline-block;

    background:
        linear-gradient(
            135deg,
            #ffffff,
            #e9d5ff
        );

    -webkit-background-clip: text;
    background-clip: text;

    -webkit-text-fill-color: transparent;
}

.contact-heading p {
    max-width: 720px;

    margin: 25px 0 0;

    color: rgba(255, 255, 255, 0.76);

    font-size: 17px;

    line-height: 1.8;
}

.contact-content {
    width: 100%;

    display: grid;

    grid-template-columns:
        minmax(0, 1.05fr)
        minmax(420px, 0.95fr);

    gap: 75px;

    align-items: center;
}

.contact-form-wrapper {
    width: 100%;

    min-width: 0;
}

.contact-form-header {
    display: flex;

    align-items: center;

    gap: 14px;

    margin-bottom: 30px;
}

.contact-form-icon {
    width: 45px;
    height: 45px;

    min-width: 45px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: rgba(255, 255, 255, 0.18);

    color: #ffffff;

    font-size: 18px;

    border: 1px solid rgba(255, 255, 255, 0.25);
}

.contact-form-header h3 {
    margin: 0 0 3px;

    color: #ffffff;

    font-size: 20px;
}

.contact-form-header p {
    margin: 0;

    color: rgba(255, 255, 255, 0.65);

    font-size: 12px;
}

.contact-form {
    width: 100%;

    padding: 35px;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.22);

    border-radius: 24px;

    box-shadow: var(--shadow-heavy);

    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
}

.contact-row {
    width: 100%;

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 28px;

    margin-bottom: 28px;
}

.contact-field {
    width: 100%;

    min-width: 0;
}

.contact-field label {
    display: block;

    margin: 0 0 9px;

    color: #ffffff;

    font-size: 13px;

    font-weight: 600;
}

.input-wrapper,
.textarea-wrapper {
    position: relative;

    width: 100%;
}

.input-wrapper i,
.textarea-wrapper i {
    position: absolute;

    left: 17px;

    z-index: 2;

    color: rgba(255, 255, 255, 0.65);

    font-size: 18px;

    pointer-events: none;
}

.input-wrapper i {
    top: 50%;

    transform: translateY(-50%);
}

.textarea-wrapper i {
    top: 18px;
}

.contact-form input,
.contact-form textarea {
    width: 100%;

    color: #ffffff;

    background: rgba(40, 0, 70, 0.22);

    border: 1px solid rgba(255, 255, 255, 0.18);

    border-radius: 12px;

    outline: none;

    font-size: 15px;

    transition:
        border-color 0.25s ease,
        background 0.25s ease,
        box-shadow 0.25s ease;
}

.contact-form input {
    height: 64px;

    padding: 0 18px 0 58px;
}

.contact-form textarea {
    min-height: 190px;

    padding: 17px 18px 17px 58px;

    resize: vertical;

    line-height: 1.7;
}

.contact-form input::placeholder,
.contact-form textarea::placeholder {
    color: rgba(255, 255, 255, 0.58);

    opacity: 1;
}

.contact-form input:focus,
.contact-form textarea:focus {
    border-color: #ffffff;

    background: rgba(40, 0, 70, 0.30);

    box-shadow:
        0 0 0 3px rgba(255, 255, 255, 0.10);
}

.contact-submit {
    width: 100%;

    margin-top: 27px;
}

.contact-submit-btn {
    width: 100%;

    min-height: 58px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 0 28px;

    border: none !important;

    border-radius: 11px !important;

    background:
        linear-gradient(
            135deg,
            #5b08a8,
            #b026ff
        ) !important;

    color: #ffffff !important;

    font-size: 15px !important;

    font-weight: 700;

    cursor: pointer;

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.contact-submit-btn:hover {
    transform: translateY(-2px);

    box-shadow:
        0 16px 35px rgba(40, 0, 80, 0.30);
}


/* =========================================================
   23. CONTACT VISUAL
========================================================= */

.contact-visual {
    position: relative;

    width: 100%;

    min-height: 520px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    padding: 25px;

    background:
        radial-gradient(
            circle at center,
            rgba(255, 255, 255, 0.10),
            transparent 58%
        );
}

.contact-image-card {
    position: relative;

    z-index: 1;

    width: 100%;

    max-width: 560px;

    min-height: 410px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 20px;

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 20px;

    background: rgba(255, 255, 255, 0.10);

    box-shadow: var(--shadow-heavy);

    backdrop-filter: blur(14px);
}

.contact-image {
    display: block;

    width: 100%;

    max-width: 500px;

    max-height: 390px;

    object-fit: contain;

    border-radius: 14px;
}

.contact-online {
    position: absolute;

    z-index: 5;

    top: 5px;

    right: 0;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 10px 16px;

    border: 1px solid rgba(255, 255, 255, 0.18);

    border-radius: 15px;

    background: rgba(40, 0, 70, 0.60);

    backdrop-filter: blur(12px);
}

.contact-online > span {
    width: 9px;
    height: 9px;

    border-radius: 50%;

    background: #00e676;

    box-shadow:
        0 0 0 4px rgba(0, 230, 118, 0.12);
}

.contact-online strong {
    color: #ffffff;

    font-size: 12px;
}

.contact-highlights {
    position: relative;

    z-index: 5;

    width: 100%;

    max-width: 560px;

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 12px;

    margin-top: 18px;
}

.contact-highlight {
    display: flex;

    align-items: center;

    gap: 9px;

    padding: 12px;

    border: 1px solid rgba(255, 255, 255, 0.15);

    border-radius: 11px;

    background: rgba(255, 255, 255, 0.09);

    backdrop-filter: blur(8px);
}

.contact-highlight > i {
    color: #ffffff;

    font-size: 17px;
}

.contact-highlight span {
    display: flex;

    flex-direction: column;

    color: rgba(255, 255, 255, 0.68);

    font-size: 10px;

    line-height: 1.4;
}

.contact-highlight strong {
    color: #ffffff;

    font-size: 11px;
}


/* =========================================================
   24. FOOTER
========================================================= */

.site-footer {
    width: 100%;

    background:
        linear-gradient(
            135deg,
            rgba(50, 0, 80, 0.55),
            rgba(80, 0, 130, 0.45),
            rgba(40, 0, 70, 0.55)
        );

    color: #ffffff;

    border-top: 1px solid rgba(255, 255, 255, 0.18);

    backdrop-filter: blur(15px);
}

.footer-container {
    width: 100%;

    max-width: 1400px;

    margin: 0 auto;

    padding: 0 30px;
}

.footer-content {
    display: grid;

    grid-template-columns:
        1.2fr
        1fr
        1.4fr;

    gap: 60px;

    padding: 55px 0 45px;
}

.footer-section {
    min-width: 0;
}

.footer-section h3 {
    margin: 0 0 20px;

    color: #ffffff;

    font-size: 18px;
}

.footer-section h3::after {
    content: "";

    display: block;

    width: 35px;

    height: 3px;

    margin-top: 8px;

    background: #ffffff;

    border-radius: 5px;
}

.footer-description {
    max-width: 330px;

    margin: 0 0 20px;

    color: rgba(255, 255, 255, 0.70);

    font-size: 14px;

    line-height: 1.7;
}

.footer-links {
    margin: 0;

    padding: 0;

    list-style: none;
}

.footer-links li {
    margin-bottom: 11px;
}

.footer-links a {
    display: inline-flex;

    align-items: center;

    gap: 9px;

    color: rgba(255, 255, 255, 0.70);

    font-size: 14px;

    transition:
        color 0.2s ease,
        transform 0.2s ease;
}

.footer-links a i {
    color: #ffffff;
}

.footer-links a:hover {
    color: #ffffff;

    transform: translateX(4px);
}

.site-footer .contact-info {
    display: flex;

    align-items: flex-start;

    gap: 13px;

    margin-bottom: 18px;
}

.site-footer .contact-icon {
    width: 34px;
    height: 34px;

    min-width: 34px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 8px;

    background: rgba(255, 255, 255, 0.10);

    color: #ffffff;
}

.site-footer .contact-text {
    min-width: 0;
}

.site-footer .contact-text a {
    display: block;

    color: rgba(255, 255, 255, 0.72);

    font-size: 14px;

    line-height: 1.6;

    word-break: break-word;
}

.site-footer .social-icons {
    width: 100%;

    display: flex;

    align-items: center;

    justify-content: flex-start;

    flex-wrap: wrap;

    gap: 10px;
}

.site-footer .social-icons a {
    width: 40px;
    height: 40px;

    min-width: 40px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.18);

    color: #ffffff;

    font-size: 16px;

    transition:
        transform 0.25s ease,
        background 0.25s ease;
}

.site-footer .social-icons a:hover {
    background: rgba(255, 255, 255, 0.22);

    border-color: rgba(255, 255, 255, 0.30);

    transform: translateY(-4px);
}

.footer-bottom {
    padding: 20px 0;

    border-top: 1px solid rgba(255, 255, 255, 0.12);

    text-align: center;
}

.footer-bottom p {
    margin: 0;

    color: rgba(255, 255, 255, 0.65);

    font-size: 13px;

    line-height: 1.6;
}


/* =========================================================
   25. TABLET
========================================================= */

@media (max-width: 1050px) {

    .features-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .course-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .teacher-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .contact-content {
        grid-template-columns: 1fr;

        gap: 50px;
    }

    .contact-visual {
        min-height: 500px;
    }

    .contact-image-card {
        max-width: 600px;
    }

    .contact-online {
        right: 5%;
    }

    .about-cta {
        grid-template-columns: 1fr;
    }

    .footer-content {
        grid-template-columns:
            1fr
            1fr;
    }
}


/* =========================================================
   26. TABLET 768
========================================================= */

@media (max-width: 768px) {

    .features-grid,
    .course-grid,
    .teacher-grid,
    .toppers-container,
    .collage {
        grid-template-columns: 1fr;
    }

    .gallery-slider {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .founder-grid {
        grid-template-columns: 1fr;

        gap: 35px;
    }

    .testimonial-grid {
        grid-template-columns: 1fr;
    }

    .contact-section {
        padding: 70px 16px;
    }

    .contact-form {
        padding: 28px 22px;
    }

    .contact-row {
        grid-template-columns: 1fr;

        gap: 18px;

        margin-bottom: 18px;
    }

    .contact-visual {
        min-height: 400px;
    }

    .contact-highlights {
        grid-template-columns: 1fr;
    }

    .footer-container {
        padding: 0 20px;
    }

    .footer-content {
        grid-template-columns: 1fr;

        gap: 35px;

        padding: 40px 0 30px;
    }

    .notification-card {
        width: 290px;

        min-width: 290px;
    }
}


/* =========================================================
   27. MOBILE
========================================================= */

@media (max-width: 600px) {

    .hero {
        padding: 60px 16px;
    }

    .hero-subtitle {
        font-size: 18px;

        letter-spacing: 0.5px;
    }

    .hero-features span {
        font-size: 13px;

        padding: 8px 13px;
    }

    .hero-buttons .btn {
        width: 100%;

        min-width: 0;
    }

    .features,
    .about-section,
    .notifications,
    .gallery,
    .courses,
    .teachers,
    .founder,
    .testimonials {
        padding: 70px 0;
    }

    .section-title {
        margin-bottom: 35px;

        font-size: 32px;
    }

    .course-card {
        border-radius: 17px;
    }

    .course-image,
    .course-placeholder {
        height: 230px;
    }

    .course-title {
        min-height: auto;

        font-size: 24px;
    }

    .course-info {
        padding: 22px;
    }

    .course-meta span {
        font-size: 12px;
    }

    .discounted-price {
        font-size: 24px;
    }

    .gallery-slider {
        grid-template-columns: 1fr;
    }

