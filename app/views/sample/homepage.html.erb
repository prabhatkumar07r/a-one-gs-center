<style nonce="<%= content_security_policy_nonce %>">
/* =========================================================
   A ONE GS CENTER
   HOMEPAGE - COMPLETE MASTER CSS
   PURPLE GLASS THEME
   MAIN BACKGROUND: #8009e2
========================================================= */

/* =========================================================
   1. GLOBAL VARIABLES
========================================================= */

:root {
    --page-bg: #8009e2;

    --purple: #8009e2;
    --purple-dark: #5b08a8;
    --purple-light: #b86cff;

    --blue: #2563eb;
    --blue-light: #60a5fa;

    --orange: #ff8c00;
    --green: #10b981;

    --white: #ffffff;
    --text: #ffffff;
    --text-soft: rgba(255, 255, 255, 0.88);
    --text-muted: rgba(255, 255, 255, 0.70);

    --glass: rgba(255, 255, 255, 0.10);
    --glass-light: rgba(255, 255, 255, 0.14);
    --glass-dark: rgba(30, 0, 55, 0.22);

    --border: rgba(255, 255, 255, 0.20);

    --shadow:
        0 20px 60px rgba(30, 0, 50, 0.25);

    --shadow-heavy:
        0 30px 80px rgba(30, 0, 50, 0.35);
}


/* =========================================================
   2. GLOBAL RESET
========================================================= */

html,
body {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;

    overflow-x: hidden;

    scroll-behavior: smooth;

    background: var(--page-bg);

    color: var(--text);

    font-family: "Poppins", sans-serif;
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

body {
    min-height: 100vh;

    background:
        radial-gradient(
            circle at 15% 10%,
            rgba(255, 255, 255, 0.12),
            transparent 28%
        ),
        radial-gradient(
            circle at 85% 30%,
            rgba(255, 255, 255, 0.08),
            transparent 30%
        ),
        #8009e2;
}

img {
    max-width: 100%;
    height: auto;
}

section {
    width: 100%;
    max-width: 100%;

    position: relative;

    overflow: hidden;

    background: transparent;
}

button,
input,
textarea,
select {
    font: inherit;
}

a {
    text-decoration: none;
}

.container {
    width: 100%;
    max-width: 1250px;

    margin-left: auto;
    margin-right: auto;

    padding-left: 20px;
    padding-right: 20px;
}


/* =========================================================
   3. COMMON GLASS
========================================================= */

.glass {
    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    box-shadow: var(--shadow);
}


/* =========================================================
   4. SECTION TITLE
========================================================= */

.section-title {
    position: relative;

    width: 100%;

    margin: 0 0 50px;

    text-align: center;

    color: #ffffff;

    font-size: clamp(32px, 4vw, 48px);

    font-weight: 800;

    line-height: 1.2;

    text-shadow:
        0 4px 20px rgba(40, 0, 70, 0.35);
}

.section-title::after {
    content: "";

    display: block;

    width: 75px;
    height: 4px;

    margin: 16px auto 0;

    border-radius: 20px;

    background:
        linear-gradient(
            90deg,
            #ffffff,
            #d8b4fe
        );

    box-shadow:
        0 0 15px rgba(255, 255, 255, 0.45);
}


/* =========================================================
   5. HERO
========================================================= */

.hero {
    position: relative;

    width: 100%;

    min-height: 100vh;
    min-height: 100svh;

    display: flex;

    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 80px 24px;

    background:
        radial-gradient(
            circle at 50% 20%,
            rgba(255, 255, 255, 0.15),
            transparent 35%
        ),
        linear-gradient(
            180deg,
            rgba(80, 0, 140, 0.18),
            rgba(128, 9, 226, 0.02)
        );
}

.hero::before {
    content: "";

    position: absolute;

    width: 500px;
    height: 500px;

    top: -250px;
    left: -180px;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.08);

    filter: blur(80px);

    pointer-events: none;
}

.hero::after {
    content: "";

    position: absolute;

    width: 500px;
    height: 500px;

    right: -220px;
    bottom: -250px;

    border-radius: 50%;

    background: rgba(30, 0, 70, 0.18);

    filter: blur(90px);

    pointer-events: none;
}

.hero .container {
    position: relative;

    z-index: 2;

    width: 100%;
    max-width: 1400px;
}

.hero-content {
    width: 100%;
    max-width: 1400px;

    margin: 0 auto;
}


/* =========================================================
   6. HERO LOGO
========================================================= */

.hero-logo {
    display: block;

    width: min(90vw, 1100px);

    max-width: 100%;

    height: auto;

    margin: 0 auto;

    object-fit: contain;

    background: transparent;

    border: none;

    border-radius: 0;

    filter:
        drop-shadow(
            0 20px 40px rgba(35, 0, 65, 0.40)
        );

    animation: floatLogo 5s ease-in-out infinite;

    transition: transform 0.4s ease;
}

.hero-logo:hover {
    transform: scale(1.03);
}

@keyframes floatLogo {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }
}


/* =========================================================
   7. HERO SUBTITLE
========================================================= */

.hero-subtitle {
    width: 100%;
    max-width: 900px;

    margin: 28px auto 0;

    color: #ffffff;

    font-size: clamp(18px, 2.2vw, 28px);

    font-weight: 600;

    line-height: 1.5;

    letter-spacing: 1px;

    text-shadow:
        0 4px 15px rgba(30, 0, 60, 0.30);
}


/* =========================================================
   8. HERO FEATURES
========================================================= */

.hero-features {
    width: 100%;
    max-width: 1000px;

    display: flex;

    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 12px;

    margin: 32px auto;
}

.hero-features span {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    max-width: 100%;

    padding: 11px 18px;

    color: #ffffff;

    background: rgba(255, 255, 255, 0.12);

    border: 1px solid rgba(255, 255, 255, 0.24);

    border-radius: 50px;

    font-size: 14px;

    font-weight: 600;

    line-height: 1.4;

    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);

    box-shadow:
        0 8px 25px rgba(30, 0, 60, 0.16);

    transition:
        background 0.3s ease,
        transform 0.3s ease;
}

.hero-features span:hover {
    background: rgba(255, 255, 255, 0.20);

    transform: translateY(-3px);
}


/* =========================================================
   9. HERO SOCIAL
========================================================= */

.hero-social {
    display: flex;

    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 18px;

    margin: 32px 0;
}

.hero-social a {
    width: 56px;
    height: 56px;

    flex: 0 0 56px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    font-size: 24px;

    color: #ffffff;

    background: rgba(255, 255, 255, 0.10);

    border: 2px solid rgba(255, 255, 255, 0.30);

    backdrop-filter: blur(10px);

    transition:
        transform 0.35s ease,
        background 0.35s ease,
        box-shadow 0.35s ease;
}

.hero-social a:hover {
    transform: translateY(-6px) scale(1.08);

    background: rgba(255, 255, 255, 0.20);

    box-shadow:
        0 15px 35px rgba(30, 0, 60, 0.25);
}

.hero-social .youtube {
    color: #ffdddd;

    border-color: #ff5c5c;
}

.hero-social .instagram {
    color: #ffd2e2;

    border-color: #ff6b9a;
}


/* =========================================================
   10. HERO BUTTONS
========================================================= */

.hero-buttons {
    width: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 15px;

    margin-top: 35px;
}

.hero-buttons .btn {
    min-width: 170px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 14px 30px;

    color: #ffffff;

    background: #ff8c00;

    border: 2px solid transparent;

    border-radius: 10px;

    font-size: 15px;

    font-weight: 700;

    box-shadow:
        0 12px 30px rgba(60, 0, 90, 0.18);

    transition:
        background 0.3s ease,
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.hero-buttons .btn:hover {
    background: #ff6b00;

    color: #ffffff;

    transform: translateY(-3px);

    box-shadow:
        0 15px 35px rgba(255, 140, 0, 0.30);
}

.hero-buttons .btn-outline {
    background: rgba(255, 255, 255, 0.08);

    border: 2px solid rgba(255, 255, 255, 0.75);

    backdrop-filter: blur(8px);
}

.hero-buttons .btn-outline:hover {
    background: #ffffff;

    color: #8009e2;
}


/* =========================================================
   11. FEATURES
========================================================= */

.features {
    width: 100%;

    padding: 100px 0;

    background:
        linear-gradient(
            180deg,
            rgba(91, 8, 168, 0.10),
            rgba(255, 255, 255, 0.04)
        );
}

.features-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 24px;
}

.feature-card {
    min-width: 0;

    padding: 32px 25px;

    text-align: center;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 20px;

    box-shadow: var(--shadow);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    transition:
        transform 0.3s ease,
        background 0.3s ease,
        border-color 0.3s ease;
}

.feature-card:hover {
    transform: translateY(-8px);

    background: rgba(255, 255, 255, 0.15);

    border-color: rgba(255, 255, 255, 0.35);
}

.feature-icon {
    display: block;

    margin-bottom: 20px;

    color: #ffffff;

    font-size: 42px;

    text-shadow:
        0 5px 20px rgba(30, 0, 60, 0.30);
}

.feature-card h3 {
    margin: 0 0 14px;

    color: #ffffff;

    font-size: 20px;

    font-weight: 700;
}

.feature-card p {
    margin: 0;

    color: rgba(255, 255, 255, 0.78);

    font-size: 14px;

    line-height: 1.8;
}

/* =========================================================
   OUR ACHIEVEMENTS
========================================================= */

.about-section {
  width: 100%;
  padding: 70px 35px 80px;

  background:
    radial-gradient(
      circle at 15% 50%,
      rgba(255,255,255,0.08),
      transparent 35%
    ),
    radial-gradient(
      circle at 85% 50%,
      rgba(255,255,255,0.08),
      transparent 35%
    ),
    linear-gradient(
      135deg,
      #4039a0 0%,
      #302078 45%,
      #35136f 100%
    );

  overflow: hidden;
  box-sizing: border-box;
}


/* =========================================================
   HEADING
========================================================= */

.achievements-heading {
  text-align: center;
  margin-bottom: 45px;
}

.achievements-heading .section-title {
  color: #fff;
  font-size: 38px;
  font-weight: 800;
  margin: 0 0 12px;
}

.achievements-subtitle {
  color: rgba(255,255,255,0.88);
  font-size: 18px;
  margin: 0;
}


/* =========================================================
   SLIDER CONTAINER
========================================================= */

.achievements-slider-container {
  width: 100%;
  max-width: 1500px;

  margin: 0 auto;

  display: flex;
  align-items: center;

  gap: 18px;

  box-sizing: border-box;
}


/* =========================================================
   VIEWPORT
========================================================= */

.toppers-container {
  flex: 1 1 auto;

  width: 100%;
  min-width: 0;

  overflow: hidden;

  position: relative;

  box-sizing: border-box;
}


/* =========================================================
   TRACK

   IMPORTANT:
   DO NOT use percentage card widths here.
========================================================= */

.achievements-track {

  display: flex;

  flex-wrap: nowrap;

  gap: 20px;

  width: max-content;

  margin: 0;
  padding: 0;

  transform: translateX(0);

  transition:
    transform 0.75s
    cubic-bezier(
      0.4,
      0,
      0.2,
      1
    );

  will-change: transform;
}


/* =========================================================
   CARD

   Width is controlled by JavaScript.
========================================================= */

.achievements-track .topper-card {

  flex: 0 0 auto;

  width: 300px;
  min-width: 300px;

  min-height: 410px;

  box-sizing: border-box;

  overflow: hidden;

  border-radius: 24px;

  border: 1px solid
    rgba(
      255,
      255,
      255,
      0.25
    );

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,0.16),
      rgba(255,255,255,0.08)
    );

  box-shadow:
    0 15px 40px
    rgba(
      20,
      0,
      60,
      0.25
    );

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  color: #fff;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}


/* =========================================================
   HOVER
========================================================= */

.achievements-track .topper-card:hover {

  transform: translateY(-7px);

  box-shadow:
    0 22px 50px
    rgba(
      20,
      0,
      60,
      0.32
    );
}


/* =========================================================
   IMAGE
========================================================= */

.topper-image-wrapper {

  width: 100%;
  height: 220px;

  overflow: hidden;

  display: flex;
  align-items: center;
  justify-content: center;

  background:
    rgba(
      255,
      255,
      255,
      0.08
    );
}


.topper-image {

  width: 100%;
  height: 100%;

  object-fit: cover;

  display: block;

  transition:
    transform 0.5s ease;
}


.topper-card:hover .topper-image {

  transform: scale(1.04);
}


/* =========================================================
   NO IMAGE
========================================================= */

.achievement-no-image {

  width: 100%;
  height: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  color: rgba(
    255,
    255,
    255,
    0.65
  );

  font-size: 60px;
}


/* =========================================================
   CARD INFORMATION
========================================================= */

.topper-info {

  padding: 25px 22px 28px;

  text-align: center;

  box-sizing: border-box;
}


.achievement-student {

  margin-bottom: 10px;

  color:
    rgba(
      255,
      255,
      255,
      0.92
    );

  font-size: 16px;

  font-weight: 600;
}


.achievement-student i {

  color: #ef55ff;

  margin-right: 5px;
}


.topper-info h4 {

  margin: 0 0 12px;

  color: #fff;

  font-size: 22px;

  line-height: 1.35;

  font-weight: 750;
}


.achievement-rank {

  margin: 0 0 10px;

  color:
    rgba(
      255,
      255,
      255,
      0.90
    );

  font-size: 15px;

  line-height: 1.5;
}


.achievement-rank i {

  color: #ffd45c;

  margin-right: 5px;
}


.achievement-year {

  display: inline-block;

  margin-bottom: 10px;

  color:
    rgba(
      255,
      255,
      255,
      0.75
    );

  font-size: 14px;
}


.achievement-year i {

  margin-right: 4px;
}


.achievement-description {

  margin: 5px auto 0;

  max-width: 340px;

  color:
    rgba(
      255,
      255,
      255,
      0.82
    );

  font-size: 14px;

  line-height: 1.65;
}


/* =========================================================
   VIDEO BUTTON
========================================================= */

.achievement-video-btn {

  margin-top: 18px;

  padding: 10px 18px;

  border: 1px solid
    rgba(
      255,
      255,
      255,
      0.30
    );

  border-radius: 999px;

  background:
    rgba(
      255,
      255,
      255,
      0.14
    );

  color: #fff;

  font-size: 14px;

  font-weight: 600;

  cursor: pointer;

  transition:
    all 0.25s ease;
}


.achievement-video-btn:hover {

  background:
    rgba(
      255,
      255,
      255,
      0.24
    );

  transform: translateY(-2px);
}


/* =========================================================
   NAVIGATION BUTTONS
========================================================= */

.achievement-slider-btn {

  flex: 0 0 48px;

  width: 48px;
  height: 48px;

  padding: 0;

  border: none;

  border-radius: 50%;

  display: flex;

  align-items: center;
  justify-content: center;

  background: #fff;

  color: #7c20dd;

  font-size: 20px;

  cursor: pointer;

  box-shadow:
    0 8px 25px
    rgba(
      0,
      0,
      0,
      0.20
    );

  z-index: 20;

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}


.achievement-slider-btn:hover {

  transform: scale(1.08);

  box-shadow:
    0 12px 32px
    rgba(
      0,
      0,
      0,
      0.28
    );
}


.achievement-slider-btn:active {

  transform: scale(0.94);
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1100px) {

  .about-section {

    padding-left: 20px;
    padding-right: 20px;
  }

  .achievements-slider-container {

    gap: 12px;
  }

  .achievements-track {

    gap: 20px;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

  .about-section {

    padding:
      50px 10px 60px;
  }

  .achievements-heading {

    margin-bottom: 30px;
  }

  .achievements-heading .section-title {

    font-size: 30px;
  }

  .achievements-subtitle {

    font-size: 15px;
  }

  .achievements-slider-container {

    gap: 7px;
  }

  .achievements-track {

    gap: 0;
  }

  .achievements-track .topper-card {

    min-height: 390px;

    border-radius: 20px;
  }

  .topper-image-wrapper {

    height: 210px;
  }

  .topper-info {

    padding:
      22px 18px 25px;
  }

  .topper-info h4 {

    font-size: 20px;
  }

  .achievement-description {

    font-size: 13.5px;
  }

  .achievement-slider-btn {

    flex: 0 0 36px;

    width: 36px;
    height: 36px;

    font-size: 15px;
  }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 420px) {

  .about-section {

    padding:
      42px 7px 50px;
  }

  .achievements-heading .section-title {

    font-size: 26px;
  }

  .achievements-subtitle {

    font-size: 14px;
  }

  .topper-image-wrapper {

    height: 190px;
  }

  .topper-info h4 {

    font-size: 18px;
  }

}
/* =========================================================
   13. EVENTS
========================================================= */

.collage {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 20px;

    margin-bottom: 45px;
}

.event-card {
    overflow: hidden;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 18px;

    backdrop-filter: blur(12px);

    box-shadow: var(--shadow);
}

.event-card img {
    display: block;

    width: 100%;

    height: 220px;

    object-fit: cover;
}

.event-card h5 {
    margin: 0;

    padding: 15px;

    color: #ffffff;

    font-size: 15px;
}


/* =========================================================
   14. GOAL
========================================================= */

.goal-quote {
    max-width: 850px;

    margin: 0 auto 45px;

    padding: 35px;

    text-align: center;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.22);

    border-radius: 20px;

    backdrop-filter: blur(14px);

    box-shadow: var(--shadow);
}

.goal-quote strong {
    display: block;

    margin-bottom: 15px;

    color: #ffffff;

    font-size: 20px;
}

.goal-quote p {
    margin: 10px 0;

    color: rgba(255, 255, 255, 0.82);

    font-size: 16px;

    line-height: 1.7;
}


/* =========================================================
   15. ABOUT CTA
========================================================= */

.about-cta {
    display: grid;

    grid-template-columns:
        1fr
        1fr;

    gap: 35px;

    align-items: center;
}

.highlight-box {
    padding: 30px;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 20px;

    backdrop-filter: blur(14px);

    box-shadow: var(--shadow);
}

.highlight-box h3 {
    margin: 0 0 20px;

    color: #ffffff;

    font-size: 24px;
}

.highlight-box ul {
    margin: 0 0 25px;

    padding-left: 20px;
}

.highlight-box li {
    margin-bottom: 12px;

    color: rgba(255, 255, 255, 0.78);

    line-height: 1.6;
}

.demo-btn {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 12px 22px;

    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            #5b08a8,
            #9c27ff
        );

    border-radius: 10px;

    font-weight: 700;

    box-shadow:
        0 10px 25px rgba(50, 0, 90, 0.25);

    transition:
        transform 0.25s ease;
}

.demo-btn:hover {
    color: #ffffff;

    transform: translateY(-2px);
}

.highlight-img {
    display: flex;

    align-items: center;
    justify-content: center;

    min-height: 300px;

    padding: 30px;

    background: rgba(255, 255, 255, 0.08);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 20px;

    backdrop-filter: blur(14px);

    box-shadow: var(--shadow);
}

.highlight-img img {
    max-width: 450px;

    width: 100%;

    object-fit: contain;
}

/* =========================================================
   NOTIFICATION TICKER — RIGHT TO LEFT
========================================================= */

.notification-ticker-container {
    position: relative;
    width: 100%;
    overflow: hidden;
}


/* =========================================================
   TICKER TRACK
========================================================= */

.notification-ticker {
    display: flex;

    flex-direction: row;

    align-items: stretch;

    gap: 20px;

    width: max-content;

    margin: 0;

    padding: 0;

    will-change: transform;

    animation:
        notificationScroll 35s linear infinite;
}


/* =========================================================
   NOTIFICATION CARD
========================================================= */

.notification-ticker .notification-card {
    position: relative;

    flex: 0 0 330px;

    width: 330px;
    min-width: 330px;

    min-height: 270px;

    margin: 0;

    opacity: 1;

    visibility: visible;

    transform: none;

    box-sizing: border-box;
}


/* =========================================================
   RIGHT → LEFT
========================================================= */

@keyframes notificationScroll {

    0% {
        transform: translateX(0);
    }

    100% {
        transform: translateX(-50%);
    }

}


/* =========================================================
   PAUSE ON HOVER
========================================================= */

.notification-ticker:hover {
    animation-play-state: paused;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .notification-ticker {
        gap: 14px;

        animation-duration: 28s;
    }

    .notification-ticker .notification-card {
        flex: 0 0 285px;

        width: 285px;

        min-width: 285px;
    }

}

/* =========================================================
   17. GALLERY
========================================================= */

.gallery {
    position: relative;

    padding: 100px 0;

    background:
        linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.04),
            rgba(91, 8, 168, 0.10)
        );

    overflow: hidden;
}


/* =========================================================
   GALLERY CONTAINER
========================================================= */

.gallery-container {
    position: relative;

    width: 100%;

    padding: 20px 20px 60px;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 22px;

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    box-shadow: var(--shadow);

    overflow: hidden;
}

/* =========================================================
   GALLERY SLIDE
========================================================= */

.gallery-slide {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    opacity: 0;
    visibility: hidden;

    transform: scale(1.02);

    transition:
        opacity 0.45s ease,
        transform 0.55s ease,
        visibility 0.45s ease;
}

.gallery-slide.active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
}


/* =========================================================
   GALLERY IMAGE
========================================================= */

.gallery-slider .gallery-image {
    position: relative;
    z-index: 2;

    display: block;

    width: auto;
    max-width: 92%;
    height: 100%;

    object-fit: contain;
    object-position: center;

    padding: 0 !important;

    border: none !important;
    border-radius: 14px !important;

    background: transparent;

    box-shadow:
        0 12px 35px rgba(0, 0, 0, 0.25);
}

/* =========================================================
   INDIVIDUAL SLIDE
========================================================= */

.gallery-slide {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    opacity: 0;

    visibility: hidden;

    transform: scale(1.02);

    transition:
        opacity 0.45s ease,
        transform 0.55s ease,
        visibility 0.45s ease;
}


.gallery-slide.active {
    opacity: 1;

    visibility: visible;

    transform: scale(1);
}


/* =========================================================
   GALLERY IMAGE
========================================================= */

.gallery-slider .gallery-image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;

    object-position: center;

    padding: 0 !important;

    background: rgba(255, 255, 255, 0.04);

    border: none !important;

    border-radius: 18px !important;

    box-shadow: none;

    transition:
        transform 0.35s ease,
        box-shadow 0.35s ease;
}


/* =========================================================
   NAVIGATION BUTTONS
========================================================= */

.gallery-nav {
    position: absolute;

    top: 50%;

    width: 48px;
    height: 48px;

    display: flex;

    align-items: center;
    justify-content: center;

    transform: translateY(-50%);

    color: #ffffff;

    background:
        rgba(70, 0, 120, 0.72);

    border: 1px solid rgba(255, 255, 255, 0.25);

    border-radius: 50%;

    cursor: pointer;

    z-index: 10;

    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);

    box-shadow:
        0 8px 22px rgba(30, 0, 60, 0.22);

    transition:
        background 0.25s ease,
        transform 0.25s ease,
        box-shadow 0.25s ease;
}


.gallery-nav:hover {
    background:
        rgba(126, 34, 206, 0.90);

    transform:
        translateY(-50%)
        scale(1.08);

    box-shadow:
        0 12px 28px rgba(30, 0, 60, 0.30);
}


.gallery-nav:active {
    transform:
        translateY(-50%)
        scale(0.96);
}


/* =========================================================
   PREVIOUS / NEXT
========================================================= */

.gallery-prev {
    left: 10px;
}

.gallery-next {
    right: 10px;
}


/* =========================================================
   DOT NAVIGATION
========================================================= */

.gallery-dots {
    position: absolute;

    left: 50%;

    bottom: 18px;

    transform: translateX(-50%);

    display: flex;

    align-items: center;
    justify-content: center;

    gap: 7px;

    z-index: 20;
}


.gallery-dot {
    width: 8px;
    height: 8px;

    padding: 0;

    border: none;

    border-radius: 50%;

    background:
        rgba(255, 255, 255, 0.45);

    cursor: pointer;

    transition:
        width 0.25s ease,
        background 0.25s ease,
        transform 0.25s ease;
}


.gallery-dot:hover {
    background:
        rgba(255, 255, 255, 0.80);

    transform: scale(1.15);
}


.gallery-dot.active {
    width: 25px;

    border-radius: 20px;

    background: #ffffff;
}


.gallery-slide::before {
    content: "";

    position: absolute;
    inset: -30px;

    background-image: var(--gallery-image);

    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;

    filter: blur(25px);

    opacity: 0.45;

    transform: scale(1.08);

    z-index: 0;
}

.gallery-slide::after {
    content: "";

    position: absolute;
    inset: 0;

    background: rgba(50, 0, 80, 0.28);

    z-index: 1;
}

.gallery-slider .gallery-image {
    position: relative;
    z-index: 2;
}

/* =========================================================
   EMPTY GALLERY
========================================================= */

.gallery-empty {
    width: 100%;
    height: 100%;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    color: rgba(255, 255, 255, 0.75);

    text-align: center;
}


.gallery-empty i {
    margin-bottom: 12px;

    font-size: 42px;
}


.gallery-empty p {
    margin: 0;

    font-size: 15px;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {

    .gallery {
        padding: 75px 0;
    }

    .gallery-container {
        padding: 16px 16px 55px;

        border-radius: 20px;
    }

    .gallery-slider {
        height: 300px;

        border-radius: 16px;
    }

    .gallery-slider .gallery-image {
        border-radius: 16px !important;
    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .gallery {
        padding: 55px 0;
    }

    .gallery-container {
        padding: 10px 10px 50px;

        border-radius: 17px;
    }

    .gallery-slider {
        height: 230px;

        border-radius: 13px;
    }

    .gallery-slider .gallery-image {
        border-radius: 13px !important;
    }

    .gallery-nav {
        width: 40px;
        height: 40px;

        font-size: 15px;
    }

    .gallery-prev {
        left: 5px;
    }

    .gallery-next {
        right: 5px;
    }

    .gallery-dots {
        bottom: 13px;

        gap: 6px;
    }

    .gallery-dot {
        width: 7px;
        height: 7px;
    }

    .gallery-dot.active {
        width: 20px;
    }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 400px) {

    .gallery-slider {
        height: 200px;
    }

    .gallery-nav {
        width: 36px;
        height: 36px;
    }

}
