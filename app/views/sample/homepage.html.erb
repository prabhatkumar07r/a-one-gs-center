<style>
/* =========================================================
   A ONE GS CENTER
   HOMEPAGE - CLEAN MASTER CSS
   HERO + SECTIONS + CONTACT + FOOTER
========================================================= */


/* =========================================================
   1. GLOBAL RESET / SAFETY
========================================================= */

html,
body {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;

    overflow-x: hidden;

    scroll-behavior: smooth;
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

img {
    max-width: 100%;
    height: auto;
}

section {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

button,
input,
textarea,
select {
    font: inherit;
}

a {
    text-decoration: none;
}

.container {
    width: 100%;
    max-width: 1200px;

    margin-left: auto;
    margin-right: auto;

    padding-left: 20px;
    padding-right: 20px;
}


/* =========================================================
   2. HERO SECTION
========================================================= */

.hero {
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    background:
        linear-gradient(
            135deg,
            #07111f 0%,
            #0b2345 50%,
            #07111f 100%
        );

    overflow: hidden;

    padding: 60px 24px;

    position: relative;
}

.hero .container {
    width: 100%;
    max-width: 1400px;
}

.hero-content {
    width: 100%;
    max-width: 1400px;

    margin: 0 auto;
}


/* =========================================================
   3. HERO LOGO
========================================================= */

.hero-logo {
    display: block;

    width: min(90vw, 1100px);
    max-width: 100%;

    height: auto;

    margin: 0 auto;

    object-fit: contain;

    background: transparent;

    border: none;

    border-radius: 0;

    box-shadow: none;

    filter:
        drop-shadow(
            0 18px 35px rgba(0, 0, 0, 0.45)
        );

    animation: floatLogo 5s ease-in-out infinite;

    transition: transform 0.4s ease;
}

.hero-logo:hover {
    transform: scale(1.03);
}

@keyframes floatLogo {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }
}


/* =========================================================
   4. HERO SUBTITLE
========================================================= */

.hero-subtitle {
    width: 100%;
    max-width: 850px;

    margin: 25px auto 0;

    color: #ffffff;

    font-family: "Poppins", sans-serif;

    font-size: clamp(18px, 2.2vw, 28px);

    font-weight: 500;

    line-height: 1.5;

    letter-spacing: 1.5px;
}


/* =========================================================
   5. HERO FEATURES
========================================================= */

.hero-features {
    width: 100%;
    max-width: 950px;

    display: flex;

    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 12px;

    margin: 30px auto;
}

.hero-features span {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    max-width: 100%;

    padding: 10px 18px;

    color: #ffffff;

    background: rgba(255, 255, 255, 0.08);

    border: 1px solid rgba(255, 255, 255, 0.15);

    border-radius: 50px;

    font-family: "Poppins", sans-serif;

    font-size: 15px;

    font-weight: 500;

    line-height: 1.4;

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);

    transition:
        background 0.3s ease,
        transform 0.3s ease;
}

.hero-features span:hover {
    background: rgba(255, 255, 255, 0.15);

    transform: translateY(-3px);
}


/* =========================================================
   6. HERO BUTTONS
========================================================= */

.hero-buttons {
    width: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 15px;

    margin-top: 35px;
}

.hero-buttons .btn {
    min-width: 160px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 14px 30px;

    color: #ffffff;

    background: #ff8c00;

    border: 2px solid transparent;

    border-radius: 8px;

    text-decoration: none;

    font-family: "Poppins", sans-serif;

    font-size: 15px;

    font-weight: 600;

    line-height: 1.3;

    transition:
        background 0.3s ease,
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.hero-buttons .btn:hover {
    background: #ff6b00;

    color: #ffffff;

    transform: translateY(-3px);

    box-shadow:
        0 10px 25px rgba(255, 140, 0, 0.3);
}

.hero-buttons .btn-outline {
    background: transparent;

    border: 2px solid #ffffff;
}

.hero-buttons .btn-outline:hover {
    background: #ffffff;

    color: #111111;
}


/* =========================================================
   7. HERO SOCIAL
========================================================= */

.hero-social {
    display: flex;

    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 18px;

    margin: 32px 0;
}

.hero-social a {
    width: 56px;
    height: 56px;

    flex: 0 0 56px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    text-decoration: none;

    font-size: 25px;

    transition:
        transform 0.35s ease,
        background 0.35s ease,
        box-shadow 0.35s ease;
}

.hero-social a:hover {
    transform: translateY(-6px) scale(1.08);
}

.hero-social .linkedin {
    color: #0a66c2;

    border: 2px solid #0a66c2;

    background: rgba(10, 102, 194, 0.08);
}

.hero-social .linkedin:hover {
    color: #ffffff;

    background: #0a66c2;
}

.hero-social .youtube {
    color: #ff0000;

    border: 2px solid #ff0000;

    background: rgba(255, 0, 0, 0.08);
}

.hero-social .youtube:hover {
    color: #ffffff;

    background: #ff0000;
}

.hero-social .instagram {
    color: #e1306c;

    border: 2px solid #e1306c;

    background: rgba(225, 48, 108, 0.08);
}

.hero-social .instagram:hover {
    color: #ffffff;

    background: #e1306c;
}


/* =========================================================
   8. COMMON SECTION TITLES
========================================================= */

.section-title {
    width: 100%;

    text-align: center;

    margin-bottom: 45px;
}


/* =========================================================
   9. CONTACT SECTION
   HERO-STYLE DARK TRANSPARENT DESIGN
========================================================= */

.contact-section {
    position: relative;

    width: 100%;
    max-width: 100%;

    min-height: 100vh;

    padding: 100px 20px 90px;

    background:
        radial-gradient(
            circle at 20% 20%,
            rgba(37, 117, 252, 0.16),
            transparent 35%
        ),
        radial-gradient(
            circle at 80% 45%,
            rgba(106, 17, 203, 0.18),
            transparent 38%
        ),
        linear-gradient(
            135deg,
            #07111f 0%,
            #0b2345 50%,
            #07111f 100%
        );

    color: #ffffff;

    overflow: hidden;
}

.contact-section::before {
    content: "";

    position: absolute;

    width: 500px;
    height: 500px;

    top: -180px;
    right: -150px;

    background: rgba(106, 17, 203, 0.12);

    border-radius: 50%;

    filter: blur(100px);

    pointer-events: none;
}

.contact-section::after {
    content: "";

    position: absolute;

    width: 450px;
    height: 450px;

    bottom: -200px;
    left: -150px;

    background: rgba(37, 117, 252, 0.10);

    border-radius: 50%;

    filter: blur(100px);

    pointer-events: none;
}

.contact-section *,
.contact-section *::before,
.contact-section *::after {
    box-sizing: border-box;
}


/* =========================================================
   10. CONTACT CONTAINER
========================================================= */

.contact-container {
    position: relative;

    z-index: 2;

    width: 100%;
    max-width: 1380px;

    margin: 0 auto;
}


/* =========================================================
   11. CONTACT HEADING
========================================================= */

.contact-heading {
    width: 100%;
    max-width: 900px;

    margin: 0 0 55px;
}

.contact-eyebrow {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-bottom: 18px;

    padding: 7px 14px;

    border: 1px solid rgba(139, 92, 246, 0.25);

    border-radius: 50px;

    background: rgba(124, 58, 237, 0.08);

    color: #a78bfa;

    font-family: "Poppins", sans-serif;

    font-size: 12px;

    font-weight: 600;
}

.contact-eyebrow i {
    font-size: 14px;
}


/* =========================================================
   12. CONTACT MAIN HEADING
========================================================= */

.contact-heading h2 {
    margin: 0;

    color: #f8fafc;

    font-family: "Poppins", sans-serif;

    font-size: clamp(48px, 6vw, 76px);

    font-weight: 800;

    line-height: 1.05;

    letter-spacing: -2px;
}

.contact-heading h2 span {
    display: inline-block;

    background:
        linear-gradient(
            135deg,
            #7c3aed 0%,
            #8b5cf6 45%,
            #a855f7 100%
        );

    -webkit-background-clip: text;
    background-clip: text;

    -webkit-text-fill-color: transparent;
}


/* =========================================================
   13. CONTACT DESCRIPTION
========================================================= */

.contact-heading p {
    width: 100%;
    max-width: 720px;

    margin: 25px 0 0;

    color: #9aa7bd;

    font-family: "Poppins", sans-serif;

    font-size: 17px;

    line-height: 1.8;
}


/* =========================================================
   14. CONTACT CONTENT
========================================================= */

.contact-content {
    width: 100%;

    display: grid;

    grid-template-columns:
        minmax(0, 1.05fr)
        minmax(420px, 0.95fr);

    gap: 75px;

    align-items: center;
}


/* =========================================================
   15. CONTACT FORM WRAPPER
========================================================= */

.contact-form-wrapper {
    width: 100%;

    min-width: 0;

    padding: 0;

    background: transparent;

    border: none;

    box-shadow: none;
}


/* =========================================================
   16. CONTACT FORM HEADER
========================================================= */

.contact-form-header {
    display: flex;

    align-items: center;

    gap: 14px;

    margin-bottom: 30px;
}

.contact-form-icon {
    width: 45px;
    height: 45px;

    min-width: 45px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background:
        linear-gradient(
            135deg,
            #6d28d9,
            #8b5cf6
        );

    color: #ffffff;

    font-size: 18px;

    box-shadow:
        0 10px 30px rgba(124, 58, 237, 0.25);
}

.contact-form-header h3 {
    margin: 0 0 3px;

    color: #f8fafc;

    font-family: "Poppins", sans-serif;

    font-size: 20px;

    font-weight: 700;
}

.contact-form-header p {
    margin: 0;

    color: #7f8ca3;

    font-family: "Poppins", sans-serif;

    font-size: 12px;
}


/* =========================================================
   17. CONTACT FORM
   GLASS / TRANSPARENT
========================================================= */

.contact-form {
    width: 100%;

    min-width: 0;

    display: block;

    padding: 35px;

    background: rgba(255, 255, 255, 0.055);

    border: 1px solid rgba(255, 255, 255, 0.12);

    border-radius: 24px;

    box-shadow:
        0 25px 70px rgba(0, 0, 0, 0.25),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    overflow: hidden;
}


/* =========================================================
   18. CONTACT ROW
========================================================= */

.contact-row {
    width: 100%;

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 28px;

    margin-bottom: 28px;
}


/* =========================================================
   19. CONTACT FIELD
========================================================= */

.contact-field {
    width: 100%;

    min-width: 0;
}

.contact-field label {
    display: block;

    margin: 0 0 9px;

    color: #f1f5f9;

    font-family: "Poppins", sans-serif;

    font-size: 13px;

    font-weight: 600;
}


/* =========================================================
   20. INPUT WRAPPER
========================================================= */

.input-wrapper,
.textarea-wrapper {
    position: relative;

    width: 100%;
}


/* =========================================================
   21. INPUT ICONS
========================================================= */

.input-wrapper i,
.textarea-wrapper i {
    position: absolute;

    left: 17px;

    z-index: 2;

    color: #8b9ab2;

    font-size: 18px;

    pointer-events: none;

    transition: color 0.25s ease;
}

.input-wrapper i {
    top: 50%;

    transform: translateY(-50%);
}

.textarea-wrapper i {
    top: 18px;
}


/* =========================================================
   22. CONTACT INPUTS
========================================================= */

.contact-form input,
.contact-form textarea {
    width: 100%;

    border: 1px solid rgba(255, 255, 255, 0.10);

    border-radius: 12px;

    background: rgba(0, 0, 0, 0.22);

    color: #ffffff;

    font-family: "Poppins", sans-serif;

    font-size: 15px;

    outline: none;

    transition:
        border-color 0.25s ease,
        background 0.25s ease,
        box-shadow 0.25s ease;
}

.contact-form input {
    height: 64px;

    padding: 0 18px 0 58px;
}

.contact-form textarea {
    min-height: 190px;

    padding: 17px 18px 17px 58px;

    resize: vertical;

    line-height: 1.7;
}


/* =========================================================
   23. PLACEHOLDER
========================================================= */

.contact-form input::placeholder,
.contact-form textarea::placeholder {
    color: #8795aa;

    opacity: 1;
}


/* =========================================================
   24. INPUT HOVER
========================================================= */

.contact-form input:hover,
.contact-form textarea:hover {
    border-color: rgba(139, 92, 246, 0.35);
}


/* =========================================================
   25. INPUT FOCUS
========================================================= */

.contact-form input:focus,
.contact-form textarea:focus {
    border-color: #7c3aed;

    background: rgba(0, 0, 0, 0.30);

    box-shadow:
        0 0 0 3px rgba(124, 58, 237, 0.14);
}

.input-wrapper:focus-within i,
.textarea-wrapper:focus-within i {
    color: #a78bfa;
}


/* =========================================================
   26. MESSAGE FIELD
========================================================= */

.contact-message-field {
    width: 100%;

    margin-top: 2px;
}


/* =========================================================
   27. SUBMIT AREA
========================================================= */

.contact-submit {
    width: 100%;

    margin-top: 27px;
}


/* =========================================================
   28. SUBMIT BUTTON
========================================================= */

.contact-submit-btn {
    width: 100%;

    min-height: 58px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 0 28px;

    border: none !important;

    border-radius: 11px !important;

    background:
        linear-gradient(
            135deg,
            #6d28d9,
            #8b5cf6
        ) !important;

    color: #ffffff !important;

    font-family: "Poppins", sans-serif;

    font-size: 15px !important;

    font-weight: 700;

    cursor: pointer;

    box-shadow:
        0 12px 30px rgba(124, 58, 237, 0.22);

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease,
        filter 0.25s ease;
}

.contact-submit-btn:hover {
    transform: translateY(-2px);

    filter: brightness(1.08);

    box-shadow:
        0 16px 35px rgba(124, 58, 237, 0.32);
}

.contact-submit-btn:active {
    transform: translateY(0);
}


/* =========================================================
   29. CONTACT VISUAL
========================================================= */

.contact-visual {
    position: relative;

    width: 100%;

    min-width: 0;

    min-height: 520px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    padding: 25px;

    background:
        radial-gradient(
            circle at center,
            rgba(124, 58, 237, 0.16),
            transparent 58%
        );

    overflow: visible;
}


/* =========================================================
   30. CONTACT IMAGE CARD
========================================================= */

.contact-image-card {
    position: relative;

    z-index: 1;

    width: 100%;

    max-width: 560px;

    min-height: 410px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 20px;

    border: 1px solid rgba(139, 92, 246, 0.16);

    border-radius: 20px;

    background:
        radial-gradient(
            circle at center,
            rgba(124, 58, 237, 0.20),
            rgba(16, 12, 31, 0.55) 65%
        );

    box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.35),
        inset 0 0 50px rgba(124, 58, 237, 0.05);

    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
}


/* =========================================================
   31. CONTACT IMAGE
========================================================= */

.contact-image {
    display: block;

    width: 100%;

    max-width: 500px;

    max-height: 390px;

    height: auto;

    object-fit: contain;

    border-radius: 14px;
}


/* =========================================================
   32. ONLINE BADGE
========================================================= */

.contact-online {
    position: absolute;

    z-index: 5;

    top: 5px;

    right: 0;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 10px 16px;

    border: 1px solid rgba(255, 255, 255, 0.10);

    border-radius: 15px;

    background: rgba(7, 12, 22, 0.82);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.25);
}

.contact-online > span {
    width: 9px;
    height: 9px;

    flex: 0 0 9px;

    border-radius: 50%;

    background: #00c853;

    box-shadow:
        0 0 0 4px rgba(0, 200, 83, 0.10);
}

.contact-online div {
    display: flex;

    flex-direction: column;
}

.contact-online strong {
    color: #dbe4f0;

    font-family: "Poppins", sans-serif;

    font-size: 12px;

    font-weight: 600;
}

.contact-online small {
    display: none;
}


/* =========================================================
   33. QUICK RESPONSE
========================================================= */

.contact-response {
    position: absolute;

    z-index: 5;

    left: 5px;

    bottom: 25px;

    display: flex;

    align-items: center;

    gap: 9px;

    padding: 9px 16px;

    border: 1px solid rgba(255, 255, 255, 0.10);

    border-radius: 14px;

    background: rgba(7, 12, 22, 0.84);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.28);
}

.contact-response > i {
    color: #00d26a;

    font-size: 18px;
}

.contact-response div {
    display: flex;

    align-items: center;
}

.contact-response strong {
    color: #cbd5e1;

    font-family: "Poppins", sans-serif;

    font-size: 12px;

    font-weight: 600;
}

.contact-response span {
    display: none;
}


/* =========================================================
   34. CONTACT HIGHLIGHTS
========================================================= */

.contact-highlights {
    position: relative;

    z-index: 5;

    width: 100%;

    max-width: 560px;

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 12px;

    margin-top: 18px;
}

.contact-highlight {
    display: flex;

    align-items: center;

    gap: 9px;

    padding: 12px;

    border: 1px solid rgba(255, 255, 255, 0.08);

    border-radius: 11px;

    background: rgba(13, 16, 22, 0.48);

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
}

.contact-highlight > i {
    color: #8b5cf6;

    font-size: 17px;
}

.contact-highlight span {
    display: flex;

    flex-direction: column;

    color: #7f8ca3;

    font-family: "Poppins", sans-serif;

    font-size: 10px;

    line-height: 1.4;
}

.contact-highlight strong {
    color: #cbd5e1;

    font-size: 11px;
}


/* =========================================================
   35. CONTACT FORM CONTROL SUPPORT
========================================================= */

.contact-form .form-group {
    width: 100%;

    margin-bottom: 18px;
}


/* If Rails / Bootstrap generates form-control */

.contact-form .form-control {
    width: 100% !important;

    min-width: 0;

    display: block !important;

    color: #ffffff !important;

    background: rgba(0, 0, 0, 0.22) !important;

    border: 1px solid rgba(255, 255, 255, 0.10) !important;

    border-radius: 12px !important;

    box-shadow: none !important;

    outline: none;

    font-family: "Poppins", sans-serif;

    transition:
        border-color 0.25s ease,
        background 0.25s ease,
        box-shadow 0.25s ease;
}

.contact-form .form-control::placeholder {
    color: #8795aa !important;

    opacity: 1;
}

.contact-form .form-control:focus {
    color: #ffffff !important;

    background: rgba(0, 0, 0, 0.30) !important;

    border-color: #7c3aed !important;

    box-shadow:
        0 0 0 3px rgba(124, 58, 237, 0.14) !important;
}


/* =========================================================
   36. SOCIAL ICONS
   FOOTER ONLY
========================================================= */

.site-footer .social-icons {
    width: 100%;

    display: flex;

    align-items: center;

    justify-content: flex-start;

    flex-wrap: wrap;

    gap: 10px;

    margin: 0;
}

.site-footer .social-icons a {
    width: 40px;
    height: 40px;

    min-width: 40px;

    flex: 0 0 40px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #172033;

    border: 1px solid #263248;

    color: #ffffff;

    font-size: 16px;

    line-height: 1;

    text-decoration: none;

    transition:
        transform 0.25s ease,
        background 0.25s ease,
        box-shadow 0.25s ease,
        border-color 0.25s ease;
}

.site-footer .social-icons a i {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    color: #ffffff;

    font-size: 17px;

    line-height: 1;
}

.site-footer .social-icons a:hover {
    background: #6d28d9;

    border-color: #6d28d9;

    transform: translateY(-4px);

    box-shadow:
        0 8px 20px rgba(109, 40, 217, 0.25);
}


/* =========================================================
   37. FOOTER
========================================================= */

.site-footer {
    width: 100%;

    margin-top: 0;

    background:
        linear-gradient(
            135deg,
            #050b14 0%,
            #07111f 50%,
            #050b14 100%
        );

    color: #ffffff;

    border-top: 1px solid rgba(255, 255, 255, 0.06);
}


/* =========================================================
   38. FOOTER CONTAINER
========================================================= */

.footer-container {
    width: 100%;

    max-width: 1400px;

    margin: 0 auto;

    padding: 0 30px;
}


/* =========================================================
   39. FOOTER CONTENT
========================================================= */

.footer-content {
    display: grid;

    grid-template-columns:
        1.2fr
        1fr
        1.4fr;

    gap: 60px;

    padding: 55px 0 45px;
}


/* =========================================================
   40. FOOTER SECTION
========================================================= */

.footer-section {
    min-width: 0;
}

.footer-section h3 {
    margin: 0 0 20px;

    color: #ffffff;

    font-family: "Poppins", sans-serif;

    font-size: 18px;

    font-weight: 700;
}

.footer-section h3::after {
    content: "";

    display: block;

    width: 35px;

    height: 3px;

    margin-top: 8px;

    background:
        linear-gradient(
            90deg,
            #6d28d9,
            #8b5cf6
        );

    border-radius: 5px;
}


/* =========================================================
   41. FOOTER DESCRIPTION
========================================================= */

.footer-description {
    max-width: 330px;

    margin: 0 0 20px;

    color: #9ca3af;

    font-family: "Poppins", sans-serif;

    font-size: 14px;

    line-height: 1.7;
}


/* =========================================================
   42. FOOTER LINKS
========================================================= */

.footer-links {
    margin: 0;

    padding: 0;

    list-style: none;
}

.footer-links li {
    margin-bottom: 11px;
}

.footer-links a {
    display: inline-flex;

    align-items: center;

    gap: 9px;

    color: #9ca3af;

    text-decoration: none;

    font-family: "Poppins", sans-serif;

    font-size: 14px;

    transition:
        color 0.2s ease,
        transform 0.2s ease;
}

.footer-links a i {
    font-size: 12px;

    color: #8b5cf6;
}

.footer-links a:hover {
    color: #ffffff;

    transform: translateX(4px);
}


/* =========================================================
   43. FOOTER CONTACT INFO
========================================================= */

.site-footer .contact-info {
    display: flex;

    align-items: flex-start;

    gap: 13px;

    margin-bottom: 18px;
}

.site-footer .contact-icon {
    width: 34px;
    height: 34px;

    min-width: 34px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 8px;

    background: #172033;

    color: #a78bfa;
}

.site-footer .contact-icon i {
    font-size: 14px;
}

.site-footer .contact-text {
    min-width: 0;
}

.site-footer .contact-text a {
    display: block;

    color: #9ca3af;

    text-decoration: none;

    font-family: "Poppins", sans-serif;

    font-size: 14px;

    line-height: 1.6;

    word-break: break-word;

    transition: color 0.2s ease;
}

.site-footer .contact-text a:hover {
    color: #ffffff;
}


/* =========================================================
   44. FOOTER BOTTOM
========================================================= */

.footer-bottom {
    padding: 20px 0;

    border-top: 1px solid rgba(255, 255, 255, 0.07);

    text-align: center;
}

.footer-bottom p {
    margin: 0;

    color: #9ca3af;

    font-family: "Poppins", sans-serif;

    font-size: 13px;

    line-height: 1.6;
}


/* =========================================================
   45. TABLET - CONTACT
========================================================= */

@media (max-width: 1050px) {

    .contact-section {
        padding: 80px 25px;
    }

    .contact-content {
        grid-template-columns: 1fr;

        gap: 50px;
    }

    .contact-visual {
        min-height: 500px;
    }

    .contact-image-card {
        max-width: 600px;
    }

    .contact-online {
        right: 5%;
    }

    .contact-response {
        left: 5%;
    }
}


/* =========================================================
   46. TABLET - FOOTER
========================================================= */

@media (max-width: 992px) {

    .footer-container {
        padding: 0 25px;
    }

    .footer-content {
        grid-template-columns:
            1fr
            1fr;

        gap: 40px;

        padding: 45px 0 35px;
    }

    .footer-social {
        grid-column: 1 / -1;
    }
}


/* =========================================================
   47. MOBILE - CONTACT
========================================================= */

@media (max-width: 700px) {

    .contact-section {
        min-height: auto;

        padding: 65px 16px 70px;
    }

    .contact-heading {
        margin-bottom: 38px;
    }

    .contact-heading h2 {
        font-size: clamp(40px, 12vw, 54px);

        letter-spacing: -1.5px;
    }

    .contact-heading p {
        margin-top: 18px;

        font-size: 14px;

        line-height: 1.75;
    }

    .contact-content {
        gap: 45px;
    }

    .contact-form {
        padding: 28px 22px;

        border-radius: 20px;
    }

    .contact-row {
        grid-template-columns: 1fr;

        gap: 18px;

        margin-bottom: 18px;
    }

    .contact-form input {
        height: 58px;
    }

    .contact-form textarea {
        min-height: 155px;
    }

    .contact-visual {
        min-height: 380px;

        padding: 15px;
    }

    .contact-image-card {
        min-height: 300px;

        padding: 15px;

        border-radius: 17px;
    }

    .contact-image {
        max-height: 290px;
    }

    .contact-online {
        top: -5px;

        right: 0;

        padding: 8px 12px;
    }

    .contact-response {
        left: 0;

        bottom: 0;

        padding: 8px 13px;
    }

    .contact-highlights {
        grid-template-columns: 1fr;
    }
}


/* =========================================================
   48. MOBILE - FOOTER
========================================================= */

@media (max-width: 768px) {

    .site-footer {
        margin-top: 0;
    }

    .footer-container {
        padding: 0 20px;
    }

    .footer-content {
        grid-template-columns: 1fr;

        gap: 35px;

        padding: 40px 0 30px;
    }

    .footer-social {
        grid-column: auto;
    }

    .footer-section h3 {
        font-size: 17px;

        margin-bottom: 16px;
    }

    .footer-description {
        max-width: 100%;
    }

    .site-footer .social-icons a {
        width: 38px;
        height: 38px;

        min-width: 38px;

        flex-basis: 38px;
    }

    .footer-bottom {
        padding: 18px 10px;
    }

    .footer-bottom p {
        font-size: 12px;
    }
}


/* =========================================================
   49. SMALL MOBILE
========================================================= */

@media (max-width: 450px) {

    .contact-section {
        padding: 50px 12px 60px;
    }

    .contact-heading h2 {
        font-size: 39px;

        letter-spacing: -1px;
    }

    .contact-heading p {
        font-size: 13px;
    }

    .contact-form {
        padding: 22px 16px;

        border-radius: 18px;
    }

    .contact-form input {
        height: 55px;

        font-size: 13px;
    }

    .contact-form textarea {
        min-height: 140px;

        font-size: 13px;
    }

    .contact-submit-btn {
        min-height: 54px;

        font-size: 14px !important;
    }

    .contact-visual {
        min-height: 320px;

        padding: 10px;
    }

    .contact-image-card {
        min-height: 250px;
    }

    .contact-image {
        max-height: 240px;
    }

    .contact-online {
        right: 0;

        transform: scale(0.9);

        transform-origin: right top;
    }

    .contact-response {
        transform: scale(0.9);

        transform-origin: left bottom;
    }

    .footer-container {
        padding: 0 16px;
    }

    .footer-content {
        gap: 30px;

        padding: 35px 0 25px;
    }

    .footer-section h3 {
        font-size: 16px;
    }

    .footer-links a,
    .site-footer .contact-text a {
        font-size: 13px;
    }

    .site-footer .contact-info {
        gap: 10px;
    }

    .site-footer .contact-icon {
        width: 32px;
        height: 32px;

        min-width: 32px;
    }

    .site-footer .social-icons {
        gap: 8px;
    }

    .site-footer .social-icons a {
        width: 36px;
        height: 36px;

        min-width: 36px;

        flex-basis: 36px;

        font-size: 14px;
    }
}


/* =========================================================
   50. VERY SMALL PHONES
========================================================= */

@media (max-width: 360px) {

    .hero {
        padding-left: 14px;
        padding-right: 14px;
    }

    .hero-subtitle {
        font-size: 17px;
    }

    .hero-features span {
        font-size: 13px;

        padding: 8px 13px;
    }

    .hero-buttons .btn {
        width: 100%;

        min-width: 0;
    }

    .contact-section {
        padding: 45px 10px 55px;
    }

    .contact-heading h2 {
        font-size: 35px;
    }

    .contact-form {
        padding: 20px 13px;

        border-radius: 16px;
    }

    .contact-form input {
        font-size: 13px;
    }

    .contact-form textarea {
        font-size: 13px;
    }

    .contact-submit-btn {
        min-height: 50px;
    }

    .footer-container {
        padding: 0 12px;
    }

    .footer-bottom p {
        font-size: 11px;
    }
}


/* =========================================================
   51. LARGE DESKTOP
========================================================= */

@media (min-width: 1400px) {

    .contact-section {
        padding-top: 120px;

        padding-bottom: 110px;
    }

    .contact-container {
        max-width: 1380px;
    }

    .contact-content {
        gap: 90px;
    }

    .contact-form {
        padding: 42px;
    }
}


/* =========================================================
   52. ACCESSIBILITY
========================================================= */

.contact-form input:focus-visible,
.contact-form textarea:focus-visible,
.contact-submit-btn:focus-visible,
.site-footer a:focus-visible,
.hero a:focus-visible {
    outline: 2px solid #a78bfa;

    outline-offset: 3px;
}


/* =========================================================
   53. REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    .hero-logo {
        animation: none;
    }

    .hero-logo,
    .hero-social a,
    .hero-buttons .btn,
    .hero-features span,
    .contact-submit-btn,
    .site-footer .social-icons a,
    .footer-links a {
        transition: none;
    }

    .hero-logo:hover,
    .hero-social a:hover,
    .hero-buttons .btn:hover,
    .hero-features span:hover,
    .contact-submit-btn:hover,
    .site-footer .social-icons a:hover,
    .footer-links a:hover {
        transform: none;
    }
}

</style>
<head>
    <link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>


<!-- =========================================================
     HERO
========================================================= -->

<section class="hero" id="home">

    <div class="container">

        <div class="hero-content">

            <%= image_tag "chatlogo.png",
                class: "hero-logo",
                alt: "A One GS Center" %>

            <p class="hero-subtitle">
                Empowering Students to Learn, Prepare & Succeed
            </p>

            <div class="hero-features">

                <span>🎓 Expert Faculty</span>

                <span>📚 Weekly Test Series</span>

                <span>💻 Online & Offline Classes</span>

            </div>

           <div class="hero-social">

    <a href="https://youtube.com/@aonegs77"
       target="_blank"
       rel="noopener noreferrer"
       class="youtube"
       aria-label="YouTube">

        <i class="bi bi-youtube"></i>

    </a>

    <a href="https://www.instagram.com/atsirshorts/"
       target="_blank"
       rel="noopener noreferrer"
       class="instagram"
       aria-label="Instagram">

        <i class="bi bi-instagram"></i>

    </a>

</div>

            <div class="hero-buttons">

                <%= link_to "Explore Courses",
                    "#courses",
                    class: "btn" %>

                <%= link_to "Contact Us",
                    "#contact",
                    class: "btn btn-outline" %>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FEATURES
========================================================= -->

<section class="features" id="features">

    <div class="container">

        <h2 class="section-title">
            Why Choose Us
        </h2>

        <div class="features-grid">

            <div class="feature-card">

                <i class="fas fa-chalkboard-teacher feature-icon"></i>

                <h3>
                    Expert Faculty
                </h3>

                <p>
                    Learn from highly qualified and experienced
                    teachers who have successfully guided students
                    in SSC, Bihar Police, Railway, Banking and NDA.
                </p>

            </div>


            <div class="feature-card">

                <i class="fas fa-book-open feature-icon"></i>

                <h3>
                    Study Materials
                </h3>

                <p>
                    Comprehensive study materials and practice
                    problems.
                </p>

            </div>


            <div class="feature-card">

                <i class="fas fa-clipboard-check feature-icon"></i>

                <h3>
                    Regular Tests
                </h3>

                <p>
                    Weekly tests and performance analysis to
                    track progress.
                </p>

            </div>


            <div class="feature-card">

                <i class="fas fa-laptop feature-icon"></i>

                <h3>
                    Online Portal
                </h3>

                <p>
                    Access lessons, assignments and tests through
                    our online portal.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     ABOUT / ACHIEVEMENTS
========================================================= -->

<section class="about-section" id="about">

    <div class="container">

        <h2 class="section-title">
            Our Achievements
        </h2>

        <div class="toppers-container">

            <% if @achievements.present? %>

                <% @achievements.each do |achievement| %>

                    <div class="topper-card">

                        <% if achievement.photo.attached? %>

                            <%= image_tag achievement.photo,
                                class: "topper-image",
                                alt: achievement.title %>

                        <% end %>

                        <div class="topper-info">

                            <h4>
                                <%= achievement.title %>
                            </h4>

                            <p>
                                <%= achievement.rank %>
                            </p>

                            <small>
                                <%= achievement.year %>
                            </small>

                            <p>
                                <%= achievement.description %>
                            </p>

                        </div>

                    </div>

                <% end %>

            <% else %>

                <p class="text-center">
                    No achievements available.
                </p>

            <% end %>

        </div>


        <div class="collage">

            <% @events.limit(6).each do |event| %>

                <div class="event-card">

                    <% if event.photo.attached? %>

                        <%= image_tag event.photo,
                            alt: event.title %>

                    <% else %>

                        <%= image_tag "default-event.jpg",
                            alt: "No Image" %>

                    <% end %>

                    <h5>
                        <%= event.title %>
                    </h5>

                </div>

            <% end %>

        </div>


        <div class="goal-quote">

            <strong>
                🎯 Our Goal
            </strong>

            <p>
                "Har student ko strong foundation ke sath
                unke sapne ke career tak pahunchana."
            </p>

            <p>
                "Agle saalon me aur zyada district aur state
                toppers dena."
            </p>

        </div>


        <div class="about-cta">

            <div class="highlight-box">

                <h3>
                    Quick Facts
                </h3>

                <ul>

                    <li>
                        Founded: 2017
                    </li>

                    <li>
                        Batch Size: Limited seats
                    </li>

                    <li>
                        Test Series: Weekly + Monthly
                    </li>

                    <li>
                        Subjects:
                        History • Geography • Political Science • Economics
                    </li>

                </ul>

                <%= link_to "Join a Demo Class",
                    new_demo_request_path,
                    class: "btn demo-btn" %>

            </div>


            <div class="highlight-img">

                <%= image_tag "logo.jpeg",
                    alt: "A One GS Center" %>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     NOTIFICATIONS
========================================================= -->

<section class="notifications" id="notifications">

    <div class="container">

        <h2 class="section-title">

            <i class="fas fa-bell"></i>

            Latest Notifications

        </h2>

        <div class="notif-showcase">

            <div class="ticker-glass-panel">

                <div class="notification-ticker-container">

                    <div class="notification-ticker">

                        <% if @notifications.present? %>

                            <% @notifications.each do |notification| %>

                                <div class="notification-card">

                                    <h5>

                                        <i class="fas fa-bullhorn text-danger"></i>

                                        <%= notification.title %>

                                    </h5>

                                    <p>
                                        <%= truncate(
                                            notification.description,
                                            length: 120
                                        ) %>
                                    </p>

                                    <p>
                                        <strong>📅 Start:</strong>

                                        <%= notification.start_date.strftime(
                                            "%d %b %Y"
                                        ) if notification.start_date.present? %>
                                    </p>

                                    <p>
                                        <strong>📅 End:</strong>

                                        <%= notification.end_date.strftime(
                                            "%d %b %Y"
                                        ) if notification.end_date.present? %>
                                    </p>

                                    <small class="text-muted">

                                        <i class="fas fa-calendar-alt"></i>

                                        Posted:

                                        <%= notification.created_at.strftime(
                                            "%d %b %Y"
                                        ) %>

                                    </small>

                                </div>

                            <% end %>

                        <% else %>

                            <div class="alert alert-info text-center">
                                No latest notifications available.
                            </div>

                        <% end %>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     GALLERY
========================================================= -->

<section class="gallery" id="gallery">

    <div class="container">

        <h2 class="section-title">
            Gallery
        </h2>

        <div class="gallery-container">

            <div class="gallery-slider">

                <% @galleries.each_with_index do |gallery, index| %>

                    <% if gallery.photos.attached? %>

                        <% gallery.photos.each do |photo| %>

                            <%= image_tag photo,
                                width: 200,
                                class: "img-thumbnail",
                                alt: "Gallery Image" %>

                        <% end %>

                    <% else %>

                        <p>
                            No photos uploaded.
                        </p>

                    <% end %>

                <% end %>

            </div>

            <button class="gallery-nav gallery-prev">
                <i class="fas fa-chevron-left"></i>
            </button>

            <button class="gallery-nav gallery-next">
                <i class="fas fa-chevron-right"></i>
            </button>

            <div class="gallery-dots"></div>

        </div>

    </div>

</section>


<!-- =========================================================
     COURSES
========================================================= -->

<section class="courses" id="courses">

    <div class="container">

        <h2 class="section-title">
            Our Courses
        </h2>

        <div class="course-grid">

            <% @courses.each do |course| %>

                <div class="course-card">

                    <% if course.respond_to?(:image) &&
                          course.image.attached? %>

                        <%= image_tag course.image,
                            class: "course-image",
                            alt: course.Course_name %>

                    <% else %>

                        <div class="course-placeholder">

                            <h3>
                                <%= course.Course_name %>
                            </h3>

                        </div>

                    <% end %>


                    <div class="course-info">

                        <h3 class="course-title">
                            <%= course.Course_name %>
                        </h3>


                        <div class="course-rating">

                            ⭐ 4.8

                            <span>
                                (250 Students)
                            </span>

                        </div>


                        <div class="course-meta">

                            <span>

                                <i class="fas fa-clock"></i>

                                <%= course.duration %>

                            </span>

                            <span>

                                <i class="fas fa-users"></i>

                                Limited Seats

                            </span>

                        </div>


                        <div class="course-price-container">

                            <% if course.original_fee.present? &&
                                  course.original_fee > course.fee %>

                                <span class="original-price">

                                    ₹<%= number_with_delimiter(
                                        course.original_fee
                                    ) %>

                                </span>

                                <span class="discounted-price">

                                    ₹<%= number_with_delimiter(
                                        course.fee
                                    ) %>

                                </span>

                                <span class="discount-badge">

                                    <%= course.discount_percentage %>%
                                    OFF

                                </span>

                            <% else %>

                                <span class="discounted-price">

                                    ₹<%= number_with_delimiter(
                                        course.fee
                                    ) %>

                                </span>

                            <% end %>

                        </div>


                        <div class="course-buttons">

                            <%= link_to "📖 View Course",
                                course_details_path(course),
                                class: "btn btn-primary w-100 mb-2" %>

                            <%= link_to "📝 Enroll Now",
                                new_enrollment_path(
                                    course_id: course.id
                                ),
                                class: "btn btn-success w-100" %>

                        </div>

                    </div>

                </div>

            <% end %>

        </div>

    </div>

</section>


<!-- =========================================================
     TEACHERS
========================================================= -->

<section class="teachers" id="teachers">

    <div class="container">

        <h2 class="section-title">
            Our Expert Faculty
        </h2>

        <div class="teacher-grid">

            <% @teachers.each do |teacher| %>

                <div class="teacher-card">

                    <% if teacher.photo.attached? %>

                        <%= image_tag teacher.photo,
                            class: "teacher-img",
                            alt: teacher.name %>

                    <% else %>

                        <img src="https://placehold.co/300x300?text=Teacher"
                             class="teacher-img"
                             alt="Teacher">

                    <% end %>


                    <div class="teacher-info">

                        <h3>
                            <%= teacher.name %>
                        </h3>

                        <p class="subject">
                            <%= teacher.subject %>
                        </p>

                        <p>
                            <strong>Qualification:</strong>
                            <%= teacher.qualification %>
                        </p>

                        <p>
                            <strong>Designation:</strong>
                            <%= teacher.designation %>
                        </p>

                        <p>
                            <strong>Experience:</strong>
                            <%= teacher.experience %> Years
                        </p>

                        <p>
                            <%= truncate(
                                teacher.bio,
                                length: 100
                            ) %>
                        </p>


                        <div class="social-links">

                            <% if teacher.facebook.present? %>

                                <%= link_to teacher.facebook,
                                    target: "_blank",
                                    rel: "noopener" do %>

                                    <i class="fab fa-facebook-f"></i>

                                <% end %>

                            <% end %>


                            <% if teacher.instagram.present? %>

                                <%= link_to teacher.instagram,
                                    target: "_blank",
                                    rel: "noopener" do %>

                                    <i class="fab fa-instagram"></i>

                                <% end %>

                            <% end %>


                            <% if teacher.linkedin.present? %>

                                <%= link_to teacher.linkedin,
                                    target: "_blank",
                                    rel: "noopener" do %>

                                    <i class="fab fa-linkedin-in"></i>

                                <% end %>

                            <% end %>


                            <% if teacher.gmail.present? %>

                                <%= mail_to teacher.gmail do %>

                                    <i class="fas fa-envelope"></i>

                                <% end %>

                            <% end %>

                        </div>

                    </div>

                </div>

            <% end %>

        </div>

    </div>

</section>


<!-- =========================================================
     FOUNDER
========================================================= -->

<section class="founder" id="founder">

    <div class="container">

        <h2 class="section-title">
            Founder & Director
        </h2>

        <div class="founder-grid">

            <div class="founder-image">

