     class="linkedin">
      <i class="fab fa-linkedin-in"></i>
  </a> %>

  <a href="https://youtube.com/@aonegs77?si=eYbHZlwjBYCkezd8"
     target="_blank"
     class="youtube">
      <i class="fab fa-youtube"></i>
  </a>

  <a href="https://www.instagram.com/atsirshorts?igsh=M2dlZ3p6dnB2cDd1"
