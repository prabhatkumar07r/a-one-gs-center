                    </li>

                </ul>

                <%= link_to "Join a Demo Class",
                    new_demo_request_path,
                    class: "btn demo-btn" %>

            </div>


            <div class="highlight-img">

                <%= image_tag "logo.jpeg",
                    alt: "A One GS Center" %>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     NOTIFICATIONS
     AUTOMATIC RUNNING
========================================================= -->

<section
  class="notifications"
  id="notifications"
  data-turbo-cache="false"
>

    <div class="container">

        <h2 class="section-title">
            <i class="bi bi-bell-fill"></i>
            Latest Notifications
        </h2>

        <div class="notif-showcase">

            <div class="ticker-glass-panel">

                <div class="notification-ticker-container">

                    <div
                        class="notification-ticker"
                        id="notificationTicker"
                    >

                        <% if @notifications.present? %>

                            <% @notifications.each do |notification| %>

                                <div class="notification-card">

                                    <h5>
                                        <i class="bi bi-megaphone-fill"></i>
                                        <%= notification.title %>
                                    </h5>

                                    <p>
                                        <%= truncate(
                                            notification.description,
                                            length: 250
                                        ) %>
                                    </p>

                                    <p>
                                        <strong>📅 Start:</strong>
                                        <%= notification.start_date.strftime("%d %b %Y") if notification.start_date.present? %>
                                    </p>

                                    <p>
                                        <strong>📅 End:</strong>
                                        <%= notification.end_date.strftime("%d %b %Y") if notification.end_date.present? %>
                                    </p>

                                    <small>
                                        <i class="bi bi-calendar-event"></i>
                                        Posted:
                                        <%= notification.created_at.strftime("%d %b %Y") %>
                                    </small>

                                </div>

                            <% end %>

                        <% else %>

                            <div class="notification-card">

                                <h5>
                                    <i class="bi bi-info-circle"></i>
                                    Notifications
                                </h5>

                                <p>
                                    No latest notifications available.
                                </p>

                            </div>

                        <% end %>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

