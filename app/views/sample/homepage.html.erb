   <!-- =========================================================
     ACHIEVEMENTS / TOPPERS
========================================================= -->

<section class="about-section" id="about">

  <div class="container">

    <!-- =====================================================
         HEADING
    ====================================================== -->

    <div class="achievements-heading">

      <h2 class="section-title">
        Our Achievements
      </h2>

      <p class="achievements-subtitle">
        “हमारे विद्यार्थियों की मेहनत और सफलता ही हमारी सबसे बड़ी उपलब्धि है।”
      </p>

    </div>


    <!-- =====================================================
         CONTINUOUS ACHIEVEMENT SLIDER
    ====================================================== -->

    <div class="achievements-slider-container">

      <div
        class="toppers-container"
        id="achievementsSlider"
        aria-label="Student achievements">

        <% if @achievements.present? %>

          <% achievements_for_slider =
               @achievements.to_a + @achievements.to_a %>

          <div class="achievements-track">

            <% achievements_for_slider.each do |achievement| %>

              <article class="topper-card">

                <!-- =========================================
                     PHOTO
                ========================================== -->

                <div class="topper-image-wrapper">

                  <% if achievement.photo.attached? %>

                    <%= image_tag achievement.photo,
                        class: "topper-image",
                        alt: "#{achievement.student_name.presence || 'Student'} - #{achievement.title.presence || 'Achievement'}",
                        loading: "lazy" %>

                  <% else %>

                    <div class="achievement-no-image">
                      <i class="bi bi-trophy-fill"></i>
                    </div>

                  <% end %>

                </div>


                <!-- =========================================
                     INFORMATION
                ========================================== -->

                <div class="topper-info">

                  <!-- STUDENT NAME -->

                  <% if achievement.student_name.present? %>

                    <div class="achievement-student">

                      <i class="bi bi-person-fill"></i>

                      <span>
                        <%= achievement.student_name %>
                      </span>

                    </div>

                  <% end %>


                  <!-- TITLE -->

                  <% if achievement.title.present? %>

                    <h4>
                      <%= achievement.title %>
                    </h4>

                  <% end %>


                  <!-- RANK -->

                  <% if achievement.rank.present? %>

                    <p class="achievement-rank">

                      <i class="bi bi-award-fill"></i>

                      <span>
                        <%= achievement.rank %>
                      </span>

                    </p>

                  <% end %>


                  <!-- YEAR -->

                  <% if achievement.year.present? %>

                    <small class="achievement-year">

                      <i class="bi bi-calendar-event"></i>

                      <span>
                        <%= achievement.year %>
                      </span>

                    </small>

                  <% end %>


                  <!-- DESCRIPTION -->

                  <% if achievement.description.present? %>

                    <p class="achievement-description">
                      <%= achievement.description %>
                    </p>

                  <% end %>


                  <!-- =======================================
                       SUCCESS STORY VIDEO
                  ======================================== -->

                  <% if achievement.video.attached? %>

                    <button
                      type="button"
                      class="achievement-video-btn"
                      data-video-url="<%= url_for(achievement.video) %>"
                      data-video-title="<%= achievement.title.presence || 'Achievement Success Story' %>"
                      aria-label="Watch success story">

                      <i class="bi bi-play-circle-fill"></i>

                      <span>
                        Watch Success Story
                      </span>

                    </button>

                  <% end %>

                </div>

              </article>

            <% end %>

          </div>

        <% else %>

          <!-- ===============================================
               EMPTY STATE
          ================================================ -->

          <div class="no-achievements">

            <i class="bi bi-trophy"></i>

            <p>
              No achievements available at the moment.
            </p>

          </div>

        <% end %>

      </div>

    </div>

  </div>

</section>


