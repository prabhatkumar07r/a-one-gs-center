
<style>
    /* =========================================================
   HERO SECTION
========================================================= */

/* =========================================================
   HERO SECTION
========================================================= */

.hero {
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    background: linear-gradient(
        135deg,
        #07111f 0%,
        #0b2345 50%,
        #07111f 100%
    );

    overflow: hidden;

    box-sizing: border-box;

    padding: 60px 24px;
}

.hero *,
.hero *::before,
.hero *::after {
    box-sizing: border-box;
}

.hero .container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
}

.hero-content {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
}


/* =========================================================
   LOGO
========================================================= */

.hero-logo {
    display: block;

    width: min(90vw, 1100px);
    max-width: 100%;

    height: auto;

    margin: 0 auto;

    object-fit: contain;

    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;

    filter: drop-shadow(
        0 18px 35px rgba(0, 0, 0, 0.45)
    );

    animation: floatLogo 5s ease-in-out infinite;

    transition: transform 0.4s ease;
}

.hero-logo:hover {
    transform: scale(1.03);
}


@keyframes floatLogo {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }
}


/* =========================================================
   SUBTITLE
========================================================= */

.hero-subtitle {
    width: 100%;
    max-width: 850px;

    margin: 25px auto 0;

    color: #ffffff;

    font-family: "Poppins", sans-serif;

    font-size: clamp(18px, 2.2vw, 28px);

    font-weight: 500;

    line-height: 1.5;

    letter-spacing: 1.5px;
}


/* =========================================================
   FEATURES
========================================================= */

.hero-features {
    width: 100%;
    max-width: 950px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 12px;

    margin: 30px auto;
}

.hero-features span {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    max-width: 100%;

    padding: 10px 18px;

    color: #ffffff;

    background: rgba(255, 255, 255, 0.08);

    border: 1px solid rgba(255, 255, 255, 0.15);

    border-radius: 50px;

    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 500;

    line-height: 1.4;

    backdrop-filter: blur(8px);

    transition:
        background 0.3s ease,
        transform 0.3s ease;
}

.hero-features span:hover {
    background: rgba(255, 255, 255, 0.15);

    transform: translateY(-3px);
}


/* =========================================================
   BUTTONS
========================================================= */

.hero-buttons {
    width: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 15px;

    margin-top: 35px;
}

.hero-buttons .btn {
    min-width: 160px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 14px 30px;

    color: #ffffff;

    background: #ff8c00;

    border-radius: 8px;

    text-decoration: none;

    font-family: "Poppins", sans-serif;
    font-size: 15px;
    font-weight: 600;

    line-height: 1.3;

    transition:
        background 0.3s ease,
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.hero-buttons .btn:hover {
    background: #ff6b00;

    transform: translateY(-3px);

    box-shadow:
        0 10px 25px rgba(255, 140, 0, 0.3);
}

.hero-buttons .btn-outline {
    background: transparent;

    border: 2px solid #ffffff;
}

.hero-buttons .btn-outline:hover {
    background: #ffffff;

    color: #111111;
}


/* =========================================================
   SOCIAL ICONS
========================================================= */

.hero-social {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 18px;

    margin: 32px 0;
}

.hero-social a {
    width: 56px;
    height: 56px;

    flex: 0 0 56px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    text-decoration: none;

    font-size: 25px;

    transition:
        transform 0.35s ease,
        background 0.35s ease,
        box-shadow 0.35s ease;
}

.hero-social a:hover {
    transform: translateY(-6px) scale(1.08);
}


/* =========================================================
   LINKEDIN
========================================================= */

.hero-social .linkedin {
    color: #0a66c2;

    border: 2px solid #0a66c2;

    background: rgba(10, 102, 194, 0.08);
}

.hero-social .linkedin:hover {
    color: #ffffff;

    background: #0a66c2;

    box-shadow:
        0 0 20px rgba(10, 102, 194, 0.6);
}


/* =========================================================
   YOUTUBE
========================================================= */

.hero-social .youtube {
    color: #ff0000;

    border: 2px solid #ff0000;

    background: rgba(255, 0, 0, 0.08);
}

.hero-social .youtube:hover {
    color: #ffffff;

    background: #ff0000;

    box-shadow:
        0 0 20px rgba(255, 0, 0, 0.6);
}


/* =========================================================
   INSTAGRAM
========================================================= */

.hero-social .instagram {
    color: #e1306c;

    border: 2px solid #e1306c;

    background: rgba(225, 48, 108, 0.08);
}

.hero-social .instagram:hover {
    color: #ffffff;

    background: #e1306c;

    box-shadow:
        0 0 20px rgba(225, 48, 108, 0.6);
}


/* =========================================================
   LARGE DESKTOP
   1400px+
========================================================= */

@media (min-width: 1400px) {

    .hero {
        padding: 70px 40px;
    }

    .hero-logo {
        width: min(80vw, 1200px);
    }

    .hero-subtitle {
        margin-top: 30px;
    }

    .hero-features {
        margin-top: 35px;
    }
}


/* =========================================================
   DESKTOP / LAPTOP
   993px - 1399px
========================================================= */

@media (max-width: 1399px) {

    .hero {
        padding: 60px 30px;
    }

    .hero-logo {
        width: min(90vw, 950px);
    }
}


/* =========================================================
   TABLET
   769px - 992px
========================================================= */

@media (max-width: 992px) {

    .hero {
        min-height: auto;

        padding: 70px 25px;
    }

    .hero-logo {
        width: min(90vw, 750px);
    }

    .hero-subtitle {
        max-width: 700px;

        margin-top: 20px;

        font-size: clamp(18px, 2.8vw, 23px);

        letter-spacing: 1px;
    }

    .hero-features {
        max-width: 700px;

        gap: 10px;

        margin: 25px auto;
    }

    .hero-features span {
        padding: 9px 15px;

        font-size: 14px;
    }

    .hero-buttons {
        margin-top: 28px;
    }
}


/* =========================================================
   SMALL TABLET / LARGE MOBILE
   577px - 768px
========================================================= */

@media (max-width: 768px) {

    .hero {
        min-height: auto;

        padding: 55px 20px 45px;
    }

    .hero-logo {
        width: min(92vw, 600px);

        animation: none;
    }

    .hero-subtitle {
        max-width: 600px;

        margin-top: 18px;

        font-size: clamp(17px, 3vw, 20px);

        line-height: 1.5;

        letter-spacing: 0.8px;
    }

    .hero-features {
        max-width: 600px;

        gap: 8px;

        margin: 22px auto;
    }

    .hero-features span {
        padding: 8px 13px;

        font-size: 13px;
    }

    .hero-buttons {
        gap: 10px;

        margin-top: 25px;
    }

    .hero-buttons .btn {
        min-width: 145px;

        padding: 12px 20px;

        font-size: 14px;
    }

    .hero-social {
        gap: 14px;

        margin: 25px 0;
    }

    .hero-social a {
        width: 50px;
        height: 50px;

        flex-basis: 50px;

        font-size: 22px;
    }
}


/* =========================================================
   MOBILE
   577px AND BELOW
========================================================= */

@media (max-width: 576px) {

    .hero {
        padding: 40px 14px 35px;
    }

    .hero-logo {
        width: 100%;
        max-width: 450px;
    }

    .hero-subtitle {
        max-width: 350px;

        margin-top: 15px;

        font-size: 16px;

        line-height: 1.45;

        letter-spacing: 0.5px;
    }

    .hero-features {
        display: grid;

        grid-template-columns: repeat(2, minmax(0, 1fr));

        width: 100%;
        max-width: 380px;

        gap: 8px;

        margin: 20px auto;
    }

    .hero-features span {
        width: 100%;

        min-height: 38px;

        padding: 8px 6px;

        border-radius: 10px;

        font-size: 12px;

        line-height: 1.3;
    }

    .hero-buttons {
        flex-direction: column;

        width: 100%;

        gap: 9px;

        margin-top: 22px;
    }

    .hero-buttons .btn {
        width: 100%;
        max-width: 300px;

        min-width: 0;

        padding: 12px 18px;

        font-size: 14px;
    }

    .hero-social {
        gap: 11px;

        margin: 24px 0;
    }

    .hero-social a {
        width: 46px;
        height: 46px;

        flex-basis: 46px;

        font-size: 19px;
    }
}


/* =========================================================
   VERY SMALL PHONES
   400px AND BELOW
========================================================= */

@media (max-width: 400px) {

    .hero {
        padding: 30px 10px 30px;
    }

    .hero-logo {
        width: 100%;
    }

    .hero-subtitle {
        max-width: 300px;

        font-size: 14px;

        line-height: 1.4;
    }

    .hero-features {
        grid-template-columns: 1fr;

        max-width: 280px;

        gap: 6px;

        margin: 17px auto;
    }

    .hero-features span {
        min-height: 36px;

        padding: 8px 10px;

        font-size: 12px;
    }

    .hero-buttons {
        margin-top: 20px;
    }

    .hero-buttons .btn {
        max-width: 260px;

        padding: 11px 16px;

        font-size: 13px;
    }

    .hero-social {
        gap: 9px;

        margin: 20px 0;
    }

    .hero-social a {
        width: 42px;
        height: 42px;

        flex-basis: 42px;

        font-size: 17px;
    }
}


/* =========================================================
   LANDSCAPE PHONES
========================================================= */

@media (max-height: 600px) and (max-width: 900px) {

    .hero {
        min-height: auto;

        padding: 35px 20px;
    }

    .hero-logo {
        width: min(75vw, 500px);
    }

    .hero-subtitle {
        margin-top: 10px;
    }

    .hero-features {
        margin: 12px auto;
    }

    .hero-buttons {
        margin-top: 15px;
    }

    .hero-social {
        margin: 15px 0;
    }
}


/* =========================================================
   REDUCE MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    .hero-logo {
        animation: none;
    }

    .hero-logo:hover,
    .hero-social a:hover,
    .hero-features span:hover,
    .hero-buttons .btn:hover {
        transform: none;
    }
}
</style>
<!DOCTYPE html>
<html lang="en">

<head>
