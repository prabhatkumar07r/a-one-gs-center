<style>
  .hero{

    min-height:100vh;

    display:flex;

    align-items:center;

    justify-content:center;

    text-align:center;

    background:#07111f;

    overflow:hidden;

}
.hero-logo img{
    width:100%;
    max-width:1200px;   /* Increase or remove if needed */
    height:auto;
    display:block;
    object-fit:contain;

    /* Remove any white box */
    background:transparent;
    border:none;
    border-radius:0;
    box-shadow:none;
    padding:0;
    margin:0;
  }


.hero-content{

    max-width:1200px;

    margin:auto;

}

.hero-logo{

    width:100%;

    max-width:950px;

    height:auto;

    display:block;

    margin:0 auto;

    animation:floatLogo 4s ease-in-out infinite;

    transition:.4s;

    mix-blend-mode:multiply; /* hides white background */

}

.hero-logo:hover{

    transform:scale(1.05);

}

.hero-subtitle{

    color:#ffffff;

    font-size:24px;

    margin-top:25px;

    letter-spacing:2px;

}

.hero-buttons{

    margin-top:40px;

}

.btn{

    padding:14px 35px;

    background:#ff8c00;

    color:#fff;

    text-decoration:none;

    border-radius:8px;

    margin:0 10px;

    transition:.3s;

}

.btn:hover{

    background:#ff6b00;

}

.btn-outline{

    background:transparent;

    border:2px solid #fff;

}

.btn-outline:hover{

    background:#fff;

    color:#111;

}

@keyframes floatLogo{

0%,100%{

transform:translateY(0);

}

50%{

transform:translateY(-12px);

}

}

.hero-logo{
    width:100%;
    max-width:1200px;
    height:auto;
    display:block;
    margin:0 auto;
    padding:0;
    background:transparent;
    border:none;
    border-radius:0;
    box-shadow:none;
}


/* Hero Social Icons */

.hero-social{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:25px;
    margin:35px 0;
}

.hero-social a{
    width:65px;
    height:65px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    font-size:30px;
    transition:.35s ease;
}

.hero-social a:hover{
    transform:translateY(-8px) scale(1.12);
}

/* LinkedIn */

.hero-social .linkedin{
    color:#0A66C2;
    border:2px solid #0A66C2;
    background:rgba(10,102,194,.08);
}

.hero-social .linkedin:hover{
    background:#0A66C2;
    color:#fff;
    box-shadow:0 0 20px rgba(10,102,194,.6);
}

/* YouTube */

.hero-social .youtube{
    color:#ff0000;
    border:2px solid #ff0000;
    background:rgba(255,0,0,.08);
}

.hero-social .youtube:hover{
    background:#ff0000;
    color:#fff;
    box-shadow:0 0 20px rgba(255,0,0,.6);
}

/* Instagram */

.hero-social .instagram{
    color:#E1306C;
    border:2px solid #E1306C;
    background:rgba(225,48,108,.08);
}

.hero-social .instagram:hover{
    background:#E1306C;
    color:#fff;
    box-shadow:0 0 20px rgba(225,48,108,.6);
}







.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    background:linear-gradient(135deg,#07111f,#0b2345,#07111f);
    overflow:hidden;
    padding:120px 20px 80px;
}

.hero-content{
    max-width:1400px;
    margin:auto;
}

.hero-logo{
    width:100%;
    max-width:1250px;
    display:block;
    margin:0 auto;
    background:transparent;
    animation:floatLogo 5s ease-in-out infinite;
    filter:drop-shadow(0 18px 35px rgba(0,0,0,.45));
}

.hero-subtitle{
    color:#fff;
    font-size:28px;
    font-weight:500;
    margin-top:25px;
}

.hero-features{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:20px;
    margin:30px 0;
}

.hero-features span{
    color:#fff;
    background:rgba(255,255,255,.08);
    padding:12px 22px;
    border-radius:50px;
    border:1px solid rgba(255,255,255,.15);
}

.hero-buttons{
    margin-top:40px;
}











.founder-image{
    display:flex;
    justify-content:center;
    align-items:center;
}

.founder-image img{
    width:380px;
    height:480px;
    object-fit:cover;
    object-position:top;
    border-radius:20px;
    border:5px solid #ffffff;
    box-shadow:0 15px 35px rgba(0,0,0,.25);
    transition:0.4s ease;
}

.founder-image img:hover{
    transform:scale(1.03);
}
.founder-grid{
    display:flex;
    align-items:center;
    gap:60px;
    flex-wrap:wrap;
}

.founder-image{
    flex:1;
    display:flex;
    justify-content:center;
}

.founder-photo{
    width:100%;
    max-width:430px;
    height:520px;
    object-fit:cover;
    border-radius:20px;
    border:6px solid #fff;
    box-shadow:0 20px 45px rgba(0,0,0,.25);
    transition:.4s;
}

.founder-photo:hover{
    transform:scale(1.03);
}

.founder-content{
    flex:1;
}
</style>
<!DOCTYPE html>
