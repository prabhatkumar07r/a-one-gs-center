<!-- =========================================================
     CONTACT SECTION
========================================================= -->

<section class="contact-section" id="contact">

  <div class="contact-container">

    <!-- =====================================================
         CONTACT INTRO
    ====================================================== -->

    <div class="contact-heading">

      <span class="contact-eyebrow">
        <i class="bi bi-headset"></i>
        We're Here to Help
      </span>

      <h2>
        Let's Start a <span>Conversation</span>
      </h2>

      <p>
        Looking for the right course, need guidance about admissions,
        or simply have a question? Send us a message and our team
        will get back to you shortly.
      </p>

    </div>


    <!-- =====================================================
         CONTACT CONTENT
    ====================================================== -->

    <div class="contact-content">


      <!-- ===================================================
           CONTACT FORM
      ==================================================== -->

      <div class="contact-form-wrapper">

        <div class="contact-form-header">

          <div class="contact-form-icon">
            <i class="bi bi-send"></i>
          </div>

          <div>
            <h3>Send Us a Message</h3>

            <p>
              Fill in the details below and we'll connect with you.
            </p>
          </div>

        </div>


        <%= form_with url: contacts_path,
            method: :post,
            local: true,
            class: "contact-form" do |form| %>


          <!-- NAME + EMAIL -->

          <div class="contact-row">

            <div class="contact-field">

              <%= form.label :name, "Your Name *" %>

              <div class="input-wrapper">

                <i class="bi bi-person"></i>

                <%= form.text_field :name,
                    placeholder: "e.g. Rahul Kumar",
                    required: true %>

              </div>

            </div>


            <div class="contact-field">

              <%= form.label :email, "Email ID *" %>

              <div class="input-wrapper">

                <i class="bi bi-envelope"></i>

                <%= form.email_field :email,
                    placeholder: "you@example.com",
                    required: true %>

              </div>

            </div>

          </div>


          <!-- PHONE + SUBJECT -->

          <div class="contact-row">

            <div class="contact-field">

              <%= form.label :phone, "Mobile Number *" %>

              <div class="input-wrapper">

                <i class="bi bi-phone"></i>

                <%= form.telephone_field :phone,
                    placeholder: "Enter your mobile number",
                    required: true %>

              </div>

            </div>


            <div class="contact-field">

              <%= form.label :subject, "How Can We Help? *" %>

              <div class="input-wrapper">

                <i class="bi bi-question-circle"></i>

                <%= form.text_field :subject,
                    placeholder: "Course, admission, enquiry...",
                    required: true %>

              </div>

            </div>

          </div>


          <!-- MESSAGE -->

          <div class="contact-field contact-message-field">

            <%= form.label :message, "Your Message *" %>

            <div class="textarea-wrapper">

              <i class="bi bi-pencil-square"></i>

              <%= form.text_area :message,
                  placeholder: "Write your question or tell us what you need help with...",
                  rows: 7,
                  required: true %>

            </div>

          </div>


          <!-- SUBMIT -->

          <div class="contact-submit">

            <%= form.submit "Submit Enquiry",
                class: "contact-submit-btn" %>

          </div>


        <% end %>

      </div>


      <!-- ===================================================
           CONTACT VISUAL
      ==================================================== -->

      <div class="contact-visual">


        <!-- AVAILABILITY BADGE -->

        <div class="contact-online">

          <span></span>

          <div>
            <strong>We're Available</strong>
            <small>Ready to assist you</small>
          </div>

        </div>


        <!-- IMAGE CARD -->

        <div class="contact-image-card">

          <%= image_tag "logo.jpeg",
              class: "contact-image",
              alt: "Connect with A One GS Center" %>

        </div>


        <!-- TRUST MESSAGE -->

    

          

          <div>
           
            <span>We'll respond as soon as possible</span>
          </div>




        <!-- SMALL BENEFITS -->

        <div class="contact-highlights">

          <div class="contact-highlight">

            <i class="bi bi-mortarboard"></i>

            <span>
              <strong>Course Guidance</strong>
              Choose the right learning path
            </span>

          </div>


          <div class="contact-highlight">

            <i class="bi bi-info-circle"></i>

            <span>
              <strong>Quick Assistance</strong>
              Get answers to your questions
            </span>

          </div>

        </div>


      </div>

    </div>

  </div>

</section>



<script>

/* =========================================================
   NOTIFICATION TICKER
========================================================= */

document.addEventListener("DOMContentLoaded", function () {

    const ticker =
        document.querySelector(".notification-ticker");

    if (!ticker) {
        return;
    }

    ticker.style.willChange = "transform";

});


/* =========================================================
   PREVENT ACCIDENTAL HORIZONTAL OVERFLOW
========================================================= */

document.addEventListener("DOMContentLoaded", function () {

    document.documentElement.style.overflowX = "hidden";

    document.body.style.overflowX = "hidden";

});

</script>