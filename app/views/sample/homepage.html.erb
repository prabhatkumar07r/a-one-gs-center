.contact-row {
    width: 100%;

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 28px;

    margin-bottom: 28px;
}

.contact-field {
    width: 100%;

    min-width: 0;
}

.contact-field label {
    display: block;

    margin: 0 0 9px;

    color: #ffffff;

    font-size: 13px;

    font-weight: 600;
}

.input-wrapper,
.textarea-wrapper {
    position: relative;

    width: 100%;
}

.input-wrapper i,
.textarea-wrapper i {
    position: absolute;

    left: 17px;

    z-index: 2;

    color: rgba(255, 255, 255, 0.65);

    font-size: 18px;

    pointer-events: none;
}

.input-wrapper i {
    top: 50%;

    transform: translateY(-50%);
}

.textarea-wrapper i {
    top: 18px;
}

.contact-form input,
.contact-form textarea {
    width: 100%;

    color: #ffffff;

    background: rgba(40, 0, 70, 0.22);

    border: 1px solid rgba(255, 255, 255, 0.18);

    border-radius: 12px;

    outline: none;

    font-size: 15px;

    transition:
        border-color 0.25s ease,
        background 0.25s ease,
        box-shadow 0.25s ease;
}

.contact-form input {
    height: 64px;

    padding: 0 18px 0 58px;
}

.contact-form textarea {
    min-height: 190px;

    padding: 17px 18px 17px 58px;

    resize: vertical;

    line-height: 1.7;
}

.contact-form input::placeholder,
.contact-form textarea::placeholder {
    color: rgba(255, 255, 255, 0.58);

    opacity: 1;
}

.contact-form input:focus,
.contact-form textarea:focus {
    border-color: #ffffff;

    background: rgba(40, 0, 70, 0.30);

    box-shadow:
        0 0 0 3px rgba(255, 255, 255, 0.10);
}

.contact-submit {
    width: 100%;

    margin-top: 27px;
}

.contact-submit-btn {
    width: 100%;

    min-height: 58px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 0 28px;

    border: none !important;

    border-radius: 11px !important;

    background:
        linear-gradient(
            135deg,
            #5b08a8,
            #b026ff
        ) !important;

    color: #ffffff !important;

    font-size: 15px !important;

    font-weight: 700;

    cursor: pointer;

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.contact-submit-btn:hover {
    transform: translateY(-2px);

    box-shadow:
        0 16px 35px rgba(40, 0, 80, 0.30);
}


/* =========================================================
   23. CONTACT VISUAL
========================================================= */

.contact-visual {
    position: relative;

    width: 100%;

    min-height: 520px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    padding: 25px;

    background:
        radial-gradient(
            circle at center,
            rgba(255, 255, 255, 0.10),
            transparent 58%
        );
}

.contact-image-card {
    position: relative;

    z-index: 1;

    width: 100%;

    max-width: 560px;

    min-height: 410px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 20px;

    border: 1px solid rgba(255, 255, 255, 0.20);

    border-radius: 20px;

    background: rgba(255, 255, 255, 0.10);

    box-shadow: var(--shadow-heavy);

    backdrop-filter: blur(14px);
}

.contact-image {
    display: block;

    width: 100%;

    max-width: 500px;

    max-height: 390px;

    object-fit: contain;

    border-radius: 14px;
}

.contact-online {
    position: absolute;

    z-index: 5;

    top: 5px;

    right: 0;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 10px 16px;

    border: 1px solid rgba(255, 255, 255, 0.18);

    border-radius: 15px;

    background: rgba(40, 0, 70, 0.60);

    backdrop-filter: blur(12px);
}

.contact-online > span {
    width: 9px;
    height: 9px;

    border-radius: 50%;

    background: #00e676;

    box-shadow:
        0 0 0 4px rgba(0, 230, 118, 0.12);
}

.contact-online strong {
    color: #ffffff;

    font-size: 12px;
}

.contact-highlights {
    position: relative;

    z-index: 5;

    width: 100%;

    max-width: 560px;

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 12px;

    margin-top: 18px;
}

.contact-highlight {
    display: flex;

    align-items: center;

    gap: 9px;

    padding: 12px;

    border: 1px solid rgba(255, 255, 255, 0.15);

    border-radius: 11px;

    background: rgba(255, 255, 255, 0.09);

    backdrop-filter: blur(8px);
}

.contact-highlight > i {
    color: #ffffff;

    font-size: 17px;
}

.contact-highlight span {
    display: flex;

    flex-direction: column;

    color: rgba(255, 255, 255, 0.68);

    font-size: 10px;

    line-height: 1.4;
}

.contact-highlight strong {
    color: #ffffff;

    font-size: 11px;
}


/* =========================================================
   24. FOOTER
========================================================= */

.site-footer {
    width: 100%;

    background:
        linear-gradient(
            135deg,
            rgba(50, 0, 80, 0.55),
            rgba(80, 0, 130, 0.45),
            rgba(40, 0, 70, 0.55)
        );

    color: #ffffff;

    border-top: 1px solid rgba(255, 255, 255, 0.18);

    backdrop-filter: blur(15px);
}

.footer-container {
    width: 100%;

    max-width: 1400px;

    margin: 0 auto;

    padding: 0 30px;
}

.footer-content {
    display: grid;

    grid-template-columns:
        1.2fr
        1fr
        1.4fr;

    gap: 60px;

    padding: 55px 0 45px;
}

.footer-section {
    min-width: 0;
}

.footer-section h3 {
    margin: 0 0 20px;

    color: #ffffff;

    font-size: 18px;
}

.footer-section h3::after {
    content: "";

    display: block;

    width: 35px;

    height: 3px;

    margin-top: 8px;

    background: #ffffff;

    border-radius: 5px;
}

.footer-description {
    max-width: 330px;

    margin: 0 0 20px;

    color: rgba(255, 255, 255, 0.70);

    font-size: 14px;

    line-height: 1.7;
}

.footer-links {
    margin: 0;

    padding: 0;

    list-style: none;
}

.footer-links li {
    margin-bottom: 11px;
}

.footer-links a {
    display: inline-flex;

    align-items: center;

    gap: 9px;

    color: rgba(255, 255, 255, 0.70);

    font-size: 14px;

    transition:
        color 0.2s ease,
        transform 0.2s ease;
}

.footer-links a i {
    color: #ffffff;
}

.footer-links a:hover {
    color: #ffffff;

    transform: translateX(4px);
}

.site-footer .contact-info {
    display: flex;

    align-items: flex-start;

    gap: 13px;

    margin-bottom: 18px;
}

.site-footer .contact-icon {
    width: 34px;
    height: 34px;

    min-width: 34px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 8px;

    background: rgba(255, 255, 255, 0.10);

    color: #ffffff;
}

.site-footer .contact-text {
    min-width: 0;
}

.site-footer .contact-text a {
    display: block;

    color: rgba(255, 255, 255, 0.72);

    font-size: 14px;

    line-height: 1.6;

    word-break: break-word;
}

.site-footer .social-icons {
    width: 100%;

    display: flex;

    align-items: center;

    justify-content: flex-start;

    flex-wrap: wrap;

    gap: 10px;
}

.site-footer .social-icons a {
    width: 40px;
    height: 40px;

    min-width: 40px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.10);

    border: 1px solid rgba(255, 255, 255, 0.18);

    color: #ffffff;

    font-size: 16px;

    transition:
        transform 0.25s ease,
        background 0.25s ease;
}

.site-footer .social-icons a:hover {
    background: rgba(255, 255, 255, 0.22);

    border-color: rgba(255, 255, 255, 0.30);

    transform: translateY(-4px);
}

.footer-bottom {
    padding: 20px 0;

    border-top: 1px solid rgba(255, 255, 255, 0.12);

    text-align: center;
}

.footer-bottom p {
    margin: 0;

    color: rgba(255, 255, 255, 0.65);

    font-size: 13px;

    line-height: 1.6;
}


/* =========================================================
   25. TABLET
========================================================= */

@media (max-width: 1050px) {

    .features-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .course-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .teacher-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .contact-content {
        grid-template-columns: 1fr;

        gap: 50px;
    }

    .contact-visual {
        min-height: 500px;
    }

    .contact-image-card {
        max-width: 600px;
    }

    .contact-online {
        right: 5%;
    }

    .about-cta {
        grid-template-columns: 1fr;
    }

    .footer-content {
        grid-template-columns:
            1fr
            1fr;
    }
}


/* =========================================================
   26. TABLET 768
========================================================= */

@media (max-width: 768px) {

    .features-grid,
    .course-grid,
    .teacher-grid,
    .toppers-container,
    .collage {
        grid-template-columns: 1fr;
    }

    .gallery-slider {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .founder-grid {
        grid-template-columns: 1fr;

        gap: 35px;
    }

    .testimonial-grid {
        grid-template-columns: 1fr;
    }

    .contact-section {
        padding: 70px 16px;
    }

    .contact-form {
        padding: 28px 22px;
    }

    .contact-row {
        grid-template-columns: 1fr;

        gap: 18px;

        margin-bottom: 18px;
    }

    .contact-visual {
        min-height: 400px;
    }

    .contact-highlights {
        grid-template-columns: 1fr;
    }

    .footer-container {
        padding: 0 20px;
    }

    .footer-content {
        grid-template-columns: 1fr;

        gap: 35px;

        padding: 40px 0 30px;
    }

    .notification-card {
        width: 290px;

        min-width: 290px;
    }
}


/* =========================================================
   27. MOBILE
========================================================= */

@media (max-width: 600px) {

    .hero {
        padding: 60px 16px;
    }

    .hero-subtitle {
        font-size: 18px;

        letter-spacing: 0.5px;
    }

    .hero-features span {
        font-size: 13px;

        padding: 8px 13px;
    }

    .hero-buttons .btn {
        width: 100%;

        min-width: 0;
    }

    .features,
    .about-section,
    .notifications,
    .gallery,
    .courses,
    .teachers,
    .founder,
    .testimonials {
        padding: 70px 0;
    }

    .section-title {
        margin-bottom: 35px;

        font-size: 32px;
    }

    .course-card {
        border-radius: 17px;
    }

    .course-image,
    .course-placeholder {
        height: 230px;
    }

    .course-title {
        min-height: auto;

        font-size: 24px;
    }

    .course-info {
        padding: 22px;
    }

    .course-meta span {
        font-size: 12px;
    }

    .discounted-price {
        font-size: 24px;
    }

    .gallery-slider {
        grid-template-columns: 1fr;
    }

    .gallery-slider img {
        height: 250px;
    }

    .contact-heading h2 {
        font-size: clamp(40px, 12vw, 54px);

        letter-spacing: -1.5px;
    }

    .contact-heading p {
        font-size: 14px;
    }

    .contact-form {
        padding: 24px 18px;

        border-radius: 18px;
    }

    .contact-form input {
        height: 58px;
    }

    .contact-form textarea {
        min-height: 155px;
    }

    .contact-image-card {
        min-height: 300px;

        padding: 15px;
    }

    .contact-image {
        max-height: 290px;
    }

    .contact-online {
        top: -5px;

        right: 0;

        padding: 8px 12px;
    }

    .founder-content h3 {
        font-size: 34px;
    }

    .footer-section h3 {
        font-size: 17px;
    }
}


/* =========================================================
   28. SMALL MOBILE
========================================================= */

@media (max-width: 450px) {

    .container {
        padding-left: 14px;
        padding-right: 14px;
    }

    .hero {
        padding-left: 12px;
        padding-right: 12px;
    }

    .hero-subtitle {
        font-size: 17px;
    }

    .hero-social a {
        width: 50px;
        height: 50px;

        flex-basis: 50px;
    }

    .course-image,
    .course-placeholder {
        height: 210px;
    }

    .course-placeholder h3 {
        font-size: 21px;
    }

    .course-info {
        padding: 20px;
    }

    .course-title {
        font-size: 22px;
    }

    .course-rating {
        font-size: 14px;
    }

    .course-meta {
        gap: 8px;
    }

    .course-meta span {
        font-size: 11px;
    }

    .course-price-container {
        gap: 9px;
    }

    .original-price {
        font-size: 13px;
    }

    .discounted-price {
        font-size: 22px;
    }

    .discount-badge {
        font-size: 10px;

        padding: 7px 8px;
    }

    .contact-section {
        padding: 55px 12px;
    }

    .contact-form {
        padding: 20px 15px;
    }

    .contact-form input {
        font-size: 13px;
    }

    .contact-form textarea {
        font-size: 13px;
    }

    .contact-submit-btn {
        min-height: 54px;

        font-size: 14px !important;
    }

    .contact-visual {
        min-height: 320px;

        padding: 10px;
    }

    .contact-image-card {
        min-height: 250px;
    }

    .contact-image {
        max-height: 240px;
    }

    .footer-container {
        padding: 0 16px;
    }

    .footer-bottom p {
        font-size: 11px;
    }

    .notification-card {
        width: 260px;

        min-width: 260px;

        padding: 20px;
    }
}


/* =========================================================
   29. VERY SMALL PHONES
========================================================= */

@media (max-width: 360px) {

    .hero-subtitle {
        font-size: 16px;
    }

    .hero-features span {
        font-size: 12px;

        padding: 7px 10px;
    }

    .course-title {
        font-size: 20px;
    }

    .course-info {
        padding: 17px;
    }

    .course-meta span {
        font-size: 10px;
    }

    .contact-heading h2 {
        font-size: 35px;
    }
}


/* =========================================================
   30. ACCESSIBILITY
========================================================= */

a:focus-visible,
button:focus-visible,
input:focus-visible,
textarea:focus-visible {
    outline: 2px solid #ffffff;

    outline-offset: 3px;
}


/* =========================================================
   31. REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation: none !important;

        transition: none !important;
    }
}

/* =========================================================
   ABOUT / QUICK FACTS SECTION
   UNIQUE ROYAL INDIGO + VIOLET GLASS DESIGN
   ONLY THIS SECTION IS CHANGED
========================================================= */

.about-section,
.quick-facts-section,
.about-wrapper {
    width: 100%;
    max-width: 100%;

    min-height: 760px;

    padding: 80px 5%;

    box-sizing: border-box;

    /*
     * UNIQUE BACKGROUND
     * Deep indigo + violet + subtle blue glow
     */
    background:
        radial-gradient(
            circle at 12% 20%,
            rgba(99, 102, 241, 0.45),
            transparent 32%
        ),
        radial-gradient(
            circle at 88% 75%,
            rgba(168, 85, 247, 0.40),
            transparent 34%
        ),
        linear-gradient(
            135deg,
            #17104f 0%,
            #25105f 45%,
            #351276 100%
        );

    overflow: visible !important;

    display: flex;
    align-items: center;

    position: relative;

    z-index: 1;
}


/* =========================================================
   SOFT BACKGROUND GLOW
========================================================= */

.about-section::before,
.quick-facts-section::before,
.about-wrapper::before {
    content: "";

    position: absolute;

    width: 420px;
    height: 420px;

    top: -180px;
    left: -120px;

    border-radius: 50%;

    background:
        rgba(129, 140, 248, 0.20);

    filter: blur(90px);

    pointer-events: none;

    z-index: 0;
}


.about-section::after,
.quick-facts-section::after,
.about-wrapper::after {
    content: "";

    position: absolute;

    width: 450px;
    height: 450px;

    right: -180px;
    bottom: -180px;

    border-radius: 50%;

    background:
        rgba(192, 132, 252, 0.18);

    filter: blur(100px);

    pointer-events: none;

    z-index: 0;
}


/* =========================================================
   SECTION CONTAINER
========================================================= */

.about-section > .container,
.quick-facts-section > .container,
.about-wrapper > .container {
    position: relative;

    z-index: 2;

    width: 100%;
}


/* =========================================================
   SECTION TITLE
========================================================= */

.about-section .section-title,
.quick-facts-section .section-title,
.about-wrapper .section-title {
    position: relative;

    z-index: 3;

    color: #ffffff !important;

    text-shadow:
        0 5px 25px rgba(0, 0, 0, 0.30);
}


/* =========================================================
   MAIN ABOUT CONTAINER
========================================================= */

.about-container,
.quick-facts-container,
.about-inner {
    width: 100%;

    max-width: 1510px;

    min-height: 620px;

    margin: 0 auto;

    padding: 38px;

    box-sizing: border-box;

    /*
     * White glass-like main card
     */
    background:
        rgba(255, 255, 255, 0.97);

    border: 1px solid rgba(255, 255, 255, 0.80);

    border-radius: 24px;

    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);

    gap: 42px;

    align-items: center;

    overflow: visible !important;

    position: relative;

    z-index: 2;

    box-shadow:
        0 35px 90px rgba(8, 4, 40, 0.35),
        0 10px 30px rgba(0, 0, 0, 0.12);
}


/* =========================================================
   QUICK FACTS CARD
========================================================= */

.quick-facts,
.quick-facts-card,
.about-info {
    width: 100%;

    min-height: 480px;

    padding: 42px 38px;

    box-sizing: border-box;

    background:
        linear-gradient(
            145deg,
            #ffffff 0%,
            #faf8ff 100%
        ) !important;

    border:
        1px solid rgba(99, 102, 241, 0.12);

    border-radius: 22px;

    color: #171717 !important;

    opacity: 1 !important;

    visibility: visible !important;

    display: flex;

    flex-direction: column;

    justify-content: center;

    overflow: visible !important;

    position: relative;

    z-index: 5;

    box-shadow:
        0 20px 50px rgba(30, 20, 80, 0.13);
}


/* =========================================================
   QUICK FACTS TOP ACCENT
========================================================= */

.quick-facts::before,
.quick-facts-card::before,
.about-info::before {
    content: "";

    position: absolute;

    top: 0;
    left: 35px;
    right: 35px;

    height: 4px;

    border-radius: 0 0 10px 10px;

    background:
        linear-gradient(
            90deg,
            #6366f1,
            #8b5cf6,
            #a855f7
        );
}


/* =========================================================
   FORCE CONTENT VISIBILITY
========================================================= */

.quick-facts,
.quick-facts *,
.quick-facts-card,
.quick-facts-card *,
.about-info,
.about-info * {
    opacity: 1 !important;

    visibility: visible !important;
}


/* =========================================================
   QUICK FACTS HEADING
========================================================= */

.quick-facts h1,
.quick-facts h2,
.quick-facts h3,
.quick-facts h4,
.quick-facts-card h1,
.quick-facts-card h2,
.quick-facts-card h3,
.quick-facts-card h4,
.about-info h1,
.about-info h2,
.about-info h3,
.about-info h4 {

    display: block !important;

    color: #5b21b6 !important;

    font-family:
        Arial,
        Helvetica,
        sans-serif !important;

    font-size: 30px !important;

    line-height: 1.3 !important;

    font-weight: 800 !important;

    margin: 0 0 28px 0 !important;

    opacity: 1 !important;

    visibility: visible !important;

    text-shadow: none !important;
}


/* =========================================================
   PARAGRAPHS
========================================================= */

.quick-facts p,
.quick-facts-card p,
.about-info p {

    display: block !important;

    color: #292929 !important;

    font-family:
        Arial,
        Helvetica,
        sans-serif !important;

    font-size: 17px !important;

    line-height: 1.7 !important;

    font-weight: 500 !important;

    margin: 0 0 14px 0 !important;

    opacity: 1 !important;

    visibility: visible !important;
}


/* =========================================================
   LIST
========================================================= */

.quick-facts ul,
.quick-facts ol,
.quick-facts-card ul,
.quick-facts-card ol,
.about-info ul,
.about-info ol {

    display: block !important;

    color: #222222 !important;

    margin: 0 !important;

    padding-left: 24px !important;

    opacity: 1 !important;

    visibility: visible !important;
}


.quick-facts li,
.quick-facts-card li,
.about-info li {

    display: list-item !important;

    color: #333333 !important;

    font-family:
        Arial,
        Helvetica,
        sans-serif !important;

    font-size: 17px !important;

    line-height: 1.7 !important;

    font-weight: 500 !important;

    margin-bottom: 10px !important;

    opacity: 1 !important;

    visibility: visible !important;
}


/* =========================================================
   FACT ROWS
========================================================= */

.quick-facts .fact,
.quick-facts-card .fact,
.about-info .fact {

    width: 100%;

    padding: 18px 0;

    box-sizing: border-box;

    border-bottom:
        1px solid #e8e4f3;

    color: #222222 !important;

    font-family:
        Arial,
        Helvetica,
        sans-serif !important;

    font-size: 17px !important;

    line-height: 1.6 !important;

    font-weight: 500 !important;

    opacity: 1 !important;

    visibility: visible !important;

    display: block !important;
}


/* =========================================================
   STRONG / BOLD TEXT
========================================================= */

.quick-facts strong,
.quick-facts b,
.quick-facts-card strong,
.quick-facts-card b,
.about-info strong,
.about-info b {

    color: #171717 !important;

    font-weight: 800 !important;

    opacity: 1 !important;

    visibility: visible !important;
}


/* =========================================================
   LINKS
========================================================= */

.quick-facts a:not(.btn),
.quick-facts-card a:not(.btn),
.about-info a:not(.btn) {

    color: #6d28d9 !important;

    opacity: 1 !important;

    visibility: visible !important;

    text-decoration: none;
}


/* =========================================================
   IMAGE CARD
========================================================= */

.about-image,
.about-logo,
.quick-facts-image {

    width: 100%;

    min-height: 640px;

    padding: 38px;

    box-sizing: border-box;

    background:
        linear-gradient(
            145deg,
            #f8f7ff,
            #eeeaff
        ) !important;

    border:
        1px solid rgba(255, 255, 255, 0.80);

    border-radius: 24px;

    display: flex;

    align-items: center;

    justify-content: center;

    overflow: visible !important;

    position: relative;

    z-index: 4;

    box-shadow:
        0 25px 60px rgba(40, 20, 90, 0.16);
}




/* =========================================================
   GALLERY - FINAL SIZE FIX
========================================================= */

.gallery-container {
    position: relative;
    width: 100%;
    min-height: 390px;

    padding: 20px;

    box-sizing: border-box;

    overflow: hidden;
}


/* =========================================================
   SLIDER
========================================================= */

.gallery-slider {
    position: relative;

    width: 100%;
    height: 350px;

    min-height: 350px;

    overflow: hidden;

    border-radius: 18px;

    background: rgba(0, 0, 0, 0.12);
}


/* =========================================================
   SLIDE
========================================================= */

.gallery-slide {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    overflow: hidden;

    opacity: 0;
    visibility: hidden;

    transition:
        opacity 0.45s ease,
        transform 0.45s ease;
}


.gallery-slide.active {
    opacity: 1;
    visibility: visible;
}


/* =========================================================
   BLURRED BACKGROUND
========================================================= */

.gallery-slide::before {
    content: "";

    position: absolute;

    inset: -40px;

    background-image: var(--gallery-image);

    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;

    filter: blur(25px);

    transform: scale(1.12);

    opacity: 0.55;

    z-index: 0;
}


.gallery-slide::after {
    content: "";

    position: absolute;

    inset: 0;

    background: rgba(60, 0, 100, 0.30);

    z-index: 1;
}


/* =========================================================
   MAIN PHOTO
========================================================= */

.gallery-slider .gallery-image {
    position: relative;

    z-index: 2;

    display: block;

    width: auto !important;

    height: 100% !important;

    max-width: 92% !important;
    max-height: 100% !important;

    object-fit: contain !important;

    object-position: center;

    padding: 0 !important;

    margin: 0 auto;

    border: none !important;

    border-radius: 12px !important;

    background: transparent !important;

    box-shadow:
        0 12px 35px rgba(0, 0, 0, 0.35);
}


/* =========================================================
   NAVIGATION
========================================================= */

.gallery-nav {
    position: absolute;

    top: 50%;

    z-index: 10;

    width: 50px;
    height: 50px;

    display: flex;

    align-items: center;
    justify-content: center;

    transform: translateY(-50%);

    border-radius: 50%;

    color: #fff;

    background: rgba(70, 0, 120, 0.78);

    border: 1px solid rgba(255, 255, 255, 0.25);

    cursor: pointer;

    backdrop-filter: blur(10px);

    transition:
        transform 0.2s ease,
        background 0.2s ease;
}


.gallery-nav:hover {
    transform:
        translateY(-50%)
        scale(1.08);

    background: rgba(100, 0, 160, 0.95);
}


.gallery-prev {
    left: 12px;
}


.gallery-next {
    right: 12px;
}


/* =========================================================
   DOTS
========================================================= */

.gallery-dots {
    position: absolute;

    left: 50%;
    bottom: 16px;

    transform: translateX(-50%);

    z-index: 20;

    display: flex;

    align-items: center;
    justify-content: center;

    gap: 7px;
}


.gallery-dot {
    width: 8px;
    height: 8px;

    padding: 0;

    border: none;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.45);

    cursor: pointer;

    transition:
        width 0.25s ease,
        background 0.25s ease;
}


.gallery-dot.active {
    width: 25px;

    border-radius: 20px;

    background: #fff;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .gallery-container {
        min-height: 300px;

        padding: 10px 10px 48px;

        border-radius: 18px;
    }

    .gallery-slider {
        height: 260px;

        min-height: 260px;

        border-radius: 14px;
    }

    .gallery-slider .gallery-image {
        max-width: 90% !important;
    }

    .gallery-nav {
        width: 40px;
        height: 40px;
    }

    .gallery-prev {
        left: 6px;
    }

    .gallery-next {
        right: 6px;
    }

}

/* =========================================================
   IMAGE CARD DECORATION
========================================================= */

.about-image::before,
.about-logo::before,
.quick-facts-image::before {

    content: "";

    position: absolute;

    width: 180px;
    height: 180px;

    top: 25px;
