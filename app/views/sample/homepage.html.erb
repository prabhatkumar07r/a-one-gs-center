/* =========================================================
   ACHIEVEMENT VIDEO MODAL
========================================================= */

.achievement-video-modal {
  position: fixed;

  inset: 0;

  width: 100%;
  height: 100vh;

  display: none;

  align-items: center;
  justify-content: center;

  padding: 25px;

  box-sizing: border-box;

  background:
    rgba(10, 5, 30, 0.82);

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);

  z-index: 99999;

  opacity: 0;

  transition:
    opacity 0.3s ease;
}


/* =========================================================
   SHOW MODAL
========================================================= */

.achievement-video-modal.show {
  display: flex;

  opacity: 1;
}


/* =========================================================
   MODAL CONTENT
========================================================= */

.achievement-video-modal-content {

  position: relative;

  width: min(
    900px,
    95vw
  );

  max-height: 90vh;

  overflow: hidden;

  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      #24145c,
      #3d1979
    );

  border: 1px solid
    rgba(
      255,
      255,
      255,
      0.18
    );

  box-shadow:
    0 30px 90px
    rgba(
      0,
      0,
      0,
      0.55
    );

  transform:
    translateY(20px)
    scale(0.96);

  transition:
    transform 0.3s ease;

  box-sizing: border-box;
}


/* =========================================================
   MODAL OPEN ANIMATION
========================================================= */

.achievement-video-modal.show
.achievement-video-modal-content {

  transform:
    translateY(0)
    scale(1);
}


/* =========================================================
   HEADER
========================================================= */

.achievement-video-modal-header {

  width: 100%;

  padding:
    22px 70px 20px 25px;

  box-sizing: border-box;

  background:
    linear-gradient(
      135deg,
      #8b21df,
      #7420d0
    );

  border-bottom: 1px solid
    rgba(
      255,
      255,
      255,
      0.12
    );
}


.achievement-video-modal-header h3 {

  margin: 0;

  color: #ffffff;

  font-size: 24px;

  line-height: 1.35;

  font-weight: 750;

  word-break: break-word;
}


/* =========================================================
   CLOSE BUTTON
========================================================= */

.achievement-video-close {

  position: absolute;

  top: 15px;
  right: 15px;

  width: 42px;
  height: 42px;

  padding: 0;

  border: none;

  border-radius: 50%;

  display: flex;

  align-items: center;
  justify-content: center;

  background:
    rgba(
      255,
      255,
      255,
      0.18
    );

  color: #ffffff;

  font-size: 17px;

  cursor: pointer;

  z-index: 20;

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}


.achievement-video-close:hover {

  background:
    rgba(
      255,
      255,
      255,
      0.30
    );

  transform:
    rotate(90deg)
    scale(1.05);
}


/* =========================================================
   VIDEO CONTAINER
========================================================= */

.achievement-video-container {

  width: 100%;

  aspect-ratio: 16 / 9;

  background: #000;

  overflow: hidden;

  display: flex;

  align-items: center;
  justify-content: center;
}


/* =========================================================
   VIDEO
========================================================= */

.achievement-video-container video {

  width: 100%;
  height: 100%;

  display: block;

  object-fit: contain;

  background: #000;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

  .achievement-video-modal {

    padding: 12px;
  }

  .achievement-video-modal-content {

    width: 100%;

    max-height: 85vh;

    border-radius: 16px;
  }

  .achievement-video-modal-header {

    padding:
      18px 58px 16px 18px;
  }

  .achievement-video-modal-header h3 {

    font-size: 18px;
  }

  .achievement-video-close {

    top: 10px;
    right: 10px;

    width: 36px;
    height: 36px;

    font-size: 14px;
  }

}


/* =========================================================
   VERY SMALL MOBILE
========================================================= */

@media (max-width: 420px) {

  .achievement-video-modal {

    padding: 8px;
  }

  .achievement-video-modal-header h3 {

    font-size: 16px;
  }

}



.achievements-slider-container {
