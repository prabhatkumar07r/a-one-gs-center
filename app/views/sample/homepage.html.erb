<script nonce="<%= content_security_policy_nonce %>">
(function () {

  /* =========================================================
     MAIN INITIALIZATION
  ========================================================= */

  function initializeHomepage() {

    /* =======================================================
       GLOBAL HORIZONTAL OVERFLOW PROTECTION
    ======================================================= */

    document.documentElement.style.overflowX = "hidden";
    document.body.style.overflowX = "hidden";


    /* =======================================================
       SMOOTH ANCHOR NAVIGATION
    ======================================================= */

    document
      .querySelectorAll('a[href^="#"]')
      .forEach(function (link) {

        if (link.dataset.smoothScrollReady === "true") {
          return;
        }

        link.dataset.smoothScrollReady = "true";

        link.addEventListener("click", function (event) {

          const targetId = this.getAttribute("href");

          if (!targetId || targetId === "#") {
            return;
          }

          const target = document.querySelector(targetId);

          if (!target) {
            return;
          }

          event.preventDefault();

          target.scrollIntoView({
            behavior: "smooth",
            block: "start"
          });

        });

      });


    /* =========================================================
       AUTOMATIC NOTIFICATION TICKER
    ========================================================= */

    initializeNotificationTicker();


    /* =========================================================
       GALLERY CAROUSEL
    ========================================================= */

    initializeGallery();


    /* =========================================================
       ACHIEVEMENT SLIDER
    ========================================================= */

    initializeAchievementSlider();


    /* =========================================================
       ACHIEVEMENT VIDEO MODAL
    ========================================================= */

    initializeAchievementVideos();


    /* =========================================================
       CONTACT FORM
    ========================================================= */

    initializeContactForm();


    /* =========================================================
       IMAGE ERROR PROTECTION
    ========================================================= */

    initializeImageProtection();


    /* =========================================================
       INTERSECTION FADE-IN
    ========================================================= */

    initializeIntersectionAnimations();

  }


  /* ============================================================
     NOTIFICATION TICKER
  ============================================================ */

  function initializeNotificationTicker() {

    const ticker =
      document.getElementById("notificationTicker");


    if (!ticker) {
      return;
    }


    if (
      ticker.dataset.tickerInitialized === "true"
    ) {
      return;
    }


    ticker.dataset.tickerInitialized = "true";


    const originalCards =
      Array.from(ticker.children);


    if (originalCards.length === 0) {
      return;
    }


    /* ========================================================
       DUPLICATE CARDS FOR CONTINUOUS LOOP
    ======================================================== */

    originalCards.forEach(function (card) {

      const clone = card.cloneNode(true);

      clone.setAttribute(
        "aria-hidden",
        "true"
      );

      ticker.appendChild(clone);

    });


    /* ========================================================
       SPEED
    ======================================================== */

    ticker.style.animationDuration = "35s";


    /* ========================================================
       TOUCH PAUSE
    ======================================================== */

    ticker.addEventListener(
      "touchstart",
      function () {

        ticker.style.animationPlayState =
          "paused";

      },
      {
        passive: true
      }
    );


    ticker.addEventListener(
      "touchend",
      function () {

        ticker.style.animationPlayState =
          "running";

      },
      {
        passive: true
      }
    );

  }


  /* ============================================================
     GALLERY CAROUSEL
  ============================================================ */

  function initializeGallery() {

    const gallerySlider =
      document.getElementById("gallerySlider");


    const galleryPrev =
      document.getElementById("galleryPrev");


    const galleryNext =
      document.getElementById("galleryNext");


    const galleryDots =
      document.getElementById("galleryDots");


    if (
      !gallerySlider ||
      !galleryPrev ||
      !galleryNext
    ) {
      return;
    }


    if (
      gallerySlider.dataset.galleryInitialized ===
      "true"
    ) {
      return;
    }


    gallerySlider.dataset.galleryInitialized =
      "true";


    const slides =
      Array.from(
        gallerySlider.querySelectorAll(
          ".gallery-slide"
        )
      );


    if (slides.length === 0) {
      return;
    }


    let currentIndex = 0;

    let autoPlay = null;


    /* ========================================================
       CREATE DOTS
    ======================================================== */

    if (galleryDots) {

      galleryDots.innerHTML = "";


      slides.forEach(function (
        slide,
        index
      ) {

        const dot =
          document.createElement("button");


        dot.type = "button";

        dot.className = "gallery-dot";


        dot.setAttribute(
          "aria-label",
          "Go to gallery image " +
          (index + 1)
        );


        dot.addEventListener(
          "click",
          function () {

            showSlide(index);

            restartAutoPlay();

          }
        );


        galleryDots.appendChild(dot);

      });

    }


    const dots =
      galleryDots
        ? galleryDots.querySelectorAll(
            ".gallery-dot"
          )
        : [];


    /* ========================================================
       SHOW SLIDE
    ======================================================== */

    function showSlide(index) {

      if (
        index >= slides.length
      ) {

        index = 0;

      }


      if (
        index < 0
      ) {

        index =
          slides.length - 1;

      }


      currentIndex = index;


      slides.forEach(
        function (
          slide,
          slideIndex
        ) {

          slide.classList.toggle(
            "active",
            slideIndex === currentIndex
          );

        }
      );


      dots.forEach(
        function (
          dot,
          dotIndex
        ) {

          dot.classList.toggle(
            "active",
            dotIndex === currentIndex
          );

        }
      );

    }


    /* ========================================================
       NEXT
    ======================================================== */

    function nextSlide() {

      showSlide(
        currentIndex + 1
      );

    }


    /* ========================================================
       PREVIOUS
    ======================================================== */

    function previousSlide() {

      showSlide(
        currentIndex - 1
      );

    }


    /* ========================================================
       BUTTONS
    ======================================================== */

    galleryNext.addEventListener(
      "click",
      function () {

        nextSlide();

        restartAutoPlay();

      }
    );


    galleryPrev.addEventListener(
      "click",
      function () {

        previousSlide();

        restartAutoPlay();

      }
    );


    /* ========================================================
       AUTOPLAY
    ======================================================== */

    function startAutoPlay() {

      stopAutoPlay();


      autoPlay =
        setInterval(
          function () {

            nextSlide();

          },
          4000
        );

    }


    function stopAutoPlay() {

      if (
        autoPlay !== null
      ) {

        clearInterval(
          autoPlay
        );

        autoPlay = null;

      }

    }


    function restartAutoPlay() {

      stopAutoPlay();

      startAutoPlay();

    }


    /* ========================================================
       HOVER
    ======================================================== */

    gallerySlider.addEventListener(
      "mouseenter",
      function () {

        stopAutoPlay();

      }
    );


    gallerySlider.addEventListener(
      "mouseleave",
      function () {

        startAutoPlay();

      }
    );


    /* ========================================================
       KEYBOARD
    ======================================================== */

    gallerySlider.addEventListener(
      "keydown",
      function (event) {

        if (
          event.key === "ArrowLeft"
        ) {

          previousSlide();

          restartAutoPlay();

        }


        if (
          event.key === "ArrowRight"
        ) {

          nextSlide();

          restartAutoPlay();

        }

      }
    );


    /* ========================================================
       BLURRED BACKGROUND
    ======================================================== */

    slides.forEach(
      function (slide) {

        const image =
          slide.querySelector(
            ".gallery-image"
          );


        if (
          image &&
          image.src
        ) {

          slide.style.setProperty(
            "--gallery-image",
            'url("' +
            image.src +
            '")'
          );

        }

      }
    );


    /* ========================================================
       INITIALIZE
    ======================================================== */

    showSlide(0);

    startAutoPlay();

  }





  /* ============================================================
     ACHIEVEMENT VIDEO MODAL
  ============================================================ */

  function initializeAchievementVideos() {

    const modal =
      document.getElementById(
        "achievementVideoModal"
      );


    const player =
      document.getElementById(
        "achievementVideoPlayer"
      );


    const title =
      document.getElementById(
        "achievementVideoTitle"
      );


    const closeButton =
      document.getElementById(
        "closeAchievementVideo"
      );


    if (
      !modal ||
      !player ||
      !closeButton
    ) {
      return;
    }


    if (
      modal.dataset.videoModalReady ===
      "true"
    ) {
      return;
    }


    modal.dataset.videoModalReady =
      "true";


    /* ========================================================
       OPEN VIDEO
    ======================================================== */

    document
      .querySelectorAll(
        ".achievement-video-btn"
      )
      .forEach(
        function (button) {

          if (
            button.dataset.videoInitialized ===
            "true"
          ) {
            return;
          }


          button.dataset.videoInitialized =
            "true";


          button.addEventListener(
            "click",
            function () {

              const videoURL =
                button.dataset.videoUrl;


              const videoTitle =
                button.dataset.videoTitle ||
                "Success Story";


              if (!videoURL) {
                return;
              }


              if (title) {

                title.textContent =
                  videoTitle;

              }


              player.src =
                videoURL;


              modal.classList.add(
                "show"
              );


              modal.setAttribute(
                "aria-hidden",
                "false"
              );


              document.body.style.overflow =
                "hidden";


              const playPromise =
                player.play();


              if (
                playPromise !== undefined
              ) {

                playPromise.catch(
                  function () {

                    /*
                     * Browser autoplay
                     * may be blocked.
                     */

                  }
                );

              }

            }
          );

        }
      );


    /* ========================================================
       CLOSE VIDEO
    ======================================================== */

    function closeVideo() {

      player.pause();


      player.removeAttribute(
        "src"
      );


      player.load();


      modal.classList.remove(
        "show"
      );


      modal.setAttribute(
        "aria-hidden",
        "true"
      );


      document.body.style.overflow =
        "";

    }


    closeButton.addEventListener(
      "click",
      closeVideo
    );


    /* ========================================================
       CLICK OUTSIDE
    ======================================================== */

    modal.addEventListener(
      "click",
      function (event) {

        if (
          event.target === modal
        ) {

          closeVideo();

        }

      }
    );


    /* ========================================================
       ESCAPE
    ======================================================== */

    document.addEventListener(
      "keydown",
      function (event) {

        if (
          event.key === "Escape" &&
          modal.classList.contains(
            "show"
          )
        ) {

          closeVideo();

        }

      }
    );

  }


  /* ============================================================
     CONTACT FORM
  ============================================================ */

  function initializeContactForm() {

    const contactForm =
      document.querySelector(
        ".contact-form"
      );


    const submitButton =
      document.querySelector(
        ".contact-submit-btn"
      );


    if (
      !contactForm ||
      !submitButton
    ) {
      return;
    }


    if (
      contactForm.dataset.contactReady ===
      "true"
    ) {
      return;
    }


    contactForm.dataset.contactReady =
      "true";


    contactForm.addEventListener(
      "submit",
      function () {

        submitButton.innerHTML =
          '<i class="bi bi-send-fill"></i>&nbsp; Sending...';


        submitButton.style.opacity =
          "0.85";

      }
    );

  }


  /* ============================================================
     IMAGE ERROR PROTECTION
  ============================================================ */

  function initializeImageProtection() {

    document
      .querySelectorAll("img")
      .forEach(
        function (image) {

          if (
            image.dataset.imageProtectionReady ===
            "true"
          ) {
            return;
          }


          image.dataset.imageProtectionReady =
            "true";


          image.addEventListener(
            "error",
            function () {

              this.style.opacity =
                "0.65";

            }
          );

        }
      );

  }


  /* ============================================================
     INTERSECTION FADE-IN
  ============================================================ */

  function initializeIntersectionAnimations() {

    if (
      !("IntersectionObserver" in window)
    ) {
      return;
    }


    const animatedElements =
      document.querySelectorAll(
        ".feature-card, " +
        ".topper-card, " +
        ".event-card, " +
        ".course-card, " +
        ".teacher-card, " +
        ".testimonial-card, " +
        ".highlight-box, " +
        ".notification-card"
      );


    if (
      animatedElements.length === 0
    ) {
      return;
    }


    const observer =
      new IntersectionObserver(
        function (
          entries
        ) {

          entries.forEach(
            function (entry) {

              if (
                entry.isIntersecting
              ) {

                entry.target.style.opacity =
                  "1";


                entry.target.style.transform =
                  "translateY(0)";


                observer.unobserve(
                  entry.target
                );

              }

            }
          );

        },
        {
          threshold: 0.08
        }
      );


    animatedElements.forEach(
      function (element) {

        if (
          element.dataset.animationReady ===
          "true"
        ) {
          return;
        }


        element.dataset.animationReady =
          "true";


        element.style.opacity =
          "0";


        element.style.transform =
          "translateY(15px)";


        element.style.transition =
          "opacity 0.6s ease, " +
          "transform 0.6s ease";


        observer.observe(
          element
        );

      }
    );

  }


  /* ============================================================
     DOM READY
  ============================================================ */

  document.addEventListener(
    "DOMContentLoaded",
    initializeHomepage
  );


  /* ============================================================
     TURBO LOAD
  ============================================================ */

  document.addEventListener(
    "turbo:load",
    initializeHomepage
  );

})();


function initializeAchievementSlider() {

  const viewport = document.getElementById("achievementsSlider");
  const track = viewport
    ? viewport.querySelector(".achievements-track")
    : null;

  const prevButton = document.getElementById("achievementPrev");
  const nextButton = document.getElementById("achievementNext");

  if (!viewport || !track || !prevButton || !nextButton) {
    return;
  }

  if (viewport.dataset.achievementSliderReady === "true") {
    return;
  }

  viewport.dataset.achievementSliderReady = "true";

  const cards = Array.from(
    track.querySelectorAll(".topper-card")
  );

  if (cards.length <= 1) {
    return;
  }

  let currentIndex = 0;
  let visibleCards = 3;
  let autoPlayTimer = null;
  let resizeTimer = null;
  let isMoving = false;


  /* =========================================================
     VISIBLE CARDS
  ========================================================= */

  function getVisibleCards() {

    if (window.innerWidth <= 700) {
      return 1;
    }

    if (window.innerWidth <= 1100) {
      return 2;
    }

    return 3;
  }


  /* =========================================================
     SET CARD WIDTH
  ========================================================= */

  function setupSlider() {

    visibleCards = getVisibleCards();

    const viewportWidth = viewport.clientWidth;

    const styles = window.getComputedStyle(track);

    const gap =
      parseFloat(styles.columnGap) ||
      parseFloat(styles.gap) ||
      0;

    const cardWidth =
      (
        viewportWidth -
        gap * (visibleCards - 1)
      ) / visibleCards;


    cards.forEach(function(card) {

      card.style.width = cardWidth + "px";
      card.style.minWidth = cardWidth + "px";
      card.style.maxWidth = cardWidth + "px";

      card.style.flex =
        "0 0 " + cardWidth + "px";

      card.style.boxSizing =
        "border-box";

    });


    currentIndex = 0;

    track.style.transition = "none";

    track.style.transform =
      "translate3d(0,0,0)";


    track.offsetHeight;


    track.style.transition =
      "transform 0.7s ease";

  }


  /* =========================================================
     MAXIMUM INDEX
  ========================================================= */

  function getMaxIndex() {

    return Math.max(
      0,
      cards.length - visibleCards
    );

  }


  /* =========================================================
     MOVE
  ========================================================= */

  function moveSlider(index, animate) {

    const maxIndex = getMaxIndex();


    if (index > maxIndex) {
      index = 0;
    }


    if (index < 0) {
      index = maxIndex;
    }


    currentIndex = index;


    const targetCard =
      cards[currentIndex];


    if (!targetCard) {
      return;
    }


    const distance =
      targetCard.offsetLeft;


    if (animate) {

      isMoving = true;

      track.style.transition =
        "transform 0.7s ease";

    } else {

      track.style.transition =
        "none";

    }


    track.style.transform =
      "translate3d(-" +
      distance +
      "px,0,0)";


    if (animate) {

      window.setTimeout(
        function() {
          isMoving = false;
        },
        750
      );

    }

  }


  /* =========================================================
     NEXT
  ========================================================= */

  function nextAchievement() {

    if (isMoving) {
      return;
    }


    moveSlider(
      currentIndex + 1,
      true
    );

  }


  /* =========================================================
     PREVIOUS
  ========================================================= */

  function previousAchievement() {

    if (isMoving) {
      return;
    }


    moveSlider(
      currentIndex - 1,
      true
    );

  }


  /* =========================================================
     BUTTONS
  ========================================================= */

  nextButton.addEventListener(
    "click",
    function() {

      nextAchievement();

      restartAutoPlay();

    }
  );


  prevButton.addEventListener(
    "click",
    function() {

      previousAchievement();

      restartAutoPlay();

    }
  );


  /* =========================================================
     AUTOPLAY
  ========================================================= */

  function startAutoPlay() {

    stopAutoPlay();


    autoPlayTimer =
      window.setInterval(
        function() {

          nextAchievement();

        },
        5000
      );

  }


  function stopAutoPlay() {

    if (autoPlayTimer !== null) {

      window.clearInterval(
        autoPlayTimer
      );

      autoPlayTimer = null;

    }

  }


  function restartAutoPlay() {

    stopAutoPlay();

    startAutoPlay();

  }


  /* =========================================================
     HOVER
  ========================================================= */

  viewport.addEventListener(
    "mouseenter",
    stopAutoPlay
  );


  viewport.addEventListener(
    "mouseleave",
    startAutoPlay
  );


  /* =========================================================
     TOUCH
  ========================================================= */

  viewport.addEventListener(
    "touchstart",
    stopAutoPlay,
    { passive: true }
  );


  viewport.addEventListener(
    "touchend",
    startAutoPlay,
    { passive: true }
  );


  /* =========================================================
     RESIZE
  ========================================================= */

  window.addEventListener(
    "resize",
    function() {

      window.clearTimeout(
        resizeTimer
      );


      resizeTimer =
        window.setTimeout(
          function() {

            setupSlider();

            moveSlider(
              0,
              false
            );

            startAutoPlay();

          },
          150
        );

    }
  );


  /* =========================================================
     INITIALIZE
  ========================================================= */

  setupSlider();

  moveSlider(
    0,
    false
  );

  startAutoPlay();

}
</script>