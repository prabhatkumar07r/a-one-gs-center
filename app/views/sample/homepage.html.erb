      </button>

      <button
        type="button"
        class="gallery-filter"
        data-gallery-filter="results">
        <i class="bi bi-mortarboard"></i>
        Results
      </button>

      <button
        type="button"
        class="gallery-filter"
        data-gallery-filter="students">
        <i class="bi bi-people"></i>
        Students
      </button>

      <button
        type="button"
        class="gallery-filter"
        data-gallery-filter="faculty">
        <i class="bi bi-person"></i>
        Faculty
      </button>

      <button
        type="button"
        class="gallery-filter"
        data-gallery-filter="study">
        <i class="bi bi-journal-bookmark"></i>
        Study
      </button>

    </div>


    <!-- =====================================================
         GALLERY GRID
    ===================================================== -->

    <div
      class="gallery-grid"
      id="galleryGrid">

      <% if @galleries.present? %>

        <% @galleries.each do |gallery| %>

          <% next unless gallery.photos.attached? %>

          <%
            gallery_categories =
              Array(gallery.categories)
                .reject(&:blank?)
                .map { |cat| cat.to_s.downcase.strip }

            gallery_categories = ["other"] if gallery_categories.empty?

            category_labels = {
              "classes"      => "Classes",
              "events"       => "Events",
              "achievements" => "Achievements",
              "results"      => "Results",
              "students"     => "Students",
              "faculty"      => "Faculty",
              "study"        => "Study",
              "other"        => "Gallery"
            }

            category_icons = {
              "classes"      => "bi-book",
              "events"       => "bi-calendar-event",
              "achievements" => "bi-trophy",
              "results"      => "bi-mortarboard",
              "students"     => "bi-people",
              "faculty"      => "bi-person",
              "study"        => "bi-journal-bookmark",
              "other"        => "bi-images"
            }

            primary_category = gallery_categories.first

            primary_badge =
              category_labels[primary_category] ||
              primary_category.humanize

            primary_icon =
              category_icons[primary_category] ||
              "bi-images"
          %>


          <!-- =================================================
               EACH PHOTO
          ================================================= -->

          <% gallery.photos.each do |photo| %>

            <article
              class="gallery-card"
              data-gallery-item
              data-gallery-category="<%= gallery_categories.join(' ') %>"
              data-gallery-url="<%= url_for(photo) %>"
              data-gallery-title="<%= gallery.title.presence || 'A One GS Center' %>"
              data-gallery-description="<%= gallery.description.to_s %>"
            >

              <!-- IMAGE -->

              <div class="gallery-image-wrapper">

                <%= image_tag photo,
                    class: "gallery-image",
                    alt: gallery.title.presence || "A One GS Center Gallery",
                    loading: "lazy" %>


                <!-- TOP BRAND -->

                <div class="gallery-brand">

                  <span class="brand-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                  </span>

                  <span>
                    A One GS Center
                  </span>

                </div>


                <!-- CATEGORY -->

                <div class="gallery-badge">

                  <i class="bi <%= primary_icon %>"></i>

                  <%= primary_badge %>

                </div>


                <!-- HOVER OVERLAY -->

                <div class="gallery-overlay">

                  <div class="gallery-view-btn">

                    <i class="bi bi-zoom-in"></i>

                  </div>

                  <span>
                    View Photo
                  </span>

                </div>

              </div>


              <!-- =================================================
                   CARD CONTENT
              ================================================= -->

              <div class="gallery-card-info">


                <!-- CATEGORY -->

                <div class="gallery-card-category">

                  <i class="bi <%= primary_icon %>"></i>

                  <%= primary_badge %>

                </div>


                <!-- TITLE -->

                <h3 class="gallery-card-title">

                  <%= gallery.title.presence ||
                      "A One GS Center" %>

                </h3>


                <!-- DESCRIPTION -->

                <% if gallery.description.present? %>

                  <p class="gallery-card-description">

                    <%= truncate(
                          gallery.description,
                          length: 120
                        ) %>

                  </p>

                <% end %>


                <!-- FOOTER -->

                <div class="gallery-card-footer">

                  <span>

                    <i class="bi bi-heart"></i>

                    Keep Learning + Keep Growing

                  </span>


                  <button
                    type="button"
                    class="gallery-arrow"
                    aria-label="View gallery">

                    <i class="bi bi-arrow-up-right"></i>

                  </button>

                </div>

              </div>

            </article>

          <% end %>

        <% end %>


      <% else %>

        <!-- =================================================
             EMPTY STATE
        ================================================= -->

        <div class="gallery-empty">

          <i class="bi bi-images"></i>

          <h3>
            No Gallery Images Yet
          </h3>

          <p>
            Gallery photos will appear here soon.
          </p>

        </div>

      <% end %>

    </div>

  </div>

</section>


