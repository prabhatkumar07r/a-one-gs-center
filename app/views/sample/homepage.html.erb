<section class="contact-section" id="contact">

    <div class="contact-container">

        <div class="contact-heading">

            <span class="contact-eyebrow">

                <i class="bi bi-headset"></i>

                We're Here to Help

            </span>

            <h2>
                Let's Start a <span>Conversation</span>
            </h2>

            <p>
                Looking for the right course, need guidance about admissions,
                or simply have a question? Send us a message and our team
                will get back to you shortly.
            </p>

        </div>


        <div class="contact-content">


            <!-- CONTACT FORM -->

            <div class="contact-form-wrapper">

                <div class="contact-form-header">

                    <div class="contact-form-icon">

                        <i class="bi bi-send"></i>

                    </div>

                    <div>

                        <h3>
                            Send Us a Message
                        </h3>

                        <p>
                            Fill in the details below and we'll connect with you.
                        </p>

                    </div>

                </div>


                <%= form_with url: contacts_path,
                    method: :post,
                    local: true,
                    multipart: true,
                    class: "contact-form" do |form| %>


                    <div class="contact-row">

                        <div class="contact-field">

                            <%= form.label :name, "Your Name *" %>

                            <div class="input-wrapper">

                                <i class="bi bi-person"></i>

                                <%= form.text_field :name,
                                    placeholder: "e.g. Rahul Kumar",
                                    required: true %>

                            </div>

                        </div>


                        <div class="contact-field">

                            <%= form.label :email, "Email ID *" %>

                            <div class="input-wrapper">

                                <i class="bi bi-envelope"></i>

                                <%= form.email_field :email,
                                    placeholder: "you@example.com",
                                    required: true %>

                            </div>

                        </div>

                    </div>


                    <div class="contact-row">

                        <div class="contact-field">

                            <%= form.label :mobile, "Mobile Number *" %>

                            <div class="input-wrapper">

                                <i class="bi bi-phone"></i>

                                <%= form.telephone_field :mobile,
                                    placeholder: "Enter your mobile number",
                                    required: true %>

                            </div>

                        </div>


                        <div class="contact-field">

                            <%= form.label :subject, "How Can We Help? *" %>

                            <div class="input-wrapper">

                                <i class="bi bi-question-circle"></i>

                                <%= form.text_field :subject,
                                    placeholder: "Course, admission, enquiry...",
                                    required: true %>

                            </div>

                        </div>

                    </div>


                    <div class="contact-field">

                        <%= form.label :message, "Your Message *" %>

                        <div class="textarea-wrapper">

                            <i class="bi bi-pencil-square"></i>

                            <%= form.text_area :message,
                                placeholder: "Write your question or tell us what you need help with...",
                                rows: 7,
                                required: true %>

                        </div>

                    </div>

                    <!-- IMAGE ATTACHMENT -->

<div class="contact-field">

    <%= form.label :image, "Attach Image (Optional)" %>

    <div class="input-wrapper">

        <i class="bi bi-image"></i>

        <%= form.file_field :image,
            accept: "image/png,image/jpeg,image/jpg,image/webp",
            class: "contact-file-input" %>

    </div>

    <small class="contact-file-help">
        JPG, JPEG, PNG or WEBP • Optional
    </small>

</div>


                    <div class="contact-submit">

                        <%= form.submit "Submit Enquiry",
                            class: "contact-submit-btn" %>

                    </div>


                <% end %>

            </div>


            <!-- CONTACT VISUAL -->

            <div class="contact-visual">

                <div class="contact-online">

                    <span></span>

                    <div>

                        <strong>
                            We're Available
                        </strong>

                    </div>

                </div>


                <div class="contact-image-card">

                    <%= image_tag "logo.jpeg",
                        class: "contact-image",
                        alt: "Connect with A One GS Center" %>

                </div>


                <div class="contact-highlights">

                    <div class="contact-highlight">

                        <i class="bi bi-mortarboard"></i>

                        <span>

                            <strong>
                                Course Guidance
                            </strong>

                            Choose the right learning path

                        </span>

                    </div>


                    <div class="contact-highlight">

                        <i class="bi bi-info-circle"></i>

                        <span>

                            <strong>
                                Quick Assistance
                            </strong>

                            Get answers to your questions

                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
<script nonce="<%= content_security_policy_nonce %>">
(function () {

  "use strict";

  function initializeHomepage() {

    document.documentElement.style.overflowX = "hidden";
    document.body.style.overflowX = "hidden";

    document
      .querySelectorAll('a[href^="#"]')
      .forEach(function (link) {

        if (
          link.dataset.smoothScrollReady === "true"
        ) {
          return;
        }

        link.dataset.smoothScrollReady = "true";

        link.addEventListener(
          "click",
          function (event) {

            const targetId =
              this.getAttribute("href");

            if (
              !targetId ||
              targetId === "#"
            ) {
              return;
            }

            let target;

            try {

              target =
                document.querySelector(targetId);

            } catch (error) {

              return;

            }

            if (!target) {
              return;
            }

            event.preventDefault();

            target.scrollIntoView({
              behavior: "smooth",
              block: "start"
            });

          }
        );

      });

    initializeNotificationTicker();

    initializeGallery();
    initializeGalleryFilters();
    initializeGalleryLightbox();

    initializeAchievementSlider();

    initializeAchievementVideos();

    initializeTestimonialCarousel();

    initializeTestimonialVideos();

    initializeContactForm();

    initializeImageProtection();

    initializeIntersectionAnimations();

  }

  function initializeNotificationTicker() {

    const ticker =
      document.getElementById(
        "notificationTicker"
      );

    if (!ticker) {
      return;
    }

    if (
      ticker.dataset.tickerInitialized ===
      "true"
    ) {
      return;
    }

    ticker.dataset.tickerInitialized = "true";

    const originalCards =
      Array.from(
        ticker.querySelectorAll(
          ":scope > .notification-card"
        )
      );

    if (
      originalCards.length === 0
    ) {
      return;
    }

    console.log(
      "SERVER NOTIFICATION CARDS:",
      originalCards.map(function (card) {
        return card.innerText;
      })
    );

    if (
      originalCards.length === 1
    ) {

      ticker.style.animation = "none";
      ticker.style.transform = "none";

    }

    if (
      originalCards.length > 1
    ) {

      originalCards.forEach(
        function (card) {

          const clone =
            card.cloneNode(true);

          clone.setAttribute(
            "aria-hidden",
            "true"
          );

          ticker.appendChild(clone);

        }
      );

      ticker.style.animationDuration =
        "35s";

    }

    ticker.addEventListener(
      "touchstart",
      function () {

        ticker.style.animationPlayState =
          "paused";

      },
      {
        passive: true
      }
    );

    ticker.addEventListener(
      "touchend",
      function () {

        ticker.style.animationPlayState =
          "running";

      },
      {
        passive: true
      }
    );

  }

  function initializeGallery() {

    const gallerySlider =
      document.getElementById(
        "gallerySlider"
      );

    const galleryPrev =
      document.getElementById(
        "galleryPrev"
      );

    const galleryNext =
      document.getElementById(
        "galleryNext"
      );

    const galleryDots =
      document.getElementById(
        "galleryDots"
      );

    if (
      !gallerySlider ||
      !galleryPrev ||
      !galleryNext
    ) {
      return;
    }

    if (
      gallerySlider.dataset.galleryInitialized ===
      "true"
    ) {
      return;
    }

    gallerySlider.dataset.galleryInitialized =
      "true";

    const slides =
      Array.from(
        gallerySlider.querySelectorAll(
          ".gallery-slide"
        )
      );

    if (
      slides.length === 0
    ) {
      return;
    }

    let currentIndex = 0;
    let autoPlay = null;

    if (galleryDots) {

      galleryDots.innerHTML = "";

      slides.forEach(
        function (
          slide,
          index
        ) {

          const dot =
            document.createElement(
              "button"
            );

          dot.type = "button";

          dot.className =
            "gallery-dot";

          dot.setAttribute(
            "aria-label",
            "Go to gallery image " +
            (index + 1)
          );

          dot.addEventListener(
            "click",
            function () {

              showSlide(index);

              restartAutoPlay();

            }
          );

          galleryDots.appendChild(dot);

        }
      );

    }

    const dots =
      galleryDots
        ? galleryDots.querySelectorAll(
            ".gallery-dot"
          )
        : [];

    function showSlide(index) {

      if (
        index >= slides.length
      ) {

        index = 0;

      }

      if (
        index < 0
      ) {

        index =
          slides.length - 1;

      }

      currentIndex = index;

      slides.forEach(
        function (
          slide,
          slideIndex
        ) {

          slide.classList.toggle(
            "active",
            slideIndex === currentIndex
          );

        }
      );

      dots.forEach(
        function (
          dot,
          dotIndex
        ) {

          dot.classList.toggle(
            "active",
            dotIndex === currentIndex
          );

        }
      );

    }

    function nextSlide() {

      showSlide(
        currentIndex + 1
      );

    }

    function previousSlide() {

      showSlide(
        currentIndex - 1
      );

    }

    galleryNext.addEventListener(
      "click",
      function () {

        nextSlide();

        restartAutoPlay();

      }
    );

    galleryPrev.addEventListener(
      "click",
      function () {

        previousSlide();

        restartAutoPlay();

      }
    );

    function startAutoPlay() {

      stopAutoPlay();

      autoPlay =
        window.setInterval(
          function () {

            nextSlide();

          },
          4000
        );

    }

    function stopAutoPlay() {

      if (
        autoPlay !== null
      ) {

        window.clearInterval(
          autoPlay
        );

        autoPlay = null;

      }

    }

    function restartAutoPlay() {

      stopAutoPlay();

      startAutoPlay();

    }

    gallerySlider.addEventListener(
      "mouseenter",
      stopAutoPlay
    );

    gallerySlider.addEventListener(
      "mouseleave",
      startAutoPlay
    );

    gallerySlider.addEventListener(
      "keydown",
      function (event) {

        if (
          event.key === "ArrowLeft"
        ) {

          previousSlide();

          restartAutoPlay();

        }

        if (
          event.key === "ArrowRight"
        ) {

          nextSlide();

          restartAutoPlay();

        }

      }
    );

    slides.forEach(
      function (slide) {

        const image =
          slide.querySelector(
            ".gallery-image"
          );

        if (
          image &&
          image.src
        ) {

          slide.style.setProperty(
            "--gallery-image",
            'url("' +
            image.src +
            '")'
          );

        }

      }
    );

    showSlide(0);

    startAutoPlay();

  }

  function initializeGalleryFilters() {

    const filters =
      document.querySelectorAll(
        "[data-gallery-filter]"
      );

    const cards =
      document.querySelectorAll(
        "[data-gallery-item]"
      );

    if (
      !filters.length ||
      !cards.length
    ) {
      return;
    }

    if (
      document.body.dataset.galleryFiltersReady ===
      "true"
    ) {
      return;
    }

    document.body.dataset.galleryFiltersReady =
      "true";

    filters.forEach(
      function (button) {

        button.addEventListener(
          "click",
          function () {

            const selectedCategory =
              button.getAttribute(
                "data-gallery-filter"
              );

            filters.forEach(
              function (item) {

                item.classList.remove(
                  "active"
                );

              }
            );

            button.classList.add(
              "active"
            );

            cards.forEach(
              function (card) {

                const cardCategories =
                  (
                    card.getAttribute(
                      "data-gallery-category"
                    ) || ""
                  )
                    .split(/\s+/)
                    .filter(Boolean);

                const shouldShow =
                  selectedCategory === "all" ||
                  cardCategories.includes(
                    selectedCategory
                  );

                if (shouldShow) {

                  card.style.display =
                    "";

                  requestAnimationFrame(
                    function () {

                      card.style.opacity =
                        "1";

                      card.style.transform =
                        "scale(1)";

                    }
                  );

                } else {

                  card.style.opacity =
                    "0";

                  card.style.transform =
                    "scale(.95)";

                  window.setTimeout(
                    function () {

                      const currentCategories =
                        (
                          card.getAttribute(
                            "data-gallery-category"
                          ) || ""
                        )
                          .split(/\s+/)
                          .filter(Boolean);

                      const stillHidden =
                        selectedCategory !== "all" &&
                        !currentCategories.includes(
                          selectedCategory
                        );

                      if (stillHidden) {

                        card.style.display =
                          "none";

                      }

                    },
                    220
                  );

                }

              }
            );

          }
        );

      }
    );

  }

  function initializeAchievementSlider() {

    const viewport =
      document.getElementById(
        "achievementsSlider"
      );

    const track =
      viewport
        ? viewport.querySelector(
            ".achievements-track"
          )
        : null;

    const prevButton =
      document.getElementById(
        "achievementPrev"
      );

    const nextButton =
      document.getElementById(
        "achievementNext"
      );

    if (
      !viewport ||
      !track ||
      !prevButton ||
      !nextButton
    ) {
      return;
    }

    if (
      viewport.dataset.achievementSliderReady ===
      "true"
    ) {
      return;
    }

    viewport.dataset.achievementSliderReady =
      "true";

    const cards =
      Array.from(
        track.querySelectorAll(
          ".topper-card"
        )
      );

    if (
      cards.length <= 1
    ) {
      return;
    }

    let currentIndex = 0;

    let visibleCards = 3;

    let autoPlayTimer = null;

    let resizeTimer = null;

    let isMoving = false;

    function getVisibleCards() {

      if (
        window.innerWidth <= 700
      ) {

        return 1;

      }

      if (
        window.innerWidth <= 1100
      ) {

        return 2;

      }

      return 3;

    }

    function setupSlider() {

      visibleCards =
        getVisibleCards();

      const viewportWidth =
        viewport.clientWidth;

      const styles =
        window.getComputedStyle(
          track
        );

      const gap =
        parseFloat(
          styles.columnGap
        ) ||
        parseFloat(
          styles.gap
        ) ||
        0;

      const cardWidth =
        (
          viewportWidth -
          gap *
          (visibleCards - 1)
        ) /
        visibleCards;

      cards.forEach(
        function (card) {

          card.style.width =
            cardWidth + "px";

          card.style.minWidth =
            cardWidth + "px";

          card.style.maxWidth =
            cardWidth + "px";

          card.style.flex =
            "0 0 " +
            cardWidth +
            "px";

          card.style.boxSizing =
            "border-box";

        }
      );

      currentIndex = 0;

      track.style.transition =
        "none";

      track.style.transform =
        "translate3d(0,0,0)";

      track.offsetHeight;

      track.style.transition =
        "transform 0.7s ease";

    }

    function getMaxIndex() {

      return Math.max(
        0,
        cards.length -
        visibleCards
      );

    }

    function moveSlider(
      index,
      animate
    ) {

      const maxIndex =
        getMaxIndex();

      if (
        index > maxIndex
      ) {

        index = 0;

      }

      if (
        index < 0
      ) {

        index = maxIndex;

      }

      currentIndex = index;

      const targetCard =
        cards[currentIndex];

      if (!targetCard) {
        return;
      }

      const distance =
        targetCard.offsetLeft;

      if (animate) {

        isMoving = true;

        track.style.transition =
          "transform 0.7s ease";

      } else {

        track.style.transition =
          "none";

      }

      track.style.transform =
        "translate3d(-" +
        distance +
        "px,0,0)";

      if (animate) {

        window.setTimeout(
          function () {

            isMoving = false;

          },
          750
        );

      }

    }

    function nextAchievement() {

      if (isMoving) {
        return;
      }

      moveSlider(
        currentIndex + 1,
        true
      );

    }

    function previousAchievement() {

      if (isMoving) {
        return;
      }

      moveSlider(
        currentIndex - 1,
        true
      );

    }

    nextButton.addEventListener(
      "click",
      function () {

        nextAchievement();

        restartAutoPlay();

      }
    );

    prevButton.addEventListener(
      "click",
      function () {

        previousAchievement();

        restartAutoPlay();

      }
    );

    function startAutoPlay() {

      stopAutoPlay();

      autoPlayTimer =
        window.setInterval(
          function () {

            nextAchievement();

          },
          5000
        );

    }

    function stopAutoPlay() {

      if (
        autoPlayTimer !== null
      ) {

        window.clearInterval(
          autoPlayTimer
        );

        autoPlayTimer = null;

      }

    }

    function restartAutoPlay() {

      stopAutoPlay();

      startAutoPlay();

    }

    viewport.addEventListener(
      "mouseenter",
      stopAutoPlay
    );

    viewport.addEventListener(
      "mouseleave",
      startAutoPlay
    );

    viewport.addEventListener(
      "touchstart",
      stopAutoPlay,
      {
        passive: true
      }
    );

    viewport.addEventListener(
      "touchend",
      startAutoPlay,
      {
        passive: true
      }
    );

    window.addEventListener(
      "resize",
      function () {

        window.clearTimeout(
          resizeTimer
        );

        resizeTimer =
          window.setTimeout(
            function () {

              setupSlider();

              moveSlider(
                0,
                false
              );

              startAutoPlay();

            },
            150
          );

      }
    );

    setupSlider();

    moveSlider(
      0,
      false
    );

    startAutoPlay();

  }

function initializeTestimonialCarousel() {

    const carousel =
        document.querySelector(".testimonial-carousel");

    const track =
        carousel
            ? carousel.querySelector(".testimonial-track")
            : null;

    if (!carousel || !track) {
        return;
    }

    if (
        carousel.dataset.testimonialContinuousReady === "true"
    ) {
        return;
    }

    carousel.dataset.testimonialContinuousReady = "true";

    let cards = Array.from(
        track.querySelectorAll(
            ".testimonial-card:not(.testimonial-card-clone)"
        )
    );

    if (cards.length < 2) {
        return;
    }

    track
        .querySelectorAll(".testimonial-card-clone")
        .forEach(function (clone) {

            clone.remove();

        });

    const cloneFragment =
        document.createDocumentFragment();

    cards.forEach(function (card) {

        const clone =
            card.cloneNode(true);

        clone.classList.add(
            "testimonial-card-clone"
        );

        clone.setAttribute(
            "aria-hidden",
            "true"
        );

        cloneFragment.appendChild(
            clone
        );

    });

    track.appendChild(
        cloneFragment
    );

    track.style.display = "flex";
    track.style.flexWrap = "nowrap";
    track.style.width = "max-content";
    track.style.willChange = "transform";

    carousel.style.overflowX = "hidden";
    carousel.style.overflowY = "visible";

    function setupCardSizes() {

        let cardWidth;

        if (window.innerWidth <= 600) {

            cardWidth =
                Math.min(
                    330,
                    carousel.clientWidth * 0.86
                );

        } else if (window.innerWidth <= 1000) {

            cardWidth = 320;

        } else {

            cardWidth = 440;

        }

        cards.forEach(function (card) {

            card.style.width =
                cardWidth + "px";

            card.style.minWidth =
                cardWidth + "px";

            card.style.maxWidth =
                cardWidth + "px";

            card.style.flex =
                "0 0 " +
                cardWidth +
                "px";

            card.style.boxSizing =
                "border-box";

        });

        track
            .querySelectorAll(
                ".testimonial-card-clone"
            )
            .forEach(function (clone) {

                clone.style.width =
                    cardWidth + "px";

                clone.style.minWidth =
                    cardWidth + "px";

                clone.style.maxWidth =
                    cardWidth + "px";

                clone.style.flex =
                    "0 0 " +
                    cardWidth +
                    "px";

                clone.style.boxSizing =
                    "border-box";

            });

    }

    function getGap() {

        const styles =
            window.getComputedStyle(
                track
            );

        return (
            parseFloat(styles.columnGap) ||
            parseFloat(styles.gap) ||
            28
        );

    }

    function getSetWidth() {

        const lastCard =
            cards[cards.length - 1];

        if (!lastCard) {
            return 0;
        }

        return (
            lastCard.offsetLeft +
            lastCard.offsetWidth +
            getGap()
        );

    }

    let position = 0;

    const speed = 0.45;

    let animationFrame = null;

    let lastTime =
        performance.now();

    let paused = false;

    function animate(currentTime) {

        const delta =
            currentTime -
            lastTime;

        lastTime =
            currentTime;

        if (!paused) {

            position -=
                speed *
                (delta / 16.67);

            const setWidth =
                getSetWidth();

            if (
                setWidth > 0 &&
                Math.abs(position) >= setWidth
            ) {

                position +=
                    setWidth;

            }

            track.style.transform =
                "translate3d(" +
                position +
                "px, 0, 0)";

        }

        animationFrame =
            requestAnimationFrame(
                animate
            );

    }

    carousel.addEventListener(
        "mouseenter",
        function () {

            paused = true;

        }
    );

    carousel.addEventListener(
        "mouseleave",
        function () {

            paused = false;

            lastTime =
                performance.now();

        }
    );

    carousel.addEventListener(
        "touchstart",
        function () {

            paused = true;

        },
        {
            passive: true
        }
    );

    carousel.addEventListener(
        "touchend",
        function () {

            paused = false;

            lastTime =
                performance.now();

        },
        {
            passive: true
        }
    );

    carousel.addEventListener(
        "touchcancel",
        function () {

            paused = false;

            lastTime =
                performance.now();

        },
        {
            passive: true
        }
    );

    document.addEventListener(
        "visibilitychange",
        function () {

            if (document.hidden) {

                paused = true;

            } else {

                paused = false;

                lastTime =
                    performance.now();

            }

        }
    );

    const reducedMotion =
        window.matchMedia(
            "(prefers-reduced-motion: reduce)"
        );

    if (reducedMotion.matches) {

        paused = true;

    }

    let resizeTimer = null;

    window.addEventListener(
        "resize",
        function () {

            window.clearTimeout(
                resizeTimer
            );

            resizeTimer =
                window.setTimeout(
                    function () {

                        setupCardSizes();

                        track.style.transform =
                            "translate3d(" +
                            position +
                            "px, 0, 0)";

                    },
                    150
                );

        }
    );

    setupCardSizes();

    position = 0;

    track.style.transform =
        "translate3d(0, 0, 0)";

    lastTime =
        performance.now();

    animationFrame =
        requestAnimationFrame(
            animate
        );

    window.addEventListener(
        "beforeunload",
        function () {

            if (animationFrame) {

                cancelAnimationFrame(
                    animationFrame
                );

            }

        }
    );

}

  function initializeTestimonialVideos() {

    const modal =
      document.querySelector(
        "[data-testimonial-video-modal]"
      );

    const player =
      document.querySelector(
        "[data-testimonial-video-player]"
      );

    const buttons =
      document.querySelectorAll(
        "[data-testimonial-video-button]"
      );

    const closeButtons =
      document.querySelectorAll(
        "[data-testimonial-video-close]"
      );

    if (
      !modal ||
      !player ||
      !buttons.length
    ) {
      return;
    }

    if (
      modal.dataset.testimonialVideoReady ===
      "true"
    ) {
      return;
    }

    modal.dataset.testimonialVideoReady =
      "true";

    buttons.forEach(
      function (button) {

        if (
          button.dataset.videoInitialized ===
          "true"
        ) {
          return;
        }

        button.dataset.videoInitialized =
          "true";

        button.addEventListener(
          "click",
          function () {

            const videoUrl =
              button.dataset.videoUrl;

            if (!videoUrl) {
              return;
            }

            player.src =
              videoUrl;

            modal.classList.add(
              "is-open"
            );

            modal.setAttribute(
              "aria-hidden",
              "false"
            );

            document.body.style.overflow =
              "hidden";

            const playPromise =
              player.play();

            if (
              playPromise &&
              typeof playPromise.catch ===
              "function"
            ) {

              playPromise.catch(
                function () {

                }
              );

            }

          }
        );

      }
    );

    function closeVideo() {

      player.pause();

      player.removeAttribute(
        "src"
      );

      player.load();

      modal.classList.remove(
        "is-open"
      );

      modal.setAttribute(
        "aria-hidden",
        "true"
      );

      document.body.style.overflow =
        "";

    }

    closeButtons.forEach(
      function (button) {

        button.addEventListener(
          "click",
          closeVideo
        );

      }
    );

    modal.addEventListener(
      "click",
      function (event) {

        if (
          event.target === modal
        ) {

          closeVideo();

        }

      }
    );

    document.addEventListener(
      "keydown",
      function (event) {

        if (
          event.key === "Escape" &&
          modal.classList.contains(
            "is-open"
          )
        ) {

          closeVideo();

        }

      }
    );

  }

  function initializeAchievementVideos() {

    const modal =
      document.getElementById(
        "achievementVideoModal"
      );

    const player =
      document.getElementById(
        "achievementVideoPlayer"
      );

    const title =
      document.getElementById(
        "achievementVideoTitle"
      );

    const closeButton =
      document.getElementById(
        "closeAchievementVideo"
      );

    if (
      !modal ||
      !player ||
      !closeButton
    ) {
      return;
    }

    if (
      modal.dataset.videoModalReady ===
      "true"
    ) {
      return;
    }

    modal.dataset.videoModalReady =
      "true";

    document
      .querySelectorAll(
        ".achievement-video-btn"
      )
      .forEach(
        function (button) {

          if (
            button.dataset.videoInitialized ===
            "true"
          ) {
            return;
          }

          button.dataset.videoInitialized =
            "true";

          button.addEventListener(
            "click",
            function () {

              const videoURL =
                button.dataset.videoUrl;

              const videoTitle =
                button.dataset.videoTitle ||
                "Success Story";

              if (!videoURL) {
                return;
              }

              if (title) {

                title.textContent =
                  videoTitle;

              }

              player.src =
                videoURL;

              modal.classList.add(
                "show"
              );

              modal.setAttribute(
                "aria-hidden",
                "false"
              );

              document.body.style.overflow =
                "hidden";

              const playPromise =
                player.play();

              if (
                playPromise !== undefined
              ) {

                playPromise.catch(
                  function () {}
                );

              }

            }
          );

        }
      );

    function closeVideo() {

      player.pause();

      player.removeAttribute(
        "src"
      );

      player.load();

      modal.classList.remove(
        "show"
      );

      modal.setAttribute(
        "aria-hidden",
        "true"
      );

      document.body.style.overflow =
        "";

    }

    closeButton.addEventListener(
      "click",
      closeVideo
    );

    modal.addEventListener(
      "click",
      function (event) {

        if (
          event.target === modal
        ) {

          closeVideo();

        }

      }
    );

    document.addEventListener(
      "keydown",
      function (event) {

        if (
          event.key === "Escape" &&
          modal.classList.contains(
            "show"
          )
        ) {

          closeVideo();

        }

      }
    );

  }

  function initializeContactForm() {

    const contactForm =
      document.querySelector(
        ".contact-form"
      );

    const submitButton =
      document.querySelector(
        ".contact-submit-btn"
      );

    if (
      !contactForm ||
      !submitButton
    ) {
      return;
    }

    if (
      contactForm.dataset.contactReady ===
      "true"
    ) {
      return;
    }

    contactForm.dataset.contactReady =
      "true";

    contactForm.addEventListener(
      "submit",
      function () {

        submitButton.innerHTML =
          '<i class="bi bi-send-fill"></i>&nbsp; Sending...';

        submitButton.style.opacity =
          "0.85";

      }
    );

  }

  function initializeImageProtection() {

    document
      .querySelectorAll("img")
      .forEach(
        function (image) {

          if (
            image.dataset.imageProtectionReady ===
            "true"
          ) {
            return;
          }

          image.dataset.imageProtectionReady =
            "true";

          image.addEventListener(
            "error",
            function () {

              this.style.opacity =
                "0.65";

            }
          );

        }
      );

  }

  function initializeIntersectionAnimations() {

    if (
      !("IntersectionObserver" in window)
    ) {
      return;
    }

    const animatedElements =
      document.querySelectorAll(
        ".feature-card, " +
        ".topper-card, " +
        ".event-card, " +
        ".course-card, " +
        ".teacher-card, " +
        ".highlight-box, " +
        ".notification-card"
      );

    if (
      animatedElements.length === 0
    ) {
      return;
    }

    const observer =
      new IntersectionObserver(
        function (entries) {

          entries.forEach(
            function (entry) {

              if (
                entry.isIntersecting
              ) {

                entry.target.classList.add(
                  "is-visible"
                );

                observer.unobserve(
                  entry.target
                );

              }

            }
          );

        },
        {
          threshold: 0.08
        }
      );

    animatedElements.forEach(
      function (element) {

        if (
          element.dataset.animationReady ===
          "true"
        ) {
          return;
        }

        element.dataset.animationReady =
          "true";

        element.classList.add(
          "scroll-hidden"
        );

        observer.observe(
          element
        );

      }
    );

  }

  document.addEventListener(
    "DOMContentLoaded",
    initializeHomepage
  );

  document.addEventListener(
    "turbo:load",
    initializeHomepage
  );

})();

(function () {

  "use strict";

  if (
    document.getElementById(
      "homepageScrollAnimationStyle"
    )
  ) {
    return;
  }

  const style =
    document.createElement(
      "style"
    );

  style.id =
    "homepageScrollAnimationStyle";

  style.textContent = `

    .scroll-hidden {
      opacity: 0;
      transform: translateY(15px);
      transition:
        opacity 0.6s ease,
        transform 0.6s ease;
    }

    .scroll-hidden.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .course-card.scroll-hidden.is-visible:hover {
      transform: translateY(-5px);
    }

  `;

  document.head.appendChild(
    style
  );

})();

function initializeGalleryLightbox() {

  const lightbox =
    document.getElementById(
      "galleryLightbox"
    );

  if (!lightbox) {
    return;
  }

  if (
    lightbox.dataset.lightboxReady ===
    "true"
  ) {
    return;
  }

  lightbox.dataset.lightboxReady =
    "true";

  const image =
    lightbox.querySelector(
      ".gallery-lightbox-image"
    );

  const closeButton =
    lightbox.querySelector(
      "[data-gallery-lightbox-close]"
    );

  const galleryImages =
    document.querySelectorAll(
      "[data-gallery-lightbox]"
    );

  if (
    !image ||
    !closeButton ||
    !galleryImages.length
  ) {
    return;
  }

  galleryImages.forEach(
    function (trigger) {

      trigger.addEventListener(
        "click",
        function (event) {

          event.preventDefault();

          const imageUrl =
            trigger.getAttribute(
              "data-gallery-lightbox"
            );

          if (!imageUrl) {
            return;
          }

          image.src =
            imageUrl;

          lightbox.classList.add(
            "is-open"
          );

          lightbox.setAttribute(
            "aria-hidden",
            "false"
          );

          document.body.style.overflow =
            "hidden";

        }
      );

    }
  );

  function closeLightbox() {

    lightbox.classList.remove(
      "is-open"
    );

    lightbox.setAttribute(
      "aria-hidden",
      "true"
    );

    image.removeAttribute(
      "src"
    );

    document.body.style.overflow =
      "";

  }

  closeButton.addEventListener(
    "click",
    closeLightbox
  );

  lightbox.addEventListener(
    "click",
    function (event) {

      if (
        event.target === lightbox
      ) {

        closeLightbox();

      }

    }
  );

  document.addEventListener(
    "keydown",
    function (event) {

      if (
        event.key === "Escape" &&
        lightbox.classList.contains(
          "is-open"
        )
      ) {

        closeLightbox();

      }

    }
  );

}

document.addEventListener("DOMContentLoaded", function () {

  const modal =
    document.getElementById("achievementVideoModal");

  const player =
    document.getElementById("achievementVideoPlayer");

  const title =
    document.getElementById("achievementVideoTitle");

  const closeButton =
    document.getElementById("closeAchievementVideo");

  document
    .querySelectorAll(".achievement-video-btn")
    .forEach(function (button) {

      button.addEventListener("click", function () {

        const videoUrl =
          button.dataset.videoUrl;

        const videoTitle =
          button.dataset.videoTitle ||
          "Achievement Success Story";

        if (!videoUrl || !modal || !player) {
          return;
        }

        if (title) {
          title.textContent = videoTitle;
        }

        player.src = videoUrl;

        player.load();

        modal.classList.add("active");

        modal.setAttribute(
          "aria-hidden",
          "false"
        );

        document.body.style.overflow = "hidden";

        player.play().catch(function () {});

      });

    });

  function closeAchievementVideo() {

    if (!modal || !player) {
      return;
    }

    player.pause();

    player.removeAttribute("src");

    player.load();

    modal.classList.remove("active");

    modal.setAttribute(
      "aria-hidden",
      "true"
    );

    document.body.style.overflow = "";

  }

  if (closeButton) {

    closeButton.addEventListener(
      "click",
      closeAchievementVideo
    );

  }

  if (modal) {

    modal.addEventListener(
      "click",
      function (event) {

        if (
          event.target === modal
        ) {

          closeAchievementVideo();

        }

      }
    );

  }

  document.addEventListener(
    "keydown",
    function (event) {

      if (
        event.key === "Escape" &&
        modal &&
        modal.classList.contains("active")
      ) {

        closeAchievementVideo();

      }

    }
  );

});
</script>