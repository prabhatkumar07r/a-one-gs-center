<!-- =========================================================
     COURSES
========================================================= -->
<section class="courses" id="courses">

  <div class="container">

    <h2 class="section-title">
      Our Courses
    </h2>

    <div class="course-grid">

      <% if @courses.present? %>

        <% @courses.each do |course| %>

          <div class="course-card">

            <!-- =================================================
                 COURSE IMAGE
            ================================================== -->

            <% if course.image.attached? %>

              <%= image_tag course.image,
                  class: "course-image",
                  alt: course.Course_name,
                  loading: "lazy" %>

            <% else %>

              <div class="course-placeholder">
                <h3>
                  <%= course.Course_name %>
                </h3>
              </div>

            <% end %>


            <!-- =================================================
                 COURSE INFORMATION
            ================================================== -->

            <div class="course-info">

              <!-- TITLE -->

              <h3 class="course-title">
                <%= course.Course_name %>
              </h3>


              <!-- RATING -->

              <div class="course-rating">

                ⭐ 4.8

                <span>
                  (250 Students)
                </span>

              </div>


              <!-- =================================================
                   COURSE META
              ================================================== -->

              <div class="course-meta">

                <span>
                  <i class="bi bi-clock"></i>

                  <%= course.duration.presence || "1 Year" %>
                </span>

                <span>
                  <i class="bi bi-people"></i>

                  Limited Seats
                </span>

              </div>


              <!-- =================================================
                   PRICE
              ================================================== -->

              <div class="course-price-container">

                <% if course.original_fee.present? &&
                      course.fee.present? &&
                      course.original_fee > course.fee %>

                  <span class="original-price">
                    ₹<%= number_with_delimiter(course.original_fee) %>
                  </span>

                  <span class="discounted-price">
                    ₹<%= number_with_delimiter(course.fee) %>
                  </span>

                  <% if course.discount_percentage.present? %>

                    <span class="discount-badge">
                      <%= number_with_precision(
                            course.discount_percentage,
                            precision: 0
                          ) %>% OFF
                    </span>

                  <% end %>

                <% elsif course.fee.present? %>

                  <span class="discounted-price">
                    ₹<%= number_with_delimiter(course.fee) %>
                  </span>

                <% else %>

                  <span class="discounted-price">
                    Free
                  </span>

                <% end %>

              </div>


              <!-- =================================================
                   COURSE BUTTONS
              ================================================== -->

              <div class="course-buttons">

                <!-- VIEW COURSE -->

                <%= link_to course_details_path(course),
                    class: "btn btn-primary" do %>

                  <i class="bi bi-book"></i>
                  View Course

                <% end %>


                <!-- ENROLL NOW -->

                <%= link_to new_student_enrollment_path(
                      course_id: course.id
                    ),
                    class: "btn btn-success" do %>

                  <i class="bi bi-pencil-square"></i>
                  Enroll Now

                <% end %>

              </div>

            </div>

          </div>

        <% end %>

      <% else %>

        <div class="course-empty">
          <i class="bi bi-book"></i>

          <h3>No Courses Available</h3>

          <p>
            New courses will be available soon.
          </p>
        </div>

      <% end %>

    </div>

  </div>

</section>

