</head>

<body>
  
    <!-- Header  -->

    <!-- Hero  -->
  <section class="hero" id="home">
  <div class="container">
    <div class="hero-content">
<%= image_tag "chatlogo.png", class: "hero-logo", alt: "A One GS Center" %>

