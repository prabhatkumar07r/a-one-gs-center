<style>

/* =========================================================
   GLOBAL HOMEPAGE SAFETY
========================================================= */

html,
body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

img {
    max-width: 100%;
    height: auto;
}


/* =========================================================
   HERO SECTION
========================================================= */

.hero {
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    background: linear-gradient(
        135deg,
        #07111f 0%,
        #0b2345 50%,
        #07111f 100%
    );

    overflow: hidden;

    padding: 60px 24px;
}

.hero .container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
}

.hero-content {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
}


/* =========================================================
   HERO LOGO
========================================================= */

.hero-logo {
    display: block;

    width: min(90vw, 1100px);
    max-width: 100%;

    height: auto;

    margin: 0 auto;

    object-fit: contain;

    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;

    filter: drop-shadow(
        0 18px 35px rgba(0, 0, 0, 0.45)
    );

    animation: floatLogo 5s ease-in-out infinite;

    transition: transform 0.4s ease;
}

.hero-logo:hover {
    transform: scale(1.03);
}

@keyframes floatLogo {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }
}


/* =========================================================
   HERO SUBTITLE
========================================================= */

.hero-subtitle {
    width: 100%;
    max-width: 850px;

    margin: 25px auto 0;

    color: #ffffff;

    font-family: "Poppins", sans-serif;

    font-size: clamp(18px, 2.2vw, 28px);

    font-weight: 500;

    line-height: 1.5;

    letter-spacing: 1.5px;
}


/* =========================================================
   HERO FEATURES
========================================================= */

.hero-features {
    width: 100%;
    max-width: 950px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 12px;

    margin: 30px auto;
}

.hero-features span {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    max-width: 100%;

    padding: 10px 18px;

    color: #ffffff;

    background: rgba(255, 255, 255, 0.08);

    border: 1px solid rgba(255, 255, 255, 0.15);

    border-radius: 50px;

    font-family: "Poppins", sans-serif;

    font-size: 15px;
    font-weight: 500;

    line-height: 1.4;

    backdrop-filter: blur(8px);

    transition:
        background 0.3s ease,
        transform 0.3s ease;
}

.hero-features span:hover {
    background: rgba(255, 255, 255, 0.15);

    transform: translateY(-3px);
}


/* =========================================================
   HERO BUTTONS
========================================================= */

.hero-buttons {
    width: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 15px;

    margin-top: 35px;
}

.hero-buttons .btn {
    min-width: 160px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 14px 30px;

    color: #ffffff;

    background: #ff8c00;

    border-radius: 8px;

    text-decoration: none;

    font-family: "Poppins", sans-serif;

    font-size: 15px;
    font-weight: 600;

    line-height: 1.3;

    transition:
        background 0.3s ease,
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.hero-buttons .btn:hover {
    background: #ff6b00;

    transform: translateY(-3px);

    box-shadow:
        0 10px 25px rgba(255, 140, 0, 0.3);
}

.hero-buttons .btn-outline {
    background: transparent;

    border: 2px solid #ffffff;
}

.hero-buttons .btn-outline:hover {
    background: #ffffff;

    color: #111111;
}


/* =========================================================
   HERO SOCIAL
========================================================= */

.hero-social {
    display: flex;
    align-items: center;
    justify-content: center;

    flex-wrap: wrap;

    gap: 18px;

    margin: 32px 0;
}

.hero-social a {
    width: 56px;
    height: 56px;

    flex: 0 0 56px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    text-decoration: none;

    font-size: 25px;

    transition:
        transform 0.35s ease,
        background 0.35s ease,
        box-shadow 0.35s ease;
}

.hero-social a:hover {
    transform: translateY(-6px) scale(1.08);
}

.hero-social .linkedin {
    color: #0a66c2;

    border: 2px solid #0a66c2;

    background: rgba(10, 102, 194, 0.08);
}

.hero-social .linkedin:hover {
    color: #ffffff;
    background: #0a66c2;
}

.hero-social .youtube {
    color: #ff0000;

    border: 2px solid #ff0000;

    background: rgba(255, 0, 0, 0.08);
}

.hero-social .youtube:hover {
    color: #ffffff;
    background: #ff0000;
}

.hero-social .instagram {
    color: #e1306c;

    border: 2px solid #e1306c;

    background: rgba(225, 48, 108, 0.08);
}

.hero-social .instagram:hover {
    color: #ffffff;
    background: #e1306c;
}


/* =========================================================
   COMMON SECTION
========================================================= */

section {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

.container {
    width: 100%;
    max-width: 1200px;

    margin-left: auto;
    margin-right: auto;

    padding-left: 20px;
    padding-right: 20px;
}

.section-title {
    width: 100%;

    text-align: center;

    margin-bottom: 45px;
}


/* =========================================================
   CONTACT SECTION
========================================================= */
/* =========================================================
   CONTACT SECTION
========================================================= */

.contact {
    width: 100%;
    padding: 100px 20px;
    background: #ffffff;
    overflow: hidden;
}

.contact *,
.contact *::before,
.contact *::after {
    box-sizing: border-box;
}


/* =========================================================
   CONTAINER
========================================================= */

.contact .container {
    width: 100%;
    max-width: 1250px;
    margin: 0 auto;
}


/* =========================================================
   CONTACT GRID
========================================================= */

.contact-grid {
    width: 100%;

    display: grid;

    grid-template-columns:
        minmax(0, 0.9fr)
        minmax(0, 1.1fr);

    gap: 70px;

    align-items: start;
}


/* =========================================================
   CONTACT INFORMATION
========================================================= */

.contact-info {
    width: 100%;
    min-width: 0;

    padding: 10px 0;
}

.contact-info > h3 {
    margin: 0 0 35px;

    color: #172033;

    font-family: "Poppins", sans-serif;

    font-size: clamp(28px, 3vw, 40px);

    font-weight: 700;

    line-height: 1.2;
}


/* =========================================================
   CONTACT DETAILS
========================================================= */

.contact-details {
    width: 100%;

    display: flex;

    flex-direction: column;

    gap: 28px;
}


/* =========================================================
   CONTACT ITEM
========================================================= */

.contact-item {
    width: 100%;

    display: flex;

    align-items: flex-start;

    gap: 18px;

    min-width: 0;
}


/* =========================================================
   CONTACT ICON
========================================================= */

.contact-icon {
    width: 50px;
    height: 50px;

    flex: 0 0 50px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #172033;

    color: #ffffff;

    font-size: 19px;
}


/* =========================================================
   CONTACT CONTENT
========================================================= */

.contact-item-content {
    flex: 1;

    min-width: 0;
}

.contact-item-content h4 {
    margin: 0 0 6px;

    color: #172033;

    font-family: "Poppins", sans-serif;

    font-size: 17px;

    font-weight: 700;
}

.contact-item-content p {
    margin: 0;

    color: #4b5563;

    font-family: "Poppins", sans-serif;

    font-size: 15px;

    line-height: 1.7;

    overflow-wrap: anywhere;
}

.contact-item-content a {
    display: inline-block;

    max-width: 100%;

    color: #4b5563;

    font-family: "Poppins", sans-serif;

    font-size: 15px;

    line-height: 1.6;

    text-decoration: none;

    overflow-wrap: anywhere;

    transition: color 0.25s ease;
}

.contact-item-content a:hover {
    color: #6d28d9;
}


/* =========================================================
   SOCIAL
========================================================= */

.contact-social {
    margin-top: 42px;
}

.contact-social h4 {
    margin: 0 0 18px;

    color: #172033;

    font-family: "Poppins", sans-serif;

    font-size: 21px;

    font-weight: 700;
}


/* =========================================================
   SOCIAL ICONS
========================================================= */

.social-icons {
    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 14px;
}

.social-icons a {
    width: 48px;
    height: 48px;

    flex: 0 0 48px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #172033;

    color: #ffffff;

    font-size: 18px;

    text-decoration: none;

    transition:
        transform 0.25s ease,
        background 0.25s ease,
        box-shadow 0.25s ease;
}

.social-icons a:hover {
    background: #6d28d9;

    transform: translateY(-4px);

    box-shadow: 0 8px 20px rgba(109, 40, 217, 0.25);
}


/* =========================================================
   CONTACT FORM CARD
========================================================= */

.contact-form {
    width: 100%;

    min-width: 0;

    padding: 42px;

    background: #f8f8f8;

    border-radius: 28px;

    box-shadow:
        0 12px 40px rgba(0, 0, 0, 0.07);

    overflow: hidden;
}


/* =========================================================
   FORM TITLE
========================================================= */

.contact-form h3 {
    margin: 0 0 28px;

    color: #172033;

    font-family: "Poppins", sans-serif;

    font-size: clamp(25px, 2.5vw, 34px);

    font-weight: 700;

    line-height: 1.3;
}


/* =========================================================
   FORM GROUP
========================================================= */

.contact-form .form-group {
    width: 100%;

    margin-bottom: 18px;
}


/* =========================================================
   INPUT / TEXTAREA
========================================================= */

.contact-form .form-control {
    width: 100%;

    min-width: 0;

    display: block;

    padding: 17px 20px;

    border: 1px solid transparent;

    border-radius: 14px;

    background: #eeeeee;

    color: #172033;

    font-family: "Poppins", sans-serif;

    font-size: 15px;

    line-height: 1.5;

    outline: none;

    box-shadow: none;

    transition:
        background 0.25s ease,
        border-color 0.25s ease,
        box-shadow 0.25s ease;
}

.contact-form .form-control::placeholder {
    color: #64748b;

    opacity: 1;
}

.contact-form .form-control:focus {
    background: #ffffff;

    border-color: #6d28d9;

    box-shadow:
        0 0 0 3px rgba(109, 40, 217, 0.10);
}


/* =========================================================
   TEXTAREA
========================================================= */

.contact-form textarea.form-control {
    min-height: 150px;

    resize: vertical;
}


/* =========================================================
   SUBMIT BUTTON
========================================================= */

.contact-submit {
    width: 100%;

    min-height: 52px;

    margin-top: 5px;

    border: none;

    border-radius: 12px;

    background: #6d28d9;

    color: #ffffff;

    font-family: "Poppins", sans-serif;

    font-size: 16px;

    font-weight: 600;

    cursor: pointer;

    transition:
        background 0.25s ease,
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.contact-submit:hover {
    background: #5b21b6;

    transform: translateY(-2px);

    box-shadow:
        0 10px 25px rgba(109, 40, 217, 0.25);
}


/* =========================================================
   FORM MESSAGE
========================================================= */

.form-message {
    width: 100%;

    margin-top: 15px;

    font-family: "Poppins", sans-serif;

    font-size: 14px;

    line-height: 1.5;

    overflow-wrap: anywhere;
}


/* =========================================================
   LARGE DESKTOP
   1400px+
========================================================= */

@media (min-width: 1400px) {

    .contact {
        padding: 120px 30px;
    }

    .contact .container {
        max-width: 1350px;
    }

    .contact-grid {
        gap: 90px;

        grid-template-columns:
            minmax(0, 0.85fr)
            minmax(0, 1.15fr);
    }

    .contact-form {
        padding: 48px;
    }
}


/* =========================================================
   LAPTOP
   993px - 1199px
========================================================= */

@media (max-width: 1199px) {

    .contact {
        padding: 85px 25px;
    }

    .contact-grid {
        gap: 45px;
    }

    .contact-form {
        padding: 35px;
    }
}


/* =========================================================
   TABLET
   769px - 992px
========================================================= */

@media (max-width: 992px) {

    .contact {
        padding: 75px 22px;
    }

    /*
       Stack the contact area.
       This prevents the form from becoming too narrow.
    */

    .contact-grid {
        grid-template-columns: 1fr;

        gap: 45px;
    }

    .contact-info {
        max-width: 800px;

        margin: 0 auto;
    }

    .contact-info > h3 {
        text-align: center;
    }

    /*
       Put contact information into two columns.
    */

    .contact-details {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 25px;
    }

    .contact-social {
        text-align: center;
    }

    .social-icons {
        justify-content: center;
    }

    .contact-form {
        width: 100%;

        max-width: 800px;

        margin: 0 auto;

        padding: 35px;
    }
}


/* =========================================================
   MOBILE
   577px - 768px
========================================================= */

@media (max-width: 768px) {

    .contact {
        padding: 65px 18px;
    }

    .contact-grid {
        gap: 35px;
    }

    .contact-details {
        grid-template-columns: 1fr;

        gap: 22px;
    }

    .contact-info > h3 {
        margin-bottom: 28px;

        font-size: 30px;
    }

    .contact-item {
        gap: 14px;
    }

    .contact-icon {
        width: 46px;
        height: 46px;

        flex-basis: 46px;

        font-size: 17px;
    }

    .contact-item-content h4 {
        font-size: 16px;
    }

    .contact-item-content p,
    .contact-item-content a {
        font-size: 14px;
    }

    .contact-social {
        margin-top: 32px;
    }

    .contact-form {
        padding: 28px 22px;

        border-radius: 22px;
    }

    .contact-form h3 {
        margin-bottom: 22px;

        font-size: 26px;
    }

    .contact-form .form-control {
        padding: 15px 16px;

        font-size: 14px;

        border-radius: 12px;
    }

    .contact-form textarea.form-control {
        min-height: 135px;
    }
}


/* =========================================================
   SMALL MOBILE
   576px AND BELOW
========================================================= */

@media (max-width: 576px) {

    .contact {
        padding: 55px 14px;
    }

    .contact-grid {
        gap: 30px;
    }

    .contact-info > h3 {
        font-size: 28px;

        text-align: left;
    }

    .contact-details {
        gap: 20px;
    }

    .contact-item {
        align-items: flex-start;
    }

    .contact-icon {
        width: 42px;
        height: 42px;

        flex-basis: 42px;

        font-size: 16px;
    }

    .contact-item-content {
        min-width: 0;
    }

    .contact-item-content h4 {
        font-size: 15px;
    }

    .contact-item-content p,
    .contact-item-content a {
        font-size: 13px;

        line-height: 1.6;
    }

    .contact-social {
        margin-top: 28px;

        text-align: left;
    }

    .contact-social h4 {
        font-size: 19px;
    }

    .social-icons {
        justify-content: flex-start;

        gap: 10px;
    }

    .social-icons a {
        width: 43px;
        height: 43px;

        flex-basis: 43px;

        font-size: 16px;
    }

    .contact-form {
        padding: 24px 16px;

        border-radius: 18px;
    }

    .contact-form h3 {
        font-size: 23px;

        margin-bottom: 20px;
    }

    .contact-form .form-group {
        margin-bottom: 14px;
    }

    .contact-form .form-control {
        padding: 14px 15px;

        font-size: 14px;

        border-radius: 10px;
    }

    .contact-form textarea.form-control {
        min-height: 125px;
    }

    .contact-submit {
        min-height: 48px;

        font-size: 14px;
    }
}


/* =========================================================
   VERY SMALL PHONES
   400px AND BELOW
========================================================= */

@media (max-width: 400px) {

    .contact {
        padding: 45px 10px;
    }

    .contact-info > h3 {
        font-size: 25px;
    }

    .contact-item {
        gap: 11px;
    }

    .contact-icon {
        width: 38px;
        height: 38px;

        flex-basis: 38px;

        font-size: 14px;
    }

    .contact-item-content h4 {
        font-size: 14px;
    }

    .contact-item-content p,
    .contact-item-content a {
        font-size: 12.5px;
    }

    .contact-form {
        padding: 20px 13px;

        border-radius: 15px;
    }

    .contact-form h3 {
        font-size: 21px;
    }

    .contact-form .form-control {
        padding: 13px 13px;

        font-size: 13px;
    }

    .social-icons {
        gap: 8px;
    }

    .social-icons a {
        width: 40px;
        height: 40px;

        flex-basis: 40px;
    }
}




/* =========================================================
   REDUCE MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    .social-icons a,
    .contact-form .btn {
        transition: none;
    }

    .social-icons a:hover,
    .contact-form .btn:hover {
        transform: none;
    }
}

</style>


<!-- =========================================================
     HERO
========================================================= -->

<section class="hero" id="home">

    <div class="container">

        <div class="hero-content">

            <%= image_tag "chatlogo.png",
                class: "hero-logo",
                alt: "A One GS Center" %>

            <p class="hero-subtitle">
                Empowering Students to Learn, Prepare & Succeed
            </p>

            <div class="hero-features">

                <span>🎓 Expert Faculty</span>

                <span>📚 Weekly Test Series</span>

                <span>💻 Online & Offline Classes</span>

            </div>

            <div class="hero-social">

                <a href="https://youtube.com/@aonegs77"
                   target="_blank"
                   rel="noopener"
                   class="youtube">

                    <i class="fab fa-youtube"></i>

                </a>

                <a href="https://www.instagram.com/atsirshorts/"
                   target="_blank"
                   rel="noopener"
                   class="instagram">

                    <i class="fab fa-instagram"></i>

                </a>

            </div>

            <div class="hero-buttons">

                <%= link_to "Explore Courses",
                    "#courses",
                    class: "btn" %>

                <%= link_to "Contact Us",
                    "#contact",
                    class: "btn btn-outline" %>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FEATURES
========================================================= -->

<section class="features" id="features">

    <div class="container">

        <h2 class="section-title">
            Why Choose Us
        </h2>

        <div class="features-grid">

            <div class="feature-card">

                <i class="fas fa-chalkboard-teacher feature-icon"></i>

                <h3>
                    Expert Faculty
                </h3>

                <p>
                    Learn from highly qualified and experienced
                    teachers who have successfully guided students
                    in SSC, Bihar Police, Railway, Banking and NDA.
                </p>

            </div>


            <div class="feature-card">

                <i class="fas fa-book-open feature-icon"></i>

                <h3>
                    Study Materials
                </h3>

                <p>
                    Comprehensive study materials and practice
                    problems.
                </p>

            </div>


            <div class="feature-card">

                <i class="fas fa-clipboard-check feature-icon"></i>

                <h3>
                    Regular Tests
                </h3>

                <p>
                    Weekly tests and performance analysis to
                    track progress.
                </p>

            </div>


            <div class="feature-card">

                <i class="fas fa-laptop feature-icon"></i>

                <h3>
                    Online Portal
                </h3>

                <p>
                    Access lessons, assignments and tests through
                    our online portal.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     ABOUT / ACHIEVEMENTS
========================================================= -->

<section class="about-section" id="about">

    <div class="container">

        <h2 class="section-title">
            Our Achievements
        </h2>

        <div class="toppers-container">

            <% if @achievements.present? %>

                <% @achievements.each do |achievement| %>

                    <div class="topper-card">

                        <% if achievement.photo.attached? %>

                            <%= image_tag achievement.photo,
                                class: "topper-image",
                                alt: achievement.title %>

                        <% end %>

                        <div class="topper-info">

                            <h4>
                                <%= achievement.title %>
                            </h4>

                            <p>
                                <%= achievement.rank %>
                            </p>

                            <small>
                                <%= achievement.year %>
                            </small>

                            <p>
                                <%= achievement.description %>
                            </p>

                        </div>

                    </div>

                <% end %>

            <% else %>

                <p class="text-center">
                    No achievements available.
                </p>

            <% end %>

        </div>


        <div class="collage">

            <% @events.limit(6).each do |event| %>

                <div class="event-card">

                    <% if event.photo.attached? %>

                        <%= image_tag event.photo,
                            alt: event.title %>

                    <% else %>

                        <%= image_tag "default-event.jpg",
                            alt: "No Image" %>

                    <% end %>

                    <h5>
                        <%= event.title %>
                    </h5>

                </div>

            <% end %>

        </div>


        <div class="goal-quote">

            <strong>
                🎯 Our Goal
            </strong>

            <p>
                "Har student ko strong foundation ke sath
                unke sapne ke career tak pahunchana."
            </p>

            <p>
                "Agle saalon me aur zyada district aur state
                toppers dena."
            </p>

        </div>


        <div class="about-cta">

            <div class="highlight-box">

                <h3>
                    Quick Facts
                </h3>

                <ul>

                    <li>
                        Founded: 2017
                    </li>

                    <li>
                        Batch Size: Limited seats
                    </li>

                    <li>
                        Test Series: Weekly + Monthly
                    </li>

                    <li>
                        Subjects:
                        History • Geography • Political Science • Economics
                    </li>

