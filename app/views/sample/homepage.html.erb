.contact-section {
    position: relative;

    width: 100%;

    padding: 100px 20px 90px;

    background:
        radial-gradient(
            circle at 20% 20%,
            rgba(255, 255, 255, 0.10),
            transparent 35%
        ),
        radial-gradient(
            circle at 80% 45%,
            rgba(50, 0, 90, 0.15),
            transparent 38%
        );

    color: #ffffff;
}

.contact-section::before,
.contact-section::after {
    content: "";

    position: absolute;

    border-radius: 50%;

    filter: blur(100px);

    pointer-events: none;
}

.contact-section::before {
    width: 500px;
    height: 500px;

    top: -180px;
    right: -150px;

    background: rgba(255, 255, 255, 0.08);
}

.contact-section::after {
    width: 450px;
    height: 450px;

    bottom: -200px;
    left: -150px;

    background: rgba(40, 0, 80, 0.18);
}

.contact-section * {
    box-sizing: border-box;
}

.contact-container {
    position: relative;

    z-index: 2;

    width: 100%;

    max-width: 1380px;

    margin: 0 auto;
}

.contact-heading {
    width: 100%;

    max-width: 900px;

    margin: 0 0 55px;
}

.contact-eyebrow {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-bottom: 18px;

    padding: 7px 14px;

    border: 1px solid rgba(255, 255, 255, 0.25);

    border-radius: 50px;

    background: rgba(255, 255, 255, 0.10);

    color: #ffffff;

    font-size: 12px;

    font-weight: 600;

    backdrop-filter: blur(10px);
}

.contact-heading h2 {
