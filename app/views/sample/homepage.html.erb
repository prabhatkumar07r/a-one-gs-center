<!-- =========================================================
     NOTIFICATIONS
========================================================= -->

<section class="notifications" id="notifications">

    <div class="container">

        <h2 class="section-title">

            <i class="fas fa-bell"></i>

            Latest Notifications

        </h2>

        <div class="notif-showcase">

            <div class="ticker-glass-panel">

                <div class="notification-ticker-container">

                    <div class="notification-ticker">

                        <% if @notifications.present? %>

                            <% @notifications.each do |notification| %>

                                <div class="notification-card">

                                    <h5>

                                        <i class="fas fa-bullhorn text-danger"></i>

                                        <%= notification.title %>

                                    </h5>

                                    <p>
                                        <%= truncate(
                                            notification.description,
                                            length: 120
                                        ) %>
                                    </p>

                                    <p>
                                        <strong>📅 Start:</strong>

                                        <%= notification.start_date.strftime(
                                            "%d %b %Y"
                                        ) if notification.start_date.present? %>
                                    </p>

                                    <p>
                                        <strong>📅 End:</strong>

                                        <%= notification.end_date.strftime(
                                            "%d %b %Y"
                                        ) if notification.end_date.present? %>
                                    </p>

                                    <small class="text-muted">

                                        <i class="fas fa-calendar-alt"></i>

                                        Posted:

                                        <%= notification.created_at.strftime(
                                            "%d %b %Y"
                                        ) %>

                                    </small>

                                </div>

                            <% end %>

                        <% else %>

                            <div class="alert alert-info text-center">
                                No latest notifications available.
                            </div>

                        <% end %>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     GALLERY
========================================================= -->

<section class="gallery" id="gallery">

    <div class="container">

        <h2 class="section-title">
            Gallery
        </h2>

        <div class="gallery-container">

            <div class="gallery-slider">

                <% @galleries.each_with_index do |gallery, index| %>

                    <% if gallery.photos.attached? %>

                        <% gallery.photos.each do |photo| %>

                            <%= image_tag photo,
                                width: 200,
                                class: "img-thumbnail",
                                alt: "Gallery Image" %>

                        <% end %>

                    <% else %>

                        <p>
                            No photos uploaded.
                        </p>

                    <% end %>

                <% end %>

            </div>

            <button class="gallery-nav gallery-prev">
                <i class="fas fa-chevron-left"></i>
            </button>

            <button class="gallery-nav gallery-next">
                <i class="fas fa-chevron-right"></i>
            </button>

            <div class="gallery-dots"></div>

        </div>

    </div>

</section>


<!-- =========================================================
     COURSES
========================================================= -->

<section class="courses" id="courses">

    <div class="container">

        <h2 class="section-title">
            Our Courses
        </h2>

        <div class="course-grid">

            <% @courses.each do |course| %>

                <div class="course-card">

                    <% if course.respond_to?(:image) &&
                          course.image.attached? %>

                        <%= image_tag course.image,
                            class: "course-image",
                            alt: course.Course_name %>

                    <% else %>

                        <div class="course-placeholder">

                            <h3>
                                <%= course.Course_name %>
                            </h3>

                        </div>

                    <% end %>


                    <div class="course-info">

                        <h3 class="course-title">
                            <%= course.Course_name %>
                        </h3>


                        <div class="course-rating">

                            ⭐ 4.8

                            <span>
                                (250 Students)
                            </span>

                        </div>


                        <div class="course-meta">

                            <span>

                                <i class="fas fa-clock"></i>

                                <%= course.duration %>

                            </span>

                            <span>

                                <i class="fas fa-users"></i>

                                Limited Seats

                            </span>

                        </div>


                        <div class="course-price-container">

                            <% if course.original_fee.present? &&
                                  course.original_fee > course.fee %>

                                <span class="original-price">

                                    ₹<%= number_with_delimiter(
                                        course.original_fee
                                    ) %>

                                </span>

                                <span class="discounted-price">

                                    ₹<%= number_with_delimiter(
                                        course.fee
                                    ) %>

                                </span>

                                <span class="discount-badge">

                                    <%= course.discount_percentage %>%
                                    OFF

                                </span>

                            <% else %>

                                <span class="discounted-price">

                                    ₹<%= number_with_delimiter(
                                        course.fee
                                    ) %>

                                </span>

                            <% end %>

                        </div>


                        <div class="course-buttons">

                            <%= link_to "📖 View Course",
                                course_details_path(course),
                                class: "btn btn-primary w-100 mb-2" %>

                            <%= link_to "📝 Enroll Now",
                                new_enrollment_path(
                                    course_id: course.id
                                ),
                                class: "btn btn-success w-100" %>

                        </div>

                    </div>

                </div>

            <% end %>

        </div>

    </div>

</section>


