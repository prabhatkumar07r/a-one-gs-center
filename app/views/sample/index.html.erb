<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login/Signup - A ONE GS CENTER</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
       :root {
    --gradient-primary: linear-gradient(135deg, #6A11CB 0%, #2575FC 100%);
    --gradient-secondary: linear-gradient(135deg, #FF057C 0%, #8D0B93 100%);
    --gradient-light: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    --gradient-card: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);

    --text-dark: #2B2D42;
    --text-light: #FFFFFF;
    --text-gray: #6C757D;

    --box-shadow: 0 12px 35px rgba(0, 0, 0, 0.12);
    --transition: all 0.3s ease;
    --border-radius: 14px;
}

/* ================================
   RESET
================================ */

*,
*::before,
*::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    width: 100%;
    min-height: 100%;
    overflow-x: hidden;
}

body {
    width: 100%;
    min-height: 100vh;

    background: var(--gradient-light);

    font-family: "Poppins", sans-serif;
    line-height: 1.6;
    color: var(--text-dark);

    overflow-x: hidden;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 24px;
}

/* ================================
   AUTH CONTAINER
================================ */

.auth-container {
    width: min(100%, 1050px);

    min-height: 620px;

    background: var(--gradient-card);

    border-radius: 20px;

    box-shadow: var(--box-shadow);

    overflow: hidden;

    display: flex;

    position: relative;
}

/* ================================
   LEFT IMAGE SECTION
================================ */

.auth-image {
    flex: 1 1 48%;

    min-width: 0;

    background: var(--gradient-primary);

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 40px;

    position: relative;

    overflow: hidden;
}

.auth-image::before {
    content: "";

    position: absolute;

    top: -50%;
    left: -50%;

    width: 200%;
    height: 200%;

    background:
        radial-gradient(
            circle,
            rgba(255,255,255,.12) 0%,
            transparent 65%
        );

    animation: pulse 15s infinite linear;
}

@keyframes pulse {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}

.auth-image-content {
    position: relative;
    z-index: 2;

    width: 100%;
    max-width: 400px;

    text-align: center;

    color: white;
}

.auth-image-content img {
    width: min(180px, 45%);

    max-width: 180px;

    height: auto;

    object-fit: contain;

    margin-bottom: 24px;

    filter:
        drop-shadow(0 8px 20px rgba(0,0,0,.2));
}

.auth-image-content h2 {
    font-size: clamp(1.7rem, 2.5vw, 2.3rem);

    line-height: 1.25;

    margin-bottom: 15px;

    font-weight: 700;

    text-shadow:
        0 2px 5px rgba(0,0,0,.2);
}

.auth-image-content p {
    width: 100%;
    max-width: 340px;

    margin: auto;

    font-size: clamp(.9rem, 1.2vw, 1.05rem);

    line-height: 1.7;

    text-shadow:
        0 1px 3px rgba(0,0,0,.2);
}

/* ================================
   FORM SECTION
================================ */

.auth-forms {
    flex: 1 1 52%;

    min-width: 0;

    padding: 45px;

    position: relative;

    display: flex;

    flex-direction: column;

    justify-content: center;
}

/* ================================
   CLOSE BUTTON
================================ */

.close-auth {
    position: absolute;

    top: 18px;
    right: 18px;

    width: 40px;
    height: 40px;

    border-radius: 50%;

    background: #f8f9fa;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    transition: var(--transition);

    box-shadow:
        0 3px 12px rgba(0,0,0,.1);

    z-index: 10;
}

.close-auth:hover {
    background: #e9ecef;

    transform: rotate(90deg);
}

/* ================================
   TABS
================================ */

.auth-tabs {
    width: 100%;

    display: flex;

    margin-bottom: 30px;

    border-bottom: 2px solid #e9ecef;
}

.auth-tab {
    flex: 1;

    padding: 13px 15px;

    text-align: center;

    cursor: pointer;

    font-weight: 600;

    color: var(--text-gray);

    transition: var(--transition);

    position: relative;
}

.auth-tab.active {
    color: #6A11CB;
}

.auth-tab.active::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -2px;

    width: 100%;
    height: 3px;

    background: var(--gradient-primary);

    border-radius: 3px 3px 0 0;
}

/* ================================
   FORM TITLE
================================ */

.form-title {
    font-size: clamp(1.45rem, 2vw, 1.85rem);

    line-height: 1.3;

    margin-bottom: 25px;

    text-align: center;

    background: var(--gradient-secondary);

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;
}

/* ================================
   FORM GROUP
================================ */

.form-group {
    width: 100%;

    margin-bottom: 18px;

    position: relative;
}

.form-group label {
    display: block;

    margin-bottom: 7px;

    font-weight: 500;

    color: var(--text-dark);

    font-size: .92rem;
}

.form-control {
    width: 100%;

    min-height: 52px;

    padding: 13px 15px 13px 45px;

    border: 1px solid #e1e4e8;

    border-radius: var(--border-radius);

    font-size: 15px;

    background: #f7f8fa;

    color: var(--text-dark);

    transition: var(--transition);
}

.form-control:focus {
    border-color: #6A11CB;

    outline: none;

    background: white;

    box-shadow:
        0 0 0 3px rgba(106,17,203,.12);
}

.form-icon {
    position: absolute;

    left: 15px;
    top: 39px;

    color: #6A11CB;

    pointer-events: none;
}

/* ================================
   CHECKBOX
================================ */

.form-check {
    display: flex;

    align-items: center;

    gap: 9px;

    margin-bottom: 18px;
}

.form-check-input {
    margin: 0;

    accent-color: #6A11CB;
}

.form-check-label {
    font-size: .85rem;

    color: var(--text-gray);
}

/* ================================
   FORGOT PASSWORD
================================ */

.forgot-password {
    display: block;

    text-align: right;

    font-size: .85rem;

    color: #6A11CB;

    margin-bottom: 18px;

    text-decoration: none;

    transition: var(--transition);
}

.forgot-password:hover {
    text-decoration: underline;
}

/* ================================
   BUTTON
================================ */

.btn {
    width: 100%;

    min-height: 52px;

    padding: 13px 18px;

    border: none;

    border-radius: var(--border-radius);

    background: var(--gradient-primary);

    color: white;

    font-size: 15px;

    font-weight: 600;

    cursor: pointer;

    transition: var(--transition);

    position: relative;

    overflow: hidden;

    z-index: 1;
}

.btn::before {
    content: "";

    position: absolute;

    inset: 0;

    width: 0;

    background: var(--gradient-secondary);

    transition: var(--transition);

    z-index: -1;
}

.btn:hover::before {
    width: 100%;
}

.btn:hover {
    transform: translateY(-2px);

    box-shadow:
        0 10px 20px rgba(0,0,0,.15);
}

/* ================================
   DIVIDER
================================ */

.auth-divider {
    display: flex;

    align-items: center;

    margin: 22px 0;

    color: var(--text-gray);
}

.auth-divider::before,
.auth-divider::after {
    content: "";

    flex: 1;

    height: 1px;

    background: #e5e7eb;
}

.auth-divider span {
    padding: 0 12px;

    font-size: .82rem;

    white-space: nowrap;
}

/* ================================
   SOCIAL LOGIN
================================ */

.social-login {
    display: flex;

    gap: 12px;

    margin-bottom: 22px;
}

.social-btn {
    flex: 1;

    min-height: 46px;

    padding: 10px;

    border: 1px solid #e5e7eb;

    border-radius: var(--border-radius);

    display: flex;

    align-items: center;
    justify-content: center;

    background: white;

    cursor: pointer;

    transition: var(--transition);
}

.social-btn:hover {
    transform: translateY(-2px);

    box-shadow:
        0 7px 18px rgba(0,0,0,.1);
}

.social-btn i {
    font-size: 1.1rem;
}

.social-btn.facebook {
    background: linear-gradient(
        135deg,
        #3b5998,
        #2d4373
    );

    color: white;

    border: none;
}

.social-btn.google {
    background: linear-gradient(
        135deg,
        #DB4437,
        #B23121
    );

    color: white;

    border: none;
}

/* ================================
   FOOTER
================================ */

.auth-footer {
    text-align: center;

    font-size: .85rem;

    color: var(--text-gray);

    line-height: 1.6;
}

.auth-footer a {
    color: #6A11CB;

    font-weight: 600;

    text-decoration: none;
}

.auth-footer a:hover {
    text-decoration: underline;
}

/* ================================
   FORM ANIMATION
================================ */

.auth-form {
    display: none;

    opacity: 0;

    transform: translateX(20px);

    transition:
        opacity .4s ease,
        transform .4s ease;
}

.auth-form.active {
    display: block;

    opacity: 1;

    transform: translateX(0);
}


/* ==================================================
   LARGE LAPTOP
   1200px → 993px
================================================== */

@media (max-width: 1200px) {

    body {
        padding: 25px;
    }

    .auth-container {
        max-width: 950px;

        min-height: 590px;
    }

    .auth-forms {
        padding: 40px;
    }

    .auth-image {
        padding: 30px;
    }
}


/* ==================================================
   TABLET / SMALL LAPTOP
   992px → 769px
================================================== */

@media (max-width: 992px) {

    body {
        padding: 20px;
    }

    .auth-container {
        max-width: 720px;

        min-height: auto;

        flex-direction: column;
    }

    .auth-image {
        flex: none;

        min-height: 260px;

        padding: 30px 25px;
    }

    .auth-image-content img {
        width: 110px;

        margin-bottom: 12px;
    }

    .auth-image-content h2 {
        font-size: 1.7rem;

        margin-bottom: 8px;
    }

    .auth-image-content p {
        font-size: .9rem;
    }

    .auth-forms {
        flex: none;

        padding: 35px;

        width: 100%;
    }
}


/* ==================================================
   MOBILE
   768px → 481px
================================================== */

@media (max-width: 768px) {

    body {
        min-height: 100svh;

        padding: 15px;

        align-items: flex-start;
    }

    .auth-container {
        width: 100%;

        margin: auto;

        border-radius: 18px;
    }

    .auth-image {
        min-height: 220px;

        padding: 25px 20px;
    }

    .auth-image-content img {
        width: 90px;

        margin-bottom: 10px;
    }

    .auth-image-content h2 {
        font-size: 1.45rem;
    }

    .auth-image-content p {
        font-size: .82rem;

        line-height: 1.5;

        max-width: 300px;
    }

    .auth-forms {
        padding: 32px 24px;
    }

    .close-auth {
        top: 12px;
        right: 12px;

        width: 36px;
        height: 36px;
    }

    .auth-tabs {
        margin-bottom: 24px;
    }

    .auth-tab {
        padding: 11px 10px;

        font-size: .9rem;
    }

    .form-title {
        font-size: 1.45rem;

        margin-bottom: 20px;
    }

    .form-control {
        min-height: 50px;

        font-size: 14px;
    }

    .btn {
        min-height: 50px;
    }

    .social-login {
        gap: 10px;
    }
}


/* ==================================================
   SMALL MOBILE
   480px → 361px
================================================== */

@media (max-width: 480px) {

    body {
        padding: 10px;

        align-items: flex-start;
    }

    .auth-container {
        border-radius: 15px;

        margin-top: 5px;
    }

    .auth-image {
        min-height: 190px;

        padding: 22px 15px;
    }

    .auth-image-content img {
        width: 70px;

        margin-bottom: 7px;
    }

    .auth-image-content h2 {
        font-size: 1.2rem;

        margin-bottom: 5px;
    }

    .auth-image-content p {
        font-size: .75rem;

        max-width: 270px;
    }

    .auth-forms {
        padding: 25px 18px 28px;
    }

    .close-auth {
        width: 32px;
        height: 32px;

        top: 10px;
        right: 10px;
    }

    .auth-tabs {
        margin-bottom: 20px;
    }

    .auth-tab {
        padding: 10px 8px;

        font-size: .82rem;
    }

    .form-title {
        font-size: 1.3rem;

        margin-bottom: 18px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form-group label {
        font-size: .82rem;
    }

    .form-control {
        min-height: 48px;

        padding:
            11px
            12px
            11px
            40px;

        font-size: 14px;

        border-radius: 10px;
    }

    .form-icon {
        left: 13px;

        top: 36px;
    }

    .forgot-password {
        font-size: .78rem;

        margin-bottom: 15px;
    }

    .btn {
        min-height: 48px;

        padding: 11px;

        font-size: 14px;

        border-radius: 10px;
    }

    .auth-divider {
        margin: 18px 0;
    }

    .auth-divider span {
        font-size: .75rem;

        padding: 0 8px;
    }

    .social-login {
        flex-direction: column;

        gap: 9px;
    }

    .social-btn {
        min-height: 45px;
    }

    .auth-footer {
        font-size: .78rem;
    }
}


/* ==================================================
   VERY SMALL PHONES
   360px and below
================================================== */

@media (max-width: 360px) {

    body {
        padding: 6px;
    }

    .auth-container {
        border-radius: 12px;
    }

    .auth-image {
        min-height: 165px;

        padding: 18px 10px;
    }

    .auth-image-content img {
        width: 60px;
    }

    .auth-image-content h2 {
        font-size: 1.05rem;
    }

    .auth-image-content p {
        display: none;
    }

    .auth-forms {
        padding: 22px 14px;
    }

    .auth-tab {
        font-size: .76rem;

        padding: 9px 5px;
    }

    .form-title {
        font-size: 1.15rem;
    }

    .form-control {
        min-height: 46px;

        font-size: 13px;
    }

    .btn {
        min-height: 46px;

        font-size: 13px;
    }
}


/* ==================================================
   LANDSCAPE MOBILE
================================================== */

@media (max-height: 600px) and (orientation: landscape) {

    body {
        align-items: flex-start;

        padding: 10px;
    }

    .auth-container {
        flex-direction: row;

        min-height: auto;
    }

    .auth-image {
        min-height: 520px;

        padding: 20px;
    }

    .auth-image-content img {
        width: 80px;
    }

    .auth-image-content h2 {
        font-size: 1.3rem;
    }

    .auth-image-content p {
        font-size: .75rem;
    }

    .auth-forms {
        padding: 25px;
    }
}


/* ==================================================
   TOUCH DEVICES
================================================== */

@media (hover: none) and (pointer: coarse) {

    .btn:hover,
    .social-btn:hover,
    .close-auth:hover {
        transform: none;
    }

    .form-control {
        min-height: 50px;
    }

    .btn {
        min-height: 50px;
    }

    .social-btn {
        min-height: 48px;
    }
}


/* ==================================================
   REDUCE ANIMATION FOR ACCESSIBILITY
================================================== */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        animation-duration: .01ms !important;

        animation-iteration-count: 1 !important;

        transition-duration: .01ms !important;
    }
}
    </style>
</head>

<body>
    <div class="auth-container">
        <div class="auth-image">
            <div class="auth-image-content">
                <img src="aonegs logo.jpeg" alt="A ONE GS CENTER Logo">
                <h2>A ONE GS CENTER </h2>
                <p>Empowering students to excel in Arts through quality education and competitive preparation</p>
            </div>
        </div>

        <div class="auth-forms">
            <div class="close-auth">
                <i class="fas fa-times"></i>
            </div>

            <div class="auth-tabs">
                <div class="auth-tab active" data-tab="login">Login</div>
                <div class="auth-tab" data-tab="register">Register</div>
            </div>

            <div class="auth-form active" id="login-form">
                <h2 class="form-title">Welcome Back</h2>

                <form action="/sample/check" method="post">

    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                    <div class="form-group">
                        <label for="loginEmail">Email or Username</label>
                        <i class="fas fa-user form-icon"></i>
                        <input type="email" name="email" id="loginEmail" class="form-control"
                            placeholder="Enter your email or username" required>
                    </div>

                    <div class="form-group">
                        <label for="loginPassword">Password</label>
                        <i class="fas fa-lock form-icon"></i>
                        <input type="password" name="password" class="form-control" placeholder="Enter your password"
                            required>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" id="rememberMe" class="form-check-input">
                        <label for="rememberMe" class="form-check-label">Remember me</label>
                    </div>

                    <a href="#" class="forgot-password">Forgot Password?</a>

                    <button type="submit" class="btn">Login</button>
                </form>

                <div class="auth-divider">
                    <span>Or continue with</span>
                </div>

                <div class="social-login">
                    <div class="social-btn facebook">
                        <i class="fab fa-facebook-f"></i>
                    </div>
                    <div class="social-btn google">
                        <i class="fab fa-google"></i>
                    </div>
                </div>

                <div class="auth-footer">
                    Don't have an account?<%= link_to "Register Now", new_user_registration_path %>
                </div>
            </div>

            <div class="auth-form" id="register-form">
                <h2 class="form-title">Create Account</h2>

                <form id="registerForm">
                    <div class="form-group">
                        <label for="fullName">Full Name</label>
                        <i class="fas fa-user form-icon"></i>
                        <input type="text" id="fullName" class="form-control" placeholder="Enter your full name"
                            required>
                    </div>

                    <div class="form-group">
                        <label for="registerEmail">Email Address</label>
                        <i class="fas fa-envelope form-icon"></i>
                        <input type="email" id="registerEmail" class="form-control" placeholder="Enter your email"
                            required>
                    </div>

                    <div class="form-group">
                        <label for="registerPassword">Password</label>
                        <i class="fas fa-lock form-icon"></i>
                        <input type="password" id="registerPassword" class="form-control"
                            placeholder="Create a password" required>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Confirm Password</label>
                        <i class="fas fa-lock form-icon"></i>
                        <input type="password" id="confirmPassword" class="form-control"
                            placeholder="Confirm your password" required>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" id="termsAgree" class="form-check-input" required>
                        <label for="termsAgree" class="form-check-label">I agree to the <a href="#">Terms &
                                Conditions</a> and <a href="#">Privacy Policy</a></label>
                    </div>

                    <button type="submit" class="btn">Create Account</button>
                </form>

                <div class="auth-divider">
                    <span>Or sign up with</span>
                </div>

                <div class="social-login">
                    <div class="social-btn facebook">
                        <i class="fab fa-facebook-f"></i>
                    </div>
                    <div class="social-btn google">
                        <i class="fab fa-google"></i>
                    </div>
                </div>

                <div class="auth-footer">
                    Already have an account? <a href="/sample/index">Login now</a> class="switch-to-login">Login now</a>
                </div>
            </div>
        </div>
    </div>

