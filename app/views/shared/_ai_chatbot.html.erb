<style nonce="<%= content_security_policy_nonce %>">

  /* =========================================================
     A ONE AI - FLOATING CHATBOT
  ========================================================= */

  .aone-ai-launcher {
    position: fixed;
    right: 24px;
    bottom: 24px;

    width: 64px;
    height: 64px;

    border: 0;
    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    color: #ffffff;

    background:
      linear-gradient(
        135deg,
        #2563eb 0%,
        #7c3aed 50%,
        #9333ea 100%
      );

    box-shadow:
      0 12px 35px rgba(80, 40, 180, 0.35),
      0 0 0 5px rgba(124, 58, 237, 0.10);

    z-index: 99990;

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .aone-ai-launcher:hover {
    transform: translateY(-4px) scale(1.04);

    box-shadow:
      0 18px 45px rgba(80, 40, 180, 0.45),
      0 0 0 7px rgba(124, 58, 237, 0.12);
  }

  .aone-ai-launcher-icon {
    font-size: 28px;
    line-height: 1;
  }

  .aone-ai-launcher-label {
    position: absolute;

    right: 74px;
    bottom: 8px;

    white-space: nowrap;

    padding: 9px 14px;

    border-radius: 14px;

    background: rgba(255, 255, 255, 0.96);

    color: #39206f;

    font-size: 13px;
    font-weight: 700;

    box-shadow:
      0 8px 25px rgba(31, 41, 55, 0.15);

    pointer-events: none;

    opacity: 0;

    transform: translateX(8px);

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .aone-ai-launcher:hover .aone-ai-launcher-label {
    opacity: 1;
    transform: translateX(0);
  }


  /* =========================================================
     CHAT WINDOW
  ========================================================= */

  .aone-ai-window {
    position: fixed;

    right: 24px;
    bottom: 100px;

    width: min(430px, calc(100vw - 30px));
    height: min(650px, calc(100vh - 130px));

    display: none;
    flex-direction: column;

    overflow: hidden;

    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.98),
        rgba(249, 247, 255, 0.98)
      );

    border:
      1px solid rgba(124, 58, 237, 0.18);

    border-radius: 24px;

    box-shadow:
      0 25px 80px rgba(31, 20, 70, 0.28),
      0 8px 30px rgba(124, 58, 237, 0.14);

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);

    z-index: 99991;

    animation: aoneAiOpen 0.25s ease;
  }

  .aone-ai-window.is-open {
    display: flex;
  }

  @keyframes aoneAiOpen {

    from {
      opacity: 0;
      transform: translateY(15px) scale(0.97);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

  }


  /* =========================================================
     HEADER
  ========================================================= */

  .aone-ai-header {
    flex: 0 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 15px 17px;

    color: #ffffff;

    background:
      linear-gradient(
        135deg,
        #1d4ed8 0%,
        #6d28d9 48%,
        #9333ea 100%
      );
  }

  .aone-ai-header-left {
    display: flex;
    align-items: center;
    gap: 11px;

    min-width: 0;
  }

  .aone-ai-avatar {
    width: 42px;
    height: 42px;

    flex: 0 0 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 14px;

    background: rgba(255, 255, 255, 0.18);

    border:
      1px solid rgba(255, 255, 255, 0.28);

    font-size: 22px;
  }

  .aone-ai-header-text {
    min-width: 0;
  }

  .aone-ai-header-title {
    margin: 0;

    font-size: 16px;
    font-weight: 800;

    line-height: 1.2;
  }

  .aone-ai-header-subtitle {
    margin-top: 3px;

    font-size: 11px;

    opacity: 0.86;
  }

  .aone-ai-close {
    width: 34px;
    height: 34px;

    flex: 0 0 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 0;
    border-radius: 10px;

    color: #ffffff;

    background: rgba(255, 255, 255, 0.12);

    cursor: pointer;

    font-size: 21px;

    transition: background 0.2s ease;
  }

  .aone-ai-close:hover {
    background: rgba(255, 255, 255, 0.22);
  }


  /* =========================================================
     QUICK ACTIONS
  ========================================================= */

  .aone-ai-quick-actions {
    display: flex;
    gap: 7px;

    padding: 11px 12px;

    overflow-x: auto;

    border-bottom:
      1px solid rgba(124, 58, 237, 0.09);

    scrollbar-width: none;
  }

  .aone-ai-quick-actions::-webkit-scrollbar {
    display: none;
  }

  .aone-ai-quick-btn {
    position: relative;
    z-index: 20;
    flex: 0 0 auto;
    pointer-events: auto;
    padding: 7px 10px;

    border:
      1px solid rgba(124, 58, 237, 0.14);

    border-radius: 999px;

    background: rgba(255, 255, 255, 0.75);

    color: #4c2a85;

    font-size: 11px;
    font-weight: 700;

    cursor: pointer;

    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .aone-ai-quick-btn:hover {
    background: #ffffff;

    transform: translateY(-1px);
  }


  /* =========================================================
     MESSAGES
  ========================================================= */

  .aone-ai-messages {
  flex: 1 1 0;

  min-height: 0;

  overflow-y: auto;
  overflow-x: hidden;

  padding: 17px 13px;

  scroll-behavior: smooth;

  scrollbar-width: thin;
}

  .aone-ai-message {
    display: flex;

    margin-bottom: 13px;
  }

  .aone-ai-message.user {
    justify-content: flex-end;
  }

  .aone-ai-message.assistant {
    justify-content: flex-start;
  }

  .aone-ai-bubble {
    max-width: 96%;

    padding: 11px 13px;

    border-radius: 17px;

    font-size: 13px;

    line-height: 1.58;

    word-break: break-word;

    overflow-wrap: anywhere;
  }

  .aone-ai-message.user .aone-ai-bubble {
    color: #ffffff;

    background:
      linear-gradient(
        135deg,
        #2563eb,
        #7c3aed
      );

    border-bottom-right-radius: 5px;

    box-shadow:
      0 6px 18px rgba(79, 70, 229, 0.18);

    white-space: pre-wrap;
  }

  .aone-ai-message.assistant .aone-ai-bubble {
    color: #273047;

    background: #ffffff;

    border:
      1px solid rgba(124, 58, 237, 0.10);

    border-bottom-left-radius: 5px;

    box-shadow:
      0 5px 18px rgba(31, 41, 55, 0.07);
  }


  /* =========================================================
     MARKDOWN CONTENT
  ========================================================= */

  .aone-ai-markdown {
    width: 100%;
  }

  .aone-ai-markdown > :first-child {
    margin-top: 0;
  }

  .aone-ai-markdown > :last-child {
    margin-bottom: 0;
  }


  /* Paragraph */

  .aone-ai-markdown p {
    margin: 0 0 9px;
  }


  /* Headings */

  .aone-ai-markdown h1,
  .aone-ai-markdown h2,
  .aone-ai-markdown h3,
  .aone-ai-markdown h4 {
    margin-top: 13px;
    margin-bottom: 7px;

    color: #32205f;

    line-height: 1.3;
    font-weight: 800;
  }

  .aone-ai-markdown h1 {
    font-size: 19px;
  }

  .aone-ai-markdown h2 {
    font-size: 17px;
  }

  .aone-ai-markdown h3 {
    font-size: 15px;
  }

  .aone-ai-markdown h4 {
    font-size: 14px;
  }


  /* Strong / emphasis */

  .aone-ai-markdown strong {
    color: #34206d;

    font-weight: 800;
  }

  .aone-ai-markdown em {
    font-style: italic;

    color: #51456e;
  }


  /* Lists */

  .aone-ai-markdown ul,
  .aone-ai-markdown ol {
    margin: 7px 0 10px;

    padding-left: 22px;
  }

  .aone-ai-markdown li {
    margin: 4px 0;

    padding-left: 2px;
  }

  .aone-ai-markdown li > ul,
  .aone-ai-markdown li > ol {
    margin-top: 4px;
    margin-bottom: 4px;
  }


  /* =========================================================
     MARKDOWN TABLE
  ========================================================= */

  .aone-ai-table-wrapper {
    width: 100%;
    max-width: 100%;
    width: 100%;

    margin: 10px 0;

    overflow-x: auto;

    border:
      1px solid rgba(124, 58, 237, 0.13);

    border-radius: 12px;

    background: #ffffff;
  }

  .aone-ai-table {
  width: max-content;
  min-width: 100%;

  border-collapse: collapse;

  font-size: 11px;

  table-layout: auto;
}

.aone-ai-table th,
.aone-ai-table td {
  white-space: normal;
  word-break: normal;
  overflow-wrap: normal;
}

.aone-ai-table th:first-child,
.aone-ai-table td:first-child {
  min-width: 125px;
}

.aone-ai-table th:nth-child(2),
.aone-ai-table td:nth-child(2) {
  min-width: 150px;
}

.aone-ai-table th {
  white-space: nowrap;
}

  .aone-ai-table th {
    padding: 8px 9px;

    text-align: left;

    color: #ffffff;

    background:
      linear-gradient(
        135deg,
        #5b21b6,
        #7c3aed
      );

    font-weight: 800;

    white-space: nowrap;
  }

  .aone-ai-table td {
    padding: 8px 9px;

    border-top:
      1px solid #eee8ff;

    color: #344054;

    vertical-align: top;
  }

  .aone-ai-table tr:nth-child(even) td {
    background: #faf9ff;
  }


  /* =========================================================
     INLINE CODE
  ========================================================= */

  .aone-ai-markdown code {
    padding: 2px 5px;

    border-radius: 5px;

    background: #f3f0ff;

    color: #6d28d9;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 11px;
  }


  /* =========================================================
     CODE BLOCK
  ========================================================= */

  .aone-ai-code-wrapper {
    margin: 10px 0;

    overflow: hidden;

    border-radius: 11px;

    background: #17152a;

    box-shadow:
      0 5px 16px rgba(31, 20, 70, 0.14);
  }

  .aone-ai-code-label {
    padding: 6px 10px;

    color: #c4b5fd;

    background: #211d38;

    border-bottom:
      1px solid rgba(255, 255, 255, 0.08);

    font-size: 9px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.06em;
  }

  .aone-ai-code {
    display: block;

    margin: 0;

    padding: 11px;

    overflow-x: auto;

    color: #f4f1ff;

    background: #17152a;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 11px;

    line-height: 1.55;

    white-space: pre;
  }


  /* =========================================================
     LINKS
  ========================================================= */

  .aone-ai-markdown a {
    color: #6d28d9;

    font-weight: 700;

    text-decoration: none;

    border-bottom:
      1px dashed rgba(109, 40, 217, 0.45);

    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .aone-ai-markdown a:hover {
    color: #4c1d95;

    background: #f4efff;
  }


  /* A ONE internal course/action link */

  .aone-ai-course-link {
    display: inline-flex;

    align-items: center;

    gap: 5px;

    margin: 3px 3px 3px 0;

    padding: 6px 10px;

    border: 0 !important;

    border-radius: 8px;

    color: #ffffff !important;

    background:
      linear-gradient(
        135deg,
        #2563eb,
        #7c3aed
      );

    font-size: 11px;

    box-shadow:
      0 4px 10px rgba(79, 70, 229, 0.16);
  }

  .aone-ai-course-link:hover {
    color: #ffffff !important;

    background:
      linear-gradient(
        135deg,
        #1d4ed8,
        #6d28d9
      );

    transform: translateY(-1px);
  }


  /* =========================================================
     BLOCKQUOTE
  ========================================================= */

  .aone-ai-markdown blockquote {
    margin: 9px 0;

    padding: 8px 11px;

    border-left:
      3px solid #8b5cf6;

    border-radius: 0 8px 8px 0;

    background: #f7f4ff;

    color: #5d5870;
  }


  /* =========================================================
     HORIZONTAL RULE
  ========================================================= */

  .aone-ai-markdown hr {
    margin: 12px 0;

    border: 0;

    border-top:
      1px solid #e8e1f7;
  }


  /* =========================================================
     WELCOME
  ========================================================= */

  .aone-ai-welcome {
    padding: 8px 2px 14px;
  }

  .aone-ai-welcome-title {
    margin-bottom: 5px;

    color: #32205f;

    font-size: 19px;
    font-weight: 800;
  }

  .aone-ai-welcome-text {
    color: #667085;

    font-size: 12px;

    line-height: 1.55;
  }


  /* =========================================================
     TYPING
  ========================================================= */

  .aone-ai-typing {
    display: none;

    align-items: center;
    gap: 5px;

    width: fit-content;

    margin: 0 13px 13px;

    padding: 10px 13px;

    border-radius: 16px;

    background: #ffffff;

    border:
      1px solid rgba(124, 58, 237, 0.10);

    box-shadow:
      0 5px 18px rgba(31, 41, 55, 0.06);
  }

  .aone-ai-typing.is-visible {
    display: flex;
  }

  .aone-ai-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #7c3aed;

    animation:
      aoneAiTyping 1.1s infinite ease-in-out;
  }

  .aone-ai-dot:nth-child(2) {
    animation-delay: 0.15s;
  }

  .aone-ai-dot:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes aoneAiTyping {

    0%, 60%, 100% {
      transform: translateY(0);
      opacity: 0.45;
    }

    30% {
      transform: translateY(-4px);
      opacity: 1;
    }

  }


  /* =========================================================
     INPUT
  ========================================================= */

  .aone-ai-input-area {
    flex: 0 0 auto;

    padding: 11px;

    background:
      rgba(255, 255, 255, 0.88);

    border-top:
      1px solid rgba(124, 58, 237, 0.09);
  }

  .aone-ai-form {
    display: flex;

    align-items: flex-end;

    gap: 8px;
  }

  .aone-ai-input {
    flex: 1;

    min-height: 44px;
    height:44px;
    max-height: 110px;

    resize: none;

    padding: 12px 13px;

    border:
      1px solid #ddd6fe;

    border-radius: 14px;

    outline: none;

    background: #ffffff;

    color: #202938;

    font-size: 13px;

    font-family: inherit;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .aone-ai-input:focus {
    border-color: #8b5cf6;

    box-shadow:
      0 0 0 3px rgba(139, 92, 246, 0.10);
  }

  .aone-ai-send {
    width: 44px;
    height: 44px;

    flex: 0 0 44px;

    border: 0;

    border-radius: 13px;

    display: flex;

    align-items: center;
    justify-content: center;

    color: #ffffff;

    background:
      linear-gradient(
        135deg,
        #2563eb,
        #7c3aed
      );

    cursor: pointer;

    font-size: 18px;

    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .aone-ai-send:hover {
    transform: translateY(-2px);
  }

  .aone-ai-send:disabled {
    opacity: 0.55;

    cursor: not-allowed;

    transform: none;
  }

  .aone-ai-powered {
    margin-top: 6px;

    text-align: center;

    color: #98a2b3;

    font-size: 9px;
  }



  .aone-ai-support-panel {
    position: absolute;
    inset: 136px 0 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 14px;
    background: linear-gradient(180deg, rgba(255,255,255,0.99), rgba(249,247,255,0.99));
  }

  .aone-ai-support-panel[hidden] {
    display: none;
  }

  .aone-ai-support-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
    padding: 12px;
    border-radius: 14px;
    background: linear-gradient(135deg, #f3efff, #ffffff);
    border: 1px solid rgba(124,58,237,0.12);
  }

  .aone-ai-support-header strong {
    display: block;
    color: #32205f;
    font-size: 15px;
    font-weight: 800;
  }

  .aone-ai-support-header div div {
    margin-top: 3px;
    color: #667085;
    font-size: 11px;
    line-height: 1.45;
  }

  #aoneAiSupportClose {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    border: 0;
    border-radius: 9px;
    color: #4c2a85;
    background: #ffffff;
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
  }

  #aoneAiSupportForm {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  #aoneAiSupportForm label {
    margin-top: 4px;
    color: #344054;
    font-size: 11px;
    font-weight: 800;
  }

  #aoneAiSupportForm select,
  #aoneAiSupportForm input,
  #aoneAiSupportForm textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #ddd6fe;
    border-radius: 11px;
    outline: none;
    background: #ffffff;
    color: #202938;
    font: inherit;
    font-size: 12px;
  }

  #aoneAiSupportForm select,
  #aoneAiSupportForm input {
    min-height: 40px;
    padding: 9px 11px;
  }

  #aoneAiSupportForm textarea {
    min-height: 125px;
    padding: 10px 11px;
    resize: vertical;
    line-height: 1.5;
  }

  #aoneAiSupportForm select:focus,
  #aoneAiSupportForm input:focus,
  #aoneAiSupportForm textarea:focus {
    border-color: #8b5cf6;
    box-shadow: 0 0 0 3px rgba(139,92,246,0.10);
  }

  #aoneAiSupportSubmit {
    min-height: 42px;
    margin-top: 5px;
    border: 0;
    border-radius: 11px;
    color: #ffffff;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    cursor: pointer;
    font-size: 12px;
    font-weight: 800;
  }

  #aoneAiSupportSubmit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  #aoneAiSupportResult {
    margin-top: 12px;
    padding: 11px 12px;
    border-radius: 11px;
    font-size: 11px;
    line-height: 1.5;
  }

  #aoneAiSupportResult.success {
    color: #166534;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
  }

  #aoneAiSupportResult.error {
    color: #991b1b;
    background: #fef2f2;
    border: 1px solid #fecaca;
  }

  .aone-ai-support-history {
    margin-top: 16px;
  }

  .aone-ai-support-history h4 {
    margin: 0 0 8px;
    color: #32205f;
    font-size: 13px;
    font-weight: 800;
  }

  .aone-ai-support-ticket {
    margin-bottom: 8px;
    padding: 10px;
    border: 1px solid rgba(124,58,237,0.11);
    border-radius: 11px;
    background: #ffffff;
  }

  .aone-ai-support-ticket-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .aone-ai-support-ticket-subject {
    min-width: 0;
    color: #344054;
    font-size: 11px;
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .aone-ai-support-ticket-status {
    flex: 0 0 auto;
    padding: 3px 7px;
    border-radius: 999px;
    color: #4c1d95;
    background: #f3e8ff;
    font-size: 9px;
    font-weight: 800;
  }

  .aone-ai-support-ticket-meta {
    margin-top: 4px;
    color: #98a2b3;
    font-size: 9px;
  }

  .aone-ai-support-ticket-reply {
    margin-top: 7px;
    padding-top: 7px;
    border-top: 1px solid #eee8ff;
    color: #475467;
    font-size: 10px;
    line-height: 1.45;
  }

  .aone-ai-support-ticket-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 8px;
  }

  .aone-ai-support-chat-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 30px;
    padding: 6px 10px;
    border-radius: 8px;
    color: #ffffff !important;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    text-decoration: none !important;
    font-size: 10px;
    font-weight: 800;
    box-shadow: 0 4px 10px rgba(79,70,229,0.16);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .aone-ai-support-chat-link:hover {
    color: #ffffff !important;
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgba(79,70,229,0.22);
  }

  .aone-ai-support-empty {
    color: #98a2b3;
    font-size: 10px;
  }

  @media (max-width: 576px) {
    .aone-ai-support-panel {
      inset: 70px 0 0;
      padding: 11px;
    }
  }

  /* =========================================================
     MOBILE
  ========================================================= */

  @media (max-width: 576px) {

    .aone-ai-launcher {
      right: 16px;
      bottom: 16px;

      width: 58px;
      height: 58px;
    }

