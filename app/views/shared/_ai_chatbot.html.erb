<script nonce="<%= content_security_policy_nonce %>">

(function () {

  "use strict";


  /* =========================================================
     ELEMENTS
  ========================================================= */

  const launcher =
    document.getElementById("aoneAiLauncher");

  const chatWindow =
    document.getElementById("aoneAiWindow");

  const closeButton =
    document.getElementById("aoneAiClose");

  const form =
    document.getElementById("aoneAiForm");

  const input =
    document.getElementById("aoneAiInput");

  const sendButton =
    document.getElementById("aoneAiSend");

  const messages =
    document.getElementById("aoneAiMessages");

  const typing =
    document.getElementById("aoneAiTyping");


  if (
    !launcher ||
    !chatWindow ||
    !closeButton ||
    !form ||
    !input ||
    !sendButton ||
    !messages ||
    !typing
  ) {

    return;

  }


  /* =========================================================
     STATE
  ========================================================= */

  let conversationId = null;

  let initialized = false;

  let sending = false;


  /* =========================================================
     CSRF
  ========================================================= */

  function csrfToken() {

    const meta =
      document.querySelector(
        'meta[name="csrf-token"]'
      );

    return meta
      ? meta.content
      : "";

  }


  /* =========================================================
     OPEN / CLOSE
  ========================================================= */

  function openChat() {

    chatWindow.classList.add(
      "is-open"
    );

    launcher.setAttribute(
      "aria-expanded",
      "true"
    );

    setTimeout(function () {

      input.focus();

    }, 100);

  }


  function closeChat() {

    chatWindow.classList.remove(
      "is-open"
    );

    launcher.setAttribute(
      "aria-expanded",
      "false"
    );

  }


  launcher.addEventListener(
    "click",
    function () {

      if (
        chatWindow.classList.contains(
          "is-open"
        )
      ) {

        closeChat();

      } else {

        openChat();

      }

    }
  );


  closeButton.addEventListener(
    "click",
    closeChat
  );


  /* =========================================================
     CREATE CONVERSATION
  ========================================================= */

  async function createConversation() {

    if (conversationId) {

      return conversationId;

    }


    const response =
      await fetch(
        "/ai/conversations",
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-CSRF-Token": csrfToken()
          },

          credentials: "same-origin",

          body: JSON.stringify({
            title: "A ONE AI Chat"
          })
        }
      );


    if (!response.ok) {

      throw new Error(
        "Could not create AI conversation."
      );

    }


    const data =
      await response.json();


    conversationId =
      data.id ||
      data.conversation_id ||
      data.conversation?.id;


    if (!conversationId) {

      throw new Error(
        "AI conversation ID was not returned."
      );

    }


    return conversationId;

  }


  /* =========================================================
     SAFE TEXT NODE
  ========================================================= */

  function textNode(text) {

    return document.createTextNode(
      text || ""
    );

  }


  /* =========================================================
     SAFE URL VALIDATION
  ========================================================= */

  function safeUrl(rawUrl) {

    if (!rawUrl) {

      return null;

    }


    const value =
      rawUrl.trim();


    /*
     * Allow internal A ONE links.
     */

    if (
      value.startsWith("/")
      &&
      !value.startsWith("//")
    ) {

      return value;

    }


    /*
     * Allow safe HTTP/HTTPS URLs only.
     */

    try {

      const parsed =
        new URL(
          value,
          window.location.origin
        );


      if (
        parsed.protocol === "http:" ||
        parsed.protocol === "https:"
      ) {

        return parsed.href;

      }

    } catch (error) {

      return null;

    }


    return null;

  }


  /* =========================================================
     INLINE MARKDOWN
  ========================================================= */

  function renderInlineMarkdown(
    text,
    parent
  ) {

    if (!text) {

      return;

    }


    let remaining =
      text;


    while (remaining.length > 0) {

      /*
       * Bold
       */

      let match =
        remaining.match(
          /^\*\*(.+?)\*\*/
        );


      if (match) {

        const strong =
          document.createElement(
            "strong"
          );

        strong.appendChild(
          textNode(match[1])
        );

        parent.appendChild(
          strong
        );

        remaining =
          remaining.slice(
            match[0].length
          );

        continue;

      }


      /*
       * Bold using __
       */

      match =
        remaining.match(
          /^__(.+?)__/
        );


      if (match) {

        const strong =
          document.createElement(
            "strong"
          );

        strong.appendChild(
          textNode(match[1])
        );

        parent.appendChild(
          strong
        );

        remaining =
          remaining.slice(
            match[0].length
          );

        continue;

      }


      /*
       * Inline code
       */

      match =
        remaining.match(
          /^`([^`]+)`/
        );


      if (match) {

        const code =
          document.createElement(
            "code"
          );

        code.textContent =
          match[1];

        parent.appendChild(
          code
        );

        remaining =
          remaining.slice(
            match[0].length
          );

        continue;

      }


      /*
       * Markdown link
       */

      match =
        remaining.match(
          /^\[([^\]]+)\]\(([^)\s]+)\)/
        );


      if (match) {

        const label =
          match[1];

        const rawUrl =
          match[2];

        const url =
          safeUrl(rawUrl);


        if (url) {

          const link =
            document.createElement(
              "a"
            );

          link.href =
            url;

          link.appendChild(
            textNode(label)
          );


          /*
           * A ONE internal links become
           * action buttons.
           */

          if (
            url.startsWith(
              "/courses/"
            )
            ||
            url.startsWith(
              "/test_series"
            )
            ||
            url.startsWith(
              "/enrollments"
            )
          ) {

            link.className =
              "aone-ai-course-link";

            link.setAttribute(
              "data-ai-internal-link",
              "true"
            );

          } else {

            link.target =
              "_blank";

            link.rel =
              "noopener noreferrer";

          }


          parent.appendChild(
            link
          );

        } else {

          parent.appendChild(
            textNode(match[0])
          );

        }


        remaining =
          remaining.slice(
            match[0].length
          );

        continue;

      }


      /*
       * Raw URL
       */

      match =
        remaining.match(
          /^(https?:\/\/[^\s<]+)/
        );


      if (match) {

        let rawUrl =
          match[1];


        /*
         * Remove common punctuation
         * from the end of URLs.
         */

        let punctuation = "";

        while (
          /[.,!?;:]$/.test(
            rawUrl
          )
        ) {

          punctuation =
            rawUrl.slice(
              -1
            ) +
            punctuation;

          rawUrl =
            rawUrl.slice(
              0,
              -1
            );

        }


        const url =
          safeUrl(rawUrl);


        if (url) {

          const link =
            document.createElement(
              "a"
            );

          link.href =
            url;

          link.target =
            "_blank";

          link.rel =
            "noopener noreferrer";

          link.textContent =
            rawUrl;

          parent.appendChild(
            link
          );

        } else {

          parent.appendChild(
            textNode(
              rawUrl
            )
          );

        }


        if (punctuation) {

          parent.appendChild(
            textNode(
              punctuation
            )
          );

        }


        remaining =
          remaining.slice(
            match[0].length
          );

        continue;

      }


      /*
       * Italic
       */

      match =
        remaining.match(
          /^\*(?!\s)(.+?)(?<!\s)\*/
        );


      if (match) {

        const italic =
          document.createElement(
            "em"
          );

        italic.appendChild(
          textNode(match[1])
        );

        parent.appendChild(
          italic
        );

        remaining =
          remaining.slice(
            match[0].length
          );

        continue;

      }


      /*
       * Italic using _
       */

      match =
        remaining.match(
          /^_(?!\s)(.+?)(?<!\s)_/
        );


      if (match) {

        const italic =
          document.createElement(
            "em"
          );

        italic.appendChild(
          textNode(match[1])
        );

        parent.appendChild(
          italic
        );

        remaining =
          remaining.slice(
            match[0].length
          );

        continue;

      }


      /*
       * Escape Markdown characters
       */

      match =
        remaining.match(
          /^\\([\\`*_[\]{}()#+.!-])/
        );


      if (match) {

        parent.appendChild(
          textNode(
            match[1]
          )
        );

        remaining =
          remaining.slice(
            match[0].length
          );

        continue;

      }


      /*
       * Normal text.
       *
       * Take one character at a time.
       * This keeps the parser safe and predictable.
       */

      parent.appendChild(
        textNode(
          remaining.charAt(0)
        )
      );

      remaining =
        remaining.slice(1);

    }

  }


  /* =========================================================
     CREATE INLINE CONTAINER
  ========================================================= */

  function createInlineContent(
    text
  ) {

    const fragment =
      document.createDocumentFragment();

    renderInlineMarkdown(
      text,
      fragment
    );

    return fragment;

  }


  /* =========================================================
     TABLE DETECTION
  ========================================================= */

  function isTableSeparator(
    line
  ) {

    const cleaned =
      line
        .trim()
        .replace(/^\|/, "")
        .replace(/\|$/, "");


    const cells =
      cleaned.split("|");


    if (
      cells.length === 0
    ) {

      return false;

    }


    return cells.every(
      function (cell) {

        return /^:?-{3,}:?$/.test(
          cell.trim()
        );

      }
    );

  }


  function splitTableRow(
    line
  ) {

    let value =
      line.trim();


    if (
      value.startsWith("|")
    ) {

      value =
        value.slice(1);

    }


    if (
      value.endsWith("|")
    ) {

      value =
        value.slice(
          0,
          -1
        );

    }


    return value.split("|")
      .map(function (cell) {

        return cell.trim();

      });

  }


  /* =========================================================
     RENDER TABLE
  ========================================================= */

  function renderTable(
    lines,
    parent
  ) {

    if (
      lines.length < 2
    ) {

      return false;

    }


    if (
      !lines[1] ||
      !isTableSeparator(
        lines[1]
      )
    ) {

      return false;

    }


    const headerCells =
      splitTableRow(
        lines[0]
      );


    const bodyLines =
      lines.slice(2);


    const wrapper =
      document.createElement(
        "div"
      );

    wrapper.className =
      "aone-ai-table-wrapper";


    const table =
      document.createElement(
        "table"
      );

    table.className =
      "aone-ai-table";


    const thead =
      document.createElement(
        "thead"
      );


    const headerRow =
      document.createElement(
        "tr"
      );


    headerCells.forEach(
      function (cell) {

        const th =
          document.createElement(
            "th"
          );

        th.appendChild(
          createInlineContent(
            cell
          )
        );

        headerRow.appendChild(
          th
        );

      }
    );


    thead.appendChild(
      headerRow
    );

    table.appendChild(
      thead
    );


    if (
      bodyLines.length > 0
    ) {

      const tbody =
        document.createElement(
          "tbody"
        );


      bodyLines.forEach(
        function (line) {

          if (
            !line.trim()
          ) {

            return;

          }


          const cells =
            splitTableRow(
              line
            );


          const tr =
            document.createElement(
              "tr"
            );


          headerCells.forEach(
            function (_, index) {

              const td =
                document.createElement(
                  "td"
                );


              td.appendChild(
                createInlineContent(
                  cells[index] || ""
                )
              );


              tr.appendChild(
                td
              );

            }
          );


          tbody.appendChild(
            tr
          );

        }
      );


      table.appendChild(
        tbody
      );

    }


    wrapper.appendChild(
      table
    );


    parent.appendChild(
      wrapper
    );


    return true;

  }


  /* =========================================================
     RENDER CODE BLOCK
  ========================================================= */

  function renderCodeBlock(
    code,
    language,
    parent
  ) {

    const wrapper =
      document.createElement(
        "div"
      );

    wrapper.className =
      "aone-ai-code-wrapper";


    if (language) {

      const label =
        document.createElement(
          "div"
        );

      label.className =
        "aone-ai-code-label";

      label.textContent =
        language;

      wrapper.appendChild(
        label
      );

    }


    const pre =
      document.createElement(
        "pre"
      );

    pre.className =
      "aone-ai-code";


    const codeElement =
      document.createElement(
        "code"
      );

    codeElement.textContent =
      code;


    pre.appendChild(
      codeElement
    );


    wrapper.appendChild(
      pre
    );


    parent.appendChild(
      wrapper
    );

  }


  /* =========================================================
     RENDER MARKDOWN
  ========================================================= */

  function renderMarkdown(
    content
  ) {

    const container =
      document.createElement(
        "div"
      );

    container.className =
      "aone-ai-markdown";


    if (
      typeof content !== "string"
    ) {

      return container;

    }


    const normalized =
      content
        .replace(/\r\n/g, "\n")
        .replace(/\r/g, "\n");


    const lines =
      normalized.split("\n");


    let i = 0;


    while (
      i < lines.length
    ) {

      const line =
        lines[i];


      /* -----------------------------------------------------
         Empty line
      ----------------------------------------------------- */

      if (
        line.trim() === ""
      ) {

        i++;

        continue;

      }


      /* -----------------------------------------------------
         Fenced code block
      ----------------------------------------------------- */

      if (
        line.trim().startsWith("```")
      ) {

        const language =
          line
            .trim()
            .slice(3)
            .trim();


        const codeLines = [];

        i++;


        while (
          i < lines.length
          &&
          !lines[i]
            .trim()
            .startsWith("```")
        ) {

          codeLines.push(
            lines[i]
          );

          i++;

        }


        if (
          i < lines.length
        ) {

          i++;

        }


        renderCodeBlock(
          codeLines.join("\n"),
          language,
          container
        );


        continue;

      }


      /* -----------------------------------------------------
         Markdown table
      ----------------------------------------------------- */

      if (
        i + 1 < lines.length
        &&
        isTableSeparator(
          lines[i + 1]
        )
      ) {

        const tableLines = [
          lines[i],
          lines[i + 1]
        ];


        i += 2;


        while (
          i < lines.length
          &&
          lines[i].trim() !== ""
          &&
          lines[i].includes("|")
        ) {

          tableLines.push(
            lines[i]
          );

          i++;

        }


        renderTable(
          tableLines,
          container
        );


        continue;

      }


      /* -----------------------------------------------------
         Heading
      ----------------------------------------------------- */

      const headingMatch =
        line.match(
          /^(#{1,4})\s+(.+)$/
        );


      if (headingMatch) {

        const level =
          headingMatch[1].length;


        const heading =
          document.createElement(
            "h" + level
          );


        heading.appendChild(
          createInlineContent(
            headingMatch[2]
          )
        );


        container.appendChild(
          heading
        );


        i++;

        continue;

      }


      /* -----------------------------------------------------
         Horizontal rule
      ----------------------------------------------------- */

      if (
        /^(\*{3,}|-{3,}|_{3,})$/.test(
          line.trim()
        )
      ) {

        container.appendChild(
          document.createElement(
            "hr"
          )
        );


        i++;

        continue;

      }


      /* -----------------------------------------------------
         Blockquote
      ----------------------------------------------------- */

      if (
        line.trim().startsWith(">")
      ) {

        const quoteLines = [];


        while (
          i < lines.length
          &&
          lines[i]
            .trim()
            .startsWith(">")
        ) {

          quoteLines.push(
            lines[i]
              .trim()
              .replace(/^>\s?/, "")
          );

          i++;

        }


        const blockquote =
          document.createElement(
            "blockquote"
          );


        quoteLines.forEach(
          function (
            quoteLine,
            index
          ) {

            if (index > 0) {

              blockquote.appendChild(
                document.createElement(
                  "br"
                )
              );

            }


            blockquote.appendChild(
              createInlineContent(
                quoteLine
              )
            );

          }
        );


        container.appendChild(
          blockquote
        );


        continue;

      }


      /* -----------------------------------------------------
         Unordered list
      ----------------------------------------------------- */

      if (
        /^\s*[-*+]\s+/.test(
          line
        )
      ) {

        const ul =
          document.createElement(
            "ul"
          );


        while (
          i < lines.length
          &&
          /^\s*[-*+]\s+/.test(
            lines[i]
          )
        ) {

          const itemText =
            lines[i]
              .replace(
                /^\s*[-*+]\s+/,
                ""
              );


          const li =
            document.createElement(
              "li"
            );


          li.appendChild(
            createInlineContent(
              itemText
            )
          );


          ul.appendChild(
            li
          );


          i++;

        }


        container.appendChild(
          ul
        );


        continue;

      }


      /* -----------------------------------------------------
         Ordered list
      ----------------------------------------------------- */

      if (
        /^\s*\d+\.\s+/.test(
          line
        )
      ) {

        const ol =
          document.createElement(
            "ol"
          );


        while (
          i < lines.length
          &&
          /^\s*\d+\.\s+/.test(
            lines[i]
          )
        ) {

          const itemText =
            lines[i]
              .replace(
                /^\s*\d+\.\s+/,
                ""
              );


          const li =
            document.createElement(
              "li"
            );


          li.appendChild(
            createInlineContent(
              itemText
            )
          );


          ol.appendChild(
            li
          );


          i++;

        }


        container.appendChild(
          ol
        );


        continue;

      }


      /* -----------------------------------------------------
         Normal paragraph
      ----------------------------------------------------- */

      const paragraphLines = [
        line
      ];


      i++;


      /*
       * Combine consecutive normal lines
       * into one paragraph.
       */

      while (
        i < lines.length
        &&
        lines[i].trim() !== ""
        &&
        !/^#{1,4}\s+/.test(
          lines[i]
        ) &&
        !/^\s*[-*+]\s+/.test(
          lines[i]
        ) &&
        !/^\s*\d+\.\s+/.test(
          lines[i]
        ) &&
        !lines[i]
          .trim()
          .startsWith(">") &&
        !lines[i]
          .trim()
          .startsWith("```") &&
        !(
          i + 1 < lines.length
          &&
          isTableSeparator(
            lines[i + 1]
          )
        )
      ) {

        paragraphLines.push(
          lines[i]
        );

        i++;

      }


      const paragraph =
        document.createElement(
          "p"
        );


      paragraphLines.forEach(
        function (
          paragraphLine,
          index
        ) {

          if (index > 0) {

            paragraph.appendChild(
              document.createElement(
                "br"
              )
            );

          }


          paragraph.appendChild(
            createInlineContent(
              paragraphLine
            )
          );

        }
      );


      container.appendChild(
        paragraph
      );

    }


    return container;

  }


  /* =========================================================
     ADD MESSAGE
  ========================================================= */

  function addMessage(
    role,
    content
  ) {

    const wrapper =
      document.createElement(
        "div"
      );

    wrapper.className =
      "aone-ai-message " +
      role;


    const bubble =
      document.createElement(
        "div"
      );

    bubble.className =
      "aone-ai-bubble";


    /*
     * USER messages remain plain text.
     *
     * AI messages are safely parsed as the
     * limited Markdown format above.
     */

    if (
      role === "assistant"
    ) {

      bubble.appendChild(
        renderMarkdown(
          content
        )
      );

    } else {

      bubble.textContent =
        content || "";

    }


    wrapper.appendChild(
      bubble
    );


    messages.appendChild(
      wrapper
    );


    scrollMessages();

  }


  /* =========================================================
     SCROLL
  ========================================================= */

  function scrollMessages() {

    messages.scrollTop =
      messages.scrollHeight;

  }


  /* =========================================================
     TYPING
  ========================================================= */

  function showTyping() {

    typing.classList.add(
      "is-visible"
    );

    scrollMessages();

  }


  function hideTyping() {

    typing.classList.remove(
      "is-visible"
    );

  }


  /* =========================================================
     SEND MESSAGE
  ========================================================= */

  async function sendMessage(
    message
  ) {

    const cleanMessage =
      message.trim();


    if (
      !cleanMessage ||
      sending
    ) {

      return;

    }


    sending = true;

    sendButton.disabled =
      true;

    input.disabled =
      true;


    addMessage(
      "user",
      cleanMessage
    );


    input.value =
      "";

    input.style.height =
      "44px";


    showTyping();


    try {

      const id =
        await createConversation();


      const response =
        await fetch(
          "/ai/conversations/" +
          encodeURIComponent(id) +
          "/messages",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",

              "Accept":
                "application/json",

              "X-CSRF-Token":
                csrfToken()
            },

            credentials:
              "same-origin",

            body:
              JSON.stringify({
                content:
                  cleanMessage,

                message:
                  cleanMessage
              })
          }
        );


      const data =
        await response
          .json()
          .catch(
            function () {
              return {};
            }
          );


      if (!response.ok) {

        console.error(
          "[A ONE AI] HTTP error:",
          response.status,
          data
        );


        throw new Error(
          data.error ||
          data.message ||
          data.content ||
          (
            "Server returned HTTP " +
            response.status
          )
        );

      }


      const answer =
        data.content ||
        data.response ||
        data.answer ||
        data.message?.content ||
        data.assistant_message?.content;


      if (!answer) {

        throw new Error(
          "A ONE AI returned an empty response."
        );

      }


      hideTyping();


      addMessage(
        "assistant",
        answer
      );


    } catch (error) {

      console.error(
        "[A ONE AI] Request failed:",
        error
      );


      hideTyping();


      addMessage(
        "assistant",
        "⚠️ A ONE AI error: " +
        error.message
      );


    } finally {

      sending =
        false;

      sendButton.disabled =
        false;

      input.disabled =
        false;

      input.focus();

    }

  }



  const supportButton =
    document.getElementById("aoneAiSupportButton");

  const supportPanel =
    document.getElementById("aoneAiSupportPanel");

  const supportClose =
    document.getElementById("aoneAiSupportClose");

  const supportForm =
    document.getElementById("aoneAiSupportForm");

  const supportCategory =
    document.getElementById("aoneAiSupportCategory");

  const supportSubject =
    document.getElementById("aoneAiSupportSubject");

  const supportDescription =
    document.getElementById("aoneAiSupportDescription");

  const supportSubmit =
    document.getElementById("aoneAiSupportSubmit");

  const supportResult =
    document.getElementById("aoneAiSupportResult");

  const supportHistory =
    document.getElementById("aoneAiSupportHistory");

  function escapeSupportHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function showSupportResult(message, type) {
    if (!supportResult) {
      return;
    }

    supportResult.hidden = false;
    supportResult.className = type || "success";
    supportResult.textContent = message || "";
  }

  function hideSupportResult() {
    if (!supportResult) {
      return;
    }

    supportResult.hidden = true;
    supportResult.className = "";
    supportResult.textContent = "";
  }

  function renderSupportHistory(items) {
    if (!supportHistory) {
      return;
    }

    if (!Array.isArray(items) || items.length === 0) {
      supportHistory.innerHTML = '<div class="aone-ai-support-empty">No support requests yet.</div>';
      return;
    }

    supportHistory.innerHTML = items.map(function (item) {
      const subject = escapeSupportHtml(item.subject || "Support Request");
      const status = escapeSupportHtml(item.status_label || item.status || "Open");
      const category = escapeSupportHtml(item.category_label || item.category || "Other");
      const created = escapeSupportHtml(item.created_at || "");
      const reply = item.admin_reply
        ? '<div class="aone-ai-support-ticket-reply"><strong>Admin:</strong> ' + escapeSupportHtml(item.admin_reply) + '</div>'
        : "";

      const chatLink = item.id
        ? '<div class="aone-ai-support-ticket-actions">' +
            '<a class="aone-ai-support-chat-link" href="/ai/support_requests/' + encodeURIComponent(item.id) + '">Open Chat →</a>' +
          '</div>'
        : "";

      return '<div class="aone-ai-support-ticket">' +
        '<div class="aone-ai-support-ticket-top">' +
          '<div class="aone-ai-support-ticket-subject">#' + escapeSupportHtml(item.id) + ' • ' + subject + '</div>' +
          '<div class="aone-ai-support-ticket-status">' + status + '</div>' +
        '</div>' +
        '<div class="aone-ai-support-ticket-meta">' + category + (created ? ' • ' + created : '') + '</div>' +
        reply +
        chatLink +
      '</div>';
    }).join("");
  }

  async function loadSupportHistory() {
    if (!supportHistory) {
      return;
    }

    supportHistory.textContent = "Loading...";

    try {
      const response = await fetch("/ai/support_requests", {
        method: "GET",
        headers: {
          "Accept": "application/json"
        },
        credentials: "same-origin"
      });

      const data = await response.json().catch(function () {
        return {};
      });

      if (!response.ok) {
        throw new Error(data.error || "Unable to load support requests.");
      }

      renderSupportHistory(data.support_requests || data.requests || data);
    } catch (error) {
      console.error("[A ONE AI] Support history failed:", error);
      supportHistory.innerHTML = '<div class="aone-ai-support-empty">Unable to load support requests.</div>';
    }
  }

  function openSupportPanel() {
    if (!supportPanel) {
      return;
    }

    supportPanel.hidden = false;
    hideSupportResult();
    loadSupportHistory();

    if (supportSubject && supportDescription && messages) {
      const lastUserMessage = messages.querySelector(".aone-ai-message.user:last-child .aone-ai-bubble");

      if (lastUserMessage) {
        const text = lastUserMessage.textContent.trim();

        if (text) {
          if (!supportSubject.value.trim()) {
            supportSubject.value = text.slice(0, 160);
          }

          if (!supportDescription.value.trim()) {
            supportDescription.value = text.slice(0, 10000);
          }
        }
      }
    }

    if (supportSubject) {
      setTimeout(function () {
        supportSubject.focus();
      }, 50);
    }
  }

  function closeSupportPanel() {
    if (supportPanel) {
      supportPanel.hidden = true;
    }

    if (supportButton) {
      supportButton.setAttribute("aria-expanded", "false");
    }
  }

  if (supportButton) {
    supportButton.type = "button";
    supportButton.setAttribute("aria-controls", "aoneAiSupportPanel");
    supportButton.setAttribute("aria-expanded", "false");

    supportButton.addEventListener("click", function (event) {
      event.preventDefault();
      event.stopPropagation();

      try {
        openChat();
      } catch (error) {
        console.error("[A ONE AI] Unable to open chat:", error);
      }

      openSupportPanel();
      supportButton.setAttribute("aria-expanded", "true");
    });
  }

  document.addEventListener("click", function (event) {
    const button = event.target.closest("#aoneAiSupportButton");

    if (!button) {
      return;
    }

    if (button === supportButton) {
      return;
    }

    event.preventDefault();
    event.stopPropagation();

    openChat();
    openSupportPanel();
    button.setAttribute("aria-expanded", "true");
  }, true);

  if (supportClose) {
    supportClose.addEventListener("click", closeSupportPanel);
  }

  if (supportForm) {
    supportForm.addEventListener("submit", async function (event) {
      event.preventDefault();

      const subject = supportSubject ? supportSubject.value.trim() : "";
      const description = supportDescription ? supportDescription.value.trim() : "";
      const category = supportCategory ? supportCategory.value : "other";

      if (!subject || !description) {
        showSupportResult("Please enter a subject and describe your requirement.", "error");
        return;
      }

      supportSubmit.disabled = true;
      supportSubmit.textContent = "Submitting...";
      hideSupportResult();

      try {
        const id = await createConversation();

        const response = await fetch("/ai/support_requests", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-CSRF-Token": csrfToken()
          },
          credentials: "same-origin",
          body: JSON.stringify({
            support_request: {
              ai_conversation_id: id,
              category: category,
              subject: subject,
              description: description
            }
          })
        });

        const data = await response.json().catch(function () {
          return {};
        });

        if (!response.ok) {
          throw new Error(data.error || "Unable to submit support request.");
        }

        const ticket = data.support_request || data.request || data;
        const ticketId = ticket.id ? "Ticket #" + ticket.id + " created successfully." : "Your support request was submitted successfully.";

        if (!ticket.id) {
          throw new Error("Support request was created but its ID was not returned.");
        }

        window.location.href =
          "/ai/support_requests/" +
          encodeURIComponent(ticket.id);
      } catch (error) {
        console.error("[A ONE AI] Support request failed:", error);
        showSupportResult(error.message || "Unable to submit support request.", "error");
      } finally {
        supportSubmit.disabled = false;
        supportSubmit.textContent = "Submit Request";
      }
    });
  }


  /* =========================================================
     FORM SUBMIT
  ========================================================= */

  form.addEventListener(
    "submit",
    function (event) {

      event.preventDefault();


      sendMessage(
        input.value
      );

    }
  );


  /* =========================================================
     ENTER TO SEND
  ========================================================= */

  input.addEventListener(
    "keydown",
    function (event) {

      if (
        event.key === "Enter" &&
        !event.shiftKey
      ) {

        event.preventDefault();

        form.requestSubmit();

      }

    }
  );


  /* =========================================================
     AUTO RESIZE TEXTAREA
  ========================================================= */

  input.addEventListener(
    "input",
    function () {

      input.style.height =
        "44px";


      input.style.height =
        Math.min(
          input.scrollHeight,
          110
        ) + "px";

    }
  );


  /* =========================================================
     QUICK QUESTIONS
  ========================================================= */

  document
    .querySelectorAll(
      "[data-ai-question]"
    )
    .forEach(
      function (button) {

        button.addEventListener(
          "click",
          function () {

            const question =
              button.getAttribute(
                "data-ai-question"
              );


            if (!question) {

              return;

            }


            openChat();


            sendMessage(
              question
            );

          }
        );

      }
    );


  /* =========================================================
     ESCAPE KEY
  ========================================================= */

  document.addEventListener(
    "keydown",
    function (event) {

      if (
        event.key === "Escape" &&
        chatWindow.classList.contains(
          "is-open"
        )
      ) {

        closeChat();

      }

    }
  );


  /* =========================================================
     TURBO SAFETY
  ========================================================= */

  if (
    window.Turbo &&
    !initialized
  ) {

    initialized =
      true;

  }

})();

</script>