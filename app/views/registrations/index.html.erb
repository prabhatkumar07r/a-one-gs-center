<% render "layouts/header" %>
<% content_for :show_layout, true %>

<div class="card shadow mb-4">
  <div class="card-body text-center">
    <h5>Total Registrations</h5>

    <h2><%= @total_students %></h2>

  </div>
</div>
<%= form_with url: registrations_path,
              method: :get,
              local: true do %>

  <%= text_field_tag :search,
        params[:search],
        placeholder: "Search Name, Email, Mobile",
        class: "form-control" %>

  <%= submit_tag "Search",
      class: "btn btn-primary mt-2" %>

<% end %>
<table class="table table-bordered table-hover">

<thead>

<tr>

<th>ID</th>
<th>Name</th>
<th>Email</th>
<th>Mobile</th>
<th>Registered</th>
<th>Action</th>

</tr>

</thead>

<tbody>

<% @students.each do |student| %>

<tr>

<td><%= student.id %></td>

<td><%= student.name %></td>

<td><%= student.email %></td>

<td><%= student.mobile %></td>

<td><%= student.created_at.strftime("%d-%m-%Y") %></td>

<td>

<%= link_to "View",
            registration_path(student),
            class:"btn btn-info btn-sm" %>

<%= link_to "Edit",
            edit_registration_path(student),
            class:"btn btn-warning btn-sm" %>

<%= button_to "Delete",
              registration_path(student),
              method: :delete,
              form: {
                data: {
                  turbo_confirm: "Delete?"
                }
              },
              class:"btn btn-danger btn-sm" %>

</td>

</tr>

<% end %>

</tbody>

</table>

<div class="mt-3 text-center">
  <%= paginate @students %>
</div>
<% render "layouts/footer" %>