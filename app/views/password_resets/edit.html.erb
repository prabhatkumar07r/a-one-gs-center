<h2>Reset Password</h2>

<%= form_with model: @user,
              url: password_reset_path(params[:id]),
              method: :patch do |f| %>

  <div>
    <%= f.label :password %><br>
    <%= f.password_field :password %>
  </div>

  <br>
  <div>
    <%= f.label :Confirm_password %> <br>
    <%= f.password_field :password %>
  </div>
  <br>

  <div>
    <%= f.submit "Update Password" %>
  </div>

<% end %>