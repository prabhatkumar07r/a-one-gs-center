
<style nonce="<%= content_security_policy_nonce %>">
  /* =========================================================
   ACHIEVEMENT FORM
========================================================= */

.achievement-form {
  width: 100%;
  max-width: 1000px;
  margin: 0 auto;
  padding-bottom: 40px;
  box-sizing: border-box;
}


/* =========================================================
   ERROR BOX
========================================================= */

.achievement-errors {
  margin-bottom: 25px;
  padding: 18px 20px;
  border: 1px solid #fecaca;
  border-radius: 14px;
  background: #fff1f2;
  color: #991b1b;
}
.status-card.selected-status {
  transform: translateY(-2px);
}
.errors-header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.errors-header > i {
  font-size: 22px;
  margin-top: 2px;
}

.errors-header strong {
  display: block;
  font-size: 16px;
  margin-bottom: 3px;
}

.errors-header span {
  display: block;
  font-size: 13px;
  color: #b91c1c;
}

.achievement-errors ul {
  margin: 14px 0 0;
  padding-left: 32px;
}

.achievement-errors li {
  margin-bottom: 5px;
  font-size: 14px;
}


/* =========================================================
   FORM SECTION
========================================================= */

.form-section {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  padding: 28px;
  margin-bottom: 24px;
  box-shadow:
    0 8px 25px rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.form-section-header {
  display: flex;
  align-items: center;
  gap: 15px;
  padding-bottom: 20px;
  margin-bottom: 22px;
  border-bottom: 1px solid #eef0f4;
}

.section-icon {
  width: 48px;
  height: 48px;
  min-width: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  background: linear-gradient(135deg, #7c3aed, #4f46e5);
  color: #ffffff;
  font-size: 21px;
  box-shadow: 0 8px 18px rgba(79, 70, 229, 0.22);
}

.form-section-header h3 {
  margin: 0 0 4px;
  font-size: 20px;
  font-weight: 750;
  color: #111827;
}

.form-section-header p {
  margin: 0;
  font-size: 13px;
  color: #6b7280;
}


/* =========================================================
   FORM GROUP
========================================================= */

.form-group {
  margin-bottom: 22px;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: inline-block;
  margin-bottom: 8px;
  color: #1f2937;
  font-size: 14px;
  font-weight: 700;
}

.required-mark {
  color: #dc2626;
  font-weight: 800;
  margin-left: 3px;
}

.achievement-form .form-control {
  width: 100%;
  min-height: 46px;
  padding: 11px 14px;
  border: 1px solid #d1d5db;
  border-radius: 10px;
  background: #ffffff;
  color: #111827;
  font-size: 14px;
  outline: none;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
  box-sizing: border-box;
}

.achievement-form textarea.form-control {
  min-height: 130px;
  resize: vertical;
  line-height: 1.6;
}

.achievement-form .form-control::placeholder {
  color: #9ca3af;
}

.achievement-form .form-control:hover {
  border-color: #a5b4fc;
}

.achievement-form .form-control:focus {
  border-color: #6366f1;
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.10);
}

.form-help {
  display: block;
  margin-top: 7px;
  color: #6b7280;
  font-size: 12px;
  line-height: 1.5;
}


/* =========================================================
   PHOTO / VIDEO UPLOAD BOX
========================================================= */

.photo-upload-box {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 22px;
  border: 1.5px dashed #c7d2fe;
  border-radius: 16px;
  background: #f8faff;
  transition:
    border-color 0.2s ease,
    background 0.2s ease,
    transform 0.2s ease;
}

.photo-upload-box:hover {
  border-color: #818cf8;
  background: #f5f7ff;
}

.upload-icon {
  width: 56px;
  height: 56px;
  min-width: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15px;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 24px;
}

.upload-content {
  flex: 1;
  min-width: 0;
}

.upload-label {
  display: block;
  margin-bottom: 9px;
  color: #1f2937;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
}

.upload-content small {
  display: block;
  margin-top: 7px;
  color: #6b7280;
  font-size: 12px;
}

.achievement-form input[type="file"] {
  cursor: pointer;
  padding: 8px;
  min-height: 44px;
}


/* =========================================================
   CURRENT PHOTO
========================================================= */

.current-photo {
  margin-top: 20px;
  padding: 18px;
  border-radius: 15px;
  border: 1px solid #e5e7eb;
  background: #fafafa;
}

.current-photo-heading {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
  color: #166534;
  font-size: 14px;
  font-weight: 750;
}

.current-photo-heading i {
  font-size: 17px;
}

.achievement-preview {
  display: block;
  width: 100%;
  max-width: 650px;
  max-height: 400px;
  object-fit: contain;
  border-radius: 12px;
  border: 1px solid #e5e7eb;
  background: #ffffff;
  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
}


/* =========================================================
   VIDEO PREVIEW
========================================================= */

.achievement-video-preview {
  display: block;
  width: 100%;
  max-width: 700px;
  max-height: 400px;
  border-radius: 14px;
  background: #000000;
  object-fit: contain;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.16);
}


/* =========================================================
   STATUS OPTIONS
========================================================= */

.status-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.status-option {
  display: block;
  cursor: pointer;
  position: relative;
}

.status-option input[type="radio"] {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.status-card {
  display: flex;
  align-items: center;
  gap: 14px;
  min-height: 86px;
  padding: 17px;
  border: 2px solid #e5e7eb;
  border-radius: 14px;
  background: #ffffff;
  transition:
    border-color 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.2s ease;
  box-sizing: border-box;
}

.status-option:hover .status-card {
  transform: translateY(-2px);
  border-color: #c7d2fe;
}

.status-option input[type="radio"]:checked + .status-card.active-status {
  border-color: #22c55e;
  background: #f0fdf4;
  box-shadow: 0 8px 20px rgba(34, 197, 94, 0.10);
}

.status-option input[type="radio"]:checked + .status-card.inactive-status {
  border-color: #ef4444;
  background: #fef2f2;
  box-shadow: 0 8px 20px rgba(239, 68, 68, 0.08);
}

.status-icon {
  width: 42px;
  height: 42px;
  min-width: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  font-size: 19px;
}

.active-status .status-icon {
  background: #dcfce7;
  color: #16a34a;
}

.inactive-status .status-icon {
  background: #fee2e2;
  color: #dc2626;
}

.status-text {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.status-text strong {
  color: #111827;
  font-size: 15px;
}

.status-text small {
  color: #6b7280;
  font-size: 12px;
  line-height: 1.4;
}


/* =========================================================
   FORM ACTIONS
========================================================= */

.achievement-form-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-top: 10px;
}

.btn-cancel,
.btn-save {
  min-height: 46px;
  padding: 11px 22px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
  box-sizing: border-box;
}

.btn-cancel {
  color: #374151;
  background: #f3f4f6;
  border: 1px solid #e5e7eb;
}

.btn-cancel:hover {
  color: #111827;
  background: #e5e7eb;
  transform: translateY(-1px);
}

.btn-save {
  min-width: 180px;
  color: #ffffff;
  background: linear-gradient(135deg, #7c3aed, #4f46e5);
  box-shadow: 0 8px 20px rgba(79, 70, 229, 0.22);
}

.btn-save:hover {
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 12px 25px rgba(79, 70, 229, 0.30);
}

.btn-save:disabled {
  opacity: 0.7;
  cursor: not-allowed;
  transform: none;
}


/* =========================================================
   VALIDATION STATE
========================================================= */

.achievement-form .form-control.field-error {
  border-color: #ef4444;
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.08);
}

.client-error {
  display: block;
  margin-top: 6px;
  color: #dc2626;
  font-size: 12px;
}


/* =========================================================
   FILE NAME
========================================================= */

.selected-file-name {
  margin-top: 8px;
  padding: 7px 10px;
  border-radius: 8px;
  background: #eef2ff;
  color: #4338ca;
  font-size: 12px;
  word-break: break-word;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

  .achievement-form {
    padding: 0 5px 30px;
  }

  .form-section {
    padding: 20px;
    border-radius: 15px;
  }

  .form-section-header {
    gap: 12px;
  }

  .section-icon {
    width: 42px;
    height: 42px;
    min-width: 42px;
    font-size: 18px;
  }

  .form-section-header h3 {
    font-size: 18px;
  }

  .status-options {
    grid-template-columns: 1fr;
  }

  .achievement-form-actions {
    flex-direction: column-reverse;
    align-items: stretch;
  }

  .btn-cancel,
  .btn-save {
    width: 100%;
  }

}

@media (max-width: 500px) {

  .form-section {
    padding: 16px;
  }

  .form-section-header {
    align-items: flex-start;
  }

  .photo-upload-box {
    flex-direction: column;
    align-items: flex-start;
    padding: 17px;
  }

  .upload-content {
    width: 100%;
  }

  .achievement-preview {
    max-height: 280px;
  }

  .achievement-video-preview {
    max-height: 260px;
  }

  .status-card {
    min-height: 78px;
  }

}




</style>

<%= form_with(model: @achievement, local: true, class: "achievement-form") do |f| %>

  <% if @achievement.errors.any? %>
    <div class="achievement-errors">
      <div class="errors-header">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
          <strong>
            Please fix the following errors
          </strong>
          <span>
            <%= pluralize(@achievement.errors.count, "error") %>
            prevented this achievement from being saved.
          </span>
        </div>
      </div>

      <ul>
        <% @achievement.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>


  <!-- =====================================================
       ACHIEVEMENT INFORMATION
  ====================================================== -->

  <div class="form-section">

    <div class="form-section-header">
      <div class="section-icon">
        <i class="bi bi-trophy-fill"></i>
      </div>

      <div>
        <h3>Achievement Information</h3>
        <p>
          Add the main details of the achievement.
        </p>
      </div>
    </div>


    <!-- Title -->

    <div class="form-group">

      <%= f.label :title, "Achievement Title", class: "form-label" %>

      <span class="required-mark">*</span>

      <%= f.text_field :title,
          class: "form-control",
          placeholder: "e.g. SNS Vidyapeeth द्वारा सम्मानित",
          required: true,
          maxlength: 150 %>

      <small class="form-help">
        Enter a clear and professional title for the achievement.
      </small>

    </div>


    <!-- Student Name -->

    <div class="form-group">

      <%= f.label :student_name, "Student / Recipient Name",
          class: "form-label" %>

      <span class="required-mark">*</span>

      <%= f.text_field :student_name,
          class: "form-control",
          placeholder: "e.g. Rahul Kumar",
          required: true,
          maxlength: 100 %>

      <small class="form-help">
        Enter the name of the student or person receiving the achievement.
      </small>

    </div>


    <!-- Rank -->

    <div class="form-group">

      <%= f.label :rank, "Rank / Recognition", class: "form-label" %>

      <%= f.text_field :rank,
          class: "form-control",
          placeholder: "e.g. District Topper / 1st Rank / Excellence Award",
          maxlength: 150 %>

      <small class="form-help">
        You can mention rank, award, recognition, or achievement type.
      </small>

    </div>


    <!-- Year -->

    <div class="form-group">

      <%= f.label :year, "Achievement Year", class: "form-label" %>

      <%= f.number_field :year,
          class: "form-control",
          placeholder: "e.g. 2026",
          min: 2000,
          max: 2100 %>

      <small class="form-help">
        Enter the year in which the achievement was received.
      </small>

    </div>


    <!-- Description -->

    <div class="form-group">

      <%= f.label :description, "Achievement Description",
          class: "form-label" %>

      <%= f.text_area :description,
          class: "form-control achievement-description",
          rows: 5,
          placeholder: "Write a short description about this achievement...",
          maxlength: 500 %>

      <small class="form-help">
        Keep the description short, professional, and easy to understand.
      </small>

    </div>

  </div>


  <!-- =====================================================
       ACHIEVEMENT PHOTO
  ====================================================== -->

  <div class="form-section">

    <div class="form-section-header">

      <div class="section-icon">
        <i class="bi bi-image-fill"></i>
      </div>

      <div>
        <h3>Achievement Photo</h3>
        <p>
          Upload a photo, certificate, award, or achievement image.
        </p>
      </div>

    </div>


    <div class="photo-upload-box">

      <div class="upload-icon">
        <i class="bi bi-cloud-arrow-up-fill"></i>
      </div>

      <div class="upload-content">

        <%= f.label :photo,
            "Choose Achievement Photo",
            class: "upload-label" %>

        <%= f.file_field :photo,
            class: "form-control",
            accept: "image/png,image/jpeg,image/jpg,image/webp" %>

        <small>
          Recommended: JPG, PNG or WebP.
        </small>

      </div>

    </div>


    <% if @achievement.photo.attached? %>

      <div class="current-photo">

        <div class="current-photo-heading">
          <i class="bi bi-check-circle-fill"></i>
          Current Photo
        </div>

        <%= image_tag @achievement.photo,
            class: "achievement-preview",
            alt: @achievement.title.presence || "Achievement Photo" %>

      </div>

    <% end %>

  </div>
  <!-- =====================================================
     ACHIEVEMENT VIDEO
====================================================== -->

<div class="form-section">

  <div class="form-section-header">

    <div class="section-icon">
      <i class="bi bi-play-circle-fill"></i>
    </div>

    <div>
      <h3>Achievement Video</h3>
      <p>
        Upload a success story, felicitation video, or achievement video.
      </p>
    </div>

  </div>


  <div class="photo-upload-box">

    <div class="upload-icon">
      <i class="bi bi-camera-video-fill"></i>
    </div>

    <div class="upload-content">

      <%= f.label :video,
          "Choose Achievement Video",
          class: "upload-label" %>

      <%= f.file_field :video,
          class: "form-control",
          accept: "video/mp4,video/webm,video/ogg" %>

      <small>
        Recommended: MP4, WebM or OGG.
      </small>

    </div>

  </div>


  <% if @achievement.video.attached? %>

    <div class="current-photo">

      <div class="current-photo-heading">
        <i class="bi bi-check-circle-fill"></i>
        Current Video
      </div>

      <video
        class="achievement-video-preview"
        controls
        preload="metadata">

        <source
          src="<%= url_for(@achievement.video) %>"
          type="<%= @achievement.video.content_type %>">

        Your browser does not support video playback.

      </video>

    </div>

  <% end %>

</div>

  <!-- =====================================================
       PUBLICATION STATUS
  ====================================================== -->

  <div class="form-section">

    <div class="form-section-header">

      <div class="section-icon">
        <i class="bi bi-eye-fill"></i>
      </div>

      <div>
        <h3>Publication Status</h3>
        <p>
          Control whether this achievement appears on the website.
        </p>
      </div>

    </div>

<div class="status-options">

  <label class="status-option">

    <%= f.radio_button :status,
        true,
        checked: (@achievement.status != false) %>

    <span class="status-card active-status">

      <span class="status-icon">
        <i class="bi bi-check-circle-fill"></i>
      </span>

      <span class="status-text">
        <strong>Active</strong>
        <small>
          Show this achievement on the homepage.
        </small>
      </span>

    </span>

  </label>


  <label class="status-option">

    <%= f.radio_button :status,
        false,
        checked: (@achievement.status == false) %>

    <span class="status-card inactive-status">

      <span class="status-icon">
        <i class="bi bi-eye-slash-fill"></i>
      </span>

      <span class="status-text">
        <strong>Inactive</strong>
        <small>
          Keep this achievement hidden from the homepage.
        </small>
      </span>

    </span>

  </label>

</div>
  <!-- =====================================================
       FORM ACTIONS
  ====================================================== -->

  <div class="achievement-form-actions">

    <%= link_to achievements_path,
        class: "btn-cancel" do %>

      <i class="bi bi-arrow-left"></i>
      Cancel

    <% end %>


    <%= f.submit(
          @achievement.persisted? ?
          "Update Achievement" :
          "Add Achievement",
          class: "btn-save"
        ) %>

  </div>


<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  function initializeAchievementForm() {

    const form = document.querySelector(".achievement-form");

    if (!form || form.dataset.initialized === "true") {
      return;
    }

    form.dataset.initialized = "true";


    /* =====================================================
       ELEMENTS
    ====================================================== */

    const titleInput =
      form.querySelector('[name="achievement[title]"]');

    const studentInput =
      form.querySelector('[name="achievement[student_name]"]');

    const descriptionInput =
      form.querySelector('[name="achievement[description]"]');

    const photoInput =
      form.querySelector('[name="achievement[photo]"]');

    const videoInput =
      form.querySelector('[name="achievement[video]"]');

    const submitButton =
      form.querySelector(
        'input[type="submit"], button[type="submit"]'
      );


    /* =====================================================
       TITLE / STUDENT NAME CLEANUP
    ====================================================== */

    [titleInput, studentInput].forEach(function (input) {

      if (!input) {
        return;
      }

      input.addEventListener("input", function () {

        input.value = input.value
          .replace(/\s+/g, " ")
          .replace(/^\s+/, "");

      });

    });


    /* =====================================================
       DESCRIPTION CHARACTER COUNTER
    ====================================================== */

    if (descriptionInput) {

      const maxLength =
        parseInt(
          descriptionInput.getAttribute("maxlength") || "500",
          10
        );

      let counter =
        descriptionInput.parentNode.querySelector(
          ".description-counter"
        );

      if (!counter) {

        counter = document.createElement("small");

        counter.className =
          "form-help description-counter";

        descriptionInput.parentNode.appendChild(counter);

      }


      function updateCounter() {

        const currentLength =
          descriptionInput.value.length;

        counter.textContent =
          currentLength +
          " / " +
          maxLength +
          " characters";

      }


      descriptionInput.addEventListener(
        "input",
        updateCounter
      );

      updateCounter();

    }


    /* =====================================================
       PHOTO VALIDATION + PREVIEW
    ====================================================== */

    if (photoInput) {

      photoInput.addEventListener("change", function () {

        const file = photoInput.files[0];

        if (!file) {
          return;
        }


        const allowedTypes = [
          "image/jpeg",
          "image/png",
          "image/webp"
        ];


        if (!allowedTypes.includes(file.type)) {

          alert(
            "Please select a JPG, PNG, or WebP image."
          );

          photoInput.value = "";

          return;
        }


        const maxSize =
          5 * 1024 * 1024;


        if (file.size > maxSize) {

          alert(
            "Image size must be 5 MB or smaller."
          );

          photoInput.value = "";

          return;
        }


        showSelectedFileName(
          photoInput,
          file
        );

        previewImage(
          photoInput,
          file
        );

      });

    }


    /* =====================================================
       VIDEO VALIDATION + PREVIEW
    ====================================================== */

    if (videoInput) {

      videoInput.addEventListener("change", function () {

        const file = videoInput.files[0];

        if (!file) {
          return;
        }


        const allowedTypes = [
          "video/mp4",
          "video/webm",
          "video/ogg"
        ];


        if (!allowedTypes.includes(file.type)) {

          alert(
            "Please select an MP4, WebM, or OGG video."
          );

          videoInput.value = "";

          return;
        }


        const maxSize =
          100 * 1024 * 1024;


        if (file.size > maxSize) {

          alert(
            "Video size must be 100 MB or smaller."
          );

          videoInput.value = "";

          return;
        }


        showSelectedFileName(
          videoInput,
          file
        );

        previewVideo(
          videoInput,
          file
        );

      });

    }


    /* =====================================================
       FILE NAME
    ====================================================== */

    function showSelectedFileName(input, file) {

      const container =
        input.closest(".upload-content");

      if (!container) {
        return;
      }


      let fileName =
        container.querySelector(".selected-file-name");


      if (!fileName) {

        fileName =
          document.createElement("div");

        fileName.className =
          "selected-file-name";

        container.appendChild(fileName);

      }


      const sizeMB =
        (file.size / (1024 * 1024)).toFixed(2);


      fileName.textContent =
        "Selected: " +
        file.name +
        " (" +
        sizeMB +
        " MB)";

    }


    /* =====================================================
       IMAGE PREVIEW
    ====================================================== */

    function previewImage(input, file) {

      const section =
        input.closest(".form-section");

      if (!section) {
        return;
      }


      let previewBox =
        section.querySelector(".new-photo-preview");


      if (!previewBox) {

        previewBox =
          document.createElement("div");

        previewBox.className =
          "current-photo new-photo-preview";

        section.appendChild(previewBox);

      }


      const reader =
        new FileReader();


      reader.onload = function (event) {

        previewBox.innerHTML = `
          <div class="current-photo-heading">
            <i class="bi bi-eye-fill"></i>
            New Photo Preview
          </div>

          <img
            src="${event.target.result}"
            class="achievement-preview"
            alt="New Achievement Photo Preview">
        `;

      };


      reader.readAsDataURL(file);

    }


    /* =====================================================
       VIDEO PREVIEW
    ====================================================== */

    function previewVideo(input, file) {

      const section =
        input.closest(".form-section");

      if (!section) {
        return;
      }


      let previewBox =
        section.querySelector(".new-video-preview");


      if (!previewBox) {

        previewBox =
          document.createElement("div");

        previewBox.className =
          "current-photo new-video-preview";

        section.appendChild(previewBox);

      }


      const videoURL =
        URL.createObjectURL(file);


      previewBox.innerHTML = `

        <div class="current-photo-heading">
          <i class="bi bi-eye-fill"></i>
          New Video Preview
        </div>

        <video
          class="achievement-video-preview"
          controls
          preload="metadata">

          <source
            src="${videoURL}"
            type="${file.type}">

          Your browser does not support video playback.

        </video>

      `;

    }


    /* =====================================================
       STATUS CARD
    ====================================================== */

    const statusInputs =
      form.querySelectorAll(
        'input[name="achievement[status]"]'
      );


    statusInputs.forEach(function (radio) {

      radio.addEventListener("change", function () {

        statusInputs.forEach(function (item) {

          const card =
            item.nextElementSibling;

          if (!card) {
            return;
          }

          card.classList.remove(
            "selected-status"
          );

        });


        const selectedCard =
          radio.nextElementSibling;


        if (selectedCard) {

          selectedCard.classList.add(
            "selected-status"
          );

        }

      });

    });


    /* =====================================================
       FORM SUBMIT
    ====================================================== */

    form.addEventListener("submit", function (event) {

      if (form.dataset.submitting === "true") {

        event.preventDefault();

        return;
      }


      form.dataset.submitting = "true";


      if (submitButton) {

        submitButton.disabled = true;


        if (
          submitButton.tagName.toLowerCase() === "input"
        ) {

          submitButton.dataset.originalValue =
            submitButton.value;

          submitButton.value =
            "Saving Achievement...";

        } else {

          submitButton.dataset.originalHTML =
            submitButton.innerHTML;

          submitButton.innerHTML =
            '<i class="bi bi-hourglass-split"></i> Saving Achievement...';

        }

      }

    });


    /* =====================================================
       STATUS INITIAL STATE
    ====================================================== */

    const checkedStatus =
      form.querySelector(
        'input[name="achievement[status]"]:checked'
      );


    if (checkedStatus) {

      const selectedCard =
        checkedStatus.nextElementSibling;

      if (selectedCard) {

        selectedCard.classList.add(
          "selected-status"
        );

      }

    }

  }


  /* =======================================================
     NORMAL PAGE LOAD
  ======================================================== */

  document.addEventListener(
    "DOMContentLoaded",
    initializeAchievementForm
  );


  /* =======================================================
     TURBO PAGE LOAD
  ======================================================== */

  document.addEventListener(
    "turbo:load",
    initializeAchievementForm
  );
</script>