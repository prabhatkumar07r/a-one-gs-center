<% content_for :show_layout, true %>
<% content_for :hide_footer, true %>

<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   A ONE GS CENTER
   QUIZ RESULT + LEADERBOARD
========================================================= */

.quiz-result-page {
  min-height: 100vh;

  padding:
    105px
    20px
    70px;

  background:
    radial-gradient(
      circle at top right,
      rgba(124, 58, 237, .10),
      transparent 32%
    ),
    radial-gradient(
      circle at bottom left,
      rgba(37, 99, 235, .08),
      transparent 32%
    ),
    #f6f8fc;

  color: #1e293b;

  box-sizing: border-box;
}


/* =========================================================
   CONTAINER
========================================================= */

.result-container {
  width: 100%;
  max-width: 1250px;

  margin: 0 auto;
}


/* =========================================================
   TOP HEADER
========================================================= */

.result-topbar {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

  margin-bottom: 22px;
}

.result-title-area {
  min-width: 0;
}

.result-eyebrow {
  display: inline-flex;

  align-items: center;

  gap: 7px;

  color: #7c3aed;

  font-size: 12px;

  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: .7px;

  margin-bottom: 6px;
}

.result-eyebrow i {
  font-size: 12px;
}

.result-title-area h1 {
  margin: 0;

  color: #111827;

  font-size: 27px;

  font-weight: 850;

  line-height: 1.25;
}

.result-title-area p {
  margin: 6px 0 0;

  color: #64748b;

  font-size: 13px;
}


/* =========================================================
   BACK BUTTON
========================================================= */

.result-back-btn {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  flex-shrink: 0;

  padding: 10px 16px;

  border-radius: 10px;

  background: #ffffff;

  border: 1px solid #e2e8f0;

  color: #475569 !important;

  text-decoration: none !important;

  font-size: 13px;

  font-weight: 750;

  transition: .2s ease;
}

.result-back-btn:hover {
  background: #f5f3ff;

  border-color: #ddd6fe;

  color: #6d28d9 !important;

  transform: translateX(-2px);
}


/* =========================================================
   MAIN CARD
========================================================= */

.result-main-card {
  background: #ffffff;

  border: 1px solid #e2e8f0;

  border-radius: 22px;

  overflow: hidden;

  box-shadow:
    0 12px 35px rgba(15, 23, 42, .07);
}


/* =========================================================
   TABS
========================================================= */

.result-tabs {
  display: flex;

  align-items: center;

  gap: 8px;

  padding: 12px;

  background:
    linear-gradient(
      135deg,
      #faf8ff,
      #f6f8ff
    );

  border-bottom: 1px solid #e5e7eb;
}

.result-tab {
  flex: 1;

  min-height: 46px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  border: 1px solid transparent;

  border-radius: 11px;

  background: transparent;

  color: #64748b;

  font-size: 13px;

  font-weight: 850;

  cursor: pointer;

  transition:
    background .2s ease,
    color .2s ease,
    border-color .2s ease,
    box-shadow .2s ease,
    transform .2s ease;
}

.result-tab i {
  font-size: 14px;
}

.result-tab:hover {
  background: #ffffff;

  color: #6d28d9;
}

.result-tab.active {
  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #4f46e5
    );

  color: #ffffff;

  border-color: transparent;

  box-shadow:
    0 7px 18px rgba(109, 40, 217, .22);
}

.result-tab.active:hover {
  color: #ffffff;
}


/* =========================================================
   TAB CONTENT
========================================================= */

.result-tab-content {
  display: none;
}

.result-tab-content.active {
  display: block;
}


/* =========================================================
   RESULT HERO
========================================================= */

.result-hero {
  position: relative;

  padding: 38px 35px 35px;

  text-align: center;

  background:
    linear-gradient(
      135deg,
      #faf8ff,
      #f4f7ff
    );

  border-bottom: 1px solid #e5e7eb;
}

.result-hero::before {
  content: "";

  position: absolute;

  width: 180px;

  height: 180px;

  border-radius: 50%;

  background: rgba(124, 58, 237, .06);

  top: -100px;

  left: -70px;
}

.result-hero::after {
  content: "";

  position: absolute;

  width: 170px;

  height: 170px;

  border-radius: 50%;

  background: rgba(37, 99, 235, .05);

  bottom: -110px;

  right: -70px;
}


/* =========================================================
   RESULT ICON
========================================================= */

.result-icon {
  position: relative;

  z-index: 2;

  width: 68px;

  height: 68px;

  margin: 0 auto 15px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      #6d28d9,
      #4f46e5
    );

  color: #ffffff;

  font-size: 28px;

  box-shadow:
    0 10px 25px rgba(109, 40, 217, .22);
}


/* =========================================================
   HERO TITLE
========================================================= */

.result-hero h2 {
  position: relative;

  z-index: 2;

  margin: 0;

  color: #111827;

  font-size: 28px;

  font-weight: 850;

  line-height: 1.3;
}

.result-hero-subtitle {
  position: relative;

  z-index: 2;

  margin: 7px 0 18px;

  color: #64748b;

  font-size: 14px;
}


/* =========================================================
   PASS / FAIL
========================================================= */

.result-status {
  position: relative;

  z-index: 2;

  display: inline-flex;

  align-items: center;

  gap: 7px;

  padding: 9px 18px;

  border-radius: 30px;

  font-size: 13px;

  font-weight: 850;

  text-transform: uppercase;

  letter-spacing: .5px;
}

.result-status.passed {
  background: #dcfce7;

  border: 1px solid #bbf7d0;

  color: #15803d;
}

.result-status.failed {
  background: #fee2e2;

  border: 1px solid #fecaca;

  color: #b91c1c;
}


/* =========================================================
   SCORE
========================================================= */

.score-area {
  display: flex;

  justify-content: center;

  padding: 32px 25px 30px;
}

.score-box {
  width: 175px;

  height: 175px;

  border-radius: 50%;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f8f7ff
    );

  border: 10px solid #ede9fe;

  box-shadow:
    0 10px 30px rgba(79, 70, 229, .10),
    inset 0 0 20px rgba(109, 40, 217, .03);
}

.score-value {
  color: #312e81;

  font-size: 40px;

  font-weight: 900;

  line-height: 1;
}

.score-label {
  margin-top: 8px;

  color: #64748b;

  font-size: 12px;

  font-weight: 700;

  text-transform: uppercase;

  letter-spacing: .5px;
}


/* =========================================================
   STATISTICS
========================================================= */

.result-stat-grid {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 14px;

  padding: 0 30px 30px;
}

.result-stat {
  padding: 18px 15px;

  text-align: center;

  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      #f8fafc,
      #f5f3ff
    );

  border: 1px solid #e2e8f0;

  transition: .2s ease;
}

.result-stat:hover {
  transform: translateY(-2px);

  box-shadow:
    0 8px 20px rgba(15, 23, 42, .06);
}

.result-stat-icon {
  width: 34px;

  height: 34px;

  margin: 0 auto 8px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 9px;

  background: #ede9fe;

  color: #6d28d9;

  font-size: 14px;
}

.result-stat strong {
  display: block;

  color: #111827;

  font-size: 22px;

  font-weight: 850;

  line-height: 1.2;
}

.result-stat span {
  display: block;

  margin-top: 5px;

  color: #64748b;

  font-size: 11px;

  font-weight: 700;

  text-transform: uppercase;

  letter-spacing: .4px;
}


/* =========================================================
   ANSWER SUMMARY
========================================================= */

.answer-summary {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 14px;

  padding: 0 30px 30px;
}

.answer-summary-box {
  display: flex;

  align-items: center;

  gap: 13px;

  padding: 15px 17px;

  border-radius: 13px;

  border: 1px solid #e2e8f0;

  background: #ffffff;
}

.answer-summary-icon {
  width: 38px;

  height: 38px;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 10px;

  font-size: 15px;
}

.answer-summary-icon.green {
  background: #dcfce7;

  color: #15803d;
}

.answer-summary-icon.orange {
  background: #fef3c7;

  color: #b45309;
}

.answer-summary-icon.blue {
  background: #dbeafe;

  color: #2563eb;
}

.answer-summary-text strong {
  display: block;

  color: #1e293b;

  font-size: 16px;

  font-weight: 850;
}

.answer-summary-text span {
  display: block;

  margin-top: 2px;

  color: #64748b;

  font-size: 11px;

  font-weight: 600;
}


/* =========================================================
   REVIEW SECTION
========================================================= */

.review-section {
  border-top: 1px solid #e5e7eb;

  padding: 30px;
}

.review-header {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  margin-bottom: 20px;
}

.review-title {
  display: flex;

  align-items: center;

  gap: 10px;
}

.review-title-icon {
  width: 38px;

  height: 38px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 10px;

  background: #ede9fe;

  color: #6d28d9;
}

.review-title h3 {
  margin: 0;

  color: #111827;

  font-size: 21px;

  font-weight: 850;
}

.review-count {
  padding: 7px 12px;

  border-radius: 20px;

  background: #f8fafc;

  border: 1px solid #e2e8f0;

  color: #64748b;

  font-size: 12px;

  font-weight: 700;
}


/* =========================================================
   ANSWER CARD
========================================================= */

.answer-review-card {
  margin-bottom: 14px;

  padding: 20px;

  border: 1px solid #e2e8f0;

  border-radius: 15px;

  background: #ffffff;

  transition: .2s ease;
}

.answer-review-card:hover {
  border-color: #c4b5fd;

  box-shadow:
    0 8px 25px rgba(79, 70, 229, .07);
}

.answer-review-card:last-child {
  margin-bottom: 0;
}


/* =========================================================
   ANSWER TOP
========================================================= */

.answer-review-top {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  margin-bottom: 14px;
}

.answer-question-number {
  display: inline-flex;

  align-items: center;

  gap: 8px;

  color: #64748b;

  font-size: 12px;

  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: .4px;
}

.question-number-badge {
  width: 31px;

  height: 31px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 8px;

  background: #ede9fe;

  color: #6d28d9;

  font-size: 13px;

  font-weight: 850;
}


/* =========================================================
   ANSWER STATUS
========================================================= */

.answer-status {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  padding: 6px 11px;

  border-radius: 20px;

  font-size: 11px;

  font-weight: 800;
}

.answer-status.correct {
  background: #dcfce7;

  color: #15803d;
}

.answer-status.incorrect {
  background: #fee2e2;

  color: #b91c1c;
}

.answer-status.unanswered {
  background: #fef3c7;

  color: #b45309;
}


/* =========================================================
   QUESTION
========================================================= */

.answer-review-question {
  margin-bottom: 15px;

  color: #1e293b;

  font-size: 16px;

  font-weight: 750;

  line-height: 1.6;
}


/* =========================================================
   ANSWER ROWS
========================================================= */

.answer-row {
  display: flex;

  align-items: flex-start;

  gap: 10px;

  padding: 12px 14px;

  margin-top: 8px;

  border-radius: 10px;

  background: #f8fafc;

  border: 1px solid #eef2f7;

  font-size: 13px;

  line-height: 1.55;
}

.answer-row.correct-answer-row {
  background: #ecfdf5;

  border-color: #bbf7d0;
}

.answer-row.unanswered-row {
  background: #fffbeb;

  border-color: #fde68a;
}

.answer-row-icon {
  width: 25px;

  height: 25px;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 7px;

  background: #e2e8f0;

  color: #64748b;

  font-size: 11px;
}

.correct-answer-row .answer-row-icon {
  background: #dcfce7;

  color: #15803d;
}

.unanswered-row .answer-row-icon {
  background: #fef3c7;

  color: #b45309;
}

.answer-row-content {
  flex: 1;

  min-width: 0;
}

.answer-row-content strong {
  color: #334155;

  font-weight: 800;
}

.answer-row-content span {
  color: #475569;
}


/* =========================================================
   ACTIONS
========================================================= */

.result-actions {
  display: flex;

  align-items: center;

  justify-content: center;

  gap: 12px;

  flex-wrap: wrap;

  padding:
    25px
    30px
    30px;

  border-top: 1px solid #e5e7eb;

  background: #fafbff;
}

.result-action-btn {
  min-height: 45px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  padding: 11px 20px;

  border-radius: 10px;

  text-decoration: none !important;

  font-size: 13px;

  font-weight: 800;

  border: 1px solid transparent;

  cursor: pointer;

  transition: .2s ease;
}

.result-action-btn:hover {
  transform: translateY(-2px);

  box-shadow:
    0 8px 18px rgba(15, 23, 42, .10);
}

.result-action-primary {
  background:
    linear-gradient(
      135deg,
      #2563eb,
      #6d28d9
    );

  color: #ffffff !important;
}

.result-action-primary:hover {
  color: #ffffff !important;
}

.result-action-secondary {
  background: #ffffff;

  border-color: #dbe2ea;

  color: #475569 !important;
}

.result-action-secondary:hover {
  background: #f8fafc;

  color: #334155 !important;
}


/* =========================================================
   LEADERBOARD
========================================================= */

#leaderboardTab {
  background:
    radial-gradient(
      circle at 8% 5%,
      rgba(255, 255, 255, .13),
      transparent 25%
    ),
    radial-gradient(
      circle at 92% 90%,
      rgba(255, 255, 255, .08),
      transparent 25%
    ),
    linear-gradient(
      135deg,
      #c218d8 0%,
      #a000c8 35%,
      #78008d 68%,
      #4d005f 100%
    );

  color: #ffffff;
}


/* =========================================================
   LEADERBOARD SECTION
========================================================= */

.leaderboard-section {
  padding:
    38px
    30px
    45px;
}


/* =========================================================
   A ONE GS CENTER LOGO / BRAND
========================================================= */

.leaderboard-brand {
  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  margin-bottom: 25px;

  text-align: center;
}

.leaderboard-brand-icon {
  width: 76px;

  height: 76px;

  display: flex;

  align-items: center;

  justify-content: center;

  margin-bottom: 10px;

  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f0d6ff
    );

  color: #78008e;

  font-size: 34px;

  box-shadow:
    0 12px 30px rgba(40, 0, 55, .30);

  border: 4px solid rgba(255,255,255,.30);
}

.leaderboard-brand-name {
  margin: 0;

  color: #ffffff;

  font-size: 17px;

  font-weight: 950;

  letter-spacing: 1.4px;

  text-transform: uppercase;
}

.leaderboard-brand-subtitle {
  margin-top: 4px;

  color: rgba(255,255,255,.72);

  font-size: 10px;

  font-weight: 700;

  letter-spacing: 1px;

  text-transform: uppercase;
}


/* =========================================================
   LEADERBOARD HEADER
========================================================= */

.leaderboard-heading {
  text-align: center;

  margin-bottom: 35px;
}

.leaderboard-heading-icon {
  width: 58px;

  height: 58px;

  margin: 0 auto 12px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 17px;

  background:
    rgba(255,255,255,.16);

  color: #ffffff;

  font-size: 24px;

  border:
    1px solid
    rgba(255,255,255,.22);

  box-shadow:
    0 10px 25px rgba(50,0,70,.18);
}

.leaderboard-heading h2 {
  margin: 0;

  color: #ffffff;

  font-size: 29px;

  font-weight: 900;
}

.leaderboard-heading p {
  margin: 7px 0 0;

  color: rgba(255,255,255,.76);

  font-size: 13px;
}


/* =========================================================
   PODIUM
========================================================= */

.podium {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  align-items: end;

  gap: 18px;

  max-width: 950px;

  margin: 0 auto 45px;
}


/* =========================================================
   TOP 3 LEADER CARDS
========================================================= */

.leader-card {
  position: relative;

  padding:
    26px
    20px
    23px;

  text-align: center;

  border-radius: 20px;

  border:
    1px solid
    rgba(255,255,255,.20);

  background:
    linear-gradient(
      145deg,
      #a000c8 0%,
      #7b008f 55%,
      #5a006f 100%
    );

  box-shadow:
    0 14px 32px rgba(65,0,80,.30);

  color: #ffffff;

  transition:
    transform .25s ease,
    box-shadow .25s ease;
}

.leader-card:hover {
  transform: translateY(-5px);

  box-shadow:
    0 20px 40px rgba(45,0,60,.40);
}


/* =========================================================
   FIRST PLACE
========================================================= */

.leader-card.first {
  padding-top: 34px;

  border-color:
    rgba(255,255,255,.40);

  background:
    linear-gradient(
      145deg,
      #c218d8 0%,
      #9c00bd 48%,
      #680078 100%
    );

  box-shadow:
    0 20px 45px rgba(55,0,75,.38);
}

.leader-card.first:hover {
  transform: translateY(-8px);

  box-shadow:
    0 25px 50px rgba(45,0,65,.45);
}


/* =========================================================
   SECOND / THIRD
========================================================= */

.leader-card.second,
.leader-card.third {
  background:
    linear-gradient(
      145deg,
      #a800c9 0%,
      #81008f 50%,
      #59006c 100%
    );
}

.leader-card.second {
  margin-top: 30px;
}

.leader-card.third {
  margin-top: 30px;
}


/* =========================================================
   RANK BADGE
========================================================= */

.leader-rank {
  position: absolute;

  top: 14px;

  left: 50%;

  transform: translateX(-50%);

  min-width: 43px;

  height: 28px;

  padding: 0 9px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  border-radius: 20px;

  background:
    rgba(255,255,255,.18);

  color: #ffffff;

  border:
    1px solid
    rgba(255,255,255,.18);

  font-size: 11px;

  font-weight: 900;
}

.leader-card.first .leader-rank {
  background: #ffffff;

  color: #85009e;
}


/* =========================================================
   STUDENT AVATAR
========================================================= */

.leader-avatar {
  width: 82px;

  height: 82px;

  margin:
    15px
    auto
    13px;

  display: flex;

  align-items: center;

  justify-content: center;

  overflow: hidden;

  padding: 0;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.25),
      rgba(255,255,255,.10)
    );

  border:
    5px solid
    rgba(255,255,255,.45);

  box-shadow:
    0 7px 20px rgba(15,23,42,.18);

  color: #ffffff;

  font-size: 26px;

  font-weight: 900;
}

.leader-card.first .leader-avatar {
  width: 96px;

  height: 96px;

  background:
    linear-gradient(
      135deg,
      #ffffff,
      #f0d6ff
    );

  color: #78008e;

  font-size: 30px;

  box-shadow:
    0 10px 25px rgba(40,0,60,.25);
}


/* =========================================================
   STUDENT PHOTO
========================================================= */

.leader-avatar-image {
  width: 100%;

  height: 100%;

  display: block;

  object-fit: cover;

  object-position: center;
}


/* =========================================================
   STUDENT NAME
========================================================= */

.leader-name {
  margin: 0;

  color: #ffffff;

  font-size: 17px;

  font-weight: 900;

  line-height: 1.3;
}

.leader-card.first .leader-name {
  font-size: 20px;
}


/* =========================================================
   SCORE
========================================================= */

.leader-score {
  margin-top: 12px;

  color: #ffffff;

  font-size: 27px;

  font-weight: 900;

  line-height: 1;
}

.leader-score-label {
  margin-top: 5px;

  color:
    rgba(255,255,255,.70);

  font-size: 10px;

  font-weight: 750;

  text-transform: uppercase;

  letter-spacing: .5px;
}


/* =========================================================
   PERCENTAGE
========================================================= */

.leader-percentage {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  margin-top: 13px;

  padding: 7px 13px;

  border-radius: 20px;

  background:
    rgba(255,255,255,.16);

  color: #ffffff;

  border:
    1px solid
    rgba(255,255,255,.20);

  font-size: 12px;

  font-weight: 850;
}


/* =========================================================
   ATTEMPTS
========================================================= */

.leader-attempts {
  margin-top: 13px;

  color:
    rgba(255,255,255,.72);

  font-size: 11px;

  font-weight: 700;
}

.leader-attempts i {
  margin-right: 4px;

  color: #f1c7ff;
}


/* =========================================================
   OTHER PARTICIPANTS
========================================================= */

.other-participants {
  margin-top: 10px;
}

.other-heading {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  margin-bottom: 15px;
}

.other-heading h3 {
  margin: 0;

  color: #ffffff;

  font-size: 20px;

  font-weight: 900;
}

.other-heading span {
  padding: 6px 11px;

  border-radius: 20px;

  background:
    rgba(255,255,255,.12);

  border:
    1px solid
    rgba(255,255,255,.20);

  color:
    rgba(255,255,255,.80);

  font-size: 11px;

  font-weight: 750;
}


/* =========================================================
   TABLE WRAPPER
========================================================= */

.leader-table-wrapper {
  overflow-x: auto;

  border:
    1px solid
    rgba(255,255,255,.20);

  border-radius: 15px;

  background:
    rgba(255,255,255,.10);

  box-shadow:
    0 12px 30px rgba(45,0,60,.20);
}


/* =========================================================
   TABLE
========================================================= */

.leader-table {
  width: 100%;

  border-collapse: collapse;

  min-width: 650px;
}

.leader-table th {
  padding: 13px 15px;

  text-align: left;

  background:
    rgba(255,255,255,.13);

  border-bottom:
    1px solid
    rgba(255,255,255,.18);

  color:
    rgba(255,255,255,.80);

  font-size: 10px;

  font-weight: 850;

  text-transform: uppercase;

  letter-spacing: .5px;
}

.leader-table td {
  padding: 14px 15px;

  border-bottom:
    1px solid
    rgba(255,255,255,.12);

  color: #ffffff;

  font-size: 13px;

  font-weight: 650;
}

.leader-table tr:last-child td {
  border-bottom: 0;
}

.leader-table tbody tr {
  transition:
    background .2s ease;
}

.leader-table tbody tr:hover {
  background:
    rgba(255,255,255,.08);
}


/* =========================================================
   TABLE RANK
========================================================= */

.table-rank {
  width: 45px;

  color: #ffffff !important;

  font-weight: 900 !important;
}


/* =========================================================
   TABLE STUDENT
========================================================= */

.table-student {
  display: flex;

  align-items: center;

  gap: 10px;
}

.table-avatar {
  width: 36px;

  height: 36px;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  overflow: hidden;

  border-radius: 50%;

  background:
    rgba(255,255,255,.16);

  border:
    1px solid
    rgba(255,255,255,.20);

  color: #ffffff;

  font-size: 11px;

  font-weight: 900;
}

.table-avatar-image {
  width: 100%;

  height: 100%;

  display: block;

  object-fit: cover;

  object-position: center;
}

.table-student-name {
  color: #ffffff;

  font-weight: 800;
}


/* =========================================================
   SCORE / ACCURACY
========================================================= */

.table-score {
  color: #ffffff !important;

  font-weight: 850 !important;
}

.table-percentage {
  color: #f1c7ff !important;

  font-weight: 850 !important;
}


/* =========================================================
   EMPTY LEADERBOARD
========================================================= */

.leaderboard-empty {
  padding: 65px 20px;

  text-align: center;
}

.leaderboard-empty-icon {
  width: 64px;

  height: 64px;

  margin: 0 auto 14px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 18px;

  background:
    rgba(255,255,255,.13);

  color: #ffffff;

  font-size: 25px;

  border:
    1px solid
    rgba(255,255,255,.18);
}

.leaderboard-empty h3 {
  margin: 0;

  color: #ffffff;

  font-size: 19px;

  font-weight: 850;
}

.leaderboard-empty p {
  margin: 7px 0 0;

  color:
    rgba(255,255,255,.70);

  font-size: 13px;
}


/* =========================================================
   MOBILE 850
========================================================= */

@media(max-width: 850px) {

  .quiz-result-page {
    padding-top: 100px;
  }

  .result-stat-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .answer-summary {
    grid-template-columns:
      1fr;
  }

  .podium {
    gap: 12px;
  }

  .leader-card {
    padding-left: 14px;

    padding-right: 14px;
  }

}


/* =========================================================
   MOBILE 600
========================================================= */

@media(max-width: 600px) {

  .quiz-result-page {
    padding:
      92px
      12px
      50px;
  }

  .result-topbar {
    align-items: flex-start;

    flex-direction: column;

    margin-bottom: 16px;
  }

  .result-title-area h1 {
    font-size: 23px;
  }

  .result-back-btn {
    width: 100%;
  }

  .result-main-card {
    border-radius: 17px;
  }


  /* TABS */

  .result-tabs {
    padding: 9px;
  }

  .result-tab {
    min-height: 43px;

    font-size: 12px;
  }


  /* HERO */

  .result-hero {
    padding:
      28px
      18px
      25px;
  }

  .result-icon {
    width: 58px;

    height: 58px;

    font-size: 24px;

    border-radius: 15px;
  }

  .result-hero h2 {
    font-size: 23px;
  }


  /* SCORE */

  .score-area {
    padding:
      25px
      15px;
  }

  .score-box {
    width: 145px;

    height: 145px;

    border-width: 8px;
  }

  .score-value {
    font-size: 34px;
  }


  /* STATS */

  .result-stat-grid {
    grid-template-columns:
      1fr 1fr;

    gap: 9px;

    padding:
      0
      15px
      20px;
  }

  .result-stat {
    padding: 15px 8px;
  }

  .result-stat strong {
    font-size: 19px;
  }


  /* REVIEW */

  .review-section {
    padding: 22px 15px;
  }

  .review-header {
    align-items: flex-start;

    flex-direction: column;
  }

  .review-title h3 {
    font-size: 19px;
  }

  .answer-review-card {
    padding: 15px;
  }

  .answer-review-top {
    align-items: flex-start;

    flex-direction: column;
  }

  .answer-review-question {
    font-size: 15px;
  }


  /* ACTIONS */

  .result-actions {
    padding:
      20px
      15px
      22px;

    flex-direction: column;
  }

  .result-action-btn {
    width: 100%;
  }


  /* LEADERBOARD */

  .leaderboard-section {
    padding:
      28px
      15px
      35px;
  }

  .leaderboard-brand {
    margin-bottom: 20px;
  }

  .leaderboard-brand-icon {
    width: 65px;

    height: 65px;

    border-radius: 19px;

    font-size: 29px;
  }

  .leaderboard-brand-name {
    font-size: 15px;
  }

  .leaderboard-heading {
    margin-bottom: 28px;
  }

  .leaderboard-heading h2 {
    font-size: 23px;
  }

  .podium {
    display: flex;

    flex-direction: column;

    align-items: stretch;

    gap: 14px;

    margin-bottom: 30px;
  }

  .leader-card,
  .leader-card.second,
  .leader-card.third,
  .leader-card.first {
    margin: 0;

    padding:
      25px
      18px
      22px;
  }

  .leader-card.first {
    order: -1;
  }

  .leader-card.second {
    order: 0;
  }

  .leader-card.third {
    order: 1;
  }

  .leader-avatar,
  .leader-card.first .leader-avatar {
    width: 76px;

    height: 76px;

    font-size: 24px;
  }

  .leader-card.first .leader-name {
    font-size: 18px;
  }

  .leader-score {
    font-size: 25px;
  }

  .other-heading {
    align-items: flex-start;

    flex-direction: column;
  }

}


/* =========================================================
   VERY SMALL
========================================================= */

@media(max-width: 420px) {

  .result-tab {
    gap: 5px;

    font-size: 11px;
  }

  .result-tab i {
    font-size: 12px;
  }

  .leaderboard-section {
    padding-left: 12px;

    padding-right: 12px;
  }

}


/* =========================================================
   PRINT
========================================================= */

@media print {

  .result-topbar,
  .result-tabs,
  .result-actions {
    display: none !important;
  }

  .quiz-result-page {
    padding: 20px;

    background: #ffffff;
  }

  .result-main-card {
    border: 1px solid #ddd;

    box-shadow: none;
  }

  .answer-review-card {
    break-inside: avoid;
  }

  #leaderboardTab {
    display: none !important;
  }

}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media(prefers-reduced-motion: reduce) {

  .result-tab,
  .leader-card,
  .answer-review-card,
  .result-action-btn {
    transition: none !important;
  }

}


/* =========================================================
   LEADERBOARD BRAND LOGO
========================================================= */

.leaderboard-brand-icon {
  width: 72px;
  height: 72px;

  margin: 0 auto 14px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 18px;

  background: #ffffff;

  border: 1px solid rgba(255,255,255,.35);

  box-shadow:
    0 10px 28px rgba(55,0,75,.25);

  overflow: hidden;
}

.leaderboard-logo {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: contain;

  padding: 7px;

  box-sizing: border-box;
}

</style>


<div class="quiz-result-page">

  <div class="result-container">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="result-topbar">

      <div class="result-title-area">

        <div class="result-eyebrow">

          <i class="fas fa-clipboard-check"></i>

          Quiz Result

        </div>

        <h1>
          <%= @quiz.title %>
        </h1>

        <p>
          Review your performance and compare your ranking
        </p>

      </div>


      <%= link_to course_quizzes_path(@course),
                  class: "result-back-btn" do %>

        <i class="fas fa-arrow-left"></i>

        Back to Quizzes

      <% end %>

    </div>


    <!-- =====================================================
         MAIN CARD
    ====================================================== -->

    <div class="result-main-card">


      <!-- ===================================================
           TABS
      ==================================================== -->

      <div class="result-tabs">

        <button
          type="button"
          class="result-tab active"
          data-tab="answerTab">

          <i class="fas fa-list-check"></i>

          Answer

        </button>


        <button
          type="button"
          class="result-tab"
          data-tab="leaderboardTab">

          <i class="fas fa-trophy"></i>

          Leaderboard

        </button>

      </div>


      <!-- ===================================================
           ANSWER TAB
      ==================================================== -->

      <div
        id="answerTab"
        class="result-tab-content active">


        <!-- RESULT HERO -->

        <div class="result-hero">

          <div class="result-icon">

            <% if @attempt.passed? %>

              <i class="fas fa-trophy"></i>

            <% else %>

              <i class="fas fa-chart-line"></i>

            <% end %>

          </div>


          <h2>

            <%= @attempt.passed? ?
                "Congratulations!" :
                "Quiz Completed" %>

          </h2>


          <div class="result-hero-subtitle">

            <%= @quiz.title %>

          </div>


          <% if @attempt.passed? %>

            <div class="result-status passed">

              <i class="fas fa-check-circle"></i>

              Passed

            </div>

          <% else %>

            <div class="result-status failed">

              <i class="fas fa-times-circle"></i>

              Failed

            </div>

          <% end %>

        </div>


        <!-- SCORE -->

        <div class="score-area">

          <div class="score-box">

            <div class="score-value">

              <%= @attempt.percentage.to_f.round(2) %>%

            </div>

            <div class="score-label">

              Your Score

            </div>

          </div>

        </div>


        <!-- COUNTS -->

        <%

          total_questions =
            @quiz.questions.count

          answered_questions =
            @answers.count

          unanswered_questions =
            [
              total_questions -
              answered_questions,
              0
            ].max

        %>


        <!-- STATISTICS -->

        <div class="result-stat-grid">


          <div class="result-stat">

            <div class="result-stat-icon">

              <i class="fas fa-star"></i>

            </div>

            <strong>
              <%= @attempt.score.to_f %>
            </strong>

            <span>
              Score
            </span>

          </div>


          <div class="result-stat">

            <div class="result-stat-icon">

              <i class="fas fa-award"></i>

            </div>

            <strong>
              <%= @attempt.total_marks.to_f %>
            </strong>

            <span>
              Total Marks
            </span>

          </div>


          <div class="result-stat">

            <div class="result-stat-icon">

              <i class="fas fa-question-circle"></i>

            </div>

            <strong>
              <%= total_questions %>
            </strong>

            <span>
              Questions
            </span>

          </div>


          <div class="result-stat">

            <div class="result-stat-icon">

              <i class="fas fa-bullseye"></i>

            </div>

            <strong>
              <%= @quiz.passing_percentage.to_f.round(0) %>%
            </strong>

            <span>
              Pass Mark
            </span>

          </div>


        </div>


        <!-- ANSWER SUMMARY -->

        <div class="answer-summary">


          <div class="answer-summary-box">

            <div class="answer-summary-icon green">

              <i class="fas fa-check"></i>

            </div>

            <div class="answer-summary-text">

              <strong>
                <%= answered_questions %>
              </strong>

              <span>
                Answered
              </span>

            </div>

          </div>


          <div class="answer-summary-box">

            <div class="answer-summary-icon orange">

              <i class="fas fa-minus"></i>

            </div>

            <div class="answer-summary-text">

              <strong>
                <%= unanswered_questions %>
              </strong>

              <span>
                Unanswered
              </span>

            </div>

          </div>


          <div class="answer-summary-box">

            <div class="answer-summary-icon blue">

              <i class="fas fa-list-ol"></i>

            </div>

            <div class="answer-summary-text">

              <strong>
                <%= total_questions %>
              </strong>

              <span>
                Total Questions
              </span>

            </div>

          </div>


        </div>


        <!-- ANSWER REVIEW -->

        <div class="review-section">


          <div class="review-header">

            <div class="review-title">

              <div class="review-title-icon">

                <i class="fas fa-list-check"></i>

              </div>

              <h3>
                Answer Review
              </h3>

            </div>


            <div class="review-count">

              <%= total_questions %> Questions

            </div>

          </div>


          <%

            answer_lookup =
              @answers.index_by(&:question_id)

          %>


          <% @quiz.questions
                    .includes(:options)
                    .order(:position)
                    .each_with_index do |
                      question,
                      index
                    | %>


            <%

              answer =
                answer_lookup[question.id]

              correct =
                answer.present? &&
                answer.is_correct?

              selected_option =
                answer&.option

              correct_option =
                question.options.find_by(
                  is_correct: true
                )

            %>


            <div class="answer-review-card">


              <div class="answer-review-top">

                <div class="answer-question-number">

                  <span class="question-number-badge">

                    <%= index + 1 %>

                  </span>

                  Question <%= index + 1 %>

                </div>


                <% if answer.blank? %>

                  <div class="answer-status unanswered">

                    <i class="fas fa-minus-circle"></i>

                    Not Answered

                  </div>

                <% elsif correct %>

                  <div class="answer-status correct">

                    <i class="fas fa-check-circle"></i>

                    Correct

                  </div>

                <% else %>

                  <div class="answer-status incorrect">

                    <i class="fas fa-times-circle"></i>

                    Incorrect

                  </div>

                <% end %>

              </div>


              <div class="answer-review-question">

                <%= question.question_text %>

              </div>


              <% if selected_option.present? %>


                <div class="answer-row">

                  <div class="answer-row-icon">

                    <i class="fas fa-user"></i>

                  </div>

                  <div class="answer-row-content">

                    <strong>
                      Your Answer:
                    </strong>

                    <span>
                      <%= selected_option.option_text %>
                    </span>

                  </div>

                </div>


                <% if !correct &&
                      correct_option.present? %>

                  <div class="answer-row correct-answer-row">

                    <div class="answer-row-icon">

                      <i class="fas fa-check"></i>

                    </div>

                    <div class="answer-row-content">

                      <strong>
                        Correct Answer:
                      </strong>

                      <span>
                        <%= correct_option.option_text %>
                      </span>

                    </div>

                  </div>

                <% end %>


              <% else %>


                <div class="answer-row unanswered-row">

                  <div class="answer-row-icon">

                    <i class="fas fa-minus"></i>

                  </div>

                  <div class="answer-row-content">

                    <strong>
                      Your Answer:
                    </strong>

                    <span>
                      Not answered
                    </span>

                  </div>

                </div>


                <% if correct_option.present? %>

                  <div class="answer-row correct-answer-row">

                    <div class="answer-row-icon">

                      <i class="fas fa-check"></i>

                    </div>

                    <div class="answer-row-content">

                      <strong>
                        Correct Answer:
                      </strong>

                      <span>
                        <%= correct_option.option_text %>
                      </span>

                    </div>

                  </div>

                <% end %>


              <% end %>


            </div>


          <% end %>


        </div>


        <!-- ACTIONS -->

        <div class="result-actions">


          <%= link_to course_quizzes_path(@course),
                      class:
                      "result-action-btn result-action-primary" do %>

            <i class="fas fa-clipboard-list"></i>

            View All Quizzes

          <% end %>


          <%= link_to course_details_path(@course),
                      class:
                      "result-action-btn result-action-secondary" do %>

            <i class="fas fa-arrow-left"></i>

            Back to Course

          <% end %>


          <button
            type="button"
            class="result-action-btn result-action-secondary"
            id="printResult">

            <i class="fas fa-print"></i>

            Print Result

          </button>


        </div>


      </div>


      <!-- ===================================================
           LEADERBOARD TAB
      ==================================================== -->

      <div
        id="leaderboardTab"
        class="result-tab-content">


        <div class="leaderboard-section">


          <!-- =================================================
               A ONE GS CENTER BRAND
          ================================================== -->

          <div class="leaderboard-brand">

            <div class="leaderboard-brand-icon">
           <%= image_tag "logo.jpeg",
                alt: "A One GS Center",
                class: "leaderboard-logo" %>
      </div>

            <div class="leaderboard-brand-name">

              A One GS Center

            </div>

            <div class="leaderboard-brand-subtitle">

              Learn • Practice • Achieve

            </div>

          </div>


          <!-- =================================================
               LEADERBOARD HEADER
          ================================================== -->

          <div class="leaderboard-heading">

            <%# <div class="leaderboard-heading-icon">

              <i class="fas fa-trophy"></i>

            </div> %>

            <h2>
              Leaderboard
            </h2>

            <p>
              <%= @quiz.title %>
            </p>

          </div>


          <% if @leaderboard.any? %>


            <!-- =================================================
                 TOP 3
            ================================================== -->

            <div class="podium">


              <% first =
                   @leaderboard[0] %>

              <% second =
                   @leaderboard[1] %>

              <% third =
                   @leaderboard[2] %>


              <!-- =============================================
                   SECOND PLACE
              ============================================== -->

              <% if second.present? %>

                <div class="leader-card second">

                  <div class="leader-rank">

                    #2

                  </div>


                  <div class="leader-avatar">

                    <% if second[:user].respond_to?(:image) &&
                          second[:user].image.attached? %>

                      <%= image_tag second[:user].image,
                                    alt: second[:name],
                                    class: "leader-avatar-image" %>

                    <% else %>

                      <%= second[:name]
                          .to_s
                          .first
                          .upcase %>

                    <% end %>

                  </div>


                  <h3 class="leader-name">

                    <%= second[:name] %>

                  </h3>


                  <div class="leader-score">

                    <%= second[:score].to_f %>
                    /
                    <%= second[:total_marks].to_f %>

                  </div>


                  <div class="leader-score-label">

                    Best Score

                  </div>


                  <div class="leader-percentage">

                    <%= second[:percentage]
                        .to_f
                        .round(2) %>%

                  </div>


                  <div class="leader-attempts">

                    <i class="fas fa-rotate"></i>

                    <%= second[:attempts] %>

                    <%= second[:attempts] == 1 ?
                        "Attempt" :
                        "Attempts" %>

                  </div>

                </div>

              <% end %>


              <!-- =============================================
                   FIRST PLACE
              ============================================== -->

              <% if first.present? %>

                <div class="leader-card first">

                  <div class="leader-rank">

                    #1

                  </div>


                  <div class="leader-avatar">

                    <% if first[:user].respond_to?(:image) &&
                          first[:user].image.attached? %>

                      <%= image_tag first[:user].image,
                                    alt: first[:name],
                                    class: "leader-avatar-image" %>

                    <% else %>

                      <%= first[:name]
                          .to_s
                          .first
                          .upcase %>

                    <% end %>

                  </div>


                  <h3 class="leader-name">

                    <%= first[:name] %>

                  </h3>


                  <div class="leader-score">

                    <%= first[:score].to_f %>
                    /
                    <%= first[:total_marks].to_f %>

                  </div>


                  <div class="leader-score-label">

                    Best Score

                  </div>


                  <div class="leader-percentage">

                    <%= first[:percentage]
                        .to_f
                        .round(2) %>%

                  </div>


                  <div class="leader-attempts">

                    <i class="fas fa-rotate"></i>

                    <%= first[:attempts] %>

                    <%= first[:attempts] == 1 ?
                        "Attempt" :
                        "Attempts" %>

                  </div>

                </div>

              <% end %>


              <!-- =============================================
                   THIRD PLACE
              ============================================== -->

              <% if third.present? %>

                <div class="leader-card third">

                  <div class="leader-rank">

                    #3

                  </div>


                  <div class="leader-avatar">

                    <% if third[:user].respond_to?(:image) &&
                          third[:user].image.attached? %>

                      <%= image_tag third[:user].image,
                                    alt: third[:name],
                                    class: "leader-avatar-image" %>

                    <% else %>

                      <%= third[:name]
                          .to_s
                          .first
                          .upcase %>

                    <% end %>

                  </div>


                  <h3 class="leader-name">

                    <%= third[:name] %>

                  </h3>


                  <div class="leader-score">

                    <%= third[:score].to_f %>
                    /
                    <%= third[:total_marks].to_f %>

                  </div>


                  <div class="leader-score-label">

                    Best Score

                  </div>


                  <div class="leader-percentage">

                    <%= third[:percentage]
                        .to_f
                        .round(2) %>%

                  </div>


                  <div class="leader-attempts">

                    <i class="fas fa-rotate"></i>

                    <%= third[:attempts] %>

                    <%= third[:attempts] == 1 ?
                        "Attempt" :
                        "Attempts" %>

                  </div>

                </div>

              <% end %>


            </div>


            <!-- =================================================
                 OTHER PARTICIPANTS
            ================================================== -->

            <% if @other_participants.any? %>

              <div class="other-participants">


                <div class="other-heading">

                  <h3>
                    Other Participants
                  </h3>

                  <span>

                    <%= @other_participants.count %>

                    <%= @other_participants.count == 1 ?
                        "Student" :
                        "Students" %>

                  </span>

                </div>


                <div class="leader-table-wrapper">

                  <table class="leader-table">

                    <thead>

                      <tr>

                        <th>
                          Rank
                        </th>

                        <th>
                          Student
                        </th>

                        <th>
                          Best Score
                        </th>

                        <th>
                          Accuracy
                        </th>

                        <th>
                          Attempts
                        </th>

                      </tr>

                    </thead>


                    <tbody>

                      <% @other_participants.each do |student| %>

                        <tr>


                          <td class="table-rank">

                            #<%= student[:rank] %>

                          </td>


                          <td>

                            <div class="table-student">


                              <div class="table-avatar">

                                <% if student[:user].respond_to?(:image) &&
                                      student[:user].image.attached? %>

                                  <%= image_tag student[:user].image,
                                                alt: student[:name],
                                                class: "table-avatar-image" %>

                                <% else %>

                                  <%= student[:name]
                                      .to_s
                                      .first
                                      .upcase %>

                                <% end %>

                              </div>


                              <div class="table-student-name">

                                <%= student[:name] %>

                              </div>


                            </div>

                          </td>


                          <td class="table-score">

                            <%= student[:score].to_f %>
                            /
                            <%= student[:total_marks].to_f %>

                          </td>


                          <td class="table-percentage">

                            <%= student[:percentage]
                                .to_f
                                .round(2) %>%

                          </td>


                          <td>

                            <%= student[:attempts] %>

                            <%= student[:attempts] == 1 ?
                                "Attempt" :
                                "Attempts" %>

                          </td>


                        </tr>

                      <% end %>

                    </tbody>

                  </table>

                </div>


              </div>

            <% end %>


          <% else %>


            <!-- =================================================
                 EMPTY LEADERBOARD
            ================================================== -->

            <div class="leaderboard-empty">

              <div class="leaderboard-empty-icon">

                <i class="fas fa-users"></i>

              </div>

              <h3>
                No leaderboard data yet
              </h3>

              <p>
                Complete attempts will appear here.
              </p>

            </div>


          <% end %>


        </div>


      </div>


    </div>

  </div>

</div>

<script nonce="<%= content_security_policy_nonce %>">

(function () {

  "use strict";


  /* =========================================================
     QUIZ RESULT PAGE INITIALIZATION
  ========================================================== */

  function initializeQuizResultPage() {

    const page =
      document.querySelector(".quiz-result-page");


    /*
     * If this page does not contain the result
     * container, do nothing.
     */
    if (!page) {
      return;
    }


    /*
     * Prevent duplicate initialization
     * during Turbo navigation.
     */
    if (
      page.dataset.resultInitialized === "true"
    ) {
      return;
    }


    page.dataset.resultInitialized = "true";


    /* =======================================================
       TAB SWITCHING
    ======================================================== */

    const tabs =
      page.querySelectorAll(
        ".result-tab"
      );

    const contents =
      page.querySelectorAll(
        ".result-tab-content"
      );


    tabs.forEach(function (tab) {

      tab.addEventListener(
        "click",
        function () {

          const targetId =
            tab.dataset.tab;


          if (!targetId) {
            return;
          }


          /* Remove active from all tabs */

          tabs.forEach(function (item) {

            item.classList.remove(
              "active"
            );

          });


          /* Hide all contents */

          contents.forEach(function (content) {

            content.classList.remove(
              "active"
            );

          });


          /* Activate clicked tab */

          tab.classList.add(
            "active"
          );


          /* Activate target content */

          const target =
            page.querySelector(
              "#" +
              CSS.escape(targetId)
            );


          if (target) {

            target.classList.add(
              "active"
            );


            window.scrollTo({
              top: 0,
              behavior: "smooth"
            });

          }

        }
      );

    });


    /* =======================================================
       PRINT RESULT
    ======================================================== */

    const printButton =
      page.querySelector(
        "#printResult"
      );


    if (printButton) {

      printButton.addEventListener(
        "click",
        function () {

          window.print();

        }
      );

    }


    /* =======================================================
       SCORE ANIMATION
    ======================================================== */

    const score =
      page.querySelector(
        ".score-box"
      );


    if (score) {

      score.style.opacity = "0";

      score.style.transform =
        "scale(.85)";

      score.style.transition =
        "opacity .5s ease, transform .5s ease";


      setTimeout(
        function () {

          /*
           * Turbo may have replaced the page
           * before the animation fires.
           */

          if (!document.documentElement.contains(score)) {
            return;
          }


          score.style.opacity = "1";

          score.style.transform =
            "scale(1)";

        },
        120
      );

    }


    /* =======================================================
       ANSWER CARD ANIMATION
    ======================================================== */

    const cards =
      page.querySelectorAll(
        ".answer-review-card"
      );


    cards.forEach(function (card, index) {

      card.style.opacity = "0";

      card.style.transform =
        "translateY(8px)";

      card.style.transition =
        "opacity .3s ease, transform .3s ease";


      setTimeout(
        function () {

          if (!document.documentElement.contains(card)) {
            return;
          }


          card.style.opacity = "1";

          card.style.transform =
            "translateY(0)";

        },
        80 + (index * 35)
      );

    });


    /* =======================================================
       LEADERBOARD CARD ANIMATION
    ======================================================== */

    const leaderCards =
      page.querySelectorAll(
        ".leader-card"
      );


    leaderCards.forEach(function (card, index) {

      card.style.opacity = "0";

      card.style.transform =
        "translateY(12px)";

      card.style.transition =
        "opacity .3s ease, transform .3s ease";


      setTimeout(
        function () {

          if (!document.documentElement.contains(card)) {
            return;
          }


          card.style.opacity = "1";

          card.style.transform =
            "translateY(0)";

        },
        100 + (index * 100)
      );

    });

  }


  /* =========================================================
     TURBO NAVIGATION
  ========================================================== */

  document.addEventListener(
    "turbo:load",
    initializeQuizResultPage
  );


  /* =========================================================
     NORMAL PAGE LOAD
  ========================================================== */

  if (
    document.readyState !== "loading"
  ) {

    initializeQuizResultPage();

  } else {

    document.addEventListener(
      "DOMContentLoaded",
      initializeQuizResultPage,
      { once: true }
    );

  }

})();

</script>