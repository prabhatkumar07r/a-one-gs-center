<% content_for :hide_header, true %>
<% content_for :hide_footer, true %>

<style nonce="<%= content_security_policy_nonce %>">
/* =========================================================
   QUIZ EXAM PAGE
========================================================= */

.quiz-exam-page {
  min-height: 100vh;

  background: #f4f6fa;

  color: #172033;

  font-family:
    "Poppins",
    "Inter",
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  box-sizing: border-box;
}


/* =========================================================
   TOP EXAM HEADER
========================================================= */

.quiz-exam-header {

  width: 100%;

  height: 58px;

  background: #ffffff;

  border-bottom: 1px solid #dfe3ea;

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 0 28px;

  box-sizing: border-box;

  position: sticky;

  top: 0;

  z-index: 1000;
}


/* =========================================================
   EXAM BRAND
========================================================= */

.quiz-exam-brand {

  display: flex;

  align-items: center;

  gap: 14px;

  min-width: 0;
}


.quiz-exam-logo {

  width: 44px;

  height: 44px;

  flex-shrink: 0;

  border-radius: 9px;

  object-fit: contain;

  background: #f4f0ff;
}


.quiz-exam-brand-content {

  min-width: 0;

  line-height: 1.1;
}


.quiz-exam-series-name {

  color: #64748b;

  font-size: 12px;

  font-weight: 500;

  margin-bottom: 3px;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}


.quiz-exam-title {

  color: #111827;

  font-size: 17px;

  font-weight: 800;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}


/* =========================================================
   HEADER ACTIONS
========================================================= */

.quiz-exam-header-actions {

  display: flex;

  align-items: center;

  gap: 12px;

  flex-shrink: 0;
}


/* =========================================================
   TIMER
========================================================= */

.quiz-exam-timer {

  min-width: 145px;

  height: 42px;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 0 18px;

  border: 1px solid #fed7aa;

  border-radius: 9px;

  background: #fffaf5;

  color: #c2410c;

  font-size: 16px;

  font-weight: 850;

  box-sizing: border-box;
}


.quiz-exam-timer.timer-warning {

  background: #fff7ed;

  border-color: #fdba74;

  color: #ea580c;
}


.quiz-exam-timer.timer-danger {

  background: #fef2f2;

  border-color: #fca5a5;

  color: #dc2626;

  animation: timerDangerPulse 1s infinite;
}


@keyframes timerDangerPulse {

  50% {
    opacity: .55;
  }

}


/* =========================================================
   QUIT BUTTON
========================================================= */

.quiz-quit-btn {

  height: 42px;

  padding: 0 17px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  border: 1px solid #dfe3ea;

  border-radius: 9px;

  background: #ffffff;

  color: #334155 !important;

  text-decoration: none !important;

  font-size: 13px;

  font-weight: 750;

  transition: .2s ease;

  cursor: pointer;
}


.quiz-quit-btn:hover {

  background: #f8fafc;

  border-color: #cbd5e1;

  color: #dc2626 !important;
}


/* =========================================================
   MAIN LAYOUT
========================================================= */

.quiz-exam-content {

  width: 100%;

  max-width: 1400px;

  margin: 0 auto;

  padding: 22px 18px 28px;

  box-sizing: border-box;
}


.quiz-exam-grid {

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    370px;

  gap: 22px;

  align-items: start;
}


/* =========================================================
   MAIN QUESTION CARD
========================================================= */

.quiz-question-card {

  background: #ffffff;

  border: 1px solid #dfe3ea;

  border-radius: 12px;

  overflow: hidden;

  box-shadow:
    0 2px 8px rgba(15, 23, 42, .035);
}


/* =========================================================
   QUESTION CARD TOP
========================================================= */

.quiz-question-header {

  min-height: 76px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  padding: 16px 32px;

  border-bottom: 1px solid #e5e7eb;

  box-sizing: border-box;
}


.quiz-question-heading {

  display: flex;

  align-items: center;

  gap: 12px;

  min-width: 0;
}


/* QUESTION NUMBER BOX */

.quiz-current-number {

  width: 43px;

  height: 43px;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 9px;

  background: #ede9fe;

  color: #6d28d9;

  font-size: 17px;

  font-weight: 850;
}


.quiz-current-question-text {

  color: #111827;

  font-size: 16px;

  font-weight: 800;
}


/* =========================================================
   QUESTION HEADER RIGHT
========================================================= */

.quiz-question-header-right {

  display: flex;

  align-items: center;

  gap: 12px;

  flex-shrink: 0;
}


/* MARKS */

.quiz-marks {

  padding: 8px 12px;

  border-radius: 8px;

  background: #f0fdf4;

  color: #15803d;

  font-size: 12px;

  font-weight: 800;

  white-space: nowrap;
}


/* QUESTION ELAPSED */

.quiz-question-time {

  color: #64748b;

  font-size: 12px;

  white-space: nowrap;
}


/* BOOKMARK */

.quiz-bookmark-btn {

  width: 43px;

  height: 43px;

  display: flex;

  align-items: center;

  justify-content: center;

  border: 1px solid #dfe3ea;

  border-radius: 9px;

  background: #ffffff;

  color: #94a3b8;

  cursor: pointer;

  transition: .2s ease;
}


.quiz-bookmark-btn:hover {

  border-color: #f59e0b;

  color: #f59e0b;

  background: #fffbeb;
}


.quiz-bookmark-btn.bookmarked {

  background: #fff7ed;

  border-color: #f59e0b;

  color: #f59e0b;
}


/* =========================================================
   QUESTION BODY
========================================================= */

.quiz-question-body {

  padding: 34px 32px 0;
}


/* QUESTION LABEL */

.quiz-question-label {

  margin-bottom: 17px;

  color: #64748b;

  font-size: 12px;

  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: .5px;
}


/* QUESTION TEXT */

.quiz-question-text {

  margin: 0 0 32px;

  color: #111827;

  font-size: 25px;

  line-height: 1.55;

  font-weight: 800;
}


/* =========================================================
   OPTIONS
========================================================= */

.quiz-options {

  display: flex;

  flex-direction: column;

  gap: 13px;
}


.quiz-option {

  position: relative;

  display: flex;

  align-items: center;

  gap: 14px;

  width: 100%;

  min-height: 68px;

  padding: 12px 17px;

  border: 1px solid #dbe1e8;

  border-radius: 11px;

  background: #ffffff;

  box-sizing: border-box;

  cursor: pointer;

  transition:
    border-color .18s ease,
    background .18s ease,
    box-shadow .18s ease,
    transform .18s ease;
}


.quiz-option:hover {

  border-color: #a78bfa;

  background: #faf9ff;

  transform: translateX(1px);
}


/* HIDE RADIO */

.quiz-option input[type="radio"] {

  position: absolute;

  opacity: 0;

  pointer-events: none;
}


/* OPTION LETTER */

.quiz-option-letter {

  width: 43px;

  height: 43px;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 9px;

  background: #f1f3f5;

  color: #475569;

  font-size: 14px;

  font-weight: 850;

  transition: .18s ease;
}


/* OPTION TEXT */

.quiz-option-text {

  color: #334155;

  font-size: 15px;

  line-height: 1.55;

  font-weight: 500;

  word-break: break-word;
}


/* SELECTED */

.quiz-option.selected {

  background: #f5f3ff;

  border-color: #7c3aed;

  box-shadow:
    0 0 0 1px rgba(124, 58, 237, .12);
}


.quiz-option.selected .quiz-option-letter {

  background: #6d28d9;

  color: #ffffff;
}


.quiz-option.selected .quiz-option-text {

  color: #312e81;

  font-weight: 700;
}


/* =========================================================
   QUESTION ACTIONS
========================================================= */

.quiz-question-actions {

  min-height: 82px;

  margin-top: 28px;

  padding: 18px 32px;

  border-top: 1px solid #e5e7eb;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 12px;

  box-sizing: border-box;
}


/* COMMON BUTTON */

.quiz-action-btn {

  min-width: 123px;

  min-height: 48px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  padding: 11px 20px;

  border-radius: 9px;

  font-size: 13px;

  font-weight: 800;

  cursor: pointer;

  transition: .2s ease;

  box-sizing: border-box;
}


/* PREVIOUS */

.quiz-prev-btn {

  background: #ffffff;

  border: 1px solid #dfe3ea;

  color: #64748b;
}


.quiz-prev-btn:hover {

  background: #f8fafc;

  border-color: #cbd5e1;

  color: #334155;
}


.quiz-prev-btn:disabled {

  opacity: .45;

  cursor: not-allowed;

  transform: none;
}


/* SAVE NEXT */

.quiz-next-btn {

  border: 1px solid #6d28d9;

  background: #6d28d9;

  color: #ffffff;
}


.quiz-next-btn:hover {

  background: #5b21b6;

  border-color: #5b21b6;

  transform: translateY(-1px);
}


/* SUBMIT */

.quiz-submit-btn {

  min-width: 145px;

  border: 1px solid #16a34a;

  background: #16a34a;

  color: #ffffff;
}


.quiz-submit-btn:hover {

  background: #15803d;

  border-color: #15803d;

  transform: translateY(-1px);
}


.quiz-submit-btn:disabled {

  opacity: .65;

  cursor: not-allowed;

  transform: none;
}


/* =========================================================
   RIGHT SIDEBAR
========================================================= */

.quiz-sidebar {

  display: flex;

  flex-direction: column;

  gap: 18px;

  position: sticky;

  top: 76px;
}


/* =========================================================
   SIDEBAR CARD
========================================================= */

.quiz-sidebar-card {

  background: #ffffff;

  border: 1px solid #dfe3ea;

  border-radius: 12px;

  overflow: hidden;

  box-shadow:
    0 2px 8px rgba(15, 23, 42, .035);
}


/* =========================================================
   TEST PROGRESS
========================================================= */

.quiz-progress-card {

  padding: 21px 19px 18px;
}


.quiz-sidebar-title-row {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 10px;

  margin-bottom: 13px;
}


.quiz-sidebar-title {

  margin: 0;

  color: #111827;

  font-size: 15px;

  font-weight: 850;
}


.quiz-progress-percent {

  color: #6d28d9;

  font-size: 13px;

  font-weight: 850;
}


/* PROGRESS TRACK */

.quiz-progress-track {

  width: 100%;

  height: 7px;

  border-radius: 20px;

  background: #ede9fe;

  overflow: hidden;

  margin-bottom: 18px;
}


.quiz-progress-fill {

  width: 0%;

  height: 100%;

  border-radius: 20px;

  background: #7c3aed;

  transition: width .25s ease;
}


/* STATS */

.quiz-stats {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);
}


.quiz-stat {

  text-align: center;

  padding: 3px 7px;

  border-right: 1px solid #e5e7eb;
}


.quiz-stat:last-child {

  border-right: none;
}


.quiz-stat strong {

  display: block;

  margin-bottom: 5px;

  color: #111827;

  font-size: 16px;

  font-weight: 850;
}


.quiz-stat span {

  color: #64748b;

  font-size: 11px;

  font-weight: 500;
}


/* =========================================================
   QUESTION PALETTE
========================================================= */

.quiz-palette-header {

  padding: 20px 19px 16px;

  border-bottom: 1px solid #e5e7eb;
}


.quiz-palette-title {

  margin: 0;

  color: #111827;

  font-size: 15px;

  font-weight: 850;
}


/* LEGEND */

.quiz-palette-legend {

  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 10px;

  padding: 16px 19px;

  border-bottom: 1px solid #e5e7eb;
}


.quiz-legend-item {

  display: flex;

  align-items: center;

  gap: 7px;

  color: #64748b;

  font-size: 11px;

  font-weight: 600;
}


.quiz-legend-box {

  width: 16px;

  height: 16px;

  flex-shrink: 0;

  border-radius: 4px;

  border: 1px solid #d1d5db;
}


.quiz-legend-box.answered {

  background: #22c55e;

  border-color: #22c55e;
}


.quiz-legend-box.current {

  background: #7c3aed;

  border-color: #7c3aed;
}


.quiz-legend-box.unanswered {

  background: #f8fafc;

  border-color: #cbd5e1;
}


.quiz-legend-box.bookmarked {

  background: #f59e0b;

  border-color: #f59e0b;
}


/* =========================================================
   ALL QUESTIONS
========================================================= */

.quiz-all-questions {

  padding: 17px 19px 20px;
}


.quiz-all-label {

  margin-bottom: 13px;

  color: #94a3b8;

  font-size: 11px;

  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: .5px;
}


.quiz-palette-grid {

  display: grid;

  grid-template-columns:
    repeat(6, 1fr);

  gap: 8px;

  max-height: 335px;

  overflow-y: auto;

  padding-right: 3px;
}


.quiz-palette-grid::-webkit-scrollbar {

  width: 5px;
}


.quiz-palette-grid::-webkit-scrollbar-track {

  background: transparent;
}


.quiz-palette-grid::-webkit-scrollbar-thumb {

  background: #d8dce5;

  border-radius: 10px;
}


/* PALETTE BUTTON */

.quiz-palette-number {

  width: 100%;

  height: 38px;

  display: flex;

  align-items: center;

  justify-content: center;

  border: 1px solid #d7dde6;

  border-radius: 8px;

  background: #ffffff;

  color: #475569;

  font-size: 12px;

  font-weight: 750;

  cursor: pointer;

  transition: .18s ease;
}


.quiz-palette-number:hover {

  border-color: #a78bfa;

  color: #6d28d9;
}


/* ANSWERED */

.quiz-palette-number.answered {

  background: #22c55e;

  border-color: #22c55e;

  color: #ffffff;
}


/* CURRENT */

.quiz-palette-number.current {

  background: #7c3aed;

  border-color: #7c3aed;

  color: #ffffff;

  box-shadow:
    0 3px 9px rgba(124, 58, 237, .22);
}


/* CURRENT + ANSWERED */

.quiz-palette-number.current.answered {

  background: #7c3aed;

  border-color: #7c3aed;

  color: #ffffff;
}


/* BOOKMARKED */

.quiz-palette-number.bookmarked {

  box-shadow:
    inset 0 -3px 0 #f59e0b;
}


/* CURRENT + BOOKMARK */

.quiz-palette-number.current.bookmarked {

  box-shadow:
    inset 0 -3px 0 #f59e0b,
    0 3px 9px rgba(124, 58, 237, .22);
}


/* =========================================================
   BOTTOM SIDEBAR ACTION CARD
========================================================= */

.quiz-bottom-actions {

  padding: 17px;
}


.quiz-paper-btn {

  width: 100%;

  min-height: 45px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  margin-bottom: 11px;

  border: 1px solid #ddd6fe;

  border-radius: 9px;

  background: #faf5ff;

  color: #6d28d9;

  font-size: 13px;

  font-weight: 800;

  cursor: pointer;

  transition: .2s ease;
}


.quiz-paper-btn:hover {

  background: #f3e8ff;

  border-color: #c4b5fd;
}


.quiz-sidebar-submit {

  width: 100%;

  min-height: 50px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  border: 1px solid #16a34a;

  border-radius: 9px;

  background: #16a34a;

  color: #ffffff;

  font-size: 14px;

  font-weight: 850;

  cursor: pointer;

  transition: .2s ease;
}


.quiz-sidebar-submit:hover {

  background: #15803d;

  border-color: #15803d;

  transform: translateY(-1px);
}


/* =========================================================
   SUBMIT MODAL
========================================================= */

.quiz-submit-overlay {

  position: fixed;

  inset: 0;

  z-index: 5000;

  display: none;

  align-items: center;

  justify-content: center;

  padding: 20px;

  background: rgba(15, 23, 42, .48);

  backdrop-filter: blur(3px);
}


.quiz-submit-overlay.show {

  display: flex;
}


.quiz-submit-modal {

  width: 100%;

  max-width: 430px;

  padding: 28px;

  border-radius: 16px;

  background: #ffffff;

  box-shadow:
    0 25px 70px rgba(15, 23, 42, .22);

  box-sizing: border-box;
}


.quiz-submit-modal-icon {

  width: 52px;

  height: 52px;

  margin: 0 auto 14px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: #ecfdf5;

  color: #16a34a;

  font-size: 22px;
}


.quiz-submit-modal h3 {

  margin: 0 0 8px;

  text-align: center;

  color: #111827;

  font-size: 20px;

  font-weight: 850;
}


.quiz-submit-modal p {

  margin: 0 0 22px;

  text-align: center;

  color: #64748b;

  font-size: 13px;

  line-height: 1.65;
}


.quiz-submit-summary {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  margin-bottom: 22px;

  border: 1px solid #e5e7eb;

  border-radius: 10px;

  overflow: hidden;
}


.quiz-submit-summary-item {

  padding: 13px 7px;

  text-align: center;

  border-right: 1px solid #e5e7eb;
}


.quiz-submit-summary-item:last-child {

  border-right: none;
}


.quiz-submit-summary-item strong {

  display: block;

  color: #111827;

  font-size: 17px;

  font-weight: 850;
}


.quiz-submit-summary-item span {

  color: #64748b;

  font-size: 10px;
}


.quiz-modal-actions {

  display: flex;

  gap: 10px;
}


.quiz-modal-cancel,
.quiz-modal-confirm {

  flex: 1;

  min-height: 46px;

  border-radius: 9px;

  font-size: 13px;

  font-weight: 800;

  cursor: pointer;
}


.quiz-modal-cancel {

  border: 1px solid #dfe3ea;

  background: #ffffff;

  color: #475569;
}


.quiz-modal-confirm {

  border: 1px solid #16a34a;

  background: #16a34a;

  color: #ffffff;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1050px) {

  .quiz-exam-grid {

    grid-template-columns:
      minmax(0, 1fr)
      320px;

  }

  .quiz-palette-grid {

    grid-template-columns:
      repeat(5, 1fr);

  }

}


@media (max-width: 850px) {

  .quiz-exam-grid {

    grid-template-columns: 1fr;

  }

  .quiz-sidebar {

    position: static;

  }

  .quiz-palette-grid {

    max-height: none;

    grid-template-columns:
      repeat(8, 1fr);

  }

}


@media (max-width: 600px) {

  .quiz-exam-header {

    height: auto;

    min-height: 62px;

    padding: 9px 12px;

    gap: 10px;

  }


  .quiz-exam-logo {

    width: 38px;

    height: 38px;

  }


  .quiz-exam-series-name {

    font-size: 10px;

  }


  .quiz-exam-title {

    font-size: 14px;

  }


  .quiz-exam-header-actions {

    gap: 6px;

  }


  .quiz-exam-timer {

    min-width: 78px;

    height: 37px;

    padding: 0 8px;

    font-size: 12px;

  }


  .quiz-quit-btn {

    height: 37px;

    padding: 0 9px;

    font-size: 11px;

  }


  .quiz-quit-btn i {

    display: none;

  }


  .quiz-exam-content {

    padding: 10px 9px 25px;

  }


  .quiz-question-header {

    min-height: auto;

    padding: 13px 14px;

  }


  .quiz-current-number {

    width: 38px;

    height: 38px;

  }


  .quiz-current-question-text {

    font-size: 14px;

  }


  .quiz-question-header-right {

    gap: 6px;

  }


  .quiz-marks {

    display: none;

  }


  .quiz-question-time {

    display: none;

  }


  .quiz-bookmark-btn {

    width: 38px;

    height: 38px;

  }


  .quiz-question-body {

    padding: 22px 14px 0;

  }


  .quiz-question-text {

    font-size: 20px;

    margin-bottom: 23px;

  }


  .quiz-option {

    min-height: 59px;

    padding: 9px 11px;

  }


  .quiz-option-letter {

    width: 36px;

    height: 36px;

  }


  .quiz-option-text {

    font-size: 14px;

  }


  .quiz-question-actions {

    min-height: auto;

    padding: 14px;

    margin-top: 22px;

  }


  .quiz-action-btn {

    min-width: 0;

    flex: 1;

    padding: 10px 12px;

  }


  .quiz-palette-grid {

    grid-template-columns:
      repeat(6, 1fr);

  }

}


/* =========================================================
   VERY SMALL MOBILE
========================================================= */

@media (max-width: 390px) {

  .quiz-exam-brand-content {

    max-width: 125px;

  }


  .quiz-exam-title {

    font-size: 13px;

  }


  .quiz-exam-timer {

    min-width: 68px;

    font-size: 11px;

  }


  .quiz-palette-grid {

    grid-template-columns:
      repeat(5, 1fr);

  }

}


/* =========================================================
   REDUCE MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {

    scroll-behavior: auto !important;

    transition: none !important;

    animation: none !important;

  }

}

</style>


<div class="quiz-exam-page">


  <!-- =====================================================
       EXAM HEADER
  ====================================================== -->

  <header class="quiz-exam-header">


    <!-- BRAND -->

    <div class="quiz-exam-brand">

      <%= image_tag(
        "logo.jpeg",
        alt: "A One GS Center",
        class: "quiz-exam-logo"
      ) %>


      <div class="quiz-exam-brand-content">

        <div class="quiz-exam-series-name">

          <%= @quiz.description.presence ||
              "Course Quiz" %>

        </div>


        <div class="quiz-exam-title">

          <%= @quiz.title %>

        </div>

      </div>

    </div>


    <!-- HEADER ACTIONS -->

    <div class="quiz-exam-header-actions">


      <div
        class="quiz-exam-timer"
        id="quizTimer">

        <%= sprintf(
          "%02d:%02d",
          @quiz.time_limit.to_i,
          0
        ) %>

      </div>


      <%= link_to(
        course_quizzes_path(@course),
        class: "quiz-quit-btn",
        data: {
          turbo_method: :get
        }
      ) do %>

        <i class="fas fa-sign-out-alt"></i>

        Quit

      <% end %>

    </div>

  </header>


  <!-- =====================================================
       MAIN CONTENT
  ====================================================== -->

  <main class="quiz-exam-content">


    <div class="quiz-exam-grid">


      <!-- =================================================
           LEFT QUESTION AREA
      ================================================== -->

      <section class="quiz-question-card">


        <!-- =================================================
             QUESTION HEADER
        ================================================== -->

        <div class="quiz-question-header">


          <div class="quiz-question-heading">


            <div
              class="quiz-current-number"
              id="currentQuestionNumber">

              1

            </div>


            <div
              class="quiz-current-question-text"
              id="currentQuestionHeading">

              Question 1 of <%= @questions.count %>

            </div>

          </div>


          <div class="quiz-question-header-right">


            <div
              class="quiz-marks"
              id="currentQuestionMarks">

              +1.0 Marks

            </div>


            <div
              class="quiz-question-time"
              id="questionElapsedTime">

              00:00

            </div>


            <button
              type="button"
              class="quiz-bookmark-btn"
              id="bookmarkBtn"
              title="Bookmark question">

              <i class="far fa-bookmark"></i>

            </button>

          </div>

        </div>


        <!-- =================================================
             FORM
        ================================================== -->

        <%= form_with(
          url: submit_course_quiz_path(
            @course,
            @quiz
          ),
          method: :post,
          id: "quizForm"
        ) do %>


          <%= hidden_field_tag(
            :attempt_id,
            @attempt.id
          ) %>


          <!-- =================================================
               QUESTION BODY
          ================================================== -->

          <div class="quiz-question-body">


            <% @questions.each_with_index do |question, index| %>


              <div
                class="quiz-question-block"
                data-question-index="<%= index %>"
                data-question-id="<%= question.id %>"
                data-marks="<%= question.marks.to_d %>"
                style="<%= index == 0 ? '' : 'display:none;' %>">


                <div class="quiz-question-label">

                  Question <%= index + 1 %>

                </div>


                <div class="quiz-question-text">

                  <%= question.question_text %>

                </div>


                <!-- OPTIONS -->

                <div class="quiz-options">


                  <% question.options
                             .order(:position, :id)
                             .each_with_index do |option, option_index| %>


                    <label
                      class="quiz-option"
                      data-option-label>


                      <%= radio_button_tag(
                        "answers[#{question.id}]",
                        option.id,
                        false,
                        class: "quiz-radio",
                        data: {
                          question_id: question.id
                        }
                      ) %>


                      <span class="quiz-option-letter">

                        <%= (
                          "A".ord + option_index
                        ).chr %>

                      </span>


                      <span class="quiz-option-text">

                        <%= option.option_text %>

                      </span>


                    </label>


                  <% end %>


                </div>


              </div>


            <% end %>


          </div>


          <!-- =================================================
               QUESTION ACTIONS
          ================================================== -->

          <div class="quiz-question-actions">


            <button
              type="button"
              class="quiz-action-btn quiz-prev-btn"
              id="prevBtn">

              <i class="fas fa-arrow-left"></i>

              Previous

            </button>


            <button
              type="button"
              class="quiz-action-btn quiz-next-btn"
              id="nextBtn">

              Save & Next

              <i class="fas fa-arrow-right"></i>

            </button>


            <button
              type="submit"
              class="quiz-action-btn quiz-submit-btn"
              id="submitBtn"
              style="display:none;">

              <i class="fas fa-check-circle"></i>

              Save & Submit

            </button>


          </div>


        <% end %>

      </section>


      <!-- =================================================
           RIGHT SIDEBAR
      ================================================== -->

      <aside class="quiz-sidebar">


        <!-- =================================================
             TEST PROGRESS
        ================================================== -->

        <div class="quiz-sidebar-card quiz-progress-card">


          <div class="quiz-sidebar-title-row">


            <h3 class="quiz-sidebar-title">

              Test Progress

            </h3>


            <span
              class="quiz-progress-percent"
              id="progressPercent">

              0%

            </span>

          </div>


          <div class="quiz-progress-track">

            <div
              class="quiz-progress-fill"
              id="progressFill">
            </div>

          </div>


          <div class="quiz-stats">


            <div class="quiz-stat">

              <strong id="answeredCount">
                0
              </strong>

              <span>
                Answered
              </span>

            </div>


            <div class="quiz-stat">

              <strong id="remainingCount">
                <%= @questions.count %>
              </strong>

              <span>
                Remaining
              </span>

            </div>


            <div class="quiz-stat">

              <strong>
                <%= @questions.count %>
              </strong>

              <span>
                Total
              </span>

            </div>


          </div>

        </div>


        <!-- =================================================
             QUESTION PALETTE
        ================================================== -->

        <div class="quiz-sidebar-card">


          <div class="quiz-palette-header">

            <h3 class="quiz-palette-title">

              Question Palette

            </h3>

          </div>


          <!-- LEGEND -->

          <div class="quiz-palette-legend">


            <div class="quiz-legend-item">

              <span
                class="quiz-legend-box answered">
              </span>

              Answered

            </div>


            <div class="quiz-legend-item">

              <span
                class="quiz-legend-box current">
              </span>

              Current

            </div>


            <div class="quiz-legend-item">

              <span
                class="quiz-legend-box unanswered">
              </span>

              Unanswered

            </div>


            <div class="quiz-legend-item">

              <span
                class="quiz-legend-box bookmarked">
              </span>

              Bookmarked

            </div>


          </div>


          <!-- ALL QUESTIONS -->

          <div class="quiz-all-questions">


            <div class="quiz-all-label">

              All Questions

            </div>


            <div class="quiz-palette-grid">


              <% @questions.each_with_index do |question, index| %>


                <button
                  type="button"
                  class="quiz-palette-number <%= 'current' if index == 0 %>"
                  data-question-index="<%= index %>"
                  title="Question <%= index + 1 %>">

                  <%= index + 1 %>

                </button>


              <% end %>


            </div>

          </div>

        </div>


        <!-- =================================================
             SIDEBAR ACTIONS
        ================================================== -->

        <div class="quiz-sidebar-card quiz-bottom-actions">


          <button
            type="button"
            class="quiz-paper-btn"
            id="questionPaperBtn">

            <i class="fas fa-file-alt"></i>

            Question Paper

          </button>


          <button
            type="button"
            class="quiz-sidebar-submit"
            id="sidebarSubmitBtn">

            <i class="fas fa-check-circle"></i>

            Submit Test

          </button>

        </div>


      </aside>


    </div>

  </main>

</div>


<!-- =========================================================
     SUBMIT CONFIRMATION MODAL
========================================================= -->

<div
  class="quiz-submit-overlay"
  id="submitOverlay">


  <div class="quiz-submit-modal">


    <div class="quiz-submit-modal-icon">

      <i class="fas fa-paper-plane"></i>

    </div>


    <h3>
      Submit Test?
    </h3>


    <p>
      Please check your answers before submitting.
      Once submitted, you cannot change your answers.
    </p>


    <div class="quiz-submit-summary">


      <div class="quiz-submit-summary-item">

        <strong id="modalTotal">
          <%= @questions.count %>
        </strong>

        <span>
          Total
        </span>

      </div>


      <div class="quiz-submit-summary-item">

        <strong id="modalAnswered">
          0
        </strong>

        <span>
          Answered
        </span>

      </div>


      <div class="quiz-submit-summary-item">

        <strong id="modalUnanswered">
          <%= @questions.count %>
        </strong>

        <span>
          Unanswered
        </span>

      </div>


    </div>


    <div class="quiz-modal-actions">


      <button
        type="button"
        class="quiz-modal-cancel"
        id="cancelSubmitBtn">

        Cancel

      </button>


      <button
        type="button"
        class="quiz-modal-confirm"
        id="confirmSubmitBtn">

        Submit Test

      </button>


    </div>


  </div>

</div>

<script nonce="<%= content_security_policy_nonce %>">
(() => {

  function initializeQuizExam() {

    /* =====================================================
       CLEANUP PREVIOUS INSTANCE
    ===================================================== */

    if (typeof window.__quizExamCleanup === "function") {
      window.__quizExamCleanup();
      window.__quizExamCleanup = null;
    }


    /* =====================================================
       ELEMENTS
    ===================================================== */

    const page =
      document.querySelector(".quiz-exam-page");

    if (!page) {
      return;
    }


    const questionBlocks =
      Array.from(
        page.querySelectorAll(
          ".quiz-question-block"
        )
      );


    const paletteButtons =
      Array.from(
        page.querySelectorAll(
          ".quiz-palette-number"
        )
      );


    const optionLabels =
      Array.from(
        page.querySelectorAll(
          ".quiz-option"
        )
      );


    const prevBtn =
      page.querySelector("#prevBtn");


    const nextBtn =
      page.querySelector("#nextBtn");


    const submitBtn =
      page.querySelector("#submitBtn");


    const sidebarSubmitBtn =
      page.querySelector("#sidebarSubmitBtn");


    const bookmarkBtn =
      page.querySelector("#bookmarkBtn");


    const quizForm =
      page.querySelector("#quizForm");


    const timer =
      page.querySelector("#quizTimer");


    const answeredCount =
      page.querySelector("#answeredCount");


    const remainingCount =
      page.querySelector("#remainingCount");


    const progressFill =
      page.querySelector("#progressFill");


    const progressPercent =
      page.querySelector("#progressPercent");


    const currentQuestionNumber =
      page.querySelector("#currentQuestionNumber");


    const currentQuestionHeading =
      page.querySelector("#currentQuestionHeading");


    const currentQuestionMarks =
      page.querySelector("#currentQuestionMarks");


    const questionPaperBtn =
      page.querySelector("#questionPaperBtn");


    const questionElapsedTime =
      page.querySelector("#questionElapsedTime");


    const submitOverlay =
      page.querySelector("#submitOverlay");


    const cancelSubmitBtn =
      page.querySelector("#cancelSubmitBtn");


    const confirmSubmitBtn =
      page.querySelector("#confirmSubmitBtn");


    const modalAnswered =
      page.querySelector("#modalAnswered");


    const modalUnanswered =
      page.querySelector("#modalUnanswered");


    if (
      !questionBlocks.length ||
      !quizForm
    ) {
      return;
    }


    /* =====================================================
       STATE
    ===================================================== */

    let currentQuestion = 0;

    let submitted = false;

    let questionStartedAt =
      Date.now();

    let remainingSeconds =
      <%= @quiz.time_limit.to_i * 60 %>;


    let timerInterval = null;

    let questionElapsedInterval = null;


    const bookmarkedQuestions =
      new Set();


    /* =====================================================
       HELPER
    ===================================================== */

    function getSelectedRadio(questionBlock) {

      if (!questionBlock) {
        return null;
      }

      return questionBlock.querySelector(
        "input[type='radio']:checked"
      );

    }


    function isQuestionAnswered(index) {

      const question =
        questionBlocks[index];

      return !!getSelectedRadio(
        question
      );

    }


    /* =====================================================
       OPTION STYLES
    ===================================================== */

    function updateOptionStyles() {

      optionLabels.forEach(
        function(label) {

          const radio =
            label.querySelector(
              "input[type='radio']"
            );

          if (!radio) {
            return;
          }

          label.classList.toggle(
            "selected",
            radio.checked
          );

        }
      );

    }


    /* =====================================================
       ANSWERED STATUS
    ===================================================== */

    function updateAnswered() {

      let answered = 0;


      questionBlocks.forEach(
        function(question, index) {

          const selected =
            getSelectedRadio(
              question
            );


          if (selected) {
            answered++;
          }


          if (paletteButtons[index]) {

            paletteButtons[index]
              .classList.toggle(
                "answered",
                !!selected
              );

          }

        }
      );


      const total =
        questionBlocks.length;


      const remaining =
        total - answered;


      const percentage =
        total > 0
          ? Math.round(
              (answered / total) * 100
            )
          : 0;


      if (answeredCount) {
        answeredCount.textContent =
          answered;
      }


      if (remainingCount) {
        remainingCount.textContent =
          remaining;
      }


      if (progressPercent) {
        progressPercent.textContent =
          percentage + "%";
      }


      if (progressFill) {
        progressFill.style.width =
          percentage + "%";
      }


      if (modalAnswered) {
        modalAnswered.textContent =
          answered;
      }


      if (modalUnanswered) {
        modalUnanswered.textContent =
          remaining;
      }

    }


    /* =====================================================
       PALETTE
    ===================================================== */

    function updatePalette() {

      paletteButtons.forEach(
        function(button, index) {

          button.classList.toggle(
            "current",
            index === currentQuestion
          );


          button.classList.toggle(
            "bookmarked",
            bookmarkedQuestions.has(index)
          );

        }
      );

    }


    /* =====================================================
       QUESTION HEADER
    ===================================================== */

    function updateQuestionHeader() {

      const question =
        questionBlocks[
          currentQuestion
        ];


      if (!question) {
        return;
      }


      const number =
        currentQuestion + 1;


      const marks =
        parseFloat(
          question.dataset.marks || "1"
        );


      if (currentQuestionNumber) {

        currentQuestionNumber.textContent =
          number;

      }


      if (currentQuestionHeading) {

        currentQuestionHeading.textContent =
          "Question " +
          number +
          " of " +
          questionBlocks.length;

      }


      if (currentQuestionMarks) {

        currentQuestionMarks.textContent =
          "+" +
          marks.toFixed(
            marks % 1 === 0 ? 1 : 2
          ) +
          " Marks";

      }

    }


    /* =====================================================
       BOOKMARK BUTTON
    ===================================================== */

    function updateBookmarkButton() {

      if (!bookmarkBtn) {
        return;
      }


      const isBookmarked =
        bookmarkedQuestions.has(
          currentQuestion
        );


      bookmarkBtn.classList.toggle(
        "bookmarked",
        isBookmarked
      );


      bookmarkBtn.innerHTML =
        isBookmarked
          ? '<i class="fas fa-bookmark"></i>'
          : '<i class="far fa-bookmark"></i>';

    }


    /* =====================================================
       QUESTION ELAPSED TIME
    ===================================================== */

    function updateQuestionElapsed() {

      if (!questionElapsedTime) {
        return;
      }


      const seconds =
        Math.floor(
          (
            Date.now() -
            questionStartedAt
          ) / 1000
        );


      const minutes =
        Math.floor(
          seconds / 60
        );


      const remaining =
        seconds % 60;


      questionElapsedTime.textContent =
        String(minutes).padStart(2, "0") +
        ":" +
        String(remaining).padStart(2, "0");

    }


    /* =====================================================
       SHOW QUESTION
    ===================================================== */

    function showQuestion(index) {

      if (
        index < 0 ||
        index >= questionBlocks.length
      ) {
        return;
      }


      /* Save visible elapsed time */

      updateQuestionElapsed();


      currentQuestion =
        index;


      questionStartedAt =
        Date.now();


      questionBlocks.forEach(
        function(question, i) {

          question.style.display =
            i === index
              ? "block"
              : "none";

        }
      );


      updateQuestionHeader();

      updatePalette();

      updateBookmarkButton();

      updateOptionStyles();

      updateAnswered();


      if (prevBtn) {

        prevBtn.disabled =
          index === 0;

      }


      if (
        index ===
        questionBlocks.length - 1
      ) {

        if (nextBtn) {
          nextBtn.style.display =
            "none";
        }


        if (submitBtn) {
          submitBtn.style.display =
            "inline-flex";
        }

      }
      else {

        if (nextBtn) {
          nextBtn.style.display =
            "inline-flex";
        }


        if (submitBtn) {
          submitBtn.style.display =
            "none";
        }

      }

    }


    /* =====================================================
       SUBMIT MODAL
    ===================================================== */

    function openSubmitModal() {

      updateAnswered();


      if (submitOverlay) {

        submitOverlay.classList.add(
          "show"
        );

      }

    }


    function closeSubmitModal() {

      if (submitOverlay) {

        submitOverlay.classList.remove(
          "show"
        );

      }

    }


    /* =====================================================
       OPTION CLICK
    ===================================================== */

    optionLabels.forEach(
      function(label) {

        label.addEventListener(
          "click",
          function() {

            const radio =
              label.querySelector(
                "input[type='radio']"
              );


            if (!radio) {
              return;
            }


            radio.checked =
              true;


            const question =
              label.closest(
                ".quiz-question-block"
              );


            if (question) {

              question
                .querySelectorAll(
                  ".quiz-option"
                )
                .forEach(
                  function(item) {

                    item.classList.remove(
                      "selected"
                    );

                  }
                );

            }


            label.classList.add(
              "selected"
            );


            updateAnswered();

          }
        );

      }
    );


    /* =====================================================
       SAVE & NEXT
    ===================================================== */

    if (nextBtn) {

      nextBtn.addEventListener(
        "click",
        function() {

          if (submitted) {
            return;
          }


          updateAnswered();


          if (
            currentQuestion <
            questionBlocks.length - 1
          ) {

            showQuestion(
              currentQuestion + 1
            );

          }

        }
      );

    }


    /* =====================================================
       PREVIOUS
    ===================================================== */

    if (prevBtn) {

      prevBtn.addEventListener(
        "click",
        function() {

          if (submitted) {
            return;
          }


          if (
            currentQuestion > 0
          ) {

            showQuestion(
              currentQuestion - 1
            );

          }

        }
      );

    }


    /* =====================================================
       PALETTE NAVIGATION
    ===================================================== */

    paletteButtons.forEach(
      function(button) {

        button.addEventListener(
          "click",
          function() {

            if (submitted) {
              return;
            }


            const index =
              parseInt(
                button.dataset.questionIndex,
                10
              );


            if (
              Number.isNaN(index)
            ) {
              return;
            }


            showQuestion(index);

          }
        );

      }
    );


    /* =====================================================
       BOOKMARK
    ===================================================== */

    if (bookmarkBtn) {

      bookmarkBtn.addEventListener(
        "click",
        function() {

          if (submitted) {
            return;
          }


          if (
            bookmarkedQuestions.has(
              currentQuestion
            )
          ) {

            bookmarkedQuestions.delete(
              currentQuestion
            );

          }
          else {

            bookmarkedQuestions.add(
              currentQuestion
            );

          }


          updateBookmarkButton();

          updatePalette();

        }
      );

    }


    /* =====================================================
       QUESTION PAPER
    ===================================================== */

    if (questionPaperBtn) {

      questionPaperBtn.addEventListener(
        "click",
        function() {

          if (submitted) {
            return;
          }


          const firstUnanswered =
            questionBlocks.findIndex(
              function(question) {

                return !getSelectedRadio(
                  question
                );

              }
            );


          if (
            firstUnanswered >= 0
          ) {

            showQuestion(
              firstUnanswered
            );

          }
          else {

            showQuestion(0);

          }

        }
      );

    }


    /* =====================================================
       SIDEBAR SUBMIT
    ===================================================== */

    if (sidebarSubmitBtn) {

      sidebarSubmitBtn.addEventListener(
        "click",
        function() {

          if (submitted) {
            return;
          }


          openSubmitModal();

        }
      );

    }


    /* =====================================================
       SUBMIT BUTTON
    ===================================================== */

    if (submitBtn) {

      submitBtn.addEventListener(
        "click",
        function(event) {

          event.preventDefault();


          if (submitted) {
            return;
          }


          openSubmitModal();

        }
      );

    }


    /* =====================================================
       CANCEL SUBMIT
    ===================================================== */

    if (cancelSubmitBtn) {

      cancelSubmitBtn.addEventListener(
        "click",
        function() {

          closeSubmitModal();

        }
      );

    }


    /* =====================================================
       CONFIRM SUBMIT
    ===================================================== */

    if (confirmSubmitBtn) {

      confirmSubmitBtn.addEventListener(
        "click",
        function() {

          if (submitted) {
            return;
          }


          submitted = true;


          confirmSubmitBtn.disabled =
            true;


          confirmSubmitBtn.innerHTML =
            '<i class="fas fa-spinner fa-spin"></i> Submitting...';


          if (submitBtn) {

            submitBtn.disabled =
              true;

          }


          if (sidebarSubmitBtn) {

            sidebarSubmitBtn.disabled =
              true;

          }


          clearInterval(
            timerInterval
          );


          clearInterval(
            questionElapsedInterval
          );


          /*
            Native submission bypasses
            the submit event handler.
          */

          HTMLFormElement.prototype.submit.call(
            quizForm
          );

        }
      );

    }


    /* =====================================================
       ESCAPE KEY
    ===================================================== */

    function handleKeydown(event) {

      if (
        event.key === "Escape"
      ) {

        closeSubmitModal();

      }

    }


    document.addEventListener(
      "keydown",
      handleKeydown
    );


    /* =====================================================
       TIMER
    ===================================================== */

    function updateTimer() {

      if (!timer) {
        return;
      }


      const minutes =
        Math.floor(
          remainingSeconds / 60
        );


      const seconds =
        remainingSeconds % 60;


      timer.textContent =
        String(minutes).padStart(2, "0") +
        ":" +
        String(seconds).padStart(2, "0");


      timer.classList.remove(
        "timer-warning",
        "timer-danger"
      );


      /* 5 MINUTE WARNING */

      if (
        remainingSeconds <= 300 &&
        remainingSeconds > 60
      ) {

        timer.classList.add(
          "timer-warning"
        );

      }


      /* LAST MINUTE */

      if (
        remainingSeconds <= 60 &&
        remainingSeconds > 0
      ) {

        timer.classList.add(
          "timer-danger"
        );

      }


      /* TIME OVER */

      if (
        remainingSeconds <= 0
      ) {

        clearInterval(
          timerInterval
        );


        if (submitted) {
          return;
        }


        submitted = true;


        if (submitBtn) {

          submitBtn.disabled =
            true;

        }


        if (sidebarSubmitBtn) {

          sidebarSubmitBtn.disabled =
            true;

        }


        alert(
          "Time is over. Your quiz will be submitted automatically."
        );


        HTMLFormElement.prototype.submit.call(
          quizForm
        );


        return;

      }


      remainingSeconds--;

    }


    /* =====================================================
       INITIALIZE
    ===================================================== */

    updateTimer();


    timerInterval =
      setInterval(
        updateTimer,
        1000
      );


    questionElapsedInterval =
      setInterval(
        updateQuestionElapsed,
        1000
      );


    showQuestion(0);

    updateAnswered();

    updatePalette();

    updateBookmarkButton();

    updateOptionStyles();


    /* =====================================================
       CLEANUP FOR TURBO
    ===================================================== */

    window.__quizExamCleanup =
      function() {

        clearInterval(
          timerInterval
        );


        clearInterval(
          questionElapsedInterval
        );


        document.removeEventListener(
          "keydown",
          handleKeydown
        );

      };

  }


  /* =======================================================
     TURBO LOAD
  ======================================================= */

  if (
    !window.__quizExamTurboListenerInstalled
  ) {

    window.__quizExamTurboListenerInstalled =
      true;


    document.addEventListener(
      "turbo:load",
      initializeQuizExam
    );


    document.addEventListener(
      "turbo:before-cache",
      function() {

        if (
          typeof window.__quizExamCleanup ===
          "function"
        ) {

          window.__quizExamCleanup();

          window.__quizExamCleanup =
            null;

        }

      }
    );

  }


  /* =======================================================
     INITIAL LOAD SAFETY
  ======================================================= */

  if (
    document.readyState !== "loading"
  ) {

    initializeQuizExam();

  }

})();
</script>