<% content_for :show_layout, true %>

<style>
/* =========================================================
   A ONE GS CENTER - QUIZ ATTEMPT
   LIGHT + TRANSPARENT / GLASS THEME
========================================================= */

.quiz-page {
  min-height: 100vh;
  padding: 35px 20px 60px;

  color: #1f2937;

  background:
    radial-gradient(
      circle at 10% 10%,
      rgba(59, 130, 246, 0.10),
      transparent 30%
    ),
    radial-gradient(
      circle at 90% 20%,
      rgba(14, 165, 233, 0.08),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      #f8fafc,
      #eef6ff 50%,
      #f8fafc
    );
}


/* =========================================================
   HEADER
========================================================= */

.quiz-header {
  max-width: 1200px;
  margin: 0 auto 25px;

  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 20px;
}

.quiz-title-box {
  flex: 1;
}

.quiz-title-box h1 {
  margin: 0;

  font-size: 30px;
  font-weight: 800;

  color: #172033;
}

.quiz-title-box p {
  margin: 8px 0 0;

  color: #64748b;
  font-size: 15px;
}


/* =========================================================
   TIMER
========================================================= */

.quiz-timer {
  min-width: 170px;

  padding: 14px 22px;

  text-align: center;

  border-radius: 15px;

  background: rgba(255, 255, 255, 0.55);

  border: 1px solid rgba(255, 255, 255, 0.75);

  box-shadow:
    0 8px 30px rgba(15, 23, 42, 0.08);

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.quiz-timer span {
  display: block;

  margin-bottom: 4px;

  color: #64748b;

  font-size: 11px;
  font-weight: 700;

  text-transform: uppercase;
  letter-spacing: 1px;
}

#quizTimer {
  font-size: 26px;
  font-weight: 800;

  color: #2563eb;
}


/* =========================================================
   MAIN LAYOUT
========================================================= */

.quiz-layout {
  max-width: 1200px;
  margin: auto;

  display: grid;

  grid-template-columns: 250px minmax(0, 1fr);

  gap: 22px;
}


/* =========================================================
   QUESTION NAVIGATION
========================================================= */

.question-nav {

  height: fit-content;

  padding: 20px;

  border-radius: 18px;

  background: rgba(255, 255, 255, 0.48);

  border: 1px solid rgba(255, 255, 255, 0.8);

  box-shadow:
    0 10px 35px rgba(15, 23, 42, 0.07);

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);

  position: sticky;
  top: 20px;
}

.question-nav h3 {
  margin: 0 0 7px;

  color: #172033;

  font-size: 18px;
  font-weight: 800;
}

.progress-text {
  margin-bottom: 17px;

  color: #64748b;

  font-size: 13px;
}


/* =========================================================
   QUESTION NUMBERS
========================================================= */

.question-numbers {
  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 8px;
}

.question-number {

  width: 100%;
  aspect-ratio: 1;

  border-radius: 10px;

  border: 1px solid rgba(148, 163, 184, 0.30);

  background: rgba(255, 255, 255, 0.55);

  color: #475569;

  font-size: 14px;
  font-weight: 700;

  cursor: pointer;

  transition:
    transform .2s ease,
    background .2s ease,
    border-color .2s ease,
    box-shadow .2s ease;
}

.question-number:hover {

  transform: translateY(-2px);

  border-color: rgba(37, 99, 235, 0.45);

  background: rgba(255, 255, 255, 0.85);

  box-shadow:
    0 5px 15px rgba(37, 99, 235, 0.10);
}

.question-number.active {

  background: rgba(37, 99, 235, 0.90);

  color: #ffffff;

  border-color: #2563eb;

  box-shadow:
    0 5px 15px rgba(37, 99, 235, 0.20);
}

.question-number.answered {

  background: rgba(34, 197, 94, 0.15);

  color: #15803d;

  border-color: rgba(34, 197, 94, 0.45);
}

.question-number.active.answered {

  background: #2563eb;

  color: #ffffff;

  border-color: #2563eb;
}


/* =========================================================
   QUIZ CARD
========================================================= */

.quiz-card {

  min-width: 0;

  padding: 30px;

  border-radius: 20px;

  background: rgba(255, 255, 255, 0.50);

  border: 1px solid rgba(255, 255, 255, 0.85);

  box-shadow:
    0 15px 50px rgba(15, 23, 42, 0.08);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}


/* =========================================================
   PROGRESS
========================================================= */

.quiz-progress {

  width: 100%;
  height: 7px;

  margin-bottom: 27px;

  overflow: hidden;

  border-radius: 20px;

  background: rgba(148, 163, 184, 0.18);
}

.quiz-progress-bar {

  height: 100%;

  width: 0%;

  border-radius: 20px;

  background:
    linear-gradient(
      90deg,
      #2563eb,
      #38bdf8
    );

  transition:
    width .35s ease;
}


/* =========================================================
   QUESTION
========================================================= */

.question-meta {

  display: flex;

  justify-content: space-between;
  align-items: center;

  gap: 15px;

  margin-bottom: 20px;

  color: #64748b;

  font-size: 14px;
}

.question-marks {

  padding: 6px 12px;

  border-radius: 20px;

  background: rgba(37, 99, 235, 0.08);

  border: 1px solid rgba(37, 99, 235, 0.18);

  color: #2563eb;

  font-size: 13px;
  font-weight: 700;
}

.question-text {

  margin-bottom: 25px;

  color: #172033;

  font-size: 23px;
  line-height: 1.55;

  font-weight: 750;
}


/* =========================================================
   OPTIONS
========================================================= */

.option-list {

  display: grid;

  gap: 13px;
}

.option-label {

  display: flex;

  align-items: center;

  gap: 15px;

  padding: 17px 18px;

  border-radius: 13px;

  border: 1px solid rgba(148, 163, 184, 0.28);

  background: rgba(255, 255, 255, 0.42);

  cursor: pointer;

  transition:
    transform .2s ease,
    background .2s ease,
    border-color .2s ease,
    box-shadow .2s ease;
}

.option-label:hover {

  transform: translateX(3px);

  background: rgba(255, 255, 255, 0.75);

  border-color: rgba(37, 99, 235, 0.35);

  box-shadow:
    0 5px 20px rgba(15, 23, 42, 0.06);
}

.option-label.selected {

  background: rgba(37, 99, 235, 0.08);

  border-color: rgba(37, 99, 235, 0.55);

  box-shadow:
    0 0 0 2px rgba(37, 99, 235, 0.08);
}

.option-radio {

  width: 20px;
  height: 20px;

  flex-shrink: 0;

  accent-color: #2563eb;

  cursor: pointer;
}

.option-text {

  color: #334155;

  font-size: 16px;

  line-height: 1.5;
}


/* =========================================================
   ACTION BUTTONS
========================================================= */

.quiz-actions {

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 12px;

  margin-top: 35px;

  padding-top: 22px;

  border-top:
    1px solid rgba(148, 163, 184, 0.20);
}

.quiz-btn {

  border: 0;

  padding: 12px 23px;

  border-radius: 10px;

  font-size: 14px;

  font-weight: 700;

  cursor: pointer;

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    background .2s ease;
}

.quiz-btn:hover {

  transform: translateY(-2px);
}


/* PREVIOUS */

.btn-prev {

  background: rgba(226, 232, 240, 0.75);

  color: #475569;

  border:
    1px solid rgba(148, 163, 184, 0.25);
}

.btn-prev:hover {

  background: rgba(226, 232, 240, 1);

  box-shadow:
    0 5px 15px rgba(15, 23, 42, 0.08);
}


/* NEXT */

.btn-next {

  background: #2563eb;

  color: #ffffff;

  box-shadow:
    0 5px 15px rgba(37, 99, 235, 0.18);
}

.btn-next:hover {

  background: #1d4ed8;

  box-shadow:
    0 8px 20px rgba(37, 99, 235, 0.25);
}


/* SUBMIT */

.btn-submit {

  background: #16a34a;

  color: #ffffff;

  box-shadow:
    0 5px 15px rgba(22, 163, 74, 0.18);
}

.btn-submit:hover {

  background: #15803d;

  box-shadow:
    0 8px 20px rgba(22, 163, 74, 0.25);
}


/* =========================================================
   TIMER WARNING
========================================================= */

.timer-warning {

  color: #d97706 !important;
}

.timer-danger {

  color: #dc2626 !important;

  animation:
    timerPulse 1s infinite;
}

@keyframes timerPulse {

  50% {
    opacity: .55;
  }
}


/* =========================================================
   EMPTY QUIZ
========================================================= */

.quiz-empty {

  padding: 50px 20px;

  text-align: center;

  color: #64748b;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 900px) {

  .quiz-layout {

    grid-template-columns: 1fr;
  }

  .question-nav {

    position: static;
  }

  .question-numbers {

    grid-template-columns: repeat(8, 1fr);
  }
}


@media (max-width: 600px) {

  .quiz-page {

    padding: 20px 12px 40px;
  }

  .quiz-header {

    flex-direction: column;

    align-items: stretch;
  }

  .quiz-title-box h1 {

    font-size: 24px;
  }

  .quiz-timer {

    width: auto;
  }

  .quiz-card {

    padding: 20px;
  }

  .question-text {

    font-size: 19px;
  }

  .question-numbers {

    grid-template-columns: repeat(5, 1fr);
  }

  .question-meta {

    align-items: flex-start;

    flex-direction: column;
  }

  .quiz-actions {

    flex-wrap: wrap;
  }

  .quiz-btn {

    flex: 1;

    min-width: 120px;
  }
}
</style>


<div class="quiz-page">

  <!-- =====================================================
       HEADER
  ====================================================== -->

  <div class="quiz-header">

    <div class="quiz-title-box">

      <h1>
        📝 <%= @quiz.title %>
      </h1>

      <% if @quiz.description.present? %>

        <p>
          <%= @quiz.description %>
        </p>

      <% end %>

    </div>


    <div class="quiz-timer">

      <span>
        Time Remaining
      </span>

      <strong id="quizTimer">
        <%= @quiz.time_limit.to_i %>:00
      </strong>

    </div>

  </div>


  <!-- =====================================================
       MAIN LAYOUT
  ====================================================== -->

  <div class="quiz-layout">


    <!-- ===================================================
         QUESTION NAVIGATION
    ==================================================== -->

    <aside class="question-nav">

      <h3>
        Questions
      </h3>

      <div class="progress-text">

        <span id="answeredCount">
          0
        </span>

        /

        <%= @questions.count %>

        answered

      </div>


      <div class="question-numbers">

        <% @questions.each_with_index do |question, index| %>

          <button
            type="button"
            class="question-number <%= 'active' if index == 0 %>"
            data-question="<%= index %>">

            <%= index + 1 %>

          </button>

        <% end %>

      </div>

    </aside>


    <!-- ===================================================
         QUIZ CONTENT
    ==================================================== -->

    <main class="quiz-card">

      <%= form_with(
      url: submit_course_quiz_path(@course, @quiz),
      method: :post,
      id: "quizForm"
    ) do %>
    <%= hidden_field_tag :attempt_id, @attempt.id %>


        <!-- PROGRESS BAR -->

        <div class="quiz-progress">

          <div
            class="quiz-progress-bar"
            id="progressBar">
          </div>

        </div>


        <!-- =================================================
             QUESTIONS
        ================================================== -->

        <% @questions.each_with_index do |question, index| %>

          <div
            class="question-block"
            data-question="<%= index %>"
            style="<%= index == 0 ? '' : 'display:none;' %>">


            <div class="question-meta">

              <span>

                Question
                <%= index + 1 %>

                of

                <%= @questions.count %>

              </span>


              <span class="question-marks">

                <%= question.marks.to_i %>

                <%= question.marks.to_i == 1 ? "mark" : "marks" %>

              </span>

            </div>


            <div class="question-text">

              <%= question.question_text %>

            </div>


            <!-- OPTIONS -->

            <div class="option-list">

              <% question.options.each do |option| %>

                <label
                  class="option-label"
                  data-option-label>

                  <%= radio_button_tag(
                        "answers[#{question.id}]",
                        option.id,
                        false,
                        class: "option-radio",
                        data: {
                          question_id: question.id
                        }
                      ) %>

                  <span class="option-text">

                    <%= option.option_text %>

                  </span>

                </label>

              <% end %>

            </div>

          </div>

        <% end %>


        <!-- =================================================
             ACTION BUTTONS
        ================================================== -->

        <div class="quiz-actions">

          <button
            type="button"
            class="quiz-btn btn-prev"
            id="prevBtn">

            ← Previous

          </button>


          <button
            type="button"
            class="quiz-btn btn-next"
            id="nextBtn">

            Next →

          </button>


          <button
            type="submit"
            class="quiz-btn btn-submit"
            id="submitBtn"
            style="display:none;">

            ✓ Submit Quiz

          </button>

        </div>


      <% end %>

    </main>

  </div>

</div>


<script>
document.addEventListener("DOMContentLoaded", function () {

  /* =====================================================
     ELEMENTS
  ===================================================== */

  const questions =
    Array.from(
      document.querySelectorAll(".question-block")
    );

  const questionButtons =
    Array.from(
      document.querySelectorAll(".question-number")
    );

  const prevBtn =
    document.getElementById("prevBtn");

  const nextBtn =
    document.getElementById("nextBtn");

  const submitBtn =
    document.getElementById("submitBtn");

  const progressBar =
    document.getElementById("progressBar");

  const answeredCount =
    document.getElementById("answeredCount");

  const quizForm =
    document.getElementById("quizForm");

  const timer =
    document.getElementById("quizTimer");


  /* =====================================================
     SAFETY
  ===================================================== */

  if (!questions.length) {
    return;
  }


  /* =====================================================
     STATE
  ===================================================== */

  let currentQuestion = 0;


  /* =====================================================
     SHOW QUESTION
  ===================================================== */

  function showQuestion(index) {

    if (
      index < 0 ||
      index >= questions.length
    ) {
      return;
    }


    currentQuestion = index;


    questions.forEach(function(question, i) {

      question.style.display =
        i === index
          ? "block"
          : "none";

    });


    questionButtons.forEach(function(button, i) {

      button.classList.toggle(
        "active",
        i === index
      );

    });


    /* Progress */

    const progress =
      ((index + 1) /
        questions.length) * 100;

    progressBar.style.width =
      progress + "%";


    /* Previous */

    prevBtn.style.display =
      index === 0
        ? "none"
        : "block";


    /* Next */

    nextBtn.style.display =
      index === questions.length - 1
        ? "none"
        : "block";


    /* Submit */

    submitBtn.style.display =
      index === questions.length - 1
        ? "block"
        : "none";

  }


  /* =====================================================
     NEXT
  ===================================================== */

  nextBtn.addEventListener(
    "click",
    function () {

      if (
        currentQuestion <
        questions.length - 1
      ) {

        showQuestion(
          currentQuestion + 1
        );

      }

    }
  );


  /* =====================================================
     PREVIOUS
  ===================================================== */

  prevBtn.addEventListener(
    "click",
    function () {

      if (currentQuestion > 0) {

        showQuestion(
          currentQuestion - 1
        );

      }

    }
  );


  /* =====================================================
     QUESTION NUMBERS
  ===================================================== */

  questionButtons.forEach(
    function(button) {

      button.addEventListener(
        "click",
        function () {

          const index =
            parseInt(
              button.dataset.question,
              10
            );

          showQuestion(index);

        }
      );

    }
  );


  /* =====================================================
     OPTION SELECTION
  ===================================================== */

  document
    .querySelectorAll(".option-label")
    .forEach(function(label) {

      label.addEventListener(
        "click",
        function () {

          const radio =
            label.querySelector(
              "input[type='radio']"
            );

          if (!radio) {
            return;
          }


          const optionList =
            label.closest(
              ".option-list"
            );

          if (optionList) {

            optionList
              .querySelectorAll(
                ".option-label"
              )
              .forEach(function(item) {

                item.classList.remove(
                  "selected"
                );

              });

          }


          label.classList.add(
            "selected"
          );


          updateAnswered();

        }
      );

    });


  /* =====================================================
     UPDATE ANSWERED COUNT
  ===================================================== */

  function updateAnswered() {

    let count = 0;


    questions.forEach(
      function(question, index) {

        const selected =
          question.querySelector(
            "input[type='radio']:checked"
          );


        if (selected) {

          count++;

          if (questionButtons[index]) {

            questionButtons[index]
              .classList.add(
                "answered"
              );

          }

        }
        else {

          if (questionButtons[index]) {

            questionButtons[index]
              .classList.remove(
                "answered"
              );

          }

        }

      }
    );


    answeredCount.textContent =
      count;

  }


  /* =====================================================
     SUBMIT CONFIRMATION
  ===================================================== */

  quizForm.addEventListener(
    "submit",
    function(event) {

      const answered =
        quizForm.querySelectorAll(
          "input[type='radio']:checked"
        ).length;


      const unanswered =
        questions.length -
        answered;


      let message =
        "Are you sure you want to submit the quiz?";


      if (unanswered > 0) {

        message +=
          "\n\nYou have " +
          unanswered +
          " unanswered question(s).";

      }


      if (!confirm(message)) {

        event.preventDefault();

      }

    }
  );


  /* =====================================================
     TIMER
  ===================================================== */

  let remainingSeconds =
    <%= @quiz.time_limit.to_i * 60 %>;


  function updateTimer() {

    const minutes =
      Math.floor(
        remainingSeconds / 60
      );

    const seconds =
      remainingSeconds % 60;


    timer.textContent =
      String(minutes).padStart(2, "0") +
      ":" +
      String(seconds).padStart(2, "0");


    /* Remove previous states */

    timer.classList.remove(
      "timer-warning",
      "timer-danger"
    );


    /* Warning */

    if (
      remainingSeconds <= 300 &&
      remainingSeconds > 60
    ) {

      timer.classList.add(
        "timer-warning"
      );

    }


    /* Danger */

    if (
      remainingSeconds <= 60
    ) {

      timer.classList.add(
        "timer-danger"
      );

    }


    /* Time finished */

    if (
      remainingSeconds <= 0
    ) {

      clearInterval(
        timerInterval
      );


      alert(
        "Time is over. Your quiz will be submitted automatically."
      );


      quizForm.submit();

      return;

    }


    remainingSeconds--;

  }


  updateTimer();


  const timerInterval =
    setInterval(
      updateTimer,
      1000
    );


  /* =====================================================
     INITIALIZE
  ===================================================== */

  showQuestion(0);

  updateAnswered();

});
</script>