<div class="container mt-5">

  <h1>
    <i class="fas fa-cloud-upload-alt"></i>
    Upload Study Note
  </h1>


  <%= form_with model: @note, local: true, multipart: true do |f| %>


    <% if @note.errors.any? %>
      <div class="alert alert-danger">

        <h5>
          <%= pluralize(@note.errors.count, "error") %>
          prevented saving:
        </h5>

        <ul>
          <% @note.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>

      </div>
    <% end %>



    <!-- Course -->

    <div class="mb-3">

      <%= label_tag :course_id,
          "Course",
          class: "form-label fw-bold" %>


      <%= select_tag :course_id,

          options_from_collection_for_select(
            @courses,
            :id,
            :Course_name
          ),

          prompt: "Select Course",

          class: "form-select",

          id: "course_select" %>

    </div>




    <!-- Playlist -->

    <div class="mb-3">

      <%= f.label :playlist_id,
          "Playlist",
          class: "form-label fw-bold" %>


      <%= f.select :playlist_id,
          [],

          {prompt:"Select Playlist"},

          {
            class:"form-select",
            id:"playlist_select",
            disabled:true
          } %>


    </div>





    <!-- Video -->

    <div class="mb-3">

      <%= f.label :video_id,
          "Video Title",

          class:"form-label fw-bold" %>


      <%= f.select :video_id,
          [],

          {prompt:"Select Video"},

          {
            class:"form-select",
            id:"video_select",
            disabled:true
          } %>

    </div>




    <!-- Description -->

    <div class="mb-3">

      <%= f.label :description,
          "Description",

          class:"form-label fw-bold" %>


      <%= f.text_area :description,

          rows:4,

          class:"form-control",

          placeholder:"Enter note description..." %>


    </div>





    <!-- PDF -->

    <div class="mb-3">

      <%= f.label :pdf_file,
          "PDF File",

          class:"form-label fw-bold" %>


      <%= f.file_field :pdf_file,

          accept:"application/pdf",

          class:"form-control",

          required:true %>

    </div>





    <%= f.submit "Upload Note",
        class:"btn btn-primary" %>


    <%= link_to "Cancel",
        resources_path,
        class:"btn btn-secondary" %>


  <% end %>

</div>
<script nonce="<%= content_security_policy_nonce %>">

(function () {

  /* =====================================================
     STUDY NOTES
     COURSE → PLAYLIST → VIDEO
     TURBO SAFE + DUPLICATE SAFE
  ===================================================== */

  function initializeStudyNotesFilters() {

    const course =
      document.getElementById("course_select");

    const playlist =
      document.getElementById("playlist_select");

    const video =
      document.getElementById("video_select");


    if (!course || !playlist || !video) {
      return;
    }


    /* =====================================================
       COURSE → PLAYLIST
    ===================================================== */

    if (course.dataset.initialized !== "true") {

      course.dataset.initialized = "true";

      course.addEventListener("change", function () {

        const courseId = this.value;

        playlist.innerHTML =
          '<option value="">Select Playlist</option>';

        video.innerHTML =
          '<option value="">Select Video</option>';

        playlist.disabled = true;
        video.disabled = true;


        if (!courseId) {
          return;
        }


        fetch(
          `/study_notes/playlists?course_id=${encodeURIComponent(courseId)}`
        )

          .then(function (response) {

            if (!response.ok) {
              throw new Error("Failed to load playlists");
            }

            return response.json();

          })

          .then(function (data) {

            playlist.innerHTML =
              '<option value="">Select Playlist</option>';

            data.forEach(function (item) {

              const option =
                document.createElement("option");

              option.value = item.id;
              option.textContent = item.title;

              playlist.appendChild(option);

            });

            playlist.disabled = false;

          })

          .catch(function (error) {

            console.error(
              "Playlist loading error:",
              error
            );

            playlist.innerHTML =
              '<option value="">Unable to load playlists</option>';

            playlist.disabled = true;

          });

      });

    }


    /* =====================================================
       PLAYLIST → VIDEO
    ===================================================== */

    if (playlist.dataset.initialized !== "true") {

      playlist.dataset.initialized = "true";

      playlist.addEventListener("change", function () {

        const playlistId = this.value;

        video.innerHTML =
          '<option value="">Select Video</option>';

        video.disabled = true;


        if (!playlistId) {
          return;
        }


        fetch(
          `/study_notes/videos?playlist_id=${encodeURIComponent(playlistId)}`
        )

          .then(function (response) {

            if (!response.ok) {
              throw new Error("Failed to load videos");
            }

            return response.json();

          })

          .then(function (data) {

            video.innerHTML =
              '<option value="">Select Video</option>';

            data.forEach(function (item) {

              const option =
                document.createElement("option");

              option.value = item.id;
              option.textContent = item.title;

              video.appendChild(option);

            });

            video.disabled = false;

          })

          .catch(function (error) {

            console.error(
              "Video loading error:",
              error
            );

            video.innerHTML =
              '<option value="">Unable to load videos</option>';

            video.disabled = true;

          });

      });

    }

  }


  /* =====================================================
     TURBO
  ===================================================== */

  document.addEventListener(
    "turbo:load",
    initializeStudyNotesFilters
  );


  /* =====================================================
     INITIAL LOAD
  ===================================================== */

  if (document.readyState !== "loading") {

    initializeStudyNotesFilters();

  } else {

    document.addEventListener(
      "DOMContentLoaded",
      initializeStudyNotesFilters,
      { once: true }
    );

  }

})();

</script>