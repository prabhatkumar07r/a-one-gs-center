<% content_for :title, "#{@course.Course_name} Videos" %>

<div class="container-fluid">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <% if @playlist %>
  <h2 class="mb-1">
    🎥 <%= @playlist.title %> Videos
  </h2>
<% else %>
  <h2 class="mb-1">
    🎥 Video Management
  </h2>
<% end %>
        <p class="text-muted mb-0">
  Course:
  <strong><%= @course.Course_name %></strong>

  <% if @playlist %>
    |
    Playlist:
    <strong><%= @playlist.title %></strong>
  <% end %>
</p>
    </div>

   <% if @playlist.present? %>
  <%= link_to "➕ Add First Video",
      new_course_playlist_video_path(@course, @playlist),
      class: "btn btn-primary" %>
<% else %>
  <%= link_to "➕ Add First Video",
      new_course_video_path(@course),
      class: "btn btn-primary" %>
<% end %>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body">

      <% if @videos.any? %>

        <table class="table table-hover align-middle">

          <thead class="table-dark">
            <tr>
              <th>#</th>
              <th>Title</th>
              <th>Duration</th>
              <th>Status</th>
              <th>Position</th>
              <th>Playlist</th>
              <th width="230">Actions</th>
            </tr>
          </thead>

          <tbody>

            <% @videos.each_with_index do |video, index| %>

              <tr>

                <td><%= index + 1 %></td>

                <td>
                  <strong><%= video.title %></strong>

                  <% if video.description.present? %>
                    <br>
                    <small class="text-muted">
                      <%= truncate(video.description, length: 60) %>
                    </small>
                  <% end %>
                </td>

                <td><%= video.duration %></td>

                <td>
                  <% if video.active? %>
                    <span class="badge bg-success">Active</span>
                  <% else %>
                    <span class="badge bg-secondary">Inactive</span>
                  <% end %>
                </td>

                <td>
                  <span class="badge bg-primary">
                    <%= video.position %>
                  </span>
                </td>

                 <td>
  <% if video.playlist.present? %>
    <span class="badge bg-info">
      <%= video.playlist.title %>
    </span>
  <% else %>
    <span class="text-muted">
      No Playlist
    </span>
  <% end %>
</td>
                <td>

                  <%= link_to "👁",
                      course_playlist_video_path(@course, video.playlist, video),
                      class: "btn btn-info btn-sm",
                      title: "Show" %>

                  <%= link_to "✏",
                      edit_course_playlist_video_path(@course, video.playlist, video),
                      class: "btn btn-warning btn-sm",
                      title: "Edit" %>

                  <%= link_to "🗑",
                  course_playlist_video_path(@course, video.playlist, video),
                 data: {
                turbo_method: :delete,
                turbo_confirm: "Delete this video?"
                },
              class: "btn btn-danger btn-sm",
              title: "Delete" %>

                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

      <% else %>

        <div class="text-center py-5">

          <h5>No videos added yet.</h5>

          <p class="text-muted">
            Start by adding your first course video.
          </p>

   <% if @playlist.present? %>
  <%= link_to "➕ Add First Video",
      new_course_playlist_video_path(@course, @playlist),
      class: "btn btn-primary" %>
<% else %>
  <%= link_to "➕ Add First Video",
      new_course_video_path(@course),
      class: "btn btn-primary" %>
<% end %>

        </div>

      <% end %>

    </div>
  </div>

  <div class="mt-3">
    <%= link_to "⬅ Back to Courses",
        courses_path,
        class: "btn btn-secondary" %>
  </div>

</div>