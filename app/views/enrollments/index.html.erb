<%= link_to "Enrollment Management",
      enrollments_path,
      class: "nav-link" %>

<!-- Dashboard Cards -->
<div class="row mb-4">

  <div class="col-md-4">
    <div class="card shadow border-start border-primary border-4">
      <div class="card-body text-center">
        <h6>Total Enrollments</h6>
        <h3><%= @total_enrollments %></h3>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow border-start border-warning border-4">
      <div class="card-body text-center">
        <h6>Pending</h6>
        <h3><%= @pending %></h3>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow border-start border-success border-4">
      <div class="card-body text-center">
        <h6>Approved</h6>
        <h3><%= @approved %></h3>
      </div>
    </div>
  </div>

</div>

<!-- Search Form -->
<%= form_with url: enrollments_path, method: :get, local: true do %>

<div class="row mb-3">

  <div class="col-md-10">
    <%= text_field_tag :search,
          params[:search],
          class: "form-control",
          placeholder: "Search Student Name..." %>
  </div>

  <div class="col-md-2">
    <%= submit_tag "🔍 Search",
          class: "btn btn-primary w-100" %>
  </div>

</div>

<% end %>

<!-- Add Button -->
<div class="mb-3">
  <%= link_to "➕ Enroll Student",
      new_enrollment_path,
      class: "btn btn-success" %>
</div>

<!-- Enrollment Table -->

<table class="table table-bordered table-hover">

  <thead class="table-dark">

    <tr>

      <th>#</th>
      <th>Student</th>
      <th>Course</th>
      <th>Status</th>
      <th>Enrolled On</th>
      <th>Action</th>

    </tr>

  </thead>

  <tbody>

    <% @enrollments.each_with_index do |enrollment, index| %>

     <tr>

<td>
<%= index + 1 %>
</td>


<td>
<%= enrollment.user.name %>
<br>
<small>
<%= enrollment.user.email %>
</small>
</td>


<td>
<%= enrollment.course.Course_name %>
</td>


<td>

<% if enrollment.status == "Approved" %>

<span class="badge bg-success">
Approved
</span>


<% elsif enrollment.status == "Pending" %>

<span class="badge bg-warning">
Pending
</span>


<% else %>

<span class="badge bg-danger">
Cancelled
</span>


<% end %>

</td>


<td>
<%= enrollment.created_at.strftime("%d-%m-%Y") %>
</td>

<td class="text-nowrap">

  <%= link_to enrollment_path(enrollment),
      class: "btn btn-info btn-sm" do %>
    <i class="bi bi-eye"></i>
  <% end %>

  <%= link_to edit_enrollment_path(enrollment),
      class: "btn btn-warning btn-sm" do %>
    <i class="bi bi-pencil"></i>
  <% end %>

  <%= link_to enrollment_path(enrollment),
      data: {
        turbo_method: :delete,
        turbo_confirm: "Delete this enrollment?"
      },
      class: "btn btn-danger btn-sm" do %>
    <i class="bi bi-trash"></i>
  <% end %>

</td>


</tr>
    <% end %>

  </tbody>

</table>
<div class="d-flex justify-content-center mt-4">
  <%= paginate @enrollments %>
</div>

<%= render "layouts/footer" %>