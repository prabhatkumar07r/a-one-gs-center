<% content_for :hide_header, true %>
<% content_for :hide_footer, true %>

<style>
  /* =========================================================
     EXAM PAGE
  ========================================================== */

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #f5f7fb;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
  }

  .exam-page {
    min-height: 100vh;
    background: #f5f7fb;
  }

  /* =========================================================
     TOP HEADER
  ========================================================== */

  .exam-header {
    height: 68px;
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 24px;

    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .exam-header-left {
    display: flex;
    align-items: center;
    gap: 15px;
    min-width: 0;
  }

  .exam-logo {
    width: 40px;
    height: 40px;
    border-radius: 10px;

    background: linear-gradient(135deg, #6d28d9, #4f46e5);

    display: flex;
    align-items: center;
    justify-content: center;

    color: white;
    font-size: 18px;

    flex-shrink: 0;
  }

  .exam-title-wrapper {
    min-width: 0;
  }

  .exam-series-name {
    font-size: 12px;
    color: #6b7280;
    margin-bottom: 2px;
  }

  .exam-title {
    font-size: 17px;
    font-weight: 700;
    color: #111827;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* =========================================================
     TIMER
  ========================================================== */

  .exam-header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .timer-box {
    min-width: 130px;
    height: 42px;

    border-radius: 8px;
    background: #fff7ed;
    border: 1px solid #fed7aa;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;

    color: #c2410c;
    font-weight: 700;
    font-size: 16px;
  }

  .timer-box i {
    font-size: 17px;
  }

  .timer-box.warning {
    background: #fef2f2;
    border-color: #fecaca;
    color: #dc2626;
  }

  .quit-btn {
    height: 42px;
    padding: 0 17px;

    border: 1px solid #e5e7eb;
    border-radius: 8px;

    background: #ffffff;
    color: #374151;

    font-size: 14px;
    font-weight: 600;

    text-decoration: none;

    display: flex;
    align-items: center;
    gap: 7px;

    cursor: pointer;
  }

  .quit-btn:hover {
    background: #f9fafb;
    color: #111827;
  }

  /* =========================================================
     MAIN LAYOUT
  ========================================================== */

  .exam-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 20px;

    padding: 20px;
    max-width: 1600px;
    margin: auto;
  }

  /* =========================================================
     LEFT QUESTION AREA
  ========================================================== */

  .question-panel {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;

    min-height: calc(100vh - 108px);

    display: flex;
    flex-direction: column;
  }

  .question-top {
    padding: 18px 22px;

    border-bottom: 1px solid #e5e7eb;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .question-number {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .question-number-badge {
    width: 38px;
    height: 38px;

    border-radius: 8px;
    background: #ede9fe;
    color: #6d28d9;

    display: flex;
    align-items: center;
    justify-content: center;

    font-weight: 800;
    font-size: 15px;
  }

  .question-number-text {
    font-size: 15px;
    font-weight: 700;
    color: #111827;
  }

  .question-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .marks-badge {
    padding: 7px 11px;

    border-radius: 7px;

    background: #f0fdf4;
    color: #15803d;

    font-size: 12px;
    font-weight: 700;
  }

  .question-timer {
    display: flex;
    align-items: center;
    gap: 6px;

    color: #6b7280;
    font-size: 13px;
  }

  /* =========================================================
     BOOKMARK
  ========================================================== */

  .bookmark-form {
    margin: 0;
    padding: 0;
  }

  .bookmark-btn {
    width: 38px;
    height: 38px;

    border: 1px solid #e5e7eb;
    border-radius: 8px;

    background: #ffffff;
    color: #6b7280;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 16px;
  }

  .bookmark-btn:hover,
  .bookmark-btn.active {
    color: #6d28d9;
    background: #f5f3ff;
    border-color: #c4b5fd;
  }

  /* =========================================================
     QUESTION BODY
  ========================================================== */

  .question-body {
    padding: 28px 30px;
    flex: 1;
  }

  .question-label {
    font-size: 13px;
    font-weight: 700;
    color: #6b7280;
    margin-bottom: 12px;

    text-transform: uppercase;
    letter-spacing: .4px;
  }

  .question-text {
    font-size: 20px;
    line-height: 1.65;

    font-weight: 600;
    color: #111827;

    margin-bottom: 28px;
  }

  /* =========================================================
     OPTIONS
  ========================================================== */

  .options-list {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .option-label {
    position: relative;

    display: flex;
    align-items: center;

    min-height: 62px;

    border: 1px solid #dfe3ea;
    border-radius: 10px;

    padding: 10px 15px;

    cursor: pointer;

    transition: all .15s ease;

    background: #ffffff;
  }

  .option-label:hover {
    border-color: #a78bfa;
    background: #faf9ff;
  }

  .option-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .option-letter {
    width: 38px;
    height: 38px;

    flex-shrink: 0;

    border-radius: 8px;

    background: #f3f4f6;
    color: #4b5563;

    display: flex;
    align-items: center;
    justify-content: center;

    font-weight: 800;
    font-size: 14px;

    margin-right: 13px;
  }

  .option-text {
    font-size: 15px;
    line-height: 1.5;
    color: #374151;
  }

  .option-radio:checked + .option-letter {
    background: #6d28d9;
    color: white;
  }

  .option-label:has(.option-radio:checked) {
    border-color: #7c3aed;
    background: #f5f3ff;
  }

  /* =========================================================
     QUESTION FOOTER
  ========================================================== */

  .question-footer {
    border-top: 1px solid #e5e7eb;

    padding: 15px 20px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background: #ffffff;
    border-radius: 0 0 12px 12px;
  }

  .previous-btn {
    min-width: 110px;
    height: 43px;

    border: 1px solid #d1d5db;
    border-radius: 8px;

    background: #ffffff;
    color: #374151;

    text-decoration: none;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    font-size: 14px;
    font-weight: 600;
  }

  .previous-btn:hover {
    background: #f9fafb;
  }

  .previous-btn.disabled {
    opacity: .45;
    pointer-events: none;
  }

  .save-next-btn {
    min-width: 145px;
    height: 43px;

    border: 0;
    border-radius: 8px;

    background: #6d28d9;
    color: white;

    cursor: pointer;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    font-size: 14px;
    font-weight: 700;
  }

  .save-next-btn:hover {
    background: #5b21b6;
  }

  /* =========================================================
     RIGHT SIDEBAR
  ========================================================== */

  .exam-sidebar {
    display: flex;
    flex-direction: column;
    gap: 15px;

    position: sticky;
    top: 88px;

    height: calc(100vh - 108px);
  }

  .sidebar-card {
    background: #ffffff;

    border: 1px solid #e5e7eb;
    border-radius: 12px;

    overflow: hidden;
  }

  /* =========================================================
     PROGRESS
  ========================================================== */

  .progress-card {
    padding: 17px;
  }

  .progress-title {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 12px;
  }

  .progress-title strong {
    font-size: 14px;
    color: #111827;
  }

  .progress-percent {
    font-size: 13px;
    font-weight: 700;
    color: #6d28d9;
  }

  .progress-track {
    width: 100%;
    height: 7px;

    background: #ede9fe;
    border-radius: 20px;

    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: #7c3aed;

    border-radius: 20px;

    transition: width .2s ease;
  }

  .progress-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    margin-top: 13px;

    text-align: center;
  }

  .progress-stat {
    border-right: 1px solid #e5e7eb;
  }

  .progress-stat:last-child {
    border-right: 0;
  }

  .progress-stat strong {
    display: block;

    font-size: 16px;
    color: #111827;
  }

  .progress-stat span {
    font-size: 11px;
    color: #6b7280;
  }

  /* =========================================================
     QUESTION PALETTE
  ========================================================== */

  .palette-card {
    flex: 1;
    min-height: 0;

    display: flex;
    flex-direction: column;
  }

  .palette-header {
    padding: 16px;

    border-bottom: 1px solid #e5e7eb;

    font-size: 14px;
    font-weight: 700;

    color: #111827;
  }

  .palette-legend {
    padding: 12px 15px;

    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 8px;

    border-bottom: 1px solid #e5e7eb;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 7px;

    font-size: 11px;
    color: #6b7280;
  }

  .legend-dot {
    width: 15px;
    height: 15px;

    border-radius: 4px;

    flex-shrink: 0;
  }

  .legend-answered {
    background: #22c55e;
  }

  .legend-current {
    background: #7c3aed;
  }

  .legend-unanswered {
    background: #f3f4f6;
    border: 1px solid #d1d5db;
  }

  .legend-bookmarked {
    background: #f59e0b;
  }

  .question-palette {
    padding: 14px;

    overflow-y: auto;

    flex: 1;
  }

  .palette-section-title {
    font-size: 11px;
    font-weight: 700;

    color: #9ca3af;

    margin-bottom: 10px;

    text-transform: uppercase;
    letter-spacing: .5px;
  }

  .palette-grid {
    display: grid;

    grid-template-columns: repeat(5, 1fr);

    gap: 8px;
  }

  .palette-number {
    height: 36px;
    width: 100%;

    border-radius: 7px;

    border: 1px solid #d1d5db;

    background: #ffffff;

    color: #4b5563;

    text-decoration: none;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 12px;
    font-weight: 700;

    position: relative;

    transition: all .12s ease;
  }

  .palette-number:hover {
    border-color: #8b5cf6;
    background: #f5f3ff;
  }

  .palette-number.answered {
    background: #dcfce7;
    border-color: #86efac;
    color: #15803d;
  }

  .palette-number.current {
    background: #7c3aed;
    border-color: #7c3aed;
    color: white;
  }

  .palette-number.bookmarked {
    border-color: #f59e0b;
  }

  .palette-number.bookmarked::after {
    content: "";

    position: absolute;

    top: 2px;
    right: 3px;

    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: #f59e0b;
  }

  /* =========================================================
     SUBMIT CARD
  ========================================================== */

  .submit-card {
    padding: 15px;
  }

  .paper-link {
    width: 100%;
    height: 40px;

    border: 1px solid #ddd6fe;
    border-radius: 8px;

    background: #faf5ff;

    color: #6d28d9;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    text-decoration: none;

    font-size: 13px;
    font-weight: 700;

    margin-bottom: 10px;
  }

  .submit-test-btn {
    width: 100%;
    height: 45px;

    border: 0;
    border-radius: 8px;

    background: #16a34a;
    color: white;

    cursor: pointer;

    font-size: 14px;
    font-weight: 800;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .submit-test-btn:hover {
    background: #15803d;
  }

  /* =========================================================
     RESPONSIVE
  ========================================================== */

  @media (max-width: 1000px) {

    .exam-content {
      grid-template-columns: 1fr;
    }

    .exam-sidebar {
      position: static;
      height: auto;
    }

    .palette-card {
      max-height: 500px;
    }
  }

  @media (max-width: 650px) {

    .exam-header {
      height: auto;
      min-height: 65px;
      padding: 10px 13px;
      gap: 10px;
    }

    .exam-header-right {
      gap: 6px;
    }

    .timer-box {
      min-width: auto;
      padding: 0 9px;
    }

    .timer-box span {
      display: none;
    }

    .quit-btn {
      padding: 0 10px;
    }

    .quit-btn span {
      display: none;
    }

    .exam-content {
      padding: 10px;
    }

    .question-body {
      padding: 20px 15px;
    }

    .question-text {
      font-size: 17px;
    }

    .question-footer {
      padding: 12px;
    }

    .previous-btn,
    .save-next-btn {
      min-width: 0;
      padding: 0 12px;
    }

    .question-top {
      padding: 14px;
    }

    .question-meta {
      gap: 7px;
    }

    .marks-badge {
      display: none;
    }
  }
</style>


<div class="exam-page">

  <!-- =======================================================
       HEADER
  ======================================================== -->

  <header class="exam-header">

    <div class="exam-header-left">

      <div class="exam-logo">
        <i class="fas fa-graduation-cap"></i>
      </div>

      <div class="exam-title-wrapper">

        <div class="exam-series-name">
          <%= @test_series.title %>
        </div>

        <div class="exam-title">
          <%= @test.title %>
        </div>

      </div>

    </div>


    <div class="exam-header-right">

      <div class="timer-box" id="examTimer">

        <i class="fas fa-clock"></i>

        <span id="timerText">
          Loading...
        </span>

      </div>


      <%= link_to(
        test_series_path(@test_series),
        class: "quit-btn",
        id: "quitTestBtn"
      ) do %>

        <i class="fas fa-sign-out-alt"></i>

        <span>
          Quit
        </span>

      <% end %>

    </div>

  </header>


  <!-- =======================================================
       MAIN CONTENT
  ======================================================== -->

  <main class="exam-content">


    <!-- =====================================================
         LEFT QUESTION PANEL
    ====================================================== -->

    <section class="question-panel">


      <!-- QUESTION HEADER -->

      <div class="question-top">

        <div class="question-number">

          <div class="question-number-badge">
            <%= @current_number %>
          </div>

          <div class="question-number-text">

            Question
            <%= @current_number %>
            of
            <%= @total_questions %>

          </div>

        </div>


        <div class="question-meta">

          <div class="marks-badge">

            +<%= @question.marks %>
            Marks

          </div>


          <div class="question-timer">

            <i class="far fa-clock"></i>

            <span id="questionTimer">
              00:00
            </span>

          </div>


          <!-- BOOKMARK -->

          <%= form_with(
            url: bookmark_test_series_test_series_test_path(
              @test_series,
              @test
            ),
            method: :post,
            local: true,
            class: "bookmark-form"
          ) do %>

            <%= hidden_field_tag(
              :question_id,
              @question.id
            ) %>

            <%= hidden_field_tag(
              :language,
              @language
            ) %>

            <button
              type="submit"
              class="bookmark-btn <%= 'active' if @bookmarked_question_ids.include?(@question.id) %>"
              title="<%= @bookmarked_question_ids.include?(@question.id) ? 'Remove bookmark' : 'Bookmark question' %>">

              <i class="<%= @bookmarked_question_ids.include?(@question.id) ? 'fas' : 'far' %> fa-bookmark"></i>

            </button>

          <% end %>

        </div>

      </div>


      <!-- ===================================================
           QUESTION BODY
      ==================================================== -->

      <div class="question-body">

        <div class="question-label">

          Question
          <%= @current_number %>

        </div>


        <div class="question-text">

          <%= simple_format(
            @question.question_for(@language)
          ) %>

        </div>


        <!-- ANSWER FORM -->

        <%= form_with(
          url: answer_test_series_test_series_test_path(
            @test_series,
            @test
          ),
          method: :post,
          local: true,
          id: "answerForm"
        ) do %>

          <%= hidden_field_tag(
            :question_id,
            @question.id
          ) %>

          <%= hidden_field_tag(
            :language,
            @language
          ) %>


          <div class="options-list">

            <% @question
                 .test_series_options
                 .sort_by(&:position)
                 .each_with_index do |option, index| %>

              <% letter = ("A".ord + index).chr %>

              <label class="option-label">

                <%= radio_button_tag(
                  :option_id,
                  option.id,
                  @selected_option_id.to_i == option.id,
                  class: "option-radio"
                ) %>

                <span class="option-letter">
                  <%= letter %>
                </span>

                <span class="option-text">
                  <%= option.text_for(@language) %>
                </span>

              </label>

            <% end %>

          </div>


          <!-- QUESTION FOOTER -->

          <div class="question-footer">

            <% if @previous_question %>

              <%= link_to(
                test_series_test_series_test_path(
                  @test_series,
                  @test,
                  question: @current_number - 1,
                  language: @language
                ),
                class: "previous-btn"
              ) do %>

                <i class="fas fa-arrow-left"></i>
                Previous

              <% end %>

            <% else %>

              <span class="previous-btn disabled">

                <i class="fas fa-arrow-left"></i>
                Previous

              </span>

            <% end %>


            <button
              type="submit"
              class="save-next-btn">

              <% if @next_question %>

                Save & Next

                <i class="fas fa-arrow-right"></i>

              <% else %>

                Save Answer

                <i class="fas fa-check"></i>

              <% end %>

            </button>

          </div>


        <% end %>

      </div>

    </section>


    <!-- =====================================================
         RIGHT SIDEBAR
    ====================================================== -->

    <aside class="exam-sidebar">


      <!-- PROGRESS -->

      <div class="sidebar-card progress-card">

        <div class="progress-title">

          <strong>
            Test Progress
          </strong>

          <span class="progress-percent">

            <%= @total_questions > 0 ?
                  ((@answered_count.to_f /
                    @total_questions) * 100).round :
                  0 %>%

          </span>

        </div>


        <div class="progress-track">

          <div
            class="progress-fill"
            style="width: <%= @total_questions > 0 ? ((@answered_count.to_f / @total_questions) * 100) : 0 %>%;">
          </div>

        </div>


        <div class="progress-stats">

          <div class="progress-stat">

            <strong>
              <%= @answered_count %>
            </strong>

            <span>
              Answered
            </span>

          </div>


          <div class="progress-stat">

            <strong>
              <%= @total_questions - @answered_count %>
            </strong>

            <span>
              Remaining
            </span>

          </div>


          <div class="progress-stat">

            <strong>
              <%= @total_questions %>
            </strong>

            <span>
              Total
            </span>

          </div>

        </div>

      </div>


      <!-- QUESTION PALETTE -->

      <div class="sidebar-card palette-card">

        <div class="palette-header">
          Question Palette
        </div>


        <div class="palette-legend">

          <div class="legend-item">

            <span class="legend-dot legend-answered"></span>

            Answered

          </div>


          <div class="legend-item">

            <span class="legend-dot legend-current"></span>

            Current

          </div>


          <div class="legend-item">

            <span class="legend-dot legend-unanswered"></span>

            Unanswered

          </div>


          <div class="legend-item">

            <span class="legend-dot legend-bookmarked"></span>

            Bookmarked

          </div>

        </div>


        <div class="question-palette">

          <div class="palette-section-title">
            All Questions
          </div>


          <div class="palette-grid">

            <% @questions.each_with_index do |question, index| %>

              <% question_number = index + 1 %>

              <% answered =
                   @answered_question_ids.include?(question.id) %>

              <%= link_to(
                question_number,
                test_series_test_series_test_path(
                  @test_series,
                  @test,
                  question: question_number,
                  language: @language
                ),
                class: [
                  "palette-number",
                  ("answered" if answered),
                  (
                    "bookmarked" if
                    @bookmarked_question_ids.include?(question.id)
                  ),
                  (
                    "current" if
                    question_number == @current_number
                  )
                ].compact.join(" ")
              ) %>

            <% end %>

          </div>

        </div>

      </div>


      <!-- SUBMIT -->

      <div class="sidebar-card submit-card">

        <div class="paper-link">

          <i class="fas fa-file-alt"></i>

          Question Paper

        </div>


        <%= form_with(
          url: finish_test_series_test_series_test_path(
            @test_series,
            @test
          ),
          method: :post,
          local: true,
          id: "finishTestForm"
        ) do %>

          <%= hidden_field_tag(
            :language,
            @language
          ) %>


          <button
            type="submit"
            class="submit-test-btn"
            id="submitTestBtn">

            <i class="fas fa-paper-plane"></i>

            Submit Test

          </button>

        <% end %>

      </div>

    </aside>

  </main>

</div>


<script>

  document.addEventListener(
    "DOMContentLoaded",
    function () {

      /* =====================================================
         EXAM TIMER
      ====================================================== */

      const timerElement =
        document.getElementById("timerText");

      const timerBox =
        document.getElementById("examTimer");

      let totalSeconds =
        <%= @remaining_seconds.to_i %>;

      let timerInterval;


      function updateTimer() {

        if (totalSeconds <= 0) {

          totalSeconds = 0;

          timerElement.textContent = "00:00";

          timerBox.classList.add("warning");

          clearInterval(timerInterval);

          const form =
            document.getElementById("finishTestForm");

          if (form) {

            /*
             * Native submit intentionally bypasses
             * the confirmation dialog when time expires.
             */

            form.submit();

          }

          return;
        }


        const hours =
          Math.floor(totalSeconds / 3600);

        const minutes =
          Math.floor(
            (totalSeconds % 3600) / 60
          );

        const seconds =
          totalSeconds % 60;


        let display;


        if (hours > 0) {

          display =
            String(hours).padStart(2, "0") +
            ":" +
            String(minutes).padStart(2, "0") +
            ":" +
            String(seconds).padStart(2, "0");

        } else {

          display =
            String(minutes).padStart(2, "0") +
            ":" +
            String(seconds).padStart(2, "0");

        }


        timerElement.textContent =
          display;


        if (totalSeconds <= 300) {

          timerBox.classList.add("warning");

        }


        totalSeconds--;

      }


      updateTimer();


      timerInterval =
        setInterval(
          updateTimer,
          1000
        );


      /* =====================================================
         QUESTION TIMER
      ====================================================== */

      const questionTimer =
        document.getElementById("questionTimer");

      let questionSeconds = 0;


      function updateQuestionTimer() {

        if (!questionTimer) {
          return;
        }

        const minutes =
          Math.floor(questionSeconds / 60);

        const seconds =
          questionSeconds % 60;


        questionTimer.textContent =
          String(minutes).padStart(2, "0") +
          ":" +
          String(seconds).padStart(2, "0");


        questionSeconds++;

      }


      updateQuestionTimer();


      setInterval(
        updateQuestionTimer,
        1000
      );


      /* =====================================================
         QUIT CONFIRMATION
      ====================================================== */

      const quitBtn =
        document.getElementById("quitTestBtn");


      if (quitBtn) {

        quitBtn.addEventListener(
          "click",
          function (event) {

            const confirmed =
              confirm(
                "Are you sure you want to quit this test?"
              );


            if (!confirmed) {

              event.preventDefault();

            }

          }
        );

      }


      /* =====================================================
         SUBMIT CONFIRMATION
      ====================================================== */

      const finishForm =
        document.getElementById("finishTestForm");


      if (finishForm) {

        finishForm.addEventListener(
          "submit",
          function (event) {

            const answered =
              <%= @answered_count.to_i %>;

            const total =
              <%= @total_questions.to_i %>;

            const remaining =
              total - answered;


            let message =
              "Are you sure you want to submit the test?";


            if (remaining > 0) {

              message =
                "You still have " +
                remaining +
                " unanswered question(s).\n\n" +
                "Are you sure you want to submit the test?";

            }


            if (!confirm(message)) {

              event.preventDefault();

            }

          }
        );

      }


      /* =====================================================
         OPTION KEYBOARD SHORTCUTS
      ====================================================== */

      document.addEventListener(
        "keydown",
        function (event) {

          /*
           * Do not trigger shortcuts while typing
           * into an input, textarea, or select.
           */

          const target =
            event.target;

          if (
            target &&
            (
              target.tagName === "INPUT" ||
              target.tagName === "TEXTAREA" ||
              target.tagName === "SELECT"
            )
          ) {

            return;

          }


          const key =
            event.key.toLowerCase();


          const letters =
            ["a", "b", "c", "d"];


          if (!letters.includes(key)) {

            return;

          }


          const index =
            letters.indexOf(key);


          const radios =
            document.querySelectorAll(
              ".option-radio"
            );


          if (radios[index]) {

            radios[index].checked =
              true;


            radios[index].dispatchEvent(
              new Event(
                "change",
                {
                  bubbles: true
                }
              )
            );

          }

        }
      );

    }
  );

</script>