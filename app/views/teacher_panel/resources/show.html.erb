<% content_for :title, @resource.title %>

<div class="container-fluid mt-4">

  <div class="card shadow border-0">

    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

      <div>
        <h3 class="mb-0">
          📂 <%= @resource.title %>
        </h3>

        <small>
          Course :
          <strong><%= @course.Course_name %></strong>
        </small>
      </div>

      <%= link_to teacher_panel_course_resources_path(@course),
          class: "btn btn-light btn-sm" do %>

        <i class="bi bi-arrow-left"></i>
        Back

      <% end %>

    </div>

    <div class="card-body">

      <div class="row">

        <div class="col-md-6 mb-3">

          <strong>Title</strong>

          <p class="mt-2">
            <%= @resource.title %>
          </p>

        </div>

        <div class="col-md-6 mb-3">

          <strong>Playlist</strong>

          <p class="mt-2">
            <%= @resource.playlist.title %>
          </p>

        </div>

      </div>

      <div class="row">

        <div class="col-md-6 mb-3">

          <strong>Resource Type</strong>

          <p class="mt-2">

           <% if @resource.pdf? %>
            <span class="badge bg-danger">PDF</span>

             <% elsif @resource.ppt? %>
          <span class="badge bg-warning text-dark">PPT</span>

           <% elsif @resource.assignment? %>
             <span class="badge bg-info">Assignment</span>

          <% elsif @resource.zip_file? %>
         <span class="badge bg-secondary">ZIP File</span>

         <% end %>

          </p>

        </div>

        <div class="col-md-6 mb-3">

          <strong>Uploaded On</strong>

          <p class="mt-2">
            <%= @resource.created_at.strftime("%d %B %Y") %>
          </p>

        </div>

      </div>

      <div class="mb-4">

        <strong>Description</strong>

        <div class="border rounded p-3 mt-2 bg-light">

          <%= simple_format(@resource.description.presence || "No description available.") %>

        </div>

      </div>

      <% if @resource.file.attached? %>

        <div class="mb-4">

          <strong>Attached File</strong>

          <br><br>

          <%= link_to rails_blob_path(@resource.file, disposition: "attachment"),
              class: "btn btn-success" do %>

            <i class="bi bi-download"></i>
            Download Resource

          <% end %>

        </div>

      <% else %>

        <div class="alert alert-warning">

          No file uploaded.

        </div>

      <% end %>

    </div>

    <div class="card-footer d-flex justify-content-end gap-2">

      <%= link_to edit_teacher_panel_course_resource_path(@course, @resource),
          class: "btn btn-warning" do %>

        <i class="bi bi-pencil"></i>
        Edit

      <% end %>

      <%= link_to teacher_panel_course_resource_path(@course, @resource),
          data: {
            turbo_method: :delete,
            turbo_confirm: "Delete this resource?"
          },
          class: "btn btn-danger" do %>

        <i class="bi bi-trash"></i>
        Delete

      <% end %>

    </div>

  </div>

</div>