<style>
 .back-btn{
    display:inline-flex;
    align-items:center;
    gap:5px;
    padding:0.37srem 0.75rem;   /* Small horizontal padding */
    width:auto;         /* Only as wide as its content */
    white-space:nowrap;
    font-size:14px;
    font-weight:500;
    border-radius:0,375rem;
    transition: all 0.2s ease-in-out;
}

.back-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 4px 12px rgba(0,0,0,.15);
}

.back-btn i{
    font-size:15px;
}
</style>


<%= form_with(model: [:teacher_panel, @course, @resource], local: true, multipart: true) do |form| %>

  <% if @resource.errors.any? %>
    <div class="alert alert-danger">
      <h5>
        <%= pluralize(@resource.errors.count, "error") %> prohibited this resource from being saved.
      </h5>

      <ul class="mb-0">
        <% @resource.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Resource Title -->
  <div class="mb-3">
    <%= form.label :title, class: "form-label fw-bold" %>
    <%= form.text_field :title,
        class: "form-control",
        placeholder: "Enter Resource Title" %>
  </div>

  <!-- Playlist -->
  <div class="mb-3">
    <%= form.label :playlist_id, "Playlist", class: "form-label fw-bold" %>

    <%= form.collection_select :playlist_id,
        @playlists,
        :id,
        :title,
        { prompt: "Select Playlist" },
        { class: "form-select" } %>
  </div>

  <!-- Description -->
  <div class="mb-3">
    <%= form.label :description, class: "form-label fw-bold" %>

    <%= form.text_area :description,
        rows: 4,
        class: "form-control",
        placeholder: "Enter Description" %>
  </div>

  <!-- Resource Type -->
  <div class="mb-3">
    <%= form.label :resource_type, class: "form-label fw-bold" %>

    <%= form.select :resource_type,
        Resource.resource_types.keys.map { |type| [type.titleize, type] },
        { prompt: "Select Resource Type" },
        { class: "form-select" } %>
  </div>

  <!-- Upload File -->
  <div class="mb-4">
    <%= form.label :file, class: "form-label fw-bold" %>

    <%= form.file_field :file,
        class: "form-control" %>

    <small class="text-muted">
      Allowed: PDF, PPT, ZIP, Assignment files
    </small>
  </div>

<div class="d-flex gap-2 mt-4">
  <%= form.submit "💾 Save Resource", class: "btn btn-success",
  class: "btn btn-outline-secondary d-flex align-items-center back-btn" %>

  <%= link_to teacher_panel_course_resources_path(@course),
      class: "btn btn-outline-secondary d-flex align-items-center back-btn" do %>
    <i class="bi bi-arrow-left me-1"></i>
    Back
  <% end %>
</div>
<% end %>
