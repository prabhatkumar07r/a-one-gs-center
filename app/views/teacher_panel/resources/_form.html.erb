<style>
  /* ==========================
     RESOURCE FORM
  ========================== */

  .resource-form {
    width: 100%;
  }

  .resource-form .form-control,
  .resource-form .form-select {
    width: 100%;
    min-height: 44px;
    border-radius: 8px;
  }

  .resource-form textarea.form-control {
    min-height: 110px;
    resize: vertical;
  }

  .resource-form .form-label {
    margin-bottom: 7px;
  }


  /* ==========================
     ACTION BUTTONS
  ========================== */

  .resource-form-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;

    padding: 0.375rem 0.75rem;

    width: auto;
    min-height: 38px;

    white-space: nowrap;

    font-size: 14px;
    font-weight: 500;

    border-radius: 0.375rem;

    transition: all 0.2s ease-in-out;
  }

  .back-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 0, 0, .15);
  }

  .back-btn i {
    font-size: 15px;
  }


  /* ==========================
     ERROR MESSAGE
  ========================== */

  .resource-form .alert {
    border-radius: 10px;
  }

  .resource-form .alert ul {
    padding-left: 20px;
  }


  /* ==========================
     FILE INPUT
  ========================== */

  .resource-file-help {
    display: block;
    margin-top: 6px;
    font-size: 13px;
  }


  /* ==========================
     TABLET
  ========================== */

  @media (max-width: 768px) {

    .resource-form-actions {
      width: 100%;
    }

    .resource-form-actions .back-btn {
      min-height: 42px;
    }

  }


  /* ==========================
     MOBILE
  ========================== */

  @media (max-width: 576px) {

    .resource-form-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .resource-form-actions .back-btn {
      width: 100%;
      justify-content: center;
    }

    .resource-form .form-control,
    .resource-form .form-select {
      font-size: 16px;
    }

    .resource-form textarea.form-control {
      min-height: 120px;
    }

  }
</style>


<%= form_with(
      model: [:teacher_panel, @course, @resource],
      local: true,
      multipart: true,
      html: { class: "resource-form" }
    ) do |form| %>


  <% if @resource.errors.any? %>

    <div class="alert alert-danger">

      <h5>
        <%= pluralize(
              @resource.errors.count,
              "error"
            ) %>
        prohibited this resource from being saved.
      </h5>

      <ul class="mb-0">

        <% @resource.errors.full_messages.each do |message| %>

          <li>
            <%= message %>
          </li>

        <% end %>

      </ul>

    </div>

  <% end %>


  <!-- ==========================
       RESOURCE TITLE
  ========================== -->

  <div class="mb-3">

    <%= form.label :title,
        class: "form-label fw-bold" %>

    <%= form.text_field :title,
        class: "form-control",
        placeholder: "Enter Resource Title" %>

  </div>


  <!-- ==========================
       PLAYLIST
  ========================== -->

  <div class="mb-3">

    <%= form.label :playlist_id,
        "Playlist",
        class: "form-label fw-bold" %>

    <%= form.collection_select :playlist_id,
        @playlists,
        :id,
        :title,
        { prompt: "Select Playlist" },
        { class: "form-select" } %>

  </div>


  <!-- ==========================
       DESCRIPTION
  ========================== -->

  <div class="mb-3">

    <%= form.label :description,
        class: "form-label fw-bold" %>

    <%= form.text_area :description,
        rows: 4,
        class: "form-control",
        placeholder: "Enter Description" %>

  </div>


  <!-- ==========================
       RESOURCE TYPE
  ========================== -->

  <div class="mb-3">

    <%= form.label :resource_type,
        class: "form-label fw-bold" %>

    <%= form.select :resource_type,
        Resource.resource_types.keys.map {
          |type| [type.titleize, type]
        },
        { prompt: "Select Resource Type" },
        { class: "form-select" } %>

  </div>


  <!-- ==========================
       FILE UPLOAD
  ========================== -->

  <div class="mb-4">

    <%= form.label :file,
        class: "form-label fw-bold" %>

    <%= form.file_field :file,
        class: "form-control" %>

    <small class="text-muted resource-file-help">
      Allowed: PDF, PPT, ZIP, Assignment files
    </small>

  </div>


  <!-- ==========================
       ACTION BUTTONS
  ========================== -->

  <div class="resource-form-actions">

    <%= form.submit "💾 Save Resource",
        class: "btn btn-success back-btn" %>


    <%= link_to teacher_panel_course_resources_path(@course),
        class: "btn btn-outline-secondary back-btn" do %>

      <i class="bi bi-arrow-left"></i>
      Back

    <% end %>

  </div>


<% end %>