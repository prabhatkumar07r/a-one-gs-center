<% content_for :title, "Resources" %>

<div class="container-fluid">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h2 class="fw-bold">
        📂 My Resources
      </h2>

      <p class="text-muted mb-0">
        Manage resources for your assigned course.
      </p>
    </div>

    <%= link_to new_teacher_panel_course_resource_path(@course),
        class: "btn btn-success" do %>

      <i class="bi bi-plus-circle"></i>
      Upload Resource

    <% end %>

  </div>


  <div class="card shadow border-0">

    <div class="card-header bg-light">

      <div class="row align-items-center">

        <div class="col-md-6">

          <h5 class="mb-0">
            Total Resources :
            <span class="badge bg-primary">
              <%= @resources.count %>
            </span>
          </h5>

        </div>

        <div class="col-md-6">

          <input
            type="text"
            id="searchResource"
            class="form-control"
            placeholder="🔍 Search Resource">

        </div>

      </div>

    </div>


    <div class="table-responsive">

      <table class="table table-hover align-middle mb-0" id="resourceTable">

        <thead class="table-dark">

          <tr>

            <th>#</th>
            <th>Title</th>
            <th>Playlist</th>
            <th>Description</th>
            <th>Type</th>
            <th>Uploaded</th>
            <th>File</th>
            <th width="170">Action</th>

          </tr>

        </thead>

        <tbody>

        <% if @resources.any? %>

          <% @resources.each_with_index do |resource, index| %>

            <tr>

              <td>
                <%= index + 1 %>
              </td>

              <td class="fw-semibold">
                <%= resource.title %>
              </td>

              <td>
                <%= resource.playlist.title %>
              </td>

              <td>
                <%= truncate(resource.description, length: 60) %>
              </td>

              <td>

                <span class="badge
                  <%= case resource.resource_type
                      when 'pdf'
                        'bg-danger'
                      when 'ppt'
                        'bg-warning text-dark'
                      when 'assignment'
                        'bg-info'
                      when 'zip_file'
                        'bg-secondary'
                      else
                        'bg-primary'
                      end %>">

                  <%= resource.resource_type.titleize %>

                </span>

              </td>

              <td>
                <%= resource.created_at.strftime("%d %b %Y") %>
              </td>

              <td>

                <% if resource.file.attached? %>

                  <div class="btn-group">

                    <%= link_to rails_blob_path(resource.file),
                        target: "_blank",
                        class: "btn btn-outline-primary btn-sm" do %>

                      <i class="bi bi-eye"></i>

                    <% end %>

                    <%= link_to rails_blob_path(
                        resource.file,
                        disposition: "attachment"
                      ),
                      class: "btn btn-success btn-sm" do %>

                      <i class="bi bi-download"></i>

                    <% end %>

                  </div>

                <% else %>

                  <span class="text-danger">
                    No File
                  </span>

                <% end %>

              </td>

              <td>

                <div class="btn-group">

                  <%= link_to edit_teacher_panel_course_resource_path(@course, resource),
                      class: "btn btn-warning btn-sm" do %>

                    <i class="bi bi-pencil"></i>

                  <% end %>

                  <%= link_to teacher_panel_course_resource_path(@course, resource),
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "Delete this resource?"
                      },
                      class: "btn btn-danger btn-sm" do %>

                    <i class="bi bi-trash"></i>

                  <% end %>

                </div>

              </td>

            </tr>

          <% end %>

        <% else %>

          <tr>

            <td colspan="8" class="text-center py-5">

              <i class="bi bi-folder-x fs-1 text-secondary"></i>

              <h5 class="mt-3 text-muted">
                No Resources Uploaded Yet
              </h5>

              <%= link_to new_teacher_panel_course_resource_path(@course),
                  class: "btn btn-success mt-2" do %>

                <i class="bi bi-plus-circle"></i>
                Upload First Resource

              <% end %>

            </td>

          </tr>

        <% end %>

        </tbody>

      </table>

    </div>

  </div>

</div>

<script>
document.addEventListener("turbo:load", function () {

  const search = document.getElementById("searchResource");

  if (search) {

    search.addEventListener("keyup", function () {

      const value = this.value.toLowerCase();

      document.querySelectorAll("#resourceTable tbody tr").forEach(function (row) {

        row.style.display =
          row.innerText.toLowerCase().includes(value)
            ? ""
            : "none";

      });

    });

  }

});
</script>