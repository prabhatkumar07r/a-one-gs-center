<style>
  /* =========================================================
     RESOURCE PAGE
  ========================================================= */

  .resource-page {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }


  /* =========================================================
     BACK / ACTION BUTTON
  ========================================================= */

  .back-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;

    padding: 6px 10px;

    width: auto;
    min-height: 38px;

    white-space: nowrap;

    font-size: 14px;
    font-weight: 500;

    border-radius: 10px;

    transition: all .2s ease;
  }

  .back-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0,0,0,.12);
  }

  .back-btn i {
    font-size: 15px;
  }


  /* =========================================================
     BREADCRUMB
  ========================================================= */

  .custom-breadcrumb {
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;

    padding: 0 !important;
    margin-bottom: 10px !important;

    width: 100%;
  }

  .custom-breadcrumb .breadcrumb {
    background: transparent !important;

    margin: 0;
    padding: 0;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .custom-breadcrumb .breadcrumb-item {
    font-size: 14px;
    font-weight: 500;
  }

  .custom-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
    content: ">";
    color: #6c757d;
    padding: 0 8px;
  }

  .custom-breadcrumb .breadcrumb-item a {
    color: #0d6efd;
    text-decoration: none;
  }

  .custom-breadcrumb .breadcrumb-item a:hover {
    text-decoration: underline;
  }

  .custom-breadcrumb .breadcrumb-item.active {
    color: #198754;
    font-weight: 600;
  }


  /* =========================================================
     HEADER
  ========================================================= */

  .resource-page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 20px;

    margin-bottom: 24px;
  }

  .resource-page-header h2 {
    margin-bottom: 5px;
  }

  .resource-page-header p {
    margin-bottom: 0;
  }


  /* =========================================================
     RESOURCE CARD
  ========================================================= */

  .resource-card {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
  }

  .resource-card .card-header {
    padding: 15px 18px;
  }


  /* =========================================================
     SEARCH
  ========================================================= */

  .resource-search {
    width: 100%;
  }

  .resource-search input {
    width: 100%;
    min-height: 42px;
    border-radius: 8px;
  }


  /* =========================================================
     TABLE
  ========================================================= */

  .resource-table-wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  #resourceTable {
    width: 100%;
    min-width: 1050px;
    margin-bottom: 0;
  }

  #resourceTable th,
  #resourceTable td {
    vertical-align: middle;
    white-space: nowrap;
  }

  #resourceTable td:nth-child(4) {
    white-space: normal;
    min-width: 220px;
    max-width: 300px;
  }

  #resourceTable th {
    font-size: 14px;
  }

  #resourceTable td {
    font-size: 14px;
  }


  /* =========================================================
     FILE / ACTION BUTTONS
  ========================================================= */

  .btn-group form {
    display: inline-block;
    margin: 0;
  }

  .resource-actions {
    display: inline-flex;
    align-items: center;
    gap: 0;
    white-space: nowrap;
  }

  .resource-actions .btn {
    min-width: 38px;
  }


  /* =========================================================
     EMPTY STATE
  ========================================================= */

  .resource-empty-state {
    text-align: center;
    padding: 55px 20px;
  }

  .resource-empty-state i {
    font-size: 48px;
  }


  /* =========================================================
     TABLET
  ========================================================= */

  @media (max-width: 992px) {

    .resource-page-header {
      align-items: flex-start;
    }

    .resource-page-header h2 {
      font-size: 28px;
    }

    .resource-card .card-header .row {
      row-gap: 12px;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media (max-width: 768px) {

    .resource-page-header {
      flex-direction: column;
      align-items: stretch;

      gap: 15px;
    }

    .resource-page-header .back-btn {
      width: 100%;
    }

    .resource-page-header h2 {
      font-size: 24px;
    }

    .resource-page-header p {
      font-size: 14px;
    }

    .resource-card .card-header {
      padding: 14px;
    }

    .resource-card .card-header .col-md-6 {
      width: 100%;
    }

    .resource-card .card-header h5 {
      font-size: 16px;
    }

    .resource-search {
      margin-top: 5px;
    }

    .custom-breadcrumb .breadcrumb-item {
      font-size: 13px;
    }

    .custom-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
      padding: 0 5px;
    }

  }


  /* =========================================================
     SMALL MOBILE
  ========================================================= */

  @media (max-width: 576px) {

    .resource-page-header h2 {
      font-size: 21px;
    }

    .resource-page-header p {
      font-size: 13px;
    }

    .resource-page-header .back-btn {
      width: 100%;
    }

    .custom-breadcrumb {
      margin-bottom: 15px !important;
    }

    .custom-breadcrumb .breadcrumb-item {
      font-size: 12px;
    }

    .resource-card {
      border-radius: 8px;
    }

    .resource-card .card-header {
      padding: 12px;
    }

    #resourceTable {
      min-width: 1000px;
    }

    .resource-empty-state {
      padding: 45px 15px;
    }

    .resource-empty-state h5 {
      font-size: 16px;
    }

  }
</style>


<div class="resource-page">

  <!-- ======================================================
       BREADCRUMB
  ======================================================= -->

  <nav aria-label="breadcrumb" class="custom-breadcrumb mb-2">

    <ol class="breadcrumb">

      <li class="breadcrumb-item">
        <%= link_to "Dashboard", teacher_dashboard_path %>
      </li>

      <li class="breadcrumb-item">
        <%= link_to "My Courses", teacher_panel_courses_path %>
      </li>

      <li class="breadcrumb-item">
        <%= link_to @course.Course_name,
            teacher_panel_course_path(@course) %>
      </li>

      <li class="breadcrumb-item active"
          aria-current="page">
        Resources
      </li>

    </ol>

  </nav>


  <% content_for :title, "Resources" %>


  <!-- ======================================================
       PAGE HEADER
  ======================================================= -->

  <div class="resource-page-header">

    <div>

      <h2 class="fw-bold">
        📂 My Resources
      </h2>

      <p class="text-muted">
        Manage resources for your assigned course.
      </p>

    </div>


    <%= link_to new_teacher_panel_course_resource_path(@course),
        class: "btn btn-outline-secondary back-btn" do %>

      <i class="bi bi-plus-circle"></i>
      Upload Resource

    <% end %>

  </div>


  <!-- ======================================================
       RESOURCE CARD
  ======================================================= -->

  <div class="card shadow border-0 resource-card">


    <!-- =========================
         CARD HEADER
    ========================== -->

    <div class="card-header bg-light">

      <div class="row align-items-center g-3">


        <!-- Total Resources -->

        <div class="col-md-6">

          <h5 class="mb-0">

            Total Resources :

            <span class="badge bg-primary">
              <%= @resources.count %>
            </span>

          </h5>

        </div>


        <!-- Search -->

        <div class="col-md-6 resource-search">

          <input
            type="text"
            id="searchResource"
            class="form-control"
            placeholder="🔍 Search Resource"
            autocomplete="off">

        </div>

      </div>

    </div>


    <!-- ======================================================
         TABLE
    ======================================================= -->

    <div class="resource-table-wrapper">

      <table
        class="table table-hover align-middle mb-0"
        id="resourceTable">

        <thead class="table-dark">

          <tr>

            <th>#</th>

            <th>Title</th>

            <th>Playlist</th>

            <th>Description</th>

            <th>Type</th>

            <th>Uploaded</th>

            <th>File</th>

            <th width="170">
              Action
            </th>

          </tr>

        </thead>


        <tbody>


          <% if @resources.any? %>


            <% @resources.each_with_index do |resource, index| %>


              <tr>


                <!-- Number -->

                <td>
                  <%= index + 1 %>
                </td>


                <!-- Title -->

                <td class="fw-semibold">

                  <%= resource.title %>

                </td>


                <!-- Playlist -->

                <td>

                  <%= resource.playlist&.title || "No Playlist" %>

                </td>


                <!-- Description -->

                <td>

                  <%= truncate(
                        resource.description.to_s,
                        length: 60
                      ) %>

                </td>


                <!-- Type -->

                <td>

                  <span class="badge
                    <%= case resource.resource_type
                        when 'pdf'
                          'bg-danger'
                        when 'ppt'
                          'bg-warning text-dark'
                        when 'assignment'
                          'bg-info'
                        when 'zip_file'
                          'bg-secondary'
                        else
                          'bg-primary'
                        end %>">

                    <%= resource.resource_type.to_s.titleize %>

                  </span>

                </td>


                <!-- Uploaded -->

                <td>

                  <%= resource.created_at.strftime(
                        "%d %b %Y"
                      ) %>

                </td>


                <!-- File -->

                <td>


                  <% if resource.file.attached? %>


                    <div class="btn-group resource-actions">


                      <!-- View -->

                      <%= link_to rails_blob_path(resource.file),
                          target: "_blank",
                          rel: "noopener",
                          class: "btn btn-outline-primary btn-sm",
                          title: "View File" do %>

                        <i class="bi bi-eye"></i>

                      <% end %>


                      <!-- Download -->

                      <%= link_to rails_blob_path(
                            resource.file,
                            disposition: "attachment"
                          ),
                          class: "btn btn-success btn-sm",
                          title: "Download File" do %>

                        <i class="bi bi-download"></i>

                      <% end %>


                    </div>


                  <% else %>


                    <span class="text-danger">
                      No File
                    </span>


                  <% end %>


                </td>


                <!-- Actions -->

                <td>


                  <div class="btn-group resource-actions">


                    <!-- Edit -->

                    <%= link_to edit_teacher_panel_course_resource_path(
                          @course,
                          resource
                        ),
                        class: "btn btn-warning btn-sm",
                        title: "Edit Resource" do %>

                      <i class="bi bi-pencil"></i>

                    <% end %>


                    <!-- Delete -->

                    <%= button_to teacher_panel_course_resource_path(
                          @course,
                          resource
                        ),
                        method: :delete,
                        form: {
                          data: {
                            turbo_confirm: "Delete this resource?"
                          }
                        },
                        class: "btn btn-danger btn-sm",
                        title: "Delete Resource" do %>

                      <i class="bi bi-trash"></i>

                    <% end %>


                  </div>


                </td>


              </tr>


            <% end %>


          <% else %>


            <!-- =================================================
                 EMPTY STATE
            ================================================== -->

            <tr>

              <td
                colspan="8"
                class="text-center">

                <div class="resource-empty-state">

                  <i class="bi bi-folder-x text-secondary"></i>

                  <h5 class="mt-3 text-muted">
                    No Resources Uploaded Yet
                  </h5>


                  <%= link_to new_teacher_panel_course_resource_path(
                        @course
                      ),
                      class: "btn btn-outline-secondary back-btn" do %>

                    <i class="bi bi-plus-circle"></i>
                    Upload First Resource

                  <% end %>


                </div>

              </td>

            </tr>


          <% end %>


        </tbody>

      </table>

    </div>

  </div>

</div>


<script>
  document.addEventListener("turbo:load", function () {

    const search = document.getElementById("searchResource");

    if (!search) return;

    /* Prevent duplicate event listeners with Turbo */
    if (search.dataset.searchInitialized === "true") return;

    search.dataset.searchInitialized = "true";


    search.addEventListener("input", function () {

      const value = this.value.trim().toLowerCase();

      const rows = document.querySelectorAll(
        "#resourceTable tbody tr"
      );


      rows.forEach(function (row) {

        const text = row.innerText.toLowerCase();

        row.style.display =
          text.includes(value)
            ? ""
            : "none";

      });

    });

  });
</script>