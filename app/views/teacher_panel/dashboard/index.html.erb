<div class="container-fluid">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">
      Teacher Dashboard
    </h2>

    <%# <%= link_to "View Courses",
    teacher_panel_courses_path,
    class: "btn btn-primary" %> 
  </div>

  <div class="row g-4">

    <!-- Total Courses -->
    <div class="col-md-4">
      <div class="card bg-primary text-white shadow border-0">
        <div class="card-body">
          <h6>Total Courses</h6>
          <h2><%= @courses.count %></h2>
        </div>
      </div>
    </div>

    <!-- Total Students -->
    <div class="col-md-4">
      <div class="card bg-success text-white shadow border-0">
        <div class="card-body">
          <h6>Total Students</h6>
          <h2><%= @students.count %></h2>
        </div>
      </div>
    </div>

    <!-- Total Videos -->
    <div class="col-md-4">
      <div class="card bg-danger text-white shadow border-0">
        <div class="card-body">
          <h6>Total Videos</h6>
          <h2><%= @videos.count %></h2>
        </div>
      </div>
    </div>

  </div>

  <div class="row mt-4">

    <!-- Recent Students -->
    <div class="col-lg-6">

      <div class="card shadow">

        <div class="card-header bg-primary text-white">
          Recent Students
        </div>

        <ul class="list-group list-group-flush">

          <% if @recent_students.any? %>

            <% @recent_students.each do |student| %>

              <li class="list-group-item">
                <strong><%= student.name %></strong><br>
                <small><%= student.email %></small>
              </li>

            <% end %>

          <% else %>

            <li class="list-group-item text-muted">
              No students found.
            </li>

          <% end %>

        </ul>

      </div>

    </div>

    <!-- Recent Courses -->
    <div class="col-lg-6">

      <div class="card shadow">

        <div class="card-header bg-success text-white">
          Recent Courses
        </div>

        <ul class="list-group list-group-flush">

          <% if @recent_courses.any? %>

            <% @recent_courses.each do |course| %>

              <li class="list-group-item">
                <%= course.Course_name %>
              </li>

            <% end %>

          <% else %>

            <li class="list-group-item text-muted">
              No courses assigned.
            </li>

          <% end %>

        </ul>

      </div>

    </div>

  </div>

</div>