<style>
  /* ===========================
   Teacher Students Page
=========================== */

.container-fluid {
  padding: 25px;
}

/* Page Heading */
.page-title h2 {
  font-size: 2rem;
  font-weight: 700;
  color: #1f2937;
}
.back-btn {
  padding: 5px 12px;
  font-size: 13px;
  font-weight: 500;
  border-radius: 6px;
  min-width: 120px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

/* Back Button */
.back-btn {
  padding: 4px 10px !important;
  font-size: 12px !important;
  font-weight: 500;
  border-radius: 6px;
  min-width: auto;
  height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  transition: all 0.3s ease;
}

.back-btn i {
  font-size: 11px;
}

.back-btn:hover {
  transform: translateY(-2px);
}
/* Card */
.card {
  border: none;
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
}

/* Card Header */
.card-header {
  background: linear-gradient(135deg, #0d6efd, #2563eb);
  color: white;
  padding: 16px 20px;
}

.card-header h5 {
  margin: 0;
  font-weight: 600;
}

/* Table */
.table {
  margin-bottom: 0;
}

.table thead th {
  background: #1f2937;
  color: #fff;
  border: none;
  font-size: 14px;
  font-weight: 600;
  padding: 14px;
}

.table tbody td {
  padding: 14px;
  vertical-align: middle;
  font-size: 14px;
}

.table tbody tr {
  transition: all 0.25s ease;
}

.table tbody tr:hover {
  background: #f8f9fa;
}

/* Student Name */
.table tbody td:nth-child(2) {
  font-weight: 600;
  color: #212529;
}

/* Badge */
.badge {
  padding: 6px 12px;
  border-radius: 50px;
  font-size: 12px;
  font-weight: 600;
}

/* Empty Row */
.text-muted {
  color: #6c757d !important;
}

/* Responsive */
@media (max-width: 768px) {

  .container-fluid {
    padding: 15px;
  }

  .page-title h2 {
    font-size: 1.5rem;
  }

  .table thead th,
  .table tbody td {
    font-size: 13px;
    padding: 10px;
  }

  .btn-secondary {
    width: 100%;
    margin-top: 10px;
  }
}


.custom-breadcrumb{
    background: transparent;
    padding: 0;
    margin: 0 0 12px 0;
    border: none;
    border-radius: 0;
    box-shadow: none;
}

.custom-breadcrumb .breadcrumb{
    margin:0;
}

.custom-breadcrumb .breadcrumb-item{
    font-size:15px;
    font-weight:500;
}

.custom-breadcrumb .breadcrumb-item a{
    color:#2563eb;
    text-decoration:none;
    transition:.3s;
}

.custom-breadcrumb .breadcrumb-item a:hover{
    color:#0d6efd;
}

.custom-breadcrumb .breadcrumb-item + .breadcrumb-item::before{
    content: ">";
    color:#6c757d;
    font-weight:bold;
}

.custom-breadcrumb .breadcrumb-item.active{
    color:#198754;
    font-weight:700;
}

.custom-breadcrumb i{
    margin-right:6px;
}



.back-btn{
    display:inline-flex;
    align-items:center;
    gap:5px;
    padding:6px 10px;   /* Small horizontal padding */
    width:auto;         /* Only as wide as its content */
    white-space:nowrap;
    font-size:14px;
    font-weight:500;
    border-radius:10px;
}

.back-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 4px 12px rgba(0,0,0,.12);
}

.back-btn i{
    
</style>
<nav aria-label="breadcrumb" class="custom-breadcrumb mb-4">

  <ol class="breadcrumb mb-0">

    <li class="breadcrumb-item">
      <%= link_to teacher_dashboard_path do %>
        <i class="bi bi-speedometer2"></i>
        Dashboard
      <% end %>
    </li>

    <li class="breadcrumb-item">
      <%= link_to teacher_panel_courses_path do %>
        <i class="bi bi-book"></i>
        My Courses
      <% end %>
    </li>

    <li class="breadcrumb-item">
      <%= link_to teacher_panel_course_path(@course) do %>
        <i class="bi bi-folder"></i>
        <%= @course.Course_name %>
      <% end %>
    </li>

    <li class="breadcrumb-item active" aria-current="page">
      <i class="bi bi-people-fill"></i>
      Students
    </li>

  </ol>

</nav>
<div class="container-fluid">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h2 class="fw-bold">
        👨‍🎓 <%= @course.Course_name %> Students
      </h2>

      <p class="text-muted mb-0">
        Total Students: <%= @students.count %>
      </p>
    </div>
    <%= link_to teacher_panel_courses_path,
      class: "btn btn-outline-secondary back-btn" do %>
    <i class="bi bi-arrow-left"></i>
    Back
  <% end %>

  </div>
   <div class="row mb-4">

  <div class="col-md-3">

    <div class="card shadow-sm border-0">

      <div class="card-body text-center">

        <i class="bi bi-people-fill fs-1 text-primary"></i>

        <h6 class="mt-2">Total Students</h6>

        <h2 class="text-primary mb-0">
          <%= @students.count %>
        </h2>

      </div>

    </div>

  </div>

</div>

  <div class="card shadow border-0">

    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">
        Enrolled Students
      </h5>
    </div>
    <div class="row mb-3">
  <div class="col-md-4 ms-auto">
    <input
      type="text"
      class="form-control"
      placeholder="🔍 Search student..."
    >
  </div>
</div>


    <div class="table-responsive">

      <table class="table table-hover align-middle mb-0">

       <thead class="table-dark">
          <tr>
             <th>#</th>
             <th>Name</th>
            <th>Email</th>
            <th>Mobile</th>
           <th>Status</th>
             <th>Action</th>
             </tr>
            </thead>

        <tbody>

          <% if @students.any? %>

            <% @students.each_with_index do |student, index| %>

              <tr>

                <td><%= index + 1 %></td>

                <td>
              <div class="d-flex align-items-center">

                  <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center me-3"
                style="width:40px;height:40px;">
                <%= student.name.first.upcase %>
              </div>

            <div>
              <strong><%= student.name %></strong><br>
              <small class="text-muted">Student</small>
              </div>

             </div>
             </td>

                <td><%= student.email %></td>

                <td>
                  <%= student.mobile.presence || "N/A" %>
                </td>

                <td>
                  <span class="badge bg-success custom-badge">
                    Enrolled
                  </span>
                </td>

              </tr>

            <% end %>

          <% else %>

            <tr>
              <td colspan="5" class="text-center py-4 text-muted">
                No students enrolled yet.
              </td>
            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>

</div>