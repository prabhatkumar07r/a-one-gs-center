<style>
  .question-show-page {
    max-width: 1000px;
    margin: 0 auto;
  }

  .question-show-card {
    background: #fff;
    border: 1px solid #e7e1ff;
    border-radius: 16px;
    box-shadow: 0 6px 20px rgba(111, 66, 193, .08);
    overflow: hidden;
  }

  .question-show-header {
    background: #f7f4ff;
    padding: 24px;
    border-bottom: 1px solid #e7e1ff;
  }

  .question-show-header h3 {
    margin: 0;
    font-weight: 700;
    color: #333;
  }

  .question-show-header p {
    margin: 6px 0 0;
    color: #777;
  }

  .question-show-body {
    padding: 28px;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 28px;
  }

  .info-box {
    background: #faf9ff;
    border: 1px solid #e6e0fa;
    border-radius: 12px;
    padding: 15px;
  }

  .info-label {
    font-size: 12px;
    color: #777;
    margin-bottom: 5px;
  }

  .info-value {
    font-size: 16px;
    font-weight: 700;
    color: #333;
  }

  .content-section {
    margin-top: 28px;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 17px;
    font-weight: 700;
    color: #333;
    margin-bottom: 14px;
  }

  .language-block {
    border: 1px solid #e7e1ff;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 14px;
  }

  .language-block-header {
    background: #f7f4ff;
    padding: 10px 15px;
    font-size: 13px;
    font-weight: 700;
    color: #6f42c1;
  }

  .language-block-content {
    padding: 17px;
    color: #333;
    line-height: 1.7;
    white-space: pre-wrap;
  }

  .option-card {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 15px;
    background: #faf9ff;
    border: 1px solid #e6e0fa;
    border-radius: 12px;
    margin-bottom: 12px;
  }

  .option-card.correct {
    background: #effaf3;
    border-color: #a9dfbd;
  }

  .option-number {
    width: 34px;
    height: 34px;
    min-width: 34px;
    border-radius: 9px;
    background: #eee8ff;
    color: #6f42c1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  .option-card.correct .option-number {
    background: #d1e7dd;
    color: #198754;
  }

  .option-content {
    flex: 1;
    min-width: 0;
  }

  .option-english {
    font-weight: 600;
    color: #333;
    margin-bottom: 7px;
  }

  .option-hindi {
    color: #555;
    line-height: 1.6;
  }

  .correct-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #198754;
    color: #fff;
    border-radius: 20px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
  }

  .explanation-box {
    background: #fff8e1;
    border: 1px solid #ffe08a;
    border-radius: 12px;
    padding: 18px;
    margin-top: 14px;
  }

  .explanation-title {
    color: #856404;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .explanation-content {
    color: #5f4b00;
    line-height: 1.7;
  }

  .action-buttons {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid #eee;
    margin-top: 30px;
    padding-top: 22px;
  }

  .btn-purple {
    background: #6f42c1;
    border-color: #6f42c1;
    color: #fff;
  }

  .btn-purple:hover {
    background: #5d35a8;
    border-color: #5d35a8;
    color: #fff;
  }

  @media (max-width: 768px) {

    .info-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .question-show-body {
      padding: 18px;
    }
  }

  @media (max-width: 500px) {

    .info-grid {
      grid-template-columns: 1fr;
    }

    .action-buttons {
      flex-direction: column;
    }

    .action-buttons a {
      width: 100%;
    }
  }
</style>


<div class="container-fluid py-4">

  <div class="question-show-page">


    <!-- =====================================================
         BREADCRUMB
    ====================================================== -->

    <div class="mb-4">

      <div class="text-muted small mb-2">

        Teacher Panel /
        Test Series /
        <%= @test_series.title %> /
        <%= @test.title %> /

        <span class="text-primary">
          Question <%= @question.position %>
        </span>

      </div>

      <h2 class="fw-bold mb-1">
        Question Details
      </h2>

      <p class="text-muted mb-0">
        View English and Hindi question content, options and explanation.
      </p>

    </div>


    <!-- =====================================================
         CARD
    ====================================================== -->

    <div class="question-show-card">


      <!-- HEADER -->

      <div class="question-show-header">

        <h3>

          <i class="fas fa-circle-question text-primary me-2"></i>

          Question <%= @question.position %>

        </h3>

        <p>
          <%= @test.title %>
        </p>

      </div>


      <!-- BODY -->

      <div class="question-show-body">


        <!-- =================================================
             INFO
        ================================================== -->

        <div class="info-grid">

          <div class="info-box">

            <div class="info-label">
              Question No.
            </div>

            <div class="info-value">
              <%= @question.position %>
            </div>

          </div>


          <div class="info-box">

            <div class="info-label">
              Marks
            </div>

            <div class="info-value">
              <%= @question.marks %>
            </div>

          </div>


          <div class="info-box">

            <div class="info-label">
              Question Type
            </div>

            <div class="info-value">

              <%= @question.question_type
                    .to_s
                    .humanize %>

            </div>

          </div>


          <div class="info-box">

            <div class="info-label">
              Options
            </div>

            <div class="info-value">
              <%= @question.test_series_options.count %>
            </div>

          </div>

        </div>


        <!-- =================================================
             QUESTION
        ================================================== -->

        <div class="content-section">

          <div class="section-title">

            <i class="fas fa-question-circle text-primary"></i>

            Question

          </div>


          <!-- ENGLISH -->

          <div class="language-block">

            <div class="language-block-header">

              🇬🇧 English

            </div>

            <div class="language-block-content">

              <%= @question.question_text.presence ||
                  "No English question available." %>

            </div>

          </div>


          <!-- HINDI -->

          <div class="language-block">

            <div class="language-block-header">

              🇮🇳 हिंदी

            </div>

            <div class="language-block-content">

              <%= @question.question_text_hindi.presence ||
                  @question.question_text %>

            </div>

          </div>

        </div>


        <!-- =================================================
             OPTIONS
        ================================================== -->

        <div class="content-section">

          <div class="section-title">

            <i class="fas fa-list-ul text-primary"></i>

            Answer Options

          </div>


          <% @question.test_series_options
              .order(position: :asc)
              .each_with_index do |option, index| %>


            <div class="option-card
              <%= "correct" if option.is_correct? %>">


              <div class="option-number">

                <%= index + 1 %>

              </div>


              <div class="option-content">


                <!-- ENGLISH -->

                <div class="option-english">

                  <strong>
                    English:
                  </strong>

                  <%= option.option_text %>

                </div>


                <!-- HINDI -->

                <div class="option-hindi">

                  <strong>
                    हिंदी:
                  </strong>

                  <%= option.option_text_hindi.presence ||
                      option.option_text %>

                </div>


              </div>


              <% if option.is_correct? %>

                <span class="correct-badge">

                  <i class="fas fa-check"></i>

                  Correct

                </span>

              <% end %>


            </div>

          <% end %>

        </div>


        <!-- =================================================
             EXPLANATION
        ================================================== -->

        <% if @question.explanation.present? ||
              @question.explanation_hindi.present? %>


          <div class="content-section">

            <div class="section-title">

              <i class="fas fa-lightbulb text-warning"></i>

              Explanation

            </div>


            <!-- ENGLISH -->

            <% if @question.explanation.present? %>

              <div class="explanation-box">

                <div class="explanation-title">

                  🇬🇧 English Explanation

                </div>

                <div class="explanation-content">

                  <%= simple_format(
                        @question.explanation
                      ) %>

                </div>

              </div>

            <% end %>


            <!-- HINDI -->

            <% if @question.explanation_hindi.present? %>

              <div class="explanation-box">

                <div class="explanation-title">

                  🇮🇳 हिंदी व्याख्या

                </div>

                <div class="explanation-content">

                  <%= simple_format(
                        @question.explanation_hindi
                      ) %>

                </div>

              </div>

            <% end %>

          </div>

        <% end %>


        <!-- =================================================
             ACTIONS
        ================================================== -->

        <div class="action-buttons">


          <%= link_to teacher_panel_test_series_test_questions_path(
                @test_series,
                @test
              ),
              class: "btn btn-outline-secondary" do %>

            <i class="fas fa-arrow-left me-1"></i>

            Back to Questions

          <% end %>


          <div class="d-flex gap-2">

            <%= link_to edit_teacher_panel_test_series_test_question_path(
                  @test_series,
                  @test,
                  @question
                ),
                class: "btn btn-purple" do %>

              <i class="fas fa-edit me-1"></i>

              Edit Question

            <% end %>


            <%= button_to teacher_panel_test_series_test_question_path(
                  @test_series,
                  @test,
                  @question
                ),
                method: :delete,
                class: "btn btn-outline-danger",
                form: {
                  data: {
                    turbo_confirm: "Are you sure you want to delete this question?"
                  }
                } do %>

              <i class="fas fa-trash me-1"></i>

              Delete

            <% end %>

          </div>

        </div>


      </div>

    </div>

  </div>

</div>