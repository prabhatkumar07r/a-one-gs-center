<style>
.custom-breadcrumb{
    background:transparent;
    padding:0;
    border-radius:0;
    box-shadow:none;
    margin-bottom:12px;
}
.main-content{
    margin-top:15px;
    padding-top:15px;
}

.custom-breadcrumb .breadcrumb{
    margin:0;
}

.custom-breadcrumb .breadcrumb-item{
    font-size:15px;
    font-weight:500;
}

.custom-breadcrumb .breadcrumb-item a{
    color:#2563eb;
    text-decoration:none;
    transition:.3s;
}

.custom-breadcrumb .breadcrumb-item a:hover{
    color:#0d6efd;
}

.custom-breadcrumb .breadcrumb-item + .breadcrumb-item::before{
    content: ">";
    color:#6c757d;
    font-weight:bold;
}

.custom-breadcrumb .breadcrumb-item.active{
    color:#198754;
    font-weight:700;
}

.custom-breadcrumb i{
    margin-right:6px;
}
.container-fluid{
     padding-top:10px !important
}
.container-fluid{
    padding-top:10px;
    padding-left:25px;
    padding-right:25px;
    padding-bottom:25px;
}
.admin-content{
    padding:85px 30px 30px;
}

.custom-breadcrumb{
    background:transparent;
    padding:0;
    margin-bottom:10px;
}

.d-flex.justify-content-between{
    margin-bottom:20px !important;
}

</style>


<div class="container-fluid px-0 pt-2">
 <nav aria-label="breadcrumb" class="custom-breadcrumb mb-4">

  <ol class="breadcrumb mb-0">

    <li class="breadcrumb-item">
      <%= link_to teacher_dashboard_path do %>
        <i class="bi bi-speedometer2"></i>
        Dashboard
      <% end %>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
      <i class="bi bi-book"></i>
      My Courses
    </li>

 

  </ol>
</nav>

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h2 class="fw-bold">📚 My Courses</h2>
      <p class="text-muted mb-0">
        Manage your course content, playlists, videos and resources.
      </p>
    </div>

  </div>


  <div class="row">

    <% @courses.each do |course| %>

      <div class="col-lg-4 col-md-6 mb-4">

        <div class="card border-0 shadow-lg h-100">


          <div class="card-body">


            <h4 class="fw-bold text-primary">
              <%= course.Course_name %>
            </h4>


            <hr>


            <p>
              <i class="bi bi-clock-fill text-primary"></i>
              <strong>Duration:</strong>
              <%= course.duration %>
            </p>


            <p>
              <i class="bi bi-currency-rupee text-success"></i>
              <strong>Fee:</strong>
              ₹<%= course.fee %>
            </p>


            <p>
              <i class="bi bi-play-circle-fill text-danger"></i>
              <strong>Videos:</strong>
              <%= course.videos.count %>
            </p>


            <p>
              <i class="bi bi-collection-play-fill text-warning"></i>
              <strong>Playlists:</strong>
              <%= course.playlists.count %>
            </p>



            <div class="d-grid gap-2 mt-4">


              <!-- Course Details -->
              <%= link_to teacher_panel_course_path(course),
                  class: "btn btn-primary" do %>

                <i class="bi bi-eye-fill"></i>
                Manage Course

              <% end %>



              <!-- Students -->
              <%= link_to teacher_panel_course_students_path(course),
                  class: "btn btn-info text-white" do %>

                <i class="bi bi-people-fill"></i>
                Students

              <% end %>




              <!-- Playlists -->
               <%= link_to teacher_panel_course_playlists_path(course),
             class: "btn btn-success" do %>

            <i class="bi bi-collection-play-fill"></i>
            Playlists

           <% end %>




              <!-- Videos -->
               <%= link_to teacher_panel_course_videos_path(course),
class:"btn btn-warning text-dark" do %>

<i class="bi bi-camera-video-fill"></i>
Videos

<% end %>



            </div>


          </div>


        </div>


      </div>


    <% end %>


  </div>


</div>