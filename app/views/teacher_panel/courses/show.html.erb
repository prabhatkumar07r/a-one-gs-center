<div class="container-fluid">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h2 class="fw-bold">
        📚 <%= @course.Course_name %>
      </h2>

      <p class="text-muted mb-0">
        Manage your course content from one place.
      </p>
    </div>

    <%= link_to teacher_panel_courses_path,
          class: "btn btn-secondary" do %>

      <i class="bi bi-arrow-left"></i>
      Back

    <% end %>

  </div>


  <!-- Statistics -->

  <div class="row g-4 mb-4">


    <div class="col-md-3">
      <div class="card shadow border-start border-primary border-4">

        <div class="card-body text-center">

          <h6>Playlists</h6>

          <h2>
            <%= @course.playlists.count %>
          </h2>

        </div>

      </div>
    </div>



    <div class="col-md-3">
      <div class="card shadow border-start border-success border-4">

        <div class="card-body text-center">

          <h6>Videos</h6>

          <h2>
            <%= @course.videos.count %>
          </h2>

        </div>

      </div>
    </div>



    <div class="col-md-3">
      <div class="card shadow border-start border-info border-4">

        <div class="card-body text-center">

          <h6>Resources</h6>

          <h2>
            <%= Resource.joins(:playlist)
                .where(playlists: { course_id: @course.id })
                .count %>
          </h2>

        </div>

      </div>
    </div>



    <div class="col-md-3">
      <div class="card shadow border-start border-warning border-4">

        <div class="card-body text-center">

          <h6>Students</h6>

          <h2>
            <%= @course.students.count %>
          </h2>

        </div>

      </div>
    </div>


  </div>




  <!-- Quick Actions -->

  <div class="card shadow mb-4">


    <div class="card-header">

      <h5 class="mb-0">
        Quick Actions
      </h5>

    </div>



    <div class="card-body">


      <div class="row g-3">



        <!-- Playlists -->

        <div class="col-md-3">

          <%= link_to teacher_panel_course_playlists_path(@course),
              class: "btn btn-primary w-100 py-3" do %>

            <i class="bi bi-collection-play-fill"></i><br>

            Playlists

          <% end %>

        </div>





        <!-- Students -->

        <div class="col-md-3">

          <%= link_to teacher_panel_course_students_path(@course),
              class: "btn btn-dark w-100 py-3" do %>

            <i class="bi bi-people-fill"></i><br>

            Students

          <% end %>

        </div>





        <!-- Videos -->

        <div class="col-md-3">

          <%= link_to teacher_panel_course_videos_path(@course),
              class: "btn btn-success w-100 py-3" do %>

            <i class="bi bi-camera-video-fill"></i><br>

            Videos

          <% end %>

        </div>





        <!-- Resources -->

        <div class="col-md-3">

          <%= link_to teacher_panel_course_resources_path(@course),
              class: "btn btn-info text-white w-100 py-3" do %>

            <i class="bi bi-file-earmark-text-fill"></i><br>

            Resources

          <% end %>

        </div>



      </div>


    </div>


  </div>





  <!-- Playlist List -->

  <div class="card shadow">


    <div class="card-header bg-dark text-white">

      Course Playlists

    </div>




    <div class="card-body">


      <% if @playlists.any? %>


        <% @playlists.each do |playlist| %>


          <div class="card mb-3">


            <div class="card-header d-flex justify-content-between">


              <strong>
                <%= playlist.title %>
              </strong>


              <span class="badge bg-primary">

                <%= playlist.videos.count %> Videos

              </span>


            </div>





            <ul class="list-group list-group-flush">


              <% playlist.videos.order(:position).each do |video| %>


                <li class="list-group-item d-flex justify-content-between">


                  <span>
                    <%= video.title %>
                  </span>


                  <span class="badge bg-success">

                    <%= video.duration %>

                  </span>


                </li>


              <% end %>


            </ul>


          </div>


        <% end %>





      <% else %>



        <div class="text-center py-5">


          <h5>
            No playlists found.
          </h5>



         <%= link_to "Create Playlist",
        new_teacher_panel_course_playlist_path(@course),
       class: "btn btn-primary mt-3" %>


        </div>



      <% end %>



    </div>


  </div>



</div>