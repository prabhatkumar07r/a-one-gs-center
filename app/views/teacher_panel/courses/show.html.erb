<style>
/* =========================================================
   TEACHER COURSE DETAILS PAGE
   All CSS is scoped to this page only.
========================================================= */

.teacher-course-page {
    width: 100%;
    padding: 10px 25px 35px;
}

/* =========================================================
   BREADCRUMB
========================================================= */

.teacher-course-page .custom-breadcrumb {
    background: #fff;
    padding: 12px 20px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
    border: 1px solid #e9ecef;
    margin-bottom: 25px;
}

.teacher-course-page .custom-breadcrumb .breadcrumb {
    margin: 0;
    padding: 0;
    background: transparent;
    flex-wrap: wrap;
}

.teacher-course-page .custom-breadcrumb .breadcrumb-item {
    font-size: 15px;
    font-weight: 500;
    display: flex;
    align-items: center;
}

.teacher-course-page .custom-breadcrumb .breadcrumb-item a {
    color: #0d6efd;
    text-decoration: none;
    transition: .3s ease;
    display: flex;
    align-items: center;
}

.teacher-course-page .custom-breadcrumb .breadcrumb-item a:hover {
    color: #084298;
}

.teacher-course-page
.custom-breadcrumb
.breadcrumb-item
+ .breadcrumb-item::before {
    content: ">";
    color: #6c757d;
    font-weight: 600;
    padding: 0 10px;
}

.teacher-course-page
.custom-breadcrumb
.breadcrumb-item.active {
    color: #198754;
    font-weight: 700;
}

.teacher-course-page .custom-breadcrumb i {
    margin-right: 6px;
    font-size: 14px;
}

/* =========================================================
   HEADER
========================================================= */

.teacher-course-page .course-page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
    margin-bottom: 25px;
}

.teacher-course-page .course-page-title {
    margin: 0;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.3;
    color: #212529;
}

.teacher-course-page .course-page-subtitle {
    margin: 6px 0 0;
    color: #6c757d;
    font-size: 15px;
    line-height: 1.5;
}

/* =========================================================
   BACK BUTTON
========================================================= */

.teacher-course-page .back-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 7px 13px;
    width: auto;
    white-space: nowrap;
    font-size: 14px;
    font-weight: 500;
    border-radius: 10px;
    transition: .25s ease;
}

.teacher-course-page .back-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 0, 0, .12);
}

.teacher-course-page .back-btn i {
    font-size: 15px;
}

/* =========================================================
   STATISTICS
========================================================= */

.teacher-course-page .course-stat-card {
    height: 100%;
    border-radius: 14px;
    transition:
        transform .25s ease,
        box-shadow .25s ease;
    overflow: hidden;
}

.teacher-course-page .course-stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, .12) !important;
}

.teacher-course-page .course-stat-card .card-body {
    padding: 22px 15px;
}

.teacher-course-page .course-stat-card h6 {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 8px;
}

.teacher-course-page .course-stat-card h2 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 8px;
}

.teacher-course-page .course-stat-card small {
    font-size: 13px;
    font-weight: 500;
}

/* =========================================================
   QUICK ACTIONS CARD
========================================================= */

.teacher-course-page .quick-actions-card {
    border: 0;
    border-radius: 15px;
    overflow: hidden;
}

.teacher-course-page .quick-actions-header {
    background: #fff;
    padding: 17px 20px;
    border-bottom: 1px solid #e9ecef;
}

.teacher-course-page .quick-actions-header h5 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
}

.teacher-course-page .quick-actions-body {
    padding: 22px;
}

/* =========================================================
   QUICK ACTION BUTTONS
========================================================= */

.teacher-course-page .quick-action-btn {
    width: 100%;
    min-height: 145px;
    padding: 22px 15px !important;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    transition:
        transform .25s ease,
        box-shadow .25s ease,
        background-color .25s ease;
}

.teacher-course-page .quick-action-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, .12);
}

.teacher-course-page .quick-action-btn i {
    font-size: 32px !important;
    margin-bottom: 10px !important;
}

.teacher-course-page .quick-action-btn strong {
    font-size: 16px;
}

.teacher-course-page .quick-action-btn small {
    font-size: 12px;
    margin-top: 4px;
    line-height: 1.4;
}

/* =========================================================
   LARGE DESKTOP
========================================================= */

@media (min-width: 1200px) {

    .teacher-course-page {
        padding-left: 25px;
        padding-right: 25px;
    }

    .teacher-course-page .course-page-title {
        font-size: 30px;
    }

}

/* =========================================================
   LAPTOP / SMALL DESKTOP
========================================================= */

@media (max-width: 1199.98px) {

    .teacher-course-page {
        padding-left: 20px;
        padding-right: 20px;
    }

    .teacher-course-page .course-page-title {
        font-size: 28px;
    }

    .teacher-course-page .course-stat-card .card-body {
        padding: 20px 12px;
    }

}

/* =========================================================
   TABLET
========================================================= */

@media (max-width: 991.98px) {

    .teacher-course-page {
        padding: 10px 18px 30px;
    }

    .teacher-course-page .course-page-header {
        align-items: flex-start;
    }

    .teacher-course-page .course-page-title {
        font-size: 26px;
    }

    .teacher-course-page .course-page-subtitle {
        font-size: 14px;
    }

    .teacher-course-page .course-stat-card h2 {
        font-size: 28px;
    }

    .teacher-course-page .quick-actions-body {
        padding: 18px;
    }

    .teacher-course-page .quick-action-btn {
        min-height: 135px;
    }

}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 767.98px) {

    .teacher-course-page {
        padding: 8px 15px 25px;
    }

    /* Breadcrumb */

    .teacher-course-page .custom-breadcrumb {
        padding: 10px 14px;
        margin-bottom: 18px;
        border-radius: 10px;
    }

    .teacher-course-page
    .custom-breadcrumb
    .breadcrumb-item {
        font-size: 13px;
    }

    .teacher-course-page
    .custom-breadcrumb
    .breadcrumb-item
    + .breadcrumb-item::before {
        padding: 0 6px;
    }

    /* Header */

    .teacher-course-page .course-page-header {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 15px;
        margin-bottom: 20px;
    }

    .teacher-course-page .course-page-title {
        font-size: 23px;
    }

    .teacher-course-page .course-page-subtitle {
        font-size: 13px;
    }

    /* Back button */

    .teacher-course-page .back-btn {
        align-self: flex-start;
        font-size: 13px;
        padding: 7px 12px;
    }

    /* Statistics */

    .teacher-course-page .course-stat-card .card-body {
        padding: 18px 10px;
    }

    .teacher-course-page .course-stat-card h6 {
        font-size: 14px;
    }

    .teacher-course-page .course-stat-card h2 {
        font-size: 26px;
    }

    .teacher-course-page .course-stat-card small {
        font-size: 12px;
    }

    /* Quick actions */

    .teacher-course-page .quick-actions-card {
        border-radius: 12px;
    }

    .teacher-course-page .quick-actions-header {
        padding: 15px;
    }

    .teacher-course-page .quick-actions-header h5 {
        font-size: 17px;
    }

    .teacher-course-page .quick-actions-body {
        padding: 15px;
    }

    .teacher-course-page .quick-action-btn {
        min-height: 125px;
        padding: 18px 10px !important;
    }

    .teacher-course-page .quick-action-btn i {
        font-size: 28px !important;
    }

}

/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 480px) {

    .teacher-course-page {
        padding: 7px 10px 20px;
    }

    /* Breadcrumb */

    .teacher-course-page .custom-breadcrumb {
        padding: 9px 11px;
    }

    .teacher-course-page
    .custom-breadcrumb
    .breadcrumb-item {
        font-size: 12px;
    }

    .teacher-course-page .custom-breadcrumb i {
        font-size: 12px;
        margin-right: 4px;
    }

    /* Header */

    .teacher-course-page .course-page-title {
        font-size: 21px;
    }

    .teacher-course-page .course-page-subtitle {
        font-size: 12px;
    }

    /* Statistics */

    .teacher-course-page .course-stat-card {
        border-radius: 11px;
    }

    .teacher-course-page .course-stat-card .card-body {
        padding: 16px 8px;
    }

    .teacher-course-page .course-stat-card h6 {
        font-size: 13px;
    }

    .teacher-course-page .course-stat-card h2 {
        font-size: 23px;
    }

    .teacher-course-page .course-stat-card small {
        font-size: 11px;
    }

    /* Quick Actions */

    .teacher-course-page .quick-actions-header {
        padding: 13px;
    }

    .teacher-course-page .quick-actions-header h5 {
        font-size: 16px;
    }

    .teacher-course-page .quick-actions-body {
        padding: 12px;
    }

    .teacher-course-page .quick-action-btn {
        min-height: 115px;
        padding: 15px 8px !important;
    }

    .teacher-course-page .quick-action-btn i {
        font-size: 25px !important;
        margin-bottom: 7px !important;
    }

    .teacher-course-page .quick-action-btn strong {
        font-size: 14px;
    }

    .teacher-course-page .quick-action-btn small {
        font-size: 10px;
    }

}

/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 360px) {

    .teacher-course-page {
        padding-left: 8px;
        padding-right: 8px;
    }

    .teacher-course-page .course-page-title {
        font-size: 19px;
    }

    .teacher-course-page .course-stat-card h2 {
        font-size: 21px;
    }

    .teacher-course-page .course-stat-card h6 {
        font-size: 12px;
    }

    .teacher-course-page .course-stat-card small {
        font-size: 10px;
    }

    .teacher-course-page .quick-action-btn {
        min-height: 108px;
    }

}
</style>


<!-- =========================================================
     TEACHER COURSE DETAILS PAGE
========================================================= -->

<div class="teacher-course-page">

  <!-- =======================================================
       BREADCRUMB
  ======================================================== -->

  <nav aria-label="breadcrumb" class="custom-breadcrumb">

    <ol class="breadcrumb">

      <li class="breadcrumb-item">

        <%= link_to teacher_dashboard_path do %>

          <i class="bi bi-house-door-fill"></i>

          Dashboard

        <% end %>

      </li>


      <li class="breadcrumb-item">

        <%= link_to teacher_panel_courses_path do %>

          <i class="bi bi-journal-bookmark-fill"></i>

          My Courses

        <% end %>

      </li>


      <li class="breadcrumb-item active" aria-current="page">

        <i class="bi bi-book-fill"></i>

        <%= @course.Course_name %>

      </li>

    </ol>

  </nav>


  <!-- =======================================================
       COURSE HEADER
  ======================================================== -->

  <div class="course-page-header">

    <div>

      <h2 class="course-page-title">

        📚 <%= @course.Course_name %>

      </h2>

      <p class="course-page-subtitle">

        Manage your course content from one place.

      </p>

    </div>


    <%= link_to teacher_panel_courses_path,
        class: "btn btn-outline-secondary back-btn" do %>

      <i class="bi bi-arrow-left"></i>

      <span>Back</span>

    <% end %>

  </div>


  <!-- =======================================================
       STATISTICS
  ======================================================== -->

  <div class="row g-3 g-md-4 mb-4">


    <!-- =====================================================
         PLAYLISTS
    ====================================================== -->

    <div class="col-6 col-lg-3">

      <%= link_to teacher_panel_course_playlists_path(@course),
          class: "text-decoration-none text-dark" do %>

        <div class="card shadow border-start border-primary border-4
                    course-stat-card">

          <div class="card-body text-center">

            <h6>
              Playlists
            </h6>

            <h2>
              <%= @course.playlists.count %>
            </h2>

            <small class="text-primary">
              View Playlists →
            </small>

          </div>

        </div>

      <% end %>

    </div>


    <!-- =====================================================
         VIDEOS
    ====================================================== -->

    <div class="col-6 col-lg-3">

      <%= link_to teacher_panel_course_videos_path(@course),
          class: "text-decoration-none text-dark" do %>

        <div class="card shadow border-start border-success border-4
                    course-stat-card">

          <div class="card-body text-center">

            <h6>
              Videos
            </h6>

            <h2>
              <%= @course.videos.count %>
            </h2>

            <small class="text-success">
              View Videos →
            </small>

          </div>

        </div>

      <% end %>

    </div>


    <!-- =====================================================
         RESOURCES
    ====================================================== -->

    <div class="col-6 col-lg-3">

      <%= link_to teacher_panel_course_resources_path(@course),
          class: "text-decoration-none text-dark" do %>

        <div class="card shadow border-start border-info border-4
                    course-stat-card">

          <div class="card-body text-center">

            <h6>
              Resources
            </h6>

            <h2>

              <%= Resource.joins(:playlist)
                  .where(playlists: { course_id: @course.id })
                  .count %>

            </h2>

            <small class="text-info">
              View Resources →
            </small>

          </div>

        </div>

      <% end %>

    </div>


    <!-- =====================================================
         STUDENTS
    ====================================================== -->

    <div class="col-6 col-lg-3">

      <%= link_to teacher_panel_course_students_path(@course),
          class: "text-decoration-none text-dark" do %>

        <div class="card shadow border-start border-warning border-4
                    course-stat-card">

          <div class="card-body text-center">

            <h6>
              Students
            </h6>

            <h2>
              <%= @course.students.count %>
            </h2>

            <small class="text-warning">
              View Students →
            </small>

          </div>

        </div>

      <% end %>

    </div>

  </div>


  <!-- =======================================================
       QUICK ACTIONS
  ======================================================== -->

  <div class="card shadow mb-4 quick-actions-card">


    <!-- Header -->

    <div class="quick-actions-header">

      <h5>
        🚀 Quick Actions
      </h5>

    </div>


    <!-- Body -->

    <div class="quick-actions-body">

      <div class="row g-3">


        <!-- =================================================
             STUDENTS
        ================================================== -->

        <div class="col-6 col-lg-3">

          <%= link_to teacher_panel_course_students_path(@course),
              class: "btn btn-outline-dark quick-action-btn" do %>

            <i class="bi bi-people-fill"></i>

            <strong>
              Students
            </strong>

            <small>
              Manage Enrolled Students
            </small>

          <% end %>

        </div>


        <!-- =================================================
             PLAYLISTS
        ================================================== -->

        <div class="col-6 col-lg-3">

          <%= link_to teacher_panel_course_playlists_path(@course),
              class: "btn btn-outline-primary quick-action-btn" do %>

            <i class="bi bi-collection-play-fill"></i>

            <strong>
              Playlists
            </strong>

            <small>
              Create & Manage
            </small>

          <% end %>

        </div>


        <!-- =================================================
             VIDEOS
        ================================================== -->

        <div class="col-6 col-lg-3">

          <%= link_to teacher_panel_course_videos_path(@course),
              class: "btn btn-outline-success quick-action-btn" do %>

            <i class="bi bi-camera-video-fill"></i>

            <strong>
              Videos
            </strong>

            <small>
              Add & Edit Videos
            </small>

          <% end %>

        </div>


        <!-- =================================================
             RESOURCES
        ================================================== -->

        <div class="col-6 col-lg-3">

          <%= link_to teacher_panel_course_resources_path(@course),
              class: "btn btn-outline-info quick-action-btn" do %>

            <i class="bi bi-file-earmark-text-fill"></i>

            <strong>
              Resources
            </strong>

            <small>
              Upload PDFs & Files
            </small>

          <% end %>

        </div>


      </div>

    </div>

  </div>

</div>