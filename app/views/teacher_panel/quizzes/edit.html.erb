<% content_for :show_layout, true %>

<style>

/* =========================================================
   TEACHER QUIZ EDIT PAGE
========================================================= */

.teacher-quizzes-page {
  width: 100%;
  min-height: 100%;
  background: #f8fafc;
  box-sizing: border-box;
}

.teacher-quizzes-container {
  width: 100%;
  max-width: 1180px;
  margin: 0 auto;
  padding: 24px 28px 40px;
  box-sizing: border-box;
}


/* =========================================================
   BREADCRUMB
========================================================= */

.quiz-page-top {
  margin-bottom: 18px;
}

.quiz-breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 8px;

  color: #94a3b8;

  font-size: 11px;
  font-weight: 600;

  line-height: 1.5;
}

.quiz-breadcrumb i {
  color: #cbd5e1;
  font-size: 9px;
}

.quiz-breadcrumb > i:first-child {
  color: #7c3aed;
  font-size: 13px;
}

.quiz-breadcrumb strong {
  color: #475569;
  font-weight: 700;
}

.quiz-breadcrumb strong:last-child {
  color: #6d28d9;
}


/* =========================================================
   PAGE HEADER
========================================================= */

.quiz-page-header {

  display: flex;
  align-items: center;

  width: 100%;

  margin-bottom: 22px;

  padding: 22px 24px;

  box-sizing: border-box;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 18px;

  box-shadow:
    0 6px 20px rgba(15, 23, 42, 0.04);
}

.quiz-header-content {

  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 14px;
}

.quiz-header-icon {

  width: 46px;
  height: 46px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 13px;

  background: #f3f0ff;

  color: #6d28d9;

  font-size: 18px;
}

.quiz-header-content h2 {

  margin: 0;

  color: #111827;

  font-size: 20px;

  font-weight: 800;

  line-height: 1.3;
}

.quiz-header-content p {

  width: 100%;

  margin: -5px 0 0 60px;

  color: #6b7280;

  font-size: 12px;

  line-height: 1.5;
}

.quiz-header-content .course-name {

  color: #6d28d9;

  font-weight: 800;
}


/* =========================================================
   FORM SPACING
========================================================= */

.teacher-quizzes-container > form,
.teacher-quizzes-container > .teacher-quiz-form-page {
  width: 100%;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 767px) {

  .teacher-quizzes-container {
    padding: 18px 15px 30px;
  }

  .quiz-page-header {
    padding: 18px;
    border-radius: 15px;
  }

  .quiz-header-content {
    gap: 11px;
  }

  .quiz-header-icon {
    width: 42px;
    height: 42px;
    font-size: 16px;
  }

  .quiz-header-content h2 {
    font-size: 18px;
  }

  .quiz-header-content p {
    margin-left: 53px;
    margin-top: -3px;
    font-size: 11px;
  }

  .quiz-breadcrumb {
    font-size: 10px;
  }

}

</style>


<div class="teacher-quizzes-page">

  <div class="teacher-quizzes-container">


    <!-- =====================================================
         BREADCRUMB
    ====================================================== -->

    <div class="quiz-page-top">

      <div class="quiz-breadcrumb">

        <i class="fas fa-chalkboard-teacher"></i>

        <span>
          Teacher Panel
        </span>

        <i class="fas fa-chevron-right"></i>

        <span>
          Courses
        </span>

        <i class="fas fa-chevron-right"></i>

        <strong>
          <%= @course.Course_name %>
        </strong>

        <i class="fas fa-chevron-right"></i>

        <strong>
          Edit Quiz
        </strong>

      </div>

    </div>


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="quiz-page-header">

      <div class="quiz-header-content">

        <div class="quiz-header-icon">

          <i class="fas fa-pen-to-square"></i>

        </div>


        <h2>
          Edit Quiz
        </h2>


        <p>

          Update quiz settings for

          <span class="course-name">
            <%= @course.Course_name %>
          </span>

        </p>

      </div>

    </div>


    <!-- =====================================================
         SHARED QUIZ FORM
    ====================================================== -->

    <%= render "form" %>


  </div>

</div>