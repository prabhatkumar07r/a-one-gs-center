<% content_for :show_layout, true %>

<style>
  /* =========================================================
     TEACHER QUIZ - EDIT PAGE
     Light / Clean / Modern UI
  ========================================================= */

  .teacher-quiz-edit-page {
    min-height: 100vh;
    padding: 30px;
    background: #f5f7fb;
    color: #1f2937;
  }

  .quiz-edit-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ================= TOP HEADER ================= */

  .quiz-edit-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
  }

  .quiz-breadcrumb {
    font-size: 13px;
    color: #6b7280;
    margin-bottom: 7px;
  }

  .quiz-breadcrumb span {
    color: #2563eb;
    font-weight: 600;
  }

  .quiz-edit-header h2 {
    margin: 0;
    font-size: 28px;
    font-weight: 800;
    color: #111827;
  }

  .quiz-edit-header p {
    margin: 7px 0 0;
    color: #6b7280;
    font-size: 14px;
  }

  .course-highlight {
    color: #2563eb;
    font-weight: 700;
  }

  /* ================= BACK BUTTON ================= */

  .btn-back-quiz {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 17px;
    border-radius: 10px;
    background: #ffffff;
    color: #374151;
    border: 1px solid #e5e7eb;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all .2s ease;
    box-shadow: 0 3px 10px rgba(15, 23, 42, .05);
  }

  .btn-back-quiz:hover {
    color: #2563eb;
    border-color: #bfdbfe;
    background: #eff6ff;
    transform: translateY(-1px);
  }

  /* ================= MAIN CARD ================= */

  .quiz-edit-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    box-shadow: 0 10px 35px rgba(15, 23, 42, .07);
    overflow: hidden;
  }

  /* ================= CARD HEADER ================= */

  .quiz-card-top {
    padding: 25px 28px;
    border-bottom: 1px solid #eef0f4;
    background: #ffffff;
  }

  .quiz-card-title {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .quiz-card-icon {
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: #eff6ff;
    color: #2563eb;
    font-size: 19px;
  }

  .quiz-card-title h4 {
    margin: 0;
    font-size: 19px;
    font-weight: 800;
    color: #111827;
  }

  .quiz-card-title small {
    display: block;
    margin-top: 3px;
    color: #6b7280;
    font-size: 12px;
  }

  /* ================= FORM ================= */

  .quiz-form {
    padding: 28px;
  }

  .form-section {
    margin-bottom: 30px;
  }

  .form-section:last-child {
    margin-bottom: 0;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 9px;
    padding-bottom: 12px;
    margin-bottom: 20px;
    border-bottom: 1px solid #eef0f4;
    color: #111827;
    font-size: 15px;
    font-weight: 800;
  }

  .section-heading i {
    color: #2563eb;
  }

  /* ================= LABEL ================= */

  .quiz-label {
    display: block;
    margin-bottom: 8px;
    color: #374151;
    font-size: 13px;
    font-weight: 700;
  }

  .required-star {
    color: #dc2626;
    margin-left: 2px;
  }

  /* ================= INPUTS ================= */

  .quiz-input,
  .quiz-textarea,
  .quiz-select {
    width: 100%;
    border: 1px solid #dfe3ea;
    border-radius: 10px;
    background: #ffffff;
    color: #111827;
    padding: 12px 14px;
    font-size: 14px;
    outline: none;
    transition: all .2s ease;
  }

  .quiz-input {
    min-height: 46px;
  }

  .quiz-textarea {
    min-height: 115px;
    resize: vertical;
  }

  .quiz-select {
    min-height: 46px;
  }

  .quiz-input:focus,
  .quiz-textarea:focus,
  .quiz-select:focus {
    border-color: #60a5fa;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, .09);
  }

  .field-help {
    margin-top: 7px;
    color: #9ca3af;
    font-size: 12px;
  }

  /* ================= QUIZ TYPE ================= */

  .quiz-type-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .quiz-type-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .quiz-type-label {
    display: block;
    height: 100%;
    padding: 18px;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    background: #ffffff;
    cursor: pointer;
    transition: all .2s ease;
  }

  .quiz-type-label:hover {
    border-color: #93c5fd;
    background: #f8fbff;
  }

  .quiz-type-option input:checked + .quiz-type-label {
    border-color: #2563eb;
    background: #eff6ff;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, .08);
  }

  .quiz-type-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    background: #f3f4f6;
    color: #2563eb;
    margin-bottom: 12px;
  }

  .quiz-type-title {
    display: block;
    color: #111827;
    font-size: 15px;
    font-weight: 800;
    margin-bottom: 5px;
  }

  .quiz-type-description {
    display: block;
    color: #6b7280;
    font-size: 12px;
    line-height: 1.5;
  }

  /* ================= VIDEO BOX ================= */

  .video-selection-box {
    margin-top: 18px;
    padding: 18px;
    border: 1px solid #dbeafe;
    border-radius: 13px;
    background: #f8fbff;
  }

  .video-selection-box.hidden {
    display: none;
  }

  /* ================= STATUS ================= */

  .status-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .status-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .status-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    background: #ffffff;
    color: #4b5563;
    cursor: pointer;
    font-size: 13px;
    font-weight: 700;
    transition: all .2s ease;
  }

  .status-label:hover {
    border-color: #93c5fd;
  }

  .status-option input:checked + .status-label {
    color: #166534;
    background: #f0fdf4;
    border-color: #86efac;
  }

  /* ================= ERRORS ================= */

  .quiz-errors {
    margin-bottom: 25px;
    padding: 16px 18px;
    border: 1px solid #fecaca;
    border-radius: 12px;
    background: #fef2f2;
    color: #991b1b;
  }

  .quiz-errors h6 {
    margin-bottom: 9px;
    font-weight: 800;
  }

  .quiz-errors ul {
    margin: 0;
    padding-left: 20px;
  }

  .quiz-errors li {
    margin-bottom: 4px;
    font-size: 13px;
  }

  /* ================= ACTIONS ================= */

  .quiz-form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 22px 28px;
    border-top: 1px solid #eef0f4;
    background: #fafbfc;
  }

  .btn-cancel-quiz {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 18px;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    background: #ffffff;
    color: #4b5563;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: all .2s ease;
  }

  .btn-cancel-quiz:hover {
    color: #111827;
    background: #f3f4f6;
  }

  .btn-update-quiz {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 22px;
    border: none;
    border-radius: 10px;
    background: #2563eb;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(37, 99, 235, .2);
    transition: all .2s ease;
  }

  .btn-update-quiz:hover {
    background: #1d4ed8;
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* ================= RESPONSIVE ================= */

  @media (max-width: 768px) {

    .teacher-quiz-edit-page {
      padding: 20px 14px;
    }

    .quiz-edit-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .quiz-edit-header h2 {
      font-size: 23px;
    }

    .btn-back-quiz {
      width: 100%;
      justify-content: center;
    }

    .quiz-type-grid {
      grid-template-columns: 1fr;
    }

    .quiz-form {
      padding: 20px;
    }

    .quiz-form-actions {
      padding: 18px 20px;
      flex-direction: column-reverse;
    }

    .btn-cancel-quiz,
    .btn-update-quiz {
      width: 100%;
    }
  }
</style>

<div class="teacher-quiz-edit-page">

  <div class="quiz-edit-container">

<!-- =====================================================
     HEADER
====================================================== -->

<div class="quiz-edit-header">

  <div>

    <div class="quiz-breadcrumb">
      Teacher Panel /
      <span>Quizzes</span> /
      Edit
    </div>

    <h2>
      <i class="fas fa-pen-to-square me-2"></i>
      Edit Quiz
    </h2>

    <p>
      Update quiz settings for
      <span class="course-highlight">
        <%= @course.Course_name %>
      </span>
    </p>

  </div>


  <%= link_to teacher_panel_course_quizzes_path(@course),
        class: "btn-back-quiz" do %>

    <i class="fas fa-arrow-left"></i>
    Back to Quizzes

  <% end %>

</div>


<!-- =====================================================
     MAIN CARD
====================================================== -->

<div class="quiz-edit-card">

  <div class="quiz-card-top">

    <div class="quiz-card-title">

      <div class="quiz-card-icon">
        <i class="fas fa-clipboard-question"></i>
      </div>

      <div>

        <h4>
          Quiz Settings
        </h4>

        <small>
          Modify the information and configuration of this quiz.
        </small>

      </div>

    </div>

  </div>


  <!-- ===================================================
       FORM
  ==================================================== -->

  <%= form_with model: [:teacher_panel, @course, @quiz],
                local: true,
                class: "quiz-form" do |f| %>


    <!-- ERRORS -->

    <% if @quiz.errors.any? %>

      <div class="quiz-errors">

        <h6>
          <i class="fas fa-triangle-exclamation me-2"></i>
          Please fix the following errors
        </h6>

        <ul>

          <% @quiz.errors.full_messages.each do |message| %>

            <li>
              <%= message %>
            </li>

          <% end %>

        </ul>

      </div>

    <% end %>


    <!-- =================================================
         BASIC INFORMATION
    ================================================== -->

    <div class="form-section">

      <div class="section-heading">

        <i class="fas fa-circle-info"></i>

        Basic Information

      </div>


      <div class="mb-4">

        <%= f.label :title, class: "quiz-label" do %>

          Quiz Title
          <span class="required-star">*</span>

        <% end %>

        <%= f.text_field :title,
              class: "quiz-input",
              placeholder: "Example: HTML Basics Quiz",
              required: true %>

      </div>


      <div>

        <%= f.label :description,
              "Description",
              class: "quiz-label" %>

        <%= f.text_area :description,
              class: "quiz-textarea",
              placeholder: "Enter quiz instructions or description..." %>

      </div>

    </div>


    <!-- =================================================
         QUIZ TYPE
    ================================================== -->

    <div class="form-section">

      <div class="section-heading">

        <i class="fas fa-layer-group"></i>

        Quiz Type

      </div>


      <div class="quiz-type-grid">


        <!-- COURSE LEVEL -->

        <div class="quiz-type-option">

          <input type="radio"
                 name="quiz_type"
                 id="course_level_quiz"
                 value="course"
                 <%= "checked" if @quiz.video_id.blank? %>>

          <label for="course_level_quiz"
                 class="quiz-type-label">

            <span class="quiz-type-icon">
              <i class="fas fa-graduation-cap"></i>
            </span>

            <span class="quiz-type-title">
              Course Level Quiz
            </span>

            <span class="quiz-type-description">
              This quiz covers the entire course.
            </span>

          </label>

        </div>


        <!-- VIDEO LEVEL -->

        <div class="quiz-type-option">

          <input type="radio"
                 name="quiz_type"
                 id="video_level_quiz"
                 value="video"
                 <%= "checked" if @quiz.video_id.present? %>>

          <label for="video_level_quiz"
                 class="quiz-type-label">

            <span class="quiz-type-icon">
              <i class="fas fa-video"></i>
            </span>

            <span class="quiz-type-title">
              Video-wise Quiz
            </span>

            <span class="quiz-type-description">
              Connect this quiz to a specific course video.
            </span>

          </label>

        </div>

      </div>


      <!-- VIDEO SELECTION -->

      <div id="videoSelectionBox"
           class="video-selection-box <%= 'hidden' if @quiz.video_id.blank? %>">

        <%= f.label :video_id,
              "Select Video",
              class: "quiz-label" %>

        <%= f.collection_select :video_id,
              @videos || @course.videos.order(:position),
              :id,
              :title,
              {
                include_blank: "Select a video..."
              },
              {
                class: "quiz-select",
                id: "quiz_video_id"
              } %>

        <div class="field-help">

          <i class="fas fa-circle-info me-1"></i>

          Select the video for which this quiz should be available.

        </div>

      </div>

    </div>


    <!-- =================================================
         QUIZ SETTINGS
    ================================================== -->

    <div class="form-section">

      <div class="section-heading">

        <i class="fas fa-sliders"></i>

        Quiz Settings

      </div>


      <div class="row g-4">

        <!-- TIME -->

        <div class="col-md-6">

          <%= f.label :time_limit, class: "quiz-label" do %>

            Time Limit
            <span class="required-star">*</span>

          <% end %>

          <%= f.number_field :time_limit,
                class: "quiz-input",
                min: 1,
                placeholder: "30",
                required: true %>

          <div class="field-help">
            Time limit in minutes.
          </div>

        </div>


        <!-- PASSING -->

        <div class="col-md-6">

          <%= f.label :passing_percentage,
                class: "quiz-label" do %>

            Passing Percentage
            <span class="required-star">*</span>

          <% end %>

          <%= f.number_field :passing_percentage,
                class: "quiz-input",
                min: 0,
                max: 100,
                step: 1,
                placeholder: "40",
                required: true %>

          <div class="field-help">
            Minimum percentage required to pass the quiz.
          </div>

        </div>

      </div>

    </div>


    <!-- =================================================
         STATUS
    ================================================== -->

    <div class="form-section">

      <div class="section-heading">

        <i class="fas fa-toggle-on"></i>

        Quiz Status

      </div>


      <div class="status-grid">

        <!-- ACTIVE -->

        <div class="status-option">

          <%= f.radio_button :status,
                "Active",
                checked: (
                  @quiz.status.blank? ||
                  @quiz.status.to_s.downcase == "active"
                ) %>

          <%= f.label :status_active,
                class: "status-label" do %>

            <i class="fas fa-circle-check"></i>
            Active

          <% end %>

        </div>


        <!-- INACTIVE -->

        <div class="status-option">

          <%= f.radio_button :status,
                "Inactive",
                checked: (
                  @quiz.status.to_s.downcase == "inactive"
                ) %>

          <%= f.label :status_inactive,
                class: "status-label" do %>

            <i class="fas fa-circle-pause"></i>
            Inactive

          <% end %>

        </div>

      </div>

    </div>


    <!-- =================================================
         FORM ACTIONS
    ================================================== -->

    <div class="quiz-form-actions">

      <%= link_to teacher_panel_course_quizzes_path(@course),
            class: "btn-cancel-quiz" do %>

        <i class="fas fa-arrow-left"></i>
        Cancel

      <% end %>


      <%= f.button type: "submit",
            class: "btn-update-quiz" do %>

        <i class="fas fa-floppy-disk"></i>
        Update Quiz

      <% end %>

    </div>


  <% end %>

</div>


  </div>

</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const courseRadio = document.getElementById("course_level_quiz");
  const videoRadio = document.getElementById("video_level_quiz");
  const videoBox = document.getElementById("videoSelectionBox");
  const videoSelect = document.getElementById("quiz_video_id");

  function updateQuizType() {

    if (!videoBox) return;

    if (videoRadio && videoRadio.checked) {

      videoBox.classList.remove("hidden");

      if (videoSelect) {
        videoSelect.required = true;
      }

    } else {

      videoBox.classList.add("hidden");

      if (videoSelect) {
        videoSelect.required = false;
        videoSelect.value = "";
      }

    }

  }

  courseRadio?.addEventListener("change", updateQuizType);
  videoRadio?.addEventListener("change", updateQuizType);

  updateQuizType();

});
</script>
