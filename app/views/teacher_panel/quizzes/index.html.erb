<% content_for :hide_footer, true %>

<style>
/* =========================================================
   TEACHER QUIZZES PAGE
   Quizwich-inspired dark dashboard
========================================================= */

.teacher-quizzes-page {
  min-height: calc(100vh - 70px);
  color: #f8fafc;
}

/* =========================================================
   HEADER
========================================================= */

.quizzes-page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.quizzes-page-heading h1 {
  margin: 0;
  font-size: 32px;
  font-weight: 750;
  letter-spacing: -0.7px;
  color: #f8fafc;
}

.quizzes-page-heading p {
  margin: 7px 0 0;
  color: #94a3b8;
  font-size: 14px;
}

.new-quiz-btn {
  display: inline-flex;
  align-items: center;
  gap: 9px;

  padding: 11px 18px;

  border: 1px solid rgba(45, 212, 191, .45);
  border-radius: 8px;

  background: #14b8a6;
  color: #ffffff;

  text-decoration: none;
  font-size: 14px;
  font-weight: 700;

  box-shadow: 0 5px 18px rgba(20, 184, 166, .18);

  transition: .2s ease;
}

.new-quiz-btn:hover {
  background: #0d9488;
  color: #ffffff;
  transform: translateY(-1px);
}

/* =========================================================
   STAT CARDS
========================================================= */

.quiz-stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 22px;
}

.quiz-stat-card {
  position: relative;

  min-height: 92px;
  padding: 18px;

  background:
    linear-gradient(
      135deg,
      rgba(30, 41, 59, .92),
      rgba(15, 23, 42, .95)
    );

  border: 1px solid #26344b;
  border-radius: 9px;

  overflow: hidden;
}

.quiz-stat-card::after {
  content: "";
  position: absolute;
  right: -30px;
  bottom: -40px;

  width: 100px;
  height: 100px;

  border-radius: 50%;
  background: rgba(20, 184, 166, .05);
}

.quiz-stat-label {
  color: #94a3b8;
  font-size: 13px;
  margin-bottom: 8px;
}

.quiz-stat-value {
  font-size: 25px;
  font-weight: 750;
  color: #f8fafc;
}

.quiz-stat-icon {
  position: absolute;
  right: 18px;
  top: 19px;

  font-size: 22px;
  color: #2dd4bf;
}

/* =========================================================
   MAIN QUIZ PANEL
========================================================= */

.quizzes-panel {
  background:
    linear-gradient(
      145deg,
      rgba(30, 41, 59, .82),
      rgba(15, 23, 42, .92)
    );

  border: 1px solid #26344b;
  border-radius: 10px;

  overflow: hidden;
}

/* =========================================================
   PANEL HEADER
========================================================= */

.quizzes-panel-header {
  padding: 20px 22px 18px;

  border-bottom: 1px solid #26344b;
}

.quizzes-panel-title {
  display: flex;
  align-items: center;
  gap: 10px;

  margin-bottom: 18px;
}

.quizzes-panel-title-bar {
  width: 6px;
  height: 25px;

  border-radius: 4px;
  background: #14b8a6;
}

.quizzes-panel-title h2 {
  margin: 0;

  font-size: 17px;
  font-weight: 700;

  color: #f8fafc;
}

.quizzes-panel-title span {
  color: #64748b;
  font-size: 13px;
}

/* =========================================================
   SEARCH AREA
========================================================= */

.quiz-search-area {
  display: flex;
  align-items: center;
  gap: 10px;
}

.quiz-search-wrapper {
  position: relative;
  flex: 1;
}

.quiz-search-wrapper i {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);

  color: #64748b;
  font-size: 14px;
}

.quiz-search-input {
  width: 100%;
  height: 42px;

  padding: 0 14px 0 40px;

  border: 1px solid #334155;
  border-radius: 7px;

  background: #111c30;
  color: #f8fafc;

  outline: none;

  font-size: 13px;

  box-sizing: border-box;
}

.quiz-search-input::placeholder {
  color: #64748b;
}

.quiz-search-input:focus {
  border-color: #14b8a6;
  box-shadow: 0 0 0 2px rgba(20, 184, 166, .08);
}

.quiz-search-btn {
  height: 42px;

  padding: 0 17px;

  border: 1px solid #334155;
  border-radius: 7px;

  background: #1e293b;
  color: #e2e8f0;

  font-size: 13px;
  font-weight: 650;

  cursor: pointer;

  transition: .2s ease;
}

.quiz-search-btn:hover {
  border-color: #14b8a6;
  background: #243247;
  color: #ffffff;
}

/* =========================================================
   TABS
========================================================= */

.quiz-tabs {
  display: flex;
  gap: 5px;

  padding: 14px 22px 0;

  border-bottom: 1px solid #26344b;
}

.quiz-tab-btn {
  position: relative;

  border: 0;
  background: transparent;

  padding: 12px 17px 14px;

  color: #64748b;

  font-size: 13px;
  font-weight: 700;

  cursor: pointer;

  transition: .2s ease;
}

.quiz-tab-btn:hover {
  color: #cbd5e1;
}

.quiz-tab-btn.active {
  color: #2dd4bf;
}

.quiz-tab-btn.active::after {
  content: "";

  position: absolute;
  left: 0;
  right: 0;
  bottom: -1px;

  height: 3px;

  border-radius: 3px 3px 0 0;

  background: #14b8a6;
}

.quiz-tab-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 21px;
  height: 20px;

  padding: 0 6px;
  margin-left: 6px;

  border-radius: 20px;

  background: #263449;
  color: #94a3b8;

  font-size: 11px;
}

.quiz-tab-btn.active .quiz-tab-count {
  background: rgba(20, 184, 166, .13);
  color: #2dd4bf;
}

/* =========================================================
   TOOLBAR
========================================================= */

.quiz-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 14px 22px;

  background: rgba(15, 23, 42, .5);

  border-bottom: 1px solid #26344b;
}

.quiz-select-all {
  display: flex;
  align-items: center;
  gap: 9px;

  color: #94a3b8;

  font-size: 12px;
  font-weight: 600;
}

.quiz-select-all input,
.quiz-checkbox {
  width: 16px;
  height: 16px;

  accent-color: #14b8a6;

  cursor: pointer;
}

.quiz-selected-info {
  color: #64748b;
  font-size: 12px;
}

.quiz-selected-info strong {
  color: #2dd4bf;
}

/* =========================================================
   TAB CONTENT
========================================================= */

.quiz-tab-content {
  display: none;
}

.quiz-tab-content.active {
  display: block;
}

/* =========================================================
   QUIZ ROW
========================================================= */

.quiz-list {
  display: flex;
  flex-direction: column;
}

.quiz-row {
  display: grid;

  grid-template-columns:
    38px
    minmax(250px, 1fr)
    minmax(230px, auto)
    110px
    115px
    115px;

  align-items: center;

  min-height: 84px;

  padding: 13px 22px;

  border-bottom: 1px solid rgba(38, 52, 75, .8);

  transition: background .18s ease;
}

.quiz-row:last-child {
  border-bottom: none;
}

.quiz-row:hover {
  background: rgba(51, 65, 85, .20);
}

/* =========================================================
   CHECKBOX
========================================================= */

.quiz-row-checkbox {
  display: flex;
  align-items: center;
}

/* =========================================================
   QUIZ INFO
========================================================= */

.quiz-info {
  min-width: 0;
}

.quiz-title {
  margin-bottom: 5px;

  color: #f1f5f9;

  font-size: 14px;
  font-weight: 700;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.quiz-description {
  max-width: 430px;

  color: #64748b;

  font-size: 12px;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* =========================================================
   VIDEO INFO
========================================================= */

.quiz-video-info {
  display: flex;
  align-items: center;
  gap: 9px;

  min-width: 0;

  color: #94a3b8;

  font-size: 12px;
}

.quiz-video-icon {
  width: 28px;
  height: 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 6px;

  background: rgba(59, 130, 246, .10);
  color: #60a5fa;
}

.quiz-video-name {
  min-width: 0;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* =========================================================
   METADATA
========================================================= */

.quiz-metric {
  display: flex;
  align-items: center;
  gap: 7px;

  color: #94a3b8;

  font-size: 12px;
  white-space: nowrap;
}

.quiz-metric i {
  color: #64748b;
}

/* =========================================================
   STATUS
========================================================= */

.quiz-status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  width: fit-content;

  padding: 5px 9px;

  border-radius: 5px;

  font-size: 11px;
  font-weight: 700;
}

.quiz-status-active {
  background: rgba(16, 185, 129, .10);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, .20);
}

.quiz-status-inactive {
  background: rgba(100, 116, 139, .12);
  color: #94a3b8;
  border: 1px solid rgba(100, 116, 139, .20);
}

/* =========================================================
   ACTIONS
========================================================= */

.quiz-actions {
  display: flex;
  align-items: center;
  gap: 6px;
}

.quiz-action-btn {
  width: 32px;
  height: 32px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #334155;
  border-radius: 6px;

  background: #172337;
  color: #94a3b8;

  text-decoration: none;

  transition: .2s ease;
}

.quiz-action-btn:hover {
  border-color: #14b8a6;
  background: #203248;
  color: #2dd4bf;
}

/* =========================================================
   EMPTY STATE
========================================================= */

.quiz-empty {
  padding: 65px 20px;

  text-align: center;
}

.quiz-empty-icon {
  width: 55px;
  height: 55px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin: 0 auto 14px;

  border-radius: 50%;

  background: #1e293b;
  color: #64748b;

  font-size: 21px;
}

.quiz-empty h3 {
  margin: 0 0 7px;

  color: #e2e8f0;

  font-size: 16px;
}

.quiz-empty p {
  margin: 0;

  color: #64748b;

  font-size: 13px;
}

/* =========================================================
   NO SEARCH RESULTS
========================================================= */

.quiz-no-results {
  display: none;

  padding: 45px 20px;

  text-align: center;

  color: #64748b;

  font-size: 13px;
}

.quiz-no-results i {
  display: block;

  margin-bottom: 10px;

  font-size: 24px;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1200px) {

  .quiz-stat-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .quiz-row {
    grid-template-columns:
      35px
      minmax(220px, 1fr)
      minmax(190px, auto)
      90px
      100px
      90px;

    gap: 8px;
  }
}

@media (max-width: 950px) {

  .quiz-row {
    grid-template-columns:
      35px
      1fr
      auto;

    gap: 10px;

    padding: 15px 18px;
  }

  .quiz-video-info {
    grid-column: 2 / -1;
  }

  .quiz-metric {
    display: inline-flex;
  }

  .quiz-row .quiz-metric:nth-of-type(2) {
    grid-column: 2;
  }

  .quiz-row .quiz-status-wrapper {
    grid-column: 2;
  }

  .quiz-actions {
    grid-column: 3;
    grid-row: 2;
  }
}

@media (max-width: 700px) {

  .quizzes-page-header {
    flex-direction: column;
  }

  .new-quiz-btn {
    width: 100%;
    justify-content: center;
  }

  .quiz-stat-grid {
    grid-template-columns: 1fr;
  }

  .quiz-search-area {
    flex-direction: column;
    align-items: stretch;
  }

  .quiz-search-btn {
    width: 100%;
  }

  .quiz-tabs {
    overflow-x: auto;
  }

  .quiz-tab-btn {
    white-space: nowrap;
  }

  .quiz-toolbar {
    padding: 12px 16px;
  }

  .quiz-row {
    grid-template-columns: 30px 1fr auto;
    padding: 15px 16px;
  }

  .quiz-info {
    min-width: 0;
  }

  .quiz-title {
    font-size: 13px;
  }

  .quiz-description {
    max-width: 100%;
  }

  .quiz-video-info {
    grid-column: 2 / -1;
  }

  .quiz-metric {
    grid-column: 2 / -1;
  }

  .quiz-status-wrapper {
    grid-column: 2;
  }

  .quiz-actions {
    grid-column: 3;
    grid-row: 4;
  }
}
</style>


<div class="teacher-quizzes-page">

  <!-- =====================================================
       PAGE HEADER
  ====================================================== -->

  <div class="quizzes-page-header">

    <div class="quizzes-page-heading">

      <h1>
        Quizzes
      </h1>

      <p>
        Manage your course-wise and video-wise quizzes
      </p>

    </div>

    <%= link_to new_teacher_panel_course_quiz_path(@course),
                class: "new-quiz-btn" do %>

      <i class="fas fa-plus"></i>

      New Quiz

    <% end %>

  </div>


  <!-- =====================================================
       STATISTICS
  ====================================================== -->

  <div class="quiz-stat-grid">

    <div class="quiz-stat-card">

      <div class="quiz-stat-label">
        Total Quizzes
      </div>

      <div class="quiz-stat-value">
        <%= @course_level_quizzes.count + @video_quizzes.count %>
      </div>

      <div class="quiz-stat-icon">
        <i class="fas fa-award"></i>
      </div>

    </div>


    <div class="quiz-stat-card">

      <div class="quiz-stat-label">
        Course Wise
      </div>

      <div class="quiz-stat-value">
        <%= @course_level_quizzes.count %>
      </div>

      <div class="quiz-stat-icon">
        <i class="fas fa-graduation-cap"></i>
      </div>

    </div>


    <div class="quiz-stat-card">

      <div class="quiz-stat-label">
        Video Wise
      </div>

      <div class="quiz-stat-value">
        <%= @video_quizzes.count %>
      </div>

      <div class="quiz-stat-icon">
        <i class="fas fa-video"></i>
      </div>

    </div>


    <div class="quiz-stat-card">

      <div class="quiz-stat-label">
        Total Questions
      </div>

      <div class="quiz-stat-value">
        <%= @course.quizzes.includes(:questions).sum { |quiz| quiz.questions.size } %>
      </div>

      <div class="quiz-stat-icon">
        <i class="fas fa-check-square"></i>
      </div>

    </div>

  </div>


  <!-- =====================================================
       MAIN PANEL
  ====================================================== -->

  <div class="quizzes-panel">


    <!-- ===================================================
         PANEL HEADER
    ==================================================== -->

    <div class="quizzes-panel-header">

      <div class="quizzes-panel-title">

        <div class="quizzes-panel-title-bar"></div>

        <h2>
          Your Quizzes
        </h2>

        <span>
          <%= @course.quizzes.count %> total
        </span>

      </div>


      <!-- =================================================
           SEARCH
      ================================================== -->

      <div class="quiz-search-area">

        <div class="quiz-search-wrapper">

          <i class="fas fa-search"></i>

          <input
            type="text"
            id="quizSearchInput"
            class="quiz-search-input"
            placeholder="Search quizzes, videos or descriptions..."
            autocomplete="off">

        </div>

        <button
          type="button"
          id="quizSearchButton"
          class="quiz-search-btn">

          <i class="fas fa-search"></i>
          Search

        </button>

      </div>

    </div>


    <!-- ===================================================
         TABS
    ==================================================== -->

    <div class="quiz-tabs">

      <button
        type="button"
        class="quiz-tab-btn active"
        data-tab="course-wise">

        <i class="fas fa-graduation-cap"></i>

        Course Wise

        <span class="quiz-tab-count">
          <%= @course_level_quizzes.count %>
        </span>

      </button>


      <button
        type="button"
        class="quiz-tab-btn"
        data-tab="video-wise">

        <i class="fas fa-video"></i>

        Video Wise

        <span class="quiz-tab-count">
          <%= @video_quizzes.count %>
        </span>

      </button>

    </div>


    <!-- ===================================================
         COURSE WISE
    ==================================================== -->

    <div
      class="quiz-tab-content active"
      data-content="course-wise">


      <!-- Toolbar -->

      <div class="quiz-toolbar">

        <label class="quiz-select-all">

          <input
            type="checkbox"
            class="select-all-checkbox"
            data-group="course-wise">

          Select All

        </label>

        <div class="quiz-selected-info">
          <strong class="selected-count"
                  data-group="course-wise">0</strong>
          selected
        </div>

      </div>


      <% if @course_level_quizzes.any? %>

        <div class="quiz-list"
             data-list="course-wise">

          <% @course_level_quizzes.each do |quiz| %>

            <div
              class="quiz-row"
              data-quiz-row
              data-search="<%= [
                quiz.title,
                quiz.description
              ].compact.join(' ').downcase %>">


              <!-- Checkbox -->

              <div class="quiz-row-checkbox">

                <input
                  type="checkbox"
                  class="quiz-checkbox"
                  data-group="course-wise"
                  value="<%= quiz.id %>">

              </div>


              <!-- Quiz -->

              <div class="quiz-info">

                <div class="quiz-title">
                  <%= quiz.title %>
                </div>

                <div class="quiz-description">
                  <%= quiz.description.presence || "Course level quiz" %>
                </div>

              </div>


              <!-- Type -->

              <div class="quiz-video-info">

                <div class="quiz-video-icon">
                  <i class="fas fa-graduation-cap"></i>
                </div>

                <div class="quiz-video-name">
                  Full Course Quiz
                </div>

              </div>


              <!-- Questions -->

              <div class="quiz-metric">

                <i class="fas fa-question-circle"></i>

                <%= quiz.questions.size %>

                Questions

              </div>


              <!-- Time -->

              <div class="quiz-metric">

                <i class="fas fa-clock"></i>

                <%= quiz.time_limit %> min

              </div>


              <!-- Status -->

              <div class="quiz-status-wrapper">

                <% if quiz.status.to_s.downcase == "active" %>

                  <span class="quiz-status-badge quiz-status-active">
                    Active
                  </span>

                <% else %>

                  <span class="quiz-status-badge quiz-status-inactive">
                    <%= quiz.status %>
                  </span>

                <% end %>

              </div>


              <!-- Actions -->

              <div class="quiz-actions">

                <%= link_to teacher_panel_course_quiz_path(@course, quiz),
                            class: "quiz-action-btn",
                            title: "View Quiz" do %>

                  <i class="fas fa-eye"></i>

                <% end %>


                <%= link_to edit_teacher_panel_course_quiz_path(@course, quiz),
                            class: "quiz-action-btn",
                            title: "Edit Quiz" do %>

                  <i class="fas fa-pen"></i>

                <% end %>

              </div>

            </div>

          <% end %>

        </div>


        <div class="quiz-no-results"
             data-no-results="course-wise">

          <i class="fas fa-search"></i>

          No course quizzes found.

        </div>

      <% else %>

        <div class="quiz-empty">

          <div class="quiz-empty-icon">
            <i class="fas fa-graduation-cap"></i>
          </div>

          <h3>
            No Course Wise Quizzes
          </h3>

          <p>
            Create a course-wise quiz to see it here.
          </p>

        </div>

      <% end %>

    </div>


    <!-- ===================================================
         VIDEO WISE
    ==================================================== -->

    <div
      class="quiz-tab-content"
      data-content="video-wise">


      <!-- Toolbar -->

      <div class="quiz-toolbar">

        <label class="quiz-select-all">

          <input
            type="checkbox"
            class="select-all-checkbox"
            data-group="video-wise">

          Select All

        </label>

        <div class="quiz-selected-info">

          <strong class="selected-count"
                  data-group="video-wise">
            0
          </strong>

          selected

        </div>

      </div>


      <% if @video_quizzes.any? %>

        <div class="quiz-list"
             data-list="video-wise">

          <% @video_quizzes.each do |quiz| %>

            <div
              class="quiz-row"
              data-quiz-row
              data-search="<%= [
                quiz.title,
                quiz.description,
                quiz.video&.title
              ].compact.join(' ').downcase %>">


              <!-- Checkbox -->

              <div class="quiz-row-checkbox">

                <input
                  type="checkbox"
                  class="quiz-checkbox"
                  data-group="video-wise"
                  value="<%= quiz.id %>">

              </div>


              <!-- Quiz -->

              <div class="quiz-info">

                <div class="quiz-title">
                  <%= quiz.title %>
                </div>

                <div class="quiz-description">
                  <%= quiz.description.presence || "Video level quiz" %>
                </div>

              </div>


              <!-- Video -->

              <div class="quiz-video-info">

                <div class="quiz-video-icon">
                  <i class="fas fa-video"></i>
                </div>

                <div
                  class="quiz-video-name"
                  title="<%= quiz.video&.title %>">

                  <%= quiz.video&.title.presence || "Video not available" %>

                </div>

              </div>


              <!-- Questions -->

              <div class="quiz-metric">

                <i class="fas fa-question-circle"></i>

                <%= quiz.questions.size %>

                Questions

              </div>


              <!-- Time -->

              <div class="quiz-metric">

                <i class="fas fa-clock"></i>

                <%= quiz.time_limit %> min

              </div>


              <!-- Status -->

              <div class="quiz-status-wrapper">

                <% if quiz.status.to_s.downcase == "active" %>

                  <span class="quiz-status-badge quiz-status-active">
                    Active
                  </span>

                <% else %>

                  <span class="quiz-status-badge quiz-status-inactive">
                    <%= quiz.status %>
                  </span>

                <% end %>

              </div>


              <!-- Actions -->

              <div class="quiz-actions">

                <%= link_to teacher_panel_course_quiz_path(@course, quiz),
                            class: "quiz-action-btn",
                            title: "View Quiz" do %>

                  <i class="fas fa-eye"></i>

                <% end %>


                <%= link_to edit_teacher_panel_course_quiz_path(@course, quiz),
                            class: "quiz-action-btn",
                            title: "Edit Quiz" do %>

                  <i class="fas fa-pen"></i>

                <% end %>

              </div>

            </div>

          <% end %>

        </div>


        <div class="quiz-no-results"
             data-no-results="video-wise">

          <i class="fas fa-search"></i>

          No video quizzes found.

        </div>

      <% else %>

        <div class="quiz-empty">

          <div class="quiz-empty-icon">
            <i class="fas fa-video"></i>
          </div>

          <h3>
            No Video Wise Quizzes
          </h3>

          <p>
            Create a video-wise quiz to see it here.
          </p>

        </div>

      <% end %>

    </div>

  </div>

</div>


<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>
document.addEventListener("DOMContentLoaded", function () {

  /* ========================================================
     TAB SYSTEM
  ======================================================== */

  const tabButtons =
    document.querySelectorAll(".quiz-tab-btn");

  const tabContents =
    document.querySelectorAll(".quiz-tab-content");


  tabButtons.forEach(function (button) {

    button.addEventListener("click", function () {

      const target =
        button.getAttribute("data-tab");


      /* Remove active from buttons */

      tabButtons.forEach(function (btn) {
        btn.classList.remove("active");
      });


      /* Hide all content */

      tabContents.forEach(function (content) {
        content.classList.remove("active");
      });


      /* Activate clicked tab */

      button.classList.add("active");


      const targetContent =
        document.querySelector(
          '.quiz-tab-content[data-content="' +
          target +
          '"]'
        );


      if (targetContent) {
        targetContent.classList.add("active");
      }


      /* Re-run search for active tab */

      filterQuizzes();

    });

  });


  /* ========================================================
     SEARCH
  ======================================================== */

  const searchInput =
    document.getElementById("quizSearchInput");

  const searchButton =
    document.getElementById("quizSearchButton");


  function filterQuizzes() {

    if (!searchInput) return;


    const searchTerm =
      searchInput.value
        .trim()
        .toLowerCase();


    const activeContent =
      document.querySelector(
        ".quiz-tab-content.active"
      );


    if (!activeContent) return;


    const rows =
      activeContent.querySelectorAll(
        "[data-quiz-row]"
      );


    const noResults =
      activeContent.querySelector(
        ".quiz-no-results"
      );


    let visibleCount = 0;


    rows.forEach(function (row) {

      const searchableText =
        row.getAttribute("data-search") || "";


      if (
        searchTerm === "" ||
        searchableText.includes(searchTerm)
      ) {

        row.style.display = "grid";

        visibleCount++;

      } else {

        row.style.display = "none";

      }

    });


    if (noResults) {

      noResults.style.display =
        searchTerm !== "" && visibleCount === 0
          ? "block"
          : "none";

    }

  }


  if (searchButton) {

    searchButton.addEventListener(
      "click",
      filterQuizzes
    );

  }


  if (searchInput) {

    searchInput.addEventListener(
      "keydown",
      function (event) {

        if (event.key === "Enter") {
          event.preventDefault();
          filterQuizzes();
        }

      }
    );


    searchInput.addEventListener(
      "input",
      function () {

        filterQuizzes();

      }
    );

  }


  /* ========================================================
     SELECT ALL + INDIVIDUAL SELECTION
  ======================================================== */

  function updateSelection(group) {

    const checkboxes =
      document.querySelectorAll(
        '.quiz-checkbox[data-group="' +
        group +
        '"]'
      );


    const selectAll =
      document.querySelector(
        '.select-all-checkbox[data-group="' +
        group +
        '"]'
      );


    const countElement =
      document.querySelector(
        '.selected-count[data-group="' +
        group +
        '"]'
      );


    const checked =
      Array.from(checkboxes)
        .filter(function (checkbox) {
          return checkbox.checked;
        });


    if (countElement) {
      countElement.textContent =
        checked.length;
    }


    if (selectAll) {

      selectAll.checked =
        checkboxes.length > 0 &&
        checked.length === checkboxes.length;

      selectAll.indeterminate =
        checked.length > 0 &&
        checked.length < checkboxes.length;

    }

  }


  const selectAllCheckboxes =
    document.querySelectorAll(
      ".select-all-checkbox"
    );


  selectAllCheckboxes.forEach(function (selectAll) {

    selectAll.addEventListener(
      "change",
      function () {

        const group =
          selectAll.getAttribute("data-group");


        const checkboxes =
          document.querySelectorAll(
            '.quiz-checkbox[data-group="' +
            group +
            '"]'
          );


        checkboxes.forEach(function (checkbox) {

          checkbox.checked =
            selectAll.checked;

        });


        updateSelection(group);

      }
    );

  });


  const quizCheckboxes =
    document.querySelectorAll(
      ".quiz-checkbox"
    );


  quizCheckboxes.forEach(function (checkbox) {

    checkbox.addEventListener(
      "change",
      function () {

        const group =
          checkbox.getAttribute("data-group");


        updateSelection(group);

      }
    );

  });


  /* ========================================================
     INITIAL STATE
  ======================================================== */

  updateSelection("course-wise");
  updateSelection("video-wise");

});
</script>