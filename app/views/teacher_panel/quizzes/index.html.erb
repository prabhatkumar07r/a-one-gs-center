<% content_for :show_layout, true %>

<style>
/* =========================================================
   TEACHER PANEL - COURSE QUIZZES
   Modern Dark Purple UI
========================================================= */

.teacher-quizzes-page {
  min-height: 100vh;
  padding: 30px;
  background:
    radial-gradient(
      circle at top left,
      rgba(99, 102, 241, .20),
      transparent 28%
    ),
    radial-gradient(
      circle at bottom right,
      rgba(168, 85, 247, .16),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      #080d1c,
      #10172b 55%,
      #090e1c
    );

  color: #fff;
}

.teacher-quizzes-container {
  width: 100%;
  max-width: 1250px;
  margin: 0 auto;
}

/* =========================================================
   TOP BAR
========================================================= */

.quiz-page-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 22px;
}

.quiz-breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;

  color: #64748b;
  font-size: 12px;
}

.quiz-breadcrumb i {
  color: #818cf8;
}

.quiz-breadcrumb strong {
  color: #e2e8f0;
}

.quiz-create-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  padding: 11px 17px;

  border-radius: 12px;

  background: linear-gradient(
    135deg,
    #6366f1,
    #8b5cf6
  );

  color: #fff;
  text-decoration: none;

  font-size: 13px;
  font-weight: 800;

  box-shadow:
    0 10px 25px rgba(99, 102, 241, .25);

  transition: .25s ease;
}

.quiz-create-btn:hover {
  color: #fff;
  transform: translateY(-2px);

  box-shadow:
    0 15px 32px rgba(99, 102, 241, .35);
}

/* =========================================================
   PAGE HEADER
========================================================= */

.quiz-page-header {
  position: relative;
  overflow: hidden;

  padding: 28px 30px;
  margin-bottom: 24px;

  border-radius: 22px;

  background:
    linear-gradient(
      135deg,
      rgba(79,70,229,.25),
      rgba(124,58,237,.12)
    );

  border: 1px solid rgba(255,255,255,.08);

  box-shadow:
    0 20px 55px rgba(0,0,0,.25);
}

.quiz-page-header::after {
  content: "";

  position: absolute;

  width: 240px;
  height: 240px;

  right: -100px;
  top: -130px;

  border-radius: 50%;

  background: rgba(129,140,248,.08);
}

.quiz-header-content {
  position: relative;
  z-index: 2;
}

.quiz-header-icon {
  width: 55px;
  height: 55px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 14px;

  border-radius: 16px;

  background: rgba(255,255,255,.06);

  border: 1px solid rgba(255,255,255,.08);

  color: #a5b4fc;

  font-size: 23px;
}

.quiz-page-header h2 {
  margin: 0 0 7px;

  color: #fff;

  font-size: 27px;
  font-weight: 800;

  letter-spacing: -.4px;
}

.quiz-page-header p {
  margin: 0;

  color: #64748b;

  font-size: 13px;
}

.course-name {
  color: #c4b5fd;
  font-weight: 800;
}

/* =========================================================
   STAT CARDS
========================================================= */

.quiz-stat-grid {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 14px;

  margin-bottom: 28px;
}

.quiz-stat-card {
  padding: 19px;

  border-radius: 17px;

  background: rgba(15,23,42,.78);

  border: 1px solid rgba(255,255,255,.07);

  box-shadow:
    0 15px 35px rgba(0,0,0,.20);
}

.quiz-stat-icon {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 12px;

  border-radius: 11px;

  background: rgba(99,102,241,.10);

  color: #a5b4fc;

  font-size: 16px;
}

.quiz-stat-number {
  color: #f8fafc;

  font-size: 25px;
  font-weight: 800;
}

.quiz-stat-label {
  margin-top: 3px;

  color: #64748b;

  font-size: 11px;
}

/* =========================================================
   SECTION
========================================================= */

.quiz-section {
  margin-bottom: 30px;
}

.quiz-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  margin-bottom: 15px;
}

.quiz-section-title {
  display: flex;
  align-items: center;
  gap: 10px;

  color: #f8fafc;

  font-size: 18px;
  font-weight: 800;
}

.quiz-section-title i {
  color: #a5b4fc;
}

.quiz-section-subtitle {
  color: #64748b;
  font-size: 11px;
}

/* =========================================================
   QUIZ CARD
========================================================= */

.quiz-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
}

.quiz-card {
  padding: 20px;

  border-radius: 17px;

  background: rgba(15,23,42,.78);

  border: 1px solid rgba(255,255,255,.07);

  transition: .25s ease;

  box-shadow:
    0 15px 35px rgba(0,0,0,.18);
}

.quiz-card:hover {
  transform: translateY(-3px);

  border-color:
    rgba(129,140,248,.28);

  box-shadow:
    0 20px 45px rgba(0,0,0,.28);
}

.quiz-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 15px;

  margin-bottom: 13px;
}

.quiz-card-icon {
  width: 43px;
  height: 43px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 12px;

  background: rgba(99,102,241,.12);

  color: #a5b4fc;

  font-size: 18px;
}

.quiz-card-title {
  margin: 0;

  color: #f8fafc;

  font-size: 15px;
  font-weight: 800;

  line-height: 1.4;
}

.quiz-card-description {
  margin-top: 6px;

  color: #64748b;

  font-size: 11px;

  line-height: 1.5;
}

.quiz-status {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  padding: 5px 9px;

  border-radius: 20px;

  font-size: 10px;
  font-weight: 800;

  white-space: nowrap;
}

.quiz-status.active {
  background: rgba(34,197,94,.10);
  color: #86efac;
  border: 1px solid rgba(34,197,94,.20);
}

.quiz-status.inactive {
  background: rgba(239,68,68,.10);
  color: #fca5a5;
  border: 1px solid rgba(239,68,68,.20);
}

/* =========================================================
   QUIZ META
========================================================= */

.quiz-meta {
  display: flex;

  flex-wrap: wrap;

  gap: 8px;

  margin-top: 15px;
}

.quiz-meta-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  padding: 7px 9px;

  border-radius: 9px;

  background: rgba(255,255,255,.035);

  color: #94a3b8;

  font-size: 10px;
}

.quiz-meta-item i {
  color: #818cf8;
}

.quiz-video-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  margin-top: 12px;

  padding: 7px 10px;

  border-radius: 9px;

  background: rgba(168,85,247,.08);

  border: 1px solid rgba(168,85,247,.15);

  color: #c4b5fd;

  font-size: 10px;
  font-weight: 700;
}

/* =========================================================
   CARD ACTIONS
========================================================= */

.quiz-card-actions {
  display: flex;

  align-items: center;

  gap: 8px;

  margin-top: 17px;

  padding-top: 14px;

  border-top:
    1px solid rgba(255,255,255,.06);
}

.quiz-action {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 6px;

  padding: 8px 11px;

  border-radius: 9px;

  font-size: 10px;
  font-weight: 800;

  text-decoration: none;

  transition: .2s ease;
}

.quiz-action.view {
  background: rgba(59,130,246,.10);
  border: 1px solid rgba(59,130,246,.18);
  color: #93c5fd;
}

.quiz-action.edit {
  background: rgba(245,158,11,.10);
  border: 1px solid rgba(245,158,11,.18);
  color: #fcd34d;
}

.quiz-action.delete {
  background: rgba(239,68,68,.08);
  border: 1px solid rgba(239,68,68,.15);
  color: #fca5a5;
}

.quiz-action:hover {
  transform: translateY(-1px);
  color: #fff;
}

/* =========================================================
   EMPTY STATE
========================================================= */

.quiz-empty {
  padding: 40px 25px;

  text-align: center;

  border-radius: 17px;

  background: rgba(15,23,42,.65);

  border:
    1px dashed rgba(255,255,255,.10);
}

.quiz-empty-icon {
  width: 55px;
  height: 55px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin: 0 auto 14px;

  border-radius: 15px;

  background: rgba(99,102,241,.08);

  color: #818cf8;

  font-size: 22px;
}

.quiz-empty h5 {
  margin-bottom: 6px;

  color: #e2e8f0;

  font-size: 15px;
  font-weight: 800;
}

.quiz-empty p {
  margin: 0;

  color: #64748b;

  font-size: 11px;
}

/* =========================================================
   TEST SERIES
========================================================= */

.test-series-list {
  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 15px;
}

.test-series-card {
  padding: 20px;

  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      rgba(30,41,59,.85),
      rgba(15,23,42,.85)
    );

  border: 1px solid rgba(255,255,255,.07);

  box-shadow:
    0 15px 35px rgba(0,0,0,.18);

  transition: .25s ease;
}

.test-series-card:hover {
  transform: translateY(-3px);

  border-color:
    rgba(168,85,247,.25);
}

.test-series-top {
  display: flex;

  justify-content: space-between;

  align-items: flex-start;

  gap: 15px;
}

.test-series-icon {
  width: 45px;
  height: 45px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 13px;

  background: rgba(168,85,247,.10);

  color: #c4b5fd;

  font-size: 18px;
}

.test-series-title {
  margin: 0;

  color: #f8fafc;

  font-size: 15px;

  font-weight: 800;
}

.test-series-description {
  margin-top: 6px;

  color: #64748b;

  font-size: 11px;

  line-height: 1.5;
}

/* =========================================================
   FREE / PAID
========================================================= */

.series-price {
  margin-top: 15px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 10px;
}

.series-free {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  padding: 6px 10px;

  border-radius: 20px;

  background: rgba(34,197,94,.10);

  border: 1px solid rgba(34,197,94,.18);

  color: #86efac;

  font-size: 10px;

  font-weight: 800;
}

.series-paid {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  padding: 6px 10px;

  border-radius: 20px;

  background: rgba(245,158,11,.10);

  border: 1px solid rgba(245,158,11,.18);

  color: #fcd34d;

  font-size: 10px;

  font-weight: 800;
}

.series-price-value {
  color: #e2e8f0;

  font-size: 14px;

  font-weight: 800;
}

/* =========================================================
   SERIES META
========================================================= */

.series-meta {
  display: flex;

  flex-wrap: wrap;

  gap: 8px;

  margin-top: 14px;
}

.series-meta-item {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  padding: 7px 9px;

  border-radius: 9px;

  background: rgba(255,255,255,.035);

  color: #94a3b8;

  font-size: 10px;
}

.series-meta-item i {
  color: #a78bfa;
}

/* =========================================================
   SERIES ACTIONS
========================================================= */

.series-actions {
  margin-top: 17px;

  padding-top: 14px;

  border-top:
    1px solid rgba(255,255,255,.06);

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 10px;
}

.series-view-btn {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  padding: 9px 13px;

  border-radius: 10px;

  background: rgba(99,102,241,.10);

  border:
    1px solid rgba(99,102,241,.18);

  color: #a5b4fc;

  text-decoration: none;

  font-size: 10px;

  font-weight: 800;

  transition: .2s ease;
}

.series-view-btn:hover {
  color: #fff;

  background: rgba(99,102,241,.18);

  transform: translateY(-1px);
}

/* =========================================================
   NOTICE
========================================================= */

.quiz-info-box {
  display: flex;

  align-items: flex-start;

  gap: 10px;

  padding: 14px 16px;

  margin-top: 20px;

  border-radius: 13px;

  background: rgba(59,130,246,.06);

  border:
    1px solid rgba(59,130,246,.12);

  color: #94a3b8;

  font-size: 11px;

  line-height: 1.5;
}

.quiz-info-box i {
  color: #60a5fa;

  margin-top: 2px;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 991px) {

  .teacher-quizzes-page {
    padding: 22px;
  }

  .quiz-stat-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .quiz-list,
  .test-series-list {
    grid-template-columns: 1fr;
  }

}

@media (max-width: 767px) {

  .teacher-quizzes-page {
    padding: 15px;
  }

  .quiz-page-top {
    flex-direction: column;

    align-items: stretch;
  }

  .quiz-create-btn {
    width: 100%;
  }

  .quiz-page-header {
    padding: 21px;
    border-radius: 18px;
  }

  .quiz-page-header h2 {
    font-size: 23px;
  }

  .quiz-stat-grid {
    grid-template-columns: 1fr 1fr;
  }

  .quiz-card,
  .test-series-card {
    padding: 17px;
  }

}

@media (max-width: 480px) {

  .quiz-stat-grid {
    grid-template-columns: 1fr;
  }

  .quiz-card-top,
  .test-series-top {
    flex-direction: column;
  }

  .quiz-status {
    align-self: flex-start;
  }

  .quiz-card-actions {
    flex-wrap: wrap;
  }

  .series-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .series-view-btn {
    width: 100%;
  }

}
</style>


<div class="teacher-quizzes-page">

  <div class="teacher-quizzes-container">


    <!-- =====================================================
         TOP NAVIGATION
    ====================================================== -->

    <div class="quiz-page-top">

      <div class="quiz-breadcrumb">

        <i class="fas fa-chalkboard-teacher"></i>

        <span>Teacher Panel</span>

        <i class="fas fa-chevron-right"></i>

        <span>Courses</span>

        <i class="fas fa-chevron-right"></i>

        <strong>
          <%= @course.Course_name %>
        </strong>

        <i class="fas fa-chevron-right"></i>

        <strong>
          Quizzes
        </strong>

      </div>


      <%= link_to new_teacher_panel_course_quiz_path(@course),
                  class: "quiz-create-btn" do %>

        <i class="fas fa-plus"></i>

        Create Quiz

      <% end %>

    </div>


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="quiz-page-header">

      <div class="quiz-header-content">

        <div class="quiz-header-icon">

          <i class="fas fa-clipboard-question"></i>

        </div>

        <h2>
          Course Quizzes
        </h2>

        <p>

          Manage course-level and video-wise quizzes for

          <span class="course-name">
            <%= @course.Course_name %>
          </span>

        </p>

      </div>

    </div>


    <!-- =====================================================
         STATISTICS
    ====================================================== -->

    <div class="quiz-stat-grid">


      <!-- TOTAL COURSE/VIDEO QUIZZES -->

      <div class="quiz-stat-card">

        <div class="quiz-stat-icon">

          <i class="fas fa-clipboard-list"></i>

        </div>

        <div class="quiz-stat-number">

          <%= @course_level_quizzes.count %>

        </div>

        <div class="quiz-stat-label">

          Course & Video Quizzes

        </div>

      </div>


      <!-- COURSE LEVEL -->

      <div class="quiz-stat-card">

        <div class="quiz-stat-icon">

          <i class="fas fa-graduation-cap"></i>

        </div>

        <div class="quiz-stat-number">

          <%= @course_level_quizzes.count { |quiz| quiz.video_id.blank? } %>

        </div>

        <div class="quiz-stat-label">

          Course Level

        </div>

      </div>


      <!-- VIDEO LEVEL -->

      <div class="quiz-stat-card">

        <div class="quiz-stat-icon">

          <i class="fas fa-video"></i>

        </div>

        <div class="quiz-stat-number">

          <%= @course_level_quizzes.count { |quiz| quiz.video_id.present? } %>

        </div>

        <div class="quiz-stat-label">

          Video-wise

        </div>

      </div>


      <!-- TEST SERIES -->

      <div class="quiz-stat-card">

        <div class="quiz-stat-icon">

          <i class="fas fa-layer-group"></i>

        </div>

        <div class="quiz-stat-number">

          <%= @test_series.count %>

        </div>

        <div class="quiz-stat-label">

          Test Series

        </div>

      </div>

    </div>


    <!-- =====================================================
         COURSE / VIDEO QUIZZES
    ====================================================== -->

    <div class="quiz-section">

      <div class="quiz-section-header">

        <div>

          <div class="quiz-section-title">

            <i class="fas fa-clipboard-check"></i>

            Course & Video Quizzes

          </div>

          <div class="quiz-section-subtitle">

            Quizzes created directly for this course or linked to a video.

          </div>

        </div>

      </div>


      <% if @course_level_quizzes.any? %>

        <div class="quiz-list">


          <% @course_level_quizzes.each do |quiz| %>

            <div class="quiz-card">


              <div class="quiz-card-top">


                <div class="d-flex gap-3">


                  <div class="quiz-card-icon">

                    <% if quiz.video_id.present? %>

                      <i class="fas fa-video"></i>

                    <% else %>

                      <i class="fas fa-graduation-cap"></i>

                    <% end %>

                  </div>


                  <div>

                    <h3 class="quiz-card-title">

                      <%= quiz.title %>

                    </h3>


                    <% if quiz.description.present? %>

                      <div class="quiz-card-description">

                        <%= truncate(
                              quiz.description,
                              length: 130
                            ) %>

                      </div>

                    <% else %>

                      <div class="quiz-card-description">

                        No description provided.

                      </div>

                    <% end %>

                  </div>

                </div>


                <% if quiz.status.to_s == "Active" %>

                  <span class="quiz-status active">

                    <i class="fas fa-circle-check"></i>

                    Active

                  </span>

                <% else %>

                  <span class="quiz-status inactive">

                    <i class="fas fa-circle-pause"></i>

                    <%= quiz.status.presence || "Inactive" %>

                  </span>

                <% end %>

              </div>


              <!-- VIDEO -->

              <% if quiz.video.present? %>

                <div class="quiz-video-tag">

                  <i class="fas fa-video"></i>

                  Video:

                  <%= quiz.video.title %>

                </div>

              <% else %>

                <div class="quiz-video-tag">

                  <i class="fas fa-graduation-cap"></i>

                  Course Level Quiz

                </div>

              <% end %>


              <!-- META -->

              <div class="quiz-meta">


                <div class="quiz-meta-item">

                  <i class="fas fa-clock"></i>

                  <%= quiz.time_limit || 0 %>

                  min

                </div>


                <div class="quiz-meta-item">

                  <i class="fas fa-percent"></i>

                  Pass:

                  <%= quiz.passing_percentage || 0 %>%

                </div>


                <div class="quiz-meta-item">

                  <i class="fas fa-question-circle"></i>

                  <%= quiz.questions.size %>

                  Questions

                </div>


                <div class="quiz-meta-item">

                  <i class="fas fa-calendar"></i>

                  <%= quiz.created_at.strftime("%d %b %Y") if quiz.created_at %>

                </div>

              </div>


              <!-- ACTIONS -->

              <div class="quiz-card-actions">


                <%= link_to teacher_panel_course_quiz_path(
                              @course,
                              quiz
                            ),
                            class: "quiz-action view" do %>

                  <i class="fas fa-eye"></i>

                  View

                <% end %>


                <%= link_to edit_teacher_panel_course_quiz_path(
                              @course,
                              quiz
                            ),
                            class: "quiz-action edit" do %>

                  <i class="fas fa-pen"></i>

                  Edit

                <% end %>


                <%= button_to teacher_panel_course_quiz_path(
                              @course,
                              quiz
                            ),
                            method: :delete,
                            class: "quiz-action delete",
                            form: {
                              style: "display:inline;"
                            },
                            data: {
                              turbo_confirm:
                                "Are you sure you want to delete this quiz?"
                            } do %>

                  <i class="fas fa-trash"></i>

                  Delete

                <% end %>


              </div>

            </div>

          <% end %>


        </div>


      <% else %>


        <div class="quiz-empty">

          <div class="quiz-empty-icon">

            <i class="fas fa-clipboard-question"></i>

          </div>

          <h5>
            No Course Quizzes Yet
          </h5>

          <p>
            Create your first course-level or video-wise quiz.
          </p>

        </div>

      <% end %>

    </div>


    <!-- =====================================================
         TEST SERIES
    ====================================================== -->

    <div class="quiz-section">

      <div class="quiz-section-header">

        <div>

          <div class="quiz-section-title">

            <i class="fas fa-layer-group"></i>

            Test Series

          </div>

          <div class="quiz-section-subtitle">

            Test series created for this course.

          </div>

        </div>

      </div>


      <% if @test_series.any? %>

        <div class="test-series-list">


          <% @test_series.each do |series| %>

            <div class="test-series-card">


              <div class="test-series-top">


                <div class="d-flex gap-3">


                  <div class="test-series-icon">

                    <i class="fas fa-layer-group"></i>

                  </div>


                  <div>

                    <h3 class="test-series-title">

                      <%= series.title %>

                    </h3>


                    <% if series.respond_to?(:description) &&
                          series.description.present? %>

                      <div class="test-series-description">

                        <%= truncate(
                              series.description,
                              length: 140
                            ) %>

                      </div>

                    <% else %>

                      <div class="test-series-description">

                        Test series for
                        <%= @course.Course_name %>.

                      </div>

                    <% end %>

                  </div>

                </div>


              </div>


              <!-- PRICE -->

              <div class="series-price">


                <% price =
                     if series.respond_to?(:price)
                       series.price
                     elsif series.respond_to?(:amount)
                       series.amount
                     else
                       0
                     end
                %>


                <% if price.to_f <= 0 %>

                  <span class="series-free">

                    <i class="fas fa-unlock"></i>

                    FREE

                  </span>

                  <span class="series-price-value">

                    Free

                  </span>

                <% else %>

                  <span class="series-paid">

                    <i class="fas fa-lock"></i>

                    PAID

                  </span>

                  <span class="series-price-value">

                    ₹<%= number_with_precision(
                          price,
                          precision: 2
                        ) %>

                  </span>

                <% end %>


              </div>


              <!-- META -->

              <div class="series-meta">


                <div class="series-meta-item">

                  <i class="fas fa-clipboard-list"></i>

                  <%= series.quizzes.size %>

                  Quizzes

                </div>


                <div class="series-meta-item">

                  <i class="fas fa-question-circle"></i>

                  <%= series.quizzes.sum { |q| q.questions.size } %>

                  Questions

                </div>


                <div class="series-meta-item">

                  <i class="fas fa-calendar"></i>

                  <%= series.created_at.strftime("%d %b %Y") if series.created_at %>

                </div>


              </div>


              <!-- ACTION -->

              <div class="series-actions">


                <span class="field-help">

                  <i class="fas fa-circle-info me-1"></i>

                  Quizzes assigned to this series are shown here.

                </span>


                <% if respond_to?(:teacher_panel_course_test_series_path) %>

                  <%= link_to teacher_panel_course_test_series_path(
                                @course,
                                series
                              ),
                              class: "series-view-btn" do %>

                    <i class="fas fa-eye"></i>

                    View Test Series

                  <% end %>

                <% end %>


              </div>


            </div>

          <% end %>


        </div>


      <% else %>


        <div class="quiz-empty">

          <div class="quiz-empty-icon">

            <i class="fas fa-layer-group"></i>

          </div>

          <h5>
            No Test Series Yet
          </h5>

          <p>
            Test series created for this course will appear here.
          </p>

        </div>

      <% end %>


      <!-- INFORMATION -->

      <div class="quiz-info-box">

        <i class="fas fa-circle-info"></i>

        <div>

          <strong>Test Series:</strong>

          Test series are separate from normal course quizzes.
          They can be configured as free or paid and can contain
          multiple quizzes for students.

        </div>

      </div>

    </div>


  </div>

</div>