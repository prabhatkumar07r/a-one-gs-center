<% content_for :hide_footer, true %>

<div class="teacher-quiz-show-page">

  <!-- =====================================================
       HEADER
  ====================================================== -->

  <div class="teacher-quiz-show-header">

    <div>

      <div class="teacher-quiz-breadcrumb">
        <%= link_to "Teacher Panel",
                    teacher_dashboard_path %>

        <i class="fas fa-chevron-right"></i>

        <%= link_to "Courses",
                    teacher_panel_courses_path %>

        <i class="fas fa-chevron-right"></i>

        <%= link_to "Quizzes",
                    teacher_panel_course_quizzes_path(@course) %>

        <i class="fas fa-chevron-right"></i>

        <span><%= @quiz.title %></span>
      </div>


      <div class="quiz-title-row">

        <div class="quiz-main-icon">
          <i class="fas fa-clipboard-check"></i>
        </div>

        <div>

          <h1>
            <%= @quiz.title %>
          </h1>

          <p>
            <%= @course.Course_name %>
          </p>

        </div>

      </div>

    </div>


    <div class="quiz-header-actions">

      <%= link_to edit_teacher_panel_course_quiz_path(@course, @quiz),
                  class: "quiz-edit-btn" do %>

        <i class="fas fa-edit"></i>
        Edit Quiz

      <% end %>


      <%= link_to teacher_panel_course_quizzes_path(@course),
                  class: "quiz-back-btn" do %>

        <i class="fas fa-arrow-left"></i>
        Back

      <% end %>

    </div>

  </div>


  <!-- =====================================================
       QUIZ SUMMARY
  ====================================================== -->

  <div class="quiz-summary-grid">


    <!-- QUESTIONS -->

    <div class="quiz-summary-card">

      <div class="summary-icon purple">
        <i class="fas fa-question-circle"></i>
      </div>

      <div>

        <span>Questions</span>

        <strong>
          <%= @questions.count %>
        </strong>

      </div>

    </div>


    <!-- TIME -->

    <div class="quiz-summary-card">

      <div class="summary-icon blue">
        <i class="fas fa-clock"></i>
      </div>

      <div>

        <span>Time Limit</span>

        <strong>
          <%= @quiz.time_limit %> min
        </strong>

      </div>

    </div>


    <!-- PASSING -->

    <div class="quiz-summary-card">

      <div class="summary-icon orange">
        <i class="fas fa-percentage"></i>
      </div>

      <div>

        <span>Passing</span>

        <strong>
          <%= @quiz.passing_percentage %>%
        </strong>

      </div>

    </div>


    <!-- STATUS -->

    <div class="quiz-summary-card">

      <div class="summary-icon green">
        <i class="fas fa-toggle-on"></i>
      </div>

      <div>

        <span>Status</span>

        <strong>
          <%= @quiz.status %>
        </strong>

      </div>

    </div>

  </div>


  <!-- =====================================================
       QUIZ INFORMATION
  ====================================================== -->

  <div class="quiz-info-card">

    <div class="quiz-card-header">

      <div>

        <h2>
          Quiz Information
        </h2>

        <p>
          Details about this quiz.
        </p>

      </div>

    </div>


    <div class="quiz-info-grid">


      <!-- TYPE -->

      <div class="quiz-info-item">

        <span class="info-label">
          Quiz Type
        </span>

        <strong>

          <% if @quiz.video.present? %>

            <i class="fas fa-video"></i>
            Video Quiz

          <% else %>

            <i class="fas fa-book-open"></i>
            Course Quiz

          <% end %>

        </strong>

      </div>


      <!-- VIDEO -->

      <% if @quiz.video.present? %>

        <div class="quiz-info-item">

          <span class="info-label">
            Video
          </span>

          <strong>
            <%= @quiz.video.title %>
          </strong>

        </div>

      <% end %>


      <!-- DESCRIPTION -->

      <div class="quiz-info-item full-width">

        <span class="info-label">
          Description
        </span>

        <div class="quiz-description">

          <%= @quiz.description.present? ?
                @quiz.description :
                "No description provided." %>

        </div>

      </div>

    </div>

  </div>


  <!-- =====================================================
       QUESTIONS HEADER
  ====================================================== -->

  <div class="questions-section-header">

    <div>

      <h2>
        Questions
      </h2>

      <p>
        Create and manage questions for this quiz.
      </p>

    </div>


    <%= link_to new_teacher_panel_course_quiz_question_path(
                  @course,
                  @quiz
                ),
                class: "add-question-btn" do %>

      <i class="fas fa-plus"></i>
      Add Question

    <% end %>

  </div>


  <!-- =====================================================
       QUESTIONS
  ====================================================== -->

  <% if @questions.any? %>

    <div class="teacher-question-list">

      <% @questions.each_with_index do |question, index| %>

        <div class="teacher-question-card">

          <div class="question-number">
            <%= index + 1 %>
          </div>


          <div class="question-content">

            <h3>
              <%= question.question_text %>
            </h3>


            <div class="question-meta">

              <span>
                <i class="fas fa-list"></i>

                <%= question.options.count %>
                Options
              </span>

            </div>

          </div>


          <div class="question-actions">

            <%= link_to teacher_panel_course_quiz_question_path(
                          @course,
                          @quiz,
                          question
                        ),
                        class: "question-view-btn",
                        title: "View Question" do %>

              <i class="fas fa-eye"></i>

            <% end %>


            <%= link_to edit_teacher_panel_course_quiz_question_path(
                          @course,
                          @quiz,
                          question
                        ),
                        class: "question-edit-btn",
                        title: "Edit Question" do %>

              <i class="fas fa-edit"></i>

            <% end %>


            <%= button_to teacher_panel_course_quiz_question_path(
                          @course,
                          @quiz,
                          question
                        ),
                        method: :delete,
                        data: {
                          turbo_confirm: "Delete this question?"
                        },
                        class: "question-delete-btn",
                        title: "Delete Question" do %>

              <i class="fas fa-trash"></i>

            <% end %>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <!-- EMPTY -->

    <div class="questions-empty">

      <div class="questions-empty-icon">
        <i class="fas fa-question-circle"></i>
      </div>

      <h2>
        No questions yet
      </h2>

      <p>
        Add questions to make this quiz available to students.
      </p>

      <%= link_to new_teacher_panel_course_quiz_question_path(
                    @course,
                    @quiz
                  ),
                  class: "add-question-btn" do %>

        <i class="fas fa-plus"></i>
        Add First Question

      <% end %>

    </div>

  <% end %>

</div>


<style>

/* =========================================================
   PAGE
========================================================= */

.teacher-quiz-show-page {
  min-height: 100vh;

  padding: 32px;

  background:
    radial-gradient(
      circle at top right,
      rgba(124, 58, 237, .09),
      transparent 35%
    ),
    #f8fafc;
}


/* =========================================================
   HEADER
========================================================= */

.teacher-quiz-show-header {
  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 25px;

  margin-bottom: 28px;
}

.teacher-quiz-breadcrumb {
  display: flex;

  align-items: center;

  gap: 8px;

  margin-bottom: 16px;

  color: #64748b;

  font-size: 12px;
}

.teacher-quiz-breadcrumb a {
  color: #7c3aed;

  text-decoration: none;

  font-weight: 600;
}

.teacher-quiz-breadcrumb i {
  color: #94a3b8;

  font-size: 9px;
}

.quiz-title-row {
  display: flex;

  align-items: center;

  gap: 15px;
}

.quiz-main-icon {
  width: 54px;
  height: 54px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 14px;

  background: #ede9fe;

  color: #7c3aed;

  font-size: 23px;
}

.quiz-title-row h1 {
  margin: 0;

  color: #111827;

  font-size: 28px;

  font-weight: 800;
}

.quiz-title-row p {
  margin: 5px 0 0;

  color: #64748b;

  font-size: 13px;
}


/* =========================================================
   HEADER ACTIONS
========================================================= */

.quiz-header-actions {
  display: flex;

  gap: 10px;
}

.quiz-edit-btn,
.quiz-back-btn {
  min-height: 42px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 7px;

  padding: 0 16px;

  border-radius: 10px;

  font-size: 12px;

  font-weight: 700;

  text-decoration: none;
}

.quiz-edit-btn {
  background: #7c3aed;

  color: #fff;
}

.quiz-edit-btn:hover {
  background: #6d28d9;

  color: #fff;
}

.quiz-back-btn {
  border: 1px solid #d1d5db;

  background: #fff;

  color: #475569;
}

.quiz-back-btn:hover {
  background: #f8fafc;

  color: #1e293b;
}


/* =========================================================
   SUMMARY
========================================================= */

.quiz-summary-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 16px;

  margin-bottom: 24px;
}

.quiz-summary-card {
  display: flex;

  align-items: center;

  gap: 13px;

  padding: 18px;

  background: #fff;

  border: 1px solid #e5e7eb;

  border-radius: 14px;

  box-shadow:
    0 5px 18px rgba(15, 23, 42, .05);
}

.summary-icon {
  width: 42px;
  height: 42px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 11px;
}

.summary-icon.purple {
  background: #ede9fe;
  color: #7c3aed;
}

.summary-icon.blue {
  background: #dbeafe;
  color: #2563eb;
}

.summary-icon.orange {
  background: #ffedd5;
  color: #ea580c;
}

.summary-icon.green {
  background: #dcfce7;
  color: #16a34a;
}

.quiz-summary-card span {
  display: block;

  margin-bottom: 3px;

  color: #64748b;

  font-size: 11px;
}

.quiz-summary-card strong {
  color: #1e293b;

  font-size: 16px;
}


/* =========================================================
   INFO CARD
========================================================= */

.quiz-info-card {
  margin-bottom: 30px;

  background: #fff;

  border: 1px solid #e5e7eb;

  border-radius: 16px;

  box-shadow:
    0 6px 20px rgba(15, 23, 42, .05);
}

.quiz-card-header {
  padding: 20px 22px;

  border-bottom: 1px solid #e5e7eb;
}

.quiz-card-header h2 {
  margin: 0 0 4px;

  color: #1e293b;

  font-size: 17px;
}

.quiz-card-header p {
  margin: 0;

  color: #64748b;

  font-size: 12px;
}

.quiz-info-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 0;
}

.quiz-info-item {
  padding: 18px 22px;

  border-bottom: 1px solid #f1f5f9;
}

.quiz-info-item:nth-child(odd) {
  border-right: 1px solid #f1f5f9;
}

.quiz-info-item.full-width {
  grid-column: 1 / -1;

  border-right: 0;
}

.info-label {
  display: block;

  margin-bottom: 6px;

  color: #94a3b8;

  font-size: 10px;

  font-weight: 700;

  text-transform: uppercase;

  letter-spacing: .05em;
}

.quiz-info-item strong {
  color: #334155;

  font-size: 13px;
}

.quiz-info-item strong i {
  margin-right: 6px;

  color: #7c3aed;
}

.quiz-description {
  color: #64748b;

  font-size: 13px;

  line-height: 1.7;
}


/* =========================================================
   QUESTIONS HEADER
========================================================= */

.questions-section-header {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

  margin-bottom: 16px;
}

.questions-section-header h2 {
  margin: 0 0 4px;

  color: #1e293b;

  font-size: 20px;
}

.questions-section-header p {
  margin: 0;

  color: #64748b;

  font-size: 12px;
}

.add-question-btn {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 8px;

  min-height: 42px;

  padding: 0 17px;

  border-radius: 10px;

  background: #7c3aed;

  color: #fff;

  font-size: 12px;

  font-weight: 700;

  text-decoration: none;

  box-shadow:
    0 7px 18px rgba(124, 58, 237, .18);
}

.add-question-btn:hover {
  background: #6d28d9;

  color: #fff;
}


/* =========================================================
   QUESTION LIST
========================================================= */

.teacher-question-list {
  display: flex;

  flex-direction: column;

  gap: 12px;
}

.teacher-question-card {
  display: flex;

  align-items: center;

  gap: 15px;

  padding: 16px;

  background: #fff;

  border: 1px solid #e5e7eb;

  border-radius: 13px;

  box-shadow:
    0 4px 14px rgba(15, 23, 42, .04);
}

.question-number {
  width: 38px;
  height: 38px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 10px;

  background: #ede9fe;

  color: #7c3aed;

  font-size: 13px;

  font-weight: 800;
}

.question-content {
  flex: 1;

  min-width: 0;
}

.question-content h3 {
  margin: 0 0 7px;

  color: #1e293b;

  font-size: 14px;

  font-weight: 700;

  line-height: 1.5;
}

.question-meta {
  color: #94a3b8;

  font-size: 11px;
}

.question-meta i {
  margin-right: 4px;

  color: #7c3aed;
}


/* =========================================================
   QUESTION ACTIONS
========================================================= */

.question-actions {
  display: flex;

  gap: 6px;
}

.question-actions a,
.question-actions button {
  width: 34px;
  height: 34px;

  display: flex;

  align-items: center;
  justify-content: center;

  border: 0;

  border-radius: 8px;

  background: #f8fafc;

  cursor: pointer;

  text-decoration: none;

  font-size: 12px;
}

.question-view-btn {
  color: #2563eb;
}

.question-edit-btn {
  color: #7c3aed;
}

.question-delete-btn {
  color: #dc2626;
}

.question-actions a:hover,
.question-actions button:hover {
  background: #f1f5f9;
}


/* =========================================================
   EMPTY
========================================================= */

.questions-empty {
  padding: 65px 25px;

  text-align: center;

  background: #fff;

  border: 1px dashed #d1d5db;

  border-radius: 16px;
}

.questions-empty-icon {
  width: 65px;
  height: 65px;

  display: flex;

  align-items: center;
  justify-content: center;

  margin: 0 auto 15px;

  border-radius: 17px;

  background: #ede9fe;

  color: #7c3aed;

  font-size: 25px;
}

.questions-empty h2 {
  margin: 0 0 7px;

  color: #1e293b;

  font-size: 20px;
}

.questions-empty p {
  margin: 0 0 20px;

  color: #64748b;

  font-size: 13px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 950px) {

  .quiz-summary-grid {
    grid-template-columns: repeat(2, 1fr);
  }

}

@media (max-width: 700px) {

  .teacher-quiz-show-page {
    padding: 20px 15px;
  }

  .teacher-quiz-show-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .quiz-header-actions {
    width: 100%;
  }

  .quiz-edit-btn,
  .quiz-back-btn {
    flex: 1;
  }

  .quiz-summary-grid,
  .quiz-info-grid {
    grid-template-columns: 1fr;
  }

  .quiz-info-item:nth-child(odd) {
    border-right: 0;
  }

  .quiz-info-item.full-width {
    grid-column: auto;
  }

  .questions-section-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .add-question-btn {
    width: 100%;
  }

  .teacher-question-card {
    align-items: flex-start;
  }

}

</style>