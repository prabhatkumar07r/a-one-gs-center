<% content_for :title, "Quiz Details" %>

<div class="container-fluid py-4">

  <!-- ================= HEADER ================= -->

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <div class="text-muted small mb-1">
        Teacher Panel / Quizzes / Show
      </div>

      <h2 class="fw-bold mb-1">
        <i class="fas fa-clipboard-question text-primary me-2"></i>
        <%= @quiz.title %>
      </h2>

      <p class="text-muted mb-0">
        <%= @course.Course_name %>
      </p>
    </div>

    <div class="d-flex gap-2">

      <%= link_to teacher_panel_course_quizzes_path(@course),
            class: "btn btn-outline-secondary" do %>
           <i class="fas fa-arrow-left me-1"></i>
           Back
         <% end %>

      <%= link_to edit_teacher_panel_course_quiz_path(@course, @quiz),
          class: "btn btn-primary" do %>
        <i class="fas fa-edit me-1"></i>
        Edit Quiz
      <% end %>

    </div>

  </div>


  <!-- ================= QUIZ INFORMATION ================= -->

  <div class="row g-4 mb-4">

    <!-- Quiz Information -->

    <div class="col-lg-8">

      <div class="card border-0 shadow-sm h-100">

        <div class="card-header bg-primary text-white py-3">

          <h5 class="mb-0 fw-bold">
            <i class="fas fa-info-circle me-2"></i>
            Quiz Information
          </h5>

        </div>

        <div class="card-body">

          <% if @quiz.description.present? %>

            <div class="mb-4">

              <h6 class="fw-bold">
                Description
              </h6>

              <p class="text-muted mb-0">
                <%= @quiz.description %>
              </p>

            </div>

          <% end %>


          <div class="row g-3">

            <!-- Time Limit -->

            <div class="col-md-4">

              <div class="p-3 bg-light rounded">

                <small class="text-muted d-block">
                  <i class="fas fa-clock me-1"></i>
                  Time Limit
                </small>

                <strong class="fs-5">
                  <%= @quiz.time_limit %> min
                </strong>

              </div>

            </div>


            <!-- Passing Percentage -->

            <div class="col-md-4">

              <div class="p-3 bg-light rounded">

                <small class="text-muted d-block">
                  <i class="fas fa-percent me-1"></i>
                  Passing Percentage
                </small>

                <strong class="fs-5">
                  <%= @quiz.passing_percentage %>%
                </strong>

              </div>

            </div>


            <!-- Status -->

            <div class="col-md-4">

              <div class="p-3 bg-light rounded">

                <small class="text-muted d-block">
                  <i class="fas fa-circle me-1"></i>
                  Status
                </small>

                <% if @quiz.status.to_s.downcase == "active" %>

                  <span class="badge bg-success fs-6">
                    Active
                  </span>

                <% else %>

                  <span class="badge bg-secondary fs-6">
                    <%= @quiz.status %>
                  </span>

                <% end %>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- Linked Video -->

    <div class="col-lg-4">

      <div class="card border-0 shadow-sm h-100">

        <div class="card-header bg-success text-white py-3">

          <h5 class="mb-0 fw-bold">
            <i class="fas fa-video me-2"></i>
            Quiz Video
          </h5>

        </div>

        <div class="card-body">

          <% if @quiz.video.present? %>

            <div class="mb-3">

              <span class="badge bg-success mb-2">
                Video Linked
              </span>

              <h5 class="fw-bold">
                <%= @quiz.video.title %>
              </h5>

              <% if @quiz.video.description.present? %>

                <p class="text-muted small">
                  <%= truncate(@quiz.video.description, length: 120) %>
                </p>

              <% end %>

              <div class="small text-muted">

                <div class="mb-2">

                  <i class="fas fa-list-ol me-2"></i>

                  Lesson:
                  <strong>
                    <%= @quiz.video.position %>
                  </strong>

                </div>

                <% if @quiz.video.duration.present? %>

                  <div>

                    <i class="fas fa-clock me-2"></i>

                    Duration:
                    <strong>
                      <%= @quiz.video.duration %>
                    </strong>

                  </div>

                <% end %>

              </div>

            </div>

          <% else %>

            <div class="text-center py-4">

              <i class="fas fa-video-slash fa-3x text-muted mb-3"></i>

              <p class="text-muted mb-0">
                This quiz is not linked to a video.
              </p>

            </div>

          <% end %>

        </div>

      </div>

    </div>

  </div>


  <!-- ================= QUESTION HEADER ================= -->

  <div class="card border-0 shadow-sm">

    <div class="card-header bg-dark text-white py-3">

      <div class="d-flex justify-content-between align-items-center">

        <h5 class="mb-0 fw-bold">

          <i class="fas fa-list-check me-2"></i>

          Quiz Questions

          <span class="badge bg-light text-dark ms-2">
            <%= @questions.count %>
          </span>

        </h5>


        <!-- Add Question -->

       <%= link_to new_teacher_panel_course_quiz_question_path(@course, @quiz),
    class: "btn btn-light btn-sm" do %>

  <i class="fas fa-plus me-1"></i>
  Add Question

<% end %>

      </div>

    </div>


    <div class="card-body p-0">

      <% if @questions.any? %>

        <div class="accordion accordion-flush"
             id="quizQuestionsAccordion">

          <% @questions.each_with_index do |question, index| %>

            <div class="accordion-item">

              <!-- ================= QUESTION HEADER ================= -->

              <h2 class="accordion-header"
                  id="heading<%= question.id %>">

                <button class="accordion-button <%= index == 0 ? '' : 'collapsed' %>"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#question<%= question.id %>"
                        aria-expanded="<%= index == 0 %>">

                  <div class="w-100 pe-3">

                    <div class="d-flex justify-content-between align-items-center">

                      <div>

                        <span class="badge bg-primary me-2">
                          Q<%= index + 1 %>
                        </span>

                        <strong>
                          <%= question.question_text %>
                        </strong>

                      </div>

                      <span class="badge bg-warning text-dark">

                        <%= question.marks %>
                        <%= question.marks.to_f == 1 ? "Mark" : "Marks" %>

                      </span>

                    </div>

                  </div>

                </button>

              </h2>


              <!-- ================= QUESTION BODY ================= -->

              <div id="question<%= question.id %>"
                   class="accordion-collapse collapse <%= index == 0 ? 'show' : '' %>"
                   data-bs-parent="#quizQuestionsAccordion">

                <div class="accordion-body">

                  <!-- Question -->

                  <div class="mb-4">

                    <h6 class="fw-bold text-primary">
                      Question
                    </h6>

                    <div class="p-3 bg-light rounded">

                      <%= question.question_text %>

                    </div>

                  </div>


                  <!-- Options -->

                  <h6 class="fw-bold mb-3">
                    Options
                  </h6>

                  <% if question.options.any? %>

                    <div class="row g-3">

                      <% question.options.order(:position).each do |option| %>

                        <div class="col-md-6">

                          <% if option.is_correct? %>

                            <div class="border border-success rounded p-3 bg-success bg-opacity-10">

                              <div class="d-flex align-items-center">

                                <span class="badge bg-success me-2">
                                  ✓
                                </span>

                                <strong>
                                  <%= option.option_text %>
                                </strong>

                              </div>

                              <small class="text-success mt-2 d-block">
                                Correct Answer
                              </small>

                            </div>

                          <% else %>

                            <div class="border rounded p-3">

                              <div class="d-flex align-items-center">

                                <span class="badge bg-secondary me-2">
                                  ○
                                </span>

                                <span>
                                  <%= option.option_text %>
                                </span>

                              </div>

                            </div>

                          <% end %>

                        </div>

                      <% end %>

                    </div>

                  <% else %>

                    <div class="alert alert-warning">

                      <i class="fas fa-exclamation-triangle me-2"></i>

                      No options added to this question.

                    </div>

                  <% end %>


                  <!-- Question Actions -->

                  <div class="border-top mt-4 pt-3">

                    <div class="d-flex justify-content-end gap-2">

                      <%= link_to edit_teacher_panel_course_quiz_question_path(
                       @course,
                     @quiz,
                    question
                     ),
                          class: "btn btn-outline-primary btn-sm" do %>

                             <i class="fas fa-edit me-1"></i>
                           Edit Question

                        <% end %>

                    </div>

                  </div>

                </div>

              </div>

            </div>

          <% end %>

        </div>

      <% else %>

        <!-- ================= NO QUESTIONS ================= -->

        <div class="text-center py-5">

          <i class="fas fa-clipboard-question fa-4x text-muted mb-3"></i>

          <h5 class="fw-bold">
            No Questions Added
          </h5>

          <p class="text-muted">
            Add questions to this quiz before making it active.
          </p>

          <%= link_to new_teacher_panel_course_quiz_question_path(@course, @quiz),
    class: "btn btn-primary" do %>

  <i class="fas fa-plus me-1"></i>
  Add First Question

<% end %>

        </div>

      <% end %>

    </div>

  </div>


  <!-- ================= BOTTOM ACTIONS ================= -->

  <div class="d-flex justify-content-between align-items-center mt-4">

    <%= link_to teacher_panel_course_quizzes_path(@course),
        class: "btn btn-outline-secondary" do %>

      <i class="fas fa-arrow-left me-1"></i>
      Back to Quizzes

    <% end %>


    <div class="d-flex gap-2">

      <%= link_to edit_teacher_panel_course_quiz_path(@course, @quiz),
          class: "btn btn-primary" do %>

        <i class="fas fa-edit me-1">
        
        </i>
        Edit Quiz

      <% end %>


      <%= button_to teacher_panel_course_quiz_path(@course, @quiz),
          method: :delete,
          class: "btn btn-outline-danger",
          data: {
            turbo_confirm: "Are you sure you want to delete this quiz?"
          } do %>

        <i class="fas fa-trash me-1"></i>
        Delete Quiz

      <% end %>

    </div>

  </div>

</div>