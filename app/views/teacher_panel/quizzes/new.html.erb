<% content_for :hide_footer, true %>

<div class="teacher-new-quiz-page">

  <!-- =====================================================
       HEADER
  ====================================================== -->

  <div class="teacher-new-quiz-header">

    <div class="teacher-new-quiz-breadcrumb">

      <span>Teacher Panel</span>
      <i class="fas fa-chevron-right"></i>

      <span>Courses</span>
      <i class="fas fa-chevron-right"></i>

      <span>Quizzes</span>
      <i class="fas fa-chevron-right"></i>

      <span>New Quiz</span>

    </div>


    <h1>
      <i class="fas fa-plus-circle"></i>
      Create Quiz
    </h1>


    <p>
      Create a new quiz for
      <strong>
        <%= @course.Course_name %>
      </strong>.
    </p>

  </div>


  <!-- =====================================================
       FORM CARD
  ====================================================== -->

  <div class="teacher-quiz-form-card">


    <%= form_with model: [:teacher_panel, @course, @quiz],
                  url: teacher_panel_course_quizzes_path(@course),
                  method: :post,
                  local: true,
                  data: { quiz_form: true },
                  id: "teacherQuizForm" do |f| %>


      <!-- =================================================
           ERRORS
      ================================================== -->

      <% if @quiz.errors.any? %>

        <div class="quiz-form-errors">

          <div class="quiz-error-title">

            <i class="fas fa-exclamation-triangle"></i>

            <strong>
              Please fix the following:
            </strong>

          </div>


          <ul>

            <% @quiz.errors.full_messages.each do |message| %>

              <li>
                <%= message %>
              </li>

            <% end %>

          </ul>

        </div>

      <% end %>


      <!-- =================================================
           QUIZ TYPE
      ================================================== -->

      <div class="quiz-form-section">

        <div class="quiz-section-heading">

          <div class="quiz-section-icon">

            <i class="fas fa-layer-group"></i>

          </div>


          <div>

            <h2>
              Quiz Type
            </h2>

            <p>
              Choose whether this quiz belongs to the complete
              course or a specific video.
            </p>

          </div>

        </div>


        <div class="quiz-type-options">


          <!-- COURSE QUIZ -->

          <label class="quiz-type-card">

            <%= radio_button_tag(
                  :quiz_type,
                  "course",
                  @quiz.video_id.blank?,
                  id: "quiz_type_course"
                ) %>


            <div class="quiz-type-content">

              <div class="quiz-type-icon">

                <i class="fas fa-book-open"></i>

              </div>


              <div>

                <strong>
                  Course Quiz
                </strong>

                <span>
                  Quiz for the complete course.
                </span>

              </div>

            </div>

          </label>



          <!-- VIDEO QUIZ -->

          <label class="quiz-type-card">

            <%= radio_button_tag(
                  :quiz_type,
                  "video",
                  @quiz.video_id.present?,
                  id: "quiz_type_video"
                ) %>


            <div class="quiz-type-content">

              <div class="quiz-type-icon">

                <i class="fas fa-video"></i>

              </div>


              <div>

                <strong>
                  Video Quiz
                </strong>

                <span>
                  Quiz for a specific course video.
                </span>

              </div>

            </div>

          </label>


        </div>

      </div>


      <!-- =================================================
           VIDEO SELECTION
      ================================================== -->

      <div
        id="videoSelectionBox"
        class="quiz-form-section video-selection-section"
        style="<%= 'display:none;' if @quiz.video_id.blank? %>"
      >


        <div class="quiz-section-heading">

          <div class="quiz-section-icon video-icon">

            <i class="fas fa-video"></i>

          </div>


          <div>

            <h2>
              Video Selection
            </h2>

            <p>
              First select a playlist, then select a video
              from that playlist.
            </p>

          </div>

        </div>



        <!-- =================================================
             PLAYLIST
        ================================================== -->

        <div class="quiz-field">

          <label for="quiz_playlist_id">

            Playlist

            <span>
              *
            </span>

          </label>


          <select
            name="quiz_playlist_id"
            id="quiz_playlist_id"
            class="quiz-select"
          >

            <option value="">
              Select a playlist...
            </option>


            <% @playlists.each do |playlist| %>

              <option
                value="<%= playlist.id %>"
                <%= "selected" if @quiz.video&.playlist_id.to_s == playlist.id.to_s %>
              >
                <%= playlist.title %>
              </option>

            <% end %>

          </select>


          <small>
            Select the playlist containing the video.
          </small>

        </div>



        <!-- =================================================
             VIDEO
        ================================================== -->

        <div class="quiz-field">

          <label for="quiz_video_id">

            Video

            <span>
              *
            </span>

          </label>


          <select
            name="quiz[video_id]"
            id="quiz_video_id"
            class="quiz-select"
          >

            <option value="">
              Select a video...
            </option>


            <% @videos.each do |video| %>

              <option
                value="<%= video.id %>"
                data-playlist-id="<%= video.playlist_id %>"
                <%= "selected" if @quiz.video_id.to_s == video.id.to_s %>
              >

                <%= video.position %>.
                <%= video.title %>

              </option>

            <% end %>

          </select>


          <small>
            Only videos from the selected playlist will appear.
          </small>

        </div>



        <!-- =================================================
             SELECTED VIDEO INFO
        ================================================== -->

        <div
          id="selectedVideoInfo"
          class="selected-video-info"
          style="display:none;"
        >

          <i class="fas fa-circle-check"></i>

          <div>

            <strong>
              Video selected
            </strong>

            <span id="selectedVideoText"></span>

          </div>

        </div>


      </div>



      <!-- =================================================
           QUIZ INFORMATION
      ================================================== -->

      <div class="quiz-form-section">


        <div class="quiz-section-heading">

          <div class="quiz-section-icon">

            <i class="fas fa-info-circle"></i>

          </div>


          <div>

            <h2>
              Quiz Information
            </h2>

            <p>
              Enter the basic details of your quiz.
            </p>

          </div>

        </div>



        <!-- TITLE -->

        <div class="quiz-field">

          <%= f.label :title do %>

            Quiz Title

            <span>
              *
            </span>

          <% end %>


          <%= f.text_field :title,
                           class: "quiz-input",
                           placeholder: "Enter quiz title...",
                           required: true %>

        </div>



        <!-- DESCRIPTION -->

        <div class="quiz-field">

          <%= f.label :description do %>

            Description

          <% end %>


          <%= f.text_area :description,
                          class: "quiz-textarea",
                          rows: 5,
                          placeholder: "Enter quiz description..." %>

        </div>


      </div>



      <!-- =================================================
           QUIZ SETTINGS
      ================================================== -->

      <div class="quiz-form-section">


        <div class="quiz-section-heading">

          <div class="quiz-section-icon">

            <i class="fas fa-sliders-h"></i>

          </div>


          <div>

            <h2>
              Quiz Settings
            </h2>

            <p>
              Configure time limit, passing percentage and status.
            </p>

          </div>

        </div>



        <div class="quiz-settings-grid">


          <!-- TIME LIMIT -->

          <div class="quiz-field">

            <%= f.label :time_limit do %>

              Time Limit

              <span>
                *
              </span>

            <% end %>


            <div class="quiz-input-with-icon">

              <i class="fas fa-clock"></i>


              <%= f.number_field :time_limit,
                                 class: "quiz-input",
                                 min: 1,
                                 step: 1,
                                 value: @quiz.time_limit || 30,
                                 required: true %>

            </div>


            <small>
              Time in minutes.
            </small>

          </div>



          <!-- PASSING PERCENTAGE -->

          <div class="quiz-field">

            <%= f.label :passing_percentage do %>

              Passing Percentage

              <span>
                *
              </span>

            <% end %>


            <div class="quiz-input-with-icon">

              <i class="fas fa-percent"></i>


              <%= f.number_field :passing_percentage,
                                 class: "quiz-input",
                                 min: 0,
                                 max: 100,
                                 step: 1,
                                 value: @quiz.passing_percentage || 40,
                                 required: true %>

            </div>


            <small>
              Required percentage to pass.
            </small>

          </div>



          <!-- STATUS -->

          <div class="quiz-field">

            <%= f.label :status do %>

              Status

              <span>
                *
              </span>

            <% end %>


            <%= f.select :status,

                         [
                           ["Active", "Active"],
                           ["Inactive", "Inactive"]
                         ],

                         {},

                         class: "quiz-select" %>

          </div>


        </div>

      </div>



      <!-- =================================================
           ACTIONS
      ================================================== -->

      <div class="quiz-form-actions">


        <%= link_to teacher_panel_course_quizzes_path(@course),
                    class: "quiz-cancel-btn" do %>

          <i class="fas fa-times"></i>

          Cancel

        <% end %>



        <%= f.submit "Create Quiz",
                     class: "quiz-submit-btn",
                     id: "createQuizButton" %>


      </div>


    <% end %>

  </div>

</div>



<!-- =========================================================
     CSS
========================================================= -->

<style>


/* =========================================================
   PAGE
========================================================= */

.teacher-new-quiz-page {

  min-height: 100vh;

  padding: 30px;

  background:
    radial-gradient(
      circle at top right,
      rgba(124, 58, 237, .10),
      transparent 35%
    ),
    #f8fafc;

}



/* =========================================================
   HEADER
========================================================= */

.teacher-new-quiz-header {

  max-width: 1100px;

  margin: 0 auto 25px;

}


.teacher-new-quiz-breadcrumb {

  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 9px;

  margin-bottom: 10px;

  color: #64748b;

  font-size: 13px;

}


.teacher-new-quiz-breadcrumb i {

  color: #94a3b8;

  font-size: 10px;

}


.teacher-new-quiz-header h1 {

  margin: 0;

  color: #111827;

  font-size: 30px;

  font-weight: 800;

}


.teacher-new-quiz-header h1 i {

  margin-right: 10px;

  color: #7c3aed;

}


.teacher-new-quiz-header p {

  margin: 8px 0 0;

  color: #64748b;

  font-size: 14px;

}



/* =========================================================
   FORM CARD
========================================================= */

.teacher-quiz-form-card {

  max-width: 1100px;

  margin: 0 auto;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 20px;

  box-shadow:
    0 15px 40px rgba(15, 23, 42, .07);

  overflow: hidden;

}



/* =========================================================
   ERRORS
========================================================= */

.quiz-form-errors {

  margin: 25px 28px 0;

  padding: 16px 18px;

  background: #fef2f2;

  border: 1px solid #fecaca;

  border-radius: 12px;

  color: #991b1b;

}


.quiz-error-title {

  display: flex;

  align-items: center;

  gap: 8px;

}


.quiz-form-errors ul {

  margin: 10px 0 0;

  padding-left: 22px;

}



/* =========================================================
   SECTION
========================================================= */

.quiz-form-section {

  padding: 28px;

  border-bottom: 1px solid #e5e7eb;

}


.quiz-section-heading {

  display: flex;

  align-items: flex-start;

  gap: 13px;

  margin-bottom: 22px;

}


.quiz-section-icon {

  width: 42px;

  height: 42px;

  display: flex;

  align-items: center;

  justify-content: center;

  flex-shrink: 0;

  border-radius: 12px;

  background: #ede9fe;

  color: #7c3aed;

}


.quiz-section-icon.video-icon {

  background: #dbeafe;

  color: #2563eb;

}


.quiz-section-heading h2 {

  margin: 0 0 5px;

  color: #1e293b;

  font-size: 18px;

  font-weight: 800;

}


.quiz-section-heading p {

  margin: 0;

  color: #64748b;

  font-size: 13px;

}



/* =========================================================
   QUIZ TYPE
========================================================= */

.quiz-type-options {

  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 16px;

}


.quiz-type-card {

  position: relative;

  display: block;

  padding: 20px;

  border: 2px solid #e2e8f0;

  border-radius: 15px;

  background: #ffffff;

  cursor: pointer;

  transition: all .2s ease;

}


.quiz-type-card:hover {

  border-color: #c4b5fd;

  background: #faf8ff;

}


.quiz-type-card input {

  position: absolute;

  opacity: 0;

  pointer-events: none;

}


.quiz-type-card:has(input:checked) {

  border-color: #7c3aed;

  background: #faf5ff;

  box-shadow:
    0 5px 18px rgba(124, 58, 237, .10);

}


.quiz-type-content {

  display: flex;

  align-items: center;

  gap: 15px;

}


.quiz-type-icon {

  width: 45px;

  height: 45px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 12px;

  background: #ede9fe;

  color: #7c3aed;

  font-size: 18px;

}


.quiz-type-content strong {

  display: block;

  margin-bottom: 5px;

  color: #1e293b;

  font-size: 15px;

}


.quiz-type-content span {

  display: block;

  color: #64748b;

  font-size: 12px;

}



/* =========================================================
   VIDEO SELECTION
========================================================= */

.video-selection-section {

  background:
    linear-gradient(
      180deg,
      #fafbff,
      #ffffff
    );

}


.quiz-field {

  margin-bottom: 20px;

}


.quiz-field:last-child {

  margin-bottom: 0;

}


.quiz-field label {

  display: block;

  margin-bottom: 8px;

  color: #334155;

  font-size: 13px;

  font-weight: 700;

}


.quiz-field label span {

  color: #dc2626;

}


.quiz-input,
.quiz-select,
.quiz-textarea {

  width: 100%;

  box-sizing: border-box;

  border: 1px solid #cbd5e1;

  border-radius: 11px;

  background: #ffffff;

  color: #1e293b;

  font-size: 13px;

  outline: none;

  transition: all .2s ease;

}


.quiz-input,
.quiz-select {

  height: 47px;

  padding: 0 14px;

}


.quiz-textarea {

  padding: 13px 14px;

  resize: vertical;

}


.quiz-input:focus,
.quiz-select:focus,
.quiz-textarea:focus {

  border-color: #7c3aed;

  box-shadow:
    0 0 0 3px rgba(124, 58, 237, .10);

}


.quiz-field small {

  display: block;

  margin-top: 6px;

  color: #94a3b8;

  font-size: 11px;

}



/* =========================================================
   INPUT ICON
========================================================= */

.quiz-input-with-icon {

  position: relative;

}


.quiz-input-with-icon > i {

  position: absolute;

  left: 14px;

  top: 50%;

  transform: translateY(-50%);

  color: #7c3aed;

  z-index: 2;

}


.quiz-input-with-icon .quiz-input {

  padding-left: 40px;

}



/* =========================================================
   SELECTED VIDEO
========================================================= */

.selected-video-info {

  display: flex;

  align-items: center;

  gap: 12px;

  margin-top: 10px;

  padding: 13px 15px;

  border: 1px solid #bbf7d0;

  border-radius: 12px;

  background: #f0fdf4;

  color: #166534;

}


.selected-video-info > i {

  font-size: 18px;

}


.selected-video-info strong {

  display: block;

  margin-bottom: 2px;

  font-size: 13px;

}


.selected-video-info span {

  display: block;

  color: #15803d;

  font-size: 12px;

}



/* =========================================================
   SETTINGS
========================================================= */

.quiz-settings-grid {

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 18px;

}



/* =========================================================
   ACTIONS
========================================================= */

.quiz-form-actions {

  display: flex;

  justify-content: flex-end;

  align-items: center;

  gap: 12px;

  padding: 22px 28px;

  background: #fafafa;

}


.quiz-cancel-btn,
.quiz-submit-btn {

  min-height: 45px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  padding: 0 21px;

  border-radius: 11px;

  font-size: 13px;

  font-weight: 700;

  text-decoration: none;

  cursor: pointer;

  transition: all .2s ease;

}


.quiz-cancel-btn {

  border: 1px solid #d1d5db;

  background: #ffffff;

  color: #475569;

}


.quiz-cancel-btn:hover {

  background: #f8fafc;

  color: #1e293b;

}


.quiz-submit-btn {

  border: 0;

  background: #7c3aed;

  color: #ffffff;

  box-shadow:
    0 7px 18px rgba(124, 58, 237, .20);

}


.quiz-submit-btn:hover {

  background: #6d28d9;

  transform: translateY(-1px);

}



/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 750px) {

  .teacher-new-quiz-page {

    padding: 20px 15px;

  }


  .quiz-type-options,
  .quiz-settings-grid {

    grid-template-columns: 1fr;

  }


  .quiz-form-section {

    padding: 20px;

  }


  .quiz-form-actions {

    flex-direction: column;

    padding: 18px 20px;

  }


  .quiz-cancel-btn,
  .quiz-submit-btn {

    width: 100%;

  }

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

  function initializeQuizForm() {

    const form =
      document.getElementById("teacherQuizForm");

    const courseRadio =
      document.getElementById("quiz_type_course");

    const videoRadio =
      document.getElementById("quiz_type_video");

    const videoBox =
      document.getElementById("videoSelectionBox");

    const playlistSelect =
      document.getElementById("quiz_playlist_id");

    const videoSelect =
      document.getElementById("quiz_video_id");

    const selectedVideoInfo =
      document.getElementById("selectedVideoInfo");

    const selectedVideoText =
      document.getElementById("selectedVideoText");


    /*
     * Prevent duplicate event listeners
     */

    if (!form || form.dataset.initialized === "true") {

      return;

    }


    form.dataset.initialized = "true";


    /*
     * -----------------------------------------------------
     * GET ALL VIDEO OPTIONS
     * -----------------------------------------------------
     */

    const allVideoOptions =
      Array.from(
        videoSelect.querySelectorAll(
          "option[data-playlist-id]"
        )
      );


    /*
     * -----------------------------------------------------
     * LOAD VIDEOS
     * -----------------------------------------------------
     */

    function loadVideos(playlistId, selectedVideoId) {

      /*
       * Remove currently displayed video options
       */

      videoSelect
        .querySelectorAll("option[data-playlist-id]")
        .forEach(function (option) {

          option.remove();

        });


      /*
       * Reset selected value
       */

      videoSelect.value = "";


      /*
       * Hide selected video information
       */

      selectedVideoInfo.style.display = "none";

      selectedVideoText.textContent = "";


      /*
       * No playlist selected
       */

      if (!playlistId) {

        return;

      }


      /*
       * Add matching videos
       */

      allVideoOptions.forEach(function (originalOption) {

        const optionPlaylistId =
          String(
            originalOption.dataset.playlistId
          );


        if (
          optionPlaylistId ===
          String(playlistId)
        ) {

          const newOption =
            originalOption.cloneNode(true);


          /*
           * Select existing video when editing
           */

          if (
            selectedVideoId &&
            String(newOption.value) ===
            String(selectedVideoId)
          ) {

            newOption.selected = true;

          }


          videoSelect.appendChild(newOption);

        }

      });


      /*
       * Show selected video information
       */

      updateSelectedVideo();

    }


    /*
     * -----------------------------------------------------
     * SELECTED VIDEO
     * -----------------------------------------------------
     */

    function updateSelectedVideo() {

      const selectedOption =
        videoSelect.options[
          videoSelect.selectedIndex
        ];


      if (
        !videoSelect.value ||
        !selectedOption ||
        !selectedOption.value
      ) {

        selectedVideoInfo.style.display =
          "none";

        selectedVideoText.textContent =
          "";

        return;

      }


      selectedVideoText.textContent =
        selectedOption.textContent.trim();


      selectedVideoInfo.style.display =
        "flex";

    }


    /*
     * -----------------------------------------------------
     * QUIZ TYPE
     * -----------------------------------------------------
     */

    function updateQuizType() {

      const isVideoQuiz =
        videoRadio.checked;


      if (isVideoQuiz) {

        videoBox.style.display =
          "block";

        playlistSelect.required =
          true;

        videoSelect.required =
          true;


        /*
         * If a playlist is already selected,
         * load its videos.
         */

        if (playlistSelect.value) {

          const currentVideoId =
            videoSelect.value ||
            "<%= @quiz.video_id %>";

          loadVideos(
            playlistSelect.value,
            currentVideoId
          );

        }

      } else {

        videoBox.style.display =
          "none";

        playlistSelect.required =
          false;

        videoSelect.required =
          false;


        /*
         * Clear video when course quiz
         */

        playlistSelect.value = "";

        videoSelect.value = "";

        selectedVideoInfo.style.display =
          "none";

      }

    }


    /*
     * -----------------------------------------------------
     * COURSE QUIZ RADIO
     * -----------------------------------------------------
     */

    courseRadio.addEventListener(
      "change",
      function () {

        updateQuizType();

      }
    );


    /*
     * -----------------------------------------------------
     * VIDEO QUIZ RADIO
     * -----------------------------------------------------
     */

    videoRadio.addEventListener(
      "change",
      function () {

        updateQuizType();

      }
    );


    /*
     * -----------------------------------------------------
     * PLAYLIST CHANGE
     * -----------------------------------------------------
     */

    playlistSelect.addEventListener(
      "change",
      function () {

        loadVideos(
          this.value,
          ""
        );

      }
    );


    /*
     * -----------------------------------------------------
     * VIDEO CHANGE
     * -----------------------------------------------------
     */

    videoSelect.addEventListener(
      "change",
      function () {

        updateSelectedVideo();

      }
    );


    /*
     * -----------------------------------------------------
     * FORM SUBMIT
     * -----------------------------------------------------
     */

    form.addEventListener(
      "submit",
      function (event) {

        /*
         * Course quiz
         */

        if (courseRadio.checked) {

          /*
           * Make absolutely sure no video is sent.
           */

          videoSelect.value = "";

          return;

        }


        /*
         * Video quiz
         */

        if (videoRadio.checked) {


          if (!playlistSelect.value) {

            event.preventDefault();

            alert(
              "Please select a playlist."
            );

            playlistSelect.focus();

            return;

          }


          if (!videoSelect.value) {

            event.preventDefault();

            alert(
              "Please select a video."
            );

            videoSelect.focus();

            return;

          }


          /*
           * Verify selected video belongs
           * to selected playlist.
           */

          const selectedOption =
            videoSelect.options[
              videoSelect.selectedIndex
            ];


          if (!selectedOption) {

            event.preventDefault();

            alert(
              "Please select a valid video."
            );

            videoSelect.focus();

            return;

          }


          const videoPlaylistId =
            selectedOption.dataset.playlistId;


          if (
            String(videoPlaylistId) !==
            String(playlistSelect.value)
          ) {

            event.preventDefault();

            alert(
              "Selected video does not belong to the selected playlist."
            );

            videoSelect.focus();

            return;

          }


          console.log(
            "QUIZ SUBMIT:",
            {
              quiz_type: "video",
              playlist_id: playlistSelect.value,
              video_id: videoSelect.value
            }
          );

        }

      }
    );


    /*
     * -----------------------------------------------------
     * INITIAL PAGE LOAD
     * -----------------------------------------------------
     */

    updateQuizType();

  }


  /*
   * Turbo navigation
   */

  document.addEventListener(
    "turbo:load",
    initializeQuizForm
  );


  /*
   * Normal browser load
   */

  document.addEventListener(
    "DOMContentLoaded",
    initializeQuizForm
  );


})();

</script>