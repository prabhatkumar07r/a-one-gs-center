<% content_for :show_layout, true %>

<style>
/* =========================================================
   TEACHER PANEL - CREATE QUIZ
   Modern Glass / Purple Gradient UI
========================================================= */

.teacher-new-quiz-page {
  min-height: 100vh;
  padding: 30px;
  background:
    radial-gradient(
      circle at top left,
      rgba(99, 102, 241, .35),
      transparent 30%
    ),
    radial-gradient(
      circle at bottom right,
      rgba(168, 85, 247, .28),
      transparent 32%
    ),
    linear-gradient(
      135deg,
      #080d1c,
      #11182d 55%,
      #0b1020
    );
  color: #fff;
}

.new-quiz-container {
  width: 100%;
  max-width: 1050px;
  margin: 0 auto;
}

/* =========================================================
   TOP NAVIGATION
========================================================= */

.quiz-top-navigation {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
}

.quiz-breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  color: #94a3b8;
  font-size: 12px;
}

.quiz-breadcrumb i {
  color: #818cf8;
}

.quiz-breadcrumb strong {
  color: #e2e8f0;
}

.quiz-back-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 15px;
  border-radius: 11px;
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.06);
  color: #e2e8f0;
  text-decoration: none;
  font-size: 13px;
  font-weight: 700;
  transition: .25s ease;
}

.quiz-back-btn:hover {
  color: #fff;
  background: rgba(255,255,255,.11);
  border-color: rgba(129,140,248,.35);
  transform: translateY(-2px);
}

/* =========================================================
   HEADER
========================================================= */

.new-quiz-header {
  position: relative;
  overflow: hidden;
  padding: 28px 30px;
  margin-bottom: 22px;
  border-radius: 22px;

  background:
    linear-gradient(
      135deg,
      rgba(79,70,229,.28),
      rgba(124,58,237,.15)
    );

  border: 1px solid rgba(255,255,255,.10);

  box-shadow:
    0 20px 55px rgba(0,0,0,.30);
}

.new-quiz-header::before {
  content: "";
  position: absolute;
  width: 220px;
  height: 220px;
  right: -90px;
  top: -120px;
  border-radius: 50%;
  background: rgba(129,140,248,.12);
}

.new-quiz-header-content {
  position: relative;
  z-index: 2;
}

.new-quiz-icon {
  width: 55px;
  height: 55px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 15px;

  border-radius: 16px;

  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.12);

  color: #a5b4fc;
  font-size: 23px;
}

.new-quiz-header h2 {
  margin: 0 0 7px;
  color: #fff;
  font-size: 27px;
  font-weight: 800;
  letter-spacing: -.4px;
}

.new-quiz-header p {
  margin: 0;
  color: #94a3b8;
  font-size: 14px;
}

.course-highlight {
  color: #c4b5fd;
  font-weight: 800;
}

/* =========================================================
   FORM CARD
========================================================= */

.quiz-form-card {
  padding: 30px;

  border-radius: 22px;

  background:
    rgba(15,23,42,.78);

  border: 1px solid rgba(255,255,255,.08);

  box-shadow:
    0 20px 60px rgba(0,0,0,.30);
}

/* =========================================================
   ERRORS
========================================================= */

.quiz-errors {
  margin-bottom: 25px;
  padding: 17px;

  border-radius: 14px;

  background: rgba(239,68,68,.10);
  border: 1px solid rgba(239,68,68,.20);

  color: #fecaca;
}

.quiz-errors h6 {
  margin-bottom: 10px;
  color: #fca5a5;
  font-weight: 800;
}

.quiz-errors ul {
  margin: 0;
  padding-left: 20px;
}

.quiz-errors li {
  margin-bottom: 4px;
  font-size: 13px;
}

/* =========================================================
   FORM SECTION
========================================================= */

.form-section {
  margin-bottom: 32px;
}

.form-section:last-child {
  margin-bottom: 0;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 9px;

  margin-bottom: 18px;
  padding-bottom: 11px;

  border-bottom: 1px solid rgba(255,255,255,.07);

  color: #f8fafc;
  font-size: 17px;
  font-weight: 800;
}

.section-title i {
  color: #a5b4fc;
}

/* =========================================================
   LABEL
========================================================= */

.quiz-label {
  display: block;
  margin-bottom: 8px;

  color: #e2e8f0;
  font-size: 13px;
  font-weight: 700;
}

.required-star {
  color: #fbbf24;
}

/* =========================================================
   INPUTS
========================================================= */

.quiz-input,
.quiz-select,
.quiz-textarea {
  width: 100%;

  padding: 12px 14px;

  border-radius: 12px;

  border: 1px solid rgba(255,255,255,.10);

  background: rgba(255,255,255,.96);

  color: #111827;

  outline: none;

  transition: .2s ease;
}

.quiz-input::placeholder,
.quiz-textarea::placeholder {
  color: #94a3b8;
}

.quiz-input:focus,
.quiz-select:focus,
.quiz-textarea:focus {
  background: #fff;

  border-color: #818cf8;

  box-shadow:
    0 0 0 4px rgba(99,102,241,.15);
}

.quiz-textarea {
  min-height: 120px;
  resize: vertical;
}

.field-help {
  margin-top: 6px;

  color: #64748b;
  font-size: 11px;
}

/* =========================================================
   QUIZ TYPE
========================================================= */

.quiz-type-wrapper {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 13px;
}

.quiz-type-option {
  position: relative;
}

.quiz-type-option input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.quiz-type-label {
  display: block;

  min-height: 150px;

  padding: 19px;

  cursor: pointer;

  border-radius: 16px;

  background: rgba(255,255,255,.035);

  border: 1px solid rgba(255,255,255,.08);

  transition: .25s ease;
}

.quiz-type-label:hover {
  transform: translateY(-2px);

  background: rgba(255,255,255,.065);

  border-color: rgba(129,140,248,.25);
}

.quiz-type-option input:checked + .quiz-type-label {
  background:
    linear-gradient(
      135deg,
      rgba(99,102,241,.18),
      rgba(168,85,247,.12)
    );

  border-color: rgba(129,140,248,.55);

  box-shadow:
    0 10px 30px rgba(99,102,241,.12);
}

.quiz-type-icon {
  display: block;

  margin-bottom: 12px;

  color: #a5b4fc;
  font-size: 25px;
}

.quiz-type-title {
  display: block;

  margin-bottom: 6px;

  color: #f8fafc;
  font-size: 14px;
  font-weight: 800;
}

.quiz-type-description {
  display: block;

  color: #64748b;

  font-size: 11px;
  line-height: 1.5;
}

/* =========================================================
   CONDITIONAL SELECTION BOX
========================================================= */

.quiz-selection-box {
  margin-top: 16px;

  padding: 20px;

  border-radius: 16px;

  background: rgba(255,255,255,.035);

  border: 1px solid rgba(255,255,255,.08);

  animation: quizFadeIn .22s ease;
}

.quiz-selection-box.hidden {
  display: none;
}

.selection-heading {
  display: flex;
  align-items: center;
  gap: 9px;

  margin-bottom: 14px;

  color: #c7d2fe;

  font-size: 13px;
  font-weight: 800;
}

.selection-heading i {
  color: #818cf8;
}

/* =========================================================
   STATUS
========================================================= */

.status-box {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.status-option input {
  position: absolute;
  opacity: 0;
}

.status-label {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  padding: 13px;

  cursor: pointer;

  border-radius: 12px;

  background: rgba(255,255,255,.035);

  border: 1px solid rgba(255,255,255,.08);

  color: #cbd5e1;

  font-size: 13px;
  font-weight: 700;

  transition: .2s ease;
}

.status-label:hover {
  background: rgba(255,255,255,.07);
}

.status-option input:checked + .status-label {
  background: rgba(34,197,94,.10);
  border-color: rgba(34,197,94,.30);
  color: #86efac;
}

/* =========================================================
   ACTIONS
========================================================= */

.form-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;

  padding-top: 24px;

  border-top: 1px solid rgba(255,255,255,.07);
}

.btn-cancel-quiz,
.btn-save-quiz {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  padding: 12px 20px;

  border-radius: 12px;

  font-size: 13px;
  font-weight: 800;

  transition: .25s ease;
}

.btn-cancel-quiz {
  color: #cbd5e1;

  text-decoration: none;

  background: rgba(255,255,255,.05);

  border: 1px solid rgba(255,255,255,.10);
}

.btn-cancel-quiz:hover {
  color: #fff;

  background: rgba(255,255,255,.09);

  transform: translateY(-2px);
}

.btn-save-quiz {
  border: 0;

  background:
    linear-gradient(
      135deg,
      #6366f1,
      #8b5cf6
    );

  color: #fff;

  box-shadow:
    0 10px 25px rgba(99,102,241,.25);

  cursor: pointer;
}

.btn-save-quiz:hover {
  transform: translateY(-2px);

  box-shadow:
    0 15px 32px rgba(99,102,241,.35);
}

/* =========================================================
   ANIMATION
========================================================= */

@keyframes quizFadeIn {

  from {
    opacity: 0;
    transform: translateY(-5px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }

}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 991px) {

  .teacher-new-quiz-page {
    padding: 22px;
  }

  .quiz-type-wrapper {
    grid-template-columns: 1fr;
  }

}

@media (max-width: 767px) {

  .teacher-new-quiz-page {
    padding: 15px;
  }

  .quiz-form-card,
  .new-quiz-header {
    padding: 20px;

    border-radius: 18px;
  }

  .quiz-top-navigation {
    flex-direction: column;
    align-items: stretch;
  }

  .quiz-back-btn {
    width: 100%;
  }

  .new-quiz-header h2 {
    font-size: 23px;
  }

  .status-box {
    grid-template-columns: 1fr;
  }

  .form-actions {
    flex-direction: column-reverse;
  }

  .btn-cancel-quiz,
  .btn-save-quiz {
    width: 100%;
  }

}
</style>


<div class="teacher-new-quiz-page">

  <div class="new-quiz-container">


    <!-- =====================================================
         TOP NAVIGATION
    ====================================================== -->

    <div class="quiz-top-navigation">

      <div class="quiz-breadcrumb">

        <i class="fas fa-chalkboard-teacher"></i>

        <span>Teacher Panel</span>

        <i class="fas fa-chevron-right"></i>

        <span>Courses</span>

        <i class="fas fa-chevron-right"></i>

        <span>
          <%= @course.Course_name %>
        </span>

        <i class="fas fa-chevron-right"></i>

        <strong>
          Create Quiz
        </strong>

      </div>


      <%= link_to teacher_panel_course_quizzes_path(@course),
                  class: "quiz-back-btn" do %>

        <i class="fas fa-arrow-left"></i>

        Back to Quizzes

      <% end %>

    </div>


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="new-quiz-header">

      <div class="new-quiz-header-content">

        <div class="new-quiz-icon">

          <i class="fas fa-clipboard-question"></i>

        </div>

        <h2>
          Create New Quiz
        </h2>

        <p>

          Create and configure a quiz for

          <span class="course-highlight">
            <%= @course.Course_name %>
          </span>

        </p>

      </div>

    </div>


    <!-- =====================================================
         FORM CARD
    ====================================================== -->

    <div class="quiz-form-card">


      <!-- ===================================================
           ERRORS
      ==================================================== -->

      <% if @quiz.errors.any? %>

        <div class="quiz-errors">

          <h6>

            <i class="fas fa-circle-exclamation me-2"></i>

            Please fix the following errors

          </h6>

          <ul>

            <% @quiz.errors.full_messages.each do |message| %>

              <li>
                <%= message %>
              </li>

            <% end %>

          </ul>

        </div>

      <% end %>


      <%= form_with model: [:teacher_panel, @course, @quiz],
                    local: true do |f| %>


        <!-- =================================================
             BASIC INFORMATION
        ================================================== -->

        <div class="form-section">

          <div class="section-title">

            <i class="fas fa-circle-info"></i>

            Basic Information

          </div>


          <!-- TITLE -->

          <div class="mb-4">

            <%= f.label :title, class: "quiz-label" do %>

              Quiz Title

              <span class="required-star">
                *
              </span>

            <% end %>


            <%= f.text_field :title,

                class: "quiz-input",

                placeholder: "Example: HTML & CSS Fundamentals Quiz",

                required: true %>

          </div>


          <!-- DESCRIPTION -->

          <div>

            <%= f.label :description,
                        "Description",
                        class: "quiz-label" %>


            <%= f.text_area :description,

                class: "quiz-textarea",

                placeholder:
                  "Enter quiz instructions, topics covered, or student instructions..." %>

          </div>

        </div>


        <!-- =================================================
             QUIZ TYPE
        ================================================== -->

        <div class="form-section">

          <div class="section-title">

            <i class="fas fa-layer-group"></i>

            Quiz Type

          </div>


          <div class="quiz-type-wrapper">


            <!-- =================================================
                 COURSE LEVEL
            ================================================== -->

            <div class="quiz-type-option">

              <input type="radio"
                     name="quiz_type"
                     id="course_level_quiz"
                     value="course"
                     <%= "checked" if
                         @quiz.video_id.blank? &&
                         @quiz.test_series_id.blank? %>>


              <label for="course_level_quiz"
                     class="quiz-type-label">

                <span class="quiz-type-icon">

                  <i class="fas fa-graduation-cap"></i>

                </span>

                <span class="quiz-type-title">

                  Course Level Quiz

                </span>

                <span class="quiz-type-description">

                  A general quiz covering the complete course.

                </span>

              </label>

            </div>


            <!-- =================================================
                 VIDEO QUIZ
            ================================================== -->

            <div class="quiz-type-option">

              <input type="radio"
                     name="quiz_type"
                     id="video_level_quiz"
                     value="video"
                     <%= "checked" if @quiz.video_id.present? %>>


              <label for="video_level_quiz"
                     class="quiz-type-label">

                <span class="quiz-type-icon">

                  <i class="fas fa-video"></i>

                </span>

                <span class="quiz-type-title">

                  Video-wise Quiz

                </span>

                <span class="quiz-type-description">

                  Attach this quiz to one specific course video.

                </span>

              </label>

            </div>


            <!-- =================================================
                 TEST SERIES
            ================================================== -->

            <div class="quiz-type-option">

              <input type="radio"
                     name="quiz_type"
                     id="test_series_quiz"
                     value="test_series"
                     <%= "checked" if @quiz.test_series_id.present? %>>


              <label for="test_series_quiz"
                     class="quiz-type-label">

                <span class="quiz-type-icon">

                  <i class="fas fa-layer-group"></i>

                </span>

                <span class="quiz-type-title">

                  Test Series Quiz

                </span>

                <span class="quiz-type-description">

                  Add this quiz to an existing test series.

                </span>

              </label>

            </div>

          </div>


          <!-- =================================================
               VIDEO SELECTION
          ================================================== -->

          <div id="videoSelectionBox"
               class="quiz-selection-box
               <%= "hidden" if @quiz.video_id.blank? %>">

            <div class="selection-heading">

              <i class="fas fa-video"></i>

              Select Video

            </div>


            <%= f.collection_select :video_id,

                                    @videos,

                                    :id,

                                    :title,

                                    {
                                      include_blank:
                                        "Select a video..."
                                    },

                                    {
                                      class: "quiz-select",
                                      id: "quiz_video_id"
                                    } %>


            <div class="field-help">

              <i class="fas fa-circle-info me-1"></i>

              The quiz will be available after the selected video.

            </div>

          </div>


          <!-- =================================================
               TEST SERIES SELECTION
          ================================================== -->

          <div id="testSeriesSelectionBox"
               class="quiz-selection-box
               <%= "hidden" if @quiz.test_series_id.blank? %>">

            <div class="selection-heading">

              <i class="fas fa-layer-group"></i>

              Select Test Series

            </div>


            <%= f.collection_select :test_series_id,

                                    @test_series,

                                    :id,

                                    :title,

                                    {
                                      include_blank:
                                        "Select a test series..."
                                    },

                                    {
                                      class: "quiz-select",
                                      id: "quiz_test_series_id"
                                    } %>


            <div class="field-help">

              <i class="fas fa-circle-info me-1"></i>

              This quiz will appear under the selected test series.

            </div>

          </div>

        </div>


        <!-- =================================================
             QUIZ SETTINGS
        ================================================== -->

        <div class="form-section">

          <div class="section-title">

            <i class="fas fa-sliders"></i>

            Quiz Settings

          </div>


          <div class="row g-4">


            <!-- TIME LIMIT -->

            <div class="col-md-6">

              <%= f.label :time_limit,
                          class: "quiz-label" do %>

                Time Limit

                <span class="required-star">
                  *
                </span>

              <% end %>


              <%= f.number_field :time_limit,

                  class: "quiz-input",

                  min: 1,

                  placeholder: "30",

                  required: true %>


              <div class="field-help">

                <i class="fas fa-clock me-1"></i>

                Time limit in minutes.

              </div>

            </div>


            <!-- PASSING PERCENTAGE -->

            <div class="col-md-6">

              <%= f.label :passing_percentage,
                          class: "quiz-label" do %>

                Passing Percentage

                <span class="required-star">
                  *
                </span>

              <% end %>


              <%= f.number_field :passing_percentage,

                  class: "quiz-input",

                  min: 0,

                  max: 100,

                  step: 1,

                  placeholder: "40",

                  required: true %>


              <div class="field-help">

                <i class="fas fa-percent me-1"></i>

                Minimum percentage required to pass.

              </div>

            </div>

          </div>

        </div>


        <!-- =================================================
             STATUS
        ================================================== -->

        <div class="form-section">

          <div class="section-title">

            <i class="fas fa-toggle-on"></i>

            Quiz Status

          </div>


          <div class="status-box">


            <!-- ACTIVE -->

            <div class="status-option">

              <%= f.radio_button :status,

                                 "Active",

                                 checked: (

                                   @quiz.status.blank? ||
                                   @quiz.status == "Active"

                                 ) %>


              <%= f.label :status_active,
                          class: "status-label" do %>

                <i class="fas fa-check-circle"></i>

                Active

              <% end %>

            </div>


            <!-- INACTIVE -->

            <div class="status-option">

              <%= f.radio_button :status,
                                 "Inactive" %>


              <%= f.label :status_inactive,
                          class: "status-label" do %>

                <i class="fas fa-pause-circle"></i>

                Inactive

              <% end %>

            </div>

          </div>

        </div>


        <!-- =================================================
             ACTIONS
        ================================================== -->

        <div class="form-actions">


          <%= link_to teacher_panel_course_quizzes_path(@course),

                      class: "btn-cancel-quiz" do %>

            <i class="fas fa-arrow-left"></i>

            Cancel

          <% end %>


          <%= f.button type: "submit",

                       class: "btn-save-quiz" do %>

            <i class="fas fa-save"></i>

            Create Quiz

          <% end %>

        </div>


      <% end %>

    </div>

  </div>

</div>


<!-- =========================================================
     QUIZ TYPE JAVASCRIPT
========================================================= -->

<script>
document.addEventListener("DOMContentLoaded", function () {

  const courseRadio =
    document.getElementById("course_level_quiz");

  const videoRadio =
    document.getElementById("video_level_quiz");

  const testSeriesRadio =
    document.getElementById("test_series_quiz");

  const videoBox =
    document.getElementById("videoSelectionBox");

  const testSeriesBox =
    document.getElementById("testSeriesSelectionBox");

  const videoSelect =
    document.getElementById("quiz_video_id");

  const testSeriesSelect =
    document.getElementById("quiz_test_series_id");


  function updateQuizType() {

    /* =====================================================
       VIDEO QUIZ
    ====================================================== */

    if (videoRadio && videoRadio.checked) {

      videoBox.classList.remove("hidden");

      testSeriesBox.classList.add("hidden");


      if (videoSelect) {
        videoSelect.required = true;
      }

      if (testSeriesSelect) {
        testSeriesSelect.required = false;
        testSeriesSelect.value = "";
      }

      return;
    }


    /* =====================================================
       TEST SERIES QUIZ
    ====================================================== */

    if (testSeriesRadio && testSeriesRadio.checked) {

      testSeriesBox.classList.remove("hidden");

      videoBox.classList.add("hidden");


      if (testSeriesSelect) {
        testSeriesSelect.required = true;
      }

      if (videoSelect) {
        videoSelect.required = false;
        videoSelect.value = "";
      }

      return;
    }


    /* =====================================================
       COURSE LEVEL QUIZ
    ====================================================== */

    videoBox.classList.add("hidden");

    testSeriesBox.classList.add("hidden");


    if (videoSelect) {
      videoSelect.required = false;
      videoSelect.value = "";
    }

    if (testSeriesSelect) {
      testSeriesSelect.required = false;
      testSeriesSelect.value = "";
    }

  }


  if (courseRadio) {
    courseRadio.addEventListener(
      "change",
      updateQuizType
    );
  }


  if (videoRadio) {
    videoRadio.addEventListener(
      "change",
      updateQuizType
    );
  }


  if (testSeriesRadio) {
    testSeriesRadio.addEventListener(
      "change",
      updateQuizType
    );
  }


  updateQuizType();

});
</script>