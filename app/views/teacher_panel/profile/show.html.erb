<style>
/* =========================================================
   A ONE GS CENTER
   TEACHER PROFILE
   Clean modern dashboard style
========================================================= */

.teacher-profile-page {
  min-height: 100vh;
  padding: 30px;
  background: #f6f7fb;
  color: #1f2937;
}


/* =========================================================
   PROFILE HEADER
========================================================= */

.teacher-profile-card {
  background: #ffffff;
  border: 1px solid #e8eaf0;
  border-radius: 22px;
  padding: 32px;
  box-shadow: 0 8px 28px rgba(31, 41, 55, 0.06);
}

.teacher-profile-header {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-bottom: 30px;
}


/* =========================================================
   AVATAR
========================================================= */

.teacher-profile-avatar {
