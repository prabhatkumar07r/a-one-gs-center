  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f5f3ff, #ede9fe);
  color: #7c3aed;
  font-size: 48px;
}


/* =========================================================
   PROFILE INFORMATION
========================================================= */

.teacher-profile-info {
  flex: 1;
