<style>
/* =========================================================
   TEACHER PROFILE PAGE
   Scoped styles - does not affect other application pages
========================================================= */

.teacher-profile-page {
  background: #0b1020;
  min-height: 100vh;
  padding: 35px;
  color: #1f2937;
}


/* =========================================================
   PROFILE HEADER CARD
========================================================= */

.teacher-profile-card {
  background: #121722;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 22px;
  padding: 35px;
  box-shadow: 0 10px 30px rgba(0,0,0,.35);
}

.teacher-profile-header {
  display: flex;
  align-items: center;
  gap: 35px;
  margin-bottom: 35px;
}


/* Avatar */

.teacher-profile-avatar {
  width: 170px;
  height: 170px;
  min-width: 170px;
  border-radius: 50%;
  overflow: hidden;
  border: 5px solid #7c3aed;
  box-shadow: 0 15px 35px rgba(124,58,237,.35);
}

.teacher-profile-avatar .avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.teacher-profile-avatar .default-avatar {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e5e7eb;
  color: #64748b;
  font-size: 45px;
}


/* Profile information */

.teacher-profile-info {
  flex: 1;
  min-width: 0;
}

.teacher-profile-info h2 {
  color: #fff;
  font-size: 38px;
  font-weight: 700;
  margin: 0 0 10px;
  word-break: break-word;
}

.teacher-profile-role {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 12px;
  padding: 5px 10px;
  border-radius: 20px;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 12px;
  font-weight: 600;
}

.teacher-profile-info p {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #cbd5e1;
  margin: 0 0 8px;
  font-size: 15px;
}

.teacher-profile-info p i {
  color: #a78bfa;
}


/* =========================================================
   STATISTICS
========================================================= */

.teacher-profile-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.teacher-profile-stat {
  background: #191f2d;
  border-radius: 18px;
  padding: 28px 20px;
  text-align: center;
  border-bottom: 3px solid #7c3aed;
  transition: .3s ease;
}

.teacher-profile-stat:hover {
  transform: translateY(-5px);
}

.teacher-profile-stat h3 {
  color: #fff;
  font-size: 40px;
  font-weight: 700;
  margin: 0 0 5px;
}

.teacher-profile-stat span {
  color: #a1a1aa;
  font-size: 15px;
}


/* =========================================================
   TABS
========================================================= */

.teacher-profile-tabs {
  display: flex;
  gap: 12px;
  margin: 30px 0;
  padding: 12px;
  background: #121722;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,.06);
  overflow-x: auto;
}

.teacher-profile-tab-btn {
  flex: 0 0 auto;
  border: none;
  background: transparent;
  color: #a1a1aa;
  padding: 13px 22px;
  border-radius: 14px;
  font-weight: 600;
  transition: .3s;
  cursor: pointer;
  white-space: nowrap;
}

.teacher-profile-tab-btn:hover {
  color: #fff;
  background: #1f2937;
}

.teacher-profile-tab-btn.active {
  background: #7c3aed;
  color: #fff;
}


/* Tab content */

.teacher-profile-tab-content {
  margin-top: 20px;
}

.teacher-profile-tab-pane {
  display: none;
}

.teacher-profile-tab-pane.active {
  display: block;
}


/* =========================================================
   SECTION HEADING
========================================================= */

.teacher-profile-section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 25px;
}

.teacher-profile-section-heading h3 {
  margin: 0;
  font-size: 22px;
  font-weight: 700;
  color: #fff;
}

.teacher-profile-section-heading h3 i {
  margin-right: 8px;
}

.teacher-profile-section-heading p {
  margin: 6px 0 0;
  color: #9ca3af;
  font-size: 14px;
}

.teacher-profile-section-count {
  padding: 7px 14px;
  border-radius: 20px;
  background: #1f2937;
  color: #cbd5e1;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
}


/* =========================================================
   OVERVIEW
========================================================= */

.teacher-profile-overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px;
}

.teacher-profile-overview-card {
  background: #121722;
  padding: 28px;
  border-radius: 20px;
  border: 1px solid rgba(255,255,255,.08);
}

.teacher-profile-overview-card h4 {
  color: #fff;
  margin: 0 0 20px;
  font-weight: 700;
}

.teacher-profile-table {
  margin: 0;
}

.teacher-profile-table th {
  width: 160px;
  color: #9ca3af;
  font-weight: 600;
  background: transparent;
}

.teacher-profile-table td {
  color: #e5e7eb;
  background: transparent;
}

.teacher-profile-table th,
.teacher-profile-table td {
  border: none;
  padding: 10px 5px;
}

.teacher-profile-summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 0;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.teacher-profile-summary-item:last-child {
  border-bottom: none;
}

.teacher-profile-summary-item span {
  color: #cbd5e1;
}

.teacher-profile-summary-item strong {
  color: #a78bfa;
  font-size: 22px;
}


/* =========================================================
   COURSES
========================================================= */

.teacher-profile-course-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.teacher-profile-course-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.teacher-profile-course-card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  overflow: hidden;
  transition: .25s ease;
  height: 100%;
}

.teacher-profile-course-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 30px rgba(0,0,0,.15);
}

.teacher-profile-course-cover {
  width: 100%;
  height: 180px;
  object-fit: cover;
  display: block;
}

.teacher-profile-course-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  color: #64748b;
  font-size: 42px;
}

.teacher-profile-course-body {
  padding: 18px;
}

.teacher-profile-course-body h4 {
  margin: 0 0 9px;
  font-size: 18px;
  font-weight: 700;
  color: #1f2937;
}

.teacher-profile-course-description {
  margin: 0 0 15px;
  color: #6b7280;
  font-size: 14px;
  line-height: 1.6;
}

.teacher-profile-course-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  padding-top: 14px;
  border-top: 1px solid #eef0f2;
}

.teacher-profile-course-meta span {
  font-size: 13px;
  color: #64748b;
}

.teacher-profile-course-meta i {
  margin-right: 5px;
}

.teacher-profile-course-view {
  margin-top: 15px;
  color: #4f46e5;
  font-weight: 600;
  font-size: 14px;
}


/* =========================================================
   STUDENTS
========================================================= */

.teacher-profile-students-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.teacher-profile-student-card {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 18px;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  transition: .25s ease;
}

.teacher-profile-student-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 22px rgba(0,0,0,.07);
}

.teacher-profile-student-avatar {
  width: 52px;
  height: 52px;
  min-width: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 23px;
}

.teacher-profile-student-info {
  min-width: 0;
}

.teacher-profile-student-info h4 {
  margin: 0 0 5px;
  font-size: 16px;
  font-weight: 700;
  color: #1f2937;
}

.teacher-profile-student-info p {
  margin: 0;
  color: #6b7280;
  font-size: 13px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


/* =========================================================
   RESOURCES
========================================================= */

.teacher-profile-resource-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.teacher-profile-resource-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 18px 20px;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  transition: .25s ease;
}

.teacher-profile-resource-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(0,0,0,.07);
}

.teacher-profile-resource-icon {
  width: 50px;
  height: 50px;
  min-width: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: #f1f5f9;
  color: #475569;
  font-size: 22px;
}

.teacher-profile-resource-info {
  flex: 1;
  min-width: 0;
}

.teacher-profile-resource-info h4 {
  margin: 0 0 6px;
  font-size: 16px;
  font-weight: 700;
  color: #1f2937;
}

.teacher-profile-resource-description {
  margin: 0 0 8px;
  color: #6b7280;
  font-size: 13px;
}

.teacher-profile-resource-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  margin: 0;
  color: #64748b;
  font-size: 12px;
}

.teacher-profile-resource-action {
  flex-shrink: 0;
}

.teacher-profile-resource-view {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 14px;
  border-radius: 8px;
  background: #f8fafc;
  color: #334155;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  border: 1px solid #e2e8f0;
  transition: .2s ease;
}

.teacher-profile-resource-view:hover {
  background: #e2e8f0;
  color: #111827;
}

.teacher-profile-resource-unavailable {
  font-size: 12px;
  color: #9ca3af;
}


/* =========================================================
   ACTIVITY
========================================================= */

.teacher-profile-activity-timeline {
  position: relative;
  margin-top: 10px;
  padding-left: 8px;
}

.teacher-profile-activity-timeline::before {
  content: "";
  position: absolute;
  top: 10px;
  bottom: 10px;
  left: 30px;
  width: 2px;
  background: #e5e7eb;
}

.teacher-profile-activity-item {
  position: relative;
  display: flex;
  gap: 18px;
  padding-bottom: 28px;
}

.teacher-profile-activity-icon {
  position: relative;
  z-index: 2;
  width: 46px;
  height: 46px;
  min-width: 46px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff;
  border: 2px solid #e5e7eb;
  font-size: 18px;
}

.teacher-profile-course-icon {
  color: #4f46e5;
}

.teacher-profile-playlist-icon {
  color: #0891b2;
}

.teacher-profile-video-icon {
  color: #dc2626;
}

.teacher-profile-resource-icon-color {
  color: #059669;
}

.teacher-profile-activity-content {
  flex: 1;
  padding-top: 2px;
}

.teacher-profile-activity-content h4 {
  margin: 0 0 6px;
  font-size: 16px;
  font-weight: 700;
  color: #1f2937;
}

.teacher-profile-activity-content p {
  margin: 0 0 8px;
  color: #6b7280;
  font-size: 14px;
  line-height: 1.5;
}

.teacher-profile-activity-time {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #9ca3af;
  font-size: 12px;
}


/* =========================================================
   EMPTY STATE
========================================================= */

.teacher-profile-empty-state {
  text-align: center;
  padding: 60px 20px;
  background: #fff;
  border: 1px dashed #d1d5db;
  border-radius: 16px;
}

.teacher-profile-empty-state i {
  font-size: 42px;
  color: #94a3b8;
}

.teacher-profile-empty-state h4 {
  margin: 15px 0 5px;
  font-weight: 700;
  color: #1f2937;
}

.teacher-profile-empty-state p {
  margin: 0;
  color: #6b7280;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 992px) {

  .teacher-profile-page {
    padding: 25px;
  }

  .teacher-profile-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .teacher-profile-overview-grid {
    grid-template-columns: 1fr;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

  .teacher-profile-page {
    padding: 15px;
  }

  .teacher-profile-card {
    padding: 20px;
    border-radius: 16px;
  }

  .teacher-profile-header {
    flex-direction: column;
    text-align: center;
    gap: 20px;
  }

  .teacher-profile-avatar {
    width: 130px;
    height: 130px;
    min-width: 130px;
  }

  .teacher-profile-info h2 {
    font-size: 28px;
  }

  .teacher-profile-info p {
    justify-content: center;
    font-size: 14px;
  }

  .teacher-profile-stats {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .teacher-profile-stat {
    padding: 20px 10px;
  }

  .teacher-profile-stat h3 {
    font-size: 30px;
  }

  .teacher-profile-stat span {
    font-size: 13px;
  }

  .teacher-profile-tabs {
    margin: 20px 0;
    gap: 6px;
    padding: 8px;
  }

  .teacher-profile-tab-btn {
    padding: 10px 15px;
    font-size: 13px;
  }

  .teacher-profile-course-grid {
    grid-template-columns: 1fr;
  }

  .teacher-profile-students-list {
    grid-template-columns: 1fr;
  }

  .teacher-profile-section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 10px;
  }

  .teacher-profile-resource-card {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .teacher-profile-resource-info {
    width: calc(100% - 70px);
  }

  .teacher-profile-resource-action {
    width: 100%;
    margin-left: 66px;
  }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 480px) {

  .teacher-profile-stats {
    grid-template-columns: 1fr 1fr;
  }

  .teacher-profile-stat h3 {
    font-size: 26px;
  }

  .teacher-profile-stat span {
    font-size: 12px;
  }

  .teacher-profile-overview-card {
    padding: 20px;
  }

  .teacher-profile-table {
    font-size: 13px;
  }

  .teacher-profile-table th {
    width: 110px;
  }

  .teacher-profile-course-cover {
    height: 150px;
  }

  .teacher-profile-activity-timeline::before {
    left: 22px;
  }

  .teacher-profile-activity-icon {
    width: 38px;
    height: 38px;
    min-width: 38px;
    font-size: 15px;
  }

  .teacher-profile-activity-item {
    gap: 14px;
  }

}
</style>


<div class="teacher-profile-page">

  <!-- =====================================================
       PROFILE HEADER
  ===================================================== -->

  <div class="teacher-profile-card">

    <div class="teacher-profile-header">

      <div class="teacher-profile-avatar">

        <% if @teacher.photo.attached? %>

          <%= image_tag @teacher.photo,
              class: "avatar-img",
              alt: @teacher.name %>

        <% else %>

          <div class="default-avatar">
            <i class="bi bi-person-fill"></i>
          </div>

        <% end %>

      </div>


      <div class="teacher-profile-info">

        <h2>
          <%= @teacher.name.presence || "Teacher" %>
        </h2>

        <div class="teacher-profile-role">
          <i class="bi bi-person-badge"></i>
          Teacher
        </div>

        <p>
          <i class="bi bi-envelope"></i>
          <%= current_user.email %>
        </p>

        <% if @teacher.subject.present? %>

          <p>
            <i class="bi bi-book"></i>
            <%= @teacher.subject %>
          </p>

        <% end %>

      </div>

    </div>


    <!-- ===================================================
         STATISTICS
    =================================================== -->

    <div class="teacher-profile-stats">

      <div class="teacher-profile-stat">
        <h3><%= @courses.count %></h3>
        <span>Total Courses</span>
      </div>

      <div class="teacher-profile-stat">
        <h3><%= @students.count %></h3>
        <span>Total Students</span>
      </div>

      <div class="teacher-profile-stat">
        <h3><%= @videos.count %></h3>
        <span>Total Videos</span>
      </div>

      <div class="teacher-profile-stat">
        <h3><%= @resources.count %></h3>
        <span>Total Resources</span>
      </div>

    </div>

  </div>


  <!-- =====================================================
       TABS
  ===================================================== -->

  <div class="teacher-profile-tabs">

    <button type="button"
            class="teacher-profile-tab-btn active"
            data-tab="overview">

      <i class="bi bi-grid"></i>
      Overview

    </button>


    <button type="button"
            class="teacher-profile-tab-btn"
            data-tab="courses">

      <i class="bi bi-book"></i>
      Courses

    </button>


    <button type="button"
            class="teacher-profile-tab-btn"
            data-tab="students">

      <i class="bi bi-people"></i>
      Students

    </button>


    <button type="button"
            class="teacher-profile-tab-btn"
            data-tab="resources">

      <i class="bi bi-folder2-open"></i>
      Resources

    </button>


    <button type="button"
            class="teacher-profile-tab-btn"
            data-tab="activity">

      <i class="bi bi-clock-history"></i>
      Activity

    </button>

  </div>


  <!-- =====================================================
       TAB CONTENT
  ===================================================== -->

  <div class="teacher-profile-tab-content">


    <!-- ===================================================
         OVERVIEW
    =================================================== -->

    <div id="overview"
         class="teacher-profile-tab-pane active">

      <div class="teacher-profile-overview-grid">


        <!-- About -->

        <div class="teacher-profile-overview-card">

          <h4>
            <i class="bi bi-person-circle"></i>
            About Teacher
          </h4>

          <table class="table table-borderless teacher-profile-table">

            <tr>
              <th>Name</th>
              <td>
                <%= @teacher.name.presence || "-" %>
              </td>
            </tr>

            <tr>
              <th>Email</th>
              <td>
                <%= current_user.email %>
              </td>
            </tr>

            <tr>
              <th>Phone</th>
              <td>
                <%= @teacher.mobile.presence || "-" %>
              </td>
            </tr>

            <tr>
              <th>Qualification</th>
              <td>
                <%= @teacher.qualification.presence || "-" %>
              </td>
            </tr>

            <tr>
              <th>Experience</th>
              <td>
                <%= @teacher.experience.presence || "-" %>
              </td>
            </tr>

            <tr>
              <th>Joined</th>
              <td>
                <%= @teacher.created_at.strftime("%d %B %Y") %>
              </td>
            </tr>

          </table>

        </div>


        <!-- Teaching Summary -->

        <div class="teacher-profile-overview-card">

          <h4>
            <i class="bi bi-bar-chart"></i>
            Teaching Summary
          </h4>


          <div class="teacher-profile-summary-item">
            <span>Courses</span>
            <strong><%= @courses.count %></strong>
          </div>


          <div class="teacher-profile-summary-item">
            <span>Students</span>
            <strong><%= @students.count %></strong>
          </div>


          <div class="teacher-profile-summary-item">
            <span>Playlists</span>
            <strong><%= @playlists.count %></strong>
          </div>


          <div class="teacher-profile-summary-item">
            <span>Videos</span>
            <strong><%= @videos.count %></strong>
          </div>


          <div class="teacher-profile-summary-item">
            <span>Resources</span>
            <strong><%= @resources.count %></strong>
          </div>

        </div>

      </div>

    </div>


    <!-- ===================================================
         COURSES
    ===================================================== -->

    <div id="courses"
         class="teacher-profile-tab-pane">

      <div class="teacher-profile-section-heading">

        <div>

          <h3>
            <i class="bi bi-book"></i>
            My Courses
          </h3>

          <p>
            Courses currently managed by you
          </p>

        </div>

        <span class="teacher-profile-section-count">
          <%= @courses.count %> Courses
        </span>

      </div>


      <% if @courses.any? %>

        <div class="teacher-profile-course-grid">

          <% @courses.each do |course| %>

            <%= link_to teacher_panel_course_path(course),
                class: "teacher-profile-course-link" do %>

              <div class="teacher-profile-course-card">

                <% if course.image.attached? %>

                  <%= image_tag course.image,
                      class: "teacher-profile-course-cover",
                      alt: course.Course_name %>

                <% else %>

                  <div class="teacher-profile-course-cover teacher-profile-course-placeholder">

                    <i class="bi bi-book"></i>

                  </div>

                <% end %>


                <div class="teacher-profile-course-body">

                  <h4>
                    <%= course.Course_name %>
                  </h4>


                  <p class="teacher-profile-course-description">

                    <%= truncate(
                      course.description.presence ||
                      "No course description available.",
                      length: 100
                    ) %>

                  </p>


                  <div class="teacher-profile-course-meta">

                    <span>
                      <i class="bi bi-play-circle"></i>
                      <%= course.videos.count %> Videos
                    </span>

                    <span>
                      <i class="bi bi-folder2-open"></i>
                      <%= course.playlists.count %> Playlists
                    </span>

                  </div>


                  <div class="teacher-profile-course-view">

                    View Course
                    <i class="bi bi-arrow-right"></i>

                  </div>

                </div>

              </div>

            <% end %>

          <% end %>

        </div>


      <% else %>

        <div class="teacher-profile-empty-state">

          <i class="bi bi-book"></i>

          <h4>No Courses Yet</h4>

          <p>
            You have not created any courses yet.
          </p>

        </div>

      <% end %>

    </div>


    <!-- ===================================================
         STUDENTS
    ===================================================== -->

    <div id="students"
         class="teacher-profile-tab-pane">

      <div class="teacher-profile-section-heading">

        <div>

          <h3>
            <i class="bi bi-people"></i>
            My Students
          </h3>

          <p>
            Students enrolled in your courses
          </p>

        </div>

        <span class="teacher-profile-section-count">
          <%= @students.count %> Students
        </span>

      </div>


      <% if @students.any? %>

        <div class="teacher-profile-students-list">

          <% @students.each do |student| %>

            <div class="teacher-profile-student-card">

              <div class="teacher-profile-student-avatar">

                <i class="bi bi-person-fill"></i>

              </div>


              <div class="teacher-profile-student-info">

                <h4>
                  <%= student.name.presence || "Student" %>
                </h4>

                <p>
                  <i class="bi bi-envelope"></i>
                  <%= student.email %>
                </p>

              </div>

            </div>

          <% end %>

        </div>


      <% else %>

        <div class="teacher-profile-empty-state">

          <i class="bi bi-people"></i>

          <h4>No Students Yet</h4>

          <p>
            No students are currently enrolled in your courses.
          </p>

        </div>

      <% end %>

    </div>


    <!-- ===================================================
         RESOURCES
    ===================================================== -->

    <div id="resources"
         class="teacher-profile-tab-pane">

      <div class="teacher-profile-section-heading">

        <div>

          <h3>
            <i class="bi bi-folder2-open"></i>
            My Resources
          </h3>

          <p>
            Learning resources available in your courses
          </p>

        </div>

        <span class="teacher-profile-section-count">
          <%= @resources.count %> Resources
        </span>

      </div>


      <% if @resources.any? %>

        <div class="teacher-profile-resource-list">

          <% @resources.each do |resource| %>

            <div class="teacher-profile-resource-card">


              <div class="teacher-profile-resource-icon">

                <% if resource.resource_type.to_s.downcase == "pdf" %>

                  <i class="bi bi-file-earmark-pdf"></i>

                <% elsif ["document", "doc", "docx"].include?(resource.resource_type.to_s.downcase) %>

                  <i class="bi bi-file-earmark-word"></i>

                <% elsif ["image", "jpg", "jpeg", "png"].include?(resource.resource_type.to_s.downcase) %>

                  <i class="bi bi-file-earmark-image"></i>

                <% else %>

                  <i class="bi bi-file-earmark-text"></i>

                <% end %>

              </div>


              <div class="teacher-profile-resource-info">

                <h4>
                  <%= resource.title.presence || "Learning Resource" %>
                </h4>


                <% if resource.description.present? %>

                  <p class="teacher-profile-resource-description">

                    <%= truncate(
                      resource.description,
                      length: 90
                    ) %>

                  </p>

                <% end %>


                <p class="teacher-profile-resource-meta">

                  <span>
                    <i class="bi bi-tag"></i>

                    <%= resource.resource_type.presence || "Resource" %>

                  </span>


                  <% if resource.playlist.present? %>

                    <span>

                      <i class="bi bi-collection-play"></i>

                      <%= resource.playlist.title %>

                    </span>

                  <% end %>

                </p>

              </div>


              <div class="teacher-profile-resource-action">

                <% if resource.file.attached? %>

                  <%= link_to rails_blob_path(
                        resource.file,
                        disposition: "attachment"
                      ),
                      class: "teacher-profile-resource-view" do %>

                    <i class="bi bi-download"></i>
                    Download

                  <% end %>

                <% else %>

                  <span class="teacher-profile-resource-unavailable">
                    No File
                  </span>

                <% end %>

              </div>

            </div>

          <% end %>

        </div>


      <% else %>

        <div class="teacher-profile-empty-state">

          <i class="bi bi-folder2-open"></i>

          <h4>No Resources Yet</h4>

          <p>
            No learning resources have been added to your courses.
          </p>

        </div>

      <% end %>

    </div>


    <!-- ===================================================
         ACTIVITY
    ===================================================== -->

    <div id="activity"
         class="teacher-profile-tab-pane">

      <div class="teacher-profile-section-heading">

        <div>

          <h3>
            <i class="bi bi-clock-history"></i>
            Recent Activity
          </h3>

          <p>
            Your latest teaching activities
          </p>

        </div>

        <span class="teacher-profile-section-count">
          <%= @activities.count %> Activities
        </span>

      </div>


      <% if @activities.any? %>

        <div class="teacher-profile-activity-timeline">

          <% @activities.each do |activity| %>

            <div class="teacher-profile-activity-item">


              <div class="teacher-profile-activity-icon
                <%= activity[:type] == "course" ? "teacher-profile-course-icon" :
                    activity[:type] == "playlist" ? "teacher-profile-playlist-icon" :
                    activity[:type] == "video" ? "teacher-profile-video-icon" :
                    "teacher-profile-resource-icon-color" %>">


                <% if activity[:type] == "course" %>

                  <i class="bi bi-book"></i>

                <% elsif activity[:type] == "playlist" %>

                  <i class="bi bi-collection-play"></i>

                <% elsif activity[:type] == "video" %>

                  <i class="bi bi-play-circle"></i>

                <% else %>

                  <i class="bi bi-file-earmark-text"></i>

                <% end %>

              </div>


              <div class="teacher-profile-activity-content">

                <h4>
                  <%= activity[:title] %>
                </h4>

                <p>
                  <strong>
                    <%= activity[:description] %>
                  </strong>
                </p>

                <span class="teacher-profile-activity-time">

                  <i class="bi bi-clock"></i>

                  <%= time_ago_in_words(
                    activity[:created_at]
                  ) %> ago

                </span>

              </div>

            </div>

          <% end %>

        </div>


      <% else %>

        <div class="teacher-profile-empty-state">

          <i class="bi bi-clock-history"></i>

          <h4>No Activity Yet</h4>

          <p>
            Your teaching activity will appear here.
          </p>

        </div>

      <% end %>

    </div>

  </div>

</div>


<script>
document.addEventListener("DOMContentLoaded", function () {

  const buttons = document.querySelectorAll(
    ".teacher-profile-tab-btn"
  );

  const panes = document.querySelectorAll(
    ".teacher-profile-tab-pane"
  );

  buttons.forEach(function (button) {

    button.addEventListener("click", function () {

      buttons.forEach(function (btn) {
        btn.classList.remove("active");
      });

      panes.forEach(function (pane) {
        pane.classList.remove("active");
      });

      this.classList.add("active");

      const tab = this.dataset.tab;
      const target = document.getElementById(tab);

      if (target) {
        target.classList.add("active");
      }

    });

  });

});
</script>