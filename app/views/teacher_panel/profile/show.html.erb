}

.teacher-profile-info h2 {
  margin: 0 0 8px;
  color: #111827;
  font-size: 34px;
  line-height: 1.2;
  font-weight: 750;
  word-break: break-word;
}

.teacher-profile-role {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 12px;
  margin-bottom: 14px;

  background: #f3efff;
  color: #6d28d9;

  border: 1px solid #e9ddff;
  border-radius: 20px;

  font-size: 12px;
  font-weight: 700;
}

.teacher-profile-info p {
  display: flex;
  align-items: center;
  gap: 9px;

  margin: 0 0 8px;

  color: #64748b;
  font-size: 14px;
}

.teacher-profile-info p i {
  width: 18px;
  color: #7c3aed;
}


/* =========================================================
   STATISTICS
========================================================= */

.teacher-profile-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.teacher-profile-stat {
  position: relative;

  background: #ffffff;
  border: 1px solid #e8eaf0;
  border-radius: 17px;

  padding: 23px 18px;

  text-align: center;

  box-shadow: 0 5px 18px rgba(31, 41, 55, 0.04);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;

  overflow: hidden;
}

.teacher-profile-stat::after {
  content: "";

  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;

  height: 3px;

  background: #7c3aed;
}

.teacher-profile-stat:hover {
  transform: translateY(-4px);
  border-color: #ddd6fe;
  box-shadow: 0 12px 28px rgba(124, 58, 237, 0.10);
}

.teacher-profile-stat h3 {
  margin: 0 0 5px;

  color: #111827;
  font-size: 34px;
  line-height: 1;
  font-weight: 750;
}

.teacher-profile-stat span {
  color: #64748b;
  font-size: 13px;
  font-weight: 600;
}


/* =========================================================
   TABS
========================================================= */

.teacher-profile-tabs {
