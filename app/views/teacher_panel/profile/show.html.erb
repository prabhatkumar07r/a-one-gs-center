  align-items: center;
  justify-content: center;
  gap: 7px;

  border: none;
  background: transparent;

  color: #64748b;

  padding: 11px 18px;

  border-radius: 10px;

  font-size: 13px;
  font-weight: 650;

  cursor: pointer;
  white-space: nowrap;

  transition:
