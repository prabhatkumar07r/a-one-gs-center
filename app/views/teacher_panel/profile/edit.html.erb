<style>
 <style>
/* =========================================================
   TEACHER PROFILE PAGE
   Responsive: Desktop / Tablet / Mobile
   Does not affect other pages
========================================================= */

.profile-page {
    width: 100%;
    min-height: 100vh;
    background: #07111f;
    padding: 40px 30px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
}

/* Main Card */
.profile-card {
    width: 100%;
    max-width: 1250px;
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    box-shadow: 0 15px 40px rgba(0, 0, 0, .25);
}

/* =========================================================
   LEFT PANEL
========================================================= */

.profile-left {
    width: 30%;
    min-width: 280px;
    background: linear-gradient(180deg, #0d6efd, #07111f);
    color: #fff;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;
    padding: 50px 30px;
}

.coaching-logo {
    width: 180px;
    max-width: 80%;
    height: auto;
    object-fit: contain;
    margin-bottom: 20px;
}

.profile-left h3 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 0;
}

.profile-left .title {
    font-size: 18px;
    margin-top: 15px;
    margin-bottom: 0;
    font-weight: 500;
}

.profile-left .desc {
    max-width: 280px;
    margin: 20px auto 0;
    line-height: 1.8;
    font-size: 15px;
    color: rgba(255, 255, 255, .88);
}

/* =========================================================
   RIGHT PANEL
========================================================= */

.profile-right {
    width: 70%;
    padding: 45px;
    background: #ffffff;
}

.profile-right h2 {
    font-size: 30px;
    font-weight: 700;
    margin-bottom: 30px;
    color: #1f2937;
}

/* =========================================================
   PHOTO
========================================================= */

.photo-section {
    text-align: center;
    margin-bottom: 35px;
}

.profile-photo {
    width: 150px;
    height: 150px;
    max-width: 100%;
    border-radius: 50%;
    object-fit: cover;

    border: 6px solid #f5f5f5;

    box-shadow:
        0 10px 25px rgba(0, 0, 0, .20);

    transition: .3s ease;
}

.profile-photo:hover {
    transform: scale(1.03);
}

/* File input */
.photo-section .form-control {
    max-width: 350px;
    margin-left: auto;
    margin-right: auto;
}

/* =========================================================
   FORM
========================================================= */

.profile-right label {
    display: block;
    margin-bottom: 7px;
    font-size: 14px;
    font-weight: 600;
    color: #374151;
}

.profile-right .form-control {
    width: 100%;
    min-height: 46px;

    border-radius: 10px;
    border: 1px solid #dee2e6;

    padding: 11px 13px;

    font-size: 14px;

    background: #fff;

    transition:
        border-color .2s ease,
        box-shadow .2s ease;
}

.profile-right .form-control:focus {
    border-color: #0d6efd;
    box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
    outline: none;
}

/* Textarea */
.profile-right textarea.form-control {
    min-height: 130px;
    resize: vertical;
}

/* Save Button */
.profile-right .btn-warning {
    font-weight: 600;
    border-radius: 10px;
    padding: 12px 30px;
    min-width: 140px;
    transition: .3s ease;
}

.profile-right .btn-warning:hover {
    transform: translateY(-2px);
    box-shadow: 0 7px 18px rgba(0, 0, 0, .15);
}

/* =========================================================
   LARGE DESKTOP
   1200px+
========================================================= */

@media (min-width: 1200px) {

    .profile-page {
        padding: 50px 40px;
    }

    .profile-card {
        max-width: 1350px;
    }

    .profile-left {
        width: 32%;
        padding: 60px 40px;
    }

    .profile-right {
        width: 68%;
        padding: 50px;
    }

    .profile-right h2 {
        font-size: 32px;
    }

    .coaching-logo {
        width: 200px;
    }
}

/* =========================================================
   LAPTOP
   992px - 1199px
========================================================= */

@media (min-width: 992px) and (max-width: 1199px) {

    .profile-page {
        padding: 35px 25px;
    }

    .profile-left {
        width: 32%;
        padding: 40px 25px;
    }

    .profile-right {
        width: 68%;
        padding: 35px;
    }

    .profile-right h2 {
        font-size: 27px;
    }

    .coaching-logo {
        width: 160px;
    }
}

/* =========================================================
   TABLET
   768px - 991px
========================================================= */

@media (min-width: 768px) and (max-width: 991px) {

    .profile-page {
        padding: 30px 20px;
    }

    .profile-card {
        flex-direction: column;
    }

    .profile-left {
        width: 100%;
        min-width: 0;

        padding: 35px 25px;

        flex-direction: row;
        gap: 25px;

        text-align: left;
    }

    .coaching-logo {
        width: 120px;
        margin: 0;
        flex-shrink: 0;
    }

    .profile-left h3 {
        font-size: 22px;
    }

    .profile-left .title {
        font-size: 16px;
        margin-top: 7px;
    }

    .profile-left .desc {
        max-width: 500px;
        margin: 10px 0 0;
        line-height: 1.6;
    }

    .profile-right {
        width: 100%;
        padding: 35px 30px;
    }

    .profile-right h2 {
        font-size: 26px;
    }
}

/* =========================================================
   MOBILE
   576px - 767px
========================================================= */

@media (min-width: 576px) and (max-width: 767px) {

    .profile-page {
        padding: 20px 15px;
    }

    .profile-card {
        flex-direction: column;
        border-radius: 16px;
    }

    .profile-left {
        width: 100%;
        min-width: 0;

        padding: 30px 20px;

        text-align: center;
    }

    .coaching-logo {
        width: 120px;
        margin-bottom: 15px;
    }

    .profile-left h3 {
        font-size: 21px;
    }

    .profile-left .title {
        font-size: 16px;
        margin-top: 8px;
    }

    .profile-left .desc {
        font-size: 14px;
        line-height: 1.6;
        margin-top: 12px;
    }

    .profile-right {
        width: 100%;
        padding: 30px 22px;
    }

    .profile-right h2 {
        font-size: 24px;
        margin-bottom: 25px;
    }

    .profile-photo {
        width: 135px;
        height: 135px;
    }

    .profile-right .btn-warning {
        width: 100%;
    }
}

/* =========================================================
   SMALL MOBILE
   Below 576px
========================================================= */

@media (max-width: 575px) {

    .profile-page {
        min-height: 100vh;

        padding: 15px 10px;

        display: block;
    }

    .profile-card {
        display: block;
        width: 100%;

        border-radius: 14px;

        box-shadow:
            0 8px 25px rgba(0, 0, 0, .20);
    }

    /* Left section */
    .profile-left {
        width: 100%;
        min-width: 0;

        padding: 28px 18px;

        text-align: center;
    }

    .coaching-logo {
        width: 100px;
        max-width: 45%;
        margin-bottom: 12px;
    }

    .profile-left h3 {
        font-size: 20px;
    }

    .profile-left .title {
        font-size: 15px;
        margin-top: 6px;
    }

    .profile-left .desc {
        font-size: 13px;
        line-height: 1.55;

        max-width: 300px;

        margin: 10px auto 0;
    }

    /* Right section */
    .profile-right {
        width: 100%;
        padding: 25px 16px;
    }

    .profile-right h2 {
        font-size: 22px;
        margin-bottom: 22px;
    }

    /* Profile image */
    .profile-photo {
        width: 115px;
        height: 115px;
        border-width: 4px;
    }

    /* File input */
    .photo-section .form-control {
        width: 100%;
        font-size: 12px;
    }

    /* Form */
    .profile-right .row {
        margin-left: 0;
        margin-right: 0;
    }

    .profile-right .row > [class*="col-"] {
        padding-left: 0;
        padding-right: 0;
    }

    .profile-right .form-control {
        min-height: 44px;
        font-size: 14px;
        padding: 10px 11px;
    }

    .profile-right textarea.form-control {
        min-height: 120px;
    }

    .profile-right label {
        font-size: 13px;
    }

    /* Save button */
    .profile-right .text-end {
        text-align: center !important;
        margin-top: 10px;
    }

    .profile-right .btn-warning {
        width: 100%;
        min-height: 46px;
        padding: 11px 20px;
    }
}

/* =========================================================
   VERY SMALL PHONES
   Below 400px
========================================================= */

@media (max-width: 400px) {

    .profile-page {
        padding: 10px 7px;
    }

    .profile-left {
        padding: 24px 14px;
    }

    .profile-right {
        padding: 22px 13px;
    }

    .coaching-logo {
        width: 90px;
    }

    .profile-left h3 {
        font-size: 18px;
    }

    .profile-left .title {
        font-size: 14px;
    }

    .profile-left .desc {
        font-size: 12px;
    }

    .profile-right h2 {
        font-size: 20px;
    }

    .profile-photo {
        width: 105px;
        height: 105px;
    }

    .profile-right .form-control {
        font-size: 13px;
    }
}

/* =========================================================
   TOUCH DEVICES
========================================================= */

@media (hover: none) and (pointer: coarse) {

    .profile-photo:hover {
        transform: none;
    }

    .profile-right .btn-warning:hover {
        transform: none;
        box-shadow: none;
    }

    .profile-right .form-control {
        min-height: 46px;
    }

    .profile-right .btn-warning {
        min-height: 48px;
    }
}
</style>
</style>



<div class="profile-page">

  <div class="profile-card">

    <!-- Left Side -->
    <div class="profile-left">

      <%= image_tag "chatlogo.png", class: "coaching-logo" %>

      <h3>A One GS Center</h3>

      <p class="title">
        Teacher Profile
      </p>

      <p class="desc">
        Keep your profile updated so students can know more about you.
      </p>

    </div>

    <!-- Right Side -->
    <div class="profile-right">

      <h2>Update Profile</h2>

      <%= form_with model: @teacher,
      url: teacher_panel_profile_path,
      method: :patch,
      local: true,
      multipart: true do |f| %>

      <div class="photo-section">

        <% if @teacher.photo.attached? %>

          <%= image_tag @teacher.photo,
          class:"profile-photo" %>

        <% else %>

          <%= image_tag "default-user.png",
          class:"profile-photo" %>

        <% end %>

        <%= f.file_field :photo,
        class:"form-control mt-3" %>

      </div>

      <div class="row">

        <div class="col-md-6 mb-3">
          <label>Full Name</label>
          <%= f.text_field :name,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Email</label>
          <%= f.email_field :gmail,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Mobile</label>
          <%= f.text_field :mobile,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Subject</label>
          <%= f.text_field :subject,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Qualification</label>
          <%= f.text_field :qualification,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Designation</label>
          <%= f.text_field :designation,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Experience</label>
          <%= f.number_field :experience,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Facebook</label>
          <%= f.text_field :facebook,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Instagram</label>
          <%= f.text_field :instagram,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>LinkedIn</label>
          <%= f.text_field :linkedin,
          class:"form-control" %>
        </div>

        <div class="col-12 mb-3">
          <label>Bio</label>
          <%= f.text_area :bio,
          rows:5,
          class:"form-control" %>
        </div>

      </div>

      <div class="text-end">

        <%= f.submit "Save Changes",
        class:"btn btn-warning px-4" %>

      </div>

      <% end %>

    </div>

  </div>

</div>