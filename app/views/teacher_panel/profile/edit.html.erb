<style>
  .profile-page{
    background:#07111f;
    min-height:100vh;
    padding:40px;
}

.profile-card{
    background:#fff;
    border-radius:20px;
    overflow:hidden;
    display:flex;
    box-shadow:0 15px 40px rgba(0,0,0,.25);
}

.profile-left{
    width:30%;
    background:linear-gradient(180deg,#0d6efd,#07111f);
    color:#fff;
    text-align:center;
    padding:50px 30px;
}

.coaching-logo{
    width:180px;
    margin-bottom:20px;
}

.profile-left h3{
    font-weight:700;
}

.title{
    font-size:20px;
    margin-top:15px;
}

.desc{
    margin-top:20px;
    line-height:28px;
}

.profile-right{
    width:70%;
    padding:40px;
}

.profile-right h2{
    font-weight:700;
    margin-bottom:30px;
}

.photo-section{
    text-align:center;
    margin-bottom:30px;
}

.profile-photo{
    width:150px;
    height:150px;
    border-radius:50%;
    object-fit:cover;
    border:6px solid #f5f5f5;
    box-shadow:0 10px 25px rgba(0,0,0,.2);
}

.form-control{
    border-radius:10px;
    padding:12px;
}

.btn-warning{
    font-weight:600;
    border-radius:10px;
    padding:12px 30px;
}
</style>



<div class="profile-page">

  <div class="profile-card">

    <!-- Left Side -->
    <div class="profile-left">

      <%= image_tag "chatlogo.png", class: "coaching-logo" %>

      <h3>A One GS Center</h3>

      <p class="title">
        Teacher Profile
      </p>

      <p class="desc">
        Keep your profile updated so students can know more about you.
      </p>

    </div>

    <!-- Right Side -->
    <div class="profile-right">

      <h2>Update Profile</h2>

      <%= form_with model: @teacher,
      url: teacher_panel_profile_path,
      method: :patch,
      local: true,
      multipart: true do |f| %>

      <div class="photo-section">

        <% if @teacher.photo.attached? %>

          <%= image_tag @teacher.photo,
          class:"profile-photo" %>

        <% else %>

          <%= image_tag "default-user.png",
          class:"profile-photo" %>

        <% end %>

        <%= f.file_field :photo,
        class:"form-control mt-3" %>

      </div>

      <div class="row">

        <div class="col-md-6 mb-3">
          <label>Full Name</label>
          <%= f.text_field :name,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Email</label>
          <%= f.email_field :gmail,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Mobile</label>
          <%= f.text_field :mobile,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Subject</label>
          <%= f.text_field :subject,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Qualification</label>
          <%= f.text_field :qualification,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Designation</label>
          <%= f.text_field :designation,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Experience</label>
          <%= f.number_field :experience,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Facebook</label>
          <%= f.text_field :facebook,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>Instagram</label>
          <%= f.text_field :instagram,
          class:"form-control" %>
        </div>

        <div class="col-md-6 mb-3">
          <label>LinkedIn</label>
          <%= f.text_field :linkedin,
          class:"form-control" %>
        </div>

        <div class="col-12 mb-3">
          <label>Bio</label>
          <%= f.text_area :bio,
          rows:5,
          class:"form-control" %>
        </div>

      </div>

      <div class="text-end">

        <%= f.submit "Save Changes",
        class:"btn btn-warning px-4" %>

      </div>

      <% end %>

    </div>

  </div>

</div>