<% content_for :title, "Test Series" %>

<div class="ts-page">

  <!-- ==================================================
       HEADER
  ================================================== -->

  <div class="ts-header">

    <div>
      <div class="ts-breadcrumb">
        Teacher Panel / Test Series
      </div>

      <h1 class="ts-title">
        Test Series
      </h1>

      <p class="ts-subtitle">
        Create and manage mock test series for students.
      </p>
    </div>

    <%= link_to new_teacher_panel_test_series_path,
                class: "ts-primary-btn" do %>
      <i class="fas fa-plus"></i>
      Create Test Series
    <% end %>

  </div>


  <!-- ==================================================
       STATISTICS
  ================================================== -->

  <div class="ts-stats">

    <div class="ts-stat-card">

      <div class="ts-stat-icon">
        <i class="fas fa-layer-group"></i>
      </div>

      <div>
        <span class="ts-stat-label">
          Total Series
        </span>

        <strong class="ts-stat-value">
          <%= @test_series.count %>
        </strong>
      </div>

    </div>


    <div class="ts-stat-card">

      <div class="ts-stat-icon">
        <i class="fas fa-check-circle"></i>
      </div>

      <div>
        <span class="ts-stat-label">
          Active
        </span>

        <strong class="ts-stat-value">
          <%= @test_series.where(status: "Active").count %>
        </strong>
      </div>

    </div>


    <div class="ts-stat-card">

      <div class="ts-stat-icon">
        <i class="fas fa-file-alt"></i>
      </div>

      <div>
        <span class="ts-stat-label">
          Total Tests
        </span>

        <strong class="ts-stat-value">
          <%= TestSeriesTest.count %>
        </strong>
      </div>

    </div>


    <div class="ts-stat-card">

      <div class="ts-stat-icon">
        <i class="fas fa-users"></i>
      </div>

      <div>
        <span class="ts-stat-label">
          Purchases
        </span>

        <strong class="ts-stat-value">
          <%= TestSeriesPurchase.paid.count %>
        </strong>
      </div>

    </div>

  </div>


  <!-- ==================================================
       TEST SERIES GRID
  ================================================== -->

  <% if @test_series.any? %>

    <div class="ts-grid">

      <% @test_series.each do |series| %>

        <div class="ts-card">

          <!-- IMAGE -->

          <div class="ts-card-image">

            <% if series.image.attached? %>

              <%= image_tag series.image,
                            alt: series.title %>

            <% else %>

              <div class="ts-image-placeholder">
                <i class="fas fa-layer-group"></i>
              </div>

            <% end %>


            <!-- STATUS -->

            <span class="ts-status
              <%= series.status.to_s.downcase == "active" ? "active" : "inactive" %>">

              <%= series.status.presence || "Inactive" %>

            </span>

          </div>


          <!-- CONTENT -->

          <div class="ts-card-body">

            <div class="ts-exam">
              <i class="fas fa-graduation-cap"></i>
              <%= series.exam_name %>
            </div>


            <h2 class="ts-card-title">
              <%= series.title %>
            </h2>


            <p class="ts-card-description">

              <%= truncate(
                    series.description.to_s,
                    length: 110
                  ) %>

            </p>


            <!-- META -->

            <div class="ts-meta">

              <span>
                <i class="fas fa-file-alt"></i>
                <%= series.test_count %> Tests
              </span>

              <span>
                <i class="fas fa-question-circle"></i>
                <%= series.total_questions %> Questions
              </span>

              <span>
                <i class="fas fa-language"></i>
                <%= series.language %>
              </span>

            </div>


            <!-- PRICE -->

            <div class="ts-price-row">

              <div>

                <% if series.original_price.present? &&
                      series.original_price.to_d > series.price.to_d %>

                  <span class="ts-original-price">
                    ₹<%= series.original_price %>
                  </span>

                <% end %>

                <strong class="ts-price">
                  <%= series.free? ? "FREE" : "₹#{series.price}" %>
                </strong>

              </div>


              <% if series.discounted? %>

                <span class="ts-discount">
                  <%= series.discount %>% OFF
                </span>

              <% end %>

            </div>


            <!-- ACTIONS -->

            <div class="ts-actions">

              <%= link_to teacher_panel_test_series_path(series),
                          class: "ts-view-btn" do %>

                <i class="fas fa-eye"></i>
                Manage

              <% end %>


              <%= link_to edit_teacher_panel_test_series_path(series),
                          class: "ts-edit-btn" do %>

                <i class="fas fa-edit"></i>

              <% end %>


              <%= button_to teacher_panel_test_series_path(series),
                            method: :delete,
                            class: "ts-delete-btn",
                            data: {
                              turbo_confirm:
                                "Are you sure you want to delete this Test Series?"
                            } do %>

                <i class="fas fa-trash"></i>

              <% end %>

            </div>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <!-- ==================================================
         EMPTY STATE
    ================================================== -->

    <div class="ts-empty">

      <div class="ts-empty-icon">
        <i class="fas fa-layer-group"></i>
      </div>

      <h2>
        No Test Series Yet
      </h2>

      <p>
        Create your first Test Series and start adding tests.
      </p>

      <%= link_to new_teacher_panel_test_series_path,
                  class: "ts-primary-btn" do %>

        <i class="fas fa-plus"></i>
        Create Test Series

      <% end %>

    </div>

  <% end %>

</div>


<style>

  /* ==================================================
     PAGE
  ================================================== */

  .ts-page {
    padding: 28px;
    max-width: 1500px;
    margin: 0 auto;
  }


  /* ==================================================
     HEADER
  ================================================== */

  .ts-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
  }

  .ts-breadcrumb {
    font-size: 13px;
    color: #8b95a7;
    margin-bottom: 7px;
  }

  .ts-title {
    margin: 0;
    font-size: 30px;
    font-weight: 800;
    color: #172033;
  }

  .ts-subtitle {
    margin: 7px 0 0;
    color: #7b8494;
    font-size: 14px;
  }


  /* ==================================================
     BUTTON
  ================================================== */

  .ts-primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 19px;
    border-radius: 10px;
    background: #4f46e5;
    color: white !important;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    border: none;
    transition: .2s;
  }

  .ts-primary-btn:hover {
    background: #4338ca;
    transform: translateY(-1px);
  }


  /* ==================================================
     STATS
  ================================================== */

  .ts-stats {
    display: grid;
    grid-template-columns:
      repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 28px;
  }

  .ts-stat-card {
    background: white;
    border: 1px solid #e7eaf0;
    border-radius: 14px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .ts-stat-icon {
    width: 46px;
    height: 46px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eef2ff;
    color: #4f46e5;
    font-size: 19px;
  }

  .ts-stat-label {
    display: block;
    font-size: 12px;
    color: #8992a3;
    margin-bottom: 4px;
  }

  .ts-stat-value {
    font-size: 23px;
    color: #172033;
  }


  /* ==================================================
     GRID
  ================================================== */

  .ts-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 22px;
  }


  /* ==================================================
     CARD
  ================================================== */

  .ts-card {
    background: white;
    border: 1px solid #e7eaf0;
    border-radius: 16px;
    overflow: hidden;
    transition: .25s;
  }

  .ts-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 12px 35px rgba(20, 30, 50, .10);
  }


  /* ==================================================
     IMAGE
  ================================================== */

  .ts-card-image {
    height: 180px;
    position: relative;
    background: #eef2ff;
    overflow: hidden;
  }

  .ts-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ts-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6366f1;
    font-size: 50px;
  }


  /* ==================================================
     STATUS
  ================================================== */

  .ts-status {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 6px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    background: white;
  }

  .ts-status.active {
    color: #15803d;
  }

  .ts-status.inactive {
    color: #b91c1c;
  }


  /* ==================================================
     BODY
  ================================================== */

  .ts-card-body {
    padding: 19px;
  }

  .ts-exam {
    font-size: 12px;
    color: #6366f1;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .ts-card-title {
    margin: 0;
    font-size: 19px;
    line-height: 1.35;
    color: #172033;
  }

  .ts-card-description {
    color: #7b8494;
    font-size: 13px;
    line-height: 1.6;
    min-height: 42px;
    margin: 9px 0 15px;
  }


  /* ==================================================
     META
  ================================================== */

  .ts-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    padding: 12px 0;
    border-top: 1px solid #edf0f4;
    border-bottom: 1px solid #edf0f4;
  }

  .ts-meta span {
    font-size: 11px;
    color: #737d8f;
  }

  .ts-meta i {
    margin-right: 4px;
  }


  /* ==================================================
     PRICE
  ================================================== */

  .ts-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 16px 0;
  }

  .ts-price {
    font-size: 21px;
    color: #172033;
  }

  .ts-original-price {
    color: #9aa2af;
    text-decoration: line-through;
    font-size: 12px;
    margin-right: 5px;
  }

  .ts-discount {
    padding: 5px 8px;
    border-radius: 6px;
    background: #ecfdf3;
    color: #15803d;
    font-size: 11px;
    font-weight: 700;
  }


  /* ==================================================
     ACTIONS
  ================================================== */

  .ts-actions {
    display: flex;
    gap: 8px;
  }

  .ts-view-btn,
  .ts-edit-btn,
  .ts-delete-btn {
    height: 38px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border: 1px solid #e1e5ec;
    background: white;
    color: #4b5563;
    cursor: pointer;
    font-size: 13px;
  }

  .ts-view-btn {
    flex: 1;
    gap: 7px;
    font-weight: 700;
  }

  .ts-edit-btn,
  .ts-delete-btn {
    width: 40px;
  }

  .ts-view-btn:hover,
  .ts-edit-btn:hover {
    background: #f5f7ff;
    color: #4f46e5;
  }

  .ts-delete-btn:hover {
    background: #fff5f5;
    color: #dc2626;
  }


  /* ==================================================
     EMPTY
  ================================================== */

  .ts-empty {
    background: white;
    border: 1px dashed #d8dce5;
    border-radius: 16px;
    padding: 70px 20px;
    text-align: center;
  }

  .ts-empty-icon {
    font-size: 50px;
    color: #a5b4fc;
    margin-bottom: 15px;
  }

  .ts-empty h2 {
    margin: 0 0 7px;
    color: #172033;
  }

  .ts-empty p {
    color: #7b8494;
    margin-bottom: 20px;
  }


  /* ==================================================
     RESPONSIVE
  ================================================== */

  @media (max-width: 1100px) {

    .ts-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .ts-stats {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

  }


  @media (max-width: 700px) {

    .ts-page {
      padding: 18px;
    }

    .ts-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .ts-primary-btn {
      width: 100%;
      justify-content: center;
    }

    .ts-grid {
      grid-template-columns: 1fr;
    }

    .ts-stats {
      grid-template-columns: 1fr;
    }

  }

</style>