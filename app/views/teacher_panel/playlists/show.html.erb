<div class="teacher-playlist-show-page">

  <!-- =========================================================
       HEADER
  ========================================================== -->

  <div class="teacher-playlist-header">

    <div class="teacher-playlist-header-left">

      <%= link_to teacher_panel_course_playlists_path(@course),
                  class: "teacher-playlist-back-btn" do %>
        <i class="bi bi-arrow-left"></i>
        <span>Back to Playlists</span>
      <% end %>

      <div class="teacher-playlist-title-area">

        <div class="teacher-playlist-icon">
          <i class="bi bi-collection-play-fill"></i>
        </div>

        <div>
          <span class="teacher-playlist-label">
            PLAYLIST
          </span>

          <h1>
            <%= @playlist.title %>
          </h1>

          <p>
            <i class="bi bi-book"></i>
            <%= @course.Course_name %>
            <span>•</span>
            <i class="bi bi-list-ol"></i>
            Position <%= @playlist.position %>
            <span>•</span>
            <i class="bi bi-camera-video"></i>
            <%= @playlist.videos.count %>
            <%= @playlist.videos.count == 1 ? "Video" : "Videos" %>
          </p>
        </div>

      </div>

    </div>


    <!-- =======================================================
         TEACHER ACTIONS
    ======================================================== -->

    <div class="teacher-playlist-actions">

      <%= link_to edit_teacher_panel_course_playlist_path(
                    @course,
                    @playlist
                  ),
                  class: "teacher-playlist-btn teacher-playlist-btn-primary" do %>

        <i class="bi bi-pencil-square"></i>
        <span>Edit Playlist</span>

      <% end %>


      <button type="button"
              class="teacher-playlist-btn teacher-playlist-btn-danger"
              id="teacherDeletePlaylistBtn">

        <i class="bi bi-trash3"></i>
        <span>Delete Playlist</span>

      </button>

    </div>

  </div>


  <!-- =========================================================
       CONTENT GRID
  ========================================================== -->

  <div class="teacher-playlist-content-grid">

    <!-- =======================================================
         LEFT COLUMN
    ======================================================== -->

    <div class="teacher-playlist-main-column">

      <!-- =====================================================
           PLAYLIST INFORMATION
      ====================================================== -->

      <section class="teacher-playlist-card">

        <div class="teacher-playlist-card-header">

          <div>
            <span class="teacher-card-eyebrow">
              OVERVIEW
            </span>

            <h2>
              Playlist Information
            </h2>
          </div>

          <div class="teacher-card-header-icon">
            <i class="bi bi-info-circle"></i>
          </div>

        </div>


        <div class="teacher-playlist-description">

          <% if @playlist.description.present? %>

            <%= simple_format(@playlist.description) %>

          <% else %>

            <div class="teacher-empty-description">

              <i class="bi bi-file-text"></i>

              <span>
                No description has been added to this playlist yet.
              </span>

            </div>

          <% end %>

        </div>

      </section>


      <!-- =====================================================
           VIDEOS
      ====================================================== -->

      <section class="teacher-playlist-card">

        <div class="teacher-playlist-card-header">

          <div>
            <span class="teacher-card-eyebrow">
              CONTENT
            </span>

            <h2>
              Playlist Videos
            </h2>

            <p class="teacher-card-subtitle">
              Videos included in this playlist.
            </p>
          </div>


          <div class="teacher-playlist-video-count">

            <%= @playlist.videos.count %>

            <span>
              <%= @playlist.videos.count == 1 ? "Video" : "Videos" %>
            </span>

          </div>

        </div>


        <% videos = @playlist.videos.order(:position, :id) %>


        <% if videos.any? %>

          <div class="teacher-playlist-video-list">

            <% videos.each_with_index do |video, index| %>

              <div class="teacher-playlist-video-item"
                   data-video-item>

                <div class="teacher-video-number">
                  <%= video.position.presence || index + 1 %>
                </div>


                <div class="teacher-video-play-icon">
                  <i class="bi bi-play-fill"></i>
                </div>


                <div class="teacher-video-information">

                  <h3>
                    <%= video.title.presence || "Untitled Video" %>
                  </h3>

                  <div class="teacher-video-meta">

                    <span>
                      <i class="bi bi-camera-video"></i>
                      Video
                    </span>

                    <% if video.video_url.present? %>
                      <span>
                        <i class="bi bi-youtube"></i>
                        YouTube
                      </span>
                    <% end %>

                  </div>

                </div>


                <% if video.video_url.present? %>

                  <%= link_to video.video_url,
                              target: "_blank",
                              rel: "noopener noreferrer",
                              class: "teacher-video-watch-btn" do %>

                    <i class="bi bi-play-circle-fill"></i>

                    <span>
                      Watch
                    </span>

                  <% end %>

                <% end %>

              </div>

            <% end %>

          </div>

        <% else %>

          <div class="teacher-playlist-empty-state">

            <div class="teacher-empty-icon">
              <i class="bi bi-camera-video-off"></i>
            </div>

            <h3>
              No Videos Yet
            </h3>

            <p>
              Videos added to this playlist will appear here.
            </p>

          </div>

        <% end %>

      </section>

    </div>


    <!-- =======================================================
         RIGHT SIDEBAR
    ======================================================== -->

    <aside class="teacher-playlist-sidebar-column">

      <!-- =====================================================
           STATISTICS
      ====================================================== -->

      <section class="teacher-playlist-card">

        <div class="teacher-playlist-card-header">

          <div>
            <span class="teacher-card-eyebrow">
              STATISTICS
            </span>

            <h2>
              Overview
            </h2>
          </div>

        </div>


        <!-- Total Videos -->

        <div class="teacher-playlist-stat">

          <div class="teacher-stat-icon">
            <i class="bi bi-camera-video"></i>
          </div>

          <div>
            <span class="teacher-stat-value">
              <%= @playlist.videos.count %>
            </span>

            <span class="teacher-stat-label">
              Total Videos
            </span>
          </div>

        </div>


        <!-- Position -->

        <div class="teacher-playlist-stat">

          <div class="teacher-stat-icon">
            <i class="bi bi-list-ol"></i>
          </div>

          <div>
            <span class="teacher-stat-value">
              <%= @playlist.position %>
            </span>

            <span class="teacher-stat-label">
              Playlist Position
            </span>
          </div>

        </div>


        <!-- Created -->

        <div class="teacher-playlist-stat">

          <div class="teacher-stat-icon">
            <i class="bi bi-calendar3"></i>
          </div>

          <div>
            <span class="teacher-stat-value">
              <%= @playlist.created_at.strftime("%d %b %Y") %>
            </span>

            <span class="teacher-stat-label">
              Created On
            </span>
          </div>

        </div>

      </section>


      <!-- =====================================================
           COURSE
      ====================================================== -->

      <section class="teacher-playlist-card">

        <div class="teacher-playlist-card-header">

          <div>
            <span class="teacher-card-eyebrow">
              COURSE
            </span>

            <h2>
              Assigned Course
            </h2>
          </div>

        </div>


        <div class="teacher-course-box">

          <div class="teacher-course-icon">
            <i class="bi bi-mortarboard-fill"></i>
          </div>

          <div>

            <strong>
              <%= @course.Course_name %>
            </strong>

            <span>
              Your assigned course
            </span>

          </div>

        </div>

      </section>


      <!-- =====================================================
           MANAGEMENT
      ====================================================== -->

      <section class="teacher-playlist-card">

        <div class="teacher-playlist-card-header">

          <div>
            <span class="teacher-card-eyebrow">
              MANAGEMENT
            </span>

            <h2>
              Playlist Actions
            </h2>
          </div>

        </div>


        <!-- Edit -->

        <%= link_to edit_teacher_panel_course_playlist_path(
                      @course,
                      @playlist
                    ),
                    class: "teacher-manage-action" do %>

          <i class="bi bi-pencil"></i>

          <span>
            <strong>
              Edit Playlist
            </strong>

            <small>
              Update playlist information
            </small>
          </span>

          <i class="bi bi-chevron-right"></i>

        <% end %>


        <!-- All Playlists -->

        <%= link_to teacher_panel_course_playlists_path(@course),
                    class: "teacher-manage-action" do %>

          <i class="bi bi-collection-play"></i>

          <span>
            <strong>
              All Playlists
            </strong>

            <small>
              Return to playlist list
            </small>
          </span>

          <i class="bi bi-chevron-right"></i>

        <% end %>


        <!-- Delete -->

        <button type="button"
                class="teacher-manage-action teacher-delete-action"
                id="teacherDeletePlaylistAction">

          <i class="bi bi-trash3"></i>

          <span>
            <strong>
              Delete Playlist
            </strong>

            <small>
              Permanently remove this playlist
            </small>
          </span>

          <i class="bi bi-chevron-right"></i>

        </button>

      </section>

    </aside>

  </div>


  <!-- =========================================================
       DELETE MODAL
  ========================================================== -->

  <div class="teacher-playlist-modal-overlay"
       id="teacherDeletePlaylistModal"
       aria-hidden="true">

    <div class="teacher-playlist-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="teacherDeletePlaylistTitle">

      <div class="teacher-modal-warning-icon">

        <i class="bi bi-exclamation-triangle"></i>

      </div>


      <h2 id="teacherDeletePlaylistTitle">
        Delete Playlist?
      </h2>


      <p>

        Are you sure you want to delete

        <strong>
          <%= @playlist.title %>
        </strong>?

        This action cannot be undone.

        All videos associated with this playlist may also be affected
        depending on your model associations.

      </p>


      <div class="teacher-modal-actions">

        <button type="button"
                class="teacher-playlist-btn teacher-playlist-btn-secondary"
                id="teacherCancelDeleteBtn">

          <i class="bi bi-x-lg"></i>
          Cancel

        </button>


        <%= button_to teacher_panel_course_playlist_path(
                        @course,
                        @playlist
                      ),
                      method: :delete,
                      class: "teacher-playlist-btn teacher-playlist-btn-danger",
                      form: {
                        class: "teacher-delete-form"
                      } do %>

          <i class="bi bi-trash3"></i>
          Delete Playlist

        <% end %>

      </div>

    </div>

  </div>

</div>


<style>

/* =========================================================
   TEACHER PLAYLIST SHOW PAGE
========================================================= */

.teacher-playlist-show-page {
  min-height: 100vh;
  padding: 32px;

  background:
    radial-gradient(
      circle at top right,
      rgba(124, 58, 237, .10),
      transparent 30%
    ),
    #f8fafc;

  color: #111827;
}


/* =========================================================
   HEADER
========================================================= */

.teacher-playlist-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 24px;
  margin-bottom: 30px;
}

.teacher-playlist-header-left {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.teacher-playlist-back-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  width: fit-content;

  color: #64748b;
  text-decoration: none;

  font-size: 14px;
  font-weight: 600;

  transition: .2s ease;
}

.teacher-playlist-back-btn:hover {
  color: #4f46e5;
  transform: translateX(-3px);
}

.teacher-playlist-title-area {
  display: flex;
  align-items: center;
  gap: 16px;
}

.teacher-playlist-icon {
  width: 62px;
  height: 62px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 16px;

  background: linear-gradient(
    135deg,
    #4f46e5,
    #7c3aed
  );

  color: #fff;
  font-size: 26px;

  box-shadow:
    0 12px 25px rgba(79, 70, 229, .22);
}

.teacher-playlist-label {
  display: block;

  margin-bottom: 5px;

  color: #6366f1;

  font-size: 10px;
  font-weight: 800;

  letter-spacing: .12em;
}

.teacher-playlist-title-area h1 {
  margin: 0;

  color: #111827;

  font-size: 30px;
  line-height: 1.2;
  font-weight: 800;
}

.teacher-playlist-title-area p {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 7px;

  margin: 7px 0 0;

  color: #64748b;

  font-size: 14px;
}


/* =========================================================
   ACTION BUTTONS
========================================================= */

.teacher-playlist-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.teacher-playlist-btn {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 8px;

  min-height: 42px;

  padding: 10px 16px;

  border: 0;
  border-radius: 10px;

  font-size: 13px;
  font-weight: 700;

  text-decoration: none;

  cursor: pointer;

  white-space: nowrap;

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    background .2s ease;
}

.teacher-playlist-btn:hover {
  transform: translateY(-2px);
}

.teacher-playlist-btn-primary {
  background: #4f46e5;
  color: #fff;

  box-shadow:
    0 8px 18px rgba(79, 70, 229, .20);
}

.teacher-playlist-btn-primary:hover {
  background: #4338ca;
  color: #fff;
}

.teacher-playlist-btn-danger {
  background: #dc2626;
  color: #fff;

  box-shadow:
    0 8px 18px rgba(220, 38, 38, .15);
}

.teacher-playlist-btn-danger:hover {
  background: #b91c1c;
  color: #fff;
}

.teacher-playlist-btn-secondary {
  background: #e2e8f0;
  color: #475569;
}

.teacher-playlist-btn-secondary:hover {
  background: #cbd5e1;
  color: #334155;
}


/* =========================================================
   GRID
========================================================= */

.teacher-playlist-content-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    340px;

  gap: 24px;

  max-width: 1400px;
}

.teacher-playlist-main-column,
.teacher-playlist-sidebar-column {
  display: flex;
  flex-direction: column;
  gap: 24px;
}


/* =========================================================
   CARD
========================================================= */

.teacher-playlist-card {
  padding: 24px;

  background: #fff;

  border: 1px solid #e2e8f0;
  border-radius: 18px;

  box-shadow:
    0 8px 30px rgba(15, 23, 42, .05);
}

.teacher-playlist-card-header {
  display: flex;

  align-items: flex-start;
  justify-content: space-between;

  gap: 15px;

  padding-bottom: 18px;
  margin-bottom: 18px;

  border-bottom: 1px solid #eef2f7;
}

.teacher-card-eyebrow {
  display: block;

  margin-bottom: 5px;

  color: #6366f1;

  font-size: 10px;
  font-weight: 800;

  letter-spacing: .12em;
}

.teacher-playlist-card h2 {
  margin: 0;

  color: #111827;

  font-size: 19px;
  font-weight: 800;
}

.teacher-card-subtitle {
  margin: 5px 0 0;

  color: #94a3b8;

  font-size: 12px;
}

.teacher-card-header-icon {
  width: 38px;
  height: 38px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 10px;

  background: #eef2ff;

  color: #4f46e5;
}


/* =========================================================
   DESCRIPTION
========================================================= */

.teacher-playlist-description {
  color: #475569;

  font-size: 15px;
  line-height: 1.8;
}

.teacher-playlist-description p {
  margin: 0 0 10px;
}

.teacher-empty-description {
  display: flex;

  align-items: center;

  gap: 10px;

  padding: 18px;

  border-radius: 12px;

  background: #f8fafc;

  color: #94a3b8;
}


/* =========================================================
   VIDEO COUNT
========================================================= */

.teacher-playlist-video-count {
  display: flex;

  align-items: baseline;

  gap: 5px;

  color: #4f46e5;

  font-size: 20px;
  font-weight: 800;
}

.teacher-playlist-video-count span {
  color: #94a3b8;

  font-size: 12px;
  font-weight: 600;
}


/* =========================================================
   VIDEO LIST
========================================================= */

.teacher-playlist-video-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.teacher-playlist-video-item {
  display: flex;

  align-items: center;

  gap: 13px;

  padding: 14px;

  border: 1px solid #e5e7eb;
  border-radius: 13px;

  background: #fff;

  transition:
    transform .2s ease,
    border-color .2s ease,
    box-shadow .2s ease;
}

.teacher-playlist-video-item:hover {
  transform: translateX(3px);

  border-color: #c7d2fe;

  box-shadow:
    0 8px 20px rgba(15, 23, 42, .06);
}

.teacher-video-number {
  width: 30px;
  height: 30px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 8px;

  background: #f1f5f9;

  color: #64748b;

  font-size: 12px;
  font-weight: 800;
}

.teacher-video-play-icon {
  width: 40px;
  height: 40px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 10px;

  background: #eef2ff;

  color: #4f46e5;

  font-size: 20px;
}

.teacher-video-information {
  min-width: 0;
  flex: 1;
}

.teacher-video-information h3 {
  margin: 0 0 5px;

  color: #1e293b;

  font-size: 14px;
  font-weight: 700;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.teacher-video-meta {
  display: flex;

  align-items: center;

  gap: 14px;

  color: #94a3b8;

  font-size: 12px;
}

.teacher-video-meta span {
  display: inline-flex;

  align-items: center;

  gap: 5px;
}

.teacher-video-watch-btn {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  padding: 8px 11px;

  border-radius: 9px;

  background: #eef2ff;
  color: #4f46e5;

  text-decoration: none;

  font-size: 12px;
  font-weight: 700;

  transition: .2s ease;
}

.teacher-video-watch-btn:hover {
  background: #e0e7ff;
  color: #4338ca;
}


/* =========================================================
   EMPTY
========================================================= */

.teacher-playlist-empty-state {
  padding: 45px 20px;

  text-align: center;
}

.teacher-empty-icon {
  width: 60px;
  height: 60px;

  display: flex;

  align-items: center;
  justify-content: center;

  margin: 0 auto 15px;

  border-radius: 16px;

  background: #f1f5f9;

  color: #94a3b8;

  font-size: 25px;
}

.teacher-playlist-empty-state h3 {
  margin: 0 0 6px;

  color: #334155;

  font-size: 16px;
}

.teacher-playlist-empty-state p {
  margin: 0;

  color: #94a3b8;

  font-size: 13px;
}


/* =========================================================
   STATS
========================================================= */

.teacher-playlist-stat {
  display: flex;

  align-items: center;

  gap: 13px;

  padding: 13px 0;

  border-bottom: 1px solid #f1f5f9;
}

.teacher-playlist-stat:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.teacher-stat-icon {
  width: 40px;
  height: 40px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 10px;

  background: #eef2ff;

  color: #4f46e5;
}

.teacher-stat-value {
  display: block;

  color: #1e293b;

  font-size: 15px;
  font-weight: 800;
}

.teacher-stat-label {
  display: block;

  margin-top: 2px;

  color: #94a3b8;

  font-size: 11px;
}


/* =========================================================
   COURSE
========================================================= */

.teacher-course-box {
  display: flex;

  align-items: center;

  gap: 12px;

  padding: 14px;

  border-radius: 12px;

  background: #f8fafc;
}

.teacher-course-icon {
  width: 42px;
  height: 42px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 11px;

  background: #e0e7ff;

  color: #4f46e5;
}

.teacher-course-box strong {
  display: block;

  color: #334155;

  font-size: 13px;
  line-height: 1.4;
}

.teacher-course-box span {
  display: block;

  margin-top: 3px;

  color: #94a3b8;

  font-size: 11px;
}


/* =========================================================
   MANAGEMENT
========================================================= */

.teacher-manage-action {
  display: flex;

  align-items: center;

  gap: 12px;

  width: 100%;

  padding: 13px 0;

  border: 0;
  border-bottom: 1px solid #f1f5f9;

  background: transparent;

  color: #475569;

  text-decoration: none;

  text-align: left;

  cursor: pointer;

  transition:
    transform .2s ease,
    color .2s ease;
}

.teacher-manage-action:last-child {
  border-bottom: 0;
}

.teacher-manage-action > i:first-child {
  color: #6366f1;
  font-size: 17px;
}

.teacher-manage-action span {
  flex: 1;
}

.teacher-manage-action strong {
  display: block;

  color: #334155;

  font-size: 13px;
}

.teacher-manage-action small {
  display: block;

  margin-top: 2px;

  color: #94a3b8;

  font-size: 11px;
}

.teacher-manage-action > i:last-child {
  color: #cbd5e1;
}

.teacher-manage-action:hover {
  transform: translateX(3px);
}

.teacher-manage-action:hover strong {
  color: #4f46e5;
}

.teacher-delete-action:hover strong {
  color: #dc2626;
}

.teacher-delete-action:hover > i:first-child {
  color: #dc2626;
}


/* =========================================================
   DELETE MODAL
========================================================= */

.teacher-playlist-modal-overlay {
  position: fixed;

  inset: 0;

  z-index: 9999;

  display: none;

  align-items: center;
  justify-content: center;

  padding: 20px;

  background: rgba(15, 23, 42, .55);

  backdrop-filter: blur(5px);
}

.teacher-playlist-modal-overlay.active {
  display: flex;
