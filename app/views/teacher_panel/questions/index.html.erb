<div class="container-fluid py-4">

  <!-- ================= HEADER ================= -->

  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>
      <div class="text-muted small mb-1">
        Teacher Panel / Courses / Quizzes / Questions
      </div>

      <h2 class="fw-bold mb-1">
        📝 Quiz Questions
      </h2>

      <p class="text-muted mb-0">
        <strong><%= @quiz.title %></strong>
        —
        <%= @course.Course_name %>
      </p>
    </div>

    <div class="d-flex gap-2 mt-3 mt-md-0">

      <%= link_to teacher_panel_course_quizzes_path(@course),
          class: "btn btn-outline-secondary" do %>

        <i class="fas fa-arrow-left me-1"></i>
        Back to Quizzes

      <% end %>

      <%= link_to new_teacher_panel_course_quiz_question_path(
            @course,
            @quiz
          ),
          class: "btn btn-primary" do %>

        <i class="fas fa-plus me-1"></i>
        Add Question

      <% end %>

    </div>

  </div>


  <!-- ================= QUIZ INFORMATION ================= -->

  <div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-body">

      <div class="row g-3">

        <div class="col-md-3">

          <div class="p-3 bg-light rounded-3">

            <small class="text-muted d-block">
              Quiz
            </small>

            <strong>
              <%= @quiz.title %>
            </strong>

          </div>

        </div>


        <div class="col-md-3">

          <div class="p-3 bg-light rounded-3">

            <small class="text-muted d-block">
              Questions
            </small>

            <strong>
              <%= @questions.count %>
            </strong>

          </div>

        </div>


        <div class="col-md-3">

          <div class="p-3 bg-light rounded-3">

            <small class="text-muted d-block">
              Time Limit
            </small>

            <strong>
              <%= @quiz.time_limit %> minutes
            </strong>

          </div>

        </div>


        <div class="col-md-3">

          <div class="p-3 bg-light rounded-3">

            <small class="text-muted d-block">
              Passing
            </small>

            <strong>
              <%= @quiz.passing_percentage %>%
            </strong>

          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- ================= QUESTIONS ================= -->

  <% if @questions.any? %>

    <% @questions.each_with_index do |question, index| %>

      <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-4">


          <!-- Question Header -->

          <div class="d-flex justify-content-between align-items-start mb-3">

            <div class="d-flex gap-3">

              <div
                class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                style="width:42px;height:42px;min-width:42px;">

                <strong>
                  <%= index + 1 %>
                </strong>

              </div>

              <div>

                <h5 class="fw-bold mb-1">

                  <%= question.question_text %>

                </h5>

                <div class="text-muted small">

                  Position:
                  <strong>
                    <%= question.position %>
                  </strong>

                  &nbsp; | &nbsp;

                  Marks:
                  <strong>
                    <%= question.marks %>
                  </strong>

                </div>

              </div>

            </div>


            <!-- Actions -->

            <div class="dropdown">

              <button
                class="btn btn-light border"
                type="button"
                data-bs-toggle="dropdown">

                <i class="fas fa-ellipsis-v"></i>

              </button>

              <ul class="dropdown-menu dropdown-menu-end">

                <li>

                  <%= link_to teacher_panel_course_quiz_question_path(
                        @course,
                        @quiz,
                        question
                      ),
                      class: "dropdown-item" do %>

                    <i class="fas fa-eye me-2"></i>
                    View

                  <% end %>

                </li>

                <li>

                  <%= link_to edit_teacher_panel_course_quiz_question_path(
                        @course,
                        @quiz,
                        question
                      ),
                      class: "dropdown-item" do %>

                    <i class="fas fa-edit me-2"></i>
                    Edit

                  <% end %>

                </li>

                <li>
                  <hr class="dropdown-divider">
                </li>

                <li>

                  <%= button_to teacher_panel_course_quiz_question_path(
                        @course,
                        @quiz,
                        question
                      ),
                      method: :delete,
                      class: "dropdown-item text-danger",
                      form: {
                        data: {
                          turbo_confirm: "Are you sure you want to delete this question?"
                        }
                      } do %>

                    <i class="fas fa-trash me-2"></i>
                    Delete

                  <% end %>

                </li>

              </ul>

            </div>

          </div>


          <!-- ================= OPTIONS ================= -->

          <div class="mt-4">

            <h6 class="fw-bold text-muted mb-3">
              Answer Options
            </h6>


            <% question.options.order(:position).each_with_index do |option, option_index| %>

              <div
                class="d-flex align-items-center justify-content-between border rounded-3 p-3 mb-2
                <%= option.is_correct? ? 'border-success bg-success bg-opacity-10' : '' %>">

                <div class="d-flex align-items-center gap-3">

                  <span
                    class="rounded-circle border d-flex align-items-center justify-content-center
                    <%= option.is_correct? ? 'bg-success text-white border-success' : 'bg-light' %>"
                    style="width:34px;height:34px;min-width:34px;">

                    <strong>
                      <%= ('A'.ord + option_index).chr %>
                    </strong>

                  </span>


                  <span>
                    <%= option.option_text %>
                  </span>

                </div>


                <% if option.is_correct? %>

                  <span class="badge bg-success">

                    <i class="fas fa-check me-1"></i>
                    Correct Answer

                  </span>

                <% else %>

                  <span class="badge bg-light text-muted border">
                    Option
                  </span>

                <% end %>

              </div>

            <% end %>

          </div>


          <!-- ================= EXPLANATION ================= -->

          <% if question.explanation.present? %>

            <div class="alert alert-info mt-4 mb-0">

              <div class="fw-bold mb-1">

                <i class="fas fa-lightbulb me-1"></i>
                Explanation

              </div>

              <%= question.explanation %>

            </div>

          <% end %>


          <!-- ================= FOOTER ================= -->

          <div class="d-flex justify-content-end gap-2 mt-4">

            <%= link_to teacher_panel_course_quiz_question_path(
                  @course,
                  @quiz,
                  question
                ),
                class: "btn btn-outline-primary btn-sm" do %>

              <i class="fas fa-eye me-1"></i>
              View

            <% end %>


            <%= link_to edit_teacher_panel_course_quiz_question_path(
                  @course,
                  @quiz,
                  question
                ),
                class: "btn btn-outline-warning btn-sm" do %>

              <i class="fas fa-edit me-1"></i>
              Edit

            <% end %>

          </div>

        </div>

      </div>

    <% end %>


  <% else %>

    <!-- ================= EMPTY STATE ================= -->

    <div class="card border-0 shadow-sm rounded-4">

      <div class="card-body text-center py-5">

        <div
          class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3"
          style="width:80px;height:80px;">

          <i class="fas fa-question-circle fa-2x text-primary"></i>

        </div>

        <h4 class="fw-bold">
          No Questions Yet
        </h4>

        <p class="text-muted mb-4">

          This quiz does not have any questions.
          Add your first question to start building the quiz.

        </p>

        <%= link_to new_teacher_panel_course_quiz_question_path(
              @course,
              @quiz
            ),
            class: "btn btn-primary btn-lg" do %>

          <i class="fas fa-plus me-2"></i>
          Add First Question

        <% end %>

      </div>

    </div>

  <% end %>

</div>