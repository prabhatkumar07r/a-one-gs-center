<div class="container-fluid py-4">

  <!-- ==================================================
       HEADER
  ================================================== -->

  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>

      <div class="text-muted small mb-1">
        Teacher Panel / Courses / Quizzes / Questions
      </div>

      <h2 class="fw-bold mb-1">
        <i class="fas fa-circle-question text-primary me-2"></i>
        Quiz Questions
      </h2>

      <p class="text-muted mb-0">

        <strong>
          <%= @quiz.title %>
        </strong>

        <span class="mx-1">—</span>

        <%= @course.Course_name %>

      </p>

    </div>


    <!-- HEADER ACTIONS -->

    <div class="d-flex gap-2 mt-3 mt-md-0">

      <%= link_to teacher_panel_course_quizzes_path(@course),
          class: "btn btn-outline-secondary" do %>

        <i class="fas fa-arrow-left me-1"></i>
        Back to Quizzes

      <% end %>


      <%= link_to new_teacher_panel_course_quiz_question_path(
            @course,
            @quiz
          ),
          class: "btn btn-primary" do %>

        <i class="fas fa-plus me-1"></i>
        Add Question

      <% end %>

    </div>

  </div>


  <!-- ==================================================
       QUIZ INFORMATION
  ================================================== -->

  <div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-body">

      <div class="row g-3">


        <!-- QUIZ -->

        <div class="col-md-3">

          <div class="question-info-box">

            <div class="question-info-icon quiz">
              <i class="fas fa-circle-question"></i>
            </div>

            <div>

              <small class="text-muted d-block">
                Quiz
              </small>

              <strong>
                <%= @quiz.title %>
              </strong>

            </div>

          </div>

        </div>


        <!-- QUESTIONS -->

        <div class="col-md-3">

          <div class="question-info-box">

            <div class="question-info-icon questions">
              <i class="fas fa-list-ol"></i>
            </div>

            <div>

              <small class="text-muted d-block">
                Questions
              </small>

              <strong>
                <%= @questions.size %>
              </strong>

            </div>

          </div>

        </div>


        <!-- TIME -->

        <div class="col-md-3">

          <div class="question-info-box">

            <div class="question-info-icon time">
              <i class="fas fa-clock"></i>
            </div>

            <div>

              <small class="text-muted d-block">
                Time Limit
              </small>

              <strong>
                <%= @quiz.time_limit %> minutes
              </strong>

            </div>

          </div>

        </div>


        <!-- PASSING -->

        <div class="col-md-3">

          <div class="question-info-box">

            <div class="question-info-icon passing">
              <i class="fas fa-chart-line"></i>
            </div>

            <div>

              <small class="text-muted d-block">
                Passing
              </small>

              <strong>
                <%= @quiz.passing_percentage %>%
              </strong>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- ==================================================
       QUESTIONS
  ================================================== -->

  <% if @questions.any? %>

    <div class="questions-wrapper">

      <% @questions.each_with_index do |question, index| %>

        <div class="question-card">


          <!-- ==================================================
               QUESTION HEADER
          ================================================== -->

          <div class="question-card-header">


            <div class="question-heading">

              <div class="question-number">

                <%= index + 1 %>

              </div>


              <div class="question-heading-text">

                <h5>

                  <%= question.question_text %>

                </h5>


                <div class="question-meta">

                  <span>

                    <i class="fas fa-location-arrow"></i>

                    Position:
                    <strong>
                      <%= question.position %>
                    </strong>

                  </span>


                  <span class="meta-divider">
                    |
                  </span>


                  <span>

                    <i class="fas fa-star"></i>

                    Marks:
                    <strong>
                      <%= question.marks %>
                    </strong>

                  </span>

                </div>

              </div>

            </div>


            <!-- ==================================================
                 ACTION MENU
            ================================================== -->

            <div class="dropdown">

              <button
                class="btn btn-light border question-menu-btn"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">

                <i class="fas fa-ellipsis-v"></i>

              </button>


              <ul class="dropdown-menu dropdown-menu-end shadow-sm">


                <!-- VIEW -->

                <li>

                  <%= link_to teacher_panel_course_quiz_question_path(
                        @course,
                        @quiz,
                        question
                      ),
                      class: "dropdown-item" do %>

                    <i class="fas fa-eye me-2 text-primary"></i>
                    View Question

                  <% end %>

                </li>


                <!-- EDIT -->

                <li>

                  <%= link_to edit_teacher_panel_course_quiz_question_path(
                        @course,
                        @quiz,
                        question
                      ),
                      class: "dropdown-item" do %>

                    <i class="fas fa-pen me-2 text-warning"></i>
                    Edit Question

                  <% end %>

                </li>


                <li>
                  <hr class="dropdown-divider">
                </li>


                <!-- DELETE -->

                <li>

                  <%= button_to teacher_panel_course_quiz_question_path(
                        @course,
                        @quiz,
                        question
                      ),
                      method: :delete,
                      class: "dropdown-item text-danger",
                      form: {
                        data: {
                          turbo_confirm:
                            "Are you sure you want to delete this question?"
                        }
                      } do %>

                    <i class="fas fa-trash me-2"></i>
                    Delete Question

                  <% end %>

                </li>

              </ul>

            </div>

          </div>


          <!-- ==================================================
               ANSWER OPTIONS
          ================================================== -->

          <div class="answer-section">

            <div class="answer-section-title">

              <i class="fas fa-list-check"></i>

              Answer Options

            </div>


            <% options =
                 question.options
                         .order(:position)
            %>


            <% if options.any? %>

              <div class="options-grid">

                <% options.each_with_index do |option, option_index| %>

                  <% letter =
                       ('A'.ord + option_index).chr
                  %>


                  <div class="answer-option
                    <%= "correct-answer" if option.is_correct? %>">


                    <!-- LETTER -->

                    <div class="answer-letter">

                      <%= letter %>

                    </div>


                    <!-- TEXT -->

                    <div class="answer-option-text">

                      <%= option.option_text %>

                    </div>


                    <!-- CORRECT -->

                    <% if option.is_correct? %>

                      <div class="correct-badge">

                        <i class="fas fa-check"></i>

                        Correct Answer

                      </div>

                    <% end %>

                  </div>

                <% end %>

              </div>

            <% else %>

              <div class="no-options">

                <i class="fas fa-triangle-exclamation"></i>

                No answer options have been added to this question.

              </div>

            <% end %>

          </div>


          <!-- ==================================================
               EXPLANATION
          ================================================== -->

          <% if question.respond_to?(:explanation) &&
                question.explanation.present? %>

            <div class="question-explanation">

              <div class="explanation-title">

                <i class="fas fa-lightbulb"></i>

                Explanation

              </div>

              <div class="explanation-text">

                <%= question.explanation %>

              </div>

            </div>

          <% end %>


          <!-- ==================================================
               FOOTER ACTIONS
          ================================================== -->

          <div class="question-footer">

            <%= link_to teacher_panel_course_quiz_question_path(
                  @course,
                  @quiz,
                  question
                ),
                class: "btn btn-outline-primary btn-sm" do %>

              <i class="fas fa-eye me-1"></i>
              View

            <% end %>


            <%= link_to edit_teacher_panel_course_quiz_question_path(
                  @course,
                  @quiz,
                  question
                ),
                class: "btn btn-outline-warning btn-sm" do %>

              <i class="fas fa-pen me-1"></i>
              Edit

            <% end %>

          </div>

        </div>

      <% end %>

    </div>


  <% else %>

    <!-- ==================================================
         EMPTY STATE
    ================================================== -->

    <div class="empty-question-card">

      <div class="empty-question-icon">

        <i class="fas fa-circle-question"></i>

      </div>


      <h4>
        No Questions Yet
      </h4>


      <p>

        This quiz does not have any questions yet.
        Add your first question to start building the quiz.

      </p>


      <%= link_to new_teacher_panel_course_quiz_question_path(
            @course,
            @quiz
          ),
          class: "btn btn-primary btn-lg px-4" do %>

        <i class="fas fa-plus me-2"></i>

        Add First Question

      <% end %>

    </div>

  <% end %>

</div>


<!-- ==================================================
     CSS
================================================== -->

<style nonce="<%= content_security_policy_nonce %>">

/* ==================================================
   PAGE
================================================== */

.questions-wrapper {

  display: flex;

  flex-direction: column;

  gap: 18px;

}


/* ==================================================
   INFO BOX
================================================== */

.question-info-box {

  min-height: 78px;

  display: flex;

  align-items: center;

  gap: 14px;

  padding: 14px 16px;

  border-radius: 14px;

  background: #f8f9fc;

  border: 1px solid #edf0f5;

}


.question-info-icon {

  width: 44px;

  height: 44px;

  min-width: 44px;

  border-radius: 12px;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 17px;

}


.question-info-icon.quiz {

  color: #4f46e5;

  background: #eef2ff;

}


.question-info-icon.questions {

  color: #2563eb;

  background: #dbeafe;

}


.question-info-icon.time {

  color: #c2410c;

  background: #ffedd5;

}


.question-info-icon.passing {

  color: #15803d;

  background: #dcfce7;

}


.question-info-box strong {

  display: block;

  color: #111827;

  font-size: 15px;

  margin-top: 2px;

}


/* ==================================================
   QUESTION CARD
================================================== */

.question-card {

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 18px;

  box-shadow:
    0 6px 24px
    rgba(15, 23, 42, .05);

  overflow: hidden;

  transition:
    border-color .2s ease,
    box-shadow .2s ease,
    transform .2s ease;

}


.question-card:hover {

  border-color: #c7d2fe;

  box-shadow:
    0 10px 30px
    rgba(79, 70, 229, .08);

  transform: translateY(-1px);

}


/* ==================================================
   QUESTION HEADER
================================================== */

.question-card-header {

  display: flex;

  align-items: flex-start;

  justify-content: space-between;

  gap: 20px;

  padding: 22px 24px;

  border-bottom: 1px solid #eef0f4;

}


.question-heading {

  display: flex;

  align-items: flex-start;

  gap: 15px;

  min-width: 0;

}


.question-number {

  width: 44px;

  height: 44px;

  min-width: 44px;

  border-radius: 13px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #eef2ff;

  color: #4338ca;

  font-weight: 800;

  font-size: 15px;

}


.question-heading-text {

  min-width: 0;

}


.question-heading-text h5 {

  margin: 0;

  color: #111827;

  font-weight: 750;

  font-size: 16px;

  line-height: 1.55;

  word-break: break-word;

}


.question-meta {

  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 8px;

  margin-top: 7px;

  color: #6b7280;

  font-size: 12px;

}


.question-meta i {

  color: #6366f1;

  margin-right: 3px;

}


.question-meta strong {

  color: #374151;

}


.meta-divider {

  color: #d1d5db;

}


.question-menu-btn {

  width: 38px;

  height: 38px;

  padding: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 10px;

}


/* ==================================================
   ANSWER SECTION
================================================== */

.answer-section {

  padding: 22px 24px;

}


.answer-section-title {

  display: flex;

  align-items: center;

  gap: 8px;

  margin-bottom: 14px;

  color: #374151;

  font-size: 13px;

  font-weight: 800;

}


.answer-section-title i {

  color: #4f46e5;

}


/* ==================================================
   OPTIONS GRID
================================================== */

.options-grid {

  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 10px;

}


.answer-option {

  min-width: 0;

  display: flex;

  align-items: center;

  gap: 10px;

  padding: 12px;

  border: 1px solid #e5e7eb;

  border-radius: 11px;

  background: #f9fafb;

  transition: .2s ease;

}


.answer-option:hover {

  border-color: #c7d2fe;

  background: #f5f7ff;

}


.answer-letter {

  width: 30px;

  height: 30px;

  min-width: 30px;

  border-radius: 9px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #e5e7eb;

  color: #374151;

  font-size: 11px;

  font-weight: 800;

}


.answer-option-text {

  flex: 1;

  min-width: 0;

  color: #374151;

  font-size: 13px;

  line-height: 1.45;

  word-break: break-word;

}


.correct-answer {

  border-color: #86efac;

  background: #f0fdf4;

}


.correct-answer .answer-letter {

  background: #16a34a;

  color: #ffffff;

}


.correct-badge {

  flex-shrink: 0;

  display: inline-flex;

  align-items: center;

  gap: 4px;

  padding: 5px 7px;

  border-radius: 7px;

  background: #dcfce7;

  color: #15803d;

  font-size: 10px;

  font-weight: 800;

}


/* ==================================================
   NO OPTIONS
================================================== */

.no-options {

  padding: 13px 15px;

  border-radius: 10px;

  background: #fff7ed;

  color: #c2410c;

  font-size: 13px;

}


/* ==================================================
   EXPLANATION
================================================== */

.question-explanation {

  margin:
    0 24px 20px;

  padding: 15px 17px;

  border:
    1px solid #dbeafe;

  border-radius: 12px;

  background: #eff6ff;

}


.explanation-title {

  display: flex;

  align-items: center;

  gap: 7px;

  margin-bottom: 6px;

  color: #1d4ed8;

  font-size: 12px;

  font-weight: 800;

}


.explanation-text {

  color: #374151;

  font-size: 13px;

  line-height: 1.55;

}


/* ==================================================
   FOOTER
================================================== */

.question-footer {

  display: flex;

  justify-content: flex-end;

  gap: 8px;

  padding: 15px 24px;

  border-top: 1px solid #eef0f4;

  background: #fafafa;

}


/* ==================================================
   EMPTY STATE
================================================== */

.empty-question-card {

  padding: 75px 25px;

  text-align: center;

  background: #ffffff;

  border:
    1px solid #e5e7eb;

  border-radius: 18px;

  box-shadow:
    0 6px 24px
    rgba(15, 23, 42, .05);

}


.empty-question-icon {

  width: 72px;

  height: 72px;

  margin: 0 auto 18px;

  border-radius: 20px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #eef2ff;

  color: #4f46e5;

  font-size: 30px;

}


.empty-question-card h4 {

  margin-bottom: 8px;

  color: #111827;

  font-weight: 800;

}


.empty-question-card p {

  max-width: 500px;

  margin:
    0 auto 22px;

  color: #6b7280;

  font-size: 14px;

  line-height: 1.6;

}


/* ==================================================
   RESPONSIVE
================================================== */

@media (max-width: 767px) {

  .question-card-header {

    padding: 18px;

  }


  .answer-section {

    padding: 18px;

  }


  .options-grid {

    grid-template-columns: 1fr;

  }


  .question-heading {

    gap: 10px;

  }


  .question-number {

    width: 38px;

    height: 38px;

    min-width: 38px;

  }


  .question-heading-text h5 {

    font-size: 15px;

  }


  .question-meta {

    display: block;

  }


  .meta-divider {

    display: none;

  }


  .question-meta span {

    margin-right: 10px;

  }


  .question-footer {

    padding: 13px 18px;

  }


  .question-explanation {

    margin-left: 18px;

    margin-right: 18px;

  }

}

</style>