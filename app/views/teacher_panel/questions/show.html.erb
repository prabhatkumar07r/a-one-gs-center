<% content_for :show_layout, true %>

<div class="container-fluid py-4">

  <!-- ==================================================
       HEADER
  ================================================== -->

  <div class="mb-4">

    <div class="text-muted small mb-2">
      Teacher Panel / Quizzes / Question
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

      <div>

        <h2 class="fw-bold mb-1">
          <i class="fas fa-circle-question text-primary me-2"></i>
          Question Details
        </h2>

        <p class="text-muted mb-0">
          Quiz:
          <strong><%= @quiz.title %></strong>
        </p>

      </div>

      <div class="d-flex gap-2">

        <%= link_to teacher_panel_course_quiz_path(@course, @quiz),
                    class: "btn btn-outline-secondary" do %>

          <i class="fas fa-arrow-left me-1"></i>
          Back to Quiz

        <% end %>

        <%= link_to edit_teacher_panel_course_quiz_question_path(
                      @course,
                      @quiz,
                      @question
                    ),
                    class: "btn btn-primary" do %>

          <i class="fas fa-pen me-1"></i>
          Edit Question

        <% end %>

      </div>

    </div>

  </div>


  <!-- ==================================================
       QUESTION CARD
  ================================================== -->

  <div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-header question-header py-3">

      <div class="d-flex justify-content-between align-items-center">

        <h5 class="mb-0 fw-bold">

          <i class="fas fa-question-circle me-2"></i>

          Question

        </h5>

        <span class="badge bg-light text-dark px-3 py-2">

          Question #<%= @question.position %>

        </span>

      </div>

    </div>


    <div class="card-body p-4">


      <!-- QUESTION TEXT -->

      <div class="question-text mb-4">

        <%= simple_format(@question.question_text) %>

      </div>


      <!-- QUESTION INFORMATION -->

      <div class="row g-3">


        <!-- MARKS -->

        <div class="col-md-4">

          <div class="info-box">

            <div class="info-icon bg-primary">

              <i class="fas fa-star"></i>

            </div>

            <div>

              <small class="text-muted d-block">
                Marks
              </small>

              <strong>
                <%= @question.marks %>
              </strong>

            </div>

          </div>

        </div>


        <!-- POSITION -->

        <div class="col-md-4">

          <div class="info-box">

            <div class="info-icon bg-info">

              <i class="fas fa-list-ol"></i>

            </div>

            <div>

              <small class="text-muted d-block">
                Position
              </small>

              <strong>
                <%= @question.position %>
              </strong>

            </div>

          </div>

        </div>


        <!-- OPTIONS -->

        <div class="col-md-4">

          <div class="info-box">

            <div class="info-icon bg-success">

              <i class="fas fa-list-check"></i>

            </div>

            <div>

              <small class="text-muted d-block">
                Options
              </small>

              <strong>
                <%= @options.count %>
              </strong>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- ==================================================
       ANSWER OPTIONS
  ================================================== -->

  <div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-header options-header py-3">

      <div class="d-flex justify-content-between align-items-center">

        <div>

          <h5 class="mb-1 fw-bold">

            <i class="fas fa-list-check me-2"></i>

            Answer Options

          </h5>

          <small>
            The green option is the correct answer.
          </small>

        </div>

        <span class="badge bg-light text-success px-3 py-2">

          <%= @options.count %> Options

        </span>

      </div>

    </div>


    <div class="card-body p-4">


      <% if @options.any? %>

        <% @options.each_with_index do |option, index| %>

          <div class="option-card
                      <%= 'correct-option' if option.is_correct? %>">


            <!-- OPTION LETTER -->

            <div class="option-letter">

              <%= ('A'.ord + index).chr %>

            </div>


            <!-- OPTION CONTENT -->

            <div class="option-content">

              <div class="option-label">

                Option <%= ('A'.ord + index).chr %>

              </div>

              <div class="option-text">

                <%= option.text %>

              </div>

            </div>


            <!-- STATUS -->

            <div class="option-status">

              <% if option.is_correct? %>

                <span class="badge bg-success px-3 py-2">

                  <i class="fas fa-check me-1"></i>

                  Correct Answer

                </span>

              <% else %>

                <span class="badge bg-secondary px-3 py-2">

                  <i class="fas fa-minus me-1"></i>

                  Incorrect

                </span>

              <% end %>

            </div>

          </div>

        <% end %>

      <% else %>

        <div class="alert alert-warning mb-0">

          <i class="fas fa-exclamation-triangle me-2"></i>

          No answer options have been added to this question.

        </div>

      <% end %>

    </div>

  </div>


  <!-- ==================================================
       EXPLANATION
  ================================================== -->

  <% if @question.respond_to?(:explanation) &&
        @question.explanation.present? %>

    <div class="card border-0 shadow-sm rounded-4 mb-4">

      <div class="card-header explanation-header py-3">

        <h5 class="mb-0 fw-bold">

          <i class="fas fa-lightbulb me-2"></i>

          Explanation

        </h5>

      </div>

      <div class="card-body p-4">

        <div class="explanation-box">

          <%= simple_format(@question.explanation) %>

        </div>

      </div>

    </div>

  <% end %>


  <!-- ==================================================
       ACTIONS
  ================================================== -->

  <div class="card border-0 shadow-sm rounded-4">

    <div class="card-body p-4">

      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">


        <%= link_to teacher_panel_course_quiz_path(
                      @course,
                      @quiz
                    ),
                    class: "btn btn-outline-secondary" do %>

          <i class="fas fa-arrow-left me-1"></i>

          Back to Questions

        <% end %>


        <div class="d-flex gap-2">


          <%= link_to edit_teacher_panel_course_quiz_question_path(
                        @course,
                        @quiz,
                        @question
                      ),
                      class: "btn btn-primary" do %>

            <i class="fas fa-edit me-1"></i>

            Edit

          <% end %>


          <%= button_to teacher_panel_course_quiz_question_path(
                          @course,
                          @quiz,
                          @question
                        ),
                        method: :delete,
                        class: "btn btn-outline-danger",
                        data: {
                          turbo_confirm:
                          "Are you sure you want to delete this question?"
                        } do %>

            <i class="fas fa-trash me-1"></i>

            Delete

          <% end %>

        </div>

      </div>

    </div>

  </div>

</div>


<!-- ==================================================
     DESIGN
================================================== -->

<style>

.question-header {

  background:
    linear-gradient(
      135deg,
      #3f52fb,
      #6675ff
    );

  color: #ffffff;

}


.options-header {

  background:
    linear-gradient(
      135deg,
      #198754,
      #2fb477
    );

  color: #ffffff;

}


.explanation-header {

  background:
    linear-gradient(
      135deg,
      #ffc107,
      #ffca2c
    );

  color: #212529;

}


.question-text {

  font-size: 1.25rem;

  font-weight: 600;

  line-height: 1.7;

  color: #212529;

  padding: 20px;

  background:
    #f8f9fa;

  border-radius: 14px;

  border-left:
    5px solid #3f52fb;

}


.info-box {

  display: flex;

  align-items: center;

  gap: 15px;

  padding: 16px;

  background: #f8f9fa;

  border-radius: 12px;

}


.info-icon {

  width: 45px;

  height: 45px;

  border-radius: 10px;

  display: flex;

  align-items: center;

  justify-content: center;

  color: #ffffff;

}


.option-card {

  display: flex;

  align-items: center;

  gap: 15px;

  padding: 18px;

  margin-bottom: 14px;

  border: 1px solid #dee2e6;

  border-radius: 14px;

  background: #ffffff;

  transition: all 0.2s ease;

}


.option-card:hover {

  transform: translateY(-2px);

  box-shadow:
    0 5px 18px
    rgba(0,0,0,0.08);

}


.option-card.correct-option {

  border:
    2px solid #198754;

  background:
    rgba(25,135,84,0.07);

}


.option-letter {

  width: 45px;

  height: 45px;

  min-width: 45px;

  border-radius: 50%;

  background: #3f52fb;

  color: #ffffff;

  display: flex;

  align-items: center;

  justify-content: center;

  font-weight: 700;

  font-size: 17px;

}


.correct-option .option-letter {

  background: #198754;

}


.option-content {

  flex: 1;

}


.option-label {

  font-size: 12px;

  color: #6c757d;

  text-transform: uppercase;

  font-weight: 700;

  margin-bottom: 4px;

}


.option-text {

  font-size: 16px;

  font-weight: 500;

  color: #212529;

}


.option-status {

  white-space: nowrap;

}


.explanation-box {

  padding: 18px;

  background:
    #fff8e1;

  border-left:
    4px solid #ffc107;

  border-radius: 10px;

  line-height: 1.7;

}


@media (max-width: 768px) {

  .option-card {

    align-items: flex-start;

    flex-wrap: wrap;

  }


  .option-status {

    width: 100%;

    margin-left: 60px;

  }


  .question-text {

    font-size: 1rem;

  }

}

</style>