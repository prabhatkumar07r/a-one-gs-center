<div class="teacher-quiz-show-page">

  <!-- ==================================================
       HEADER
  ================================================== -->

  <div class="quiz-header">

    <div class="breadcrumb">
      <span>Teacher Panel</span>
      <i class="fas fa-chevron-right"></i>
      <span>Quizzes</span>
      <i class="fas fa-chevron-right"></i>
      <span>Quiz Details</span>
    </div>

    <div class="header-main">

      <div>

        <div class="quiz-title-row">

          <div class="quiz-icon">
            <i class="fas fa-circle-question"></i>
          </div>

          <div>

            <h1>
              <%= @quiz.title %>
            </h1>

            <p>
              <%= @course.Course_name %>
            </p>

          </div>

        </div>

      </div>

      <div class="header-actions">

        <%= link_to teacher_panel_course_quizzes_path(@course),
            class: "btn btn-outline-secondary" do %>

          <i class="fas fa-arrow-left"></i>
          Back to Quizzes

        <% end %>

        <%= link_to new_teacher_panel_course_quiz_question_path(
                      @course,
                      @quiz
                    ),
                    class: "btn btn-primary" do %>

          <i class="fas fa-plus"></i>
          Add Question

        <% end %>

      </div>

    </div>

  </div>


  <!-- ==================================================
       QUIZ INFORMATION
  ================================================== -->

  <div class="quiz-info-grid">

    <div class="info-card">

      <div class="info-icon purple">
        <i class="fas fa-list-ol"></i>
      </div>

      <div>

        <span>
          Questions
        </span>

        <strong>
          <%= @questions.count %>
        </strong>

      </div>

    </div>


    <div class="info-card">

      <div class="info-icon blue">
        <i class="fas fa-clock"></i>
      </div>

      <div>

        <span>
          Time Limit
        </span>

        <strong>
          <%= @quiz.time_limit %> min
        </strong>

      </div>

    </div>


    <div class="info-card">

      <div class="info-icon green">
        <i class="fas fa-chart-line"></i>
      </div>

      <div>

        <span>
          Passing
        </span>

        <strong>
          <%= @quiz.passing_percentage %>%
        </strong>

      </div>

    </div>


    <div class="info-card">

      <div class="info-icon orange">
        <i class="fas fa-circle-check"></i>
      </div>

      <div>

        <span>
          Status
        </span>

        <strong class="status-text">
          <%= @quiz.status %>
        </strong>

      </div>

    </div>

  </div>


  <!-- ==================================================
       QUESTIONS
  ================================================== -->

  <div class="questions-card">

    <div class="questions-header">

      <div>

        <h2>
          <i class="fas fa-list-check"></i>
          Quiz Questions
        </h2>

        <p>
          Manage questions and answer options for this quiz.
        </p>

      </div>

      <%= link_to new_teacher_panel_course_quiz_question_path(
                    @course,
                    @quiz
                  ),
                  class: "add-question-btn" do %>

        <i class="fas fa-plus"></i>
        Add Question

      <% end %>

    </div>


    <% if @questions.any? %>

      <div class="question-list">

        <% @questions.each_with_index do |question, index| %>

          <div class="question-item">

            <!-- QUESTION NUMBER -->

            <div class="question-number">

              <%= index + 1 %>

            </div>


            <!-- QUESTION CONTENT -->

            <div class="question-content">

              <div class="question-top">

                <h3>
                  <%= question.question_text %>
                </h3>

                <span class="marks-badge">

                  <%= question.marks %>
                  <%= question.marks.to_f == 1 ? "Mark" : "Marks" %>

                </span>

              </div>


              <!-- OPTIONS -->

              <% options =
                   question.options
                           .order(:position)
              %>

              <% if options.any? %>

                <div class="options-grid">

                  <% options.each do |option| %>

                    <div class="answer-option
                                <%= "correct-option-item" if option.is_correct? %>">

                      <div class="answer-letter">

                        <%= ('A'.ord + option.position.to_i - 1).chr %>

                      </div>

                      <span class="answer-text">

                        <%= option.option_text %>

                      </span>


                      <% if option.is_correct? %>

                        <span class="correct-badge">

                          <i class="fas fa-check"></i>
                          Correct

                        </span>

                      <% end %>

                    </div>

                  <% end %>

                </div>

              <% else %>

                <div class="no-options">

                  <i class="fas fa-triangle-exclamation"></i>

                  No answer options added.

                </div>

              <% end %>

            </div>


            <!-- ACTIONS -->

            <div class="question-actions">

              <%= link_to teacher_panel_course_quiz_question_path(
                            @course,
                            @quiz,
                            question
                          ),
                          class: "question-action view",
                          title: "View Question" do %>

                <i class="fas fa-eye"></i>

              <% end %>


              <%= link_to edit_teacher_panel_course_quiz_question_path(
                            @course,
                            @quiz,
                            question
                          ),
                          class: "question-action edit",
                          title: "Edit Question" do %>

                <i class="fas fa-pen"></i>

              <% end %>


              <%= button_to teacher_panel_course_quiz_question_path(
                              @course,
                              @quiz,
                              question
                            ),
                            method: :delete,
                            class: "question-action delete",
                            title: "Delete Question",
                            form: {
                              data: {
                                turbo_confirm: "Are you sure you want to delete this question?"
                              }
                            } do %>

                <i class="fas fa-trash"></i>

              <% end %>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <!-- ==================================================
           EMPTY STATE
      ================================================== -->

      <div class="empty-state">

        <div class="empty-icon">

          <i class="fas fa-circle-question"></i>

        </div>

        <h3>
          No Questions Yet
        </h3>

        <p>
          Start building this quiz by adding your first question.
        </p>

        <%= link_to new_teacher_panel_course_quiz_question_path(
                      @course,
                      @quiz
                    ),
                    class: "btn btn-primary px-4" do %>

          <i class="fas fa-plus me-1"></i>
          Add First Question

        <% end %>

      </div>

    <% end %>

  </div>

</div>


<!-- ==================================================
     CSS
================================================== -->

<style nonce="<%= content_security_policy_nonce %>">

/* ==================================================
   PAGE
================================================== */

.teacher-quiz-show-page {

  min-height: 100vh;

  padding: 30px;

  background:
    linear-gradient(
      135deg,
      #f8f9ff 0%,
      #ffffff 50%,
      #f7f8fc 100%
    );

}


/* ==================================================
   HEADER
================================================== */

.quiz-header {

  margin-bottom: 25px;

}


.breadcrumb {

  display: flex;

  align-items: center;

  gap: 9px;

  color: #6b7280;

  font-size: 13px;

  margin-bottom: 15px;

}


.breadcrumb i {

  font-size: 9px;

  color: #9ca3af;

}


.header-main {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

  flex-wrap: wrap;

}


.quiz-title-row {

  display: flex;

  align-items: center;

  gap: 15px;

}


.quiz-icon {

  width: 58px;

  height: 58px;

  border-radius: 16px;

  display: flex;

  align-items: center;

  justify-content: center;

  background:
    linear-gradient(
      135deg,
      #4f46e5,
      #7c3aed
    );

  color: #ffffff;

  font-size: 25px;

  box-shadow:
    0 8px 20px
    rgba(79, 70, 229, .20);

}


.quiz-title-row h1 {

  margin: 0;

  font-size: 28px;

  font-weight: 800;

  color: #111827;

}


.quiz-title-row p {

  margin: 4px 0 0;

  color: #6b7280;

  font-size: 14px;

}


.header-actions {

  display: flex;

  align-items: center;

  gap: 10px;

  flex-wrap: wrap;

}


/* ==================================================
   INFO GRID
================================================== */

.quiz-info-grid {

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 16px;

  margin-bottom: 25px;

}


.info-card {

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 16px;

  padding: 18px;

  display: flex;

  align-items: center;

  gap: 14px;

  box-shadow:
    0 5px 18px
    rgba(15, 23, 42, .05);

}


.info-icon {

  width: 45px;

  height: 45px;

  border-radius: 12px;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 18px;

}


.info-icon.purple {

  color: #6d28d9;

  background: #ede9fe;

}


.info-icon.blue {

  color: #2563eb;

  background: #dbeafe;

}


.info-icon.green {

  color: #15803d;

  background: #dcfce7;

}


.info-icon.orange {

  color: #c2410c;

  background: #ffedd5;

}


.info-card span {

  display: block;

  color: #6b7280;

  font-size: 12px;

  margin-bottom: 3px;

}


.info-card strong {

  color: #111827;

  font-size: 18px;

  font-weight: 800;

}


.status-text {

  color: #15803d !important;

}


/* ==================================================
   QUESTIONS CARD
================================================== */

.questions-card {

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 20px;

  overflow: hidden;

  box-shadow:
    0 8px 30px
    rgba(15, 23, 42, .06);

}


.questions-header {

  padding: 22px 25px;

  border-bottom: 1px solid #e5e7eb;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

}


.questions-header h2 {

  margin: 0 0 5px;

  font-size: 20px;

  font-weight: 800;

  color: #111827;

}


.questions-header h2 i {

  color: #4f46e5;

  margin-right: 8px;

}


.questions-header p {

  margin: 0;

  color: #6b7280;

  font-size: 13px;

}


.add-question-btn {

  display: inline-flex;

  align-items: center;

  gap: 8px;

  padding: 10px 16px;

  border-radius: 10px;

  background: #4f46e5;

  color: #ffffff;

  text-decoration: none;

  font-size: 13px;

  font-weight: 700;

  transition: .2s ease;

}


.add-question-btn:hover {

  background: #4338ca;

  color: #ffffff;

  transform: translateY(-1px);

}


/* ==================================================
   QUESTION LIST
================================================== */

.question-list {

  padding: 20px;

}


.question-item {

  position: relative;

  display: flex;

  gap: 18px;

  padding: 20px;

  margin-bottom: 15px;

  border: 1px solid #e5e7eb;

  border-radius: 16px;

  background: #ffffff;

  transition: .2s ease;

}


.question-item:last-child {

  margin-bottom: 0;

}


.question-item:hover {

  border-color: #c7d2fe;

  box-shadow:
    0 8px 25px
    rgba(79, 70, 229, .08);

}


.question-number {

  width: 42px;

  height: 42px;

  min-width: 42px;

  border-radius: 12px;

  background: #eef2ff;

  color: #4338ca;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 15px;

  font-weight: 800;

}


.question-content {

  flex: 1;

  min-width: 0;

}


.question-top {

  display: flex;

  align-items: flex-start;

  justify-content: space-between;

  gap: 15px;

  margin-bottom: 15px;

}


.question-top h3 {

  margin: 0;

  color: #111827;

  font-size: 16px;

  line-height: 1.55;

  font-weight: 700;

}


.marks-badge {

  flex-shrink: 0;

  padding: 5px 9px;

  border-radius: 8px;

  background: #f3f4f6;

  color: #4b5563;

  font-size: 11px;

  font-weight: 700;

}


/* ==================================================
   OPTIONS
================================================== */

.options-grid {

  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 10px;

}


.answer-option {

  display: flex;

  align-items: center;

  gap: 10px;

  min-width: 0;

  padding: 11px 12px;

  border: 1px solid #e5e7eb;

  border-radius: 10px;

  background: #f9fafb;

}


.answer-letter {

  width: 28px;

  height: 28px;

  min-width: 28px;

  border-radius: 8px;

  background: #e5e7eb;

  color: #374151;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 11px;

  font-weight: 800;

}


.answer-text {

  flex: 1;

  min-width: 0;

  color: #374151;

  font-size: 13px;

  line-height: 1.4;

  word-break: break-word;

}


.correct-option-item {

  border-color: #86efac;

  background: #f0fdf4;

}


.correct-option-item .answer-letter {

  background: #16a34a;

  color: #ffffff;

}


.correct-badge {

  flex-shrink: 0;

  display: inline-flex;

  align-items: center;

  gap: 4px;

  padding: 4px 7px;

  border-radius: 7px;

  background: #dcfce7;

  color: #15803d;

  font-size: 10px;

  font-weight: 800;

}


/* ==================================================
   QUESTION ACTIONS
================================================== */

.question-actions {

  display: flex;

  align-items: flex-start;

  gap: 7px;

}


.question-action {

  width: 36px;

  height: 36px;

  border: 1px solid #e5e7eb;

  border-radius: 9px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #ffffff;

  text-decoration: none;

  cursor: pointer;

  transition: .2s ease;

}


.question-action.view {

  color: #2563eb;

}


.question-action.edit {

  color: #7c3aed;

}


.question-action.delete {

  color: #dc2626;

}


.question-action:hover {

  transform: translateY(-1px);

  box-shadow:
    0 4px 12px
    rgba(15, 23, 42, .08);

}


.no-options {

  padding: 12px;

  border-radius: 10px;

  background: #fff7ed;

  color: #c2410c;

  font-size: 13px;

}


/* ==================================================
   EMPTY STATE
================================================== */

.empty-state {

  padding: 70px 25px;

  text-align: center;

}


.empty-icon {

  width: 70px;

  height: 70px;

  margin: 0 auto 18px;

  border-radius: 20px;

  background: #eef2ff;

  color: #4f46e5;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 30px;

}


.empty-state h3 {

  margin-bottom: 7px;

  font-size: 20px;

  font-weight: 800;

  color: #111827;

}


.empty-state p {

  margin-bottom: 20px;

  color: #6b7280;

  font-size: 14px;

}


/* ==================================================
   RESPONSIVE
================================================== */

@media (max-width: 1100px) {

  .quiz-info-grid {

    grid-template-columns:
      repeat(2, 1fr);

  }

}


@media (max-width: 767px) {

  .teacher-quiz-show-page {

    padding: 18px;

  }


  .quiz-title-row h1 {

    font-size: 22px;

  }


  .header-actions {

    width: 100%;

  }


  .header-actions a {

    flex: 1;

    text-align: center;

  }


  .quiz-info-grid {

    grid-template-columns: 1fr;

  }


  .questions-header {

    align-items: flex-start;

    flex-direction: column;

  }


  .add-question-btn {

    width: 100%;

    justify-content: center;

  }


  .question-item {

    flex-direction: column;

  }


  .question-actions {

    width: 100%;

    justify-content: flex-end;

  }


  .options-grid {

    grid-template-columns: 1fr;

  }


  .question-top {

    flex-direction: column;

  }

}

</style>