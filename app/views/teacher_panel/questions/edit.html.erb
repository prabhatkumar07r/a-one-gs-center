<% content_for :show_layout, true %>

<div class="container-fluid py-4">

  <!-- ==================================================
       HEADER
  ================================================== -->

  <div class="mb-4">

    <div class="text-muted small mb-2">
      Teacher Panel / Quizzes / Edit Question
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

      <div>

        <h2 class="fw-bold mb-1">
          <i class="fas fa-pen-to-square text-primary me-2"></i>
          Edit Question
        </h2>

        <p class="text-muted mb-0">
          Quiz:
          <strong>
            <%= @quiz.title %>
          </strong>
        </p>

        <p class="text-muted small mb-0">
          Course:
          <strong>
            <%= @course.Course_name %>
          </strong>
        </p>

      </div>


      <%= link_to teacher_panel_course_quiz_question_path(
            @course,
            @quiz,
            @question
          ),
          class: "btn btn-outline-secondary" do %>

        <i class="fas fa-arrow-left me-1"></i>
        Back to Question

      <% end %>

    </div>

  </div>


  <!-- ==================================================
       ERRORS
  ================================================== -->

  <% if @question.errors.any? %>

    <div class="alert alert-danger shadow-sm rounded-4 mb-4">

      <div class="fw-bold mb-2">

        <i class="fas fa-exclamation-triangle me-2"></i>

        Please fix the following errors:

      </div>

      <ul class="mb-0">

        <% @question.errors.full_messages.each do |message| %>

          <li>
            <%= message %>
          </li>

        <% end %>

      </ul>

    </div>

  <% end %>


  <!-- ==================================================
       FORM
  ================================================== -->

  <%= form_with model: @question,
                url: teacher_panel_course_quiz_question_path(
                  @course,
                  @quiz,
                  @question
                ),
                method: :patch,
                local: true,
                id: "editQuestionForm" do |form| %>


    <!-- ==================================================
         QUESTION DETAILS
    ================================================== -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

      <div class="card-header question-header">

        <h5 class="mb-0 fw-bold">

          <i class="fas fa-pen me-2"></i>

          Question Details

        </h5>

      </div>


      <div class="card-body p-4">


        <!-- QUESTION -->

        <div class="mb-4">

          <%= form.label :question_text,
                         "Question",
                         class: "form-label fw-bold" %>

          <%= form.text_area :question_text,
                             rows: 5,
                             class: "form-control question-textarea",
                             placeholder: "Enter your question...",
                             required: true %>

        </div>


        <div class="row g-3">


          <!-- MARKS -->

          <div class="col-md-6">

            <%= form.label :marks,
                           "Marks",
                           class: "form-label fw-bold" %>

            <%= form.number_field :marks,
                                  min: 0.5,
                                  step: 0.5,
                                  class: "form-control",
                                  required: true %>

          </div>


          <!-- POSITION -->

          <div class="col-md-6">

            <%= form.label :position,
                           "Question Position",
                           class: "form-label fw-bold" %>

            <%= form.number_field :position,
                                  min: 1,
                                  step: 1,
                                  class: "form-control",
                                  required: true %>

          </div>

        </div>


        <!-- ==================================================
             EXPLANATION
        ================================================== -->

        <% if @question.respond_to?(:explanation) %>

          <div class="mt-4">

            <%= form.label :explanation,
                           "Explanation",
                           class: "form-label fw-bold" %>

            <%= form.text_area :explanation,
                               rows: 4,
                               class: "form-control",
                               placeholder:
                               "Explain why the correct answer is correct..." %>

          </div>

        <% end %>

      </div>

    </div>


    <!-- ==================================================
         ANSWER OPTIONS
    ================================================== -->

    <div class="card border-0 shadow-sm rounded-4 mb-4">

      <div class="card-header options-header">

        <div class="d-flex justify-content-between align-items-center">

          <div>

            <h5 class="mb-1 fw-bold">

              <i class="fas fa-list-check me-2"></i>

              Answer Options

            </h5>

            <small>
              Select exactly one correct answer.
            </small>

          </div>


          <span class="badge bg-light text-success">
            <%= @question.options.size %> Options
          </span>

        </div>

      </div>


      <div class="card-body p-4">


        <div class="alert alert-info rounded-3 mb-4">

          <i class="fas fa-circle-info me-2"></i>

          Update the options below and select exactly one
          option as the correct answer.

        </div>


        <!-- ==================================================
             NESTED OPTIONS
        ================================================== -->

        <%= form.fields_for :options do |option_form| %>

          <% index = option_form.index.to_i %>

          <% letter = ('A'.ord + index).chr %>

          <% correct = option_form.object.is_correct? %>


          <div
            class="option-box
                   <%= 'selected-option' if correct %>"
            data-option-index="<%= index %>">


            <div class="row align-items-center g-3">


              <!-- ==================================================
                   OPTION LETTER
              ================================================== -->

              <div class="col-md-1 col-2 text-center">

                <div class="option-number">

                  <%= letter %>

                </div>

              </div>


              <!-- ==================================================
                   OPTION TEXT
              ================================================== -->

              <div class="col-md-8 col-10">

                <%= option_form.label :option_text,
                                      "Option #{letter}",
                                      class: "form-label fw-bold" %>

                <%= option_form.text_field :option_text,
                                           class: "form-control option-input",
                                           placeholder:
                                           "Enter option #{letter}",
                                           autocomplete: "off",
                                           required: true %>

              </div>


              <!-- ==================================================
                   CORRECT ANSWER
              ================================================== -->

              <div class="col-md-3">

                <div class="correct-answer-wrapper">

                  <input
                    type="radio"
                    name="correct_option"
                    value="<%= index %>"
                    id="correct_option_<%= index %>"
                    class="correct-option"
                    <%= "checked" if correct %>>

                  <label
                    for="correct_option_<%= index %>"
                    class="correct-label">

                    <span class="radio-circle"></span>

                    <span>
                      Correct Answer
                    </span>

                  </label>

                </div>


                <!-- ==================================================
                     DATABASE VALUE
                ================================================== -->

                <%= option_form.hidden_field :is_correct,
                                             value: correct ? "true" : "false",
                                             class: "correct-value" %>


                <!-- ==================================================
                     POSITION
                ================================================== -->

                <%= option_form.hidden_field :position,
                                             value:
                                             option_form.object.position ||
                                             index + 1 %>


                <!-- ==================================================
                     EXISTING OPTION ID
                ================================================== -->

                <% if option_form.object.persisted? %>

                  <%= option_form.hidden_field :id %>

                <% end %>

              </div>

            </div>

          </div>

        <% end %>


        <!-- ==================================================
             CORRECT ANSWER WARNING
        ================================================== -->

        <div
          id="correctAnswerWarning"
          class="alert alert-warning rounded-3 d-none mb-0">

          <i class="fas fa-triangle-exclamation me-2"></i>

          Please select exactly one correct answer.

        </div>

      </div>

    </div>


    <!-- ==================================================
         ACTIONS
    ================================================== -->

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">


      <%= link_to teacher_panel_course_quiz_question_path(
            @course,
            @quiz,
            @question
          ),
          class: "btn btn-outline-secondary btn-lg" do %>

        <i class="fas fa-times me-1"></i>

        Cancel

      <% end %>


      <%= form.submit "Update Question",
                      class: "btn btn-success btn-lg px-5",
                      id: "updateQuestionBtn" %>

    </div>


  <% end %>

</div>

<!-- ==================================================
     JAVASCRIPT
================================================== -->

<script nonce="<%= content_security_policy_nonce %>">

(function () {

  /* =========================================================
     EDIT QUESTION
     TURBO SAFE + DUPLICATE SAFE
  ========================================================= */

  function initializeEditQuestionForm() {

    const form =
      document.getElementById("editQuestionForm");

    const radios =
      document.querySelectorAll(".correct-option");

    const boxes =
      document.querySelectorAll(".option-box");

    const warning =
      document.getElementById("correctAnswerWarning");


    if (!form && !radios.length) {
      return;
    }


    /* =======================================================
       UPDATE CORRECT ANSWER
    ======================================================= */

    function updateCorrectAnswer(selectedRadio) {

      radios.forEach(function (radio) {

        const box =
          radio.closest(".option-box");

        if (!box) {
          return;
        }


        const hidden =
          box.querySelector(".correct-value");


        if (radio === selectedRadio) {

          if (hidden) {
            hidden.value = "true";
          }

          box.classList.add(
            "selected-option"
          );

        } else {

          if (hidden) {
            hidden.value = "false";
          }

          box.classList.remove(
            "selected-option"
          );

        }

      });

    }


    /* =======================================================
       RADIO CHANGE
    ======================================================= */

    radios.forEach(function (radio) {

      if (
        radio.dataset.correctInitialized === "true"
      ) {
        return;
      }

      radio.dataset.correctInitialized = "true";


      radio.addEventListener(
        "change",
        function () {

          updateCorrectAnswer(this);

          if (warning) {

            warning.classList.add(
              "d-none"
            );

          }

        }
      );

    });


    /* =======================================================
       RESTORE CURRENT CORRECT ANSWER
    ======================================================= */

    const checkedRadio =
      document.querySelector(
        ".correct-option:checked"
      );


    if (checkedRadio) {

      updateCorrectAnswer(
        checkedRadio
      );

    }


    /* =======================================================
       FORM SUBMIT
    ======================================================= */

    if (
      form &&
      form.dataset.correctAnswerInitialized !== "true"
    ) {

      form.dataset.correctAnswerInitialized =
        "true";


      form.addEventListener(
        "submit",
        function (event) {

          const selected =
            form.querySelector(
              ".correct-option:checked"
            );


          /* -----------------------------------------------
             NO CORRECT ANSWER
          ----------------------------------------------- */

          if (!selected) {

            event.preventDefault();


            if (warning) {

              warning.classList.remove(
                "d-none"
              );

            }


            alert(
              "Please select one correct answer before updating the question."
            );


            return;

          }


          /* -----------------------------------------------
             SYNCHRONIZE DATABASE VALUES
          ----------------------------------------------- */

          updateCorrectAnswer(
            selected
          );


          if (warning) {

            warning.classList.add(
              "d-none"
            );

          }

        }
      );

    }

  }


  /* =========================================================
     TURBO NAVIGATION
  ========================================================= */

  document.addEventListener(
    "turbo:load",
    initializeEditQuestionForm
  );


  /* =========================================================
     INITIAL PAGE LOAD
  ========================================================= */

  if (document.readyState !== "loading") {

    initializeEditQuestionForm();

  } else {

    document.addEventListener(
      "DOMContentLoaded",
      initializeEditQuestionForm,
      { once: true }
    );

  }

})();

</script>


<!-- ==================================================
     CSS
================================================== -->

<style nonce="<%= content_security_policy_nonce %>">

/* ==================================================
   QUESTION HEADER
================================================== */

.question-header {

  padding: 16px 20px;

  background:
    linear-gradient(
      135deg,
      #3f52fb,
      #6675ff
    );

  color: #ffffff;

}


/* ==================================================
   OPTIONS HEADER
================================================== */

.options-header {

  padding: 16px 20px;

  background:
    linear-gradient(
      135deg,
      #198754,
      #2fb477
    );

  color: #ffffff;

}


/* ==================================================
   QUESTION TEXTAREA
================================================== */

.question-textarea {

  min-height: 130px;

  resize: vertical;

}


/* ==================================================
   OPTION BOX
================================================== */

.option-box {

  position: relative;

  padding: 18px;

  margin-bottom: 14px;

  background: #ffffff;

  border:
    1px solid #dee2e6;

  border-radius: 16px;

  transition:
    border-color .2s ease,
    background .2s ease,
    box-shadow .2s ease,
    transform .2s ease;

}


.option-box:hover {

  border-color: #a5b4fc;

  background: #fafbff;

  box-shadow:
    0 7px 22px
    rgba(15, 23, 42, .06);

  transform: translateY(-1px);

}


.option-box.selected-option {

  border:
    2px solid #198754;

  background:
    rgba(25, 135, 84, .055);

  box-shadow:
    0 7px 22px
    rgba(25, 135, 84, .10);

}


/* ==================================================
   OPTION NUMBER
================================================== */

.option-number {

  width: 44px;

  height: 44px;

  border-radius: 50%;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  background: #3f52fb;

  color: #ffffff;

  font-weight: 800;

  font-size: 16px;

  transition:
    background .2s ease,
    transform .2s ease;

}


.selected-option .option-number {

  background: #198754;

  transform: scale(1.04);

}


/* ==================================================
   OPTION INPUT
================================================== */

.option-input {

  min-height: 45px;

  border-radius: 10px;

}


.option-input:focus {

  border-color: #3f52fb;

  box-shadow:
    0 0 0 .2rem
    rgba(63, 82, 251, .14);

}


/* ==================================================
   CORRECT ANSWER WRAPPER
================================================== */

.correct-answer-wrapper {

  min-height: 45px;

  display: flex;

  align-items: center;

}


/* ==================================================
   HIDDEN RADIO
================================================== */

.correct-option {

  position: absolute;

  width: 1px;

  height: 1px;

  opacity: 0;

  pointer-events: none;

}


/* ==================================================
   CORRECT LABEL
================================================== */

.correct-label {

  display: inline-flex;

  align-items: center;

  gap: 9px;

  padding: 10px 12px;

  border-radius: 10px;

  color: #6b7280;

  font-size: 13px;

  font-weight: 700;

  cursor: pointer;

  user-select: none;

  transition:
    all .2s ease;

}


.correct-label:hover {

  color: #198754;

  background:
    rgba(25, 135, 84, .08);

}


/* ==================================================
   RADIO CIRCLE
================================================== */

.radio-circle {

  width: 21px;

  height: 21px;

  min-width: 21px;

  border:
    2px solid #adb5bd;

  border-radius: 50%;

  background: #ffffff;

  position: relative;

  transition:
    all .2s ease;

}


.correct-option:checked + .correct-label {

  color: #198754;

  background:
    rgba(25, 135, 84, .08);

}


.correct-option:checked + .correct-label .radio-circle {

  border-color: #198754;

}


.correct-option:checked + .correct-label .radio-circle::after {

  content: "";

  position: absolute;

  width: 10px;

  height: 10px;

  left: 3px;

  top: 3px;

  border-radius: 50%;

  background: #198754;

}


/* ==================================================
   FORM CONTROL
================================================== */

.form-control {

  border-radius: 10px;

}


.form-control:focus {

  border-color: #3f52fb;

  box-shadow:
    0 0 0 .2rem
    rgba(63, 82, 251, .15);

}


/* ==================================================
   BUTTONS
================================================== */

.btn {

  border-radius: 10px;

}


/* ==================================================
   RESPONSIVE
================================================== */

@media (max-width: 768px) {

  .option-box {

    padding: 15px;

  }


  .option-number {

    margin-bottom: 5px;

  }


  .correct-answer-wrapper {

    margin-top: 4px;

  }


  .correct-label {

    width: 100%;

    justify-content: flex-start;

  }

}

</style>