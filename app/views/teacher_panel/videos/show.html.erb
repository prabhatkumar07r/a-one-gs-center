<div class="container">

  <div class="card shadow border-0">

    <div class="card-body">

      <h2 class="fw-bold">
        🎥 <%= @video.title %>
      </h2>


      <hr>


      <p>
        <strong>Course:</strong>
        <%= @video.course.Course_name %>
      </p>


      <p>
        <strong>Duration:</strong>
        <%= @video.duration || "-" %>
      </p>


      <p>
        <strong>Description:</strong>
        <%= @video.description || "No description" %>
      </p>



      <% if @video.video_url.present? %>

        <div class="ratio ratio-16x9">

              <iframe
            src="https://www.youtube.com/embed/<%= @video.video_url.split('/').last.split('?').first %>"
            title="YouTube video"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen>
          </iframe>
        </div>

         <% else %>

        <div class="alert alert-warning">
          Video URL not available.
        </div>

      <% end %>

  

      <div class="mt-3">

        <%= link_to "Back",
         teacher_panel_course_videos_path(@course),
         class: "btn btn-secondary" %>


        <%= link_to "Edit",
          edit_teacher_panel_course_video_path(@course, @video),
          class:"btn btn-warning" %>

      </div>


    </div>

  </div>

</div>