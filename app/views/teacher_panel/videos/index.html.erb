  opacity: 1 !important;

  color: #94a3b8 !important;
}

.teacher-videos-page .videos-title-icon {
  opacity: 1 !important;
}


/* =========================================================
   BREADCRUMB
========================================================= */

.teacher-videos-page .custom-breadcrumb,
.teacher-videos-page .custom-breadcrumb * {
  opacity: 1 !important;

  filter: none !important;
}

.teacher-videos-page .custom-breadcrumb .breadcrumb-item {
  color: #94a3b8 !important;
}

.teacher-videos-page .custom-breadcrumb a {
  color: #a78bfa !important;
}

.teacher-videos-page
.custom-breadcrumb
.breadcrumb-item.active {
  color: #c4b5fd !important;
}
</style>


<div class="teacher-videos-page">

  <!-- =====================================================
       BREADCRUMB
  ====================================================== -->

  <nav aria-label="breadcrumb" class="custom-breadcrumb">

    <ol class="breadcrumb">

      <li class="breadcrumb-item">

        <%= link_to teacher_dashboard_path do %>

          <i class="bi bi-house-door-fill"></i>
          Dashboard

        <% end %>

      </li>

      <li class="breadcrumb-item">

        <%= link_to teacher_panel_courses_path do %>

          <i class="bi bi-journal-bookmark-fill"></i>
          My Courses

        <% end %>

      </li>

      <li class="breadcrumb-item">

        <%= link_to teacher_panel_course_path(@course) do %>

          <i class="bi bi-book-fill"></i>
          <%= @course.Course_name %>

        <% end %>

      </li>

      <li class="breadcrumb-item active" aria-current="page">

        <i class="bi bi-camera-video-fill"></i>
        Videos

      </li>

    </ol>

  </nav>


  <!-- =====================================================
       PAGE HEADER
  ====================================================== -->

  <div class="videos-page-header">

    <div class="videos-page-title">

      <div class="videos-title-icon">

        <i class="bi bi-camera-video-fill"></i>

      </div>

      <div>

        <h2>
          My Videos
        </h2>

        <p>
          Manage videos of your assigned courses.
        </p>

      </div>

    </div>


    <%= link_to new_teacher_panel_course_video_path(@course),
        class: "add-video-btn" do %>

      <i class="bi bi-plus-lg"></i>

      Add Video

    <% end %>

  </div>


  <!-- =====================================================
       STATISTICS
  ====================================================== -->

  <div class="video-stats">

    <!-- Total -->

    <div class="video-stat-card">

      <div class="video-stat-top">

        <div class="video-stat-icon total">

          <i class="bi bi-camera-video-fill"></i>

        </div>

        <div class="video-stat-info">

          <div class="video-stat-label">
            Total Videos
          </div>

          <div class="video-stat-number">
            <%= @videos.count %>
          </div>

        </div>

      </div>

    </div>


    <!-- Active -->

    <div class="video-stat-card">

      <div class="video-stat-top">

        <div class="video-stat-icon active">

          <i class="bi bi-check-circle-fill"></i>

        </div>

        <div class="video-stat-info">

          <div class="video-stat-label">
            Active Videos
          </div>

          <div class="video-stat-number">

            <%= @videos.count { |video|
                  video.status.to_s.downcase == "active"
                } %>

          </div>

        </div>

      </div>

    </div>


    <!-- Duration -->

    <div class="video-stat-card">

      <div class="video-stat-top">

        <div class="video-stat-icon duration">

          <i class="bi bi-clock-fill"></i>

        </div>

        <div class="video-stat-info">

          <div class="video-stat-label">
            With Duration
          </div>

          <div class="video-stat-number">

            <%= @videos.count { |video|
                  video.duration.present?
                } %>

          </div>

        </div>

      </div>

    </div>


    <!-- Inactive -->

    <div class="video-stat-card">

      <div class="video-stat-top">

        <div class="video-stat-icon inactive">

          <i class="bi bi-pause-circle-fill"></i>

        </div>

        <div class="video-stat-info">

          <div class="video-stat-label">
            Inactive Videos
          </div>

          <div class="video-stat-number">

            <%= @videos.count { |video|
                  video.status.to_s.downcase != "active"
                } %>

          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- =====================================================
       SEARCH / FILTER
  ====================================================== -->

  <div class="video-filter-card">

    <div class="video-search">

      <i class="bi bi-search"></i>

      <input
        type="text"
        id="teacherVideoSearch"
        placeholder="Search videos..."
        autocomplete="off"
      >

    </div>


    <select
      class="video-filter-select"
      id="teacherVideoStatusFilter"
    >

      <option value="all">
        All Status
      </option>

      <option value="active">
        Active
      </option>

      <option value="inactive">
        Inactive
      </option>

    </select>

  </div>


  <!-- =====================================================
       VIDEO TABLE
  ====================================================== -->

  <div class="videos-card">

    <div class="table-responsive">

      <table class="table videos-table">

        <thead>

          <tr>

            <th>#</th>

            <th>Video</th>

            <th>Course</th>

            <th>Duration</th>

            <th>Status</th>

            <th>Actions</th>

          </tr>

        </thead>


        <tbody id="teacherVideosTableBody">

          <% if @videos.any? %>

            <% @videos.each_with_index do |video, index| %>

              <tr
                class="teacher-video-row"
                data-video-title="<%= video.title.to_s.downcase %>"
                data-video-status="<%= video.status.to_s.downcase == 'active' ? 'active' : 'inactive' %>"
              >

                <!-- NUMBER -->

                <td class="video-number">

                  <%= index + 1 %>

                </td>


                <!-- VIDEO -->

                <td>

                  <div class="video-title-wrapper">

                    <div class="video-title-icon">

                      <i class="bi bi-play-fill"></i>

                    </div>

                    <div class="video-title-content">

                      <div
                        class="video-title"
                        title="<%= video.title %>"
                      >

                        <%= video.title %>

                      </div>

                      <div class="video-subtitle">

                        Video Lesson

                      </div>

                    </div>

                  </div>

                </td>


                <!-- COURSE -->

                <td>

                  <div class="video-course">

                    <i class="bi bi-book-fill"></i>

                    <span title="<%= video.course&.Course_name %>">

                      <%= video.course&.Course_name || "N/A" %>

                    </span>

                  </div>

                </td>


                <!-- DURATION -->

                <td>

                  <div class="video-duration">

                    <i class="bi bi-clock"></i>

                    <%= video.duration.presence || "-" %>

                  </div>

                </td>


                <!-- STATUS -->

                <td>

                  <% if video.status.to_s.downcase == "active" %>

                    <span class="video-status status-active">

                      <span class="video-status-dot"></span>

                      Active

                    </span>

                  <% else %>

                    <span class="video-status status-inactive">

                      <span class="video-status-dot"></span>

                      Inactive

                    </span>

                  <% end %>

                </td>


                <!-- ACTIONS -->

                <td>

                  <div class="video-actions">

                    <!-- VIEW -->

                    <%= link_to teacher_panel_course_video_path(
                          @course,
                          video
                        ),
                        class: "video-action view",
                        title: "View Video" do %>

                      <i class="bi bi-eye-fill"></i>

                    <% end %>


                    <!-- EDIT -->

                    <%= link_to edit_teacher_panel_course_video_path(
                          @course,
                          video
                        ),
                        class: "video-action edit",
                        title: "Edit Video" do %>

                      <i class="bi bi-pencil-fill"></i>

                    <% end %>


                    <!-- DELETE -->

                    <%= link_to teacher_panel_course_video_path(
                          @course,
                          video
                        ),
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "Delete this video?"
                        },
                        class: "video-action delete",
                        title: "Delete Video" do %>

                      <i class="bi bi-trash-fill"></i>

                    <% end %>

                  </div>

                </td>

              </tr>

            <% end %>

          <% else %>

            <tr>

              <td
                colspan="6"
                class="videos-empty"
              >

                <div class="videos-empty-icon">

                  <i class="bi bi-camera-video-off"></i>

                </div>

                <h5>
                  No Videos Available
                </h5>

                <p>
                  No videos have been added to this course yet.
                </p>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>


    <!-- ===================================================
         FOOTER
    ==================================================== -->

    <% if @videos.any? %>

      <div class="videos-table-footer">

        <div class="videos-result-count"
             id="teacherVideoResultCount">

          Showing <%= @videos.count %>
          <%= @videos.count == 1 ? "video" : "videos" %>

        </div>

      </div>

    <% end %>

  </div>

</div>

<script nonce="<%= content_security_policy_nonce %>">
(function () {
  "use strict";

  function initializeTeacherVideoFilter() {

    const searchInput =
      document.getElementById("teacherVideoSearch");

    const statusFilter =
      document.getElementById("teacherVideoStatusFilter");

    const resultCount =
      document.getElementById("teacherVideoResultCount");

    const rows =
      document.querySelectorAll(".teacher-video-row");


    /*
      Page par required elements nahi hain
      to initialization stop kar do.
    */
    if (!searchInput && !statusFilter && !rows.length) {
      return;
    }


    /*
      Duplicate event listeners prevent karne ke liye
    */
    if (
      searchInput &&
      searchInput.dataset.videoSearchInitialized === "true" &&
      statusFilter &&
      statusFilter.dataset.videoStatusInitialized === "true"
    ) {
      return;
    }


    function filterVideos() {

      const search =
        searchInput
          ? searchInput.value
              .trim()
              .toLowerCase()
          : "";

      const status =
        statusFilter
          ? statusFilter.value
          : "all";

      let visibleCount = 0;


      rows.forEach(function (row) {

        const title =
          (row.dataset.videoTitle || "")
            .toLowerCase();

        const rowStatus =
          row.dataset.videoStatus || "";


        const matchesSearch =
          title.includes(search);

        const matchesStatus =
          status === "all" ||
          rowStatus === status;


        if (
          matchesSearch &&
          matchesStatus
        ) {

          row.style.display = "";

          visibleCount++;

        } else {

          row.style.display = "none";

        }

      });


      if (resultCount) {

        resultCount.textContent =
          "Showing " +
          visibleCount +
          " " +
          (visibleCount === 1
            ? "video"
            : "videos");

      }

    }


    /*
      Search listener
    */
    if (
      searchInput &&
      searchInput.dataset.videoSearchInitialized !== "true"
    ) {

      searchInput.dataset.videoSearchInitialized = "true";

      searchInput.addEventListener(
        "input",
        filterVideos
      );

    }


    /*
      Status filter listener
    */
    if (
      statusFilter &&
      statusFilter.dataset.videoStatusInitialized !== "true"
    ) {

      statusFilter.dataset.videoStatusInitialized = "true";

      statusFilter.addEventListener(
        "change",
        filterVideos
      );

    }


    /*
      Initial filtering
      page load par result count bhi correct rahega
    */
    filterVideos();
  }


  /*
    Turbo navigation support
  */
  document.addEventListener(
    "turbo:load",
    initializeTeacherVideoFilter
  );


  /*
    Normal browser load support
  */
  if (document.readyState !== "loading") {

    initializeTeacherVideoFilter();

  } else {

    document.addEventListener(
      "DOMContentLoaded",
      initializeTeacherVideoFilter,
      { once: true }
    );

  }

})();
</script>