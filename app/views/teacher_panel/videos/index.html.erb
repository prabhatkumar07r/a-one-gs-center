
<style nonce="<%= content_security_policy_nonce %>">
/* =========================================================
   TEACHER VIDEOS PAGE
   MODERN DARK / PURPLE DASHBOARD
   Fully scoped to .teacher-videos-page
========================================================= */

.teacher-videos-page {
  --tv-primary: #7c3aed;
  --tv-primary-2: #6366f1;
  --tv-purple-light: #a78bfa;
  --tv-blue: #3b82f6;
  --tv-green: #10b981;
  --tv-yellow: #f59e0b;
  --tv-red: #ef4444;

  --tv-bg: #07111f;
  --tv-bg-2: #0a1628;
  --tv-card: #0d1b30;
  --tv-card-2: #10213a;

  --tv-border: rgba(148, 163, 184, 0.14);
  --tv-text: #f8fafc;
  --tv-text-2: #e2e8f0;
  --tv-muted: #94a3b8;
  --tv-muted-2: #64748b;

  width: 100%;
  min-height: calc(100vh - 70px);
  padding: 25px;
  box-sizing: border-box;

  color: var(--tv-text);

  background:
    radial-gradient(
      circle at top right,
      rgba(124, 58, 237, 0.12),
      transparent 30%
    ),
    radial-gradient(
      circle at bottom left,
      rgba(37, 99, 235, 0.08),
      transparent 30%
    );
}


/* =========================================================
   BREADCRUMB
========================================================= */

.teacher-videos-page .custom-breadcrumb {
  padding: 0;
  margin: 0 0 22px;
  background: transparent;
  border: 0;
}

.teacher-videos-page .custom-breadcrumb .breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  padding: 0;
  margin: 0;

  background: transparent;
}

.teacher-videos-page .custom-breadcrumb .breadcrumb-item {
  display: flex;
  align-items: center;

  font-size: 13px;
  font-weight: 500;

  color: var(--tv-muted);
}

.teacher-videos-page
.custom-breadcrumb
.breadcrumb-item
+ .breadcrumb-item::before {

  content: "›";

  padding: 0 10px;

  color: #475569;

  font-size: 18px;
  font-weight: 400;
}

.teacher-videos-page .custom-breadcrumb .breadcrumb-item a {

  display: inline-flex;
  align-items: center;
  gap: 6px;

  color: #a5b4fc;

  text-decoration: none;

  transition: color .2s ease;
}

.teacher-videos-page .custom-breadcrumb .breadcrumb-item a:hover {
  color: #c4b5fd;
}

.teacher-videos-page .custom-breadcrumb .breadcrumb-item.active {
  color: var(--tv-purple-light);
  font-weight: 600;
}

.teacher-videos-page .custom-breadcrumb i {
  font-size: 13px;
}


/* =========================================================
   PAGE HEADER
========================================================= */

.teacher-videos-page .videos-page-header {

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 25px;
}

.teacher-videos-page .videos-page-title {

  display: flex;
  align-items: center;

  gap: 15px;

  min-width: 0;
}

.teacher-videos-page .videos-title-icon {

  width: 58px;
  height: 58px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      rgba(124, 58, 237, .95),
      rgba(79, 70, 229, .85)
    );

  border: 1px solid rgba(167, 139, 250, .35);

  box-shadow:
    0 10px 30px rgba(124, 58, 237, .20);
}

.teacher-videos-page .videos-title-icon i {

  font-size: 25px;

  color: #fff;
}

.teacher-videos-page .videos-page-title h2 {

  margin: 0;

  color: var(--tv-text);

  font-size: 30px;
  font-weight: 750;

  letter-spacing: -.5px;
}

.teacher-videos-page .videos-page-title p {

  margin: 5px 0 0;

  color: var(--tv-muted);

  font-size: 13px;
}


/* =========================================================
   ADD VIDEO BUTTON
========================================================= */

.teacher-videos-page .add-video-btn {

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  min-height: 44px;

  padding: 0 18px;

  border: 0;
  border-radius: 10px;

  color: #fff;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #6366f1
    );

  font-size: 14px;
  font-weight: 700;

  text-decoration: none;

  box-shadow:
    0 8px 24px rgba(124, 58, 237, .25);

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    filter .2s ease;
}

.teacher-videos-page .add-video-btn:hover {

  color: #fff;

  transform: translateY(-2px);

  filter: brightness(1.08);

  box-shadow:
    0 12px 30px rgba(124, 58, 237, .35);
}

.teacher-videos-page .add-video-btn i {
  font-size: 17px;
}


/* =========================================================
   STATISTICS
========================================================= */

.teacher-videos-page .video-stats {

  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 16px;

  margin-bottom: 20px;
}

.teacher-videos-page .video-stat-card {

  position: relative;

  min-height: 112px;

  padding: 17px;

  overflow: hidden;

  border: 1px solid var(--tv-border);

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      rgba(13, 27, 48, .98),
      rgba(10, 22, 40, .98)
    );

  box-sizing: border-box;

  transition:
    transform .2s ease,
    border-color .2s ease;
}

.teacher-videos-page .video-stat-card:hover {

  transform: translateY(-2px);

  border-color:
    rgba(167, 139, 250, .35);
}

.teacher-videos-page .video-stat-card::after {

  content: "";

  position: absolute;

  width: 100px;
  height: 100px;

  right: -35px;
  bottom: -50px;

  border-radius: 50%;

  background: rgba(124, 58, 237, .08);

  pointer-events: none;
}

.teacher-videos-page .video-stat-top {

  display: flex;
  align-items: center;

  gap: 12px;
}

.teacher-videos-page .video-stat-icon {

  width: 43px;
  height: 43px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 11px;

  font-size: 19px;
}

.teacher-videos-page .video-stat-icon.total {

  color: #c4b5fd;

  background:
    rgba(124, 58, 237, .20);

  border:
    1px solid rgba(167, 139, 250, .22);
}

.teacher-videos-page .video-stat-icon.active {

  color: #6ee7b7;

  background:
    rgba(16, 185, 129, .15);

  border:
    1px solid rgba(16, 185, 129, .22);
}

.teacher-videos-page .video-stat-icon.duration {

  color: #93c5fd;

  background:
    rgba(59, 130, 246, .15);

  border:
    1px solid rgba(59, 130, 246, .22);
}

.teacher-videos-page .video-stat-icon.inactive {

  color: #fcd34d;

  background:
    rgba(245, 158, 11, .13);

  border:
    1px solid rgba(245, 158, 11, .20);
}

.teacher-videos-page .video-stat-info {
  min-width: 0;
}

.teacher-videos-page .video-stat-label {

  margin-bottom: 3px;

  color: var(--tv-muted);

  font-size: 11px;
  font-weight: 500;
}

.teacher-videos-page .video-stat-number {

  color: var(--tv-text);

  font-size: 25px;
  font-weight: 750;

  line-height: 1.1;
}


/* =========================================================
   FILTER / SEARCH CARD
========================================================= */

.teacher-videos-page .video-filter-card {

  display: flex;
  align-items: center;

  gap: 12px;

  padding: 13px;

  margin-bottom: 16px;

  border: 1px solid var(--tv-border);

  border-radius: 13px;

  background:
    rgba(13, 27, 48, .95);

  box-shadow:
    0 8px 25px rgba(0, 0, 0, .12);
}

.teacher-videos-page .video-search {

  position: relative;

  flex: 1;

  min-width: 180px;
}

.teacher-videos-page .video-search i {

  position: absolute;

  left: 13px;
  top: 50%;

  transform: translateY(-50%);

  color: var(--tv-muted-2);

  font-size: 15px;

  pointer-events: none;
}

.teacher-videos-page .video-search input {

  width: 100%;
  height: 42px;

  padding:
    0 14px 0 38px;

  border:
    1px solid rgba(148, 163, 184, .15);

  border-radius: 9px;

  outline: none;

  color: var(--tv-text);

  background: #0a1830;

  font-size: 13px;

  box-sizing: border-box;

  transition:
    border-color .2s ease,
    box-shadow .2s ease;
}

.teacher-videos-page .video-search input::placeholder {
  color: #64748b;
}

.teacher-videos-page .video-search input:focus {

  border-color:
    rgba(124, 58, 237, .65);

  box-shadow:
    0 0 0 3px rgba(124, 58, 237, .10);
}

.teacher-videos-page .video-filter-select {

  width: 170px;
  height: 42px;

  padding: 0 12px;

  border:
    1px solid rgba(148, 163, 184, .15);

  border-radius: 9px;

  outline: none;

  color: var(--tv-text);

  background: #0a1830;

  font-size: 13px;

  cursor: pointer;
}

.teacher-videos-page .video-filter-select:focus {

  border-color:
    rgba(124, 58, 237, .65);

  box-shadow:
    0 0 0 3px rgba(124, 58, 237, .10);
}

.teacher-videos-page .video-filter-select option {

  background: #0d1b30;

  color: #fff;
}


/* =========================================================
   VIDEO CARD
========================================================= */

.teacher-videos-page .videos-card {

  width: 100%;

  overflow: hidden;

  border:
    1px solid var(--tv-border);

  border-radius: 14px;

  background:
    rgba(13, 27, 48, .98);

  box-shadow:
    0 10px 30px rgba(0, 0, 0, .15);
}


/* =========================================================
   TABLE
========================================================= */

.teacher-videos-page .videos-table {

  width: 100%;

  min-width: 850px;

  margin: 0;

  border-collapse: collapse;
}

.teacher-videos-page .videos-table thead th {

  padding: 15px 14px;

  border-bottom:
    1px solid rgba(148, 163, 184, .14);

  border-top: 0;

  background:
    #0b1a31 !important;

  color: #94a3b8 !important;

  font-size: 11px;

  font-weight: 700;

  text-transform: uppercase;

  letter-spacing: .5px;

  white-space: nowrap;

  vertical-align: middle;
}

.teacher-videos-page .videos-table tbody td {

  padding: 14px;

  border-bottom:
    1px solid rgba(148, 163, 184, .09);

  color: #cbd5e1;

  background: transparent;

  font-size: 13px;

  vertical-align: middle;
}

.teacher-videos-page .videos-table tbody tr {

  transition:
    background .2s ease;
}

.teacher-videos-page .videos-table tbody tr:hover {

  background:
    rgba(124, 58, 237, .055);
}

.teacher-videos-page .videos-table tbody tr:last-child td {

  border-bottom: 0;
}


/* =========================================================
   NUMBER
========================================================= */

.teacher-videos-page .video-number {

  color: #64748b;

  font-weight: 600;

  width: 35px;
}


/* =========================================================
   VIDEO TITLE
========================================================= */

.teacher-videos-page .video-title-wrapper {

  display: flex;
  align-items: center;

  gap: 11px;

  min-width: 230px;
}

.teacher-videos-page .video-title-icon {

  width: 38px;
  height: 38px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  color: #c4b5fd;

  background:
    linear-gradient(
      135deg,
      rgba(124, 58, 237, .35),
      rgba(99, 102, 241, .22)
    );

  border:
    1px solid rgba(167, 139, 250, .20);
}

.teacher-videos-page .video-title-icon i {
  font-size: 16px;
}

.teacher-videos-page .video-title-content {
  min-width: 0;
}

.teacher-videos-page .video-title {

  max-width: 280px;

  overflow: hidden;

  color: #f1f5f9;

  font-size: 13px;
  font-weight: 650;

  line-height: 1.4;

  text-overflow: ellipsis;

  white-space: nowrap;
}

.teacher-videos-page .video-subtitle {

  margin-top: 3px;

  color: #64748b;

  font-size: 10px;

  white-space: nowrap;
}


/* =========================================================
   COURSE
========================================================= */

.teacher-videos-page .video-course {

  display: flex;
  align-items: center;

  gap: 7px;

  max-width: 190px;

  color: #cbd5e1;

  font-size: 12px;
}

.teacher-videos-page .video-course i {

  color: #a78bfa;

  font-size: 13px;
}

.teacher-videos-page .video-course span {

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;
}


/* =========================================================
   DURATION
========================================================= */

.teacher-videos-page .video-duration {

  display: inline-flex;
  align-items: center;

  gap: 6px;

  color: #94a3b8;

  white-space: nowrap;
}

.teacher-videos-page .video-duration i {

  color: #64748b;
}


/* =========================================================
   STATUS
========================================================= */

.teacher-videos-page .video-status {

  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 6px;

  min-width: 72px;

  padding: 6px 10px;

  border-radius: 50px;

  font-size: 10px;

  font-weight: 700;

  white-space: nowrap;
}

.teacher-videos-page .video-status.status-active {

  color: #6ee7b7;

  background:
    rgba(16, 185, 129, .14);

  border:
    1px solid rgba(16, 185, 129, .20);
}

.teacher-videos-page .video-status.status-inactive {

  color: #94a3b8;

  background:
    rgba(100, 116, 139, .15);

  border:
    1px solid rgba(100, 116, 139, .20);
}

.teacher-videos-page .video-status-dot {

  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: currentColor;
}


/* =========================================================
   ACTION BUTTONS
========================================================= */

.teacher-videos-page .video-actions {

  display: inline-flex;

  align-items: center;

  gap: 5px;

  white-space: nowrap;
}

.teacher-videos-page .video-actions .video-action {

  width: 32px;
  height: 32px;

  padding: 0;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  border: 1px solid transparent;

  border-radius: 7px;

  text-decoration: none;

  transition:
    transform .2s ease,
    filter .2s ease,
    background .2s ease;
}

.teacher-videos-page .video-actions .video-action:hover {

  transform: translateY(-2px);

  filter: brightness(1.12);
}

.teacher-videos-page .video-action.view {

  color: #93c5fd;

  background:
    rgba(59, 130, 246, .16);

  border-color:
    rgba(59, 130, 246, .20);
}

.teacher-videos-page .video-action.edit {

  color: #fcd34d;

  background:
    rgba(245, 158, 11, .14);

  border-color:
    rgba(245, 158, 11, .20);
}

.teacher-videos-page .video-action.delete {

  color: #fca5a5;

  background:
    rgba(239, 68, 68, .14);

  border-color:
    rgba(239, 68, 68, .20);
}

.teacher-videos-page .video-actions i {
  font-size: 13px;
}


/* =========================================================
   EMPTY STATE
========================================================= */

.teacher-videos-page .videos-empty {

  padding: 60px 20px !important;

  text-align: center;

  color: var(--tv-muted);
}

.teacher-videos-page .videos-empty-icon {

  width: 65px;
  height: 65px;

  margin: 0 auto 15px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 15px;

  color: #a78bfa;

  background:
    rgba(124, 58, 237, .12);

  border:
    1px solid rgba(124, 58, 237, .20);
}

.teacher-videos-page .videos-empty-icon i {
  font-size: 27px;
}

.teacher-videos-page .videos-empty h5 {

  margin: 0 0 6px;

  color: #e2e8f0;

  font-size: 15px;
  font-weight: 700;
}

.teacher-videos-page .videos-empty p {

  margin: 0;

  color: #64748b;

  font-size: 12px;
}


/* =========================================================
   TABLE FOOTER
========================================================= */

.teacher-videos-page .videos-table-footer {

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 13px 16px;

  border-top:
    1px solid rgba(148, 163, 184, .09);

  background:
    rgba(7, 17, 31, .35);
}

.teacher-videos-page .videos-result-count {

  color: #64748b;

  font-size: 11px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1100px) {

  .teacher-videos-page .video-stats {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .teacher-videos-page .video-filter-select {

    width: 150px;
  }
}


@media (max-width: 768px) {

  .teacher-videos-page {

    padding: 18px 15px;
  }

  .teacher-videos-page .videos-page-header {

    align-items: flex-start;

    flex-direction: column;

    gap: 15px;
  }

  .teacher-videos-page .videos-page-title h2 {

    font-size: 25px;
  }

  .teacher-videos-page .videos-title-icon {

    width: 50px;
    height: 50px;
  }

  .teacher-videos-page .add-video-btn {

    width: 100%;
  }

  .teacher-videos-page .video-filter-card {

    align-items: stretch;

    flex-direction: column;
  }

  .teacher-videos-page .video-search {

    width: 100%;
  }

  .teacher-videos-page .video-filter-select {

    width: 100%;
  }

  .teacher-videos-page .videos-table {

    min-width: 850px;
  }

  .teacher-videos-page .table-responsive {

    overflow-x: auto;

    -webkit-overflow-scrolling: touch;
  }

  .teacher-videos-page .videos-table-footer {

    align-items: flex-start;

    flex-direction: column;
  }
}


@media (max-width: 480px) {

  .teacher-videos-page {

    padding: 14px 12px;
  }

  .teacher-videos-page .video-stats {

    grid-template-columns:
      1fr;
  }

  .teacher-videos-page .videos-page-title {

    gap: 11px;
  }

  .teacher-videos-page .videos-title-icon {

    width: 45px;
    height: 45px;
  }

  .teacher-videos-page .videos-page-title h2 {

    font-size: 22px;
  }

  .teacher-videos-page .videos-page-title p {

    font-size: 12px;
  }
}



/* =========================================================
   FINAL VISIBILITY FIX
   Put this at the VERY END of the style block
========================================================= */

.teacher-videos-page {
  opacity: 1 !important;
  filter: none !important;
  visibility: visible !important;

  color: #f8fafc !important;

  background:
    radial-gradient(
      circle at top right,
      rgba(124, 58, 237, 0.12),
      transparent 32%
    ),
    #07111f !important;
}


/* =========================================================
   FILTER
========================================================= */

.teacher-videos-page .video-filter-card {
  opacity: 1 !important;
  filter: none !important;

  background: #0d1b30 !important;

  border: 1px solid rgba(148, 163, 184, .16) !important;
}

.teacher-videos-page .video-search input,
.teacher-videos-page .video-filter-select {
  opacity: 1 !important;

  color: #f8fafc !important;

  background: #0a1830 !important;

  border: 1px solid rgba(148, 163, 184, .20) !important;
}

.teacher-videos-page .video-search input::placeholder {
  color: #94a3b8 !important;
}

.teacher-videos-page .video-search i {
  color: #94a3b8 !important;
}


/* =========================================================
   TABLE CARD
========================================================= */

.teacher-videos-page .videos-card {
  opacity: 1 !important;
  filter: none !important;

  background: #0d1b30 !important;

  border: 1px solid rgba(148, 163, 184, .18) !important;
}


/* =========================================================
   TABLE HEADER
========================================================= */

.teacher-videos-page .videos-table thead,
.teacher-videos-page .videos-table thead tr,
.teacher-videos-page .videos-table thead th {
  opacity: 1 !important;

  background: #0b1a31 !important;

  color: #cbd5e1 !important;

  border-color:
    rgba(148, 163, 184, .16) !important;
}


/* =========================================================
   TABLE BODY
========================================================= */

.teacher-videos-page .videos-table tbody,
.teacher-videos-page .videos-table tbody tr,
.teacher-videos-page .videos-table tbody td {
  opacity: 1 !important;

  color: #cbd5e1 !important;

  background: #0d1b30 !important;

  border-color:
    rgba(148, 163, 184, .09) !important;
}


/* =========================================================
   ROW HOVER
========================================================= */

.teacher-videos-page .videos-table tbody tr:hover td {
  background:
    rgba(124, 58, 237, .08) !important;

  color: #f8fafc !important;
}


/* =========================================================
   VIDEO TITLE
========================================================= */

.teacher-videos-page .video-title {
  opacity: 1 !important;

  color: #f8fafc !important;

  font-weight: 650 !important;
}

.teacher-videos-page .video-subtitle {
  opacity: 1 !important;

  color: #64748b !important;
}


/* =========================================================
   NUMBER
========================================================= */

.teacher-videos-page .video-number {
  color: #94a3b8 !important;

  opacity: 1 !important;
}


/* =========================================================
   COURSE
========================================================= */

.teacher-videos-page .video-course {
  color: #cbd5e1 !important;

  opacity: 1 !important;
}

.teacher-videos-page .video-course i {
  color: #a78bfa !important;
}


/* =========================================================
   DURATION
========================================================= */

.teacher-videos-page .video-duration {
  color: #cbd5e1 !important;

  opacity: 1 !important;
}

.teacher-videos-page .video-duration i {
  color: #94a3b8 !important;
}


/* =========================================================
   TITLE ICON
========================================================= */

.teacher-videos-page .video-title-icon {
  opacity: 1 !important;

  color: #c4b5fd !important;

  background:
    linear-gradient(
      135deg,
      rgba(124, 58, 237, .45),
      rgba(99, 102, 241, .30)
    ) !important;

  border:
    1px solid rgba(167, 139, 250, .30) !important;
