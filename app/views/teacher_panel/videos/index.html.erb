  color: #fca5a5 !important;

  background:
    rgba(239, 68, 68, .18) !important;

  border-color:
    rgba(239, 68, 68, .30) !important;
}


/* =========================================================
   ADD BUTTON
========================================================= */

.teacher-videos-page .add-video-btn {
  opacity: 1 !important;

  color: #fff !important;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #6366f1
    ) !important;
}


/* =========================================================
   PAGE HEADER
========================================================= */

.teacher-videos-page .videos-page-title h2 {
  opacity: 1 !important;

  color: #f8fafc !important;
}

