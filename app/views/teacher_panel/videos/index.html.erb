  filter: none !important;
}

.teacher-videos-page .video-action.view {
  color: #93c5fd !important;

  background:
    rgba(59, 130, 246, .20) !important;

  border-color:
    rgba(59, 130, 246, .35) !important;
}

.teacher-videos-page .video-action.edit {
  color: #fcd34d !important;

  background:
    rgba(245, 158, 11, .18) !important;

  border-color:
    rgba(245, 158, 11, .30) !important;
}

