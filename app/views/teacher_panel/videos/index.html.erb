<div class="container-fluid">


  <div class="d-flex justify-content-between align-items-center mb-4">


    <div>

      <h2 class="fw-bold">
        🎥 My Videos
      </h2>

      <p class="text-muted mb-0">
        Manage videos of your assigned courses.
      </p>

    </div>



    <%= link_to new_teacher_panel_course_video_path(@course),
        class: "btn btn-primary" do %>

      <i class="bi bi-plus-circle"></i>
      Add Video

    <% end %>


  </div>




  <div class="card shadow border-0">


    <div class="table-responsive">


      <table class="table table-hover mb-0">


        <thead class="table-dark">

          <tr>

            <th>#</th>
            <th>Title</th>
            <th>Course</th>
            <th>Duration</th>
            <th>Status</th>
            <th>Action</th>

          </tr>

        </thead>



        <tbody>


        <% if @videos.any? %>


          <% @videos.each_with_index do |video,index| %>


            <tr>


              <td>
                <%= index + 1 %>
              </td>



              <td class="fw-bold">
                <%= video.title %>
              </td>



              <td>
                <%= video.course&.Course_name || "N/A" %>
              </td>



              <td>
                <%= video.duration || "-" %>
              </td>



              <td>

                <% if video.status == 1 %>

                  <span class="badge bg-success">
                    Active
                  </span>

                <% else %>

                  <span class="badge bg-secondary">
                    Inactive
                  </span>

                <% end %>

              </td>

                      <%= link_to teacher_panel_course_video_path(
      @course,
      video
    ),
    class:"btn btn-info btn-sm" do %>

  <i class="bi bi-eye"></i>

<% end %>

              <td>


                <%= link_to edit_teacher_panel_course_video_path(
                      @course,
                      video
                    ),
                    class:"btn btn-warning btn-sm" do %>

                  <i class="bi bi-pencil"></i>

                <% end %>




                <%= link_to teacher_panel_course_video_path(
                      @course,
                      video
                    ),
                    data:{
                      turbo_method: :delete,
                      turbo_confirm:"Delete this video?"
                    },
                    class:"btn btn-danger btn-sm" do %>

                  <i class="bi bi-trash"></i>

                <% end %>


              </td>


            </tr>


          <% end %>


        <% else %>


          <tr>

            <td colspan="6"
                class="text-center text-muted py-4">

              No videos available.

            </td>

          </tr>


        <% end %>



        </tbody>


      </table>


    </div>


  </div>


</div>