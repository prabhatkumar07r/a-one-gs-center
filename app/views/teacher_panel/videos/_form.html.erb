<%= form_with(
      model: video,
      url: video.persisted? ? 
        teacher_panel_course_video_path(@course, video) :
        teacher_panel_course_videos_path(@course),
      local: true
    ) do |form| %>


  <% if video.errors.any? %>

    <div class="alert alert-danger">

      <h5>
        <%= pluralize(video.errors.count, "error") %>
        prohibited this video from being saved:
      </h5>


      <ul class="mb-0">

        <% video.errors.full_messages.each do |message| %>

          <li>
            <%= message %>
          </li>

        <% end %>

      </ul>

    </div>

  <% end %>




  <!-- Title -->

  <div class="mb-3">

    <%= form.label :title,
        class: "form-label fw-bold" %>


    <%= form.text_field :title,
        class: "form-control",
        placeholder: "Enter Video Title" %>

  </div>




  <!-- Playlist -->

  <div class="mb-3">

    <%= form.label :playlist_id,
        "Playlist",
        class: "form-label fw-bold" %>


    <%= form.collection_select :playlist_id,
        @playlists || [],
        :id,
        :title,
        { prompt: "Select Playlist" },
        { class: "form-select" } %>

  </div>




  <!-- Description -->

  <div class="mb-3">

    <%= form.label :description,
        class: "form-label fw-bold" %>


    <%= form.text_area :description,
        rows: 4,
        class: "form-control",
        placeholder: "Enter video description" %>

  </div>




  <!-- Duration / Position / Status -->

  <div class="row">


    <div class="col-md-4">

      <%= form.label :duration,
          class: "form-label fw-bold" %>


      <%= form.text_field :duration,
          class: "form-control",
          placeholder: "15 Minutes" %>

    </div>




    <div class="col-md-4">

      <%= form.label :position,
          class: "form-label fw-bold" %>


      <%= form.number_field :position,
          class: "form-control" %>

    </div>




    <div class="col-md-4">

      <%= form.label :status,
          class: "form-label fw-bold" %>


      <%= form.select :status,
          Video.statuses.keys.map { |s| [s.titleize, s] },
          {},
          class: "form-select" %>

    </div>


  </div>





  <!-- YouTube URL -->

  <div class="mt-3">

    <%= form.label :video_url,
        "YouTube Video URL",
        class: "form-label fw-bold" %>


    <%= form.text_field :video_url,
        class: "form-control",
        placeholder: "https://youtube.com/..." %>

  </div>





  <!-- Thumbnail -->

  <div class="mt-3">

    <%= form.label :thumbnail,
        class: "form-label fw-bold" %>


    <%= form.file_field :thumbnail,
        class: "form-control" %>

  </div>





  <!-- Buttons -->

  <div class="mt-4">


    <%= form.submit(
          video.persisted? ? "Update Video" : "Save Video",
          class: "btn btn-success"
        ) %>



    <%= link_to "Back",
        teacher_panel_course_videos_path(@course),
        class: "btn btn-secondary" %>


  </div>



<% end %>