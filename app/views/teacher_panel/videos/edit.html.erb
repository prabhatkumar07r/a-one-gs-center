<% content_for :title, "Edit Video" %>

<div class="container-fluid mt-4">

  <div class="card shadow">

    <div class="card-header bg-warning">

      <h3>
        ✏️ Edit Video
      </h3>

      <small>
        Course:
        <strong>
          <%= @course.Course_name %>
        </strong>
      </small>

    </div>


    <div class="card-body">

      <%= render "form", video: @video %>

    </div>


    <div class="card-footer">

      <%= link_to "⬅ Back",
          teacher_panel_course_videos_path(@course),
          class: "btn btn-secondary" %>

    </div>


  </div>

</div>