  min-height: 58px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  padding: 12px 18px;

  border: 0;

  border-radius: 12px;

  outline: none;

  background: transparent;

  color: #555d70;

  font-family: inherit;

  font-size: 14px;

  font-weight: 700;

  cursor: pointer;

  user-select: none;

  -webkit-tap-highlight-color: transparent;

  transition:
    background .2s ease,
    color .2s ease,
    box-shadow .2s ease,
    transform .2s ease;
}


.learning-tab-btn i {
  font-size: 15px;

  pointer-events: none;
}


.learning-tab-btn span {
  pointer-events: none;
}


/* =========================================================
   HOVER
========================================================= */

.learning-tab-btn:hover {
  background: #f8f5ff;

  color: #6d28d9;
}


/* =========================================================
   ACTIVE
========================================================= */

