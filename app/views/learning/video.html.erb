<% content_for :hide_header, true %>
<% content_for :hide_footer, true %>

<style>

/* =========================================================
   ROOT
========================================================= */

:root {
  --primary: #6d28d9;
  --primary2: #4f46e5;
  --blue: #2563eb;
  --pink: #ec4899;

  --text: #1f2937;
  --muted: #64748b;

  --border: #e9d5ff;
  --light-purple: #f5f3ff;
  --light-blue: #eff6ff;

  --white: #ffffff;
}


/* =========================================================
   PAGE
========================================================= */

.learning-page {
  min-height: 100vh;

  background:
    radial-gradient(
      circle at top right,
      rgba(236, 72, 153, 0.12),
      transparent 35%
    ),
    radial-gradient(
      circle at bottom left,
      rgba(79, 70, 229, 0.14),
      transparent 40%
    ),
    #f8f7ff;

  color: var(--text);
}


/* =========================================================
   FIXED SIDEBAR
========================================================= */

.learning-sidebar {
  position: fixed;

  top: 0;
  left: 0;

  width: 378px;
  height: 100vh;

  background: #ffffff;

  border-right: 1px solid #e5e7eb;

  z-index: 1000;

  overflow-y: auto;

  box-shadow:
    8px 0 30px rgba(79, 70, 229, 0.08);
}


/* Sidebar scrollbar */

.learning-sidebar::-webkit-scrollbar {
  width: 6px;
}

.learning-sidebar::-webkit-scrollbar-thumb {
  background:
    linear-gradient(
      180deg,
      #6d28d9,
      #ec4899
    );

  border-radius: 10px;
}


/* =========================================================
   SIDEBAR HEADER
========================================================= */

.sidebar-header {
  padding: 24px 20px;

  background: #ffffff;

  border-bottom: 1px solid #eee;

  position: sticky;

  top: 0;

  z-index: 5;
}

.sidebar-header h3 {
  margin: 0;

  color: #6d28d9;

  font-size: 27px;

  font-weight: 800;
}

.sidebar-course-name {
  margin-top: 5px;

  color: #64748b;

  font-size: 16px;
}


/* =========================================================
   SIDEBAR PROGRESS
========================================================= */

.sidebar-progress {
  padding: 18px 20px;

  background:
    linear-gradient(
      135deg,
      #f5f3ff,
      #fff1f8
    );

  border-bottom: 1px solid #eadcff;
}

.sidebar-progress-title {
  display: flex;

  justify-content: space-between;

  font-weight: 700;

  color: #4c1d95;

  margin-bottom: 8px;
}

.sidebar-progress-bar {
  height: 7px;

  background: #e5e7eb;

  border-radius: 20px;

  overflow: hidden;
}

.sidebar-progress-fill {
  height: 100%;

  background:
    linear-gradient(
      90deg,
      #2563eb,
      #7c3aed,
      #ec4899
    );

  border-radius: 20px;

  transition: width 0.4s ease;
}


/* =========================================================
   PLAYLIST DROPDOWN
========================================================= */

.playlist-list {
  width: 100%;
}

.playlist-item {
  width: 100%;
  margin-bottom: 7px;
}


/* Playlist button */

.playlist-toggle {
  width: 100%;
  min-height: 50px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 12px 16px;

  border: 1px solid transparent;
  border-radius: 11px;

  background: transparent;

  color: #6d28d9;

  cursor: pointer;

  text-align: left;

  transition:
    background .2s ease,
    border-color .2s ease,
    color .2s ease;
}


/* Hover */

.playlist-toggle:hover {
  background: #f5f3ff;

  border-color: #e9d5ff;

  color: #5b21b6;
}


/* =========================================================
   PLAYLIST LEFT SIDE
========================================================= */

.playlist-toggle-left {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 11px;
}


/* Folder icon */

.playlist-toggle-left > i {
  width: 32px;
  height: 32px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 9px;

  background: #ede9fe;

  color: #7c3aed;

  font-size: 15px;
}


/* Playlist title */

.playlist-title {
  overflow: hidden;

  color: #5b21b6;

  font-size: 14px;

  font-weight: 750;

  white-space: nowrap;

  text-overflow: ellipsis;
}


/* =========================================================
   DROPDOWN CHEVRON
========================================================= */

.playlist-arrow {
  width: 28px;
  height: 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 8px;

  background: #f3f0ff;

  color: #7c3aed;

  font-size: 11px;

  transition:
    transform .25s ease,
    background .2s ease,
    color .2s ease;
}


/* =========================================================
   OPEN PLAYLIST
========================================================= */

.playlist-item.open .playlist-toggle {
  background:
    linear-gradient(
      90deg,
      #f5f3ff,
      #faf5ff
    );

  border-color: #ddd6fe;
}


.playlist-item.open .playlist-toggle-left > i {
  background: #7c3aed;

  color: #ffffff;
}


/* Rotate dropdown icon */

.playlist-item.open .playlist-arrow {
  transform: rotate(180deg);

  background: #7c3aed;

  color: #ffffff;
}


/* =========================================================
   PLAYLIST VIDEOS
========================================================= */

.playlist-videos {
  display: none;

  padding: 4px 8px 8px 18px;
}


.playlist-item.open .playlist-videos {
  display: block;
}


/* =========================================================
   VIDEO ITEM
========================================================= */

.video-item {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 10px;

  padding: 11px 12px;

  margin: 3px 0;

  border-radius: 9px;

  color: #475569;

  background: transparent;

  text-decoration: none;

  transition:
    background .2s ease,
    color .2s ease,
    transform .2s ease;
}


.video-item:hover {
  background: #f5f3ff;

  color: #6d28d9;

  transform: translateX(2px);
}


/* Active video */

.video-item.active {
  color: #ffffff !important;

  background:
    linear-gradient(
      90deg,
      #2563eb,
      #6d28d9,
      #9333ea
    );

  border-left: 4px solid #ec4899;

  font-weight: 700;

  box-shadow:
    0 5px 18px rgba(109, 40, 217, .25);
}

/* =========================================================
   COMPLETED / PENDING
========================================================= */

.video-completed,
.video-pending {
  width: 28px;

  height: 28px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  flex-shrink: 0;
}

.video-completed {
  background: #16a34a;

  color: #ffffff;
}

.video-pending {
  background: #e2e8f0;

  color: #475569;
}

.video-item.active .video-pending {
  background: rgba(255,255,255,.20);

  color: #ffffff;
}


/* =========================================================
   MAIN CONTENT
========================================================= */

.learning-main {
  margin-left: 378px;

  height: 100vh;

  overflow-y: auto;

  padding: 35px 45px 70px;
}


/* Main scrollbar */

.learning-main::-webkit-scrollbar {
  width: 8px;
}

.learning-main::-webkit-scrollbar-thumb {
  background:
    linear-gradient(
      180deg,
      #6d28d9,
      #ec4899
    );

  border-radius: 20px;
}


/* =========================================================
   COMMON CARDS
========================================================= */

.learning-card {
  background: #ffffff;

  border: 1px solid #eee5ff;

  border-radius: 20px;

  box-shadow:
    0 8px 25px rgba(79, 70, 229, 0.07);

  overflow: hidden;
}


/* =========================================================
   COURSE PROGRESS
========================================================= */

.course-progress {
  height: 12px;

  border-radius: 20px;

  background: #ede9fe;

  overflow: hidden;
}

.course-progress .progress-bar {
  background:
    linear-gradient(
      90deg,
      #7c3aed,
      #ec4899
    );

  border-radius: 20px;
}


/* =========================================================
   COURSE INFORMATION
========================================================= */

.course-title {
  color: #5b21b6;

  font-weight: 800;
}

.course-description {
  color: #6b7280;
}


/* =========================================================
   VIDEO HEADER
========================================================= */

.video-header-card {
  background: #ffffff;

  border: 1px solid #eadcff;

  border-radius: 20px;

  padding: 30px;

  margin-bottom: 25px;

  box-shadow:
    0 10px 35px rgba(79, 70, 229, 0.08);
}

.video-title {
  color: #1e1b4b;

  font-size: 34px;

  font-weight: 800;

  margin-bottom: 20px;
}


/* =========================================================
   VIDEO META
========================================================= */

.video-info {
  display: flex;

  flex-wrap: wrap;

  gap: 12px;
}

.video-info span {
  display: inline-flex;

  align-items: center;

  gap: 7px;

  padding: 9px 14px;

  border-radius: 10px;

  background: #f5f3ff;

  color: #4c1d95;

  border: 1px solid #ddd6fe;

  font-weight: 600;

  margin: 0;
}


/* =========================================================
   VIDEO PLAYER
========================================================= */

.video-wrapper {
  background: #000;

  border-radius: 18px;

  overflow: hidden;

  box-shadow:
    0 15px 40px rgba(0, 0, 0, 0.18);

  margin-top: 20px;
}

.video-wrapper iframe {
  width: 100%;

  height: 100%;

  border: 0;

  display: block;
}


/* =========================================================
   NAVIGATION
========================================================= */

.lesson-navigation {
  background: #ffffff;

  border: 1px solid #eee5ff;

  border-radius: 18px;

  padding: 22px;

  margin-bottom: 30px;

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 15px;

  box-shadow:
    0 8px 25px rgba(79, 70, 229, 0.07);
}

.btn-previous {
  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color: #ffffff !important;

  border: none;

  border-radius: 11px;

  padding: 12px 22px;

  font-weight: 700;
}

.btn-next {
  background:
    linear-gradient(
      135deg,
      #9333ea,
      #ec4899
    );

  color: #ffffff !important;

  border: none;

  border-radius: 11px;

  padding: 12px 22px;

  font-weight: 700;
}

.btn-previous:hover,
.btn-next:hover {
  color: #ffffff !important;

  transform: translateY(-2px);
}


/* =========================================================
   LEARNING TABS
========================================================= */

.learning-content-tabs {
  margin-top: 25px;

  background: #ffffff;

  border: 1px solid #e9d5ff;

  border-radius: 22px;

  overflow: hidden;

  box-shadow:
    0 10px 30px rgba(109, 40, 217, 0.08);
}


/* =========================================================
   TAB NAVIGATION
========================================================= */

.learning-tab-nav {
  display: flex;

  align-items: stretch;

  width: 100%;

  background:
    linear-gradient(
      135deg,
      #faf5ff,
      #eff6ff
    );

  border-bottom: 1px solid #e9d5ff;

  padding: 0;
}

.learning-tab-button {
  position: relative;

  flex: 1;

  border: none;

  outline: none;

  background: transparent;

  color: #64748b;

  padding: 18px 20px;

  font-size: 16px;

  font-weight: 800;

  cursor: pointer;

  transition:
    background 0.25s ease,
    color 0.25s ease;
}

.learning-tab-button i {
  margin-right: 8px;

  font-size: 15px;
}

.learning-tab-button:hover {
  background: rgba(124, 58, 237, 0.07);

  color: #6d28d9;
}


/* Active tab */

.learning-tab-button.active {
  background: #ffffff;

  color: #6d28d9;
}

.learning-tab-button.active::after {
  content: "";

  position: absolute;

  left: 15%;

  right: 15%;

  bottom: 0;

  height: 4px;

  border-radius: 8px 8px 0 0;

  background:
    linear-gradient(
      90deg,
      #2563eb,
      #7c3aed,
      #ec4899
    );
}


/* =========================================================
   TAB CONTENT
========================================================= */

.learning-tab-content {
  padding: 28px;
}

.learning-tab-pane {
  display: none;

  animation: tabFadeIn 0.25s ease;
}

.learning-tab-pane.active {
  display: block;
}

@keyframes tabFadeIn {

  from {
    opacity: 0;

    transform: translateY(5px);
  }

  to {
    opacity: 1;

    transform: translateY(0);
  }

}


/* =========================================================
   TAB SECTION HEADER
========================================================= */

.tab-section-header {
  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 15px;

  margin-bottom: 22px;

  padding-bottom: 18px;

  border-bottom: 1px solid #eee5ff;
}

.tab-section-title {
  display: flex;

  align-items: center;

  gap: 10px;

  color: #4c1d95;

  font-size: 22px;

  font-weight: 800;

  margin: 0;
}

.tab-section-title i {
  color: #7c3aed;
}


/* =========================================================
   STUDY NOTES
========================================================= */

.study-note-item {
  background:
    linear-gradient(
      135deg,
      #faf5ff,
      #ffffff
    );

  margin-bottom: 16px;

  padding: 22px;

  border-radius: 15px;

  border: 1px solid #ede9fe;

  box-shadow:
    0 5px 15px rgba(79, 70, 229, 0.06);

  transition: all 0.2s ease;
}

.study-note-item:hover {
  transform: translateY(-2px);

  box-shadow:
    0 8px 22px rgba(79, 70, 229, 0.10);
}

.study-note-item:last-child {
  margin-bottom: 0;
}

.study-note-item h5 {
  color: #1e1b4b;

  font-weight: 800;

  margin-bottom: 8px;
}

.study-note-item p {
  color: #64748b;

  margin-bottom: 0;
}


/* =========================================================
   QUIZ TAB
========================================================= */

.quiz-tab-wrapper {
  width: 100%;
}

.quiz-card {
  background:
    linear-gradient(
      135deg,
      #faf5ff,
      #eff6ff
    );

  border: 1px solid #ddd6fe;

  border-radius: 16px;

  padding: 22px;

  margin-bottom: 15px;

  transition: all 0.25s ease;
}

.quiz-card:last-child {
  margin-bottom: 0;
}

.quiz-card:hover {
  transform: translateY(-3px);

  box-shadow:
    0 10px 25px rgba(109, 40, 217, 0.10);
}

.quiz-card-content {
  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 25px;
}

.quiz-info {
  min-width: 0;
}

.quiz-info h4,
.quiz-info h5 {
  color: #312e81;

  font-weight: 800;

  margin-bottom: 8px;
}

.quiz-info p {
  color: #475569;

  margin-bottom: 15px;
}


/* Quiz meta */

.quiz-meta {
  display: flex;

  flex-wrap: wrap;

  gap: 10px;
}

.quiz-meta span {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  padding: 8px 11px;

  border-radius: 9px;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  color: #64748b;

  font-size: 13px;

  font-weight: 600;
}

.quiz-meta i {
  color: #6d28d9;
}


/* Quiz action */

.quiz-action {
  flex-shrink: 0;
}

.start-quiz-btn {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  min-width: 150px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #7c3aed,
      #ec4899
    );

  color: #ffffff !important;

  border: none;

  border-radius: 12px;

  padding: 13px 25px;

  font-weight: 800;

  text-decoration: none;

  box-shadow:
    0 8px 20px rgba(109, 40, 217, 0.25);

  transition: all 0.2s ease;
}

.start-quiz-btn:hover {
  transform: translateY(-2px);

  color: #ffffff !important;

  box-shadow:
    0 12px 25px rgba(109, 40, 217, 0.35);
}


/* =========================================================
   RESOURCES TAB
========================================================= */

.resource-item {
  background:
    linear-gradient(
      135deg,
      #ffffff,
      #f0fdf4
    );

  border: 1px solid #bbf7d0;

  border-radius: 16px;

  padding: 22px;

  margin-bottom: 16px;

  transition: all 0.2s ease;
}

.resource-item:last-child {
  margin-bottom: 0;
}

.resource-item:hover {
  transform: translateY(-2px);

  box-shadow:
    0 8px 20px rgba(22, 163, 74, 0.08);
}

.resource-item h5 {
  color: #14532d;

  font-weight: 800;

  margin-bottom: 8px;
}

.resource-item p {
  color: #64748b;

  margin-bottom: 12px;
}

.resource-type-badge {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  padding: 6px 10px;

  border-radius: 8px;

  background: #dcfce7;

  color: #166534;

  font-size: 12px;

  font-weight: 800;
}


/* =========================================================
   EMPTY STATES
========================================================= */

.tab-empty {
  padding: 45px 20px;

  text-align: center;

  background: #f8fafc;

  border: 1px dashed #cbd5e1;

  border-radius: 15px;

  color: #64748b;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  gap: 5px;
}

.tab-empty i {
  display: block;

  font-size: 38px;

  margin-bottom: 12px;

  color: #94a3b8;
}

.tab-empty strong {
  display: block;

  color: #475569;

  margin-bottom: 5px;
}


/* =========================================================
   DOWNLOAD / VIEW BUTTONS
========================================================= */

.resource-actions,
.note-actions {
  display: flex;

  justify-content: flex-end;

  flex-wrap: wrap;

  gap: 8px;
}


/* =========================================================
   COMPLETE BUTTON
========================================================= */

.complete-button {
  background:
    linear-gradient(
      135deg,
      #2563eb,
      #7c3aed,
      #ec4899
    );

  color: #ffffff !important;

  border: none;

  padding: 13px 24px;

  border-radius: 12px;

  font-size: 16px;

  font-weight: 700;

  box-shadow:
    0 8px 20px rgba(109, 40, 217, 0.25);

  transition: all 0.2s ease;
}

.complete-button:hover {
  transform: translateY(-2px);

  color: #ffffff !important;

  box-shadow:
    0 12px 25px rgba(109, 40, 217, 0.35);
}


/* =========================================================
   NO QUIZ
========================================================= */

.no-quiz {
  background: #e0f2fe;

  color: #075985;

  border: 1px solid #7dd3fc;

  border-radius: 12px;

  padding: 18px 20px;

  font-weight: 600;
}


/* =========================================================
   RESPONSIVE - TABLET
========================================================= */

@media (max-width: 991px) {

  .learning-sidebar {
    width: 300px;
  }

  .learning-main {
    margin-left: 300px;

    padding: 25px;
  }

  .video-title {
    font-size: 28px;
  }

  .quiz-card-content {
    gap: 18px;
  }

  .start-quiz-btn {
    min-width: 130px;
  }

}


/* =========================================================
   RESPONSIVE - MOBILE
========================================================= */

@media (max-width: 767px) {

  .learning-page {
    display: block;

    overflow: auto;
  }

  .learning-sidebar {
    position: relative;

    width: 100%;

    height: auto;

    max-height: 450px;

    border-right: none;

    border-bottom: 1px solid #e5e7eb;
  }

  .learning-main {
    margin-left: 0;

    width: 100%;

    height: auto;

    overflow: visible;

    padding: 20px 15px;
  }

  .video-header-card {
    padding: 20px;
  }

  .video-title {
    font-size: 24px;
  }

  .video-info {
    gap: 8px;
  }

  .video-info span {
    font-size: 13px;

    padding: 8px 10px;
  }

  .lesson-navigation {
    flex-direction: column;
  }

  .btn-previous,
  .btn-next {
    width: 100%;

    text-align: center;
  }


  /* =====================================================
     MOBILE PLAYLIST
  ===================================================== */

  .playlist-toggle {
    padding: 12px 14px;
  }

  .playlist-videos {
    padding-left: 12px;
  }


  /* =====================================================
     MOBILE TABS
  ===================================================== */

  .learning-tab-nav {
    overflow-x: auto;

    flex-direction: row;

    scrollbar-width: none;
  }

  .learning-tab-nav::-webkit-scrollbar {
    display: none;
  }

  .learning-tab-button {
    flex: 0 0 auto;

    width: auto;

    min-width: 145px;

    white-space: nowrap;

    padding: 15px 18px;

    text-align: center;

    border-bottom: none;
  }

  .learning-tab-button.active::after {
    left: 12%;

    right: 12%;

    top: auto;

    bottom: 0;

    width: auto;

    height: 4px;

    border-radius: 8px 8px 0 0;
  }

  .learning-tab-content {
    padding: 18px;
  }

  .tab-section-header {
    align-items: flex-start;

    flex-direction: column;
  }

  .tab-section-title {
    font-size: 19px;
  }


  /* =====================================================
     MOBILE QUIZ
  ===================================================== */

  .quiz-card-content {
    flex-direction: column;

    align-items: stretch;
  }

  .quiz-action {
    width: 100%;
  }

  .start-quiz-btn {
    width: 100%;
  }

  .quiz-meta {
    gap: 7px;
  }

  .quiz-meta span {
    font-size: 12px;
  }


  /* =====================================================
     MOBILE NOTES
  ===================================================== */

  .study-note-item {
    padding: 18px;
  }


  /* =====================================================
     MOBILE RESOURCES
  ===================================================== */

  .resource-item {
    padding: 18px;
  }

  .resource-actions,
  .note-actions {
    justify-content: flex-start;
  }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 420px) {

  .learning-main {
    padding: 15px 10px;
  }

  .learning-tab-content {
    padding: 14px;
  }

  .video-header-card {
    padding: 16px;
  }

  .video-title {
    font-size: 21px;
  }

  .sidebar-header h3 {
    font-size: 22px;
  }

  .learning-tab-button {
    min-width: 135px;

    padding: 14px 15px;

