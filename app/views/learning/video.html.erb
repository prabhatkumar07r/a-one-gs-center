  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #6366f1
    );

  color: #ffffff;

  box-shadow:
    0 7px 17px rgba(99, 102, 241, .28);
}


/* =========================================================
   TAB CONTENT
========================================================= */

.learning-tab-content {
