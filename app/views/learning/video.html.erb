/* =========================================================
   LEARNING TABS
   DARK NAVY + PURPLE DESIGN
========================================================= */

.learning-tabs-section {
  width: 100%;
  margin-top: 24px;
  margin-bottom: 40px;
}


/* =========================================================
   TAB BAR
========================================================= */

.learning-tabs {
  width: 100%;

  min-height: 72px;

  padding: 7px;

  display: grid;
  grid-template-columns: repeat(3, 1fr);

  gap: 5px;

  box-sizing: border-box;

  background: #ffffff;

  border-radius: 17px;

  box-shadow:
    0 8px 25px rgba(0, 0, 0, .14);
}


/* =========================================================
   TAB BUTTON
========================================================= */

.learning-tab {
  min-height: 58px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  padding: 12px 18px;

  border: 0;

  border-radius: 12px;

  background: transparent;

  color: #555d70;

  font-family: inherit;

  font-size: 14px;
  font-weight: 700;

  cursor: pointer;

  transition:
    background .2s ease,
    color .2s ease,
    box-shadow .2s ease,
    transform .2s ease;
}

.learning-tab i {
  font-size: 15px;
}


/* =========================================================
   HOVER
========================================================= */

