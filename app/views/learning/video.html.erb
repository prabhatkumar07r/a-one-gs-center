<% content_for :hide_header, true %>
<% content_for :hide_footer, true %>
<style nonce="<%= content_security_policy_nonce %>">
/* =========================================================
   A ONE GS CENTER - LEARNING PAGE
========================================================= */

:root {
  --learning-primary: #7c3aed;
  --learning-primary-2: #6366f1;
  --learning-primary-light: #a78bfa;
  --learning-pink: #ec4899;

  --learning-bg: #07111f;
  --learning-bg-2: #0a1628;
  --learning-sidebar: #09172a;
  --learning-card: #0d1b30;
  --learning-card-2: #10213a;

  --learning-border: rgba(148, 163, 184, 0.14);

  --learning-text: #f8fafc;
  --learning-muted: #94a3b8;
  --learning-muted-2: #64748b;

  --learning-success: #22c55e;
  --learning-warning: #f59e0b;
  --learning-danger: #ef4444;
}

/* =========================================================
   RESET
========================================================= */

.learning-page,
.learning-page * {
  box-sizing: border-box;
}

.learning-page {
  min-height: 100vh;
  width: 100%;

  margin: 0;
  padding: 0;

  color: var(--learning-text);

  background:
    radial-gradient(
      circle at 75% 0%,
      rgba(124, 58, 237, 0.16),
      transparent 32%
    ),
    radial-gradient(
      circle at 15% 100%,
      rgba(79, 70, 229, 0.10),
      transparent 35%
    ),
    var(--learning-bg);

  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

.learning-page a {
  text-decoration: none;
}

.learning-page button {
  font-family: inherit;
}

/* =========================================================
   LEARNING TOPBAR
========================================================= */

.learning-topbar {
  position: fixed;
  top: 0;
  left: 0;

  width: 100%;
  height: 72px;

  display: flex;
  align-items: center;

  padding: 0 24px;

  background:
    linear-gradient(
      135deg,
      rgba(7, 17, 31, 0.98),
      rgba(10, 22, 40, 0.98)
    );

  border-bottom: 1px solid rgba(148, 163, 184, 0.14);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  box-shadow:
    0 8px 30px rgba(0, 0, 0, 0.16);

  z-index: 3000;
}


/* =========================================================
   BRAND
========================================================= */

.learning-brand {
  width: 230px;

  display: flex;
  align-items: center;
  gap: 11px;

  flex-shrink: 0;

  color: #fff;
}

.learning-brand-icon {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 10px;
  overflow: hidden;

  background: #ffffff;
}

.learning-brand-icon img {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}


.learning-brand-text {
  min-width: 0;

  display: flex;
  flex-direction: column;

  line-height: 1.15;
}

.learning-brand-text strong {
  color: #f8fafc;

  font-size: 14px;
  font-weight: 800;

  white-space: nowrap;
}

.learning-brand-text small {
  margin-top: 3px;

  color: #64748b;

  font-size: 9px;
  font-weight: 600;

  letter-spacing: .03em;

  white-space: nowrap;
}


/* =========================================================
   TOP NAVIGATION
========================================================= */
/* =========================================================
   TOP NAVIGATION — CENTERED
========================================================= */

.learning-top-navigation {
  position: absolute;

  left: 50%;
  top: 50%;

  transform: translate(-50%, -50%);

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 5px;

  white-space: nowrap;
}

.learning-top-navigation a {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  padding: 9px 13px;

  border-radius: 9px;

  color: #94a3b8;

  font-size: 12px;
  font-weight: 650;

  white-space: nowrap;

  transition:
    color .2s ease,
    background .2s ease,
    transform .2s ease;
}

.learning-top-navigation a i {
  font-size: 12px;
}

.learning-top-navigation a:hover {
  color: #fff;

  background: rgba(124, 58, 237, .10);

  transform: translateY(-1px);
}

.learning-top-navigation a.active {
  color: #fff;

  background:
    linear-gradient(
      135deg,
      rgba(124, 58, 237, .20),
      rgba(99, 102, 241, .10)
    );
}

.learning-top-navigation a.active i {
  color: #a78bfa;
}

.learning-top-navigation a.active::after {
  content: "";

  position: absolute;

  left: 50%;
  bottom: -1px;

  width: 22px;
  height: 2px;

  transform: translateX(-50%);

  border-radius: 999px;

  background:
    linear-gradient(
      90deg,
      #7c3aed,
      #ec4899
    );
}





/* =========================================================
   ICON BUTTONS
========================================================= */

.learning-icon-button {
  width: 36px;
  height: 36px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0;

  border: 1px solid rgba(148, 163, 184, 0.13);
  border-radius: 9px;

  color: #94a3b8;

  background: rgba(255, 255, 255, 0.025);

  cursor: pointer;

  transition:
    color .2s ease,
    background .2s ease,
    border-color .2s ease,
    transform .2s ease;
}

.learning-icon-button i {
  font-size: 12px;
}

.learning-icon-button:hover {
  color: #fff;

  border-color: rgba(124, 58, 237, 0.35);

  background: rgba(124, 58, 237, 0.12);

  transform: translateY(-1px);
}

.learning-icon-button:active {
  transform: translateY(0);
}

.learning-icon-button:focus-visible {
  outline: 2px solid #a78bfa;
  outline-offset: 2px;
}


/* =========================================================
   TOP ACTION BUTTONS
========================================================= */

.learning-top-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.learning-icon-button {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0;
  margin: 0;

  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 10px;

  background: #0d1b30;

  color: #94a3b8;

  cursor: pointer;

  transition:
    background .2s ease,
    color .2s ease,
    border-color .2s ease,
    transform .2s ease;
}

.learning-icon-button svg {
  width: 19px;
  height: 19px;

  fill: none;
  stroke: currentColor;

  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;

  display: block;
}

.learning-icon-button:hover {
  background: rgba(124, 58, 237, 0.12);
  border-color: rgba(167, 139, 250, 0.25);
  color: #c4b5fd;

  transform: translateY(-1px);
}

/* =========================================================
   USER AREA
========================================================= */

.learning-user {
  min-width: 145px;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 5px 10px 5px 6px;

  border: 1px solid rgba(148, 163, 184, 0.13);
  border-radius: 999px;

  background: rgba(255, 255, 255, 0.025);
}

.learning-user-avatar {
  width: 32px;
  height: 32px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 50%;

  color: #fff;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #ec4899
    );

  font-size: 12px;
  font-weight: 800;

  box-shadow:
    0 5px 15px rgba(124, 58, 237, 0.22);
}

.learning-user-name {
  min-width: 0;

  display: flex;
  flex-direction: column;

  line-height: 1.15;
}

.learning-user-name strong {
  overflow: hidden;

  color: #e2e8f0;

  font-size: 11px;
  font-weight: 750;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.learning-user-name small {
  margin-top: 3px;

  overflow: hidden;

  color: #64748b;

  font-size: 8px;
  font-weight: 600;

  text-overflow: ellipsis;
  white-space: nowrap;
}


/* =========================================================
   TOPBAR RESPONSIVE — 1100px
========================================================= */

@media (max-width: 1100px) {

  .learning-topbar {
    padding: 0 16px;
  }

  .learning-brand {
    width: 205px;
  }

  .learning-top-navigation a {
    padding: 8px 9px;
  }

  .learning-top-navigation a span {
    display: none;
  }

  .learning-top-navigation a {
    width: 36px;

    justify-content: center;
  }

  .learning-user {
    min-width: auto;

    padding-right: 7px;
  }
}


/* =========================================================
   TOPBAR RESPONSIVE — 767px
========================================================= */

@media (max-width: 767px) {

  .learning-topbar {
    height: 62px;

    padding: 0 11px;
  }

  .learning-brand {
    width: auto;
  }

  .learning-brand-icon {
    width: 34px;
    height: 34px;

    border-radius: 9px;
  }

  .learning-brand-icon i {
    font-size: 14px;
  }

  .learning-brand-text strong {
    font-size: 12px;
  }

  .learning-brand-text small {
    font-size: 8px;
  }

  .learning-top-navigation {
    display: none;
  }

  .learning-top-actions {
    gap: 6px;
  }

  .learning-icon-button {
    width: 33px;
    height: 33px;
  }

  .learning-user {
    min-width: auto;

    padding: 4px;
  }

  .learning-user-name {
    display: none;
  }

  .learning-user-avatar {
    width: 30px;
    height: 30px;
  }
}


/* =========================================================
   TOPBAR RESPONSIVE — 480px
========================================================= */

@media (max-width: 480px) {

  .learning-topbar {
    padding: 0 8px;
  }

  .learning-brand-text small {
    display: none;
  }

  .learning-brand-text strong {
    font-size: 11px;
  }

  .learning-icon-button {
    width: 31px;
    height: 31px;
  }

  .learning-user-avatar {
    width: 29px;
    height: 29px;
  }
}

/* =========================================================
   TOP ACTIONS
========================================================= */

.learning-top-actions {
  margin-left: auto;

  display: flex;
  align-items: center;

  gap: 10px;
}

.learning-icon-button {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid rgba(148, 163, 184, 0.10);

  border-radius: 9px;

  background: #0d1b30;

  color: #94a3b8;

  cursor: pointer;

  transition: 0.2s ease;
}

.learning-icon-button:hover {
  color: #fff;

  background: #14243b;

  border-color: rgba(124, 58, 237, 0.35);
}

.learning-icon-button i {
  font-size: 13px;
}

/* =========================================================
   USER
========================================================= */

.learning-user {
  display: flex;
  align-items: center;

  gap: 9px;

  margin-left: 5px;

  padding-left: 14px;

  border-left: 1px solid var(--learning-border);
}

.learning-user-avatar {
  width: 36px;
  height: 36px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #60a5fa,
      #6366f1
    );

  color: #fff;

  font-size: 12px;
  font-weight: 800;
}

.learning-user-name strong {
  display: block;

  color: #fff;

  font-size: 12px;
  font-weight: 700;
}

.learning-user-name small {
  display: block;

  margin-top: 2px;

  color: #64748b;

  font-size: 9px;
}

/* =========================================================
   LEFT SIDEBAR
========================================================= */

.learning-sidebar {
  position: fixed;

  top: 72px;
  left: 0;
  bottom: 0;

  width: 220px;

  padding: 24px 12px;

  background:
    linear-gradient(
      180deg,
      #09182d,
      #071321
    );

  border-right: 1px solid var(--learning-border);

  z-index: 2000;

  overflow-y: auto;
  overflow-x: hidden;
}

.learning-sidebar::-webkit-scrollbar {
  width: 5px;
}

.learning-sidebar::-webkit-scrollbar-thumb {
  background: #263750;

  border-radius: 20px;
}

/* =========================================================
   SIDEBAR SECTION
========================================================= */

.sidebar-label {
  padding: 0 12px 10px;

  color: #475569;

  font-size: 9px;
  font-weight: 800;

  text-transform: uppercase;

  letter-spacing: 1.2px;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;

  gap: 5px;
}

.sidebar-nav a {
  display: flex;
  align-items: center;

  gap: 12px;

  padding: 11px 13px;

  color: #94a3b8;

  border-radius: 9px;

  font-size: 12px;
  font-weight: 600;

  transition: 0.2s ease;
}

.sidebar-nav a i {
  width: 20px;

  color: #64748b;

  text-align: center;

  font-size: 13px;
}

.sidebar-nav a:hover {
  color: #fff;

  background: rgba(124, 58, 237, 0.10);
}

.sidebar-nav a:hover i {
  color: #a78bfa;
}

.sidebar-nav a.active {
  color: #fff;

  background:
    linear-gradient(
      90deg,
      #4f46e5,
      #6d28d9
    );

  box-shadow:
    0 8px 20px rgba(79, 70, 229, 0.24);
}

.sidebar-nav a.active i {
  color: #fff;
}

/* =========================================================
   SIDEBAR DIVIDER
========================================================= */

.sidebar-divider {
  height: 1px;

  margin: 20px 8px;

  background: var(--learning-border);
}

/* =========================================================
   SIDEBAR COURSE CARD
========================================================= */

.sidebar-course-card {
  padding: 13px;

  border: 1px solid rgba(148, 163, 184, 0.10);

  border-radius: 11px;

  background:
    linear-gradient(
      135deg,
      rgba(124, 58, 237, 0.10),
      rgba(30, 41, 59, 0.45)
    );
}

.sidebar-course-card-label {
  margin-bottom: 6px;

  color: #64748b;

  font-size: 9px;
  font-weight: 700;

  text-transform: uppercase;
}

.sidebar-course-card-title {
  color: #e2e8f0;

  font-size: 11px;
  font-weight: 700;

  line-height: 1.45;

  display: -webkit-box;

  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;

  overflow: hidden;
}

/* =========================================================
   MAIN AREA
========================================================= */

.learning-main {
  width: calc(100% - 220px);

  min-height: 100vh;

  margin-left: 220px;

  padding-top: 72px;

  overflow-x: hidden;
}

/* =========================================================
   CONTENT GRID
========================================================= */

.learning-content {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    380px;

  gap: 20px;

  padding: 22px 22px 50px;
}

.learning-center {
  min-width: 0;
}

/* =========================================================
   BREADCRUMB
========================================================= */

.learning-breadcrumb {
  display: flex;
  align-items: center;

  flex-wrap: wrap;

  gap: 8px;

  margin-bottom: 15px;

  color: #64748b;

  font-size: 10px;
  font-weight: 600;
}

.learning-breadcrumb i {
  font-size: 8px;
}

.learning-breadcrumb strong {
  color: #c4b5fd;
}

/* =========================================================
   COURSE HEADER
========================================================= */

.course-header {
  position: relative;

  display: flex;
  align-items: center;

  gap: 18px;

  padding: 18px;

  margin-bottom: 18px;

  overflow: hidden;

  border: 1px solid var(--learning-border);

  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      rgba(13, 27, 48, 0.98),
      rgba(12, 28, 51, 0.98)
    );

  box-shadow:
    0 12px 35px rgba(0, 0, 0, 0.12);
}

.course-header::before {
  content: "";

  position: absolute;

  width: 180px;
  height: 180px;

  right: -80px;
  top: -100px;

  border-radius: 50%;

  background: rgba(124, 58, 237, 0.10);

  filter: blur(15px);

  pointer-events: none;
}

/* =========================================================
   COURSE IMAGE
========================================================= */

.course-image,
.course-image-placeholder {
  width: 150px;
  height: 90px;

  flex: 0 0 150px;

  object-fit: cover;

  border-radius: 10px;
}

.course-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;

  background:
    linear-gradient(
      135deg,
      #312e81,
      #7c3aed
    );

  color: #fff;

  font-size: 32px;
}

/* =========================================================
   COURSE INFO
========================================================= */

.course-header-info {
  min-width: 0;

  flex: 1;
}

.course-header-info h1 {
  margin: 0 0 6px;

  color: #fff;

  font-size: 20px;
  font-weight: 800;

  line-height: 1.3;
}

.course-header-info p {
  margin: 0 0 11px;

  color: #94a3b8;

  font-size: 11px;

  line-height: 1.5;
}

.course-stats {
  display: flex;
  align-items: center;

  flex-wrap: wrap;

  gap: 12px;
}

.course-stat {
  color: #64748b;

  font-size: 10px;
}

.course-stat i {
  margin-right: 4px;

  color: #8b5cf6;
}

.course-stat strong {
  color: #e2e8f0;
}

/* =========================================================
   COURSE PROGRESS
========================================================= */

.progress-box {
  width: 170px;

  flex: 0 0 170px;

  padding: 12px;

  border: 1px solid rgba(148, 163, 184, 0.10);

  border-radius: 10px;

  background: rgba(7, 17, 31, 0.35);
}

.progress-box-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 7px;

  color: #64748b;

  font-size: 9px;
  font-weight: 600;
}

.progress-box-header strong {
  color: #c4b5fd;
}

.progress-track {
  height: 6px;

  overflow: hidden;

  border-radius: 20px;

  background: #1e293b;
}

.progress-fill {
  height: 100%;

  border-radius: inherit;

  background:
    linear-gradient(
      90deg,
      #6366f1,
      #8b5cf6,
      #ec4899
    );
}

/* =========================================================
   VIDEO CARD
========================================================= */

.video-card {
  overflow: hidden;

  background: #081526;

  border: 1px solid var(--learning-border);

  border-radius: 15px;

  box-shadow:
    0 20px 45px rgba(0, 0, 0, 0.25);
}

.video-wrapper {
  position: relative;

  width: 100%;

  aspect-ratio: 16 / 9;

  overflow: hidden;

  background: #000;
}

.video-wrapper iframe {
  width: 100%;
  height: 100%;

  display: block;

  border: 0;
}

.video-not-found {
  width: 100%;
  height: 100%;

  min-height: 300px;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 10px;

  color: #64748b;
}

.video-not-found i {
  font-size: 35px;

  color: #475569;
}

/* =========================================================
   VIDEO INFORMATION
========================================================= */

.video-information {
  padding: 18px 20px;

  background:
    linear-gradient(
      135deg,
      #0d1b30,
      #0b192c
    );

  border-top: 1px solid rgba(148, 163, 184, 0.08);
}

.video-information h2 {
  margin: 0 0 11px;

  color: #fff;

  font-size: 19px;
  font-weight: 800;

  line-height: 1.35;
}

.video-meta {
  display: flex;

  flex-wrap: wrap;

  gap: 7px;
}

.video-meta span {
  display: inline-flex;
  align-items: center;

  gap: 5px;

  padding: 6px 9px;

  color: #94a3b8;

  background: #13243c;

  border: 1px solid rgba(148, 163, 184, 0.09);

  border-radius: 7px;

  font-size: 9px;
}

.video-meta i {
  color: #8b5cf6;
}

.video-description {
  margin: 12px 0 0;

  color: #64748b;

  font-size: 11px;

  line-height: 1.6;
}

/* =========================================================
   LESSON NAVIGATION
========================================================= */

.lesson-navigation {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  margin: 15px 0 18px;
}

.btn-previous,
.btn-next {
  min-width: 125px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 7px;

  padding: 10px 15px;

  border-radius: 9px;

  font-size: 11px;
  font-weight: 700;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.btn-previous {
  color: #cbd5e1 !important;

  background: #101f34;

  border: 1px solid #334155;
}

.btn-next {
  color: #fff !important;

  background:
    linear-gradient(
      135deg,
      #4f46e5,
      #7c3aed
    );

  box-shadow:
    0 7px 18px rgba(79, 70, 229, 0.20);
}

.btn-previous:hover,
.btn-next:hover {
  transform: translateY(-2px);
}

.btn-previous:hover {
  background: #14243b;
}

.btn-next:hover {
  box-shadow:
    0 10px 25px rgba(79, 70, 229, 0.30);
}

/* =========================================================
   TABS
========================================================= */

.learning-content-tabs {
  overflow: hidden;

  background: #0c1a2d;

  border: 1px solid var(--learning-border);

  border-radius: 14px;
}

.learning-tab-nav {
  display: flex;

  overflow-x: auto;

  background: #0a1729;

  border-bottom: 1px solid var(--learning-border);
}

.learning-tab-nav::-webkit-scrollbar {
  height: 0;
}

.learning-tab-button {
  position: relative;

  flex: 1;

  min-width: 150px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 7px;

  padding: 13px 12px;

  border: 0;

  background: transparent;

  color: #64748b;

  font-size: 10px;
  font-weight: 700;

  white-space: nowrap;

  cursor: pointer;

  transition: 0.2s ease;
}

.learning-tab-button:hover {
  color: #c4b5fd;
}

.learning-tab-button.active {
  color: #fff;

  background:
    linear-gradient(
      180deg,
      rgba(109, 40, 217, 0.22),
      transparent
    );
}

.learning-tab-button.active::after {
  content: "";

  position: absolute;

  left: 20px;
  right: 20px;
  bottom: 0;

  height: 2px;

  border-radius: 10px;

  background:
    linear-gradient(
      90deg,
      #6366f1,
      #a855f7
    );
}

.learning-tab-button .badge {
  font-size: 8px;

  padding: 4px 6px;
}

.learning-tab-content {
  padding: 18px;
}

.learning-tab-pane {
  display: none;
}

.learning-tab-pane.active {
  display: block;
}

/* =========================================================
   TAB SECTION HEADER
========================================================= */

.tab-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  margin-bottom: 14px;
}

.tab-section-title {
  margin: 0;

  display: flex;
  align-items: center;

  gap: 8px;

  color: #fff;

  font-size: 14px;
  font-weight: 800;
}

.tab-section-title i {
  color: #a78bfa;
}

.tab-section-header > .badge {
  font-size: 8px;

  padding: 5px 7px;
}

/* =========================================================
   STUDY NOTES
========================================================= */

.study-note-item {
  padding: 15px;

  margin-bottom: 10px;

  background:
    linear-gradient(
      135deg,
      #0e2036,
      #0c1c31
    );

  border: 1px solid rgba(148, 163, 184, 0.11);

  border-radius: 11px;
}

.study-note-item:last-child {
  margin-bottom: 0;
}

.study-note-item h5 {
  margin: 0 0 6px;

  color: #fff;

  font-size: 13px;
  font-weight: 700;
}

.study-note-item p {
  margin: 0;

  color: #94a3b8;

  font-size: 10px;

  line-height: 1.6;
}

.note-actions,
.resource-actions {
  display: flex;
  align-items: center;

  justify-content: flex-end;

  flex-wrap: wrap;

  gap: 7px;
}

.note-actions .btn,
.resource-actions .btn {
  font-size: 9px;

  border-radius: 7px;
}

/* =========================================================
   QUIZ
========================================================= */

.quiz-card {
  padding: 16px;

  margin-bottom: 10px;

  background:
    linear-gradient(
      135deg,
      #0e2036,
      #0c1c31
    );

  border: 1px solid rgba(148, 163, 184, 0.11);

  border-radius: 11px;
}

.quiz-card:last-child {
  margin-bottom: 0;
}

.quiz-card-content {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;
}

.quiz-info {
  min-width: 0;

  flex: 1;
}

.quiz-info h4 {
  margin: 0 0 6px;

  color: #fff;

  font-size: 13px;
  font-weight: 800;
}

.quiz-info p {
  margin: 0 0 9px;

  color: #94a3b8;

  font-size: 10px;

  line-height: 1.5;
}

.quiz-meta {
  display: flex;
  flex-wrap: wrap;

  gap: 7px;
}

.quiz-meta span {
  display: inline-flex;
  align-items: center;

  gap: 5px;

  padding: 5px 7px;

  color: #94a3b8;

  background: #13243c;

  border-radius: 6px;

  font-size: 8px;
}

.quiz-meta i {
  color: #8b5cf6;
}

.quiz-action {
  flex-shrink: 0;
}

.start-quiz-btn {
  min-width: 105px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 6px;

  padding: 10px 13px;

  border: 0;

  border-radius: 8px;

  color: #fff;

  background:
    linear-gradient(
      135deg,
      #4f46e5,
      #7c3aed
    );

  font-size: 10px;
  font-weight: 800;

  cursor: pointer;

  box-shadow:
    0 7px 16px rgba(79, 70, 229, 0.20);

  transition: 0.2s ease;
}

.start-quiz-btn:hover {
  transform: translateY(-2px);

  box-shadow:
    0 10px 22px rgba(79, 70, 229, 0.30);
}

/* =========================================================
   RESOURCES
========================================================= */

.resource-item {
  padding: 15px;

  margin-bottom: 10px;

  background:
    linear-gradient(
      135deg,
      #0e2036,
      #0c1c31
    );

  border: 1px solid rgba(148, 163, 184, 0.11);

  border-radius: 11px;
}

.resource-item:last-child {
  margin-bottom: 0;
}

.resource-item h5 {
  margin: 0 0 6px;

  color: #fff;

  font-size: 13px;
  font-weight: 700;
}

.resource-item p {
  margin: 0 0 9px;

  color: #94a3b8;

  font-size: 10px;

  line-height: 1.6;
}

.resource-type-badge {
  display: inline-flex;
  align-items: center;

  gap: 5px;

  padding: 5px 8px;

  color: #86efac;

  background: rgba(34, 197, 94, 0.10);

  border: 1px solid rgba(34, 197, 94, 0.14);

  border-radius: 6px;

  font-size: 8px;
  font-weight: 700;
}

/* =========================================================
   EMPTY STATE
========================================================= */

.tab-empty {
  min-height: 180px;

  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 7px;

  padding: 25px;

  color: #64748b;

  text-align: center;

  border: 1px dashed rgba(148, 163, 184, 0.14);

  border-radius: 11px;

  background: rgba(7, 17, 31, 0.25);
}

.tab-empty i {
  margin-bottom: 4px;

  color: #7c3aed;

  font-size: 28px;
}

.tab-empty strong {
  color: #cbd5e1;

  font-size: 12px;
}

.tab-empty span {
  color: #64748b;

  font-size: 10px;
}

/* =========================================================
   COMPLETE BUTTON
========================================================= */

.learning-complete-card {
  margin-top: 18px;
  margin-bottom: 20px;

  padding: 16px;

  text-align: center;

  border: 1px solid var(--learning-border);

  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      #0d1b30,
      #0b192c
    );
}

.complete-button {
  width: 100%;

  padding: 12px 18px;

  border: 0;

  border-radius: 9px;

  color: #fff;

  background:
    linear-gradient(
      135deg,
      #4f46e5,
      #7c3aed,
      #ec4899
    );

  font-size: 11px;
  font-weight: 800;

  cursor: pointer;

  box-shadow:
    0 9px 22px rgba(109, 40, 217, 0.25);

  transition: 0.2s ease;
}

.complete-button:hover {
  transform: translateY(-2px);

  box-shadow:
    0 12px 28px rgba(109, 40, 217, 0.32);
}

.complete-button:disabled {
  opacity: 0.55;

  cursor: not-allowed;

  transform: none;

  box-shadow: none;
}

/* =========================================================
   RIGHT PLAYLIST
========================================================= */

.learning-playlist {
  position: sticky;

  top: 92px;

  height: calc(100vh - 112px);

  min-height: 500px;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  background:
    linear-gradient(
      180deg,
      #0c1b30,
      #09172a
    );

  border: 1px solid var(--learning-border);

  border-radius: 15px;

  box-shadow:
    0 15px 40px rgba(0, 0, 0, 0.16);
}

/* =========================================================
   PLAYLIST HEADER
========================================================= */

.playlist-header {
  flex-shrink: 0;

  padding: 17px;

  background:
    linear-gradient(
      135deg,
      #0d1d33,
      #0b192c
    );

  border-bottom: 1px solid var(--learning-border);
}

.playlist-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;
}

.playlist-heading {
  display: flex;
  align-items: center;

  gap: 9px;
}

.playlist-heading-icon {
  width: 32px;
  height: 32px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 8px;

  color: #c4b5fd;

  background: rgba(124, 58, 237, 0.15);
}

.playlist-heading-icon i {
  font-size: 12px;
}

.playlist-header h3 {
  margin: 0;

  color: #fff;

  font-size: 15px;
  font-weight: 800;
}

.playlist-count {
  flex-shrink: 0;

  padding: 5px 7px;

  color: #c4b5fd;

  background: rgba(124, 58, 237, 0.12);

  border-radius: 6px;

  font-size: 8px;
  font-weight: 700;
}

.playlist-header p {
  margin: 9px 0 0;

  color: #64748b;

  font-size: 9px;

  line-height: 1.5;
}

/* =========================================================
   PLAYLIST SUMMARY
========================================================= */

.playlist-summary {
  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 7px;

  margin-top: 12px;
}

.playlist-summary-item {
  padding: 8px;

  border: 1px solid rgba(148, 163, 184, 0.08);

  border-radius: 7px;

  background: rgba(7, 17, 31, 0.35);
}

.playlist-summary-item span {
  display: block;

  color: #64748b;

  font-size: 8px;
}

.playlist-summary-item strong {
  display: block;

  margin-top: 2px;

  color: #e2e8f0;

  font-size: 11px;
}

/* =========================================================
   PLAYLIST SCROLL
========================================================= */

.playlist-scroll {
  flex: 1;

  overflow-y: auto;

  padding: 10px;
}

.playlist-scroll::-webkit-scrollbar {
  width: 5px;
}

.playlist-scroll::-webkit-scrollbar-thumb {
  background: #334155;

  border-radius: 20px;
}

/* =========================================================
   PLAYLIST ITEM
========================================================= */

.playlist-item {
  margin-bottom: 8px;

  overflow: hidden;

  background: #0b1a2e;

  border: 1px solid rgba(148, 163, 184, 0.09);

  border-radius: 10px;
}

.playlist-item:last-child {
  margin-bottom: 0;
}

/* =========================================================
   PLAYLIST TOGGLE
========================================================= */

.playlist-toggle {
  width: 100%;

  min-height: 49px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  padding: 9px 10px;

  border: 0;

  background: transparent;

  color: #e2e8f0;

  text-align: left;

  cursor: pointer;

  transition: 0.2s ease;
}

.playlist-toggle:hover {
  background: rgba(124, 58, 237, 0.08);
}

.playlist-toggle-left {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 9px;
}

.playlist-folder-icon {
  width: 30px;
  height: 30px;

  flex: 0 0 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 7px;

  color: #a78bfa;

  background: rgba(124, 58, 237, 0.15);
}

.playlist-folder-icon i {
  font-size: 11px;
}

.playlist-title {
  overflow: hidden;

  color: #e2e8f0;

  white-space: nowrap;

  text-overflow: ellipsis;

  font-size: 10px;
  font-weight: 700;
}

.playlist-arrow {
  flex: 0 0 auto;

  color: #64748b;

  transition:
    transform 0.2s ease,
    color 0.2s ease;
}

.playlist-arrow i {
  font-size: 9px;
}

.playlist-item.open .playlist-arrow {
  transform: rotate(180deg);

  color: #a78bfa;
}

/* =========================================================
   PLAYLIST VIDEOS
========================================================= */

.playlist-videos {
  display: none;

  padding: 5px;

  background: #081628;

  border-top: 1px solid rgba(148, 163, 184, 0.07);
}

.playlist-item.open .playlist-videos {
  display: block;
}

/* =========================================================
   VIDEO ITEM
========================================================= */

.video-item {
  min-height: 47px;

  display: flex;
  align-items: center;

  gap: 8px;

  padding: 7px 7px;

  margin: 2px 0;

  color: #94a3b8;

  border-radius: 8px;

  transition:
    background 0.18s ease,
    color 0.18s ease,
    transform 0.18s ease;
}

.video-item:hover {
  color: #fff;

  background: #14243b;
}

.video-item.active {
  color: #fff;

  background:
    linear-gradient(
      90deg,
      #4338ca,
      #6d28d9
    );

  box-shadow:
    0 5px 15px rgba(79, 70, 229, 0.22);
}

.video-number {
  width: 27px;
  height: 27px;

  flex: 0 0 27px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  color: #94a3b8;

  background: #1e3350;

  font-size: 9px;
  font-weight: 700;
}

.video-item.active .video-number {
  color: #fff;

  background: rgba(255, 255, 255, 0.18);
}

.video-item-info {
  min-width: 0;

  flex: 1;
}

.video-item-title {
  display: block;

  overflow: hidden;

  color: inherit;

  white-space: nowrap;

  text-overflow: ellipsis;

  font-size: 9px;
  font-weight: 600;
}

.video-item-duration {
  display: block;

  margin-top: 3px;

  color: #64748b;

  font-size: 8px;
}

.video-item.active .video-item-duration {
  color: #ddd6fe;
}

/* =========================================================
   COMPLETION ICONS
========================================================= */

.video-completed,
.video-pending {
  width: 22px;
  height: 22px;

  flex: 0 0 22px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  font-size: 8px;
}

.video-completed {
  color: #fff;

  background: #16a34a;
}

.video-pending {
  color: #64748b;

  background: #1e293b;
}

.video-item.active .video-pending {
  color: #fff;

  background: rgba(255, 255, 255, 0.18);
}

/* =========================================================
   VIDEO NOT AVAILABLE
========================================================= */

.learning-video-alert {
  padding: 20px;

  color: #fcd34d;

  background: rgba(245, 158, 11, 0.08);

  border: 1px solid rgba(245, 158, 11, 0.15);

  border-radius: 10px;

  font-size: 11px;
}

/* =========================================================
   RESPONSIVE - 1300
========================================================= */

@media (max-width: 1300px) {
  .learning-content {
    grid-template-columns:
      minmax(0, 1fr)
      350px;
  }

  .learning-brand {
    width: 205px;
  }

  .learning-topnav {
    gap: 18px;
  }

  .learning-topnav a {
    font-size: 12px;
  }
}

/* =========================================================
   RESPONSIVE - 1100
========================================================= */

@media (max-width: 1100px) {
  .learning-content {
    grid-template-columns:
      minmax(0, 1fr)
      320px;
  }

  .learning-topnav {
    display: none;
  }

  .course-header {
    align-items: flex-start;

    flex-wrap: wrap;
  }

  .progress-box {
    width: 100%;

    flex: 1 1 100%;
  }
}

/* =========================================================
   RESPONSIVE - 900
========================================================= */

@media (max-width: 900px) {
  .learning-sidebar {
    width: 190px;
  }

  .learning-main {
    width: calc(100% - 190px);

    margin-left: 190px;
  }

  .learning-content {
    grid-template-columns: 1fr;
  }

  .learning-playlist {
    position: relative;

    top: auto;

    height: 520px;

    min-height: 520px;
  }
}

/* =========================================================
   RESPONSIVE - 767
========================================================= */

@media (max-width: 767px) {
  .learning-topbar {
    height: 64px;

    padding: 0 14px;
  }

  .learning-brand {
    width: auto;
  }

  .learning-brand-text strong {
    font-size: 14px;
  }

  .learning-brand-text small {
    font-size: 8px;
  }

  .learning-top-actions {
    gap: 6px;
  }

  .learning-icon-button {
    width: 34px;
    height: 34px;
  }

  .learning-user {
    display: none;
  }

  /* Sidebar becomes horizontal menu */

  .learning-sidebar {
    position: fixed;

    top: 64px;
    left: 0;
    right: 0;
    bottom: auto;

    width: 100%;

    height: auto;

    padding: 8px;

    border-right: 0;

    border-bottom: 1px solid var(--learning-border);

    overflow-x: auto;
    overflow-y: hidden;
  }

  .sidebar-label,
  .sidebar-divider,
  .sidebar-course-card {
    display: none;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: row;

    width: max-content;

    gap: 5px;
  }

  .sidebar-nav a {
    min-width: 70px;

    flex-direction: column;

    justify-content: center;

    gap: 4px;

    padding: 8px 10px;

    font-size: 8px;

    text-align: center;
  }

  .sidebar-nav a i {
    width: auto;

    font-size: 13px;
  }

  .learning-main {
    width: 100%;

    margin-left: 0;

    padding-top: 112px;
  }

  .learning-content {
    padding: 12px 10px 35px;
  }

  .learning-breadcrumb {
    margin-bottom: 11px;
  }

  .course-header {
    padding: 13px;

    gap: 12px;
  }

  .course-image,
  .course-image-placeholder {
    width: 100px;
    height: 65px;

    flex-basis: 100px;
  }

  .course-header-info h1 {
    font-size: 16px;
  }

  .course-header-info p {
    font-size: 9px;
  }

  .course-stats {
    gap: 7px;
  }

  .course-stat {
    font-size: 8px;
  }

  .video-information {
    padding: 14px;
  }

  .video-information h2 {
    font-size: 16px;
  }

  .video-meta span {
    font-size: 8px;
  }

  .lesson-navigation {
    flex-direction: column;
  }

  .btn-previous,
  .btn-next {
    width: 100%;
  }

  .learning-tab-content {
    padding: 13px;
  }

  .quiz-card-content {
    flex-direction: column;

    align-items: stretch;
  }

  .quiz-action {
    width: 100%;
  }

  .start-quiz-btn {
    width: 100%;
  }

  .note-actions,
  .resource-actions {
    justify-content: flex-start;
  }

  .learning-playlist {
    height: 450px;

    min-height: 450px;
  }
}

/* =========================================================
   RESPONSIVE - 480
========================================================= */

@media (max-width: 480px) {
  .learning-brand-icon {
    width: 34px;
    height: 34px;

    border-radius: 9px;
  }

  .learning-brand-icon i {
    font-size: 15px;
  }

  .learning-brand-text strong {
    font-size: 12px;
  }

  .learning-brand-text small {
    display: none;
  }

  .learning-top-actions .learning-icon-button:first-child {
    display: none;
  }

  .course-image,
  .course-image-placeholder {
    width: 85px;
    height: 58px;

    flex-basis: 85px;
  }

  .course-header-info h1 {
    font-size: 14px;
  }

  .course-header-info p {
    display: none;
  }

  .learning-tab-button {
    min-width: 125px;

    font-size: 9px;
  }

  .playlist-summary {
    grid-template-columns: 1fr 1fr;
  }
}

/* =========================================================
   PROFESSIONAL COURSE CONTENT PANEL
========================================================= */

.course-content-panel {
  position: sticky;
  top: 92px;

  width: 100%;
  max-height: calc(100vh - 112px);

  background:
    linear-gradient(
      180deg,
      rgba(15, 29, 51, 0.98),
      rgba(7, 17, 31, 0.98)
    );

  border: 1px solid rgba(148, 163, 184, 0.13);
  border-radius: 20px;

  overflow: hidden;

  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.025);
}


/* =========================================================
   HEADER
========================================================= */

.content-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 22px 20px 18px;

  border-bottom: 1px solid rgba(148, 163, 184, 0.10);
}

.content-header-left {
  display: flex;
  align-items: center;
  gap: 13px;
  min-width: 0;
}

.content-header-icon {
  width: 42px;
  height: 42px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      rgba(124, 58, 237, 0.22),
      rgba(99, 102, 241, 0.18)
    );

  border: 1px solid rgba(124, 58, 237, 0.25);

  color: #a78bfa;

  font-size: 17px;
}

.content-header-left h2 {
  margin: 0;

  color: #f8fafc;

  font-size: 17px;
  font-weight: 800;
  letter-spacing: -0.3px;
}

.content-header-left p {
  margin: 4px 0 0;

  color: #64748b;

  font-size: 11px;
  line-height: 1.4;
}

.playlist-count-badge {
  flex-shrink: 0;

  display: flex;
  align-items: center;
  gap: 6px;

  padding: 8px 10px;

  border-radius: 9px;

  background: rgba(99, 102, 241, 0.13);

  border: 1px solid rgba(99, 102, 241, 0.18);

  color: #c4b5fd;

  font-size: 10px;
  font-weight: 700;
}

.playlist-count-badge i {
  font-size: 9px;
}


/* =========================================================
   STATISTICS
========================================================= */

.content-stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;

  gap: 9px;

  padding: 14px 14px 10px;
}

.content-stat-card {
  padding: 12px;

  background: rgba(7, 23, 42, 0.72);

  border: 1px solid rgba(148, 163, 184, 0.10);

  border-radius: 11px;
}

.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 6px;
}

.stat-top span {
  color: #64748b;

  font-size: 10px;
  font-weight: 500;
}

.stat-top i {
  color: #6366f1;

  font-size: 11px;
}

.content-stat-card strong {
  display: block;

  color: #f8fafc;

  font-size: 18px;
  font-weight: 800;
}


/* =========================================================
   PROGRESS
========================================================= */

.content-progress-box {
  margin: 4px 14px 15px;
  padding: 13px;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      rgba(124, 58, 237, 0.09),
      rgba(99, 102, 241, 0.05)
    );

  border: 1px solid rgba(124, 58, 237, 0.12);
}

.progress-info {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 9px;
}

.progress-info span {
  color: #94a3b8;

  font-size: 10px;
  font-weight: 600;
}

.progress-info strong {
  color: #a78bfa;

  font-size: 11px;
}

.progress-track {
  width: 100%;
  height: 5px;

  overflow: hidden;

  border-radius: 999px;

  background: rgba(148, 163, 184, 0.10);
}

.progress-fill {
  height: 100%;

  border-radius: inherit;

  background:
    linear-gradient(
      90deg,
      #7c3aed,
      #6366f1
    );

  box-shadow: 0 0 12px rgba(124, 58, 237, 0.45);

  transition: width 0.4s ease;
}


/* =========================================================
   PLAYLIST AREA
========================================================= */

.playlist-list {
  max-height: calc(100vh - 330px);

  overflow-y: auto;

  padding: 0 10px 12px;
}


/* Custom scrollbar */

.playlist-list::-webkit-scrollbar {
  width: 5px;
}

.playlist-list::-webkit-scrollbar-track {
  background: transparent;
}

.playlist-list::-webkit-scrollbar-thumb {
  background: rgba(148, 163, 184, 0.16);
  border-radius: 999px;
}

.playlist-list::-webkit-scrollbar-thumb:hover {
  background: rgba(148, 163, 184, 0.28);
}


/* =========================================================
   PLAYLIST SECTION
========================================================= */

.playlist-section {
  margin-bottom: 8px;

  border: 1px solid rgba(148, 163, 184, 0.08);

  border-radius: 12px;

  overflow: hidden;

  background: rgba(9, 23, 42, 0.55);
}

.playlist-section.is-open {
  border-color: rgba(124, 58, 237, 0.22);

  background: rgba(12, 27, 48, 0.75);
}


/* =========================================================
   PLAYLIST HEADER
========================================================= */

.playlist-header {
  width: 100%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  padding: 13px;

  border: 0;

  background: transparent;

  color: inherit;

  cursor: pointer;

  text-align: left;
}

.playlist-header:hover {
  background: rgba(124, 58, 237, 0.055);
}

.playlist-header-left {
  display: flex;
  align-items: center;

  gap: 10px;

  min-width: 0;
}

.playlist-number {
  width: 30px;
  height: 30px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  background: rgba(99, 102, 241, 0.13);

  color: #a78bfa;

  font-size: 11px;
  font-weight: 800;
}

.playlist-info {
  min-width: 0;
}

.playlist-info h3 {
  margin: 0;

  overflow: hidden;

  color: #e2e8f0;

  font-size: 12px;
  font-weight: 700;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.playlist-info span {
  display: block;

  margin-top: 3px;

  color: #64748b;

  font-size: 9px;
}

.playlist-header-right {
  flex-shrink: 0;
}

.playlist-chevron {
  color: #64748b;

  font-size: 10px;

  transition: transform 0.25s ease;
}

.playlist-section.is-open .playlist-chevron {
  transform: rotate(180deg);

  color: #a78bfa;
}


/* =========================================================
   LESSON LIST
========================================================= */

.playlist-videos {
  display: none;

  padding: 0 7px 8px;
}


/* =========================================================
   LESSON ITEM
========================================================= */

.lesson-item {
  position: relative;

  display: flex;
  align-items: center;

  gap: 9px;

  min-height: 62px;

  margin-top: 3px;

  padding: 8px;

  border-radius: 10px;

  text-decoration: none;

  border: 1px solid transparent;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.lesson-item:hover {
  background: rgba(99, 102, 241, 0.07);

  border-color: rgba(99, 102, 241, 0.12);

  transform: translateX(2px);
}


/* Active lesson */

.lesson-item.active {
  background:
    linear-gradient(
      135deg,
      rgba(124, 58, 237, 0.34),
      rgba(99, 102, 241, 0.22)
    );

  border-color: rgba(139, 92, 246, 0.38);

  box-shadow:
    inset 3px 0 0 #8b5cf6,
    0 6px 18px rgba(76, 29, 149, 0.16);
}

.lesson-item.active:hover {
  transform: none;
}


/* Completed lesson */

.lesson-item.completed:not(.active) {
  background: rgba(34, 197, 94, 0.025);
}


/* =========================================================
   LESSON NUMBER
========================================================= */

.lesson-number {
  width: 32px;
  height: 32px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #172c48;

  color: #94a3b8;

  font-size: 10px;
  font-weight: 700;

  transition: all 0.2s ease;
}

.lesson-item.active .lesson-number {
  background: rgba(255, 255, 255, 0.14);

  color: #ffffff;
}

.lesson-item.completed .lesson-number {
  background: rgba(34, 197, 94, 0.13);

  color: #22c55e;
}


/* =========================================================
   LESSON CONTENT
========================================================= */

.lesson-content {
  flex: 1;

  min-width: 0;
}

.lesson-title {
  display: -webkit-box;

  overflow: hidden;

  color: #94a3b8;

  font-size: 11px;
  font-weight: 600;

  line-height: 1.45;

  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.lesson-item:hover .lesson-title {
  color: #cbd5e1;
}

.lesson-item.active .lesson-title {
  color: #ffffff;

  font-weight: 700;
}

.lesson-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 7px;

  margin-top: 4px;

  color: #64748b;

  font-size: 8px;
}

.lesson-meta i {
  font-size: 8px;
}

.now-playing {
  display: inline-flex;
  align-items: center;
  gap: 3px;

  color: #c4b5fd;

  font-weight: 700;
}


/* =========================================================
   LESSON STATUS
========================================================= */

.lesson-status {
  flex-shrink: 0;
}

.status-completed,
.status-playing,
.status-pending {
  width: 28px;
  height: 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;
}


/* Completed */

.status-completed {
  background: rgba(34, 197, 94, 0.16);

  color: #22c55e;

  border: 1px solid rgba(34, 197, 94, 0.18);

  font-size: 10px;
}


/* Pending */

.status-pending {
  background: #182941;

  color: #64748b;

  font-size: 8px;
}

.lesson-item:hover .status-pending {
  background: #233958;

  color: #94a3b8;
}


/* Playing animation */

.status-playing {
  gap: 2px;

  background: rgba(167, 139, 250, 0.15);

  border: 1px solid rgba(167, 139, 250, 0.22);
}

.status-playing span {
  display: block;

  width: 2px;

  border-radius: 3px;

  background: #a78bfa;

  animation: lessonEqualizer 0.8s infinite ease-in-out;
}

.status-playing span:nth-child(1) {
  height: 7px;
  animation-delay: 0s;
}

.status-playing span:nth-child(2) {
  height: 11px;
  animation-delay: 0.15s;
}

.status-playing span:nth-child(3) {
  height: 8px;
  animation-delay: 0.3s;
}

@keyframes lessonEqualizer {
  0%,
  100% {
    transform: scaleY(0.65);
  }

  50% {
    transform: scaleY(1.2);
  }
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1100px) {

  .content-panel-header {
    padding: 18px 16px 15px;
  }

  .playlist-list {
    max-height: 600px;
  }

}


@media (max-width: 900px) {

  .course-content-panel {
    position: relative;

    top: auto;

    max-height: none;
  }

  .playlist-list {
    max-height: 550px;
  }

}


@media (max-width: 600px) {

  .content-panel-header {
    padding: 16px 14px;
  }

  .content-header-icon {
    width: 38px;
    height: 38px;
  }

  .content-header-left h2 {
    font-size: 15px;
  }

  .content-header-left p {
    font-size: 10px;
  }

  .playlist-count-badge {
    padding: 7px 8px;

    font-size: 9px;
  }

  .content-stat-grid {
    padding: 11px;
  }

  .content-progress-box {
    margin: 3px 11px 12px;
  }

  .playlist-list {
    padding: 0 7px 10px;
  }

}


