      </aside>

    </div>

  </main>

</div>
<script nonce="<%= content_security_policy_nonce %>">
(function () {

  function initializeLearningPage() {

    /* =========================================================
       PLAYLIST ACCORDION
    ========================================================= */

    const playlists =
      document.querySelectorAll("[data-playlist]");

    playlists.forEach(function (playlist) {

      const button =
        playlist.querySelector("[data-playlist-toggle]");

      const videos =
        playlist.querySelector(".playlist-videos");

      const chevron =
        playlist.querySelector(".playlist-chevron");

      if (!button || !videos) {
        return;
      }

      /*
       * IMPORTANT:
       * Do not use the old hidden state if this playlist
       * already contains the current video.
       */

      const isCurrentPlaylist =
        playlist.classList.contains("is-open");

      if (isCurrentPlaylist) {

        videos.style.display = "block";

        button.setAttribute(
          "aria-expanded",
          "true"
        );

        if (chevron) {
          chevron.style.transform =
            "rotate(180deg)";
        }

      } else {

        videos.style.display = "none";

        button.setAttribute(
          "aria-expanded",
          "false"
        );

        if (chevron) {
          chevron.style.transform =
            "rotate(0deg)";
        }

      }

      /*
       * Prevent duplicate event listeners
       * when Turbo loads the page again.
       */

      if (button.dataset.playlistInitialized === "true") {
        return;
      }

      button.dataset.playlistInitialized = "true";

      button.addEventListener(
        "click",
        function (event) {

          event.preventDefault();
          event.stopPropagation();

          const currentlyOpen =
            playlist.classList.contains("is-open");

          if (currentlyOpen) {

            playlist.classList.remove("is-open");

            videos.style.display = "none";

            button.setAttribute(
              "aria-expanded",
              "false"
            );

            if (chevron) {
              chevron.style.transform =
                "rotate(0deg)";
            }

          } else {

            playlist.classList.add("is-open");

            videos.style.display = "block";

            button.setAttribute(
              "aria-expanded",
              "true"
            );

            if (chevron) {
              chevron.style.transform =
                "rotate(180deg)";
            }

          }

        }
      );

    });


    /* =========================================================
       LEARNING TABS
    ========================================================= */

    const tabButtons =
      document.querySelectorAll(
        ".learning-tab-button"
      );

    const tabPanes =
      document.querySelectorAll(
        ".learning-tab-pane"
      );

    if (
      tabButtons.length === 0 ||
      tabPanes.length === 0
    ) {
      return;
    }


    /* =========================================================
       TAB FUNCTION
    ========================================================= */

    function activateTab(button) {

      const targetId =
        button.getAttribute(
          "data-learning-tab"
        );

      if (!targetId) {
        return;
      }

      const targetPane =
        document.getElementById(targetId);

      if (!targetPane) {
        console.error(
          "Learning tab pane not found:",
          targetId
        );

        return;
      }


      /* -------------------------------------------------------
         BUTTONS
      ------------------------------------------------------- */

      tabButtons.forEach(function (item) {

        item.classList.remove("active");

        item.setAttribute(
          "aria-selected",
          "false"
        );

      });


      /* -------------------------------------------------------
         PANES
      ------------------------------------------------------- */

      tabPanes.forEach(function (pane) {

        pane.classList.remove("active");

        pane.style.display = "none";

      });


      /* -------------------------------------------------------
         ACTIVE BUTTON
      ------------------------------------------------------- */

      button.classList.add("active");

      button.setAttribute(
        "aria-selected",
        "true"
      );


      /* -------------------------------------------------------
         ACTIVE PANE
      ------------------------------------------------------- */

      targetPane.classList.add("active");

      targetPane.style.display = "block";

    }


    /* =========================================================
       INITIAL TAB
    ========================================================= */

    let initialButton =
      document.querySelector(
        ".learning-tab-button.active"
      );

    if (!initialButton) {
      initialButton = tabButtons[0];
    }

    if (initialButton) {
      activateTab(initialButton);
    }


    /* =========================================================
       TAB CLICK EVENTS
    ========================================================= */

    tabButtons.forEach(function (button) {

      if (
        button.dataset.tabInitialized === "true"
      ) {
        return;
      }

      button.dataset.tabInitialized = "true";

      button.addEventListener(
        "click",
        function (event) {

          event.preventDefault();
          event.stopPropagation();

          activateTab(button);

        }
      );

    });


    /* =========================================================
       CURRENT VIDEO AUTO SCROLL
    ========================================================= */

    const activeVideo =
      document.querySelector(
        ".course-content-panel .lesson-item.active"
      );

    if (activeVideo) {

      setTimeout(function () {

        activeVideo.scrollIntoView({
          behavior: "smooth",
          block: "center"
        });

      }, 300);

    }

  }


  /* ===========================================================
     TURBO
  ============================================================ */

  document.addEventListener(
    "turbo:load",
    initializeLearningPage
  );


  /* ===========================================================
     NORMAL PAGE LOAD
  ============================================================ */

  document.addEventListener(
    "DOMContentLoaded",
    initializeLearningPage
  );

})();
</script>