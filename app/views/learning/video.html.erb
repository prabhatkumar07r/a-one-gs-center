}


/* =========================================================
   PLAYLIST ROW
========================================================= */

.playlist-list {
  width: 100%;
}

.playlist-item {
  width: 100%;
  margin-bottom: 7px;
}


/* =========================================================
   PLAYLIST BUTTON
========================================================= */

.playlist-toggle {
  width: 100%;
  min-height: 58px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 10px 12px 10px 14px;

  border: 1px solid #d8c7ff;
  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      #faf8ff,
      #f6f1ff
    );

  color: #5b21b6;

  cursor: pointer;

  text-align: left;

  box-sizing: border-box;

  transition:
    background .2s ease,
    border-color .2s ease,
    box-shadow .2s ease;
}

.playlist-toggle:hover {
  background:
    linear-gradient(
      135deg,
      #f5f0ff,
      #eee7ff
    );

  border-color: #a78bfa;

  box-shadow:
    0 4px 14px rgba(109, 40, 217, .10);
}


/* =========================================================
   LEFT SIDE
========================================================= */

.playlist-toggle-left {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 13px;
}


/* =========================================================
   FOLDER ICON
========================================================= */

.playlist-folder-icon {
  width: 38px;
  height: 38px;

  flex: 0 0 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;

  background: #7c3aed;

  color: #ffffff;

  box-shadow:
    0 4px 10px rgba(124, 58, 237, .20);
}

.playlist-folder-icon svg {
  width: 20px;
  height: 20px;

  display: block;

  fill: currentColor;
}


/* =========================================================
   PLAYLIST TITLE
========================================================= */

.playlist-title {
  min-width: 0;

  overflow: hidden;

  color: #5b21b6;

  font-size: 15px;

  font-weight: 800;

  line-height: 1.3;

  white-space: nowrap;

  text-overflow: ellipsis;
}


/* =========================================================
   DROPDOWN BUTTON
========================================================= */

.playlist-arrow {
  width: 34px;
  height: 34px;

  flex: 0 0 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-left: 10px;

  border-radius: 9px;

  background: #7c3aed;

  color: #ffffff;

  transition:
    transform .25s ease,
    background .2s ease;
}

.playlist-arrow svg {
  width: 17px;
  height: 17px;

  display: block;

  fill: none;

  stroke: currentColor;

  stroke-width: 2.5;

  stroke-linecap: round;

  stroke-linejoin: round;
}


/* =========================================================
   OPEN STATE
========================================================= */

.playlist-item.open .playlist-toggle {
  background:
    linear-gradient(
      135deg,
      #f3edff,
      #eee7ff
    );

  border-color: #c4b5fd;
}

.playlist-item.open .playlist-folder-icon {
  background: #6d28d9;
}

.playlist-item.open .playlist-arrow {
  transform: rotate(180deg);

  background: #6d28d9;
}


/* =========================================================
   PLAYLIST VIDEOS
========================================================= */

.playlist-videos {
  display: none;

  padding: 5px 8px 7px 18px;
}

.playlist-item.open .playlist-videos {
  display: block;
}

</style>


