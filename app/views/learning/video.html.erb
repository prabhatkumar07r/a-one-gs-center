}


/* =========================================================
   ACTIVE
========================================================= */

.learning-tab.active {
  color: #ffffff;

  background:
    linear-gradient(
      135deg,
      #7c3aed 0%,
      #6366f1 100%
    );

  box-shadow:
    0 7px 17px rgba(99, 102, 241, .28);

  transform: translateY(-1px);
}

/* =========================================================
   LEARNING TABS
========================================================= */

.learning-tabs-wrapper {
  position: relative;

  width: 100%;

  margin-top: 24px;

  z-index: 100;

  pointer-events: auto;
}


/* =========================================================
   TAB BAR
========================================================= */

.learning-tabs {
  position: relative;

  width: 100%;

  min-height: 72px;

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 5px;

  padding: 7px;

  box-sizing: border-box;

  background: #ffffff;

  border-radius: 17px;

  box-shadow:
    0 8px 25px rgba(0, 0, 0, .14);

  z-index: 101;
}


/* =========================================================
   TAB BUTTON
========================================================= */

.learning-tab-btn {
  position: relative;

  z-index: 102;

  pointer-events: auto;

  appearance: none;

