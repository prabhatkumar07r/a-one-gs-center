        <!-- PLAYLISTS -->

        <div class="playlist-list">

          <% @course.playlists
              .order(:position, :id)
              .each_with_index do |playlist, playlist_index| %>


            <% playlist_has_current_video =
                 playlist.videos.exists?(@video.id) %>


            <div
              class="playlist-section <%= 'is-open' if playlist_has_current_video %>"
              data-playlist>


              <!-- PLAYLIST HEADER -->

              <button
                type="button"
                class="playlist-header"
                data-playlist-toggle>


                <div class="playlist-header-left">


                  <div class="playlist-number">

                    <%= playlist_index + 1 %>

                  </div>


                  <div class="playlist-info">

                    <h3>
                      <%= playlist.title %>
                    </h3>

                    <span>

                      <%= playlist.videos.count %>

                      <%= playlist.videos.count == 1 ?
                          "Lesson" :
                          "Lessons" %>

                    </span>

                  </div>

                </div>


                <div class="playlist-header-right">

                  <i class="fas fa-chevron-down playlist-chevron"></i>

                </div>

              </button>


              <!-- VIDEOS -->

              <div
                class="playlist-videos"
                <%= 'style="display:block;"' if playlist_has_current_video %>>


                <% playlist.videos
                    .order(:position, :id)
                    .each_with_index do |video, video_index| %>


                  <% progress =
                       current_user.video_progresses.find_by(
                         video: video
                       ) %>


                  <% completed =
                       progress.present? &&
                       progress.completed? %>


                  <% active_video =
                       video.id == @video.id %>


                  <!-- LESSON -->

                  <a
                    href="<%= learning_video_path(@course, video) %>"
                    class="
                      lesson-item
                      <%= 'active' if active_video %>
                      <%= 'completed' if completed %>
                    ">


                    <!-- NUMBER -->

                    <div class="lesson-number">

                      <% if completed %>

