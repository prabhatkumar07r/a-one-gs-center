<!-- =========================================================
     PLAYLIST + TAB JAVASCRIPT
========================================================= -->

<script>

document.addEventListener("DOMContentLoaded", function () {


  /* ========================================================
     PLAYLIST DROPDOWN
  ======================================================== */

  const playlistButtons =
    document.querySelectorAll(
      ".playlist-toggle"
    );


  playlistButtons.forEach(function (button) {

    button.addEventListener(
      "click",
      function () {

        const playlistItem =
          this.closest(".playlist-item");


        if (!playlistItem) {
          return;
        }


        const isOpen =
          playlistItem.classList.toggle(
            "open"
          );


        this.setAttribute(
          "aria-expanded",
          isOpen ? "true" : "false"
        );

      }
    );

  });


  /* ========================================================
     LEARNING TABS
  ======================================================== */

  const tabButtons =
    document.querySelectorAll(
      ".learning-tab-button"
    );


  const tabPanes =
    document.querySelectorAll(
      ".learning-tab-pane"
    );


  tabButtons.forEach(function (button) {

    button.addEventListener(
      "click",
      function () {


        const targetId =
          button.dataset.learningTab;


        /* Remove active from buttons */

        tabButtons.forEach(
          function (item) {

            item.classList.remove(
              "active"
            );

            item.setAttribute(
              "aria-selected",
              "false"
            );

          }
        );


        /* Hide all panes */

        tabPanes.forEach(
          function (pane) {

            pane.classList.remove(
              "active"
            );

          }
        );


        /* Activate clicked tab */

        button.classList.add(
          "active"
        );

        button.setAttribute(
          "aria-selected",
          "true"
        );


        /* Show selected pane */

        const targetPane =
          document.getElementById(
            targetId
          );


        if (targetPane) {

          targetPane.classList.add(
            "active"
          );

        }

      }
    );

  });

});

</script>