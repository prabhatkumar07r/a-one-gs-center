<% content_for :hide_header, true %>
<% content_for :hide_footer, true %>

<style>
/* =========================================================
   VIDEO LEARNING PAGE
   Purple / Transparent Theme
========================================================= */

.learning-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(139, 92, 246, 0.28), transparent 35%),
    radial-gradient(circle at bottom right, rgba(236, 72, 153, 0.20), transparent 35%),
    linear-gradient(135deg, #f5f3ff, #fdf2f8);

  display: flex;
  overflow: hidden;
}


.quiz-section {
  margin-top: 40px;
}


/* ================= QUIZ HEADER ================= */

.quiz-header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 22px 25px;

  border-radius: 18px;

  background: rgba(255,255,255,0.75);

  border: 1px solid rgba(99,102,241,0.15);

  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
}


.quiz-header h3 {
  color: #3f52fb;
}


.quiz-icon {
  width: 55px;
  height: 55px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 15px;

  background: linear-gradient(
    135deg,
    #3f52fb,
    #fc466b
  );

  color: white;

  font-size: 23px;
}


/* ================= QUIZ CARD ================= */

.quiz-card {

  background: rgba(255,255,255,0.88);

  border-radius: 20px;

  padding: 25px;

  margin-bottom: 20px;

  border: 1px solid rgba(99,102,241,0.15);

  box-shadow:
    0 12px 35px rgba(0,0,0,0.08);

  transition: all .25s ease;
}


.quiz-card:hover {

  transform: translateY(-3px);

  box-shadow:
    0 18px 40px rgba(0,0,0,0.12);
}


.quiz-card-content {

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 25px;
}


.quiz-info h4 {

  color: #252b42;

}


.quiz-meta {

  display: flex;

  flex-wrap: wrap;

  gap: 20px;

  color: #6b7280;

  font-size: 14px;
}


.quiz-meta span {

  display: inline-flex;

  align-items: center;

  gap: 6px;
}


.quiz-meta i {

  color: #3f52fb;
}


/* ================= START BUTTON ================= */

.quiz-start-btn {

  min-width: 160px;

  border: none;

  border-radius: 12px;

  background:
    linear-gradient(
      135deg,
      #3f52fb,
      #fc466b
    );

  box-shadow:
    0 8px 20px rgba(63,82,251,.25);

  transition: all .25s ease;
}


.quiz-start-btn:hover {

  transform: translateY(-2px);

  box-shadow:
    0 12px 25px rgba(63,82,251,.35);
}


/* ================= MOBILE ================= */

@media (max-width: 768px) {

  .quiz-header {

    align-items: flex-start;

    gap: 15px;

  }


  .quiz-card-content {

    flex-direction: column;

    align-items: flex-start;

  }


  .quiz-action {

    width: 100%;

  }


  .quiz-start-btn {

    width: 100%;

  }

}


/* =========================================================
   FIXED SIDEBAR
========================================================= */

.learning-sidebar {
  width: 320px;
  height: 100vh;

  position: fixed;
  left: 0;
  top: 0;

  overflow-y: auto;

  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  border-right: 1px solid rgba(139, 92, 246, 0.18);

  box-shadow: 8px 0 30px rgba(139, 92, 246, 0.10);

  z-index: 1000;
}


/* Sidebar scrollbar */

.learning-sidebar::-webkit-scrollbar {
  width: 6px;
}

.learning-sidebar::-webkit-scrollbar-thumb {
  background: rgba(124, 58, 237, 0.35);
  border-radius: 10px;
}


/* =========================================================
   SIDEBAR HEADER
========================================================= */

.sidebar-header {
  position: sticky;
  top: 0;

  z-index: 10;

  padding: 20px;

  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(15px);

  border-bottom: 1px solid rgba(139, 92, 246, 0.15);
}

.sidebar-header h5 {
  margin: 0;

  color: #6d28d9;

  font-weight: 700;
}


/* =========================================================
   PLAYLIST
========================================================= */

.playlist-title {
  padding: 15px 18px;

  background: rgba(139, 92, 246, 0.07);

  border-bottom: 1px solid rgba(139, 92, 246, 0.10);
}

.playlist-title strong {
  color: #5b21b6;
}


/* =========================================================
   VIDEO ITEMS
========================================================= */

.video-item {
  display: block;

  padding: 13px 18px;

  text-decoration: none;

  color: #374151;

  background: rgba(255, 255, 255, 0.45);

  border-bottom: 1px solid rgba(139, 92, 246, 0.08);

  transition: all .2s ease;
}

.video-item:hover {
  background: rgba(139, 92, 246, 0.10);

  color: #6d28d9;

  padding-left: 23px;
}

.video-item.active {
  background:
    linear-gradient(
      90deg,
      rgba(139, 92, 246, 0.18),
      rgba(236, 72, 153, 0.08)
    );

  color: #6d28d9;

  border-left: 4px solid #7c3aed;
}


/* =========================================================
   MAIN CONTENT
========================================================= */

.learning-main {
  margin-left: 320px;

  width: calc(100% - 320px);

  height: 100vh;

  overflow-y: auto;

  padding: 30px;
}


/* Main scrollbar */

.learning-main::-webkit-scrollbar {
  width: 8px;
}

.learning-main::-webkit-scrollbar-thumb {
  background: rgba(124, 58, 237, 0.30);
  border-radius: 10px;
}


/* =========================================================
   GLASS CARDS
========================================================= */

.learning-card {
  background: rgba(255, 255, 255, 0.72);

  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);

  border: 1px solid rgba(139, 92, 246, 0.15);

  border-radius: 18px;

  box-shadow:
    0 10px 35px rgba(139, 92, 246, 0.10);
}


/* =========================================================
   COURSE HEADER
========================================================= */

.course-title {
  color: #5b21b6;

  font-weight: 800;
}

.course-description {
  color: #6b7280;
}


/* =========================================================
   PROGRESS
========================================================= */

.course-progress {
  height: 12px;

  border-radius: 20px;

  background: rgba(139, 92, 246, 0.10);
}

.course-progress .progress-bar {
  background:
    linear-gradient(
      90deg,
      #7c3aed,
      #ec4899
    );

  border-radius: 20px;
}


/* =========================================================
   VIDEO
========================================================= */

.video-wrapper {
  background: #000;

  border-radius: 18px;

  overflow: hidden;

  box-shadow:
    0 15px 40px rgba(0,0,0,.18);
}


/* =========================================================
   INFO
========================================================= */

.video-info span {
  margin-right: 20px;

  color: #6b7280;
}


/* =========================================================
   ACCORDION
========================================================= */

.learning-page .accordion-item {
  border: 1px solid rgba(139, 92, 246, 0.12);

  border-radius: 14px !important;

  overflow: hidden;

  margin-bottom: 12px;

  background: rgba(255,255,255,.65);
}

.learning-page .accordion-button {
  background: rgba(255,255,255,.65);

  color: #4c1d95;

  box-shadow: none;
}

.learning-page .accordion-button:not(.collapsed) {
  background: rgba(139, 92, 246, .08);

  color: #6d28d9;
}


/* =========================================================
   BUTTONS
========================================================= */

.btn-purple {
  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #ec4899
    );

  color: white;

  border: none;

  border-radius: 10px;

  padding: 10px 20px;
}

.btn-purple:hover {
  color: white;

  transform: translateY(-1px);

  box-shadow:
    0 8px 20px rgba(124,58,237,.25);
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 991px) {

  .learning-sidebar {
    width: 270px;
  }

  .learning-main {
    margin-left: 270px;

    width: calc(100% - 270px);

    padding: 20px;
  }

}

@media (max-width: 767px) {

  .learning-page {
    display: block;

    overflow: auto;
  }

  .learning-sidebar {
    position: relative;

    width: 100%;

    height: auto;

    max-height: 400px;
  }

  .learning-main {
    margin-left: 0;

    width: 100%;

    height: auto;

    overflow: visible;

    padding: 15px;
  }

}
</style>


<div class="learning-page">


  <!-- =====================================================
       FIXED SIDEBAR
  ====================================================== -->

  <aside class="learning-sidebar">

    <div class="sidebar-header">

      <h5>
        <i class="fas fa-book-open me-2"></i>
        Course Content
      </h5>

      <small class="text-muted">
        <%= @course.Course_name %>
      </small>

    </div>


    <% @playlists.each_with_index do |playlist, index| %>

      <%
        playlist_total = playlist.videos.count

        playlist_completed =
          current_user.video_progresses
            .joins(:video)
            .where(
              videos: {
                playlist_id: playlist.id
              },
              video_progresses: {
                completed: true
              }
            )
            .count

        playlist_progress =
          playlist_total.zero? ? 0 :
          ((playlist_completed.to_f / playlist_total) * 100).round
      %>


      <!-- Playlist -->

      <div class="playlist-title">

        <div class="d-flex justify-content-between align-items-center">

          <strong>
            <i class="fas fa-folder-open me-2"></i>
            <%= playlist.title %>
          </strong>

          <small>
            <%= playlist_progress %>%
          </small>

        </div>


        <div class="progress mt-2"
             style="height:5px;">

          <div class="progress-bar"
               style="width:<%= playlist_progress %>%">
          </div>

        </div>

      </div>


      <!-- Videos -->

      <% playlist.videos.order(:position).each do |video| %>

        <%
          progress =
            current_user.video_progresses.find_by(
              video: video
            )
        %>


        <%= link_to learning_video_path(@course, video),
            class: "video-item #{'active' if video == @video}" do %>


          <div class="d-flex justify-content-between align-items-center">

            <div>

              <strong>
                <%= video.position %>.
              </strong>

              <%= video.title %>

            </div>


            <% if progress&.completed? %>

              <i class="fas fa-check-circle text-success"></i>

            <% else %>

              <i class="fas fa-play-circle text-muted"></i>

            <% end %>

          </div>


        <% end %>

      <% end %>


    <% end %>

  </aside>



  <!-- =====================================================
       SCROLLABLE MAIN CONTENT
  ====================================================== -->

  <main class="learning-main">


    <!-- Course Progress -->

    <div class="learning-card mb-4">

      <div class="p-4">

        <div class="d-flex justify-content-between align-items-center">

          <div>

            <h5 class="fw-bold mb-1">
              📈 Course Progress
            </h5>

            <small class="text-muted">

              Completed
              <strong><%= @completed_videos %></strong>
              of
              <strong><%= @total_videos %></strong>
              videos

            </small>

          </div>


          <span class="badge bg-success fs-6">

            <%= @course_progress %>%

          </span>

        </div>


        <div class="progress course-progress mt-3">

          <div class="progress-bar"
               style="width:<%= @course_progress %>%">

          </div>

        </div>

      </div>

    </div>



    <!-- Course Information -->

    <div class="learning-card mb-4">

      <div class="p-4">

        <div class="row align-items-center">

          <div class="col-md-9">

            <h2 class="course-title">

              🎓 <%= @course.Course_name %>

            </h2>

            <p class="course-description">

              Welcome back! Continue your learning journey.

            </p>


            <div class="d-flex flex-wrap gap-4">

              <span>
                <i class="fas fa-folder text-primary"></i>
                <strong><%= @playlists.count %></strong>
                Playlists
              </span>

              <span>
                <i class="fas fa-play-circle text-danger"></i>
                <strong><%= @total_videos %></strong>
                Videos
              </span>

              <span>
                <i class="fas fa-book text-warning"></i>
                <strong><%= @notes.count %></strong>
                Notes
              </span>

              <span>
                <i class="fas fa-folder text-success"></i>
                <strong><%= @resources.count %></strong>
                Resources
              </span>

            </div>

          </div>


          <div class="col-md-3 text-center">

            <% if @course.image.attached? %>

              <%= image_tag @course.image,
                  class: "img-fluid rounded-4 shadow",
                  style: "max-height:140px;" %>

            <% else %>

              <i class="fas fa-graduation-cap fa-5x text-primary"></i>

            <% end %>

          </div>

        </div>

      </div>

    </div>



    <!-- Video Title -->

    <div class="learning-card mb-4">

      <div class="p-4">

        <h2 class="fw-bold">

          <%= @video.title %>

        </h2>


        <div class="video-info mb-3">

          <span>
            <i class="fas fa-folder text-primary"></i>
            <strong>Playlist:</strong>
            <%= @playlist.title %>
          </span>


          <span>
            <i class="fas fa-clock text-success"></i>
            <strong>Duration:</strong>
            <%= @video.duration %>
          </span>


          <span>
            <i class="fas fa-play-circle text-danger"></i>
            <strong>Lesson:</strong>
            <%= @video.position %>
          </span>


          <span>
            <i class="fas fa-calendar text-warning"></i>
            <strong>Published:</strong>
            <%= @video.created_at.strftime("%d %b %Y") %>
          </span>

        </div>


        <% if @video.description.present? %>

          <p class="lead text-muted">

            <%= @video.description %>

          </p>

        <% end %>


        <!-- YouTube -->

        <% if @video.video_url.present? %>

          <div class="ratio ratio-16x9 video-wrapper">

            <iframe
              id="youtube-player"
              src="https://www.youtube.com/embed/<%= @video.youtube_id %>?enablejsapi=1"
              title="<%= @video.title %>"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen>
            </iframe>

          </div>


          <script src="https://www.youtube.com/iframe_api"></script>

          <script>

            let player;

            function onYouTubeIframeAPIReady() {

              player = new YT.Player("youtube-player");

            }


            setInterval(function () {

              if (
                !player ||
                typeof player.getDuration !== "function"
              ) return;


              const current = player.getCurrentTime();

              const duration = player.getDuration();


              if (
                duration > 0 &&
                (current / duration) >= 0.90
              ) {

                const btn =
                  document.getElementById("completeBtn");

                if (btn) {

                  btn.disabled = false;

                }

              }

            }, 1000);

          </script>

        <% else %>

          <div class="alert alert-warning">

            Video not available.

          </div>

        <% end %>

      </div>

    </div>



    <!-- Previous / Next -->

    <div class="learning-card mb-4">

      <div class="p-3">

        <div class="d-flex justify-content-between">

          <% if @previous_video.present? %>

            <%= link_to learning_video_path(
                  @course,
                  @previous_video
                ),
                class: "btn btn-outline-primary" do %>

              ⬅ Previous

            <% end %>

          <% else %>

            <span></span>

          <% end %>


          <% if @next_video.present? %>

            <%= link_to learning_video_path(
                  @course,
                  @next_video
                ),
                class: "btn btn-purple" do %>

              Next ➜

            <% end %>

          <% end %>

        </div>

      </div>

    </div>



    <!-- Study Notes -->

    <div class="accordion mb-4"
         id="learningAccordion">


      <div class="accordion-item">

        <h2 class="accordion-header">

          <button class="accordion-button"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#studyNotes">

            <i class="fas fa-book-open text-danger me-2"></i>

            <strong>Study Notes</strong>

            <span class="badge bg-danger ms-3">

              <%= @notes.count %>

            </span>

          </button>

        </h2>


        <div id="studyNotes"
             class="accordion-collapse collapse show">

          <div class="accordion-body">

            <% if @notes.any? %>

              <% @notes.each do |note| %>

                <div class="card border-0 shadow-sm mb-3">

                  <div class="card-body">

                    <div class="row align-items-center">

                      <div class="col-md-8">

                        <h5>
                          <%= note.title %>
                        </h5>

                        <p class="text-muted">

                          <%= truncate(
                            note.description,
                            length: 120
                          ) %>

                        </p>

                      </div>


                      <div class="col-md-4 text-end">

                        <% if note.pdf_file.attached? %>

                          <%= link_to rails_blob_path(
                                note.pdf_file
                              ),
                              target: "_blank",
                              class: "btn btn-outline-danger btn-sm" do %>

                            <i class="fas fa-eye"></i>
                            View

                          <% end %>


                          <%= link_to rails_blob_path(
                                note.pdf_file,
                                disposition: "attachment"
                              ),
                              class: "btn btn-danger btn-sm" do %>

                            <i class="fas fa-download"></i>
                            Download

                          <% end %>

                        <% end %>

                      </div>

                    </div>

                  </div>

                </div>

              <% end %>

            <% else %>

              <div class="alert alert-info">

                No Study Notes Available.

              </div>

            <% end %>

          </div>

        </div>

      </div>
      <!-- ================= QUIZ SECTION ================= -->

<div class="quiz-section mt-5 mb-5">

  <div class="quiz-header mb-4">

    <div>
      <h3 class="fw-bold mb-1">
        🧠 Test Your Knowledge
      </h3>

      <p class="text-muted mb-0">
        Complete the quiz to check your understanding of this course.
      </p>
    </div>

    <div class="quiz-icon">
      <i class="fas fa-brain"></i>
    </div>

  </div>


  <% if @course.quizzes.where(status: "Active").any? %>

    <% @course.quizzes
              .where(status: "Active")
              .order(created_at: :desc)
              .each do |quiz| %>

      <div class="quiz-card">

        <div class="quiz-card-content">

          <div class="quiz-info">

            <h4 class="fw-bold mb-2">
              <%= quiz.title %>
            </h4>

            <% if quiz.description.present? %>

              <p class="text-muted mb-3">
                <%= quiz.description %>
              </p>

            <% end %>


            <div class="quiz-meta">

              <span>
                <i class="fas fa-question-circle"></i>

                <strong>
                  <%= quiz.questions.count %>
                </strong>

                Questions
              </span>


              <% if quiz.respond_to?(:duration) && quiz.duration.present? %>

                <span>
                  <i class="fas fa-clock"></i>

                  <strong>
                    <%= quiz.duration %>
                  </strong>

                  Minutes
                </span>

              <% end %>


              <% if quiz.respond_to?(:passing_percentage) &&
                    quiz.passing_percentage.present? %>

                <span>
                  <i class="fas fa-trophy"></i>

                  Pass:
                  <strong>
                    <%= quiz.passing_percentage %>%
                  </strong>

                </span>

              <% end %>

            </div>

          </div>


          <div class="quiz-action">

            <%= button_to start_course_quiz_path(@course, quiz),
                method: :post,
                class: "btn btn-primary btn-lg quiz-start-btn" do %>

              <i class="fas fa-play me-2"></i>

              Start Quiz

            <% end %>

          </div>

        </div>

      </div>

    <% end %>

  <% else %>

    <div class="alert alert-info">

      <i class="fas fa-info-circle me-2"></i>

      No quiz is available for this course yet.

    </div>

  <% end %>

</div>

<!-- ================= END QUIZ SECTION ================= -->



      <!-- Resources -->

      <div class="accordion-item">

        <h2 class="accordion-header">

          <button class="accordion-button collapsed"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#resources">

            <i class="fas fa-folder-open text-success me-2"></i>

            <strong>Learning Resources</strong>

            <span class="badge bg-success ms-3">

              <%= @resources.count %>

            </span>

          </button>

        </h2>


        <div id="resources"
             class="accordion-collapse collapse">

          <div class="accordion-body">

            <% if @resources.any? %>

              <% @resources.each do |resource| %>

                <div class="card border-0 shadow-sm mb-3">

                  <div class="card-body">

                    <div class="row align-items-center">

                      <div class="col-md-8">

                        <h5>
                          <%= resource.title %>
                        </h5>

                        <p class="text-muted">

                          <%= truncate(
                            resource.description,
                            length: 120
                          ) %>

                        </p>

                        <span class="badge bg-success">

                          <%= resource.resource_type.titleize %>

                        </span>

                      </div>


                      <div class="col-md-4 text-end">

                        <% if resource.file.attached? %>

                          <%= link_to rails_blob_path(
                                resource.file
                              ),
                              target: "_blank",
                              class: "btn btn-outline-success btn-sm" do %>

                            <i class="fas fa-eye"></i>
                            View

                          <% end %>


                          <%= link_to rails_blob_path(
                                resource.file,
                                disposition: "attachment"
                              ),
                              class: "btn btn-success btn-sm" do %>

                            <i class="fas fa-download"></i>
                            Download

                          <% end %>

                        <% end %>

                      </div>

                    </div>

                  </div>

                </div>

              <% end %>

            <% else %>

              <div class="alert alert-warning">

                No Resources Available.

              </div>

            <% end %>

          </div>

        </div>

      </div>

    </div>



    <!-- Mark Complete -->

    <div class="learning-card mb-5">

      <div class="p-4 text-center">

        <%= button_to "✔ Mark as Completed",
            complete_learning_video_path(
              @course,
              @video
            ),
            method: :post,
            id: "completeBtn",
            class: "btn btn-success btn-lg",
            disabled: false %>

      </div>

    </div>


  </main>

</div>
<style>
  <style>
/* =========================================================
   LEARNING / VIDEO PAGE
   LIGHT PURPLE + BLUE + PINK DESIGN
========================================================= */

:root {
  --primary: #6d28d9;
  --primary2: #4f46e5;
  --blue: #2563eb;
  --pink: #ec4899;
  --text: #1f2937;
  --muted: #64748b;
  --border: #e9d5ff;
  --light-purple: #f5f3ff;
  --light-blue: #eff6ff;
  --white: #ffffff;
}

/* =========================================================
   PAGE
========================================================= */

.learning-page {
  min-height: 100vh;
  background:
    radial-gradient(
      circle at top right,
      rgba(236, 72, 153, 0.12),
      transparent 35%
    ),
    radial-gradient(
      circle at bottom left,
