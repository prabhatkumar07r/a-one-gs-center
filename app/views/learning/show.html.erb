<% content_for :show_layout, true %>

<div class="container mt-5">

  <!-- Course Header -->
  <div class="mb-4">
    <h2 class="fw-bold text-primary">
      🎓 <%= @course.Course_name %>
    </h2>

    <% if @course.description.present? %>
      <p class="text-muted"><%= @course.description %></p>
    <% end %>
  </div>

  <!-- Progress Card -->
  <div class="card shadow mb-5">
    <div class="card-body">

      <h5 class="mb-3">
        📈 Learning Progress
      </h5>

      <div class="progress" style="height:25px;">
        <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
             role="progressbar"
             style="width:<%= @progress %>%">

          <%= @progress %>%

        </div>
      </div>

      <p class="mt-3 mb-0 text-muted">
        <strong><%= @completed_videos %></strong> /
        <strong><%= @total_videos %></strong>
        Videos Completed
      </p>

    </div>
  </div>

  <% if @playlists.any? %>

    <% @playlists.each do |playlist| %>

      <div class="card shadow mb-4">

        <div class="card-header bg-primary text-white">

          <h4 class="mb-0">
            📚 <%= playlist.title %>
          </h4>

          <% if playlist.description.present? %>
            <small><%= playlist.description %></small>
          <% end %>

        </div>

        <div class="card-body">

          <!-- ================= Videos ================= -->

          <h5 class="text-primary">
            🎥 Videos
          </h5>

          <% if playlist.videos.any? %>

            <div class="list-group mb-4">

              <% playlist.videos.order(:position).each do |video| %>

                <%= link_to learning_video_path(@course, video),
                    class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>

                  <div>

                    ▶ <strong><%= video.position %>.</strong>

                    <%= video.title %>

                  </div>

                  <span class="badge bg-secondary">
                    <%= video.duration %>
                  </span>

                <% end %>

              <% end %>

            </div>

          <% else %>

            <p class="text-muted">
              No videos available.
            </p>

          <% end %>

          <!-- ================= Notes ================= -->

          <h5 class="text-success mt-4">
            📝 Study Notes
          </h5>

          <% if playlist.notes.any? %>

            <ul class="list-group mb-4">

              <% playlist.notes.each do |note| %>

                <li class="list-group-item d-flex justify-content-between align-items-center">

                  <div>

                    <strong><%= note.title %></strong>

                    <% if note.description.present? %>

                      <br>

                      <small class="text-muted">
                        <%= note.description %>
                      </small>

                    <% end %>

                  </div>

                    <% if note.pdf_file.attached? %>

                <%= link_to rails_blob_path(note.pdf_file, disposition: "attachment"),
                 class: "text-primary",
                 title: "Download PDF" do %>

                <i class="fas fa-download fa-2x text-primary"></i>

              <% end %>

            <% else %>

               <span class="badge bg-danger">No PDF</span>

               <% end %>

                </li>

              <% end %>

            </ul>

          <% else %>

            <p class="text-muted">
              No study notes available.
            </p>

          <% end %>

          <!-- ================= Resources ================= -->

          <h5 class="text-warning">
            📂 Resources
          </h5>

          <% if playlist.resources.any? %>

            <ul class="list-group">

              <% playlist.resources.each do |resource| %>

                <li class="list-group-item d-flex justify-content-between align-items-center">

                  <div>

                    <strong>
                      <%= resource.title %>
                    </strong>

                    <span class="badge bg-info ms-2">
                      <%= resource.resource_type.upcase %>
                    </span>

                  </div>

                  <% if resource.file.attached? %>

                   <%= link_to rails_blob_path(resource.file, disposition: "attachment"),
                 class: "text-primary",
                 title: "Download " do %>

                <i class="fas fa-download fa-2x text-primary"></i>

              <% end %>

                  <% else %>

                    <span class="badge bg-danger">
                      No File
                    </span>

                  <% end %>

                </li>

              <% end %>

            </ul>

          <% else %>

            <p class="text-muted">
              No resources available.
            </p>

          <% end %>

        </div>

      </div>

    <% end %>

  <% else %>

    <div class="alert alert-warning">

      No playlists available for this course.

    </div>

  <% end %>

</div>