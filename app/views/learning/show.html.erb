<script nonce="<%= content_security_policy_nonce %>">

(function () {

  /* =====================================================
     LEARNING PAGE
     TURBO SAFE + DUPLICATE SAFE
  ===================================================== */

  function initializeLearningPage() {

    /* =====================================================
       BACK BUTTON
    ===================================================== */

    const backBtn =
      document.getElementById("learningBackBtn");

    if (
      backBtn &&
      backBtn.dataset.initialized !== "true"
    ) {

      backBtn.dataset.initialized = "true";

      backBtn.addEventListener("click", function (event) {

        event.preventDefault();

        if (
          document.referrer &&
          document.referrer !== window.location.href
        ) {

          window.history.back();

        } else {

          window.location.href = "/";

        }

      });

    }


    /* =====================================================
       PREVENT DOUBLE-CLICKING QUIZ BUTTONS
    ===================================================== */

    const quizButtons =
      document.querySelectorAll(".start-quiz-button");


    quizButtons.forEach(function (button) {

      if (button.dataset.quizInitialized === "true") {
        return;
      }

      button.dataset.quizInitialized = "true";


      button.addEventListener("click", function () {

        if (button.dataset.clicked === "true") {
          return;
        }


        button.dataset.clicked = "true";


        const originalHTML =
          button.innerHTML;


        button.innerHTML =
          "<span>⏳</span> Starting Quiz...";


        setTimeout(function () {

          if (document.body.contains(button)) {

            button.innerHTML =
              originalHTML;

            button.dataset.clicked =
              "false";

          }

        }, 5000);

      });

    });

  }


  /* =====================================================
     TURBO SUPPORT
  ===================================================== */

  document.addEventListener(
    "turbo:load",
    initializeLearningPage
  );


  /* =====================================================
     INITIAL PAGE LOAD
  ===================================================== */

  if (document.readyState !== "loading") {

    initializeLearningPage();

  } else {

    document.addEventListener(
      "DOMContentLoaded",
      initializeLearningPage,
      { once: true }
    );

  }

})();

</script>