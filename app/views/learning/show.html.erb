<% content_for :show_layout, true %>

<div class="learning-page">

  <!-- =========================================================
       BACK BUTTON
  ========================================================== -->

  <div class="learning-back-wrapper">
    <button type="button" class="learning-back-btn" id="learningBackBtn">
      <span class="back-arrow">←</span>
      <span>Back to Course</span>
    </button>
  </div>

  <!-- =========================================================
       MAIN LEARNING CONTAINER
  ========================================================== -->

  <div class="learning-main-container">


<!-- =======================================================
     LEFT SIDE — COURSE CONTENT
======================================================== -->

<section class="learning-left">


  <!-- =====================================================
       COURSE HERO
  ====================================================== -->

  <div class="learning-course-hero">

    <div class="learning-brand-badge">
      🎓 A ONE GS CENTER
    </div>

    <div class="learning-hero-icon">
      🎓
    </div>

    <div class="learning-hero-content">

      <span class="learning-label">
        CURRENT COURSE
      </span>

      <h1>
        <%= @course.Course_name %>
      </h1>

      <% if @course.description.present? %>

        <p>
          <%= @course.description %>
        </p>

      <% else %>

        <p>
          Learn. Practice. Grow.
        </p>

      <% end %>

    </div>

  </div>


  <!-- =====================================================
       LEARNING PROGRESS
  ====================================================== -->

  <div class="learning-progress-card">

    <div class="progress-top">

      <div>

        <span class="progress-label">
          YOUR LEARNING PROGRESS
        </span>

        <h3>
          Keep going — you're doing great!
        </h3>

      </div>

      <div class="progress-circle">
        <%= @progress.to_i %>%
      </div>

    </div>


    <div class="progress-track">

      <div
        class="progress-fill"
        style="width:<%= @progress.to_i %>%;">
      </div>

    </div>


    <div class="progress-bottom">

      <span>
        <strong><%= @completed_videos %></strong>
        of
        <strong><%= @total_videos %></strong>
        lessons completed
      </span>

      <span>
        🎥 Video Lessons
      </span>

    </div>

  </div>


  <!-- =====================================================
       PLAYLISTS
  ====================================================== -->

  <% if @playlists.present? && @playlists.any? %>

    <% @playlists.each_with_index do |playlist, playlist_index| %>

      <div class="learning-playlist-card">


        <!-- PLAYLIST HEADER -->

        <div class="playlist-top">

          <div class="playlist-number">
            <%= playlist_index + 1 %>
          </div>

          <div class="playlist-heading">

            <span>
              COURSE PLAYLIST
            </span>

            <h2>
              <%= playlist.title %>
            </h2>

            <% if playlist.description.present? %>

              <p>
                <%= playlist.description %>
              </p>

            <% end %>

          </div>

        </div>


        <!-- =================================================
             VIDEOS
        ================================================== -->

        <div class="learning-section">

          <div class="learning-section-heading">

            <div class="section-icon video-icon">
              🎥
            </div>

            <div>

              <h3>
                Videos
              </h3>

              <span>
                <%= playlist.videos.count %>
                lessons available
              </span>

            </div>

          </div>


          <% if playlist.videos.present? && playlist.videos.any? %>

            <div class="learning-video-list">

              <% playlist.videos.order(:position).each do |video| %>

                <%= link_to learning_video_path(@course, video),
                    class: "learning-video-item" do %>


                  <div class="video-position">
                    <%= video.position %>
                  </div>


                  <div class="learning-video-info">

                    <h4>
                      <%= video.title %>
                    </h4>

                    <% if video.description.present? %>

                      <p>
                        <%= video.description %>
                      </p>

                    <% end %>

                    <% if video.duration.present? %>

                      <small>
                        ⏱ <%= video.duration %>
                      </small>

                    <% end %>

                  </div>


                  <div class="video-play">

                    <span>
                      ▶
                    </span>

                  </div>


                <% end %>

              <% end %>

            </div>

          <% else %>

            <div class="learning-empty">
              <span>🎥</span>
              <p>No videos available in this playlist.</p>
            </div>

          <% end %>

        </div>


        <!-- =================================================
             STUDY NOTES
        ================================================== -->

        <div class="learning-section">

          <div class="learning-section-heading">

            <div class="section-icon notes-icon">
              📝
            </div>

            <div>

              <h3>
                Study Notes
              </h3>

              <span>
                Downloadable learning material
              </span>

            </div>

          </div>


          <% if playlist.notes.present? && playlist.notes.any? %>

            <div class="learning-download-list">

              <% playlist.notes.each do |note| %>

                <div class="learning-download-item">

                  <div class="download-left">

                    <div class="download-file-icon">
                      📄
                    </div>

                    <div>

                      <h4>
                        <%= note.title %>
                      </h4>

                      <% if note.description.present? %>

                        <p>
                          <%= note.description %>
                        </p>

                      <% end %>

                    </div>

                  </div>


                  <% if note.pdf_file.attached? %>

                    <%= link_to rails_blob_path(
                          note.pdf_file,
                          disposition: "attachment"
                        ),
                        class: "download-action",
                        title: "Download PDF" do %>

                      <span>
                        ↓
                      </span>

                      <strong>
                        PDF
                      </strong>

                    <% end %>

                  <% else %>

                    <span class="file-unavailable">
                      No PDF
                    </span>

                  <% end %>

                </div>

              <% end %>

            </div>

          <% else %>

            <div class="learning-empty">
              <span>📝</span>
              <p>No study notes available.</p>
            </div>

          <% end %>

        </div>


      </div>

    <% end %>

  <% else %>

    <div class="learning-empty large-empty">

      <span>📚</span>

      <h3>
        No Playlists Available
      </h3>

      <p>
        Course learning content will be available soon.
      </p>

    </div>

  <% end %>


</section>



<!-- =======================================================
     RIGHT SIDE — RESOURCES + QUIZ
======================================================== -->

<aside class="learning-right">


  <!-- =====================================================
       COURSE QUICK INFO
  ====================================================== -->

  <div class="learning-side-card course-summary-card">

    <div class="side-card-header">

      <div class="side-icon">
        🎓
      </div>

      <div>

        <span>
          LEARNING
        </span>

        <h3>
          Course Overview
        </h3>

      </div>

    </div>


    <div class="course-summary-list">

      <div class="summary-item">

        <span>
          📚 Playlists
        </span>

        <strong>
          <%= @playlists.count %>
        </strong>

      </div>


      <div class="summary-item">

        <span>
          🎥 Lessons
        </span>

        <strong>
          <%= @total_videos %>
        </strong>

      </div>


      <div class="summary-item">

        <span>
          ✅ Completed
        </span>

        <strong>
          <%= @completed_videos %>
        </strong>

      </div>

    </div>

  </div>



  <!-- =====================================================
       RESOURCES
  ====================================================== -->

  <div class="learning-side-card">

    <div class="side-card-header">

      <div class="side-icon resource-side-icon">
        📂
      </div>

      <div>

        <span>
          COURSE MATERIAL
        </span>

        <h3>
          Resources
        </h3>

      </div>

    </div>


    <p class="side-card-description">
      Access additional files and resources provided by your teacher.
    </p>


    <div class="resource-list">

      <% resources = @playlists.flat_map(&:resources) %>

      <% if resources.present? && resources.any? %>

        <% resources.each do |resource| %>

          <div class="resource-item">

            <div class="resource-info">

              <div class="resource-icon">
                📎
              </div>

              <div>

                <h4>
                  <%= resource.title %>
                </h4>

                <span>
                  <%= resource.resource_type.to_s.upcase %>
                </span>

              </div>

            </div>


            <% if resource.file.attached? %>

              <%= link_to rails_blob_path(
                    resource.file,
                    disposition: "attachment"
                  ),
                  class: "resource-download",
                  title: "Download Resource" do %>

                ↓

              <% end %>

            <% else %>

              <span class="resource-disabled">
                —
              </span>

            <% end %>

          </div>

        <% end %>

      <% else %>

        <div class="side-empty">

          <span>📂</span>

          <p>
            No resources available.
          </p>

        </div>

      <% end %>

    </div>

  </div>


<!-- =====================================================
     QUIZ CENTER — FULL COURSE QUIZZES ONLY
======================================================== -->

<div class="learning-side-card quiz-side-card">

  <div class="side-card-header">

    <div class="side-icon quiz-side-icon">
      🧠
    </div>

    <div>

      <span>
        TEST YOUR KNOWLEDGE
      </span>

      <h3>
        Quiz Center
      </h3>

    </div>

  </div>


  <p class="side-card-description">
    Test your understanding of the complete course with
    course-level quizzes.
  </p>


  <% full_course_quizzes = @quizzes.where(video_id: nil) %>


  <% if full_course_quizzes.present? && full_course_quizzes.any? %>

    <div class="quiz-list">

      <% full_course_quizzes.each do |quiz| %>

        <div class="quiz-card">

          <div class="quiz-card-top">

            <div class="quiz-number">
              🧠
            </div>

            <span class="quiz-active">
              ACTIVE
            </span>

          </div>


          <h4>
            <%= quiz.title %>
          </h4>


          <% if quiz.description.present? %>

            <p>
              <%= quiz.description %>
            </p>

          <% else %>

            <p>
              Test your knowledge with this full course quiz.
            </p>

          <% end %>


          <div class="quiz-details">

            <span>
              📝 <%= quiz.questions.count %>
            </span>

            <span>
              ⏱ <%= quiz.time_limit.to_i %> min
            </span>

            <% if quiz.respond_to?(:passing_percentage) &&
                  quiz.passing_percentage.present? %>

              <span>
                🎯 <%= quiz.passing_percentage %>%
              </span>

            <% end %>

          </div>


          <%= button_to start_course_quiz_path(@course, quiz),
              method: :post,
              class: "start-quiz-button" do %>

            <span>
              🚀
            </span>

            Start Quiz

          <% end %>

        </div>

      <% end %>

    </div>


  <% else %>

    <div class="side-empty quiz-empty">

      <span>🧠</span>

      <h4>
        No Full Course Quizzes
      </h4>

      <p>
        Full course quizzes will appear here.
      </p>

    </div>

  <% end %>

</div>


  <!-- =====================================================
       LEARNING TIP
  ====================================================== -->

  <div class="learning-tip-card">

    <div class="tip-icon">
      💡
    </div>

    <div>

      <h4>
        Learning Tip
      </h4>

      <p>
        Complete each video and review the notes before attempting the quiz.
      </p>

    </div>

  </div>


</aside>


  </div>

</div>

<style nonce="<%= content_security_policy_nonce %>">


.learning-page {
  min-height: 100vh;
  padding: 30px 5% 80px;

  background:
    radial-gradient(
      circle at 8% 5%,
      rgba(139, 92, 246, 0.14),
      transparent 28%
    ),
    radial-gradient(
      circle at 92% 8%,
      rgba(59, 130, 246, 0.10),
      transparent 26%
    ),
    linear-gradient(
      135deg,
      #f8f7fc 0%,
      #f1eff8 48%,
      #ebeaf4 100%
    );

  color: #25213a;
}


/* =========================================================
   BACK BUTTON
========================================================= */

.learning-back-wrapper {
  width: 100%;
  padding-top: 95px;
  margin-bottom: 28px;
}

.learning-back-btn {
  display: inline-flex;
  align-items: center;
  gap: 11px;

  padding: 13px 23px;

  border: 1px solid #e3dfed;
  border-radius: 15px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #eeebf5
    );

  color: #342c4d;

  font-size: 14px;
  font-weight: 800;

  cursor: pointer;

  box-shadow:
    8px 8px 18px rgba(69, 61, 91, 0.13),
    -6px -6px 15px rgba(255,255,255,0.90),
    inset 1px 1px 0 rgba(255,255,255,.9);

  transition:
    transform .22s ease,
    box-shadow .22s ease;
}

.learning-back-btn:hover {
  transform: translateX(-4px) translateY(-2px);

  box-shadow:
    11px 11px 24px rgba(69,61,91,.16),
    -7px -7px 17px rgba(255,255,255,.95);
}

.learning-back-btn:active {
  transform: translateX(-2px) translateY(1px);

  box-shadow:
    inset 4px 4px 10px rgba(80,70,100,.14),
    inset -3px -3px 8px rgba(255,255,255,.9);
}

.back-arrow {
  font-size: 21px;
  line-height: 1;
}


/* =========================================================
   MAIN CONTAINER
========================================================= */

.learning-main-container {
  max-width: 1450px;
  margin: 0 auto;

  display: grid;

  grid-template-columns:
    minmax(0, 1.65fr)
    minmax(330px, .75fr);

  gap: 28px;
}


/* =========================================================
   LEFT
========================================================= */

.learning-left {
  min-width: 0;
}


/* =========================================================
   COURSE HERO — 3D
========================================================= */

.learning-course-hero {
  position: relative;
  overflow: hidden;

  display: flex;
  align-items: center;

  gap: 25px;

  min-height: 285px;

  padding: 38px;

  border-radius: 27px;

  background:
    linear-gradient(
      145deg,
      #ffffff 0%,
      #f5f2fb 50%,
      #eae6f3 100%
    );

  border: 1px solid #e4deef;

  box-shadow:
    18px 18px 38px rgba(64, 52, 91, .16),
    -12px -12px 28px rgba(255,255,255,.95),
    inset 1px 1px 0 rgba(255,255,255,.95);

  transform: translateZ(0);
}

.learning-course-hero::before {
  content: "";

  position: absolute;

  width: 350px;
  height: 350px;

  left: 40%;
  top: 50%;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(124,58,237,.10),
      transparent 68%
    );

  pointer-events: none;
}

.learning-course-hero::after {
  content: "";

  position: absolute;

  width: 210px;
  height: 210px;

  right: -80px;
  top: -90px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(124,58,237,.11),
      transparent 70%
    );

  pointer-events: none;
}


/* =========================================================
   BRAND BADGE
========================================================= */

.learning-brand-badge {
  position: absolute;

  top: 18px;
  left: 22px;

  padding: 9px 16px;

  border-radius: 30px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #eeeaf7
    );

  border: 1px solid #ddd6eb;

  color: #6242a1;

  font-size: 10px;
  font-weight: 900;

  letter-spacing: .6px;

  z-index: 3;

  box-shadow:
    6px 6px 13px rgba(76,65,100,.12),
    -4px -4px 10px rgba(255,255,255,.95);
}


/* =========================================================
   HERO ICON
========================================================= */

.learning-hero-icon {
  position: relative;
  z-index: 2;

  width: 95px;
  height: 95px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-left: auto;

  border-radius: 26px;

  background:
    linear-gradient(
      145deg,
      #a78bfa 0%,
      #7c3aed 48%,
      #5b21b6 100%
    );

  color: #ffffff;

  font-size: 44px;

  box-shadow:
    12px 14px 25px rgba(91,33,182,.25),
    -5px -5px 12px rgba(255,255,255,.75),
    inset 2px 2px 5px rgba(255,255,255,.25),
    inset -4px -5px 8px rgba(45,20,95,.22);
}

.learning-hero-icon::after {
  content: "";

  position: absolute;

  inset: 7px;

  border-radius: 20px;

  border: 1px solid rgba(255,255,255,.20);

  pointer-events: none;
}


/* =========================================================
   HERO CONTENT
========================================================= */

.learning-hero-content {
  position: relative;
  z-index: 3;

  min-width: 0;

  flex: 1;

  text-align: center;
}

.learning-label {
  display: block;

  margin-bottom: 9px;

  color: #7651b9;

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 1.5px;
}

.learning-hero-content h1 {
  margin: 0;

  color: #29233d;

  font-size: clamp(28px, 3vw, 43px);

  line-height: 1.15;

  font-weight: 900;

  text-shadow:
    2px 3px 5px rgba(75,64,95,.12);
}

.learning-hero-content p {
  margin: 12px 0 0;

  color: #77718a;

  font-size: 15px;

  line-height: 1.6;
}


/* =========================================================
   PROGRESS CARD
========================================================= */

.learning-progress-card {
  margin-top: 20px;

  padding: 24px;

  border-radius: 21px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #efedf6
    );

  border: 1px solid #e2ddeb;

  box-shadow:
    12px 13px 28px rgba(65,54,90,.13),
    -8px -8px 20px rgba(255,255,255,.95),
    inset 1px 1px 0 rgba(255,255,255,.95);
}

.progress-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;
}

.progress-label {
  display: block;

  color: #7651b9;

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 1.3px;
}

.progress-top h3 {
  margin: 6px 0 0;

  color: #302a42;

  font-size: 16px;
  font-weight: 800;
}


/* 3D PROGRESS CIRCLE */

.progress-circle {
  min-width: 65px;
  height: 65px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    linear-gradient(
      145deg,
      #a78bfa,
      #7c3aed 52%,
      #5b21b6
    );

  border: 1px solid rgba(255,255,255,.6);

  color: #ffffff;

  font-size: 16px;
  font-weight: 900;

  box-shadow:
    9px 10px 19px rgba(91,33,182,.22),
    -5px -5px 12px rgba(255,255,255,.9),
    inset 2px 2px 5px rgba(255,255,255,.25),
    inset -4px -4px 7px rgba(45,20,95,.22);
}


/* =========================================================
   PROGRESS TRACK
========================================================= */

.progress-track {
  height: 11px;

  margin-top: 19px;

  overflow: hidden;

  border-radius: 20px;

  background:
    #e2deeb;

  box-shadow:
    inset 3px 3px 7px rgba(76,65,100,.14),
    inset -2px -2px 5px rgba(255,255,255,.9);
}

.progress-fill {
  height: 100%;

  border-radius: 20px;

  background:
    linear-gradient(
      90deg,
      #7c3aed,
      #a855f7
    );

  box-shadow:
    3px 2px 8px rgba(124,58,237,.30),
    inset 1px 1px 2px rgba(255,255,255,.35);

  transition: width .5s ease;
}

.progress-bottom {
  display: flex;

  justify-content: space-between;

  gap: 10px;

  margin-top: 11px;

  color: #888296;

  font-size: 11px;
}

.progress-bottom strong {
  color: #5d3c99;
}


/* =========================================================
   PLAYLIST CARD — 3D
========================================================= */

.learning-playlist-card {
  margin-top: 21px;

  overflow: hidden;

  border-radius: 23px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #eeecf5
    );

  border: 1px solid #e1dce9;

  box-shadow:
    15px 16px 32px rgba(65,54,90,.13),
    -9px -9px 21px rgba(255,255,255,.95);
}


/* =========================================================
   PLAYLIST HEADER
========================================================= */

.playlist-top {
  display: flex;
  align-items: flex-start;

  gap: 16px;

  padding: 25px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f1eef8
    );

  border-bottom: 1px solid #e5e0ed;

  box-shadow:
    inset 0 -3px 7px rgba(75,65,95,.035);
}

.playlist-number {
  width: 45px;
  height: 45px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 13px;

  background:
    linear-gradient(
      145deg,
      #a78bfa,
      #7c3aed 55%,
      #5b21b6
    );

  color: #ffffff;

  font-size: 15px;
  font-weight: 900;

  box-shadow:
    8px 9px 17px rgba(91,33,182,.22),
    -4px -4px 9px rgba(255,255,255,.85),
    inset 1px 1px 3px rgba(255,255,255,.25);
}

.playlist-heading {
  min-width: 0;
}

.playlist-heading > span {
  display: block;

  margin-bottom: 5px;

  color: #7651b9;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: 1.2px;
}

.playlist-heading h2 {
  margin: 0;

  color: #302a42;

  font-size: 22px;

  font-weight: 900;
}

.playlist-heading p {
  margin: 6px 0 0;

  color: #858092;

  font-size: 12px;

  line-height: 1.6;
}


/* =========================================================
   LEARNING SECTION
========================================================= */

.learning-section {
  padding: 25px;
}

.learning-section + .learning-section {
  border-top: 1px solid #e6e1ed;
}

.learning-section-heading {
  display: flex;
  align-items: center;

  gap: 12px;

  margin-bottom: 18px;
}

.section-icon {
  width: 43px;
  height: 43px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 12px;

  border: 1px solid #ddd6e8;

  box-shadow:
    5px 5px 11px rgba(71,61,90,.10),
    -4px -4px 9px rgba(255,255,255,.9);

  font-size: 20px;
}

.video-icon {
  background:
    linear-gradient(
      145deg,
      #f0ecff,
      #ddd5fa
    );
}

.notes-icon {
  background:
    linear-gradient(
      145deg,
      #ecfff7,
      #d9f4e9
    );
}

.learning-section-heading h3 {
  margin: 0;

  color: #332d44;

  font-size: 17px;

  font-weight: 850;
}

.learning-section-heading span {
  display: block;

  margin-top: 3px;

  color: #8b8598;

  font-size: 11px;
}


/* =========================================================
   VIDEO LIST
========================================================= */

.learning-video-list {
  display: flex;

