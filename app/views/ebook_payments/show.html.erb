<div class="ebook-payment-page">

  <div class="ebook-payment-wrapper">

    <!-- BACK -->
    <%= link_to ebook_path(@ebook),
          class: "ebook-payment-back" do %>
      <i class="bi bi-arrow-left"></i>
      Back to E-Book
    <% end %>


    <!-- HEADER -->
    <div class="ebook-payment-header">
      <span class="ebook-payment-badge">
        <i class="bi bi-book"></i>
        E-BOOK
      </span>

      <h1>Complete Your Payment</h1>

<p>
  Secure payment to unlock:
</p>

<div class="payment-ebook-title">
  <i class="bi bi-book-half"></i>
  <strong><%= @ebook.title %></strong>
</div>
    </div>


    <!-- E-BOOK CARD -->
    <div class="ebook-payment-card">

      <div class="ebook-cover">

        <% if @ebook.cover_image.attached? %>

          <%= image_tag @ebook.cover_image,
                alt: @ebook.title %>

        <% else %>

          <div class="ebook-cover-placeholder">
            <i class="bi bi-book-half"></i>
          </div>

        <% end %>

      </div>


      <div class="ebook-info">

  <span class="ebook-label">
    YOU ARE PURCHASING
  </span>

  <h2>
    <%= @ebook.title %>
  </h2>

  <% if @ebook.author.present? %>
    <p>
      <i class="bi bi-person"></i>
      By <%= @ebook.author %>
    </p>
  <% end %>

  <div class="ebook-meta">

    <% if @ebook.category.present? %>
      <span>
        <i class="bi bi-bookmark"></i>
        <%= @ebook.category %>
      </span>
    <% end %>

    <% if @ebook.language.present? %>
      <span>
        <i class="bi bi-translate"></i>
        <%= @ebook.language %>
      </span>
    <% end %>

    <% if @ebook.exam_name.present? %>
      <span>
        <i class="bi bi-mortarboard"></i>
        <%= @ebook.exam_name %>
      </span>
    <% end %>

  </div>

  <div class="payment-for-badge">
    <i class="bi bi-check-circle-fill"></i>
    Payment for this E-Book
  </div>

</div>


      <!-- PRICE -->

      <div class="ebook-price">

        <span>
          Amount Payable
        </span>

        <strong>
          ₹<%= number_with_delimiter(@purchase.amount.to_i) %>
        </strong>

      </div>

    </div>


    <!-- ORDER SUMMARY -->

    <div class="ebook-payment-section">

      <div class="section-title">

        <i class="bi bi-receipt"></i>

        <h3>
          Order Summary
        </h3>

      </div>


      <div class="summary-row">

        <span>
          E-Book Price
        </span>

        <strong>
          ₹<%= number_with_delimiter(@purchase.amount.to_i) %>
        </strong>

      </div>


      <div class="summary-divider"></div>


      <div class="summary-row total">

        <span>
          Total Amount
        </span>

        <strong>
          ₹<%= number_with_delimiter(@purchase.amount.to_i) %>
        </strong>

      </div>

    </div>


    <!-- PAYMENT METHOD -->

    <div class="ebook-payment-section">

      <div class="section-title">

        <i class="bi bi-credit-card"></i>

        <h3>
          Payment Method
        </h3>

      </div>


      <div class="payment-method active">

        <div class="payment-method-icon">
          <i class="bi bi-phone"></i>
        </div>

        <div>
          <strong>UPI / Card / Net Banking</strong>

          <span>
            Google Pay, PhonePe, Paytm, Cards and more
          </span>
        </div>

        <i class="bi bi-check-circle-fill payment-check"></i>

      </div>

    </div>


    <!-- SECURITY -->

    <div class="ebook-security">

      <div class="security-icon">
        <i class="bi bi-shield-lock-fill"></i>
      </div>

      <div>

        <strong>
          Secure Razorpay Payment
        </strong>

        <p>
          Your payment information is securely processed
          through Razorpay.
        </p>

      </div>

    </div>


    <!-- PAY BUTTON -->

    <button
      type="button"
      id="ebook-pay-button"
      class="ebook-pay-button">

      <span id="ebook-pay-icon">
        <i class="bi bi-lock-fill"></i>
      </span>

      <span id="ebook-pay-text">
        Pay Now ₹<%= number_with_delimiter(@purchase.amount.to_i) %>
      </span>

    </button>


    <p class="ebook-payment-terms">
      By proceeding with payment, you agree to our
      Terms & Conditions and Privacy Policy.
    </p>

  </div>

</div>


<!-- =========================================================
     RAZORPAY CHECKOUT
========================================================= -->

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script nonce="<%= content_security_policy_nonce %>">

(function () {

  function initializeEbookPaymentPage() {

    const payButton =
      document.getElementById("ebook-pay-button");

    if (!payButton) {
      return;
    }


    /* Prevent duplicate Turbo listeners */

    if (
      payButton.dataset.initialized === "true"
    ) {
      return;
    }

    payButton.dataset.initialized = "true";


    payButton.addEventListener("click", function () {

      if (payButton.disabled) {
        return;
      }


      payButton.disabled = true;

      payButton.classList.add("loading");


      /* =====================================================
         CHECK RAZORPAY
      ====================================================== */

      if (typeof Razorpay === "undefined") {

        console.error(
          "Razorpay checkout.js is not loaded."
        );

        payButton.disabled = false;

        payButton.classList.remove("loading");

        alert(
          "Payment service is temporarily unavailable. Please refresh the page and try again."
        );

        return;
      }


      /* =====================================================
         RAZORPAY OPTIONS
      ====================================================== */

      const options = {

        key:
          "<%= ENV.fetch("RAZORPAY_KEY_ID") %>",


        amount:
          <%= (@purchase.amount.to_d * 100).to_i %>,


        currency:
          "INR",


        name:
          "A One GS Center",


        description:
          "<%= j @ebook.title %>",


        order_id:
          "<%= @purchase.razorpay_order_id %>",


        /* ===================================================
           PREFILL
        ==================================================== */

        prefill: {

          name:
            "<%= j current_user.name.to_s %>",

          email:
            "<%= j current_user.email.to_s %>"

        },


        /* ===================================================
           THEME
        ==================================================== */

        theme: {

          color:
            "#1261d8"

        },


        /* ===================================================
           SUCCESS
        ==================================================== */

        handler:
          function (response) {

            const form =
              document.createElement("form");


            form.method =
              "POST";


            form.action =
              "<%= verify_ebook_payment_path(@purchase) %>";


            const csrf =
              document.querySelector(
                'meta[name="csrf-token"]'
              );


            function addField(name, value) {

              const input =
                document.createElement("input");

              input.type =
                "hidden";

              input.name =
                name;

              input.value =
                value || "";

              form.appendChild(input);

            }


            addField(
              "authenticity_token",
              csrf ? csrf.content : ""
            );


            addField(
              "razorpay_payment_id",
              response.razorpay_payment_id
            );


            addField(
              "razorpay_order_id",
              response.razorpay_order_id
            );


            addField(
              "razorpay_signature",
              response.razorpay_signature
            );


            document.body.appendChild(form);

            form.submit();

          },


        /* ===================================================
           MODAL DISMISS
        ==================================================== */

        modal: {

          ondismiss:
            function () {

              payButton.disabled = false;

              payButton.classList.remove("loading");

            }

        }

      };


      /* =====================================================
         OPEN RAZORPAY
      ====================================================== */

      try {

        const razorpay =
          new Razorpay(options);


        /* ===================================================
           PAYMENT FAILED
        ==================================================== */

        razorpay.on(
          "payment.failed",
          function () {

            window.location.href =
              "<%= ebook_payment_failed_path(@purchase) %>";

          }
        );


        razorpay.open();


      } catch (error) {

        console.error(
          "E-Book Razorpay initialization failed:",
          error
        );

        payButton.disabled = false;

        payButton.classList.remove("loading");

        alert(
          "Unable to open payment gateway. Please try again."
        );

      }

    });

  }


  /* =========================================================
     TURBO
  ========================================================= */

  document.addEventListener(
    "turbo:load",
    initializeEbookPaymentPage
  );


  /* =========================================================
     INITIAL LOAD
  ========================================================= */

  if (document.readyState !== "loading") {

    initializeEbookPaymentPage();

  } else {

    document.addEventListener(
      "DOMContentLoaded",
      initializeEbookPaymentPage,
      { once: true }
    );

  }

})();

</script>


<style nonce="<%= content_security_policy_nonce %>">

.ebook-payment-page {
  min-height: 100vh;
  padding: 100px 20px 50px;
  background:
    linear-gradient(135deg, #f4f7fb, #eef3ff);
  font-family: "Poppins", Arial, sans-serif;
}

.ebook-payment-wrapper {
  width: 100%;
  max-width: 850px;
  margin: 0 auto;
}

.ebook-payment-back {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 15px;
  color: #1261d8;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
}

.ebook-payment-header {
  margin-bottom: 20px;
}

.ebook-payment-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  border-radius: 20px;
  background: #eaf2ff;
  color: #1261d8;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .7px;
}

.ebook-payment-header h1 {
  margin: 8px 0 3px;
  color: #172033;
  font-size: 28px;
  font-weight: 800;
}

.ebook-payment-header p {
  margin: 0;
  color: #64748b;
  font-size: 13px;
}


/* E-BOOK CARD */

.ebook-payment-card {
  display: grid;
  grid-template-columns: 100px minmax(0, 1fr) auto;
  align-items: center;
  gap: 18px;
  padding: 18px;
  margin-bottom: 16px;
  background: #fff;
  border: 1px solid #e4eaf2;
  border-radius: 14px;
  box-shadow: 0 8px 25px rgba(15,23,42,.06);
}

.ebook-cover {
  width: 100px;
  height: 125px;
  overflow: hidden;
  border-radius: 8px;
  background: linear-gradient(135deg,#1261d8,#7048d8);
}

.ebook-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ebook-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 40px;
}

.ebook-info {
  min-width: 0;
}

.ebook-label {
  color: #64748b;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

.ebook-info h2 {
  margin: 4px 0;
  color: #172033;
  font-size: 19px;
  font-weight: 800;
  line-height: 1.3;
}

.ebook-info p {
  margin: 5px 0;
  color: #64748b;
  font-size: 12px;
}

.ebook-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  margin-top: 9px;
}

.ebook-meta span {
  color: #64748b;
  font-size: 10px;
}

.ebook-meta i {
  color: #1261d8;
}

.ebook-price {
  min-width: 130px;
  text-align: right;
}

.ebook-price span {
  display: block;
  color: #64748b;
  font-size: 10px;
}

.ebook-price strong {
  display: block;
  margin-top: 3px;
  color: #172033;
  font-size: 25px;
  font-weight: 800;
}


/* SECTION */

.ebook-payment-section {
  padding: 18px;
  margin-bottom: 16px;
  background: #fff;
  border: 1px solid #e4eaf2;
  border-radius: 12px;
  box-shadow: 0 6px 20px rgba(15,23,42,.04);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 15px;
}

.section-title > i {
  color: #1261d8;
  font-size: 18px;
}

.section-title h3 {
  margin: 0;
  color: #172033;
  font-size: 15px;
  font-weight: 800;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 7px 0;
  color: #64748b;
  font-size: 13px;
}

.summary-row strong {
  color: #334155;
}

.summary-divider {
  height: 1px;
  margin: 7px 0;
  background: #e5e7eb;
}

.summary-row.total {
  color: #172033;
  font-weight: 700;
}

.summary-row.total strong {
  color: #172033;
  font-size: 20px;
}


/* PAYMENT METHOD */

.payment-method {
  min-height: 58px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border: 1px solid #b7d2f8;
  border-radius: 10px;
  background: #f7fbff;
}

.payment-method-icon {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: #eaf3ff;
  color: #1261d8;
  font-size: 19px;
}

.payment-method > div:nth-child(2) {
  flex: 1;
}

.payment-method strong {
  display: block;
  color: #334155;
  font-size: 13px;
}

.payment-method span {
  display: block;
  margin-top: 2px;
  color: #64748b;
  font-size: 10px;
}

.payment-check {
  color: #1261d8;
  font-size: 18px;
}


/* SECURITY */

.ebook-security {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 14px;
  margin-bottom: 14px;
  border: 1px solid #cfe3fb;
  border-radius: 10px;
  background: #edf6ff;
}

.security-icon {
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: #dcecff;
  color: #1261d8;
  font-size: 18px;
}

.ebook-security strong {
  display: block;
  color: #14529b;
  font-size: 13px;
}

.ebook-security p {
  margin: 2px 0 0;
  color: #64748b;
  font-size: 10px;
}


/* PAY BUTTON */

.ebook-pay-button {
  width: 100%;
  min-height: 52px;
  border: 0;
  border-radius: 9px;
  background: linear-gradient(135deg,#1261d8,#0754c7);
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(18,97,216,.22);
  transition: .2s ease;
}

.ebook-pay-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(18,97,216,.32);
}

.ebook-pay-button:disabled,
.ebook-pay-button.loading {
  cursor: wait;
  opacity: .7;
  transform: none;
}

.ebook-payment-terms {
  margin: 10px 0 0;
  text-align: center;
  color: #94a3b8;
  font-size: 10px;
}


/* MOBILE */

@media (max-width: 700px) {

  .ebook-payment-page {
    padding: 85px 12px 35px;
  }

  .ebook-payment-card {
    grid-template-columns: 75px minmax(0,1fr);
    gap: 12px;
  }

  .ebook-cover {
    width: 75px;
    height: 100px;
  }

  .ebook-price {
    grid-column: 2;
    text-align: left;
    min-width: 0;
  }

  .ebook-price strong {
    font-size: 22px;
  }

  .ebook-payment-header h1 {
    font-size: 24px;
  }

}




/* =========================================================
   PAYMENT E-BOOK TITLE
========================================================= */

.payment-ebook-title {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
  padding: 9px 13px;
  border-radius: 9px;
  background: #ffffff;
  border: 1px solid #dce6f3;
  color: #172033;
  font-size: 13px;
  box-shadow: 0 4px 12px rgba(15, 23, 42, .05);
}

.payment-ebook-title i {
  color: #1261d8;
  font-size: 16px;
}

.payment-ebook-title strong {
  font-weight: 700;
}


/* =========================================================
   PAYMENT FOR BADGE
========================================================= */

.payment-for-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 10px;
  padding: 5px 9px;
  border-radius: 20px;
  background: #edf6ff;
  color: #1261d8;
  font-size: 10px;
  font-weight: 700;
}

.payment-for-badge i {
  font-size: 11px;
}

</style>