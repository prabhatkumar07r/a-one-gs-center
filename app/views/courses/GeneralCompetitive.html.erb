
<style>

.course-container{
  max-width:1200px;
  margin:40px auto;
  padding:20px;
}

.hero-section{
  background:linear-gradient(135deg,#0f172a,#1e3a8a,#2563eb);
  color:white;
  padding:60px 30px;
  border-radius:20px;
  text-align:center;
  box-shadow:0 10px 30px rgba(0,0,0,0.2);
}

.hero-section h1{
  font-size:48px;
  margin-bottom:15px;
}

.hero-section p{
  font-size:18px;
  opacity:0.9;
}

.course-info{
  display:flex;
  justify-content:center;
  gap:20px;
  margin-top:25px;
  flex-wrap:wrap;
}

.info-box{
  background:rgba(255,255,255,0.15);
  padding:12px 20px;
  border-radius:30px;
}

.subject-card{
  margin-top:40px;
  background:white;
  padding:35px;
  border-radius:20px;
  box-shadow:0 10px 25px rgba(0,0,0,0.1);
}

.subject-card h2{
  color:#1e40af;
  margin-bottom:20px;
  border-left:5px solid #2563eb;
  padding-left:15px;
}

.subject-card h3{
  color:#0f172a;
  margin-top:25px;
}

.subject-card p{
  color:#555;
  line-height:1.7;
}

.subject-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:15px;
  margin-top:20px;
}

.subject-item{
  background:linear-gradient(135deg,#eff6ff,#dbeafe);
  padding:18px;
  border-radius:12px;
  font-weight:600;
  transition:0.3s;
}

.subject-item:hover{
  transform:translateY(-5px);
  box-shadow:0 8px 15px rgba(37,99,235,0.2);
}

.feature-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:15px;
  margin-top:20px;
}

.feature-box{
  background:#f8fafc;
  padding:18px;
  border-radius:12px;
  border-left:4px solid #2563eb;
  font-weight:600;
}

.enroll-btn{
  display:inline-block;
  margin-top:30px;
  padding:14px 35px;
  background:linear-gradient(135deg,#2563eb,#1d4ed8);
  color:white;
  text-decoration:none;
  border-radius:30px;
  font-weight:bold;
  transition:0.3s;
}

.enroll-btn:hover{
  transform:translateY(-3px);
  box-shadow:0 10px 20px rgba(37,99,235,0.3);
}
.button-section{
  text-align:center;
  margin-top:40px;
}

.back-btn{
  background:#2563eb;
  color:white;
  text-decoration:none;
  padding:12px 30px;
  border-radius:30px;
  font-weight:bold;
}
</style>









<div class="subject-card">
  <h2>🎯 General Competitive Exams</h2>

  <p><strong>Duration:</strong> 1 Year</p>
  <p><strong>Seats:</strong> Limited Seats Available</p>

  <h3>Overview</h3>

  <p>
    Complete preparation for SSC, Railway, Banking, Bihar Police,
    NDA, CUET and other competitive examinations.
  </p>

  <h3>Subjects Covered</h3>

  <ul>
    <li>📚 General Knowledge</li>
    <li>🧠 Reasoning</li>
    <li>➗ Mathematics</li>
    <li>📝 English</li>
    <li>📰 Current Affairs</li>
  </ul>

  <h3>Course Features</h3>

  <ul>
    <li>✅ Daily Practice Sets</li>
    <li>✅ Weekly Mock Tests</li>
    <li>✅ Previous Year Questions</li>
    <li>✅ Doubt Clearing Sessions</li>
    <li>✅ Interview & Personality Development</li>
    <li>✅ Expert Faculty Guidance</li>
  </ul>
    <div class="button-section">
    <%= link_to "Back to Homepage",
                "/sample/homepage",
                class: "back-btn" %>
  </div>
</div>