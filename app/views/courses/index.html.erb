<% content_for :show_layout, true %>
<div class="d-flex justify-content-between align-items-center mb-3">

  <h2>📚 Course Management</h2>

  <%= link_to "➕ Add Course",
      new_course_path,
      class: "btn btn-success" %>

</div>
<div class="row mb-4">

  <div class="col-md-4">
    <div class="card shadow border-start border-primary border-4">
      <div class="card-body text-center">
        <h6>Total Courses</h6>
        <h3><%= @total_courses %></h3>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow border-start border-success border-4">
      <div class="card-body text-center">
        <h6>Active</h6>
        <h3><%= @active_courses %></h3>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow border-start border-danger border-4">
      <div class="card-body text-center">
        <h6>Inactive</h6>
        <h3><%= @inactive_courses %></h3>
      </div>
    </div>
  </div>

</div>

<%= form_with url: courses_path, method: :get, local: true do %>

<div class="row">

  <div class="col-md-6">
    <%= text_field_tag :search,
        params[:search],
        class: "form-control",
        placeholder: "Search Course..." %>
  </div>

  <div class="col-md-3">
    <%= select_tag :status,
        options_for_select(
          [
            ["All Status",""],
            ["Active","Active"],
            ["Inactive","Inactive"]
          ],
          params[:status]
        ),
        class: "form-select" %>
  </div>

  <div class="col-md-3">
    <%= submit_tag "Search",
        class: "btn btn-primary w-100" %>
  </div>

</div>

<% end %>
<p class="text-muted mt-3">
  Total Courses : <strong><%= @courses.count %></strong>
</p>

<div class="table-responsive">
  <table class="table table-bordered table-hover align-middle">

    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Duration</th>
        <th>Fees</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>

    <tbody>
      <% @courses.each do |course| %>
        <tr>
          <td><%= course.id %></td>
          <td><%= course.Course_name %></td>
          <td><%= course.duration %></td>
          <td>₹<%= course.fee %></td>

          <td>
            <% if course.status == "Active" %>
              <span class="badge bg-success">Active</span>
            <% else %>
              <span class="badge bg-danger">Inactive</span>
            <% end %>
          </td>

          <td>
            <div class="d-flex gap-1">

  <%= link_to course_path(course),
      class: "btn btn-info btn-sm text-white",
      title: "View Course" do %>
    <i class="bi bi-eye-fill"></i>
  <% end %>

  <%= link_to edit_course_path(course),
      class: "btn btn-warning btn-sm",
      title: "Edit Course" do %>
    <i class="bi bi-pencil-square"></i>
  <% end %>

<%= link_to course_playlists_path(course),
    class: "btn btn-primary btn-sm",
    title: "Manage Playlists" do %>
  <i class="bi bi-collection-play-fill"></i>
<% end %>
  <%= button_to course_path(course),
      method: :delete,
      form: { data: { turbo_confirm: "Delete this course?" } },
      class: "btn btn-danger btn-sm",
      title: "Delete Course" do %>
    <i class="bi bi-trash-fill"></i>
  <% end %>

</div>
          </td>
        </tr>
      <% end %>
    </tbody>

  </table>
</div>

<div class="d-flex justify-content-center mt-4">
  <%= paginate @courses %>
</div>