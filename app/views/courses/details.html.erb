<% content_for :show_layout, true %>

<div class="course-details-page">

  <!-- =========================================================
       BACK BUTTON
  ========================================================== -->

  <div class="course-back-wrapper">

    <%= link_to root_path(anchor: "course"),
        class: "course-back-btn",
        id: "courseBackBtn" do %>

      <span class="back-arrow">
        <i class="fas fa-arrow-left"></i>
      </span>

      <span>Back</span>

    <% end %>

  </div>


  <!-- =========================================================
       MAIN COURSE CONTAINER
  ========================================================== -->

  <div class="course-main-container">

    <!-- =======================================================
         LEFT SIDE
    ======================================================== -->

    <section class="course-left">


      <!-- =====================================================
           BRAND
      ====================================================== -->

      <div class="course-brand-section">

        <div class="brand-badge">

          <div class="coaching-logo">
            <%= image_tag "logo.jpeg",
                          alt: "A One GS Center Logo" %>
          </div>

          <span>
            A ONE GS CENTER
          </span>

        </div>

      </div>


      <!-- =====================================================
           COURSE HERO
      ====================================================== -->

      <div class="course-hero">

        <h1>
          <%= @course.Course_name %>
        </h1>

        <p>
          Learn. Practice. Grow.
        </p>

      </div>


      <!-- =====================================================
           COURSE INFORMATION
      ====================================================== -->

      <div class="course-info-grid">


        <!-- DURATION -->

        <div class="info-card">

          <div class="info-content">

            <span>
              Duration
            </span>

            <strong>
              <%= @course.duration.presence || "—" %>
            </strong>

          </div>

        </div>


        <!-- LESSONS -->

        <div class="info-card">

          <div class="info-content">

            <span>
              Lessons
            </span>

            <strong>
              <%= @videos.count %>
            </strong>

          </div>

        </div>


        <!-- TEACHER -->

        <div class="info-card">

          <div class="info-content">

            <span>
              Teacher
            </span>

            <strong>
              <%= @course.teacher&.name || "Not Assigned" %>
            </strong>

          </div>

        </div>

      </div>


      <!-- =====================================================
           ABOUT + COURSE CONTENT TABS
      ====================================================== -->

      <div class="course-tabs-wrapper">


        <!-- ===================================================
             TAB NAVIGATION
        ==================================================== -->

        <div class="course-tabs-nav">

          <!-- ABOUT -->

          <button
            type="button"
            class="course-tab-btn active"
            data-course-tab="about-course-tab">

            <i class="fas fa-book-open"></i>

            <span>
              About This Course
            </span>

          </button>


          <!-- CONTENT -->

          <button
            type="button"
            class="course-tab-btn"
            data-course-tab="course-content-tab">

            <span>
              Course Content
            </span>

          </button>

        </div>


        <!-- ===================================================
             TAB CONTENT
        ==================================================== -->

        <div class="course-tabs-content">


          <!-- =================================================
               ABOUT COURSE
          ================================================== -->

          <div
            id="about-course-tab"
            class="course-tab-pane active">

            <div class="course-tab-heading">

              <div>

                <h2>
                  About This Course
                </h2>

                <p>
                  Learn more about this course and what you will study.
                </p>

              </div>

            </div>


            <div class="course-description-box">

              <%= simple_format(
                    @course.description.presence ||
                    "This course provides complete learning material with practical lessons and guided learning."
                  ) %>

            </div>

          </div>


          <!-- =================================================
               COURSE CONTENT
          ================================================== -->

          <div
            id="course-content-tab"
            class="course-tab-pane">

            <div class="course-tab-heading">

              <div>

                <h2>
                  Course Content
                </h2>

                <p>
                  Explore playlists and video lessons included in this course.
                </p>

              </div>

            </div>


            <% if @videos.any? %>

              <%
                approved =
                  user_signed_in? &&
                  @enrollment&.status == "Approved"

                free_videos_count =
                  @videos.where(is_free: true).count
              %>


              <!-- =================================================
                   PLAYLISTS
              ================================================== -->

              <div class="course-playlists">

                <% @course.playlists
                         .order(:position, :id)
                         .each do |playlist| %>

                  <%
                    playlist_videos =
                      playlist.videos.order(:position, :id)

                    playlist_open =
                      playlist_videos.any?
                  %>

                  <% next if playlist_videos.empty? %>


                  <!-- PLAYLIST -->

                  <div
                    class="course-playlist <%= 'open' if playlist_open %>">


                    <!-- PLAYLIST HEADER -->

                    <button
                      type="button"
                      class="course-playlist-header"
                      aria-expanded="<%= playlist_open %>">

                      <div class="playlist-header-left">

                        <div class="playlist-icon">
                          <i class="fas fa-folder"></i>
                        </div>

                        <div class="playlist-header-text">

                          <strong>
                            <%= playlist.title %>
                          </strong>

                          <span>
                            <%= playlist_videos.count %>
                            <%= playlist_videos.count == 1 ? "Video" : "Videos" %>
                          </span>

                        </div>

                      </div>


                      <div class="playlist-header-right">

                        <i class="fas fa-chevron-down playlist-chevron"></i>

                      </div>

                    </button>


                    <!-- PLAYLIST VIDEOS -->

                    <div class="course-playlist-videos">

                      <% playlist_videos.each_with_index do |video, index| %>


                        <!-- =================================================
                             VIDEO ROW
                        ================================================== -->

                        <div class="course-video-row">


                          <!-- SERIAL NUMBER -->

                          <div class="course-video-number">
                            <%= index + 1 %>.
                          </div>


                          <!-- VIDEO INFORMATION -->

                          <div class="course-video-info">

                            <h4>
                              <%= video.title %>
                            </h4>


                            <div class="course-video-meta">

                              <% if video.is_free? %>

                                <span class="free-preview-badge">

                                  <i class="fas fa-unlock"></i>

                                  FREE PREVIEW

                                </span>

                              <% else %>

                                <span class="paid-video-badge">

                                  <i class="fas fa-lock"></i>

                                  PAID

                                </span>

                              <% end %>

                            </div>

                          </div>


                          <!-- ACTION -->

                          <div class="course-video-action">


                            <% if video.is_free? %>

                              <%= link_to learning_video_path(@course, video),
                                  class: "watch-preview-btn" do %>

                                <i class="fas fa-play"></i>

                                <span>
                                  Watch Free Preview
                                </span>

                              <% end %>


                            <% elsif approved %>

                              <%= link_to learning_video_path(@course, video),
                                  class: "watch-video-btn" do %>

                                <i class="fas fa-play"></i>

                                <span>
                                  Watch Video
                                </span>

                              <% end %>


                            <% else %>

                              <%= link_to new_student_enrollment_path(
                                    course_id: @course.id
                                  ),
                                  class: "locked-video-btn" do %>

                                <i class="fas fa-lock"></i>

                                <span>
                                  Enroll to Watch
                                </span>

                              <% end %>

                            <% end %>


                          </div>

                        </div>


                      <% end %>

                    </div>

                  </div>

                <% end %>

              </div>


              <!-- =================================================
                   FREE PREVIEW INFORMATION
              ================================================== -->

              <% if free_videos_count > 0 %>

                <div class="free-preview-information">

                  <div class="free-preview-information-icon">

                    <i class="fas fa-play-circle"></i>

                  </div>


                  <div>

                    <strong>
                      Free Preview Available
                    </strong>

                    <p>

                      Watch
                      <%= free_videos_count %>
                      free preview
                      <%= free_videos_count == 1 ? "video" : "videos" %>
                      before enrolling in this course.

                    </p>

                  </div>

                </div>

              <% end %>


            <% else %>


              <!-- =================================================
                   NO CONTENT
              ================================================== -->

              <div class="course-no-content">

                <div class="no-content-icon">

                  <i class="fas fa-folder-open"></i>

                </div>

                <h3>
                  Course Content Coming Soon
                </h3>

                <p>
                  Learning material will be added soon.
                </p>

              </div>


            <% end %>

          </div>

        </div>

      </div>

    </section>


    <!-- =======================================================
         RIGHT SIDE — PAYMENT
    ======================================================== -->

    <aside class="course-right">


      <!-- =====================================================
           PAYMENT CARD
      ====================================================== -->

      <div class="payment-card">


        <!-- PAYMENT HEADER -->

        <div class="payment-header">

          <span>
            COURSE PRICE
          </span>

          <div class="secure-payment">

            <i class="fas fa-shield-alt"></i>

            Secure Payment

          </div>

        </div>


        <!-- ===================================================
             PRICE CALCULATION
        ==================================================== -->

        <%
          course_fee = @course.fee.to_d

          discount =
            if @enrollment&.fee.present?

              @enrollment.fee.discount_amount.to_d

            else

              @course.current_discount_amount.to_d

            end

          final_amount =
            if @enrollment&.fee.present?

              @enrollment.fee.total_fee.to_d -
                @enrollment.fee.discount_amount.to_d

            else

              @course.final_fee.to_d

            end

          final_amount = 0.to_d if final_amount < 0
        %>


        <!-- ORIGINAL PRICE -->

        <% if discount > 0 %>

          <div class="price-row">

            <div class="original-price">

              ₹<%= number_with_delimiter(course_fee.to_i) %>

            </div>


            <div class="discount-badge">

              Save ₹<%= number_with_delimiter(discount.to_i) %>

            </div>

          </div>

        <% end %>


        <!-- FINAL PRICE -->

        <div class="final-price">

          ₹<%= number_with_delimiter(final_amount.to_i) %>

        </div>


        <!-- DISCOUNT -->

        <% if discount > 0 %>

          <div class="discount-box">

            <div class="discount-icon">

              <i class="fas fa-gift"></i>

            </div>


            <div>

              <strong>

                <%= @course.active_discount&.name ||
                    @enrollment&.fee&.discount_name ||
                    "Special Offer" %>

              </strong>


              <p>

                You save
                ₹<%= number_with_delimiter(discount.to_i) %>
                on this course.

              </p>

            </div>

          </div>

        <% end %>


        <!-- ===================================================
             PAYMENT SUMMARY
        ==================================================== -->

        <div class="payment-summary">


          <div class="summary-row">

            <span>
              Course Fee
            </span>

            <strong>

              ₹<%= number_with_delimiter(course_fee.to_i) %>

            </strong>

          </div>


          <% if discount > 0 %>

            <div class="summary-row discount-row">

              <span>
                Discount
              </span>

              <strong>

                - ₹<%= number_with_delimiter(discount.to_i) %>

              </strong>

            </div>

          <% end %>


          <div class="summary-divider"></div>


          <div class="summary-row payable-row">

            <span>
              Payable Amount
            </span>

            <strong>

              ₹<%= number_with_delimiter(final_amount.to_i) %>

            </strong>

          </div>

        </div>


        <!-- ===================================================
             PAYMENT ACTION
        ==================================================== -->

        <div class="payment-action">


          <% if user_signed_in? %>


            <!-- APPROVED -->

            <% if @enrollment&.status == "Approved" %>

              <%= link_to learning_course_path(@course),
                  class: "payment-btn success-btn" do %>

                <i class="fas fa-play"></i>

                Start Learning

              <% end %>


            <!-- FREE COURSE -->

            <% elsif @course.free? %>

              <%= button_to enroll_free_course_path(@course),
                  method: :post,
                  class: "payment-btn free-btn" do %>

                <i class="fas fa-graduation-cap"></i>

                Enroll for Free

              <% end %>


            <!-- EXISTING PAID ENROLLMENT -->

            <% elsif @enrollment.present? %>

              <%= link_to payment_path(@enrollment),
                  class: "payment-btn pay-btn" do %>

                <i class="fas fa-credit-card"></i>

                Pay ₹<%= number_with_delimiter(final_amount.to_i) %>

              <% end %>


              <div class="pending-note">

                <i class="fas fa-hourglass-half"></i>

                Enrollment is waiting for payment/approval

              </div>


            <!-- NEW PAID ENROLLMENT -->

            <% else %>

              <%= link_to new_student_enrollment_path(
                    course_id: @course.id
                  ),
                  class: "payment-btn pay-btn" do %>

                <i class="fas fa-clipboard-list"></i>

                Enroll Now

              <% end %>

            <% end %>


          <% else %>


            <!-- LOGIN -->

            <%= link_to new_user_session_path,
                class: "payment-btn login-btn" do %>

              <i class="fas fa-lock"></i>

              Login to Enroll

            <% end %>

          <% end %>

        </div>


        <!-- ===================================================
             SECURITY
        ==================================================== -->

        <div class="payment-security">

          <div>

            <i class="fas fa-lock"></i>

            <span>
              Secure & Safe
            </span>

          </div>


          <div>

            <i class="fas fa-bolt"></i>

            <span>
              Fast Payment
            </span>

          </div>


          <div>

            <i class="fas fa-shield-alt"></i>

            <span>
              Trusted Checkout
            </span>

          </div>

        </div>

      </div>


      <!-- =====================================================
           SUPPORT CARD
      ====================================================== -->

      <div class="support-card">

        <div>

          <h3>
            Need Help?
          </h3>

          <p>
            Contact A One GS Center for course-related assistance.
          </p>

        </div>

      </div>

    </aside>

  </div>

</div>


<style>

/* ============================================================
   COURSE DETAILS PAGE
============================================================ */

.course-details-page {

  min-height: 100vh;

  padding: 30px 5% 70px;

  position: relative;

  overflow: hidden;

  box-sizing: border-box;

  color: #32164f;

  background:
    radial-gradient(
      circle at 10% 5%,
      rgba(255,255,255,.20),
      transparent 25%
    ),
    radial-gradient(
      circle at 90% 10%,
      rgba(255,255,255,.12),
      transparent 28%
    ),
    radial-gradient(
      circle at 50% 100%,
      rgba(255,255,255,.10),
      transparent 35%
    ),
    linear-gradient(
      135deg,
      #c026d3 0%,
      #b414d0 30%,
      #a21caf 62%,
      #86198f 100%
    );
}


/* ============================================================
   BACK BUTTON
============================================================ */

.course-back-wrapper {

  width: 100%;

  padding-top: 110px;

  padding-left: 10px;

  margin-bottom: 25px;

  position: relative;

  z-index: 5;
}

.course-back-btn {

  display: inline-flex;

  align-items: center;

  gap: 10px;

  padding: 13px 22px;

  border: 1px solid rgba(255,255,255,.45);

  border-radius: 14px;

  background: rgba(255,255,255,.96);

  color: #7e22ce;

  font-size: 16px;

  font-weight: 800;

  text-decoration: none;

  box-shadow:
    0 10px 28px rgba(70,10,90,.22);

  transition:
    transform .25s ease,
    box-shadow .25s ease,
    background .25s ease;
}

.course-back-btn:hover {

  transform: translateX(-4px);

  background: #ffffff;

  color: #a21caf;

  box-shadow:
    0 15px 35px rgba(70,10,90,.30);
}

.back-arrow {

  font-size: 22px;

  line-height: 1;
}


/* ============================================================
   MAIN CONTAINER
============================================================ */

.course-main-container {

  width: 100%;

  max-width: 1450px;

  margin: 0 auto;

  display: grid;

  grid-template-columns:
    minmax(0, 1.65fr)
    minmax(350px, .75fr);

  gap: 28px;

  padding: 28px;

  box-sizing: border-box;

  border-radius: 30px;

  border: 1px solid rgba(255,255,255,.55);

  background: rgba(255,255,255,.95);

  box-shadow:
    0 30px 80px rgba(70,10,90,.28),
    0 8px 25px rgba(255,255,255,.15);

  backdrop-filter: blur(18px);

  animation:
    courseFadeIn .55s ease both;
}


/* ============================================================
   LEFT / RIGHT
============================================================ */

.course-left {

  min-width: 0;
}

.course-right {

  position: sticky;

  top: 25px;

  align-self: start;
}


/* ============================================================
   BRAND
============================================================ */

.course-brand-section {

  width: 100%;

  text-align: center;

  margin-bottom: 24px;
}

.brand-badge {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 12px;

  padding: 9px 20px;

  background: rgba(255,255,255,.97);

  border: 1px solid rgba(255,255,255,.6);

  border-radius: 18px;

  color: #7e22ce;

  font-size: 15px;

  font-weight: 900;

  letter-spacing: .8px;

  box-shadow:
    0 10px 30px rgba(70,10,90,.18);

  box-sizing: border-box;
}

.coaching-logo {

  width: 48px;

  height: 48px;

  display: flex;

  align-items: center;

  justify-content: center;

  overflow: hidden;

  border-radius: 10px;

  background: #ffffff;
}

.coaching-logo img {

  width: 100%;

  height: 100%;

  display: block;

  object-fit: contain;
}


/* ============================================================
   HERO
============================================================ */

.course-hero {

  min-height: 290px;

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;

  padding: 40px;

  border-radius: 25px;

  border: 1px solid rgba(255,255,255,.30);

  background:
    radial-gradient(
      circle at 50% 20%,
      rgba(255,255,255,.18),
      transparent 45%
    ),
    linear-gradient(
      135deg,
      #c026d3 0%,
      #a21caf 55%,
      #86198f 100%
    );

  box-shadow:
    0 20px 50px rgba(126,34,206,.28),
    inset 0 1px 0 rgba(255,255,255,.25);

  text-align: center;
}

.course-hero h1 {

  margin: 0;

  max-width: 850px;

  color: #ffffff;

  font-size: clamp(30px, 4vw, 48px);

  line-height: 1.15;

  font-weight: 900;

  text-shadow:
    0 5px 20px rgba(60,5,80,.28);
}

.course-hero p {

  margin: 14px 0 0;

  color: rgba(255,255,255,.90);

  font-size: 16px;

  font-weight: 600;
}


/* ============================================================
   INFORMATION
============================================================ */

.course-info-grid {

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 14px;

  margin-top: 18px;
}

.info-card {

  display: flex;

  align-items: center;

  padding: 18px;

  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      #ffffff,
      #faf5ff
    );

  border: 1px solid #eadcff;

  box-shadow:
    0 8px 22px rgba(126,34,206,.08);

  transition:
    transform .25s ease,
    border-color .25s ease,
    box-shadow .25s ease;
}

.info-card:hover {

  transform: translateY(-4px);

  border-color: #c084fc;

  box-shadow:
    0 15px 30px rgba(126,34,206,.15);
}

.info-content {

  min-width: 0;
}

.info-content span {

  display: block;

  margin-bottom: 5px;

  color: #80658e;

  font-size: 12px;

  font-weight: 700;
}

.info-content strong {

  display: block;

  color: #3b2054;

  font-size: 15px;

  font-weight: 800;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;
}


/* ============================================================
   TABS
============================================================ */

.course-tabs-wrapper {

  margin-top: 22px;

  overflow: hidden;

  border-radius: 24px;

  background: #ffffff;

  border: 1px solid #eadcff;

  box-shadow:
    0 12px 35px rgba(126,34,206,.10);
}

.course-tabs-nav {

  width: 100%;

  display: flex;

  align-items: stretch;

  background:
    linear-gradient(
      135deg,
      #faf5ff,
      #f5edff,
      #fdf4ff
    );

  border-bottom:
    1px solid #eadcff;
}

.course-tab-btn {

  position: relative;

  flex: 1;

  min-height: 64px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 9px;

  border: none;

  outline: none;

  background: transparent;

  color: #80658e;

  padding: 16px 20px;

  font-size: 15px;

  font-weight: 900;

  cursor: pointer;

  transition:
    color .25s ease,
    background .25s ease;
}

.course-tab-btn:hover {

  background:
    rgba(192,38,211,.07);

  color: #a21caf;
}

.course-tab-btn.active {

  background: #ffffff;

  color: #8b1bb1;
}

.course-tab-btn.active::after {

  content: "";

  position: absolute;

  left: 15%;

  right: 15%;

  bottom: 0;

  height: 4px;

  border-radius:
    8px 8px 0 0;

  background:
    linear-gradient(
      90deg,
      #7e22ce,
      #c026d3,
      #ec4899
    );
}

.course-tabs-content {

  padding: 28px;
}

.course-tab-pane {

  display: none;

  animation:
    courseTabFade .30s ease;
}

.course-tab-pane.active {

  display: block;
}


/* ============================================================
   TAB HEADING
============================================================ */

.course-tab-heading {

  margin-bottom: 22px;

  padding-bottom: 18px;

  border-bottom:
    1px solid #eadcff;
}

.course-tab-heading h2 {

  margin: 0 0 5px;

  color: #3b2054;

  font-size: 24px;

  font-weight: 900;
}

.course-tab-heading p {

  margin: 0;

  color: #80658e;

  font-size: 13px;

  line-height: 1.5;
}


/* ============================================================
   DESCRIPTION
============================================================ */

.course-description-box {

  padding: 22px 24px;

  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      #ffffff,
      #fdfaff,
      #faf5ff
    );

  border: 1px solid #eadcff;

  box-shadow:
    0 7px 20px rgba(126,34,206,.06);

  color: #725d7d;

  font-size: 16px;

  line-height: 1.9;
}

.course-description-box p {

  margin: 0 0 12px;
}

.course-description-box p:last-child {

  margin-bottom: 0;
}


/* ============================================================
   PLAYLISTS
============================================================ */

.course-playlists {

  display: flex;

  flex-direction: column;

  gap: 12px;
}

.course-playlist {

  overflow: hidden;

  border-radius: 17px;

  background:
    linear-gradient(
      135deg,
      #ffffff,
      #fdfaff
    );

  border: 1px solid #eadcff;

  box-shadow:
    0 6px 18px rgba(126,34,206,.06);

  transition:
    border-color .25s ease,
    box-shadow .25s ease;
}

.course-playlist.open {

  border-color: #d8b4f5;

  box-shadow:
    0 10px 25px rgba(126,34,206,.10);
}


/* ============================================================
   PLAYLIST HEADER
============================================================ */

.course-playlist-header {

  width: 100%;

  min-height: 72px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  padding: 12px 17px;

