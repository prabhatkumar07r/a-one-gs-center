
<% content_for :enable_theme_toggle, true %>

<% content_for :show_layout, true %>
<main class="student-course-details">

  <!-- =====================================================
       BREADCRUMB
  ====================================================== -->

  <div class="course-breadcrumb">
    <%= link_to student_dashboard_path do %>
      <i class="fas fa-home"></i>
      Home
    <% end %>

    <i class="fas fa-chevron-right"></i>

    <span>Courses</span>

    <i class="fas fa-chevron-right"></i>

    <strong>
      <%= @course.Course_name %>
    </strong>
  </div>

<%= link_to homepage_path(anchor: "courses"),
      class: "payment-back-link",
      title: "Back to Courses" do %>

  <span class="back-icon">
    <i class="bi bi-arrow-left"></i>
  </span>

<% end %>


  <!-- =====================================================
       COURSE HERO
  ====================================================== -->

  <section class="course-hero">

    <div class="course-hero-image">

      <% if @course.image.present? %>

        <%= image_tag @course.image,
              alt: @course.Course_name %>

      <% else %>

        <div class="course-image-placeholder">
          <i class="fas fa-graduation-cap"></i>
        </div>

      <% end %>

    </div>


    <div class="course-hero-info">

      <div class="course-label">
        <i class="fas fa-book-open"></i>
        COURSE
      </div>

      <h1>
        <%= @course.Course_name %>
      </h1>

      <p class="course-subtitle">
        Complete learning course with lectures,
        notes, practice and quizzes.
      </p>


      <!-- Course Meta -->

      <div class="course-meta">

        <span>
          <i class="fas fa-user-tie"></i>
          <%= @course.teacher&.name || "Expert Instructor" %>
        </span>

        <span>
          <i class="fas fa-video"></i>
          Course Videos
        </span>

        <span>
          <i class="fas fa-book"></i>
          Notes & Resources
        </span>

      </div>


      <!-- Rating -->

      <div class="course-rating">

        <span class="rating-stars">
          ★★★★★
        </span>

        <strong>4.8/5</strong>

        <span>
          Student Learning Course
        </span>

      </div>


      <!-- Pricing -->

      <div class="course-price-row">

        <% if @course.respond_to?(:original_fee) &&
              @course.original_fee.present? &&
              @course.original_fee.to_f > @course.fee.to_f %>

          <span class="course-old-price">
            ₹<%= number_with_delimiter(@course.original_fee.to_i) %>
          </span>

        <% end %>


        <span class="course-current-price">

          <% if @course.respond_to?(:free?) && @course.free? %>

            Free

          <% elsif @course.fee.to_f <= 0 %>

            Free

          <% else %>

            ₹<%= number_with_delimiter(@course.fee.to_i) %>

          <% end %>

        </span>


        <% if @course.respond_to?(:discount_percentage) &&
              @course.discount_percentage.to_f > 0 %>

          <span class="course-discount">
            <%= @course.discount_percentage.to_i %>% OFF
          </span>

        <% end %>

      </div>


      <!-- =================================================
           ACTIONS
      ================================================== -->
<div class="course-actions">

  <% if @enrollment.present? && @enrollment.status == "Approved" %>

    <%= link_to learning_course_path(@course),
          class: "course-primary-btn" do %>

      <i class="fas fa-play"></i>
      Continue Learning

    <% end %>

  <% elsif @course.respond_to?(:free?) && @course.free? %>

    <%= button_to enrollments_path,
          method: :post,
          params: { enrollment: { course_id: @course.id } },
          class: "course-primary-btn" do %>

      <i class="fas fa-graduation-cap"></i>
      Enroll for Free

    <% end %>

  <% elsif @course.fee.to_f <= 0 %>

    <%= button_to enrollments_path,
          method: :post,
          params: { enrollment: { course_id: @course.id } },
          class: "course-primary-btn" do %>

      <i class="fas fa-graduation-cap"></i>
      Enroll for Free

    <% end %>

  <% elsif @enrollment.present? && @enrollment.status == "Pending" %>

    <%= link_to payment_path(@enrollment),
          class: "course-primary-btn" do %>

      <i class="fas fa-credit-card"></i>
      Continue Payment

    <% end %>

  <% else %>

    <%= button_to enrollments_path,
          method: :post,
          params: { enrollment: { course_id: @course.id } },
          class: "course-primary-btn" do %>

      <i class="fas fa-shopping-cart"></i>
      Enroll Now

    <% end %>

  <% end %>


  <button type="button"
          class="course-wishlist-btn"
          onclick="toggleCourseWishlist(this)">

    <i class="far fa-heart"></i>

    <span>Add to Wishlist</span>

  </button>

</div>

    </div>

  </section>



  <!-- =====================================================
       COURSE TABS
  ====================================================== -->
<div class="course-tabs">

  <button class="course-tab active" data-tab="about">
    About
  </button>

  <button class="course-tab" data-tab="content">
    Course Content
  </button>

  <button class="course-tab" data-tab="instructor">
    Instructor
  </button>

  <button class="course-tab" data-tab="reviews">
    Reviews
  </button>

  <button class="course-tab" data-tab="faqs">
    FAQs
  </button>

</div>



  <!-- =====================================================
       MAIN CONTENT + SIDEBAR
  ====================================================== -->

  <div class="course-details-grid">


    <!-- ===================================================
         LEFT CONTENT
    ==================================================== -->

   <!-- ===================================================
     LEFT CONTENT
==================================================== -->

<div class="course-main-column">


  <!-- =================================================
       ABOUT TAB
  ================================================== -->

  <div id="about" class="course-tab-panel active">


    <!-- ================================================
         OVERVIEW
    ================================================= -->

    <section class="course-content-card">

      <div class="section-heading">

        <div class="section-heading-icon">
          <i class="fas fa-book-open"></i>
        </div>

        <div>

          <h2>
            About This Course
          </h2>

          <p>
            Learn, practice and improve your concepts
            with structured course content.
          </p>

        </div>

      </div>


      <div class="course-description">

        <% if @course.respond_to?(:description) &&
              @course.description.present? %>

          <%= simple_format(@course.description) %>

        <% else %>

          <p>
            This course is designed to help students
            understand important concepts through
            structured video lectures, notes,
            practice questions and quizzes.
          </p>

          <p>
            Follow the lessons step by step and
            practice regularly to improve your
            preparation and performance.
          </p>

        <% end %>

      </div>

    </section>



    <!-- ================================================
         COURSE INCLUDES
    ================================================= -->

    <section class="course-content-card">

      <div class="section-title">

        <i class="fas fa-layer-group"></i>

        <h2>
          Course Includes
        </h2>

      </div>


      <div class="includes-grid">


        <div class="include-item">

          <div class="include-icon blue">
            <i class="fas fa-play"></i>
          </div>

          <div>

            <strong>
              Video Lectures
            </strong>

            <small>
              High-quality learning videos
            </small>

          </div>

        </div>


        <div class="include-item">

          <div class="include-icon green">
            <i class="fas fa-file-alt"></i>
          </div>

          <div>

            <strong>
              Study Notes
            </strong>

            <small>
              Downloadable learning material
            </small>

          </div>

        </div>


        <div class="include-item">

          <div class="include-icon orange">
            <i class="fas fa-pencil-alt"></i>
          </div>

          <div>

            <strong>
              Practice Questions
            </strong>

            <small>
              Practice and improve concepts
            </small>

          </div>

        </div>


        <div class="include-item">

          <div class="include-icon purple">
            <i class="fas fa-question-circle"></i>
          </div>

          <div>

            <strong>
              Quizzes
            </strong>

            <small>
              Existing course & video quizzes
            </small>

          </div>

        </div>


        <div class="include-item">

          <div class="include-icon pink">
            <i class="fas fa-chart-line"></i>
          </div>

          <div>

            <strong>
              Progress Tracking
            </strong>

            <small>
              Track your learning progress
            </small>

          </div>

        </div>


        <div class="include-item">

          <div class="include-icon teal">
            <i class="fas fa-certificate"></i>
          </div>

          <div>

            <strong>
              Certificate
            </strong>

            <small>
              Course completion certificate
            </small>

          </div>

        </div>


      </div>

    </section>



    <!-- ================================================
         WHO IS THIS COURSE FOR
    ================================================= -->

    <section class="course-content-card">

      <div class="section-title">

        <i class="fas fa-users"></i>

        <h2>
          Who Is This Course For?
        </h2>

      </div>


      <ul class="course-target-list">

        <li>
          <i class="fas fa-check"></i>
          Students preparing for their examinations
        </li>

        <li>
          <i class="fas fa-check"></i>
          Students who want structured learning
        </li>

        <li>
          <i class="fas fa-check"></i>
          Students looking for video-based learning
        </li>

        <li>
          <i class="fas fa-check"></i>
          Students who want regular practice and quizzes
        </li>

      </ul>

    </section>

  </div>



  <!-- =================================================
       COURSE CONTENT TAB
  ================================================== -->

  <div id="content" class="course-tab-panel">


    <section class="course-content-card">

      <div class="content-header">

        <div>

          <div class="section-title">

            <i class="fas fa-list"></i>

            <h2>
              Course Content
            </h2>

          </div>

          <p class="section-subtitle">
            Explore the available lessons and
            learning resources.
          </p>

        </div>

      </div>


      <% if @course.respond_to?(:playlists) &&
            @course.playlists.present? %>


        <div class="course-chapters">

          <% @course.playlists.each_with_index do |playlist, index| %>

            <div class="chapter-item">

              <button type="button"
                      class="chapter-header"
                      onclick="toggleChapter(this)">

                <div class="chapter-number">
                  <%= index + 1 %>
                </div>

                <div class="chapter-info">

                  <strong>

                    <%= playlist.respond_to?(:name) ?
                          playlist.name :
                          "Chapter #{index + 1}" %>

                  </strong>

                  <div class="chapter-meta">

                    <span>
                      <i class="fas fa-video"></i>
                      Lessons
                    </span>

                    <span>
                      <i class="fas fa-file-alt"></i>
                      Notes
                    </span>

                    <span>
                      <i class="fas fa-question-circle"></i>
                      Quiz
                    </span>

                  </div>

                </div>

                <i class="fas fa-chevron-down chapter-arrow"></i>

              </button>


              <div class="chapter-body">

                <div class="chapter-empty">

                  <i class="fas fa-play-circle"></i>

                  <span>
                    Open Learning Portal to access
                    the lessons in this section.
                  </span>

                </div>

              </div>

            </div>

          <% end %>

        </div>


      <% else %>

        <div class="empty-course-content">

          <i class="fas fa-book-open"></i>

          <h3>
            Course content is being prepared
          </h3>

          <p>
            Lessons and resources will appear here
            when they are available.
          </p>

        </div>

      <% end %>

    </section>

  </div>



  <!-- =================================================
       INSTRUCTOR TAB
  ================================================== -->

 <!-- =========================================================
     INSTRUCTOR
========================================================= -->

<div id="instructor" class="course-tab-panel">

  <section class="course-content-card">

    <div class="section-title">

      <i class="fas fa-user-tie"></i>

      <h2>
        Instructor
      </h2>

    </div>


    <div class="instructor-card">


      <!-- =================================================
           INSTRUCTOR AVATAR
      ================================================== -->

      <div class="instructor-avatar">

        <% if @course.teacher&.photo&.attached? %>

          <%= image_tag @course.teacher.photo,
                alt: @course.teacher.name,
                class: "instructor-avatar-image" %>

        <% else %>

          <i class="fas fa-user"></i>

        <% end %>

      </div>


      <!-- =================================================
           INSTRUCTOR INFO
      ================================================== -->

      <div class="instructor-info">

        <h3>
          <%= @course.teacher&.name ||
              "A-One GS Center Instructor" %>
        </h3>

        <span>
          Course Instructor
        </span>


        <div class="instructor-rating">

          <span>
            ★
          </span>

          <strong>
            4.8
          </strong>

          Instructor Rating

        </div>

      </div>


      <!-- =================================================
           DESCRIPTION
      ================================================== -->

      <div class="instructor-description">

        <p>
          Experienced educator focused on helping
          students understand concepts and improve
          their academic preparation.
        </p>

      </div>


    </div>

  </section>

</div>


  <!-- =================================================
       REVIEWS TAB
  ================================================== -->

  <div id="reviews" class="course-tab-panel">

    <section class="course-content-card">

      <div class="section-title">

        <i class="fas fa-star"></i>

        <h2>
          Student Reviews
        </h2>

      </div>


      <div class="review-summary">

        <div class="review-score">

          <strong>
            4.8
          </strong>

          <span>
            ★★★★★
          </span>

          <small>
            Overall Course Rating
          </small>

        </div>


        <div class="review-message">

          <h3>
            Learn with confidence
          </h3>

          <p>
            Student feedback and course reviews
            will appear here.
          </p>

        </div>

      </div>

    </section>

  </div>



  <!-- =================================================
       FAQ TAB
  ================================================== -->

  <div id="faqs" class="course-tab-panel">

    <section class="course-content-card">

      <div class="section-title">

        <i class="fas fa-question-circle"></i>

        <h2>
          Frequently Asked Questions
        </h2>

      </div>


      <div class="faq-list">


        <details>

          <summary>

            How can I access this course?

            <i class="fas fa-chevron-down"></i>

          </summary>

          <p>
            Enroll in the course and access your
            available learning content from the
            Learning Portal.
          </p>

        </details>


        <details>

          <summary>

            Are course videos available after enrollment?

            <i class="fas fa-chevron-down"></i>

          </summary>

          <p>
            Approved enrollment provides access to
            the course learning content according to
            the existing course access rules.
          </p>

        </details>


        <details>

          <summary>

            Are quizzes included?

            <i class="fas fa-chevron-down"></i>

          </summary>

          <p>
            Your existing course-wise and video-wise
            quiz system remains available for the
            enrolled course.
          </p>

        </details>


        <details>

          <summary>

            Is this course available on mobile?

            <i class="fas fa-chevron-down"></i>

          </summary>

          <p>
            Yes. The student learning interface is
            designed to work on mobile, tablet and
            desktop screens.
          </p>

        </details>


      </div>

    </section>

  </div>


</div>

    <!-- ===================================================
         RIGHT SIDEBAR
    ==================================================== -->
<aside class="course-sidebar">


  <!-- =====================================================
       FREE PREVIEW
  ====================================================== -->

  <div class="sidebar-card preview-card">

    <div class="preview-icon">
      <i class="fas fa-play"></i>
    </div>

    <h3>
      Free Preview Available
    </h3>

    <p>
      Watch a preview and experience the quality
      of the course.
    </p>

    <button type="button"
            class="preview-btn">

      <i class="fas fa-play"></i>
      Watch Free Preview

    </button>

  </div>


  <!-- =====================================================
       APPROVED — COURSE PROGRESS
  ====================================================== -->

  <% if @enrollment.present? &&
        @enrollment.status == "Approved" %>

    <div class="sidebar-card">

      <div class="sidebar-card-title">

        <i class="fas fa-chart-line"></i>

        <h3>
          Course Progress
        </h3>

      </div>


      <div
        class="progress-circle"
        style="--progress: <%= @course_progress %>%;"
      >

        <div class="progress-circle-inner">

          <%= @course_progress %>%

        </div>

      </div>


      <div class="progress-label">

        <span>
          Continue Learning
        </span>

        <strong>
          <%= @course_progress %>%
        </strong>

      </div>


      <div class="progress-bar">

        <span
          style="width: <%= @course_progress %>%;"
        ></span>

      </div>


      <div class="progress-video-count">

        <i class="fas fa-play-circle"></i>

        <span>
          <%= @completed_videos %>
          of
          <%= @total_videos %>
          videos completed
        </span>

      </div>


      <%= link_to learning_course_path(@course),
            class: "sidebar-primary-btn" do %>

        <i class="fas fa-play"></i>

        Continue Learning

      <% end %>

    </div>

  <% end %>


  <!-- =====================================================
       PENDING — CONTINUE PAYMENT
  ====================================================== -->

  <% if @enrollment.present? &&
        @enrollment.status == "Pending" %>

    <div class="sidebar-card pending-payment-card">

      <div class="sidebar-card-title">

        <i class="fas fa-credit-card"></i>

        <h3>
          Complete Enrollment
        </h3>

      </div>


      <p class="pending-payment-text">

        Your enrollment has been created.
        Complete the payment to get access
        to this course.

      </p>


      <%= link_to payment_path(@enrollment),
            class: "sidebar-primary-btn" do %>

        <i class="fas fa-credit-card"></i>

        Continue Payment

      <% end %>

    </div>

  <% end %>


  <!-- =====================================================
       PRICE DETAILS
  ====================================================== -->

  <div class="sidebar-card price-card">

    <div class="sidebar-card-title">

      <i class="fas fa-tag"></i>

      <h3>
        Price Details
      </h3>

    </div>


    <% if @course.original_fee.present? &&
          @course.original_fee.to_f > @course.fee.to_f %>

      <div class="price-row">

        <span>
          Course Fee
        </span>

        <del>
          ₹<%= number_with_delimiter(@course.original_fee.to_i) %>
        </del>

      </div>

    <% end %>


    <div class="price-row final">

      <span>
        Final Price
      </span>

      <strong>

        <% if @course.respond_to?(:free?) &&
              @course.free? %>

          Free

        <% elsif @course.fee.to_f <= 0 %>

          Free

        <% else %>

          ₹<%= number_with_delimiter(@course.fee.to_i) %>

        <% end %>

      </strong>

    </div>


    <!-- ===================================================
         NO ENROLLMENT
    ==================================================== -->

    <% if @enrollment.blank? %>

      <% if @course.respond_to?(:free?) &&
            @course.free? %>

        <%= button_to enroll_free_course_path(@course),
              method: :post,
              class: "sidebar-primary-btn" do %>

          <i class="fas fa-graduation-cap"></i>

          Enroll for Free

        <% end %>


      <% elsif @course.fee.to_f <= 0 %>

        <%= button_to enroll_free_course_path(@course),
              method: :post,
              class: "sidebar-primary-btn" do %>

          <i class="fas fa-graduation-cap"></i>

          Enroll for Free

        <% end %>


      <% else %>

        <%= button_to enrollments_path,
              method: :post,
              params: {
                enrollment: {
                  course_id: @course.id
                }
              },
              class: "sidebar-primary-btn" do %>

          <i class="fas fa-shopping-cart"></i>

          Enroll Now

        <% end %>

      <% end %>


    <!-- ===================================================
         PENDING
    ==================================================== -->

    <% elsif @enrollment.status == "Pending" %>

      <%= link_to payment_path(@enrollment),
            class: "sidebar-primary-btn" do %>

        <i class="fas fa-credit-card"></i>

        Continue Payment

      <% end %>


    <!-- ===================================================
         APPROVED
    ==================================================== -->

    <% elsif @enrollment.status == "Approved" %>

      <%= link_to learning_course_path(@course),
            class: "sidebar-primary-btn" do %>

        <i class="fas fa-play"></i>

        Continue Learning

      <% end %>

    <% end %>

  </div>


  <!-- =====================================================
       QUICK INFORMATION
  ====================================================== -->

  <div class="sidebar-card quick-info-card">

    <div class="sidebar-card-title">

      <i class="fas fa-info-circle"></i>

      <h3>
        Course Information
      </h3>

    </div>


    <div class="quick-info-row">

      <span>
        <i class="fas fa-user-tie"></i>
        Instructor
      </span>

      <strong>
        <%= @course.teacher&.name || "Assigned Instructor" %>
      </strong>

    </div>


    <div class="quick-info-row">

      <span>
        <i class="fas fa-play-circle"></i>
        Videos
      </span>

      <strong>
        Available in Learning Portal
      </strong>

    </div>


    <div class="quick-info-row">

      <span>
        <i class="fas fa-question-circle"></i>
        Quizzes
      </span>

      <strong>
        Included
      </strong>

    </div>

  </div>


  <!-- =====================================================
       CTA
  ====================================================== -->

  <div class="sidebar-cta">

    <i class="fas fa-graduation-cap"></i>

    <h3>
      Learn Today,
      Build a Better Tomorrow!
    </h3>

    <p>
      Join A-One GS Center and take the next
      step towards your success.
    </p>

  </div>

</aside>
  </div>

</main>


<style>
  /* =========================================================
   STUDENT COURSE DETAILS
========================================================= */

.student-course-details {
  min-height: 100vh;
  background: #f5f8fc;
  color: #172b4d;
  padding: 25px 32px 60px;
  transition: background .3s ease, color .3s ease;
  padding-top: 100px;
}


/* =========================================================
   BREADCRUMB
========================================================= */

.course-breadcrumb {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
  font-size: 13px;
  color: #718096;
}

.course-breadcrumb a {
  color: #4c6fff;
  text-decoration: none;
}

.course-breadcrumb i {
  font-size: 9px;
  color: #a0aec0;
}


/* =========================================================
   HERO
========================================================= */

.course-hero {
  display: grid;
  grid-template-columns: 310px 1fr;
  gap: 28px;
  background: #fff;
  border: 1px solid #e5eaf1;
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 8px 30px rgba(20, 40, 80, .06);
}

.course-hero-image {
  height: 205px;
  border-radius: 12px;
  overflow: hidden;
  background: #e8eef7;
}

.course-hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.course-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60px;
  color: #7557d9;
  background: linear-gradient(135deg, #ede9fe, #ddd6fe);
}

.course-hero-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.course-label {
  color: #6d4aff;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .8px;
  margin-bottom: 6px;
}

.course-label i {
  margin-right: 5px;
}

.course-hero h1 {
  margin: 0;
  font-size: 34px;
  line-height: 1.15;
  font-weight: 800;
  color: #12243f;
}

