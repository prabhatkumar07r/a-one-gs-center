<!-- ===========================================================
     JAVASCRIPT
=========================================================== -->

<script>

document.addEventListener("DOMContentLoaded", function () {


  /* =========================================================
     COURSE TABS
  ========================================================= */

  const tabButtons =
    document.querySelectorAll(".course-tab-btn");

  const tabPanes =
    document.querySelectorAll(".course-tab-pane");


  tabButtons.forEach(function (button) {

    button.addEventListener("click", function () {

      const targetId =
        button.dataset.courseTab;


      tabButtons.forEach(function (item) {

        item.classList.remove("active");

      });


      tabPanes.forEach(function (pane) {

        pane.classList.remove("active");

      });


      button.classList.add("active");


      const targetPane =
        document.getElementById(targetId);


      if (targetPane) {

        targetPane.classList.add("active");

      }

    });

  });


  /* =========================================================
     PLAYLIST DROPDOWNS
  ========================================================= */

  const playlistButtons =
    document.querySelectorAll(
      ".course-playlist-header"
    );


  playlistButtons.forEach(function (button) {

    button.addEventListener("click", function () {

      const playlist =
        button.closest(".course-playlist");


      if (!playlist) {

        return;

      }


      const isOpen =
        playlist.classList.toggle("open");


      button.setAttribute(
        "aria-expanded",
        isOpen ? "true" : "false"
      );

    });

  });


  /* =========================================================
     PAYMENT BUTTON LOADING
  ========================================================= */

  const paymentButtons =
    document.querySelectorAll(
      ".pay-btn, .free-btn, .login-btn"
    );


  paymentButtons.forEach(function (button) {

    button.addEventListener("click", function () {

      if (
        button.dataset.clicked === "true"
      ) {

        return;

      }


      button.dataset.clicked = "true";


      const originalHTML =
        button.innerHTML;


      button.innerHTML =
        '<i class="fas fa-spinner fa-spin"></i> Please wait...';


      setTimeout(function () {

        if (
          document.body.contains(button)
        ) {

          button.innerHTML =
            originalHTML;

          button.dataset.clicked =
            "false";

        }

      }, 5000);

    });

  });


  /* =========================================================
     BACK BUTTON
  ========================================================= */

  const backBtn =
    document.getElementById("courseBackBtn");


  if (backBtn) {

    backBtn.addEventListener(
      "click",
      function () {

        /*
         * Normal Rails link behavior.
         */

      }
    );

  }

});

</script>