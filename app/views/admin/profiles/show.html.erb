<style>
  /* =========================================================
     ADMIN PROFILE PAGE
  ========================================================= */

  .admin-profile-page {
    padding: 10px 5px 30px;
  }

  /* ================= PAGE HEADER ================= */

  .admin-profile-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 25px;
  }

  .admin-profile-title {
    font-size: 28px;
    font-weight: 700;
    color: #172033;
    margin: 0 0 5px;
  }

  .admin-profile-subtitle {
    color: #8b95a5;
    font-size: 14px;
    margin: 0;
  }

  .admin-edit-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 10px;
    font-weight: 600;
    white-space: nowrap;
  }

  /* ================= MAIN CARD ================= */

  .admin-profile-card {
    border: 0;
    border-radius: 18px;
    overflow: hidden;
    background: #ffffff;
  }

  .admin-profile-card .card-body {
    padding: 35px;
  }

  /* ================= PROFILE LEFT ================= */

  .admin-profile-left {
    text-align: center;
    border-right: 1px solid #edf0f4;
    padding-right: 30px;
  }

  .admin-profile-avatar-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 18px;
  }

  .admin-profile-image,
  .admin-profile-placeholder {
    width: 155px;
    height: 155px;
    border-radius: 50%;
  }

  .admin-profile-image {
    object-fit: cover;
    border: 5px solid #f1f3f5;
    box-shadow: 0 8px 25px rgba(0, 0, 0, .10);
  }

  .admin-profile-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;

    background: #2563eb;
    color: #ffffff;

    font-size: 55px;

    box-shadow: 0 8px 25px rgba(37, 99, 235, .20);
  }

  .admin-profile-name {
    font-size: 22px;
    font-weight: 700;
    color: #172033;
    margin-bottom: 7px;
  }

  .admin-profile-role {
    display: inline-flex;
    align-items: center;
    gap: 6px;

    padding: 6px 12px;
    border-radius: 20px;

    font-size: 12px;
    font-weight: 600;

    background: #fee2e2;
    color: #dc2626;
  }
   
    /*========edit profile=====*/
    .back-btn{
    display:inline-flex;
    align-items:center;
    gap:5px;
    padding:6px 10px;   /* Small horizontal padding */
    width:auto;         /* Only as wide as its content */
    white-space:nowrap;
    font-size:14px;
    font-weight:500;
    border-radius:10px;
}

.back-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 4px 12px rgba(0,0,0,.12);
}

.back-btn i{
    font-size:15px;

  }  

  /* ================= PROFILE RIGHT ================= */

  .admin-profile-info {
    padding-left: 30px;
  }

  .admin-profile-info-title {
    font-size: 20px;
    font-weight: 700;
    color: #172033;
    margin-bottom: 25px;
  }

  /* ================= INFO BOX ================= */

  .profile-info-box {
    height: 100%;
    padding: 17px 18px;

    border: 1px solid #edf0f4;
    border-radius: 12px;

    background: #fafbfc;

    transition: all .2s ease;
  }

  .profile-info-box:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 18px rgba(0, 0, 0, .06);
  }

  .profile-label {
    display: flex;
    align-items: center;
    gap: 8px;

    color: #8b95a5;
    font-size: 12px;
    font-weight: 600;

    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: .3px;
  }

  .profile-label i {
    color: #2563eb;
  }

  .profile-value {
    color: #172033;
    font-size: 15px;
    font-weight: 600;

    word-break: break-word;
  }

  /* ================= STATUS ================= */

  .account-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 6px 11px;

    border-radius: 20px;

    background: #dcfce7;
    color: #16a34a;

    font-size: 12px;
    font-weight: 700;
  }

  .account-status-dot {
    width: 7px;
    height: 7px;

    border-radius: 50%;
    background: #22c55e;
  }

  /* ================= MOBILE ================= */

  @media (max-width: 767px) {

    .admin-profile-page {
      padding: 5px 0 25px;
    }

    .admin-profile-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .admin-profile-title {
      font-size: 24px;
    }

    .admin-edit-btn {
      width: 100%;
      justify-content: center;
    }

    .admin-profile-card .card-body {
      padding: 25px 18px;
    }

    .admin-profile-left {
      border-right: 0;
      border-bottom: 1px solid #edf0f4;

      padding-right: 0;
      padding-bottom: 25px;
      margin-bottom: 25px;
    }

    .admin-profile-info {
      padding-left: 0;
    }

    .admin-profile-info-title {
      font-size: 18px;
    }
  }
</style>


<div class="container-fluid admin-profile-page">

  <!-- =====================================================
       PAGE HEADER
  ====================================================== -->

  <div class="admin-profile-header">

    <div>
      <h2 class="admin-profile-title">
        My Profile
      </h2>

      <p class="admin-profile-subtitle">
        Manage your administrator profile and account information
      </p>
    </div>

    <%= link_to edit_admin_profile_path,
    class: "btn btn-outline-secondary back-btn" do %>
  <i class="bi bi-pencil"></i>
  Edit Profile
<% end %>

  </div>


  <!-- =====================================================
       PROFILE CARD
  ====================================================== -->

  <div class="card shadow-sm admin-profile-card">

    <div class="card-body">

      <div class="row align-items-center">

        <!-- =================================================
             PROFILE AVATAR
        ================================================== -->

        <div class="col-md-3">

          <div class="admin-profile-left">

            <div class="admin-profile-avatar-wrapper">

              <% if @admin.image.attached? %>

                <%= image_tag @admin.image,
                    class: "admin-profile-image",
                    alt: "Administrator profile image" %>

              <% else %>

                <div class="admin-profile-placeholder">
                  <i class="fas fa-user"></i>
                </div>

              <% end %>

            </div>


            <!-- Name -->

            <div class="admin-profile-name">

              <%= @admin.name.presence || "Administrator" %>

            </div>


            <!-- Role -->

            <span class="admin-profile-role">

              <i class="fas fa-user-shield"></i>

              Administrator

            </span>

          </div>

        </div>


        <!-- =================================================
             PROFILE INFORMATION
        ================================================== -->

        <div class="col-md-9">

          <div class="admin-profile-info">

            <h4 class="admin-profile-info-title">
              Account Information
            </h4>


            <div class="row g-3">


              <!-- ================= EMAIL ================= -->

              <div class="col-md-6">

                <div class="profile-info-box">

                  <div class="profile-label">

                    <i class="fas fa-envelope"></i>

                    Email

                  </div>

                  <div class="profile-value">

                    <%= @admin.email %>

                  </div>

                </div>

              </div>


              <!-- ================= MOBILE ================= -->

              <div class="col-md-6">

                <div class="profile-info-box">

                  <div class="profile-label">

                    <i class="fas fa-phone"></i>

                    Mobile

                  </div>

                  <div class="profile-value">

                    <%= @admin.mobile.presence || "Not provided" %>

                  </div>

                </div>

              </div>


              <!-- ================= ROLE ================= -->

              <div class="col-md-6">

                <div class="profile-info-box">

                  <div class="profile-label">

                    <i class="fas fa-user-shield"></i>

                    Role

                  </div>

                  <div class="profile-value">

                    Administrator

                  </div>

                </div>

              </div>


              <!-- ================= MEMBER SINCE ================= -->

              <div class="col-md-6">

                <div class="profile-info-box">

                  <div class="profile-label">

                    <i class="fas fa-calendar-alt"></i>

                    Member Since

                  </div>

                  <div class="profile-value">

                    <%= @admin.created_at.strftime("%d %b %Y") %>

                  </div>

                </div>

              </div>


              <!-- ================= ACCOUNT STATUS ================= -->

              <div class="col-md-6">

                <div class="profile-info-box">

                  <div class="profile-label">

                    <i class="fas fa-circle-check"></i>

                    Account Status

                  </div>

                  <div class="profile-value">

                    <span class="account-status">

                      <span class="account-status-dot"></span>

                      Active

                    </span>

                  </div>

                </div>

              </div>


              <!-- ================= LAST UPDATED ================= -->

              <div class="col-md-6">

                <div class="profile-info-box">

                  <div class="profile-label">

                    <i class="fas fa-clock"></i>

                    Last Updated

                  </div>

                  <div class="profile-value">

                    <%= @admin.updated_at.strftime("%d %b %Y, %I:%M %p") %>

                  </div>

                </div>

              </div>


            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>