<div class="container-fluid">

  <!-- PAGE HEADER -->

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h2 class="fw-bold mb-1">
        <i class="bi bi-camera-video"></i>
        Live Classes
      </h2>

      <p class="text-muted mb-0">
        Manage your upcoming, live and recorded classes.
      </p>
    </div>

    <%= link_to new_admin_live_class_path,
        class: "btn btn-primary" do %>

      <i class="bi bi-plus-circle"></i>
      Add Live Class

    <% end %>

  </div>


  <!-- STATISTICS -->

  <div class="row mb-4">

    <div class="col-md-3 mb-3">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="text-muted small">Total Classes</div>
          <h3 class="fw-bold mb-0">
            <%= @total_live_classes %>
          </h3>
        </div>
      </div>
    </div>


    <div class="col-md-3 mb-3">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="text-muted small">Upcoming</div>
          <h3 class="fw-bold mb-0 text-primary">
            <%= @upcoming_live_classes %>
          </h3>
        </div>
      </div>
    </div>


    <div class="col-md-3 mb-3">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="text-muted small">Live Now</div>
          <h3 class="fw-bold mb-0 text-danger">
            <%= @currently_live_classes %>
          </h3>
        </div>
      </div>
    </div>


    <div class="col-md-3 mb-3">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="text-muted small">Ended</div>
          <h3 class="fw-bold mb-0 text-secondary">
            <%= @ended_live_classes %>
          </h3>
        </div>
      </div>
    </div>

  </div>


  <!-- FILTERS -->

  <div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

      <%= form_with url: admin_live_classes_path,
          method: :get,
          local: true do |f| %>

        <div class="row g-3 align-items-end">

          <div class="col-md-4">

            <%= f.label :search,
                "Search",
                class: "form-label" %>

            <%= f.text_field :search,
                value: params[:search],
                class: "form-control",
                placeholder: "Search live class title..." %>

          </div>


          <div class="col-md-3">

            <%= f.label :status,
                "Status",
                class: "form-label" %>

            <%= f.select :status,
                [
                  ["All Status", ""],
                  ["Upcoming", "upcoming"],
                  ["Live Now", "live"],
                  ["Ended", "ended"]
                ],
                { selected: params[:status] },
                class: "form-select" %>

          </div>


          <div class="col-md-3">

            <%= f.label :access_type,
                "Access",
                class: "form-label" %>

            <%= f.select :access_type,
                [
                  ["All Access", ""],
                  ["Free", "free"],
                  ["Enrolled Only", "enrolled"]
                ],
                { selected: params[:access_type] },
                class: "form-select" %>

          </div>


          <div class="col-md-2 d-flex gap-2">

            <%= f.submit "Filter",
                class: "btn btn-primary w-100" %>

            <%= link_to "Reset",
                admin_live_classes_path,
                class: "btn btn-outline-secondary" %>

          </div>

        </div>

      <% end %>

    </div>

  </div>


  <!-- LIVE CLASSES TABLE -->

  <div class="card shadow-sm border-0">

    <div class="card-body p-0">

      <% if @live_classes.any? %>

        <div class="table-responsive">

          <table class="table table-hover align-middle mb-0">

            <thead class="table-light">

              <tr>
                <th class="ps-3">Title</th>
                <th>Course</th>
                <th>Schedule</th>
                <th>Access</th>
                <th>Status</th>
                <th class="text-end pe-3">Actions</th>
              </tr>

            </thead>

            <tbody>

              <% @live_classes.each do |live_class| %>

                <tr>

                  <td class="ps-3">

                    <div class="fw-semibold">
                      <%= live_class.title %>
                    </div>

                   <% if live_class.recording_url.present? %>

  <br>

  <small class="text-success">
    <i class="bi bi-play-circle"></i>
    Recording available
  </small>

<% end %>

                  </td>


                  <td>

                    <%= live_class.course.Course_name %>

                  </td>


                  <td>

                    <% if live_class.scheduled_at.present? %>

                      <%= live_class.scheduled_at.strftime("%d %b %Y") %>

                      <br>

                      <small class="text-muted">
                        <%= live_class.scheduled_at.strftime("%I:%M %p") %>
                      </small>

                    <% else %>

                      <span class="text-muted">Not scheduled</span>

                    <% end %>

                  </td>


                  <td>

                    <% if live_class.free? %>

                      <span class="badge bg-success">
                        Free
                      </span>

                    <% else %>

                      <span class="badge bg-primary">
                        Enrolled Only
                      </span>

                    <% end %>

                  </td>


                   <td>

  <% if live_class.upcoming? %>

    <span class="badge bg-warning text-dark">
      UPCOMING
    </span>

  <% elsif live_class.live? %>

    <span class="badge bg-danger">
      🔴 LIVE NOW
    </span>

  <% elsif live_class.ended? %>

    <span class="badge bg-secondary">
      ENDED
    </span>

  <% end %>

</td>


                  <td class="text-end pe-3">

                    <div class="btn-group">

                      <%= link_to admin_live_class_path(live_class),
                          class: "btn btn-sm btn-outline-primary" do %>

                        <i class="bi bi-eye"></i>

                      <% end %>


                      <%= link_to edit_admin_live_class_path(live_class),
                          class: "btn btn-sm btn-outline-secondary" do %>

                        <i class="bi bi-pencil"></i>

                      <% end %>


                      <%= button_to admin_live_class_path(live_class),
    method: :delete,
    data: {
      turbo_confirm: live_class.live? ?
        "This class is currently LIVE. Are you sure you want to delete it?" :
        "Are you sure you want to delete this live class?"
    },
    class: "btn btn-sm btn-outline-danger" do %>

  <i class="bi bi-trash"></i>

<% end %>

                    </div>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      <% else %>

        <div class="text-center py-5">

          <i class="bi bi-camera-video fs-1 text-muted"></i>

          <h5 class="mt-3">
            No Live Classes Found
          </h5>

          <p class="text-muted">
            Create your first live class to get started.
          </p>

          <%= link_to "Add Live Class",
              new_admin_live_class_path,
              class: "btn btn-primary" %>

        </div>

      <% end %>

    </div>

  </div>

</div>