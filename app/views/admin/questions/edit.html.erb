<div class="admin-question-edit">

  <!-- =========================================================
       HEADER
  ========================================================== -->

  <div class="question-header">

    <div>

      <div class="breadcrumb">

        <span>Admin Panel</span>
        <i class="fas fa-chevron-right"></i>

        <span>Courses</span>
        <i class="fas fa-chevron-right"></i>

        <span>Quizzes</span>
        <i class="fas fa-chevron-right"></i>

        <span>Edit Question</span>

      </div>


      <h1>

        <i class="fas fa-pen-to-square"></i>

        Edit Question

      </h1>


      <p>

        Update the question, marks and answer options.

      </p>

    </div>


    <div class="header-buttons">

      <%= link_to admin_course_quiz_question_path(
                    @course,
                    @quiz,
                    @question
                  ),
                  class: "glass-btn secondary" do %>

        <i class="fas fa-arrow-left"></i>

        Back to Question

      <% end %>

    </div>

  </div>


  <!-- =========================================================
       QUIZ INFORMATION
  ========================================================== -->

  <div class="info-grid">

    <div class="info-card">

      <div class="info-icon purple">

        <i class="fas fa-book-open"></i>

      </div>

      <div>

        <span>Course</span>

        <strong>

          <%= @course.Course_name %>

        </strong>

      </div>

    </div>


    <div class="info-card">

      <div class="info-icon blue">

        <i class="fas fa-clipboard-question"></i>

      </div>

      <div>

        <span>Quiz</span>

        <strong>

          <%= @quiz.title %>

        </strong>

      </div>

    </div>


    <div class="info-card">

      <div class="info-icon orange">

        <i class="fas fa-star"></i>

      </div>

      <div>

        <span>Current Marks</span>

        <strong>

          <%= @question.marks %>

        </strong>

      </div>

    </div>


    <div class="info-card">

      <div class="info-icon green">

        <i class="fas fa-list-ol"></i>

      </div>

      <div>

        <span>Position</span>

        <strong>

          Question <%= @question.position %>

        </strong>

      </div>

    </div>

  </div>


  <!-- =========================================================
       FORM
  ========================================================== -->

  <%= form_with model: [
                    @course,
                    @quiz,
                    @question
                  ],
                  url: admin_course_quiz_question_path(
                    @course,
                    @quiz,
                    @question
                  ),
                  method: :patch,
                  local: true,
                  id: "editQuestionForm" do |form| %>


    <!-- =======================================================
         VALIDATION ERRORS
    ======================================================== -->

    <% if @question.errors.any? %>

      <div class="error-card">

        <div class="error-icon">

          <i class="fas fa-circle-exclamation"></i>

        </div>

        <div>

          <h3>

            Please fix the following errors

          </h3>

          <ul>

            <% @question.errors.full_messages.each do |message| %>

              <li>

                <%= message %>

              </li>

            <% end %>

          </ul>

        </div>

      </div>

    <% end %>


    <!-- =======================================================
         QUESTION DETAILS
    ======================================================== -->

    <div class="edit-card">

      <div class="card-heading">

        <div class="heading-icon">

          <i class="fas fa-pen"></i>

        </div>

        <div>

          <h2>

            Question Details

          </h2>

          <span>

            Edit the main question information.

          </span>

        </div>

      </div>


      <div class="card-body">


        <!-- QUESTION TEXT -->

        <div class="form-group">

          <%= form.label :question_text,
                         "Question",
                         class: "form-label" %>

          <%= form.text_area :question_text,
                             rows: 5,
                             class: "form-control question-input",
                             placeholder:
                             "Enter the question..." %>

        </div>


        <div class="form-row">


          <!-- MARKS -->

          <div class="form-group">

            <%= form.label :marks,
                           "Marks",
                           class: "form-label" %>

            <%= form.number_field :marks,
                                  min: 0.5,
                                  step: 0.5,
                                  class: "form-control",
                                  placeholder: "Example: 1" %>

          </div>


          <!-- POSITION -->

          <div class="form-group">

            <%= form.label :position,
                           "Question Position",
                           class: "form-label" %>

            <%= form.number_field :position,
                                  min: 1,
                                  step: 1,
                                  class: "form-control" %>

          </div>

        </div>

      </div>

    </div>


    <!-- =======================================================
         OPTIONS
    ======================================================== -->

    <div class="edit-card">

      <div class="card-heading options-heading">

        <div class="heading-icon green-icon">

          <i class="fas fa-list-check"></i>

        </div>

        <div>

          <h2>

            Answer Options

          </h2>

          <span>

            Select exactly one correct answer.

          </span>

        </div>


        <div class="options-badge">

          <%= @question.options.count %>

          Options

        </div>

      </div>


      <div class="card-body">


        <div class="correct-info">

          <i class="fas fa-circle-info"></i>

          <span>

            Choose one option as the correct answer.

            The selected option will be saved as
            <strong>is_correct = true</strong>.

          </span>

        </div>


        <!-- ===================================================
             EXISTING OPTIONS
        ==================================================== -->

        <%= form.fields_for :options do |option_form| %>

          <% index = option_form.index %>

          <div class="option-box
                      <%= "correct-selected" if option_form.object.is_correct? %>"
               data-option-index="<%= index %>">


            <div class="option-letter">

              <%= ('A'.ord + index).chr %>

            </div>


            <div class="option-content">

              <%= option_form.label :option_text,
                                    "Option #{('A'.ord + index).chr}",
                                    class: "form-label" %>

              <%= option_form.text_field :option_text,
                                         class: "form-control option-input",
                                         placeholder:
                                         "Enter option #{('A'.ord + index).chr}" %>


              <!-- Keep database ID -->

              <%= option_form.hidden_field :id %>


              <!-- Keep position -->

              <%= option_form.hidden_field :position,
                                           value: index + 1 %>

            </div>


            <div class="correct-area">

              <%= option_form.radio_button :is_correct,
                                           true,
                                           class:
                                           "correct-option",
                                           name: "correct_option",
                                           value: index,
                                           checked:
                                           option_form.object.is_correct? %>


              <label>

                <span class="radio-custom"></span>

                <span>

                  Correct Answer

                </span>

              </label>


              <!-- Actual submitted value -->

              <%= option_form.hidden_field :is_correct,
                                            value:
                                            option_form.object.is_correct?,
                                            class:
                                            "correct-hidden" %>

            </div>

          </div>

        <% end %>


      </div>

    </div>


    <!-- =======================================================
         ACTION BUTTONS
    ======================================================== -->

    <div class="bottom-actions">

      <%= link_to admin_course_quiz_question_path(
                    @course,
                    @quiz,
                    @question
                  ),
                  class: "bottom-btn secondary" do %>

        <i class="fas fa-xmark"></i>

        Cancel

      <% end %>


      <%= form.submit "Update Question",
                      class: "bottom-btn save",
                      id: "updateQuestionBtn" do %>

        <i class="fas fa-save"></i>

        Update Question

      <% end %>

    </div>


  <% end %>

</div>


<!-- =========================================================
     JAVASCRIPT
========================================================== -->

<script>

document.addEventListener("DOMContentLoaded", function () {

  const form =
    document.getElementById("editQuestionForm");

  const radios =
    document.querySelectorAll(".correct-option");

  const hiddenFields =
    document.querySelectorAll(".correct-hidden");

  const optionBoxes =
    document.querySelectorAll(".option-box");


  /*
   * ==========================================================
   * INITIAL CORRECT ANSWER
   * ==========================================================
   */

  function setCorrectOption(selectedIndex) {

    hiddenFields.forEach(function (hidden) {

      hidden.value = "false";

    });


    optionBoxes.forEach(function (box) {

      box.classList.remove(
        "correct-selected"
      );

    });


    const selectedBox =
      document.querySelector(
        '.option-box[data-option-index="' +
        selectedIndex +
        '"]'
      );


    if (selectedBox) {

      selectedBox.classList.add(
        "correct-selected"
      );


      const hidden =
        selectedBox.querySelector(
          ".correct-hidden"
        );


      if (hidden) {

        hidden.value = "true";

      }

    }

  }


  /*
   * ==========================================================
   * RADIO CHANGE
   * ==========================================================
   */

  radios.forEach(function (radio) {

    radio.addEventListener(
      "change",
      function () {

        setCorrectOption(
          radio.value
        );

      }
    );

  });


  /*
   * ==========================================================
   * FORM VALIDATION
   * ==========================================================
   */

  if (form) {

    form.addEventListener(
      "submit",
      function (event) {

        const selected =
          document.querySelector(
            ".correct-option:checked"
          );


        if (!selected) {

          event.preventDefault();


          alert(
            "Please select exactly one correct answer."
          );


          return false;

        }


        /*
         * Make absolutely sure only the
         * selected option is true.
         */

        hiddenFields.forEach(
          function (hidden) {

            hidden.value = "false";

          }
        );


        const selectedBox =
          selected.closest(
            ".option-box"
          );


        if (selectedBox) {

          const selectedHidden =
            selectedBox.querySelector(
              ".correct-hidden"
            );


          if (selectedHidden) {

            selectedHidden.value =
              "true";

          }

        }

      }
    );

  }

});

</script>


<!-- =========================================================
     DESIGN
========================================================== -->

<style>

/* =========================================================
   PAGE
========================================================= */

.admin-question-edit {

  min-height: 100vh;

  padding: 30px;

  background:
    linear-gradient(
      135deg,
      rgba(63,82,251,.06),
      rgba(124,58,237,.045),
      rgba(255,255,255,.84)
    );

}


/* =========================================================
   HEADER
========================================================= */

.question-header {

  display: flex;

  justify-content: space-between;

  align-items: flex-start;

  gap: 20px;

  margin-bottom: 25px;

}


.breadcrumb {

  display: flex;

  align-items: center;

  gap: 8px;

  color: #858b9a;

  font-size: 12px;

  margin-bottom: 10px;

}


.breadcrumb i {

  font-size: 9px;

  color: #b8bdc8;

}


.question-header h1 {

  margin: 0;

  color: #292e3d;

  font-size: 30px;

  font-weight: 800;

}


.question-header h1 i {

  color: #3f52fb;

  margin-right: 8px;

}


.question-header p {

  margin: 6px 0 0;

  color: #858b9a;

}


/* =========================================================
   HEADER BUTTON
========================================================= */

.header-buttons {

  display: flex;

  gap: 10px;

}


.glass-btn {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  padding: 11px 17px;

  border-radius: 12px;

  text-decoration: none;

  font-size: 13px;

  font-weight: 650;

  transition: .2s ease;

}


.glass-btn.secondary {

  color: #555b6b;

  background:
    rgba(255,255,255,.66);

  border:
    1px solid rgba(90,100,120,.13);

  backdrop-filter:
    blur(12px);

}


.glass-btn.secondary:hover {

  color: #3f52fb;

  background:
    rgba(255,255,255,.9);

  transform:
    translateY(-1px);

}


/* =========================================================
   INFO GRID
========================================================= */

.info-grid {

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 14px;

  margin-bottom: 22px;

}


.info-card {

  display: flex;

  align-items: center;

  gap: 13px;

  padding: 16px;

  border-radius: 17px;

  background:
    rgba(255,255,255,.63);

  border:
    1px solid rgba(255,255,255,.85);

  backdrop-filter:
    blur(14px);

  box-shadow:
    0 7px 25px rgba(40,50,80,.055);

}


.info-icon {

  width: 44px;

  height: 44px;

  min-width: 44px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 12px;

}


.info-icon.purple {

  color: #7c3aed;

  background:
    rgba(124,58,237,.10);

}


.info-icon.blue {

  color: #3f52fb;

  background:
    rgba(63,82,251,.10);

}


.info-icon.orange {

  color: #f59e0b;

  background:
    rgba(245,158,11,.11);

}


.info-icon.green {

  color: #198754;

  background:
    rgba(25,135,84,.10);

}


.info-card span {

  display: block;

  color: #8a909d;

  font-size: 10px;

  margin-bottom: 3px;

}


.info-card strong {

  display: block;

  color: #303545;

  font-size: 13px;

  word-break: break-word;

}


/* =========================================================
   EDIT CARD
========================================================= */

.edit-card {

  margin-bottom: 20px;

  border-radius: 20px;

  background:
    rgba(255,255,255,.66);

  border:
    1px solid rgba(255,255,255,.86);

  backdrop-filter:
    blur(15px);

  -webkit-backdrop-filter:
    blur(15px);

  box-shadow:
    0 9px 30px rgba(40,50,80,.065);

  overflow: hidden;

}


.card-heading {

  display: flex;

  align-items: center;

  gap: 12px;

  padding: 20px 23px;

  border-bottom:
    1px solid rgba(90,100,120,.08);

}


.heading-icon {

  width: 40px;

  height: 40px;

  min-width: 40px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 11px;

  color: #3f52fb;

  background:
    rgba(63,82,251,.10);

}


.green-icon {

  color: #198754;

  background:
    rgba(25,135,84,.10);

}


.card-heading h2 {

  margin: 0;

  color: #292e3d;

  font-size: 18px;

  font-weight: 750;

}


.card-heading span {

  display: block;

  margin-top: 3px;

  color: #888e9c;

  font-size: 11px;

}


.card-body {

  padding: 24px;

}


/* =========================================================
   FORM
========================================================= */

.form-group {

  margin-bottom: 20px;

}


.form-row {

  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 18px;

}


.form-label {

  display: block;

  margin-bottom: 8px;

  color: #363b4a;

  font-size: 13px;

  font-weight: 700;

}


.form-control {

  width: 100%;

  padding: 11px 13px;

  border:
    1px solid #dfe2e8;

  border-radius: 11px;

  background:
    rgba(255,255,255,.78);

  color: #303545;

  font-size: 14px;

  outline: none;

  transition: .2s ease;

}


.form-control:focus {

  border-color: #3f52fb;

  box-shadow:
    0 0 0 3px rgba(63,82,251,.10);

  background: #fff;

}


.question-input {

  min-height: 125px;

  resize: vertical;

  line-height: 1.55;

}


/* =========================================================
   OPTIONS HEADER
========================================================= */

.options-heading {

  justify-content: flex-start;

}


.options-badge {

  margin-left: auto;

  padding: 7px 12px;

  border-radius: 20px;

  color: #198754;

  background:
    rgba(25,135,84,.09);

  font-size: 11px;

  font-weight: 750;

}


/* =========================================================
   INFO
========================================================= */

.correct-info {

  display: flex;

  align-items: center;

  gap: 9px;

  padding: 12px 14px;

  margin-bottom: 17px;

  border-radius: 11px;

  color: #5f6675;

  background:
    rgba(63,82,251,.055);

  border:
    1px solid rgba(63,82,251,.09);

  font-size: 12px;

}


.correct-info i {

  color: #3f52fb;

}


/* =========================================================
   OPTION BOX
========================================================= */

.option-box {

  display: grid;

  grid-template-columns:
    44px 1fr 190px;

  align-items: center;

  gap: 15px;

  padding: 16px;

  margin-bottom: 12px;

  border:
    1px solid #e0e3e8;

  border-radius: 15px;

  background:
    rgba(249,250,252,.72);

  transition: .2s ease;

}


.option-box:last-child {

  margin-bottom: 0;

}


.option-box:hover {

  border-color:
    rgba(63,82,251,.35);

  box-shadow:
    0 6px 20px rgba(63,82,251,.07);

}


.option-box.correct-selected {

  border-color:
    rgba(25,135,84,.45);

  background:
    rgba(25,135,84,.055);

  box-shadow:
    0 5px 18px rgba(25,135,84,.07);

}


/* =========================================================
   OPTION LETTER
========================================================= */

.option-letter {

  width: 40px;

  height: 40px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 11px;

  color: #3f52fb;

  background:
    rgba(63,82,251,.10);

  font-size: 14px;

  font-weight: 800;

}


.correct-selected .option-letter {

  color: #198754;

  background:
    rgba(25,135,84,.13);

}


/* =========================================================
   OPTION CONTENT
========================================================= */

.option-content {

  min-width: 0;

}


.option-input {

  background:
    rgba(255,255,255,.82);

}


/* =========================================================
   CORRECT AREA
========================================================= */

.correct-area {

  display: flex;

  align-items: center;

  gap: 8px;

  min-height: 44px;

  padding: 8px 10px;

  border-radius: 10px;

}


.correct-area input {

  position: absolute;

  opacity: 0;

}


.correct-area label {

  display: flex;

  align-items: center;

  gap: 8px;

  cursor: pointer;

  color: #6f7583;

  font-size: 12px;

  font-weight: 650;

}


.radio-custom {

  width: 19px;

  height: 19px;

  display: inline-block;

  border:
    2px solid #b9bec8;

  border-radius: 50%;

  position: relative;

  transition: .2s ease;

}


.correct-option:checked + label .radio-custom {

  border-color: #198754;

}


.correct-option:checked + label .radio-custom::after {

  content: "";

  position: absolute;

  width: 9px;

  height: 9px;

  top: 3px;

  left: 3px;

  border-radius: 50%;

  background: #198754;

}


.correct-option:checked + label {

  color: #198754;

}


/* =========================================================
   ERROR
========================================================= */

.error-card {

  display: flex;

  gap: 13px;

  padding: 16px;

  margin-bottom: 20px;

  border-radius: 15px;

  color: #842029;

  background:
    rgba(220,53,69,.075);

  border:
    1px solid rgba(220,53,69,.18);

}


.error-icon {

  width: 38px;

  height: 38px;

  min-width: 38px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 10px;

  color: #dc3545;

  background:
    rgba(220,53,69,.10);

}


.error-card h3 {

  margin: 0 0 6px;

  font-size: 13px;

}


.error-card ul {

  margin: 0;

  padding-left: 18px;

  font-size: 12px;

}


/* =========================================================
   ACTIONS
========================================================= */

.bottom-actions {

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 15px;

  padding-bottom: 20px;

}


.bottom-btn {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  padding: 12px 20px;

  border-radius: 12px;

  text-decoration: none;

  border: 1px solid transparent;

  font-size: 13px;

  font-weight: 700;

  cursor: pointer;

  transition: .2s ease;

}


.bottom-btn.secondary {

  color: #5d6370;

  background:
    rgba(255,255,255,.68);

  border-color:
    rgba(90,100,120,.14);

}


.bottom-btn.save {

  color: white;

  background:
    linear-gradient(
      135deg,
      #198754,
      #20a464
    );

  box-shadow:
    0 8px 20px rgba(25,135,84,.18);

}


.bottom-btn:hover {

  transform:
    translateY(-2px);

}


.bottom-btn.save:hover {

  box-shadow:
    0 12px 25px rgba(25,135,84,.25);

}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1100px) {

  .info-grid {

    grid-template-columns:
      repeat(2, 1fr);

  }


  .option-box {

    grid-template-columns:
      44px 1fr;

  }


  .correct-area {

    grid-column: 2;

  }

}


@media (max-width: 700px) {

  .admin-question-edit {

    padding: 18px;

  }


  .question-header {

    flex-direction: column;

  }


  .header-buttons {

    width: 100%;

  }


  .glass-btn {

    width: 100%;

  }


  .info-grid {

    grid-template-columns: 1fr;

  }


  .form-row {

    grid-template-columns: 1fr;

    gap: 0;

  }


  .option-box {

    grid-template-columns:
      42px 1fr;

    padding: 13px;

  }


  .correct-area {

    grid-column: 1 / -1;

  }


  .bottom-actions {

    flex-direction: column-reverse;

    align-items: stretch;

  }


  .bottom-btn {

    width: 100%;

  }

}

</style>