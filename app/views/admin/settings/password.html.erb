<style>
  .password-page {
    padding: 10px 5px 30px;
  }

  .password-header {
    margin-bottom: 25px;
  }

  .password-title {
    color: #172033;
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 5px;
  }

  .password-subtitle {
    color: #8b95a5;
    font-size: 14px;
    margin: 0;
  }

  .password-card {
    max-width: 650px;
    border: 0;
    border-radius: 16px;
    background: #fff;
  }

  .password-card-body {
    padding: 30px;
  }

  .password-icon {
    width: 55px;
    height: 55px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 14px;

    background: #eef4ff;
    color: #2563eb;

    font-size: 21px;

    margin-bottom: 20px;
  }

  .password-section-title {
    color: #172033;
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .password-section-text {
    color: #8b95a5;
    font-size: 13px;
    margin-bottom: 25px;
  }

  .password-label {
    color: #343a40;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 7px;
  }

  .password-input {
    width: 100%;
    height: 45px;

    border: 1px solid #e1e5eb;
    border-radius: 9px;

    padding: 0 13px;

    font-size: 14px;

    outline: none;

    transition: .2s ease;
  }

  .password-input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, .10);
  }

  .password-field {
    margin-bottom: 20px;
  }

  .password-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;

    margin-top: 25px;
    padding-top: 20px;

    border-top: 1px solid #edf0f4;
  }

  .password-btn {
    border-radius: 9px;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .password-page {
      padding: 5px 0 25px;
    }

    .password-title {
      font-size: 24px;
    }

    .password-card-body {
      padding: 22px;
    }

    .password-actions {
      flex-direction: column;
    }

    .password-btn {
      width: 100%;
    }
  }
</style>


<div class="container-fluid password-page">

  <div class="password-header">

    <h2 class="password-title">
      Change Password
    </h2>

    <p class="password-subtitle">
      Update your administrator account password
    </p>

  </div>


  <div class="card shadow-sm password-card">

    <div class="password-card-body">

      <div class="password-icon">
        <i class="fas fa-lock"></i>
      </div>


      <h4 class="password-section-title">
        Update your password
      </h4>

      <p class="password-section-text">
        Choose a strong password that you don't use anywhere else.
      </p>


      <%= form_with model: @admin,
          url: admin_settings_password_path,
          method: :patch,
          local: true do |f| %>


        <!-- CURRENT PASSWORD -->

        <div class="password-field">

          <%= f.label :current_password,
              "Current Password",
              class: "password-label" %>

          <%= f.password_field :current_password,
              autocomplete: "current-password",
              class: "password-input",
              placeholder: "Enter current password" %>

        </div>


        <!-- NEW PASSWORD -->

        <div class="password-field">

          <%= f.label :password,
              "New Password",
              class: "password-label" %>

          <%= f.password_field :password,
              autocomplete: "new-password",
              class: "password-input",
              placeholder: "Enter new password" %>

        </div>


        <!-- CONFIRM PASSWORD -->

        <div class="password-field">

          <%= f.label :password_confirmation,
              "Confirm New Password",
              class: "password-label" %>

          <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              class: "password-input",
              placeholder: "Confirm new password" %>

        </div>


        <div class="password-actions">

          <%= link_to admin_settings_security_path,
              class: "btn btn-light password-btn" do %>

            Cancel

          <% end %>


          <%= f.submit "Update Password",
              class: "btn btn-primary password-btn" %>

        </div>


      <% end %>

    </div>

  </div>

</div>