<%= render "ebook_3d_style" %>

<div class="ebook-3d-page">

  <div class="ebook-study-background">
    <div class="study-object study-book">📚</div>
    <div class="study-object study-pencil">✏️</div>
    <div class="study-object study-graduation">🎓</div>
    <div class="study-object study-notes">📝</div>
  </div>


  <div class="ebook-3d-content">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="ebook-page-header">

      <div>

        <h1 class="ebook-page-title">
          📚 E-Book Details
        </h1>

        <p class="ebook-page-subtitle">
          Explore this study material.
        </p>

      </div>


      <%= link_to "← All E-Books",
          admin_ebooks_path,
          class: "ebook-3d-btn" %>

    </div>



    <!-- =====================================================
         E-BOOK DETAIL CARD
    ====================================================== -->

    <div class="ebook-detail-card">


      <!-- ===================================================
           COVER
      ==================================================== -->

      <div>

        <% if @ebook.cover_image.attached? %>

          <%= image_tag @ebook.cover_image,
              class: "ebook-detail-cover",
              alt: @ebook.title %>

        <% else %>

          <div class="ebook-detail-cover"
               style="display:flex;align-items:center;justify-content:center;font-size:100px;background:#ede9fe;">
            📖
          </div>

        <% end %>

      </div>



      <!-- ===================================================
           E-BOOK INFORMATION
      ==================================================== -->

      <div>

        <h2 class="ebook-detail-title">
          <%= @ebook.title %>
        </h2>


        <!-- AUTHOR -->

        <% if @ebook.author.present? %>

          <div class="ebook-card-author">
            ✍️ Written by
            <strong>
              <%= @ebook.author %>
            </strong>
          </div>

        <% end %>



        <!-- PRICE -->

        <div class="ebook-card-meta">

          <% if @ebook.free? %>

            <span class="ebook-price-badge">
              FREE E-BOOK
            </span>

          <% else %>

            <span class="ebook-price-badge paid">
              ₹<%= @ebook.price %>
            </span>

          <% end %>

        </div>



        <!-- DESCRIPTION -->

        <% if @ebook.description.present? %>

          <div class="ebook-detail-description">
            <%= simple_format @ebook.description %>
          </div>

        <% end %>



        <!-- =================================================
             INFORMATION GRID
        ================================================== -->

        <div class="ebook-info-grid">


          <div class="ebook-info-item">

            <span class="ebook-info-label">
              Category
            </span>

            <span class="ebook-info-value">
              <%= @ebook.category.presence || "—" %>
            </span>

          </div>



          <div class="ebook-info-item">

            <span class="ebook-info-label">
              Language
            </span>

            <span class="ebook-info-value">
              <%= @ebook.language.presence || "—" %>
            </span>

          </div>



          <div class="ebook-info-item">

            <span class="ebook-info-label">
              Exam
            </span>

            <span class="ebook-info-value">
              <%= @ebook.exam_name.presence || "—" %>
            </span>

          </div>



          <div class="ebook-info-item">

            <span class="ebook-info-label">
              Status
            </span>

            <span class="ebook-info-value">
              <%= @ebook.status.to_s.titleize %>
            </span>

          </div>


        </div>



        <!-- =====================================================
             STEP 7 — MULTI PDF MANAGEMENT
        ====================================================== -->

        <div class="ebook-pdf-section">


          <!-- SECTION HEADER -->

          <div class="ebook-pdf-section-header">

            <div>

              <h3 class="ebook-pdf-section-title">
                📚 E-Book PDF Files
              </h3>

              <p class="ebook-pdf-section-subtitle">
                Manage all PDF files included in this E-Book.
              </p>

            </div>


            <%= link_to "➕ Add PDF",
                new_admin_ebook_ebook_file_path(@ebook),
                class: "ebook-action add-pdf" %>

          </div>



          <!-- =================================================
               PDF LIST
          ================================================== -->

          <% if @ebook.ebook_files.any? %>

            <div class="ebook-pdf-list">


              <% @ebook.ebook_files.order(:position, :id).each do |ebook_file| %>


                <div class="ebook-pdf-item">


                  <!-- NUMBER -->

                  <div class="ebook-pdf-number">
                    <%= ebook_file.position %>
                  </div>



                  <!-- ICON -->

                  <div class="ebook-pdf-icon">
                    📄
                  </div>



                  <!-- INFORMATION -->

                  <div class="ebook-pdf-info">


                    <div class="ebook-pdf-title">
                      <%= ebook_file.title %>
                    </div>


                    <% if ebook_file.description.present? %>

                      <div class="ebook-pdf-description">

                        <%= truncate(
                              ebook_file.description,
                              length: 120
                            ) %>

                      </div>

                    <% end %>



                    <!-- STATUS -->

                    <div class="ebook-pdf-meta">


                      <span class="ebook-pdf-status <%= ebook_file.status %>">

                        <%= ebook_file.status.to_s.titleize %>

                      </span>



                      <% if ebook_file.pdf.attached? %>

                        <span class="ebook-pdf-attached">
                          PDF Attached
                        </span>

                      <% else %>

                        <span class="ebook-pdf-missing">
                          PDF Missing
                        </span>

                      <% end %>


                    </div>


                  </div>



                  <!-- =================================================
                       PDF ACTIONS
                  ================================================== -->

                  <div class="ebook-pdf-actions">


                    <% if ebook_file.pdf.attached? %>

                      <%= link_to "👁 Open",
                          rails_blob_path(
                            ebook_file.pdf,
                            disposition: "inline"
                          ),
                          target: "_blank",
                          rel: "noopener",
                          class: "ebook-pdf-btn view" %>

                    <% end %>



                    <%= link_to "✏️ Edit",
                        edit_admin_ebook_ebook_file_path(
                          @ebook,
                          ebook_file
                        ),
                        class: "ebook-pdf-btn edit" %>



                    <%= button_to "🗑 Delete",
                        admin_ebook_ebook_file_path(
                          @ebook,
                          ebook_file
                        ),
                        method: :delete,
                        class: "ebook-pdf-btn delete",
                        form: {
                          data: {
                            turbo_confirm: "Delete this PDF file?"
                          }
                        } %>


                  </div>


                </div>


              <% end %>


            </div>


          <!-- =================================================
               EMPTY STATE
          ================================================== -->

          <% else %>

            <div class="ebook-pdf-empty">


              <div class="ebook-pdf-empty-icon">
                📄
              </div>


              <h4>
                No PDF files added yet
              </h4>


              <p>
                Add the first PDF file to this E-Book.
              </p>


              <%= link_to "➕ Add First PDF",
                  new_admin_ebook_ebook_file_path(@ebook),
                  class: "ebook-action add-pdf" %>


            </div>

          <% end %>


        </div>



        <!-- =====================================================
             EXISTING E-BOOK ACTIONS
             LEGACY PDF SUPPORT KEPT
        ====================================================== -->

        <div class="ebook-card-actions">


          <!-- EDIT E-BOOK -->

          <%= link_to "✏️ Edit",
              edit_admin_ebook_path(@ebook),
              class: "ebook-action edit" %>



          <!-- LEGACY PDF -->

          <% if @ebook.pdf_file.attached? %>

            <%= link_to "📄 Open PDF",
                rails_blob_path(
                  @ebook.pdf_file,
                  disposition: "inline"
                ),
                target: "_blank",
                rel: "noopener",
                class: "ebook-action view" %>

          <% end %>



          <!-- DELETE E-BOOK -->

          <%= button_to "🗑 Delete",
              admin_ebook_path(@ebook),
              method: :delete,
              class: "ebook-action delete",
              form: {
                data: {
                  turbo_confirm: "Delete this E-Book?"
                }
              } %>


        </div>


      </div>


    </div>


  </div>


</div>


<!-- =========================================================
     PAGE JAVASCRIPT
========================================================= -->

<%= render "ebook_3d_script" %>



<!-- =========================================================
     STEP 7 — MULTI PDF STYLES
========================================================= -->

<style nonce="<%= content_security_policy_nonce %>">

  /* =========================================================
     MULTI PDF SECTION
  ========================================================= */

  .ebook-pdf-section {

    margin-top: 32px;

    padding: 24px;

    border-radius: 22px;

    background: rgba(255, 255, 255, 0.72);

    border: 1px solid rgba(124, 58, 237, 0.14);

    box-shadow:
      0 14px 35px rgba(76, 29, 149, 0.08);

  }



  /* =========================================================
     HEADER
  ========================================================= */

  .ebook-pdf-section-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 22px;

  }



  .ebook-pdf-section-title {

    margin: 0;

    font-size: 22px;

    font-weight: 800;

    color: #312e81;

  }



  .ebook-pdf-section-subtitle {

    margin: 5px 0 0;

    color: #64748b;

    font-size: 14px;

  }



  /* =========================================================
     ADD PDF BUTTON
  ========================================================= */

  .ebook-action.add-pdf {

    background:
      linear-gradient(
        135deg,
        #7c3aed,
        #4f46e5
      );

    color: #ffffff;

    text-decoration: none;

    border: 0;

  }



  .ebook-action.add-pdf:hover {

    color: #ffffff;

    transform: translateY(-1px);

  }



  /* =========================================================
     PDF LIST
  ========================================================= */

  .ebook-pdf-list {

    display: flex;

    flex-direction: column;

    gap: 12px;

  }



  /* =========================================================
     PDF ITEM
  ========================================================= */

  .ebook-pdf-item {

    display: flex;

    align-items: center;

    gap: 15px;

    padding: 17px;

    border-radius: 17px;

    background: #ffffff;

    border: 1px solid #e5e7eb;

    transition: 0.2s ease;

  }



  .ebook-pdf-item:hover {

    transform: translateY(-2px);

    box-shadow:
      0 8px 22px rgba(15, 23, 42, 0.08);

  }



  /* =========================================================
     NUMBER
  ========================================================= */

  .ebook-pdf-number {

    width: 38px;

    height: 38px;

    flex: 0 0 38px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    background: #ede9fe;

    color: #6d28d9;

    font-weight: 800;

  }



  /* =========================================================
     ICON
  ========================================================= */

  .ebook-pdf-icon {

    font-size: 30px;

    flex: 0 0 auto;

  }



  /* =========================================================
     INFO
  ========================================================= */

  .ebook-pdf-info {

    flex: 1;

    min-width: 0;

  }



  .ebook-pdf-title {

    font-size: 16px;

    font-weight: 800;

    color: #1e293b;

  }



  .ebook-pdf-description {

    margin-top: 4px;

    color: #64748b;

    font-size: 13px;

    line-height: 1.5;

  }



  /* =========================================================
     META
  ========================================================= */

  .ebook-pdf-meta {

    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    margin-top: 8px;

  }



  .ebook-pdf-status,
  .ebook-pdf-attached,
  .ebook-pdf-missing {

    display: inline-flex;

    align-items: center;

    padding: 4px 9px;

    border-radius: 999px;

    font-size: 11px;

    font-weight: 700;

  }



  .ebook-pdf-status.active {

    background: #dcfce7;

    color: #166534;

  }



  .ebook-pdf-status.inactive {

    background: #fee2e2;

    color: #991b1b;

  }



  .ebook-pdf-attached {

    background: #dbeafe;

    color: #1d4ed8;

  }



  .ebook-pdf-missing {

    background: #fef3c7;

    color: #92400e;

  }



  /* =========================================================
     ACTIONS
  ========================================================= */

  .ebook-pdf-actions {

    display: flex;

    align-items: center;

    gap: 7px;

    flex-wrap: wrap;

  }



  .ebook-pdf-btn {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 36px;

    padding: 7px 11px;

    border-radius: 10px;

    border: 0;

    text-decoration: none;

    font-size: 12px;

    font-weight: 700;

    cursor: pointer;

    transition: 0.2s ease;

  }



  .ebook-pdf-btn:hover {

    transform: translateY(-1px);

  }



  .ebook-pdf-btn.view {

    background: #dbeafe;

    color: #1d4ed8;

  }



  .ebook-pdf-btn.edit {

    background: #ede9fe;

    color: #6d28d9;

  }



  .ebook-pdf-btn.delete {

    background: #fee2e2;

    color: #dc2626;

  }



  /* =========================================================
     EMPTY STATE
  ========================================================= */

  .ebook-pdf-empty {

    text-align: center;

    padding: 45px 20px;

    border: 2px dashed #ddd6fe;

    border-radius: 18px;

    background: #fafaff;

  }



  .ebook-pdf-empty-icon {

    font-size: 48px;

    margin-bottom: 10px;

  }



  .ebook-pdf-empty h4 {

    margin: 0;

    color: #312e81;

    font-weight: 800;

  }



  .ebook-pdf-empty p {

    margin: 7px 0 18px;

    color: #64748b;

  }



  /* =========================================================
     MOBILE
  ========================================================= */

  @media (max-width: 768px) {

    .ebook-pdf-section-header {

      align-items: flex-start;

      flex-direction: column;

    }



    .ebook-pdf-item {

      align-items: flex-start;

      flex-wrap: wrap;

    }



    .ebook-pdf-info {

      width: calc(100% - 70px);

    }



    .ebook-pdf-actions {

      width: 100%;

      padding-left: 53px;

    }

  }

</style>