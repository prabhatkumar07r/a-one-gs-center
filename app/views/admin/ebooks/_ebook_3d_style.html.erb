<style nonce="<%= content_security_policy_nonce %>">

  /* =========================================================
     E-BOOK 3D EDUCATION THEME
  ========================================================= */

  .ebook-3d-page {
    --ebook-primary: #6d28d9;
    --ebook-primary-dark: #4c1d95;
    --ebook-secondary: #2563eb;
    --ebook-text: #172033;
    --ebook-muted: #667085;
    --ebook-card: rgba(255, 255, 255, 0.92);

    position: relative;
    min-height: calc(100vh - 70px);
    padding: 32px;
    overflow: hidden;

    background:
      radial-gradient(
        circle at 10% 10%,
        rgba(124, 58, 237, 0.16),
        transparent 30%
      ),
      radial-gradient(
        circle at 90% 20%,
        rgba(37, 99, 235, 0.13),
        transparent 30%
      ),
      linear-gradient(
        135deg,
        #f7f8ff 0%,
        #eef2ff 45%,
        #f8fafc 100%
      );
  }


  /* =========================================================
     EDUCATION BACKGROUND
  ========================================================= */

  .ebook-study-background {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .study-object {
    position: absolute;
    opacity: 0.10;
    color: #4c1d95;
    font-size: 90px;
    filter: blur(0.3px);
    animation: studyFloat 8s ease-in-out infinite;
  }

  .study-book {
    top: 12%;
    right: 5%;
    transform: rotate(-15deg);
  }

  .study-pencil {
    bottom: 15%;
    left: 4%;
    transform: rotate(25deg);
    animation-delay: 1s;
  }

  .study-graduation {
    top: 45%;
    right: 10%;
    font-size: 75px;
    animation-delay: 2s;
  }

  .study-notes {
    bottom: 5%;
    right: 25%;
    font-size: 65px;
    transform: rotate(10deg);
    animation-delay: 3s;
  }

  @keyframes studyFloat {
    0%, 100% {
      transform: translateY(0) rotate(-8deg);
    }

    50% {
      transform: translateY(-15px) rotate(-3deg);
    }
  }


  /* =========================================================
     MAIN CONTENT
  ========================================================= */

  .ebook-3d-content {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    margin: auto;
  }


  /* =========================================================
     HEADER
  ========================================================= */

  .ebook-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
    padding: 26px 30px;

    border-radius: 24px;

    background: rgba(255, 255, 255, 0.94);

    border: 1px solid rgba(255, 255, 255, 0.8);

    box-shadow:
      0 20px 45px rgba(31, 41, 55, 0.12),
      0 5px 12px rgba(109, 40, 217, 0.08);

    transform: translateZ(0);
  }

  .ebook-page-title {
    margin: 0;
    color: var(--ebook-text);
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .ebook-page-subtitle {
    margin: 7px 0 0;
    color: var(--ebook-muted);
    font-size: 14px;
  }


  /* =========================================================
     3D BUTTON
  ========================================================= */

  .ebook-3d-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    padding: 12px 20px;

    border: 0;
    border-radius: 14px;

    color: white;
    background: linear-gradient(
      135deg,
      var(--ebook-primary),
      var(--ebook-secondary)
    );

    font-weight: 700;
    text-decoration: none;

    box-shadow:
      0 8px 0 rgba(76, 29, 149, 0.35),
      0 15px 25px rgba(76, 29, 149, 0.20);

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .ebook-3d-btn:hover {
    color: white;
    transform: translateY(-4px);
    box-shadow:
      0 12px 0 rgba(76, 29, 149, 0.30),
      0 20px 35px rgba(76, 29, 149, 0.25);
  }

  .ebook-3d-btn:active {
    transform: translateY(3px);
    box-shadow:
      0 4px 0 rgba(76, 29, 149, 0.35),
      0 8px 15px rgba(76, 29, 149, 0.18);
  }


  /* =========================================================
     BOOK GRID
  ========================================================= */

  .ebook-grid {
    display: grid;
    grid-template-columns:
      repeat(auto-fill, minmax(280px, 1fr));
    gap: 28px;
  }


  /* =========================================================
     3D BOOK CARD
  ========================================================= */

  .ebook-card {
    position: relative;
    overflow: hidden;

    border-radius: 24px;

    background: var(--ebook-card);

    border: 1px solid rgba(255, 255, 255, 0.9);

    box-shadow:
      0 25px 50px rgba(15, 23, 42, 0.12),
      0 8px 18px rgba(109, 40, 217, 0.08);

    transform-style: preserve-3d;

    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  .ebook-card:hover {
    transform:
      perspective(1000px)
      rotateX(2deg)
      rotateY(-3deg)
      translateY(-8px);

    box-shadow:
      0 35px 65px rgba(15, 23, 42, 0.18),
      0 12px 25px rgba(109, 40, 217, 0.13);
  }


  /* =========================================================
     COVER
  ========================================================= */

  .ebook-cover {
    position: relative;
    height: 230px;
    overflow: hidden;

    background:
      linear-gradient(
        135deg,
        #ddd6fe,
        #bfdbfe
      );

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ebook-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;

    transition: transform 0.5s ease;
  }

  .ebook-card:hover .ebook-cover img {
    transform: scale(1.06);
  }

  .ebook-cover-placeholder {
    font-size: 70px;
    opacity: 0.55;
  }


  /* =========================================================
     PRICE BADGE
  ========================================================= */

  .ebook-price-badge {
    position: absolute;
    top: 15px;
    right: 15px;

    padding: 7px 13px;

    border-radius: 999px;

    color: white;
    background: linear-gradient(
      135deg,
      #16a34a,
      #059669
    );

    font-size: 12px;
    font-weight: 800;

    box-shadow:
      0 8px 18px rgba(5, 150, 105, 0.30);
  }

  .ebook-price-badge.paid {
    background: linear-gradient(
      135deg,
      #7c3aed,
      #2563eb
    );
  }


  /* =========================================================
     CARD BODY
  ========================================================= */

  .ebook-card-body {
    padding: 22px;
  }

  .ebook-card-title {
    margin: 0 0 7px;

    color: var(--ebook-text);

    font-size: 19px;
    font-weight: 800;

    line-height: 1.3;
  }

  .ebook-card-author {
    color: var(--ebook-muted);
    font-size: 13px;
  }

  .ebook-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;

    margin-top: 15px;
  }

  .ebook-meta-pill {
    padding: 6px 10px;

    border-radius: 9px;

    color: #4c1d95;
    background: #f1efff;

    font-size: 11px;
    font-weight: 700;
  }


  /* =========================================================
     CARD ACTIONS
  ========================================================= */

  .ebook-card-actions {
    display: flex;
    gap: 8px;

    margin-top: 20px;
  }

  .ebook-action {
    flex: 1;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 40px;

    border-radius: 11px;

    font-size: 12px;
    font-weight: 700;

    text-decoration: none;

    transition: 0.2s ease;
  }

  .ebook-action.view {
    color: #4c1d95;
    background: #ede9fe;
  }

  .ebook-action.edit {
    color: #1d4ed8;
    background: #dbeafe;
  }

  .ebook-action.delete {
    color: #b91c1c;
    background: #fee2e2;
    border: 0;
  }

  .ebook-action:hover {
    transform: translateY(-2px);
    filter: brightness(0.97);
  }


  /* =========================================================
     FORM CARD
  ========================================================= */

  .ebook-form-card {
    max-width: 1000px;
    margin: auto;

    padding: 32px;

    border-radius: 26px;

    background: rgba(255, 255, 255, 0.95);

    box-shadow:
      0 25px 60px rgba(15, 23, 42, 0.13),
      0 10px 25px rgba(109, 40, 217, 0.08);

    border: 1px solid rgba(255, 255, 255, 0.9);
  }

  .ebook-form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .ebook-form-group {
    display: flex;
    flex-direction: column;
  }

  .ebook-form-group.full {
    grid-column: 1 / -1;
  }

  .ebook-form-group label {
    margin-bottom: 8px;

    color: #344054;

    font-size: 13px;
    font-weight: 700;
  }

  .ebook-form-group input,
  .ebook-form-group textarea,
  .ebook-form-group select {
    width: 100%;

    padding: 12px 14px;

    border: 1px solid #d9def0;
    border-radius: 12px;

    background: #f9faff;

    color: #172033;

    outline: none;

    transition: 0.2s ease;
  }

  .ebook-form-group textarea {
    min-height: 130px;
    resize: vertical;
  }

  .ebook-form-group input:focus,
  .ebook-form-group textarea:focus,
  .ebook-form-group select:focus {
    border-color: #7c3aed;

    background: white;

    box-shadow:
      0 0 0 4px rgba(124, 58, 237, 0.10);
  }


  /* =========================================================
     SHOW PAGE
  ========================================================= */

  .ebook-detail-card {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 35px;

    padding: 32px;

    border-radius: 28px;

    background: rgba(255, 255, 255, 0.95);

    box-shadow:
      0 30px 70px rgba(15, 23, 42, 0.14);
  }

  .ebook-detail-cover {
    width: 100%;
    min-height: 390px;

    border-radius: 18px;

    object-fit: cover;

    box-shadow:
      15px 18px 0 rgba(76, 29, 149, 0.10),
      0 25px 40px rgba(15, 23, 42, 0.18);
  }

  .ebook-detail-title {
    margin: 0 0 10px;

    color: var(--ebook-text);

    font-size: 34px;
    font-weight: 900;
  }

  .ebook-detail-description {
    margin-top: 22px;

    color: #475467;

    line-height: 1.8;
  }

  .ebook-info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;

    margin-top: 25px;
  }

  .ebook-info-item {
    padding: 14px;

    border-radius: 13px;

    background: #f8f9ff;
  }

  .ebook-info-label {
    display: block;

    color: #98a2b3;

    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .ebook-info-value {
    display: block;

    margin-top: 4px;

    color: #172033;

    font-weight: 700;
  }


  /* =========================================================
     EMPTY STATE
  ========================================================= */

  .ebook-empty {
    padding: 70px 20px;

    text-align: center;

    border-radius: 25px;

    background: rgba(255, 255, 255, 0.90);

    box-shadow:
      0 20px 50px rgba(15, 23, 42, 0.10);
  }

  .ebook-empty-icon {
    font-size: 65px;
    margin-bottom: 15px;
  }

  .ebook-empty h3 {
    margin: 0;

    color: #172033;
    font-size: 23px;
  }

  .ebook-empty p {
    color: #667085;
  }


  /* =========================================================
     RESPONSIVE
  ========================================================= */

  @media (max-width: 768px) {

    .ebook-3d-page {
      padding: 18px;
    }

    .ebook-page-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .ebook-page-title {
      font-size: 24px;
    }

    .ebook-form-grid {
      grid-template-columns: 1fr;
    }

    .ebook-form-group.full {
      grid-column: auto;
    }

    .ebook-detail-card {
      grid-template-columns: 1fr;
      padding: 20px;
    }

    .ebook-detail-cover {
      max-width: 280px;
      margin: auto;
    }

    .ebook-detail-title {
      font-size: 27px;
    }

    .ebook-info-grid {
      grid-template-columns: 1fr;
    }

  }

</style>