<style>
  /* =========================================================
   ADMIN TEST SERIES — SHOW PAGE
   ========================================================= */

.admin-ts-page {
  width: 100%;
  padding: 28px;
}

/* =========================================================
   HEADER
   ========================================================= */

.admin-ts-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 28px;
}

.admin-ts-breadcrumb {
  margin-bottom: 8px;
  color: #7c83a1;
  font-size: 13px;
  font-weight: 500;
}

.admin-ts-breadcrumb a {
  color: #6366f1;
  text-decoration: none;
  transition: color 0.2s ease;
}

.admin-ts-breadcrumb a:hover {
  color: #4f46e5;
}

.admin-ts-header h1 {
  margin: 0 0 8px;
  color: #17172a;
  font-size: 30px;
  line-height: 1.25;
  font-weight: 750;
}

.admin-ts-header p {
  max-width: 760px;
  margin: 0;
  color: #6b7280;
  font-size: 14px;
  line-height: 1.7;
}

.admin-ts-header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

/* =========================================================
   BUTTONS
   ========================================================= */

.admin-ts-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  min-height: 42px;
  padding: 10px 17px;

  border: 1px solid transparent;
  border-radius: 9px;

  font-size: 14px;
  font-weight: 600;
  line-height: 1;
  text-decoration: none;

  cursor: pointer;
  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.admin-ts-btn:hover {
  transform: translateY(-1px);
}

.admin-ts-btn-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #6366f1, #7c3aed);
  box-shadow: 0 5px 16px rgba(99, 102, 241, 0.18);
}

.admin-ts-btn-primary:hover {
  color: #ffffff;
  background: linear-gradient(135deg, #4f46e5, #6d28d9);
  box-shadow: 0 7px 20px rgba(99, 102, 241, 0.25);
}

.admin-ts-btn-light {
  color: #374151;
  background: #ffffff;
  border-color: #e5e7eb;
}

.admin-ts-btn-light:hover {
  color: #4f46e5;
  border-color: #c7d2fe;
  background: #f8f9ff;
}

/* =========================================================
   INFO CARDS
   ========================================================= */

.admin-ts-info-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 36px;
}

.admin-ts-info-card {
  min-width: 0;
  padding: 18px;

  background: #ffffff;
  border: 1px solid #e8eaf1;
  border-radius: 12px;

  box-shadow: 0 4px 14px rgba(25, 25, 50, 0.04);
}

.admin-ts-info-card span {
  display: block;
  margin-bottom: 7px;

  color: #8a90a6;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.admin-ts-info-card strong {
  display: block;

  color: #202033;
  font-size: 15px;
  font-weight: 700;

  overflow-wrap: anywhere;
}

/* =========================================================
   SECTION HEADER
   ========================================================= */

.admin-ts-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  margin-bottom: 16px;
}

.admin-ts-section-header h2 {
  margin: 0 0 4px;

  color: #181827;
  font-size: 21px;
  font-weight: 700;
}

.admin-ts-section-header p {
  margin: 0;

  color: #858ba0;
  font-size: 13px;
}

/* =========================================================
   TEST LIST
   ========================================================= */

.admin-ts-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.admin-ts-list-item {
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) auto;
  align-items: center;
  gap: 18px;

  padding: 18px 20px;

  background: #ffffff;
  border: 1px solid #e7e9f0;
  border-radius: 13px;

  box-shadow: 0 4px 14px rgba(25, 25, 50, 0.035);

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.2s ease;
}

.admin-ts-list-item:hover {
  border-color: #d9d7ff;
  box-shadow: 0 8px 22px rgba(45, 45, 90, 0.07);
  transform: translateY(-1px);
}

/* =========================================================
   TEST NUMBER
   ========================================================= */

.admin-ts-list-number {
  width: 46px;
  height: 46px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 11px;

  color: #ffffff;
  background: linear-gradient(135deg, #6366f1, #7c3aed);

  font-size: 16px;
  font-weight: 750;

  box-shadow: 0 5px 14px rgba(99, 102, 241, 0.18);
}

/* =========================================================
   TEST CONTENT
   ========================================================= */

.admin-ts-list-content {
  min-width: 0;
}

.admin-ts-list-content h3 {
  margin: 0 0 5px;

  color: #1c1c2e;
  font-size: 16px;
  font-weight: 700;

  overflow-wrap: anywhere;
}

.admin-ts-list-content p {
  max-width: 760px;
  margin: 0 0 10px;

  color: #747b91;
  font-size: 13px;
  line-height: 1.55;

  overflow-wrap: anywhere;
}

/* =========================================================
   TEST META
   ========================================================= */

.admin-ts-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px;
}

.admin-ts-meta span {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  color: #73798c;
  font-size: 12px;
  font-weight: 600;
}

.admin-ts-meta i {
  color: #6366f1;
  font-size: 12px;
}

/* =========================================================
   TEST ACTIONS
   ========================================================= */

.admin-ts-list-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 7px;

  flex-shrink: 0;
}

.admin-ts-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 35px;
  padding: 7px 11px;

  border: 1px solid #e5e7eb;
  border-radius: 7px;

  background: #ffffff;

  color: #4b5563;
  font-size: 12px;
  font-weight: 600;
  line-height: 1;

  text-decoration: none;
  cursor: pointer;

  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease;
}

.admin-ts-action:hover {
  text-decoration: none;
}

.admin-ts-action.view:hover {
  color: #4f46e5;
  background: #f5f5ff;
  border-color: #c7d2fe;
}

.admin-ts-action.edit:hover {
  color: #2563eb;
  background: #eff6ff;
  border-color: #bfdbfe;
}

.admin-ts-action.delete {
  color: #dc2626;
  background: #ffffff;
}

.admin-ts-action.delete:hover {
  color: #b91c1c;
  background: #fef2f2;
  border-color: #fecaca;
}

/*
  button_to generates a form around the button.
  Keep the form from disturbing the action layout.
*/
.admin-ts-list-actions form {
  margin: 0;
  padding: 0;
}

/* =========================================================
   EMPTY STATE
   ========================================================= */

.admin-ts-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  min-height: 220px;
  padding: 35px;

  background: #ffffff;
  border: 1px dashed #dfe2eb;
  border-radius: 13px;

  text-align: center;
}

.admin-ts-empty.small {
  min-height: 150px;
}

.admin-ts-empty i {
  margin-bottom: 12px;

  color: #9ca3af;
  font-size: 30px;
}

.admin-ts-empty p {
  margin: 0;

  color: #73798c;
  font-size: 14px;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1200px) {
  .admin-ts-info-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .admin-ts-page {
    padding: 22px;
  }

  .admin-ts-header {
    flex-direction: column;
  }

  .admin-ts-header-actions {
    width: 100%;
  }

  .admin-ts-header-actions .admin-ts-btn {
    flex: 1;
  }

  .admin-ts-list-item {
    grid-template-columns: 46px minmax(0, 1fr);
  }

  .admin-ts-list-actions {
    grid-column: 2;
    justify-content: flex-start;
  }
}

@media (max-width: 650px) {
  .admin-ts-page {
    padding: 16px;
  }

  .admin-ts-header h1 {
    font-size: 24px;
  }

  .admin-ts-info-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .admin-ts-info-card {
    padding: 14px;
  }

  .admin-ts-section-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-ts-section-header .admin-ts-btn {
    width: 100%;
  }

  .admin-ts-list-item {
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 12px;
    padding: 15px;
  }

  .admin-ts-list-number {
    width: 42px;
    height: 42px;
  }

  .admin-ts-list-actions {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
  }

  .admin-ts-action {
    width: 100%;
  }

  .admin-ts-meta {
    gap: 9px 12px;
  }
}

@media (max-width: 430px) {
  .admin-ts-info-grid {
    grid-template-columns: 1fr;
  }

  .admin-ts-header-actions {
    flex-direction: column;
  }

  .admin-ts-header-actions .admin-ts-btn {
    width: 100%;
  }

  .admin-ts-list-actions {
    grid-template-columns: 1fr;
  }
}
</style>

<div class="admin-ts-page">

  <div class="admin-ts-header">

    <div>

      <div class="admin-ts-breadcrumb">
        <%= link_to "Test Series",
                    admin_test_series_index_path %>
        /
        <%= @test_series.title %>
      </div>

      <h1>
        <%= @test_series.title %>
      </h1>

      <p>
        <%= @test_series.description.presence ||
            "No description available." %>
      </p>

    </div>

    <div class="admin-ts-header-actions">

      <%= link_to edit_admin_test_series_path(@test_series),
                  class: "admin-ts-btn admin-ts-btn-primary" do %>
        <i class="fas fa-edit"></i>
        Edit
      <% end %>

      <%= link_to admin_test_series_index_path,
                  class: "admin-ts-btn admin-ts-btn-light" do %>
        Back
      <% end %>

    </div>

  </div>


  <div class="admin-ts-info-grid">

    <div class="admin-ts-info-card">
      <span>Exam</span>
      <strong>
        <%= @test_series.exam_name.presence || "-" %>
      </strong>
    </div>

    <div class="admin-ts-info-card">
      <span>Price</span>
      <strong>
        ₹<%= @test_series.price.to_f.round(2) %>
      </strong>
    </div>

    <div class="admin-ts-info-card">
      <span>Original Price</span>
      <strong>
        ₹<%= @test_series.original_price.to_f.round(2) %>
      </strong>
    </div>

    <div class="admin-ts-info-card">
      <span>Language</span>
      <strong>
        <%= @test_series.language.presence || "-" %>
      </strong>
    </div>

    <div class="admin-ts-info-card">
      <span>Mode</span>
      <strong>
        <%= @test_series.mode.presence || "-" %>
      </strong>
    </div>

    <div class="admin-ts-info-card">
      <span>Status</span>
      <strong>
        <%= @test_series.status %>
      </strong>
    </div>

  </div>


  <div class="admin-ts-section-header">

    <div>
      <h2>Tests</h2>

      <p>
        <%= @tests.count %> test(s)
      </p>
    </div>

    <%= link_to new_admin_test_series_test_path(@test_series),
                class: "admin-ts-btn admin-ts-btn-primary" do %>
      <i class="fas fa-plus"></i>
      Add Test
    <% end %>

  </div>


  <% if @tests.any? %>

    <div class="admin-ts-list">

      <% @tests.each do |test| %>

        <div class="admin-ts-list-item">

          <div class="admin-ts-list-number">
            <%= test.test_number %>
          </div>

          <div class="admin-ts-list-content">

            <h3>
              <%= test.title %>
            </h3>

            <p>
              <%= test.description.presence ||
                  "No description available." %>
            </p>

            <div class="admin-ts-meta">

              <span>
                <i class="fas fa-question-circle"></i>
                <%= test.test_series_questions.count %>
                Questions
              </span>

              <span>
                <i class="fas fa-clock"></i>
                <%= test.duration %> Minutes
              </span>

              <span>
                <i class="fas fa-circle"></i>
                <%= test.status %>
              </span>

            </div>

          </div>

          <div class="admin-ts-list-actions">

            <%= link_to admin_test_series_test_path(
                          @test_series,
                          test
                        ),
                        class: "admin-ts-action view" do %>
              View
            <% end %>

            <%= link_to edit_admin_test_series_test_path(
                          @test_series,
                          test
                        ),
                        class: "admin-ts-action edit" do %>
              Edit
            <% end %>

            <%= button_to admin_test_series_test_path(
                            @test_series,
                            test
                          ),
                          method: :delete,
                          class: "admin-ts-action delete",
                          form: {
                            data: {
                              turbo_confirm:
                                "Delete this test?"
                            }
                          } do %>
              Delete
            <% end %>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <div class="admin-ts-empty small">
      <i class="fas fa-file-alt"></i>
      <p>No tests have been created yet.</p>
    </div>

  <% end %>

</div>