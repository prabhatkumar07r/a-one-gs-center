<style nonce="<%= content_security_policy_nonce %>">
body:has(.admin-ts-page) {
  background: #f4f6ff !important;
}

.admin-ts-page {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  padding: 4px 0 25px;
  color: #172554;
}

.admin-ts-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 18px;
}

.admin-ts-title-wrap {
  min-width: 0;
}

.admin-ts-title {
  margin: 0;
  color: #172554;
  font-size: 25px;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.4px;
}

.admin-ts-subtitle {
  margin: 5px 0 0;
  color: #64748b;
  font-size: 13px;
}

.admin-ts-header-actions {
  display: flex;
  align-items: center;
  gap: 9px;
}

.admin-ts-add {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 40px;
  padding: 9px 15px;
  border: 0;
  border-radius: 9px;
  background: linear-gradient(135deg, #6d28d9, #4f46e5);
  color: #fff !important;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none !important;
  box-shadow: 0 7px 18px rgba(79, 70, 229, .22);
  transition: all .2s ease;
}

.admin-ts-add:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 22px rgba(79, 70, 229, .3);
  color: #fff !important;
}

.admin-ts-theme-toggle {
  width: 40px;
  height: 40px;
  min-width: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #dfe3f0;
  border-radius: 9px;
  background: #fff;
  color: #4f46e5;
  cursor: pointer;
  font-size: 15px;
  box-shadow: 0 4px 12px rgba(30, 41, 59, .06);
  transition: all .2s ease;
}

.admin-ts-theme-toggle:hover {
  background: #f5f3ff;
  border-color: #c4b5fd;
  color: #6d28d9;
  transform: translateY(-1px);
}

.admin-ts-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 13px;
  margin-bottom: 16px;
}

.admin-ts-stat {
  position: relative;
  overflow: hidden;
  min-height: 82px;
  padding: 15px 16px;
  border: 1px solid #e8eaf6;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 5px 18px rgba(30, 41, 59, .07);
  transition: all .2s ease;
}

.admin-ts-stat:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 24px rgba(30, 41, 59, .09);
}

.admin-ts-stat::after {
  content: "";
  position: absolute;
  right: -18px;
  bottom: -25px;
  width: 75px;
  height: 75px;
  border-radius: 50%;
  background: rgba(99, 102, 241, .07);
}

.admin-ts-stat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  margin-bottom: 7px;
  border-radius: 8px;
  background: #f1edff;
  color: #6d28d9;
  font-size: 13px;
}

.admin-ts-stat:nth-child(2) .admin-ts-stat-icon {
  background: #ecfdf5;
  color: #059669;
}

.admin-ts-stat:nth-child(3) .admin-ts-stat-icon {
  background: #fff7ed;
  color: #ea580c;
}

.admin-ts-stat:nth-child(4) .admin-ts-stat-icon {
  background: #eff6ff;
  color: #2563eb;
}

.admin-ts-stat-label {
  color: #64748b;
  font-size: 11px;
  font-weight: 600;
}

.admin-ts-stat-value {
  margin-top: 2px;
  color: #172554;
  font-size: 21px;
  font-weight: 800;
}

.admin-ts-alert {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 15px;
  padding: 10px 13px;
  border: 1px solid #86efac;
  border-radius: 9px;
  background: #f0fdf4;
  color: #166534;
  font-size: 13px;
  font-weight: 600;
}

.admin-ts-table-card {
  overflow: hidden;
  border: 1px solid #e5e7eb;
  border-radius: 13px;
  background: #fff;
  box-shadow: 0 7px 25px rgba(15, 23, 42, .08);
  transition: all .2s ease;
}

.admin-ts-table-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 15px 17px;
  border-bottom: 1px solid #edf0f5;
  background: #fff;
}

.admin-ts-table-heading {
  display: flex;
  align-items: center;
  gap: 10px;
}

.admin-ts-table-heading-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: #f1edff;
  color: #6d28d9;
}

.admin-ts-table-heading h2 {
  margin: 0;
  color: #172554;
  font-size: 15px;
  font-weight: 750;
}

.admin-ts-table-heading span {
  display: block;
  margin-top: 2px;
  color: #94a3b8;
  font-size: 11px;
}

.admin-ts-count-total {
  padding: 5px 9px;
  border-radius: 7px;
  background: #f5f3ff;
  color: #6d28d9;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}

.admin-ts-filters {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 12px 17px;
  border-bottom: 1px solid #edf0f5;
  background: #fcfcff;
}

.admin-ts-search {
  position: relative;
  flex: 1;
  min-width: 0;
}

.admin-ts-search i {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: #94a3b8;
  font-size: 12px;
  pointer-events: none;
}

.admin-ts-search input {
  width: 100%;
  height: 38px;
  box-sizing: border-box;
  padding: 0 12px 0 34px;
  border: 1px solid #e2e5ee;
  border-radius: 8px;
  outline: none;
  background: #fff;
  color: #172554;
  font-size: 12px;
  transition: all .2s ease;
}

.admin-ts-search input::placeholder {
  color: #a1a9b8;
}

.admin-ts-search input:focus {
  border-color: #8b5cf6;
  box-shadow: 0 0 0 3px rgba(139, 92, 246, .09);
}

.admin-ts-filter-select {
  width: 145px;
  height: 38px;
  padding: 0 30px 0 11px;
  border: 1px solid #e2e5ee;
  border-radius: 8px;
  outline: none;
  background: #fff;
  color: #475569;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

.admin-ts-filter-select:focus {
  border-color: #8b5cf6;
  box-shadow: 0 0 0 3px rgba(139, 92, 246, .09);
}

.admin-ts-table-wrapper {
  width: 100%;
  overflow-x: auto;
}

.admin-ts-table {
  width: 100%;
  min-width: 850px;
  border-collapse: collapse;
  font-size: 13px;
}

.admin-ts-table thead {
  background: #f8fafc;
}

.admin-ts-table th {
  padding: 11px 14px;
  border-bottom: 1px solid #e8edf3;
  color: #64748b;
  text-align: left;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .045em;
  white-space: nowrap;
}

.admin-ts-table td {
  padding: 11px 14px;
  border-bottom: 1px solid #f1f5f9;
  color: #475569;
  vertical-align: middle;
  background: #fff;
}

.admin-ts-table tbody tr {
  transition: background .15s ease;
}

.admin-ts-table tbody tr:hover td {
  background: #fafaff;
}

.admin-ts-table tbody tr:last-child td {
  border-bottom: 0;
}

.admin-ts-series-row.is-hidden {
  display: none;
}

.admin-ts-index {
  color: #94a3b8;
  font-size: 12px;
  font-weight: 700;
}

.admin-ts-title-cell {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 190px;
}

.admin-ts-series-icon {
  display: flex;
  flex: 0 0 34px;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: linear-gradient(135deg, #ede9fe, #e0e7ff);
  color: #5b21b6;
  font-size: 13px;
}

.admin-ts-title-text {
  min-width: 0;
}

.admin-ts-title-text strong {
  display: block;
  max-width: 245px;
  overflow: hidden;
  color: #172554;
  font-size: 13px;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-ts-title-text small {
  display: block;
  margin-top: 2px;
  color: #94a3b8;
  font-size: 10px;
}

.admin-ts-exam {
  display: inline-flex;
  padding: 5px 8px;
  border-radius: 6px;
  background: #f1f5f9;
  color: #475569;
  font-size: 11px;
  font-weight: 650;
}

.admin-ts-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 30px;
  height: 27px;
  padding: 0 8px;
  border-radius: 6px;
  background: #f1edff;
  color: #6d28d9;
  font-size: 12px;
  font-weight: 800;
}

.admin-ts-price {
  color: #172554;
  font-size: 13px;
  font-weight: 750;
}

.admin-ts-free {
  color: #059669;
}

.admin-ts-status {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 9px;
  border-radius: 20px;
  font-size: 10px;
  font-weight: 750;
  white-space: nowrap;
}

.admin-ts-status::before {
  content: "";
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: currentColor;
}

.admin-ts-status.active {
  background: #dcfce7;
  color: #15803d;
}

.admin-ts-status.inactive {
  background: #fee2e2;
  color: #b91c1c;
}

.admin-ts-status.pending {
  background: #fef3c7;
  color: #a16207;
}

.admin-ts-actions {
  display: flex;
  align-items: center;
  gap: 5px;
}

.admin-ts-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  min-height: 30px;
  padding: 5px 8px;
  border: 1px solid transparent;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 700;
  text-decoration: none !important;
  cursor: pointer;
  transition: all .15s ease;
}

.admin-ts-action.view {
  border-color: #dbeafe;
  background: #eff6ff;
  color: #2563eb;
}

.admin-ts-action.view:hover {
  background: #dbeafe;
  color: #1d4ed8;
}

.admin-ts-action.edit {
  border-color: #ede9fe;
  background: #f5f3ff;
  color: #6d28d9;
}

.admin-ts-action.edit:hover {
  background: #ede9fe;
  color: #5b21b6;
}

.admin-ts-action.delete {
  border-color: #fee2e2;
  background: #fef2f2;
  color: #dc2626;
}

.admin-ts-action.delete:hover {
  background: #fee2e2;
  color: #b91c1c;
}

.admin-ts-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 270px;
  padding: 35px;
  border: 1px solid #e5e7eb;
  border-radius: 13px;
  background: #fff;
  box-shadow: 0 7px 25px rgba(15, 23, 42, .08);
  text-align: center;
}

.admin-ts-empty > i {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  margin-bottom: 13px;
  border-radius: 14px;
  background: #f1edff;
  color: #6d28d9;
  font-size: 24px;
}

.admin-ts-empty h3 {
  margin: 0 0 5px;
  color: #172554;
  font-size: 18px;
  font-weight: 800;
}

.admin-ts-empty p {
  margin: 0 0 17px;
  color: #64748b;
  font-size: 13px;
}

.admin-ts-empty .admin-ts-add {
  width: auto;
}

.admin-ts-filter-empty {
  display: none;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 170px;
  padding: 25px;
  background: #fff;
  text-align: center;
}

.admin-ts-filter-empty.is-visible {
  display: flex;
}

.admin-ts-filter-empty i {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  margin-bottom: 9px;
  border-radius: 10px;
  background: #f3efff;
  color: #7c3aed;
  font-size: 16px;
}

.admin-ts-filter-empty strong {
  color: #334155;
  font-size: 13px;
  font-weight: 800;
}

.admin-ts-filter-empty span {
  margin-top: 3px;
  color: #94a3b8;
  font-size: 11px;
}

body.admin-ts-dark:has(.admin-ts-page),
body.admin-ts-dark:has(.admin-ts-page) main,
body.admin-ts-dark:has(.admin-ts-page) .main-content,
body.admin-ts-dark:has(.admin-ts-page) .admin-main,
body.admin-ts-dark:has(.admin-ts-page) .content-wrapper {
  background: #0e1222 !important;
}

body.admin-ts-dark .admin-ts-page {
  color: #e5e7eb;
}

body.admin-ts-dark .admin-ts-title {
  color: #ffffff !important;
}

body.admin-ts-dark .admin-ts-subtitle {
  color: #94a3b8 !important;
}

body.admin-ts-dark .admin-ts-theme-toggle {
  background: #181c32 !important;
  border-color: #3b4565 !important;
  color: #fbbf24 !important;
}

body.admin-ts-dark .admin-ts-theme-toggle:hover {
  background: #252b43 !important;
  color: #fcd34d !important;
}

body.admin-ts-dark .admin-ts-stat,
body.admin-ts-dark .admin-ts-table-card,
body.admin-ts-dark .admin-ts-empty {
  background: #181c32 !important;
  border-color: #303653 !important;
  color: #e5e7eb !important;
}

body.admin-ts-dark .admin-ts-stat-label {
  color: #a5aec4 !important;
}

body.admin-ts-dark .admin-ts-stat-value {
  color: #ffffff !important;
}

body.admin-ts-dark .admin-ts-table-head {
  background: #181c32 !important;
  border-bottom-color: #303653 !important;
}

body.admin-ts-dark .admin-ts-table {
  background: #181c32 !important;
}

body.admin-ts-dark .admin-ts-table thead {
  background: #111528 !important;
}

body.admin-ts-dark .admin-ts-table th {
  background: #111528 !important;
  color: #94a3b8 !important;
  border-bottom-color: #303653 !important;
}

body.admin-ts-dark .admin-ts-table td {
  background: #181c32 !important;
  color: #cbd5e1 !important;
  border-bottom-color: #292e49 !important;
}

body.admin-ts-dark .admin-ts-table tbody tr:hover td {
  background: #20253d !important;
}

body.admin-ts-dark .admin-ts-table-heading h2 {
  color: #ffffff !important;
}

body.admin-ts-dark .admin-ts-table-heading span {
  color: #7f8aa3 !important;
}

body.admin-ts-dark .admin-ts-title-text strong {
  color: #f8fafc !important;
}

body.admin-ts-dark .admin-ts-title-text small {
  color: #7f8aa3 !important;
}

body.admin-ts-dark .admin-ts-exam {
  background: #252a42 !important;
  color: #cbd5e1 !important;
}

body.admin-ts-dark .admin-ts-count {
  background: #2b2350 !important;
  color: #c4b5fd !important;
}

body.admin-ts-dark .admin-ts-count-total {
  background: #2b2350 !important;
  color: #c4b5fd !important;
}

body.admin-ts-dark .admin-ts-price {
  color: #ffffff !important;
}

body.admin-ts-dark .admin-ts-series-icon {
  background: #292348 !important;
  color: #a78bfa !important;
}

body.admin-ts-dark .admin-ts-stat-icon {
  background: #292348 !important;
  color: #a78bfa !important;
}

body.admin-ts-dark .admin-ts-table-heading-icon {
  background: #292348 !important;
  color: #a78bfa !important;
}

body.admin-ts-dark .admin-ts-empty h3 {
  color: #ffffff !important;
}

body.admin-ts-dark .admin-ts-empty p {
  color: #94a3b8 !important;
}

body.admin-ts-dark .admin-ts-filter-empty {
  background: #181c32 !important;
}

body.admin-ts-dark .admin-ts-filter-empty i {
  background: #292348 !important;
  color: #a78bfa !important;
}

body.admin-ts-dark .admin-ts-filter-empty strong {
  color: #f1f5f9 !important;
}

body.admin-ts-dark .admin-ts-filter-empty span {
  color: #7f8aa3 !important;
}

body.admin-ts-dark .admin-ts-filters {
  background: #181c32 !important;
  border-bottom-color: #303653 !important;
}

body.admin-ts-dark .admin-ts-search input {
  background: #111528 !important;
  border-color: #343b58 !important;
  color: #f1f5f9 !important;
}

body.admin-ts-dark .admin-ts-search input::placeholder {
  color: #6f7891 !important;
}

body.admin-ts-dark .admin-ts-search i {
  color: #7f8aa3 !important;
}

body.admin-ts-dark .admin-ts-search input:focus {
  border-color: #818cf8 !important;
  box-shadow: 0 0 0 3px rgba(129, 140, 248, .12);
}

body.admin-ts-dark .admin-ts-filter-select {
  background: #111528 !important;
  border-color: #343b58 !important;
  color: #dbe3f0 !important;
}

body.admin-ts-dark .admin-ts-filter-select:focus {
  border-color: #818cf8 !important;
}

body.admin-ts-dark .admin-ts-alert {
  background: #12271d !important;
  border-color: #28623a !important;
  color: #86efac !important;
}

@media (max-width: 1100px) {
  .admin-ts-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 768px) {
  .admin-ts-page {
    padding: 0 0 20px;
  }

  .admin-ts-top {
    flex-direction: column;
    align-items: stretch;
  }

  .admin-ts-title {
    font-size: 22px;
  }

  .admin-ts-header-actions {
    width: 100%;
  }

  .admin-ts-add {
    flex: 1;
    width: auto;
  }

  .admin-ts-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .admin-ts-stat {
    min-height: 75px;
    padding: 12px;
  }

  .admin-ts-stat-value {
    font-size: 18px;
  }

  .admin-ts-table-head {
    padding: 13px;
  }

  .admin-ts-table th,
  .admin-ts-table td {
    padding: 10px 11px;
  }

  .admin-ts-action {
    width: 30px;
    min-width: 30px;
    padding: 0;
  }

  .admin-ts-action i {
    margin: 0;
    font-size: 11px;
  }

  .admin-ts-action span {
    display: none;
  }

  .admin-ts-filters {
    flex-direction: column;
    align-items: stretch;
  }

  .admin-ts-filter-select {
    width: 100%;
  }
}

@media (max-width: 430px) {
  .admin-ts-stats {
    grid-template-columns: 1fr 1fr;
  }

  .admin-ts-stat-label {
    font-size: 10px;
  }

  .admin-ts-stat-value {
    font-size: 17px;
  }

  .admin-ts-table-heading h2 {
    font-size: 14px;
  }

  .admin-ts-count-total {
    display: none;
  }

  .admin-ts-header-actions {
    gap: 7px;
  }

  .admin-ts-theme-toggle {
    width: 38px;
    min-width: 38px;
    height: 38px;
  }

  .admin-ts-add {
    min-height: 38px;
    font-size: 12px;
  }
}
</style>

<div class="admin-ts-page">

  <div class="admin-ts-top">

    <div class="admin-ts-title-wrap">
      <h1 class="admin-ts-title">Test Series</h1>

      <p class="admin-ts-subtitle">
        Manage and monitor all test series from your admin panel.
      </p>
    </div>

    <div class="admin-ts-header-actions">

      <button
        type="button"
        class="admin-ts-theme-toggle"
        id="adminTsThemeToggle"
        aria-label="Switch to night mode"
        title="Switch to night mode">
        <i class="fas fa-moon" id="adminTsThemeIcon"></i>
      </button>

      <%= link_to new_admin_test_series_path,
                  class: "admin-ts-add" do %>
        <i class="fas fa-plus"></i>
        Add Test Series
      <% end %>

    </div>

  </div>

  <% if notice.present? %>

    <div class="admin-ts-alert">
      <i class="fas fa-circle-check"></i>
      <%= notice %>
    </div>

  <% end %>

  <% if @test_series.any? %>

    <div class="admin-ts-stats">

      <div class="admin-ts-stat">
        <div class="admin-ts-stat-icon">
          <i class="fas fa-layer-group"></i>
        </div>

        <div class="admin-ts-stat-label">
          Total Test Series
        </div>

        <div class="admin-ts-stat-value">
          <%= @test_series.size %>
        </div>
      </div>

      <div class="admin-ts-stat">
        <div class="admin-ts-stat-icon">
          <i class="fas fa-circle-check"></i>
        </div>

        <div class="admin-ts-stat-label">
          Active Series
        </div>

        <div class="admin-ts-stat-value">
          <%= @test_series.count { |series|
                series.status.to_s.downcase == "active"
              } %>
        </div>
      </div>

      <div class="admin-ts-stat">
        <div class="admin-ts-stat-icon">
          <i class="fas fa-file-circle-question"></i>
        </div>

        <div class="admin-ts-stat-label">
          Total Tests
        </div>

        <div class="admin-ts-stat-value">
          <%= @test_series.sum { |series|
                series.test_series_tests.size
              } %>
        </div>
      </div>

      <div class="admin-ts-stat">
        <div class="admin-ts-stat-icon">
          <i class="fas fa-indian-rupee-sign"></i>
        </div>

        <div class="admin-ts-stat-label">
          Paid Series
        </div>

        <div class="admin-ts-stat-value">
          <%= @test_series.count { |series|
                series.price.to_f > 0
              } %>
        </div>
      </div>

    </div>

    <div class="admin-ts-table-card">

      <div class="admin-ts-table-head">

        <div class="admin-ts-table-heading">

          <div class="admin-ts-table-heading-icon">
            <i class="fas fa-clipboard-list"></i>
          </div>

          <div>
            <h2>All Test Series</h2>

            <span>
              Search and filter your test series
            </span>
          </div>

        </div>

        <div
          class="admin-ts-count-total"
          id="adminTsVisibleCount">
          <%= @test_series.size %> Entries
        </div>

      </div>

      <div class="admin-ts-filters">

        <div class="admin-ts-search">

          <i class="fas fa-search"></i>

          <input
            type="text"
            id="adminTsSearch"
            placeholder="Search test series, exam name..."
            autocomplete="off">

        </div>

        <select
          id="adminTsFilter"
          class="admin-ts-filter-select">

          <option value="all">
            All Series
          </option>

          <option value="active">
            Active
          </option>

          <option value="inactive">
            Inactive
          </option>

          <option value="paid">
            Paid
          </option>

          <option value="free">
            Free
          </option>

        </select>

      </div>

      <div class="admin-ts-table-wrapper">

        <table class="admin-ts-table">

          <thead>

            <tr>
              <th>#</th>
              <th>Test Series</th>
              <th>Exam</th>
              <th>Tests</th>
              <th>Price</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>

          </thead>

          <tbody>

            <% @test_series.each_with_index do |series, index| %>

              <tr
                class="admin-ts-series-row"
                data-search="<%= [
                  series.title,
                  series.exam_name,
                  series.status
                ].compact.join(' ').downcase %>"
                data-status="<%= series.status.to_s.downcase %>"
                data-price="<%= series.price.to_f > 0 ? 'paid' : 'free' %>">

                <td>
                  <span class="admin-ts-index">
                    <%= index + 1 %>
                  </span>
                </td>

                <td>

                  <div class="admin-ts-title-cell">

                    <div class="admin-ts-series-icon">
                      <i class="fas fa-clipboard-check"></i>
                    </div>

                    <div class="admin-ts-title-text">

                      <strong title="<%= series.title %>">
                        <%= series.title %>
                      </strong>

                      <small>
                        Test Series
                      </small>

                    </div>

                  </div>

                </td>

                <td>

                  <span class="admin-ts-exam">
                    <%= series.exam_name.presence || "-" %>
                  </span>

                </td>

                <td>

                  <span class="admin-ts-count">
                    <%= series.test_series_tests.size %>
                  </span>

                </td>

                <td>

                  <% if series.price.to_f > 0 %>

                    <span class="admin-ts-price">
                      ₹<%= series.price.to_f.round(2) %>
                    </span>

                  <% else %>

                    <span class="admin-ts-price admin-ts-free">
                      Free
                    </span>

                  <% end %>

                </td>

                <td>

                  <span
                    class="admin-ts-status <%= series.status.to_s.downcase %>">
                    <%= series.status %>
                  </span>

                </td>

                <td>

                  <div class="admin-ts-actions">

                    <%= link_to admin_test_series_path(series),
                                class: "admin-ts-action view",
                                title: "View" do %>

                      <i class="fas fa-eye"></i>
                      <span>View</span>

                    <% end %>

                    <%= link_to edit_admin_test_series_path(series),
                                class: "admin-ts-action edit",
                                title: "Edit" do %>

                      <i class="fas fa-pen"></i>
                      <span>Edit</span>

                    <% end %>

                    <%= button_to admin_test_series_path(series),
                                  method: :delete,
                                  class: "admin-ts-action delete",
                                  title: "Delete",
                                  form: {
                                    data: {
                                      turbo_confirm: "Are you sure you want to delete this Test Series?"
                                    }
                                  } do %>

                      <i class="fas fa-trash"></i>
                      <span>Delete</span>

                    <% end %>

                  </div>

                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

        <div
          class="admin-ts-filter-empty"
          id="adminTsFilterEmpty">

          <i class="fas fa-magnifying-glass"></i>

          <strong>
            No matching Test Series
          </strong>

          <span>
            Try a different search or filter.
          </span>

        </div>

      </div>

    </div>

  <% else %>

    <div class="admin-ts-empty">

      <i class="fas fa-folder-open"></i>

      <h3>
        No Test Series Found
      </h3>

      <p>
        Create your first Test Series to start managing exams.
      </p>

      <%= link_to new_admin_test_series_path,
                  class: "admin-ts-add" do %>

        <i class="fas fa-plus"></i>
        Add Test Series

      <% end %>

    </div>

  <% end %>

</div>

<script nonce="<%= content_security_policy_nonce %>">
(function() {
  function applyAdminTsTheme() {
    const isDark =
      localStorage.getItem("admin-ts-theme") === "dark";

    const icon =
      document.getElementById("adminTsThemeIcon");

    const toggle =
      document.getElementById("adminTsThemeToggle");

    document.body.classList.toggle(
      "admin-ts-dark",
      isDark
    );

    if (icon) {
      icon.classList.remove(
        "fa-moon",
        "fa-sun"
      );

      icon.classList.add(
        isDark ? "fa-sun" : "fa-moon"
      );
    }

    if (toggle) {
      const label =
        isDark
          ? "Switch to day mode"
          : "Switch to night mode";

      toggle.setAttribute(
        "aria-label",
        label
      );

      toggle.setAttribute(
        "title",
        label
      );
    }
  }

  function initializeAdminTsPage() {
    applyAdminTsTheme();

    const toggle =
      document.getElementById(
        "adminTsThemeToggle"
      );

    if (
      toggle &&
      toggle.dataset.themeReady !== "true"
    ) {
      toggle.dataset.themeReady = "true";

      toggle.addEventListener(
        "click",
        function() {
          const isDark =
            !document.body.classList.contains(
              "admin-ts-dark"
            );

          localStorage.setItem(
            "admin-ts-theme",
            isDark ? "dark" : "light"
          );

          applyAdminTsTheme();
        }
      );
    }

    const search =
      document.getElementById(
        "adminTsSearch"
      );

    const filter =
      document.getElementById(
        "adminTsFilter"
      );

    const rows =
      document.querySelectorAll(
        ".admin-ts-series-row"
      );

    const count =
      document.getElementById(
        "adminTsVisibleCount"
      );

    const empty =
      document.getElementById(
        "adminTsFilterEmpty"
      );

    if (
      !search ||
      !filter ||
      !rows.length
    ) {
      return;
    }

    function filterSeries() {
      const searchValue =
        search.value
          .trim()
          .toLowerCase();

      const filterValue =
        filter.value;

      let visible = 0;

      rows.forEach(function(row) {
        const searchText =
          row.dataset.search || "";

        const status =
          row.dataset.status || "";

        const price =
          row.dataset.price || "";

        const searchMatch =
          !searchValue ||
          searchText.includes(
            searchValue
          );

        let filterMatch = true;

        if (
          filterValue === "active"
        ) {
          filterMatch =
            status === "active";
        }

        if (
          filterValue === "inactive"
        ) {
          filterMatch =
            status === "inactive";
        }

        if (
          filterValue === "paid"
        ) {
          filterMatch =
            price === "paid";
        }

        if (
          filterValue === "free"
        ) {
          filterMatch =
            price === "free";
        }

        const show =
          searchMatch &&
          filterMatch;

        row.classList.toggle(
          "is-hidden",
          !show
        );

        if (show) {
          visible++;
        }
      });

      if (count) {
        count.textContent =
          visible +
          (
            visible === 1
              ? " Entry"
              : " Entries"
          );
      }

      if (empty) {
        empty.classList.toggle(
          "is-visible",
          visible === 0
        );
      }
    }

    if (
      search.dataset.filterReady !== "true"
    ) {
      search.dataset.filterReady = "true";

      search.addEventListener(
        "input",
        filterSeries
      );
    }

    if (
      filter.dataset.filterReady !== "true"
    ) {
      filter.dataset.filterReady = "true";

      filter.addEventListener(
        "change",
        filterSeries
      );
    }

    filterSeries();
  }

  document.addEventListener(
    "turbo:load",
    initializeAdminTsPage
  );

  document.addEventListener(
    "DOMContentLoaded",
    initializeAdminTsPage
  );

  initializeAdminTsPage();
})();
</script>