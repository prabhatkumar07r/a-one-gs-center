<style>
  /* =========================================================
   ADMIN TEST SERIES
   INDEX PAGE
========================================================= */

.admin-ts-page {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  color: #1e293b;
}


/* =========================================================
   HEADER
========================================================= */

.admin-ts-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  margin-bottom: 25px;
}

.admin-ts-header h1 {
  margin: 0 0 6px;

  font-size: 28px;
  font-weight: 700;

  color: #ffffff;
}

.admin-ts-header p {
  margin: 0;

  font-size: 14px;

  color: rgba(255, 255, 255, 0.75);
}


/* =========================================================
   BUTTON
========================================================= */

.admin-ts-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  min-height: 40px;
  padding: 9px 16px;

  border: 0;
  border-radius: 8px;

  text-decoration: none;

  font-size: 14px;
  font-weight: 600;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    opacity 0.2s ease;
}

.admin-ts-btn:hover {
  transform: translateY(-1px);
  text-decoration: none;
}

.admin-ts-btn-primary {
  background: #ffffff;
  color: #5b21b6;

  box-shadow:
    0 5px 18px rgba(0, 0, 0, 0.15);
}

.admin-ts-btn-primary:hover {
  color: #4c1d95;

  box-shadow:
    0 8px 22px rgba(0, 0, 0, 0.20);
}


/* =========================================================
   ALERT
========================================================= */

.admin-ts-alert {
  margin-bottom: 20px;
  padding: 12px 15px;

  border-radius: 8px;

  font-size: 14px;
  font-weight: 600;
}

.admin-ts-alert.success {
  background: rgba(220, 252, 231, 0.95);
  border: 1px solid #86efac;
  color: #166534;
}


/* =========================================================
   TABLE CARD
========================================================= */

.admin-ts-table-card {
  width: 100%;

  overflow: hidden;

  background: #ffffff;

  border: 1px solid rgba(255, 255, 255, 0.18);

  border-radius: 12px;

  box-shadow:
    0 10px 30px rgba(15, 23, 42, 0.18);
}


/* =========================================================
   TABLE WRAPPER
========================================================= */

.admin-ts-table-wrapper {
  width: 100%;

  overflow-x: auto;
}


/* =========================================================
   TABLE
========================================================= */

.admin-ts-table {
  width: 100%;

  min-width: 850px;

  border-collapse: collapse;

  font-size: 14px;
}

.admin-ts-table thead {
  background: #f8fafc;
}

.admin-ts-table th {
  padding: 14px 16px;

  text-align: left;

  border-bottom: 1px solid #e2e8f0;

  color: #475569;

  font-size: 12px;
  font-weight: 700;

  text-transform: uppercase;
  letter-spacing: 0.03em;

  white-space: nowrap;
}

.admin-ts-table td {
  padding: 14px 16px;

  border-bottom: 1px solid #f1f5f9;

  color: #334155;

  vertical-align: middle;
}

.admin-ts-table tbody tr {
  transition: background 0.15s ease;
}

.admin-ts-table tbody tr:hover {
  background: #f8fafc;
}

.admin-ts-table tbody tr:last-child td {
  border-bottom: 0;
}


/* =========================================================
   TITLE
========================================================= */

.admin-ts-table td strong {
  display: block;

  max-width: 280px;

  color: #0f172a;

  font-weight: 700;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


/* =========================================================
   COUNT
========================================================= */

.admin-ts-count {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-width: 30px;
  height: 28px;

  padding: 0 8px;

  border-radius: 6px;

  background: #ede9fe;

  color: #5b21b6;

  font-size: 13px;
  font-weight: 700;
}


/* =========================================================
   STATUS
========================================================= */

.admin-ts-status {
  display: inline-flex;

  align-items: center;

  padding: 5px 9px;

  border-radius: 20px;

  font-size: 12px;
  font-weight: 700;

  white-space: nowrap;
}

.admin-ts-status.active {
  background: #dcfce7;
  color: #166534;
}

.admin-ts-status.inactive {
  background: #fee2e2;
  color: #991b1b;
}

.admin-ts-status.pending {
  background: #fef3c7;
  color: #92400e;
}


/* =========================================================
   ACTIONS
========================================================= */

.admin-ts-actions {
  display: flex;

  align-items: center;

  gap: 6px;

  white-space: nowrap;
}


/* =========================================================
   ACTION BUTTON
========================================================= */

.admin-ts-action {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 5px;

  min-height: 34px;

  padding: 7px 10px;

  border: 1px solid transparent;
  border-radius: 6px;

  background: transparent;

  font-family: inherit;
  font-size: 12px;
  font-weight: 600;

  text-decoration: none;

  cursor: pointer;

  transition:
    background 0.15s ease,
    border-color 0.15s ease,
    color 0.15s ease;
}

.admin-ts-action i {
  font-size: 12px;
}


/* VIEW */

.admin-ts-action.view {
  background: #eff6ff;
  border-color: #dbeafe;
  color: #1d4ed8;
}

.admin-ts-action.view:hover {
  background: #dbeafe;
  color: #1e40af;
}


/* EDIT */

.admin-ts-action.edit {
  background: #f5f3ff;
  border-color: #ede9fe;
  color: #6d28d9;
}

.admin-ts-action.edit:hover {
  background: #ede9fe;
  color: #5b21b6;
}


/* DELETE */

.admin-ts-action.delete {
  background: #fef2f2;
  border-color: #fee2e2;
  color: #dc2626;
}

.admin-ts-action.delete:hover {
  background: #fee2e2;
  color: #b91c1c;
}


/* =========================================================
   EMPTY STATE
========================================================= */

.admin-ts-empty {
  display: flex;

  align-items: center;
  justify-content: center;

  flex-direction: column;

  min-height: 300px;

  padding: 40px;

  background: #ffffff;

  border-radius: 12px;

  box-shadow:
    0 10px 30px rgba(15, 23, 42, 0.18);

  text-align: center;
}

.admin-ts-empty > i {
  margin-bottom: 15px;

  font-size: 42px;

  color: #7c3aed;
}

.admin-ts-empty h3 {
  margin: 0 0 6px;

  color: #0f172a;

  font-size: 20px;
  font-weight: 700;
}

.admin-ts-empty p {
  margin: 0 0 20px;

  color: #64748b;

  font-size: 14px;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 991px) {

  .admin-ts-header {
    align-items: flex-start;
  }

  .admin-ts-header h1 {
    font-size: 25px;
  }

  .admin-ts-table th,
  .admin-ts-table td {
    padding: 12px 13px;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

  .admin-ts-header {
    flex-direction: column;
    align-items: stretch;

    gap: 15px;
  }

  .admin-ts-header h1 {
    font-size: 23px;
  }

  .admin-ts-header p {
    font-size: 13px;
  }

  .admin-ts-btn-primary {
    width: 100%;
  }

  .admin-ts-table-card {
    border-radius: 9px;
  }

  .admin-ts-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .admin-ts-action {
    width: 100%;
  }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 400px) {

  .admin-ts-page {
    padding: 0;
  }

  .admin-ts-header h1 {
    font-size: 21px;
  }

  .admin-ts-empty {
    min-height: 260px;
    padding: 25px 15px;
  }

}
</style>

<div class="admin-ts-page">

  <div class="admin-ts-header">
    <div>
      <h1>Test Series</h1>
      <p>Manage all test series from the admin panel.</p>
    </div>

    <%= link_to new_admin_test_series_path,
                class: "admin-ts-btn admin-ts-btn-primary" do %>
      <i class="fas fa-plus"></i>
      Add Test Series
    <% end %>
  </div>


  <% if notice.present? %>
    <div class="admin-ts-alert success">
      <%= notice %>
    </div>
  <% end %>


  <% if @test_series.any? %>

    <div class="admin-ts-table-card">

      <div class="admin-ts-table-wrapper">

        <table class="admin-ts-table">

          <thead>
            <tr>
              <th>#</th>
              <th>Title</th>
              <th>Exam</th>
              <th>Tests</th>
              <th>Price</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>

            <% @test_series.each_with_index do |series, index| %>

              <tr>

                <td>
                  <%= index + 1 %>
                </td>

                <td>
                  <strong>
                    <%= series.title %>
                  </strong>
                </td>

                <td>
                  <%= series.exam_name.presence || "-" %>
                </td>

                <td>
                  <span class="admin-ts-count">
                    <%= series.test_series_tests.size %>
                  </span>
                </td>

                <td>
                  ₹<%= series.price.to_f.round(2) %>
                </td>

                <td>
                  <span class="
                    admin-ts-status
                    <%= series.status.to_s.downcase %>
                  ">
                    <%= series.status %>
                  </span>
                </td>

                <td>

                  <div class="admin-ts-actions">

                    <%= link_to admin_test_series_path(series),
                                class: "admin-ts-action view" do %>
                      <i class="fas fa-eye"></i>
                      View
                    <% end %>

                    <%= link_to edit_admin_test_series_path(series),
                                class: "admin-ts-action edit" do %>
                      <i class="fas fa-edit"></i>
                      Edit
                    <% end %>

                    <%= button_to admin_test_series_path(series),
                                  method: :delete,
                                  class: "admin-ts-action delete",
                                  form: {
                                    data: {
                                      turbo_confirm:
                                        "Are you sure you want to delete this Test Series?"
                                    }
                                  } do %>
                      <i class="fas fa-trash"></i>
                      Delete
                    <% end %>

                  </div>

                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

      </div>

    </div>

  <% else %>

    <div class="admin-ts-empty">

      <i class="fas fa-folder-open"></i>

      <h3>No Test Series Found</h3>

      <p>Create your first Test Series.</p>

      <%= link_to "Add Test Series",
                  new_admin_test_series_path,
                  class: "admin-ts-btn admin-ts-btn-primary" %>

    </div>

  <% end %>

</div>