<% content_for :show_layout, true %>

<style>
/* =========================================================
   ADMIN — CREATE QUIZ PAGE
========================================================= */

.teacher-new-quiz-page {
  min-height: calc(100vh - 70px);
  padding: 30px;
  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(79, 70, 229, 0.10),
      transparent 30%
    ),
    #f8fafc;
  color: #1e293b;
}

/* =========================================================
   CONTAINER
========================================================= */

.new-quiz-container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
}

/* =========================================================
   PAGE HEADER
========================================================= */

.new-quiz-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.new-quiz-header-content {
  min-width: 0;
}

.new-quiz-breadcrumb {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 10px;
  color: #64748b;
  font-size: 12px;
  font-weight: 600;
}

.new-quiz-breadcrumb a {
  color: #4f46e5;
  text-decoration: none;
}

.new-quiz-breadcrumb a:hover {
  text-decoration: underline;
}

.new-quiz-title {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0;
  color: #0f172a;
  font-size: 28px;
  font-weight: 800;
  line-height: 1.2;
}

.new-quiz-title-icon {
  width: 44px;
  height: 44px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  flex: 0 0 44px;

  border-radius: 12px;

  background: linear-gradient(
    135deg,
    #4f46e5,
    #6366f1
  );

  color: #fff;

  font-size: 19px;

  box-shadow:
    0 8px 20px rgba(79, 70, 229, 0.20);
}

.new-quiz-subtitle {
  margin: 8px 0 0 56px;
  color: #64748b;
  font-size: 14px;
  line-height: 1.6;
}

.course-highlight {
  display: inline-flex;
  align-items: center;

  margin-left: 4px;
  padding: 3px 9px;

  border-radius: 6px;

  background: #eef2ff;
  color: #4338ca;

  font-weight: 700;
}

/* =========================================================
   FORM CARD
========================================================= */

.quiz-form-card {
  overflow: hidden;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 18px;

  box-shadow:
    0 15px 40px rgba(15, 23, 42, 0.07);
}

/* =========================================================
   FORM SECTION
========================================================= */

.form-section {
  padding: 28px 30px;

  border-bottom: 1px solid #eef2f7;
}

.form-section:last-of-type {
  border-bottom: 0;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 11px;

  margin-bottom: 22px;
}

.section-heading-icon {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex: 0 0 38px;

  border-radius: 10px;

  background: #eef2ff;
  color: #4f46e5;

  font-size: 16px;
}

.section-heading-text h3 {
  margin: 0;

  color: #0f172a;

  font-size: 16px;
  font-weight: 800;
}

.section-heading-text p {
  margin: 3px 0 0;

  color: #94a3b8;

  font-size: 12px;
}

/* =========================================================
   LABELS
========================================================= */

.quiz-label {
  display: block;

  margin-bottom: 8px;

  color: #334155;

  font-size: 13px;
  font-weight: 700;
}

.required-star {
  margin-left: 2px;
  color: #dc2626;
}

/* =========================================================
   INPUTS
========================================================= */

.quiz-input,
.quiz-textarea,
.quiz-select {
  width: 100%;

  border: 1px solid #cbd5e1;
  border-radius: 10px;

  background: #ffffff;

  color: #0f172a;

  font-size: 14px;

  outline: none;

  transition:
    border-color .2s ease,
    box-shadow .2s ease,
    background .2s ease;
}

.quiz-input {
  min-height: 46px;
  padding: 11px 13px;
}

.quiz-textarea {
  min-height: 115px;
  padding: 12px 13px;

  resize: vertical;
}

.quiz-select {
  min-height: 46px;
  padding: 10px 13px;

  cursor: pointer;
}

.quiz-input:hover,
.quiz-textarea:hover,
.quiz-select:hover {
  border-color: #a5b4fc;
}

.quiz-input:focus,
.quiz-textarea:focus,
.quiz-select:focus {
  border-color: #6366f1;

  box-shadow:
    0 0 0 4px rgba(99, 102, 241, 0.10);
}

/* =========================================================
   HELP TEXT
========================================================= */

.field-help {
  display: flex;
  align-items: flex-start;
  gap: 5px;

  margin-top: 7px;

  color: #94a3b8;

  font-size: 11px;
  line-height: 1.5;
}

/* =========================================================
   QUIZ TYPE SELECTOR
========================================================= */

.quiz-type-wrapper {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 15px;
}

.quiz-type-option {
  position: relative;
}

.quiz-type-option input {
  position: absolute;

  opacity: 0;

  pointer-events: none;
}

.quiz-type-label {
  position: relative;

  display: flex;
  flex-direction: column;

  min-height: 145px;

  padding: 20px;

  background: #f8fafc;

  border: 1px solid #e2e8f0;

  border-radius: 14px;

  cursor: pointer;

  transition:
    border-color .2s ease,
    background .2s ease,
    box-shadow .2s ease,
    transform .2s ease;
}

.quiz-type-label:hover {
  transform: translateY(-2px);

  border-color: #c7d2fe;

  box-shadow:
    0 8px 22px rgba(15, 23, 42, .06);
}

.quiz-type-option input:checked + .quiz-type-label {
  background: #eef2ff;

  border-color: #6366f1;

  box-shadow:
    0 0 0 3px rgba(99, 102, 241, .08);
}

.quiz-type-icon {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 14px;

  border-radius: 11px;

  background: #ffffff;

  color: #4f46e5;

  font-size: 17px;

  box-shadow:
    0 4px 12px rgba(15, 23, 42, .05);
}

.quiz-type-title {
  color: #0f172a;

  font-size: 14px;
  font-weight: 800;
}

.quiz-type-description {
  margin-top: 5px;

  color: #64748b;

  font-size: 12px;
  line-height: 1.5;
}

/* =========================================================
   VIDEO SELECTION
========================================================= */

.video-selection-box {
  margin-top: 18px;
  padding: 20px;

  background:
    linear-gradient(
      135deg,
      #f8fafc,
      #f1f5f9
    );

  border: 1px solid #e2e8f0;
  border-radius: 13px;

  animation: slideDown .25s ease;
}

.video-selection-box.hidden {
  display: none;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================================
   STATUS
========================================================= */

.status-box {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 14px;
}

.status-option {
  position: relative;
}

.status-option input {
  position: absolute;

  opacity: 0;

  pointer-events: none;
}

.status-label {
  display: flex;
  align-items: center;

  min-height: 48px;

  padding: 12px 15px;

  border: 1px solid #e2e8f0;

  border-radius: 10px;

  background: #f8fafc;

  color: #475569;

  font-size: 13px;
  font-weight: 700;

  cursor: pointer;

  transition: .2s ease;
}

.status-label:hover {
  border-color: #c7d2fe;
}

.status-option input:checked + .status-label {
  background: #eef2ff;

  border-color: #6366f1;

  color: #4338ca;

  box-shadow:
    0 0 0 3px rgba(99, 102, 241, .07);
}

/* =========================================================
   ERRORS
========================================================= */

.quiz-errors {
  margin: 24px 30px 0;

  padding: 16px 18px;

  background: #fef2f2;

  border: 1px solid #fecaca;

  border-left: 4px solid #dc2626;

  border-radius: 11px;

  color: #991b1b;
}

.quiz-errors h6 {
  display: flex;
  align-items: center;

  margin: 0 0 9px;

  font-size: 13px;
  font-weight: 800;
}

.quiz-errors ul {
  margin: 0;
  padding-left: 20px;

  font-size: 12px;
  line-height: 1.7;
}

/* =========================================================
   ACTIONS
========================================================= */

.form-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 15px;

  padding: 22px 30px;

  background: #f8fafc;

  border-top: 1px solid #e2e8f0;
}

.btn-cancel-quiz,
.btn-save-quiz {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  min-height: 44px;

  padding: 10px 17px;

  border-radius: 9px;

  font-size: 13px;
  font-weight: 700;

  text-decoration: none;

  cursor: pointer;

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    background .2s ease;
}

.btn-cancel-quiz {
  background: #ffffff;

  border: 1px solid #cbd5e1;

  color: #475569;
}

.btn-cancel-quiz:hover {
  background: #f1f5f9;

  color: #0f172a;

  transform: translateY(-1px);
}

.btn-save-quiz {
  border: 0;

  background:
    linear-gradient(
      135deg,
      #4f46e5,
      #6366f1
    );

  color: #ffffff;

  box-shadow:
    0 7px 18px rgba(79, 70, 229, .20);
}

.btn-save-quiz:hover {
  color: #ffffff;

  transform: translateY(-1px);

  box-shadow:
    0 10px 24px rgba(79, 70, 229, .27);
}

.btn-save-quiz.loading {
  pointer-events: none;

  opacity: .75;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {

  .teacher-new-quiz-page {
    padding: 22px 16px;
  }

  .quiz-type-wrapper {
    grid-template-columns: 1fr;
  }

  .course-highlight {
    display: inline;
  }
}

@media (max-width: 650px) {

  .teacher-new-quiz-page {
    padding: 18px 12px;
  }

  .new-quiz-title {
    font-size: 23px;
  }

  .new-quiz-title-icon {
    width: 40px;
    height: 40px;

    flex-basis: 40px;
  }

  .new-quiz-subtitle {
    margin-left: 0;
  }

  .form-section {
    padding: 22px 18px;
  }

  .quiz-errors {
    margin-left: 18px;
    margin-right: 18px;
  }

  .status-box {
    grid-template-columns: 1fr;
  }

  .form-actions {
    flex-direction: column-reverse;

    padding: 18px;
  }

  .btn-cancel-quiz,
  .btn-save-quiz {
    width: 100%;
  }
}

@media (max-width: 420px) {

  .new-quiz-title {
    font-size: 21px;
  }

  .section-heading-text h3 {
    font-size: 15px;
  }

  .quiz-type-label {
    min-height: auto;
    padding: 17px;
  }
}
</style>

<div class="teacher-new-quiz-page">

  <div class="new-quiz-container">

<!-- =====================================================
     HEADER
====================================================== -->

<div class="new-quiz-header">

  <div class="new-quiz-header-content">

    <div class="new-quiz-breadcrumb">

      <%= link_to "Courses", admin_courses_path %>

      <i class="fas fa-chevron-right"></i>

      <%= link_to @course.Course_name,
                  admin_course_path(@course) %>

      <i class="fas fa-chevron-right"></i>

      <span>New Quiz</span>

    </div>


    <h1 class="new-quiz-title">

      <span class="new-quiz-title-icon">
        <i class="fas fa-plus"></i>
      </span>

      Create New Quiz

    </h1>


    <p class="new-quiz-subtitle">

      Create and configure a new quiz for

      <span class="course-highlight">
        <%= @course.Course_name %>
      </span>

    </p>

  </div>

</div>


<!-- =====================================================
     FORM CARD
====================================================== -->

<div class="quiz-form-card">


  <!-- ===================================================
       ERRORS
  ==================================================== -->

  <% if @quiz.errors.any? %>

    <div class="quiz-errors">

      <h6>
        <i class="fas fa-exclamation-triangle"></i>

        Please fix the following errors:
      </h6>

      <ul>

        <% @quiz.errors.full_messages.each do |message| %>

          <li>
            <%= message %>
          </li>

        <% end %>

      </ul>

    </div>

  <% end %>


  <%= form_with model: [:admin, @course, @quiz],
                local: true,
                data: {
                  quiz_form: true
                } do |f| %>


    <!-- =================================================
         BASIC INFORMATION
    ================================================== -->

    <div class="form-section">

      <div class="section-heading">

        <div class="section-heading-icon">

          <i class="fas fa-circle-info"></i>

        </div>

        <div class="section-heading-text">

          <h3>
            Basic Information
          </h3>

          <p>
            Enter the basic details of your quiz.
          </p>

        </div>

      </div>


      <!-- TITLE -->

      <div class="mb-4">

        <%= f.label :title,
              class: "quiz-label" do %>

          Quiz Title

          <span class="required-star">*</span>

        <% end %>


        <%= f.text_field :title,
              class: "quiz-input",
              placeholder: "Example: HTML Basics Quiz",
              autocomplete: "off",
              required: true %>

      </div>


      <!-- DESCRIPTION -->

      <div>

        <%= f.label :description,
              "Description",
              class: "quiz-label" %>


        <%= f.text_area :description,
              class: "quiz-textarea",
              placeholder: "Enter quiz instructions or description..." %>

      </div>

    </div>


    <!-- =================================================
         QUIZ TYPE
    ================================================== -->

    <div class="form-section">

      <div class="section-heading">

        <div class="section-heading-icon">

          <i class="fas fa-layer-group"></i>

        </div>

        <div class="section-heading-text">

          <h3>
            Quiz Type
          </h3>

          <p>
            Choose how this quiz should be associated with the course.
          </p>

        </div>

      </div>


      <div class="quiz-type-wrapper">


        <!-- COURSE LEVEL -->

        <div class="quiz-type-option">

          <input type="radio"
                 name="quiz_type"
                 id="course_level_quiz"
                 value="course"
                 <%= "checked" if @quiz.video_id.blank? %>>


          <label for="course_level_quiz"
                 class="quiz-type-label">

            <span class="quiz-type-icon">

              <i class="fas fa-graduation-cap"></i>

            </span>


            <span class="quiz-type-title">

              Course Level Quiz

            </span>


            <span class="quiz-type-description">

              Covers the entire course and is not tied to one particular video.

            </span>

          </label>

        </div>


        <!-- VIDEO LEVEL -->

        <div class="quiz-type-option">

          <input type="radio"
                 name="quiz_type"
                 id="video_level_quiz"
                 value="video"
                 <%= "checked" if @quiz.video_id.present? %>>


          <label for="video_level_quiz"
                 class="quiz-type-label">

            <span class="quiz-type-icon">

              <i class="fas fa-video"></i>

            </span>


            <span class="quiz-type-title">

              Video-wise Quiz

            </span>


            <span class="quiz-type-description">

              Connect this quiz to one specific course video.

            </span>

          </label>

        </div>


      </div>


      <!-- =================================================
           VIDEO SELECTION
      ================================================== -->

      <div id="videoSelectionBox"
           class="video-selection-box <%= 'hidden' if @quiz.video_id.blank? %>">

        <%= f.label :video_id,
              "Select Video",
              class: "quiz-label" %>


        <%= f.collection_select :video_id,
              @videos || @course.videos.order(:position),
              :id,
              :title,
              {
                include_blank: "Select a video..."
              },
              {
                class: "quiz-select",
                id: "quiz_video_id"
              } %>


        <div class="field-help">

          <i class="fas fa-info-circle"></i>

          <span>
            Select the video for which this quiz should be available.
          </span>

        </div>

      </div>

    </div>


    <!-- =================================================
         QUIZ SETTINGS
    ================================================== -->

    <div class="form-section">

      <div class="section-heading">

        <div class="section-heading-icon">

          <i class="fas fa-sliders"></i>

        </div>

        <div class="section-heading-text">

          <h3>
            Quiz Settings
          </h3>

          <p>
            Configure time and passing requirements.
          </p>

        </div>

      </div>


      <div class="row g-4">


        <!-- TIME -->

        <div class="col-md-6">

          <%= f.label :time_limit,
                class: "quiz-label" do %>

            Time Limit

            <span class="required-star">*</span>

          <% end %>


          <%= f.number_field :time_limit,
                class: "quiz-input",
                min: 1,
                step: 1,
                placeholder: "30",
                required: true %>


          <div class="field-help">

            <i class="fas fa-clock"></i>

            <span>
              Time limit in minutes.
            </span>

          </div>

        </div>


        <!-- PASSING -->

        <div class="col-md-6">

          <%= f.label :passing_percentage,
                class: "quiz-label" do %>

            Passing Percentage

            <span class="required-star">*</span>

          <% end %>


          <%= f.number_field :passing_percentage,
                class: "quiz-input",
                min: 0,
                max: 100,
                step: 1,
                placeholder: "40",
                required: true %>


          <div class="field-help">

            <i class="fas fa-percent"></i>

            <span>
              Minimum percentage required to pass.
            </span>

          </div>

        </div>


      </div>

    </div>


    <!-- =================================================
         STATUS
    ================================================== -->

    <div class="form-section">

      <div class="section-heading">

        <div class="section-heading-icon">

          <i class="fas fa-toggle-on"></i>

        </div>

        <div class="section-heading-text">

          <h3>
            Quiz Status
          </h3>

          <p>
            Control whether students can access this quiz.
          </p>

        </div>

      </div>


      <div class="status-box">


        <!-- ACTIVE -->

        <div class="status-option">

          <%= f.radio_button :status,
                "Active",
                checked: (
                  @quiz.status.blank? ||
                  @quiz.status == "Active"
                ) %>


          <%= f.label :status_active,
                class: "status-label" do %>

            <i class="fas fa-check-circle me-2"></i>

            Active

          <% end %>

        </div>


        <!-- INACTIVE -->

        <div class="status-option">

          <%= f.radio_button :status,
                "Inactive" %>


          <%= f.label :status_inactive,
                class: "status-label" do %>

            <i class="fas fa-pause-circle me-2"></i>

            Inactive

          <% end %>

        </div>


      </div>

    </div>


    <!-- =================================================
         ACTIONS
    ================================================== -->

    <div class="form-actions">


      <%= link_to admin_course_quizzes_path(@course),
            class: "btn-cancel-quiz" do %>

        <i class="fas fa-arrow-left"></i>

        Cancel

      <% end %>


      <%= f.button type: "submit",
            class: "btn-save-quiz",
            data: {
              save_quiz: true
            } do %>

        <i class="fas fa-save"></i>

        Create Quiz

      <% end %>


    </div>


  <% end %>

</div>


  </div>

</div>

<script>
(function () {

  function initializeQuizForm() {

    const courseRadio =
      document.getElementById("course_level_quiz");

    const videoRadio =
      document.getElementById("video_level_quiz");

    const videoBox =
      document.getElementById("videoSelectionBox");

    const videoSelect =
      document.getElementById("quiz_video_id");

    const quizForm =
      document.querySelector("[data-quiz-form]");

    const saveButton =
      document.querySelector("[data-save-quiz]");


    /*
     * ======================================================
     * QUIZ TYPE
     * ======================================================
     */

    function updateQuizType() {

      if (!videoBox) return;


      if (videoRadio && videoRadio.checked) {

        videoBox.classList.remove("hidden");


        if (videoSelect) {

          videoSelect.required = true;

        }

      } else {

        videoBox.classList.add("hidden");


        if (videoSelect) {

          videoSelect.required = false;

          videoSelect.value = "";

        }

      }

    }


    /*
     * ======================================================
     * RADIO EVENTS
     * ======================================================
     */

    courseRadio?.addEventListener(
      "change",
      updateQuizType
    );

    videoRadio?.addEventListener(
      "change",
      updateQuizType
    );


    /*
     * ======================================================
     * INITIAL STATE
     * ======================================================
 */

    updateQuizType();


    /*
     * ======================================================
     * FORM SUBMIT
     * ======================================================
 */

    if (quizForm && saveButton) {

      quizForm.addEventListener(
        "submit",
        function () {

          saveButton.classList.add("loading");

          saveButton.innerHTML =
            '<i class="fas fa-spinner fa-spin"></i> Creating Quiz...';

        }
      );

    }


    /*
     * ======================================================
     * INPUT VALIDATION
     * ======================================================
 */

    const passingInput =
      document.getElementById("quiz_passing_percentage");

    if (passingInput) {

      passingInput.addEventListener(
        "input",
        function () {

          let value =
            parseInt(this.value || 0, 10);


          if (value > 100) {

            this.value = 100;

          }

          if (value < 0) {

            this.value = 0;

          }

        }
      );

    }


    /*
     * ======================================================
     * TIME LIMIT VALIDATION
     * ======================================================
 */

    const timeInput =
      document.getElementById("quiz_time_limit");

    if (timeInput) {

      timeInput.addEventListener(
        "input",
        function () {

          if (
            this.value &&
            parseInt(this.value, 10) < 1
          ) {

            this.value = 1;

          }

        }
      );

    }

  }


  /*
   * ========================================================
   * TURBO SUPPORT
   * ========================================================
   */

  document.addEventListener(
    "turbo:load",
    initializeQuizForm
  );


  /*
   * NORMAL PAGE LOAD
   */

  document.addEventListener(
    "DOMContentLoaded",
    initializeQuizForm
  );


