<% content_for :show_layout, true %>

<style nonce="<%= content_security_policy_nonce %>">

  /* =========================================================
     PAGE
  ========================================================= */

  .teacher-new-quiz-page {
    min-height: 100vh;
    padding: 30px;
    background:
      radial-gradient(
        circle at top right,
        rgba(124, 58, 237, 0.08),
        transparent 32%
      ),
      radial-gradient(
        circle at bottom left,
        rgba(37, 99, 235, 0.06),
        transparent 30%
      ),
      #f8f7ff;
    box-sizing: border-box;
  }


  /* =========================================================
     HEADER
  ========================================================= */

  .quiz-page-header {
    max-width: 1100px;
    margin: 0 auto 25px;
  }

  .quiz-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;

    color: #7c3aed;
    font-size: 13px;
    font-weight: 600;
  }

  .quiz-breadcrumb i {
    font-size: 9px;
    color: #9ca3af;
  }

  .quiz-page-title {
    margin: 0;

    color: #111827;
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .quiz-page-subtitle {
    margin: 7px 0 0;

    color: #6b7280;
    font-size: 14px;
  }


  /* =========================================================
     CARD
  ========================================================= */

  .quiz-form-card {
    max-width: 1100px;
    margin: 0 auto;

    background: #ffffff;

    border: 1px solid #e5e7eb;
    border-radius: 18px;

    box-shadow:
      0 15px 40px rgba(15, 23, 42, 0.07);

    overflow: hidden;
  }

  .quiz-form-header {
    padding: 22px 26px;

    border-bottom: 1px solid #eef0f4;

    background:
      linear-gradient(
        135deg,
        rgba(124, 58, 237, 0.05),
        rgba(59, 130, 246, 0.04)
      );
  }

  .quiz-form-header h2 {
    margin: 0;

    color: #1f2937;

    font-size: 18px;
    font-weight: 750;
  }

  .quiz-form-header p {
    margin: 5px 0 0;

    color: #6b7280;
    font-size: 13px;
  }

  .quiz-form-body {
    padding: 28px;
  }


  /* =========================================================
     GRID
  ========================================================= */

  .quiz-form-grid {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 22px;
  }

  .quiz-field-full {
    grid-column: 1 / -1;
  }


  /* =========================================================
     LABEL
  ========================================================= */

  .quiz-label {
    display: block;

    margin-bottom: 8px;

    color: #374151;

    font-size: 13px;
    font-weight: 700;
  }

  .quiz-required {
    color: #dc2626;
  }


  /* =========================================================
     INPUTS
  ========================================================= */

  .quiz-input,
  .quiz-select,
  .quiz-textarea {
    width: 100%;

    box-sizing: border-box;

    border: 1px solid #dfe3ea;
    border-radius: 10px;

    background: #ffffff;

    color: #111827;

    font-size: 14px;

    outline: none;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .quiz-input,
  .quiz-select {
    min-height: 47px;
    padding: 12px 14px;
  }

  .quiz-textarea {
    min-height: 125px;
    padding: 13px 14px;

    resize: vertical;
  }

  .quiz-input:focus,
  .quiz-select:focus,
  .quiz-textarea:focus {
    border-color: #7c3aed;

    box-shadow:
      0 0 0 3px rgba(124, 58, 237, 0.10);
  }


  /* =========================================================
     QUIZ TYPE
  ========================================================= */

  .quiz-type-wrapper {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 14px;
  }

  .quiz-type-option {
    position: relative;
  }

  .quiz-type-option input {
    position: absolute;

    opacity: 0;
    pointer-events: none;
  }

  .quiz-type-label {
    display: flex;

    align-items: center;
    gap: 13px;

    min-height: 72px;

    padding: 14px 16px;

    box-sizing: border-box;

    border: 1px solid #e5e7eb;
    border-radius: 13px;

    background: #ffffff;

    cursor: pointer;

    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .quiz-type-label:hover {
    border-color: #c4b5fd;

    transform: translateY(-1px);
  }

  .quiz-type-option input:checked + .quiz-type-label {
    border-color: #7c3aed;

    background:
      linear-gradient(
        135deg,
        rgba(124, 58, 237, 0.07),
        rgba(192, 38, 211, 0.04)
      );

    box-shadow:
      0 6px 18px rgba(124, 58, 237, 0.08);
  }

  .quiz-type-icon {
    width: 40px;
    height: 40px;

    min-width: 40px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 11px;

    background: #f3f4f6;

    color: #6b7280;

    font-size: 16px;
  }

  .quiz-type-option input:checked + .quiz-type-label .quiz-type-icon {
    background: #ede9fe;
    color: #7c3aed;
  }

  .quiz-type-content strong {
    display: block;

    color: #1f2937;

    font-size: 14px;
    font-weight: 750;
  }

  .quiz-type-content span {
    display: block;

    margin-top: 3px;

    color: #6b7280;

    font-size: 12px;
    line-height: 1.4;
  }


  /* =========================================================
     VIDEO SELECTION AREA
  ========================================================= */

  .video-selection-box {
    grid-column: 1 / -1;

    padding: 20px;

    border: 1px solid #ddd6fe;
    border-radius: 14px;

    background:
      linear-gradient(
        135deg,
        rgba(124, 58, 237, 0.045),
        rgba(59, 130, 246, 0.025)
      );
  }

  .video-selection-header {
    display: flex;

    align-items: center;
    gap: 10px;

    margin-bottom: 17px;
  }

  .video-selection-header-icon {
    width: 35px;
    height: 35px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 9px;

    background: #ede9fe;
    color: #7c3aed;
  }

  .video-selection-header strong {
    color: #312e81;

    font-size: 14px;
    font-weight: 750;
  }

  .video-selection-header span {
    display: block;

    margin-top: 2px;

    color: #6b7280;

    font-size: 12px;
  }


  /* =========================================================
     PLAYLIST SELECT
  ========================================================= */

  .playlist-selection {
    margin-bottom: 18px;
  }


  /* =========================================================
     VIDEO SELECT
  ========================================================= */

  .video-select-wrapper {
    position: relative;
  }

  .video-select-loading {
    display: none;

    margin-top: 7px;

    color: #7c3aed;

    font-size: 12px;
    font-weight: 600;
  }

  .video-select-empty {
    margin-top: 7px;

    color: #6b7280;

    font-size: 12px;
  }


  /* =========================================================
     STATUS
  ========================================================= */

  .status-options {
    display: flex;

    gap: 12px;

    flex-wrap: wrap;
  }

  .status-option {
    position: relative;
  }

  .status-option input {
    position: absolute;

    opacity: 0;
    pointer-events: none;
  }

  .status-label {
    display: inline-flex;

    align-items: center;
    gap: 8px;

    min-height: 43px;

    padding: 0 15px;

    border: 1px solid #e5e7eb;
    border-radius: 10px;

    background: #ffffff;

    color: #4b5563;

    font-size: 13px;
    font-weight: 650;

    cursor: pointer;

    transition: all 0.2s ease;
  }

  .status-label:hover {
    border-color: #c4b5fd;
  }

  .status-option input:checked + .status-label {
    border-color: #7c3aed;

    background: #f5f3ff;

    color: #6d28d9;
  }


  /* =========================================================
     ERROR
  ========================================================= */

  .quiz-errors {
    margin-bottom: 22px;

    padding: 15px 17px;

    border: 1px solid #fecaca;
    border-radius: 11px;

    background: #fef2f2;

    color: #991b1b;

    font-size: 13px;
  }

  .quiz-errors strong {
    display: block;

    margin-bottom: 7px;
  }

  .quiz-errors ul {
    margin: 0;
    padding-left: 20px;
  }


  /* =========================================================
     ACTIONS
  ========================================================= */

  .quiz-form-actions {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 12px;

    margin-top: 30px;
    padding-top: 22px;

    border-top: 1px solid #eef0f4;
  }

  .quiz-cancel-btn,
  .quiz-submit-btn {
    min-height: 46px;

    padding: 0 20px;

    border-radius: 10px;

    font-size: 13px;
    font-weight: 700;

    text-decoration: none;

    cursor: pointer;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .quiz-cancel-btn {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    border: 1px solid #e5e7eb;

    background: #ffffff;

    color: #4b5563;
  }

  .quiz-cancel-btn:hover {
    color: #374151;

    transform: translateY(-1px);
  }

  .quiz-submit-btn {
    border: 0;

    background:
      linear-gradient(
        135deg,
        #6d28d9,
        #c026d3
      );

    color: #ffffff;

    box-shadow:
      0 7px 18px rgba(109, 40, 217, 0.20);
  }

  .quiz-submit-btn:hover {
    transform: translateY(-1px);

    box-shadow:
      0 10px 23px rgba(109, 40, 217, 0.28);
  }


  /* =========================================================
     HIDDEN
  ========================================================= */

  .hidden {
    display: none !important;
  }


  /* =========================================================
     RESPONSIVE
  ========================================================= */

  @media (max-width: 768px) {

    .teacher-new-quiz-page {
      padding: 20px 14px;
    }

    .quiz-page-title {
      font-size: 24px;
    }

    .quiz-form-body {
      padding: 20px;
    }

    .quiz-form-grid {
      grid-template-columns: 1fr;
    }

    .quiz-field-full {
      grid-column: auto;
    }

    .video-selection-box {
      grid-column: auto;
    }

    .quiz-type-wrapper {
      grid-template-columns: 1fr;
    }

    .quiz-form-actions {
      flex-direction: column-reverse;
      align-items: stretch;
    }

    .quiz-cancel-btn,
    .quiz-submit-btn {
      width: 100%;
    }
  }

</style>


<div class="teacher-new-quiz-page">

  <!-- =======================================================
       HEADER
  ======================================================== -->

  <div class="quiz-page-header">

    <div class="quiz-breadcrumb">

      <span>Admin Panel</span>

      <i class="fas fa-chevron-right"></i>

      <span>Courses</span>

      <i class="fas fa-chevron-right"></i>

      <span>Quizzes</span>

      <i class="fas fa-chevron-right"></i>

      <span>Add Quiz</span>

    </div>

    <h1 class="quiz-page-title">
      Create New Quiz
    </h1>

    <p class="quiz-page-subtitle">
      Create a course-level quiz or assign a quiz to a specific video.
    </p>

  </div>


  <!-- =======================================================
       FORM CARD
  ======================================================== -->

  <div class="quiz-form-card">

    <div class="quiz-form-header">

      <h2>
        Quiz Information
      </h2>

      <p>
        Configure the quiz and choose where it should appear.
      </p>

    </div>


    <div class="quiz-form-body">

      <!-- ===================================================
           ERRORS
      ==================================================== -->

      <% if @quiz.errors.any? %>

        <div class="quiz-errors">

          <strong>
            Please fix the following errors:
          </strong>

          <ul>

            <% @quiz.errors.full_messages.each do |message| %>

              <li>
                <%= message %>
              </li>

            <% end %>

          </ul>

        </div>

      <% end %>


      <%= form_with model: [:admin, @course, @quiz],
                    local: true,
                    data: {
                      quiz_form: true
                    } do |f| %>


        <div class="quiz-form-grid">


          <!-- =================================================
               QUIZ TITLE
          ================================================== -->

          <div class="quiz-field-full">

            <%= f.label :title, class: "quiz-label" do %>
              Quiz Title
              <span class="quiz-required">*</span>
            <% end %>

            <%= f.text_field :title,
                  class: "quiz-input",
                  placeholder: "Enter quiz title",
                  required: true,
                  autocomplete: "off" %>

          </div>


          <!-- =================================================
               DESCRIPTION
          ================================================== -->

          <div class="quiz-field-full">

            <%= f.label :description,
                  "Description",
                  class: "quiz-label" %>

            <%= f.text_area :description,
                  class: "quiz-textarea",
                  placeholder: "Enter quiz description..." %>

          </div>


          <!-- =================================================
               QUIZ TYPE
          ================================================== -->

          <div class="quiz-field-full">

            <label class="quiz-label">

              Quiz Type
              <span class="quiz-required">*</span>

            </label>


            <div class="quiz-type-wrapper">


              <!-- COURSE QUIZ -->

              <div class="quiz-type-option">

                <input
                  type="radio"
                  name="quiz_type"
                  value="course"
                  id="quiz_type_course"
                  <%= "checked" if @quiz.video_id.blank? %>
                >

                <label
                  for="quiz_type_course"
                  class="quiz-type-label">

                  <span class="quiz-type-icon">
                    <i class="fas fa-book"></i>
                  </span>

                  <span class="quiz-type-content">

                    <strong>
                      Course Level Quiz
                    </strong>

                    <span>
                      Quiz for the complete course
                    </span>

                  </span>

                </label>

              </div>


              <!-- VIDEO QUIZ -->

              <div class="quiz-type-option">

                <input
                  type="radio"
                  name="quiz_type"
                  value="video"
                  id="quiz_type_video"
                  <%= "checked" if @quiz.video_id.present? %>
                >

                <label
                  for="quiz_type_video"
                  class="quiz-type-label">

                  <span class="quiz-type-icon">
                    <i class="fas fa-play-circle"></i>
                  </span>

                  <span class="quiz-type-content">

                    <strong>
                      Video-wise Quiz
                    </strong>

                    <span>
                      Quiz for a specific video
                    </span>

                  </span>

                </label>

              </div>

            </div>

          </div>


          <!-- =================================================
               PLAYLIST + VIDEO
          ================================================== -->

          <div
            id="videoSelectionBox"
            class="video-selection-box <%= "hidden" if @quiz.video_id.blank? %>"
          >

            <div class="video-selection-header">

              <div class="video-selection-header-icon">

                <i class="fas fa-layer-group"></i>

              </div>

              <div>

                <strong>
                  Video Quiz Assignment
                </strong>

                <span>
                  Select the playlist first, then choose the video.
                </span>

              </div>

            </div>


            <!-- ===============================================
                 PLAYLIST
            ================================================ -->
<%= select_tag(
      :quiz_playlist_id,
      options_from_collection_for_select(
        @playlists,
        :id,
        :title,
        @quiz.video&.playlist_id
      ),
      {
        include_blank: "Select a playlist...",
        class: "quiz-select",
        id: "quiz_playlist_id"
      }
    ) %>


            <!-- ===============================================
                 VIDEO
            ================================================ -->

            <div class="video-select-wrapper">

              <%= f.label :video_id,
                    "Select Video",
                    class: "quiz-label" %>


              <%= f.select :video_id,
                    options_for_select(
                      if @quiz.video&.playlist_id.present?

                        @quiz.video
                            .playlist
                            .videos
                            .order(:position, :id)
                            .map do |video|

                          [
                            "#{video.position}. #{video.title}",
                            video.id
                          ]

                        end

                      else

                        []

                      end,
                      @quiz.video_id
                    ),
                    {
                      include_blank: "Select a video..."
                    },
                    {
                      class: "quiz-select",
                      id: "quiz_video_id"
                    } %>


              <div
                id="videoSelectLoading"
                class="video-select-loading"
              >
                <i class="fas fa-spinner fa-spin"></i>
                Loading videos...
              </div>


              <div
                id="videoSelectEmpty"
                class="video-select-empty"
              >
                Select a playlist to load its videos.
              </div>

            </div>

          </div>


          <!-- =================================================
               TIME LIMIT
          ================================================== -->

          <div>

            <%= f.label :time_limit,
                  "Time Limit (minutes)",
                  class: "quiz-label" %>

            <%= f.number_field :time_limit,
                  class: "quiz-input",
                  min: 1,
                  placeholder: "30" %>

          </div>


          <!-- =================================================
               PASSING
          ================================================== -->

          <div>

            <%= f.label :passing_percentage,
                  "Passing Percentage",
                  class: "quiz-label" %>

            <%= f.number_field :passing_percentage,
                  class: "quiz-input",
                  min: 1,
                  max: 100,
                  placeholder: "40" %>

          </div>


          <!-- =================================================
               STATUS
          ================================================== -->

          <div class="quiz-field-full">

            <label class="quiz-label">

              Status
              <span class="quiz-required">*</span>

            </label>


            <div class="status-options">


              <div class="status-option">

                <%= f.radio_button :status,
                      "Active",
                      id: "quiz_status_active" %>

                <label
                  for="quiz_status_active"
                  class="status-label">

                  <i class="fas fa-check-circle"></i>

                  Active

                </label>

              </div>


              <div class="status-option">

                <%= f.radio_button :status,
                      "Inactive",
                      id: "quiz_status_inactive" %>

                <label
                  for="quiz_status_inactive"
                  class="status-label">

                  <i class="fas fa-pause-circle"></i>

                  Inactive

                </label>

              </div>

            </div>

          </div>


          <!-- =================================================
               ACTIONS
          ================================================== -->

          <div class="quiz-field-full">

            <div class="quiz-form-actions">

              <%= link_to(
                    "Cancel",
                    admin_course_quizzes_path(@course),
                    class: "quiz-cancel-btn"
                  ) %>


              <%= f.submit(
                    "Create Quiz",
                    class: "quiz-submit-btn"
                  ) %>

            </div>

          </div>


        </div>

      <% end %>

    </div>

  </div>

</div>

<script nonce="<%= content_security_policy_nonce %>">
  document.addEventListener("turbo:load", function () {

    const courseRadio =
      document.getElementById("quiz_type_course");

    const videoRadio =
      document.getElementById("quiz_type_video");

    const videoSelectionBox =
      document.getElementById("videoSelectionBox");

    const playlistSelect =
      document.getElementById("quiz_playlist_id");

    const videoSelect =
      document.getElementById("quiz_video_id");

    const loadingMessage =
      document.getElementById("videoSelectLoading");

    const emptyMessage =
      document.getElementById("videoSelectEmpty");

    if (
      !courseRadio ||
      !videoRadio ||
      !videoSelectionBox ||
      !playlistSelect ||
      !videoSelect
    ) {
      return;
    }


    /* =========================================================
       PLAYLIST → VIDEOS DATA
    ========================================================= */

    const playlistVideos = <%= raw(
      @playlists.each_with_object({}) do |playlist, hash|

        hash[playlist.id] =
          playlist.videos
                  .order(:position, :id)
                  .map do |video|

            {
              id: video.id,
              title: video.title,
              position: video.position
            }

          end

      end.to_json
    ) %>;


    /* =========================================================
       LOAD VIDEOS
    ========================================================= */

    function loadVideos(playlistId, selectedVideoId = null) {

      videoSelect.innerHTML =
        '<option value="">Select a video...</option>';

      if (loadingMessage) {
        loadingMessage.style.display = "none";
      }

      if (emptyMessage) {
        emptyMessage.style.display = "none";
      }


      if (!playlistId) {

        if (emptyMessage) {
          emptyMessage.style.display = "block";
          emptyMessage.textContent =
            "Select a playlist to load its videos.";
        }

        return;
      }


      if (loadingMessage) {
        loadingMessage.style.display = "block";
      }


      const videos =
        playlistVideos[String(playlistId)] ||
        playlistVideos[playlistId] ||
        [];


      videos.forEach(function (video) {

        const option =
          document.createElement("option");

        option.value =
          String(video.id);

        option.textContent =
          video.position + ". " + video.title;

        if (
          selectedVideoId &&
          String(video.id) ===
            String(selectedVideoId)
        ) {
          option.selected = true;
        }

        videoSelect.appendChild(option);

      });


      if (loadingMessage) {
        loadingMessage.style.display = "none";
      }


      if (videos.length === 0) {

        if (emptyMessage) {
          emptyMessage.style.display = "block";

          emptyMessage.textContent =
            "No videos are available in this playlist.";
        }

      }

    }


    /* =========================================================
       QUIZ TYPE
    ========================================================= */

    function updateQuizType() {

      if (videoRadio.checked) {

        videoSelectionBox.classList.remove("hidden");

        playlistSelect.required = true;
        videoSelect.required = true;

      } else {

        videoSelectionBox.classList.add("hidden");

        playlistSelect.required = false;
        videoSelect.required = false;

        playlistSelect.value = "";

        videoSelect.innerHTML =
          '<option value="">Select a video...</option>';

        videoSelect.value = "";

      }

    }


    /* =========================================================
       QUIZ TYPE EVENTS
    ========================================================= */

    courseRadio.addEventListener(
      "change",
      updateQuizType
    );

    videoRadio.addEventListener(
      "change",
      updateQuizType
    );


    /* =========================================================
       PLAYLIST CHANGE
    ========================================================= */

    playlistSelect.addEventListener(
      "change",
      function () {

        loadVideos(
          playlistSelect.value
        );

      }
    );


    /* =========================================================
       INITIAL STATE
    ========================================================= */

    updateQuizType();


    /* =========================================================
       EXISTING VIDEO
       Useful if form is rendered again with existing data
    ========================================================= */

    <% if @quiz.video_id.present? && @quiz.video&.playlist_id.present? %>

      const initialPlaylistId =
        "<%= @quiz.video.playlist_id %>";

      const initialVideoId =
        "<%= @quiz.video_id %>";

      playlistSelect.value =
        initialPlaylistId;

      loadVideos(
        initialPlaylistId,
        initialVideoId
      );

    <% end %>

  });
</script>