<!-- =========================================================
     TAB JAVASCRIPT
========================================================= -->

<script nonce="<%= content_security_policy_nonce %>">
(function () {

  function initializeQuizTabs() {

    const tabs =
      document.querySelectorAll(".quiz-type-tab");

    const panes =
      document.querySelectorAll(".quiz-type-pane");

    if (!tabs.length || !panes.length) {
      return;
    }


    tabs.forEach(function (tab) {

      /*
       * Prevent duplicate event listeners
       * when Turbo loads the page again.
       */
      if (tab.dataset.quizTabInitialized === "true") {
        return;
      }

      tab.dataset.quizTabInitialized = "true";


      tab.addEventListener("click", function (event) {

        event.preventDefault();


        const targetId =
          tab.getAttribute("data-quiz-target");


        if (!targetId) {
          return;
        }


        const targetPane =
          document.getElementById(targetId);


        if (!targetPane) {
          return;
        }


        /*
         * Remove active state from every tab
         */

        tabs.forEach(function (item) {

          item.classList.remove("active");

          item.setAttribute(
            "aria-selected",
            "false"
          );

        });


        /*
         * Hide every pane
         */

        panes.forEach(function (pane) {

          pane.classList.remove("active");

        });


        /*
         * Activate clicked tab
         */

        tab.classList.add("active");

        tab.setAttribute(
          "aria-selected",
          "true"
        );


        /*
         * Show selected pane
         */

        targetPane.classList.add("active");

      });

    });

  }


  /*
   * Normal browser load
   */

  document.addEventListener(
    "DOMContentLoaded",
    initializeQuizTabs
  );


  /*
   * Rails Turbo navigation
   */

  document.addEventListener(
    "turbo:load",
    initializeQuizTabs
  );


  /*
   * If this script itself is evaluated after
   * DOMContentLoaded/Turbo load, initialize immediately.
   */

  initializeQuizTabs();

})();
</script>