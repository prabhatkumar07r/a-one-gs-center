<div class="admin-quizzes-page">

  <!-- =========================================================
       PAGE HEADER
  ========================================================== -->

  <div class="quiz-page-header">

    <div class="quiz-header-content">

      <div class="quiz-breadcrumb">
        <span>Admin Panel</span>
        <i class="fas fa-chevron-right"></i>
        <span>Courses</span>
        <i class="fas fa-chevron-right"></i>
        <span>Quizzes</span>
      </div>

      <h1 class="quiz-page-title">

        <span class="quiz-page-title-icon">
          <i class="fas fa-clipboard-question"></i>
        </span>

        Course Quizzes

      </h1>

      <p class="quiz-page-subtitle">

        Manage course-level and video-specific quizzes for

        <strong>
          <%= @course.Course_name %>
        </strong>

      </p>

    </div>


    <!-- HEADER ACTIONS -->

    <div class="quiz-header-actions">

      <%= link_to admin_course_path(@course),
                  class: "quiz-btn quiz-btn-secondary" do %>

        <i class="fas fa-arrow-left"></i>

        <span>
          Back to Course
        </span>

      <% end %>


      <%= link_to new_admin_course_quiz_path(@course),
                  class: "quiz-btn quiz-btn-primary" do %>

        <i class="fas fa-plus"></i>

        <span>
          Create Quiz
        </span>

      <% end %>

    </div>

  </div>


  <!-- =========================================================
       SUMMARY CARDS
  ========================================================== -->

  <div class="quiz-summary-grid">


    <!-- TOTAL QUIZZES -->

    <div class="quiz-summary-card">

      <div class="quiz-summary-info">

        <span class="quiz-summary-label">
          Total Quizzes
        </span>

        <strong class="quiz-summary-value">
          <%= @quizzes.count %>
        </strong>

        <span class="quiz-summary-description">
          Course + video quizzes
        </span>

      </div>

      <div class="quiz-summary-icon purple">
        <i class="fas fa-clipboard-question"></i>
      </div>

    </div>


    <!-- ACTIVE QUIZZES -->

    <div class="quiz-summary-card">

      <div class="quiz-summary-info">

        <span class="quiz-summary-label">
          Active Quizzes
        </span>

        <strong class="quiz-summary-value">
         <%= @quizzes.active.count %>
        </strong>

        <span class="quiz-summary-description">
          Currently available
        </span>

      </div>

      <div class="quiz-summary-icon green">
        <i class="fas fa-circle-check"></i>
      </div>

    </div>


    <!-- TOTAL QUESTIONS -->

    <div class="quiz-summary-card">

      <div class="quiz-summary-info">

        <span class="quiz-summary-label">
          Total Questions
        </span>

        <strong class="quiz-summary-value">
          <%= @quizzes.sum { |quiz| quiz.questions.count } %>
        </strong>

        <span class="quiz-summary-description">
          Across all quizzes
        </span>

      </div>

      <div class="quiz-summary-icon orange">
        <i class="fas fa-circle-question"></i>
      </div>

    </div>

  </div>


  <!-- =========================================================
       QUIZ TYPE TABS
  ========================================================== -->

 <%
  course_quizzes = @quizzes.course_wise
  video_quizzes  = @quizzes.video_wise
%>


 <!-- =========================================================
     QUIZ TYPE TABS
========================================================== -->

<div class="quiz-type-tabs">

  <!-- COURSE QUIZZES -->

  <button
    type="button"
    class="quiz-type-tab active"
    data-quiz-target="course-quizzes-pane"
    aria-selected="true">

    <span class="quiz-type-icon course">
      <i class="fas fa-book"></i>
    </span>

    <span class="quiz-type-text">
      <strong>Course Quizzes</strong>

      <small>
        Quizzes for the complete course
      </small>
    </span>

    <span class="quiz-type-count">
      <%= course_quizzes.count %>
    </span>

  </button>


  <!-- VIDEO QUIZZES -->

  <button
    type="button"
    class="quiz-type-tab"
    data-quiz-target="video-quizzes-pane"
    aria-selected="false">

    <span class="quiz-type-icon video">
      <i class="fas fa-video"></i>
    </span>

    <span class="quiz-type-text">
      <strong>Video Quizzes</strong>

      <small>
        Quizzes for individual videos
      </small>
    </span>

    <span class="quiz-type-count">
      <%= video_quizzes.count %>
    </span>

  </button>

</div>

  <!-- =========================================================
       COURSE QUIZZES PANE
  ========================================================== -->

  <section
    id="course-quizzes-pane"
    class="quiz-type-pane active">


    <div class="quiz-panel">


      <!-- PANEL HEADER -->

      <div class="quiz-panel-header">

        <div>

          <div class="quiz-panel-title">

            <span class="quiz-panel-title-icon course">
              <i class="fas fa-book"></i>
            </span>

            <div>

              <h2>
                Course Quizzes
              </h2>

              <p>
                Quizzes available for the complete course
              </p>

            </div>

          </div>

        </div>


        <span class="quiz-panel-count">
          <%= course_quizzes.count %>
          <%= course_quizzes.count == 1 ? "Quiz" : "Quizzes" %>
        </span>

      </div>


      <% if course_quizzes.any? %>


        <!-- TABLE -->

        <div class="quiz-table-wrapper">

          <table class="quiz-table">

            <thead>

              <tr>

                <th class="number-column">
                  #
                </th>

                <th>
                  Quiz
                </th>

                <th>
                  Type
                </th>

                <th>
                  Questions
                </th>

                <th>
                  Time
                </th>

                <th>
                  Passing
                </th>

                <th>
                  Status
                </th>

                <th class="actions-column">
                  Actions
                </th>

              </tr>

            </thead>


            <tbody>

              <% course_quizzes.each_with_index do |quiz, index| %>

                <tr>


                  <!-- NUMBER -->

                  <td>

                    <span class="quiz-number">
                      <%= index + 1 %>
                    </span>

                  </td>


                  <!-- QUIZ -->

                  <td>

                    <div class="quiz-name">
                      <%= quiz.title %>
                    </div>

                    <% if quiz.description.present? %>

                      <div class="quiz-description">

                        <%= truncate(
                              quiz.description,
                              length: 70
                            ) %>

                      </div>

                    <% end %>

                  </td>


                  <!-- TYPE -->

                  <td>

                    <span class="quiz-type-badge course">

                      <i class="fas fa-book"></i>

                      Course

                    </span>

                  </td>


                  <!-- QUESTIONS -->

                  <td>

                    <span class="quiz-question-badge">

                      <i class="fas fa-circle-question"></i>

                      <%= quiz.questions.size %>

                    </span>

                  </td>


                  <!-- TIME -->

                  <td>

                    <span class="quiz-table-value">

                      <i class="fas fa-clock"></i>

                      <%= quiz.time_limit %> min

                    </span>

                  </td>


                  <!-- PASSING -->

                  <td>

                    <strong class="passing-value">
                      <%= quiz.passing_percentage %>%
                    </strong>

                  </td>


                  <!-- STATUS -->

                  <td>

                      <% if quiz.status.to_s.downcase == "active" %>

                    <span class="quiz-status active">

                   <i class="fas fa-check"></i>

                   Active

                  </span>

             <% else %>

               <span class="quiz-status inactive">

                <i class="fas fa-pause"></i>

                 <%= quiz.status %>

              </span>

            <% end %>

             </td>


                  <!-- ACTIONS -->

                  <td>

                    <div class="quiz-actions">

                      <%= link_to admin_course_quiz_path(
                                    @course,
                                    quiz
                                  ),
                                  class: "quiz-action view",
                                  title: "View Quiz" do %>

                        <i class="fas fa-eye"></i>

                      <% end %>


                      <%= link_to edit_admin_course_quiz_path(
                                    @course,
                                    quiz
                                  ),
                                  class: "quiz-action edit",
                                  title: "Edit Quiz" do %>

                        <i class="fas fa-pen"></i>

                      <% end %>


                      <%= button_to admin_course_quiz_path(
                                      @course,
                                      quiz
                                    ),
                                    method: :delete,
                                    class: "quiz-action delete",
                                    form: {
                                      data: {
                                        turbo_confirm:
                                          "Are you sure you want to delete this quiz?"
                                      }
                                    },
                                    title: "Delete Quiz" do %>

                        <i class="fas fa-trash"></i>

                      <% end %>

                    </div>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>


      <% else %>


        <!-- EMPTY STATE -->

        <div class="quiz-empty-state">

          <div class="quiz-empty-icon course">
            <i class="fas fa-book"></i>
          </div>

          <h3>
            No Course Quizzes
          </h3>

          <p>
            This course does not have any course-level quizzes yet.
          </p>

          <%= link_to new_admin_course_quiz_path(@course),
                      class: "quiz-btn quiz-btn-primary" do %>

            <i class="fas fa-plus"></i>

            Create Course Quiz

          <% end %>

        </div>

      <% end %>

    </div>

  </section>


  <!-- =========================================================
       VIDEO QUIZZES PANE
  ========================================================== -->

  <section
    id="video-quizzes-pane"
    class="quiz-type-pane">


    <div class="quiz-panel">


      <!-- PANEL HEADER -->

      <div class="quiz-panel-header">

        <div class="quiz-panel-title">

          <span class="quiz-panel-title-icon video">
            <i class="fas fa-video"></i>
          </span>

          <div>

            <h2>
              Video Quizzes
            </h2>

            <p>
              Quizzes linked to individual course videos
            </p>

          </div>

        </div>


        <span class="quiz-panel-count video">
          <%= video_quizzes.count %>
          <%= video_quizzes.count == 1 ? "Quiz" : "Quizzes" %>
        </span>

      </div>


      <% if video_quizzes.any? %>


        <!-- TABLE -->

        <div class="quiz-table-wrapper">

          <table class="quiz-table">

            <thead>

              <tr>

                <th class="number-column">
                  #
                </th>

                <th>
                  Quiz
                </th>

                <th>
                  Video
                </th>

                <th>
                  Questions
                </th>

                <th>
                  Time
                </th>

                <th>
                  Passing
                </th>

                <th>
                  Status
                </th>

                <th class="actions-column">
                  Actions
                </th>

              </tr>

            </thead>


            <tbody>

              <% video_quizzes.each_with_index do |quiz, index| %>

                <tr>


                  <!-- NUMBER -->

                  <td>

                    <span class="quiz-number video">
                      <%= index + 1 %>
                    </span>

                  </td>


                  <!-- QUIZ -->

                  <td>

                    <div class="quiz-name">
                      <%= quiz.title %>
                    </div>

                    <% if quiz.description.present? %>

                      <div class="quiz-description">

                        <%= truncate(
                              quiz.description,
                              length: 70
                            ) %>

                      </div>

                    <% end %>

                  </td>


                  <!-- VIDEO -->

                  <td>

                    <span class="video-name-badge">

                      <i class="fas fa-video"></i>

                      <%= truncate(
                            quiz.video&.title || "Video",
                            length: 35
                          ) %>

                    </span>

                  </td>


                  <!-- QUESTIONS -->

                  <td>

                    <span class="quiz-question-badge">

                      <i class="fas fa-circle-question"></i>

                      <%= quiz.questions.size %>

                    </span>

                  </td>


                  <!-- TIME -->

                  <td>

                    <span class="quiz-table-value">

                      <i class="fas fa-clock"></i>

                      <%= quiz.time_limit %> min

                    </span>

                  </td>


                  <!-- PASSING -->

                  <td>

                    <strong class="passing-value">
                      <%= quiz.passing_percentage %>%
                    </strong>

                  </td>


                  <!-- STATUS -->

                  <td>

                    <% if quiz.status == "active" %>

                      <span class="quiz-status active">

                        <i class="fas fa-check"></i>

                        Active

                      </span>

                    <% else %>

                      <span class="quiz-status inactive">

                        <i class="fas fa-pause"></i>

                        <%= quiz.status %>

                      </span>

                    <% end %>

                  </td>


                  <!-- ACTIONS -->

                  <td>

                    <div class="quiz-actions">

                      <%= link_to admin_course_quiz_path(
                                    @course,
                                    quiz
                                  ),
                                  class: "quiz-action view",
                                  title: "View Quiz" do %>

                        <i class="fas fa-eye"></i>

                      <% end %>


                      <%= link_to edit_admin_course_quiz_path(
                                    @course,
                                    quiz
                                  ),
                                  class: "quiz-action edit",
                                  title: "Edit Quiz" do %>

                        <i class="fas fa-pen"></i>

                      <% end %>


                      <%= button_to admin_course_quiz_path(
                                      @course,
                                      quiz
                                    ),
                                    method: :delete,
                                    class: "quiz-action delete",
                                    form: {
                                      data: {
                                        turbo_confirm:
                                          "Are you sure you want to delete this quiz?"
                                      }
                                    },
                                    title: "Delete Quiz" do %>

                        <i class="fas fa-trash"></i>

                      <% end %>

                    </div>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>


      <% else %>


        <!-- EMPTY STATE -->

        <div class="quiz-empty-state">

          <div class="quiz-empty-icon video">
            <i class="fas fa-video"></i>
          </div>

          <h3>
            No Video Quizzes
          </h3>

          <p>
            No quizzes have been created for individual videos yet.
          </p>

          <%= link_to new_admin_course_quiz_path(@course),
                      class: "quiz-btn quiz-btn-primary" do %>

            <i class="fas fa-plus"></i>

            Create Video Quiz

          <% end %>

        </div>

      <% end %>

    </div>

  </section>

</div>


<!-- =========================================================
     STYLES
========================================================== -->

<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   PAGE
========================================================= */

.admin-quizzes-page {

  min-height: 100vh;

  padding: 30px 34px 60px;

  background:
    radial-gradient(
      circle at top right,
      rgba(99,102,241,.08),
      transparent 32%
    ),

    #f8fafc;

  box-sizing: border-box;

}


/* =========================================================
   HEADER
========================================================= */

.quiz-page-header {

  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 25px;

  margin-bottom: 28px;

}


.quiz-header-content {
  min-width: 0;
}


.quiz-breadcrumb {

  display: flex;

  align-items: center;

  gap: 8px;

  margin-bottom: 10px;

  color: #94a3b8;

  font-size: 12px;

}


.quiz-breadcrumb i {
  font-size: 9px;
}


.quiz-page-title {

  display: flex;

  align-items: center;

  gap: 12px;

  margin: 0 0 7px;

  color: #0f172a;

  font-size: 27px;

  font-weight: 800;

}


.quiz-page-title-icon {

  width: 45px;
  height: 45px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  border-radius: 13px;

  background: #eef2ff;

  color: #4f46e5;

  font-size: 19px;

}


.quiz-page-subtitle {

  margin: 0;

  color: #64748b;

  font-size: 14px;

}


.quiz-page-subtitle strong {
  color: #334155;
}


/* =========================================================
   HEADER BUTTONS
========================================================= */

.quiz-header-actions {

  display: flex;

  align-items: center;

  gap: 10px;

  flex-shrink: 0;

}


.quiz-btn {

  min-height: 42px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 8px;

  padding: 0 16px;

  border-radius: 10px;

  text-decoration: none;

  border: 1px solid transparent;

  font-size: 13px;

  font-weight: 600;

  transition: all .2s ease;

  cursor: pointer;

}


.quiz-btn-primary {

  background: #4f46e5;

  color: #ffffff;

  box-shadow:
    0 4px 12px rgba(79,70,229,.18);

}


.quiz-btn-primary:hover {

  background: #4338ca;

  color: #ffffff;

  transform: translateY(-1px);

}


.quiz-btn-secondary {

  background: #ffffff;

  border-color: #e2e8f0;

  color: #475569;

}


.quiz-btn-secondary:hover {

  background: #f8fafc;

  color: #334155;

}


/* =========================================================
   SUMMARY
========================================================= */

.quiz-summary-grid {

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;

  margin-bottom: 22px;

}


.quiz-summary-card {

  min-height: 112px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  padding: 20px;

  background: #ffffff;

  border: 1px solid #e2e8f0;

  border-radius: 16px;

  box-shadow:
    0 3px 14px rgba(15,23,42,.04);

  box-sizing: border-box;

  transition:
    transform .2s ease,
    box-shadow .2s ease;

}


.quiz-summary-card:hover {

  transform: translateY(-2px);

  box-shadow:
    0 8px 24px rgba(15,23,42,.08);

}


.quiz-summary-info {

  min-width: 0;

}


.quiz-summary-label {

  display: block;

  margin-bottom: 4px;

  color: #64748b;

  font-size: 12px;

  font-weight: 600;

}


.quiz-summary-value {

  display: block;

  color: #0f172a;

  font-size: 27px;

  line-height: 1.1;

}


.quiz-summary-description {

  display: block;

  margin-top: 5px;

  color: #94a3b8;

  font-size: 11px;

}


.quiz-summary-icon {

  width: 48px;
  height: 48px;

  min-width: 48px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 13px;

  font-size: 19px;

}


.quiz-summary-icon.purple {

  background: #eef2ff;

  color: #4f46e5;

}


.quiz-summary-icon.green {

  background: #ecfdf5;

  color: #059669;

}


.quiz-summary-icon.orange {

  background: #fff7ed;

  color: #ea580c;

}


/* =========================================================
   QUIZ TYPE TABS
========================================================= */

.quiz-type-tabs {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 10px;

  padding: 6px;

  margin-bottom: 18px;

  background: #eef2f7;

  border: 1px solid #e2e8f0;

  border-radius: 16px;

}


.quiz-type-tab {

  min-height: 76px;

  display: flex;

  align-items: center;

  gap: 12px;

  padding: 12px 15px;

  border: 0;

  border-radius: 11px;

  background: transparent;

  color: #64748b;

  text-align: left;

  cursor: pointer;

  transition: all .2s ease;

}


.quiz-type-tab:hover {

  background: rgba(255,255,255,.7);

  color: #4f46e5;

}


.quiz-type-tab.active {

  background: #ffffff;

  color: #4f46e5;

  box-shadow:
    0 4px 14px rgba(15,23,42,.07);

}


.quiz-type-icon {

  width: 43px;
  height: 43px;

  min-width: 43px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 12px;

  background: #e0e7ff;

  color: #4f46e5;

}


.quiz-type-icon.video {

  background: #e0f2fe;

  color: #0284c7;

}


.quiz-type-text {

  min-width: 0;

  display: flex;

  flex-direction: column;

  gap: 3px;

}


.quiz-type-text strong {

  font-size: 14px;

  color: inherit;

}


.quiz-type-text small {

  color: #94a3b8;

  font-size: 11px;

}


.quiz-type-count {

  margin-left: auto;

  min-width: 30px;
  height: 30px;

  padding: 0 8px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  border-radius: 20px;

  background: #e0e7ff;

  color: #4338ca;

  font-size: 12px;

  font-weight: 700;

}


.quiz-type-tab:nth-child(2) .quiz-type-count {

  background: #e0f2fe;

  color: #0369a1;

}


.quiz-type-tab.active .quiz-type-count {

  background: #4f46e5;

  color: #ffffff;

}


/* =========================================================
   PANES
========================================================= */

.quiz-type-pane {
  display: none;
}


.quiz-type-pane.active {
  display: block;
}


/* =========================================================
   PANEL
========================================================= */

.quiz-panel {

  overflow: hidden;

  background: #ffffff;

  border: 1px solid #e2e8f0;

  border-radius: 17px;

  box-shadow:
    0 4px 18px rgba(15,23,42,.05);

}


.quiz-panel-header {

  min-height: 76px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  padding: 15px 20px;

  border-bottom: 1px solid #eef2f7;

}


.quiz-panel-title {

  display: flex;

  align-items: center;

  gap: 11px;

}


.quiz-panel-title-icon {

  width: 40px;
  height: 40px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 11px;

  background: #eef2ff;

  color: #4f46e5;

}


.quiz-panel-title-icon.video {

  background: #e0f2fe;

  color: #0284c7;

}


.quiz-panel-title h2 {

  margin: 0 0 2px;

  color: #0f172a;

  font-size: 16px;

  font-weight: 750;

}


.quiz-panel-title p {

  margin: 0;

  color: #94a3b8;

  font-size: 11px;

}


.quiz-panel-count {

  padding: 7px 11px;

  border-radius: 8px;

  background: #eef2ff;

  color: #4338ca;

  font-size: 11px;

  font-weight: 700;

  white-space: nowrap;

}


.quiz-panel-count.video {

  background: #e0f2fe;

  color: #0369a1;

}


/* =========================================================
   TABLE
========================================================= */

.quiz-table-wrapper {

  width: 100%;

  overflow-x: auto;

}


.quiz-table {

  width: 100%;

  min-width: 920px;

  border-collapse: collapse;

}


.quiz-table thead th {

  padding: 13px 15px;

  background: #f8fafc;

  border-bottom: 1px solid #e2e8f0;

  color: #64748b;

  font-size: 11px;

  font-weight: 700;

  text-align: left;

  white-space: nowrap;

}


.quiz-table thead th:first-child {

  padding-left: 20px;

}


.quiz-table tbody td {

  padding: 16px 15px;

  border-bottom: 1px solid #f1f5f9;

  color: #475569;

