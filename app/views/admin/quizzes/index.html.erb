<div class="container-fluid py-4">

  <!-- ==================================================
       HEADER
  ================================================== -->

  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

    <div>
      <div class="text-muted small mb-2">
        Admin Panel / Courses / Quizzes
      </div>

      <h2 class="fw-bold mb-1">
        <i class="fas fa-clipboard-question text-primary me-2"></i>
        Course Quizzes
      </h2>

      <p class="text-muted mb-0">
        Manage quizzes for
        <strong><%= @course.Course_name %></strong>
      </p>
    </div>


    <div class="d-flex gap-2">

      <%= link_to admin_course_path(@course),
                  class: "btn btn-outline-secondary" do %>

        <i class="fas fa-arrow-left me-1"></i>
        Back to Course

      <% end %>


      <%= link_to new_admin_course_quiz_path(@course),
                  class: "btn btn-primary" do %>

        <i class="fas fa-plus me-1"></i>
        Create Quiz

      <% end %>

    </div>

  </div>


  <!-- ==================================================
       SUMMARY
  ================================================== -->

  <div class="row g-3 mb-4">

    <div class="col-md-4">

      <div class="card border-0 shadow-sm rounded-4 summary-card">

        <div class="card-body">

          <div class="d-flex justify-content-between align-items-center">

            <div>

              <small class="text-muted">
                Total Quizzes
              </small>

              <h3 class="fw-bold mb-0">
                <%= @quizzes.count %>
              </h3>

            </div>

            <div class="summary-icon bg-primary-subtle text-primary">
              <i class="fas fa-clipboard-question"></i>
            </div>

          </div>

        </div>

      </div>

    </div>


    <div class="col-md-4">

      <div class="card border-0 shadow-sm rounded-4 summary-card">

        <div class="card-body">

          <div class="d-flex justify-content-between align-items-center">

            <div>

              <small class="text-muted">
                Active Quizzes
              </small>

              <h3 class="fw-bold mb-0">

                <%= @quizzes.count { |quiz| quiz.status == "Active" } %>

              </h3>

            </div>

            <div class="summary-icon bg-success-subtle text-success">
              <i class="fas fa-circle-check"></i>
            </div>

          </div>

        </div>

      </div>

    </div>


    <div class="col-md-4">

      <div class="card border-0 shadow-sm rounded-4 summary-card">

        <div class="card-body">

          <div class="d-flex justify-content-between align-items-center">

            <div>

              <small class="text-muted">
                Total Questions
              </small>

              <h3 class="fw-bold mb-0">

                <%= @quizzes.sum { |quiz| quiz.questions.size } %>

              </h3>

            </div>

            <div class="summary-icon bg-warning-subtle text-warning">
              <i class="fas fa-circle-question"></i>
            </div>

          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- ==================================================
       QUIZ LIST
  ================================================== -->

  <% if @quizzes.any? %>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

      <div class="card-header bg-white border-0 py-3">

        <div class="d-flex justify-content-between align-items-center">

          <div>

            <h5 class="fw-bold mb-1">
              <i class="fas fa-list-check text-primary me-2"></i>
              All Quizzes
            </h5>

            <small class="text-muted">
              Manage quizzes and their questions
            </small>

          </div>

          <span class="badge bg-primary-subtle text-primary px-3 py-2">
            <%= @quizzes.count %> Quiz<%= @quizzes.count == 1 ? "" : "zes" %>
          </span>

        </div>

      </div>


      <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

          <thead class="table-light">

            <tr>

              <th class="ps-4">
                #
              </th>

              <th>
                Quiz
              </th>

              <th>
                Video
              </th>

              <th>
                Questions
              </th>

              <th>
                Time
              </th>

              <th>
                Passing
              </th>

              <th>
                Status
              </th>

              <th class="text-end pe-4">
                Actions
              </th>

            </tr>

          </thead>


          <tbody>

            <% @quizzes.each_with_index do |quiz, index| %>

              <tr>

                <!-- NUMBER -->

                <td class="ps-4">

                  <span class="quiz-number">
                    <%= index + 1 %>
                  </span>

                </td>


                <!-- QUIZ -->

                <td>

                  <div class="fw-bold">
                    <%= quiz.title %>
                  </div>

                  <% if quiz.description.present? %>

                    <small class="text-muted">

                      <%= truncate(
                            quiz.description,
                            length: 70
                          ) %>

                    </small>

                  <% end %>

                </td>


                <!-- VIDEO -->

                <td>

                  <% if quiz.video.present? %>

                    <span class="badge bg-info-subtle text-info">

                      <i class="fas fa-video me-1"></i>

                      <%= truncate(
                            quiz.video.title,
                            length: 35
                          ) %>

                    </span>

                  <% else %>

                    <span class="text-muted">
                      Course Quiz
                    </span>

                  <% end %>

                </td>


                <!-- QUESTIONS -->

                <td>

                  <span class="badge bg-primary-subtle text-primary">

                    <%= quiz.questions.size %>

                    <%= quiz.questions.size == 1 ? "Question" : "Questions" %>

                  </span>

                </td>


                <!-- TIME -->

                <td>

                  <i class="fas fa-clock text-secondary me-1"></i>

                  <%= quiz.time_limit %> min

                </td>


                <!-- PASSING -->

                <td>

                  <strong>
                    <%= quiz.passing_percentage %>%
                  </strong>

                </td>


                <!-- STATUS -->

                <td>

                  <% if quiz.status == "Active" %>

                    <span class="badge bg-success">

                      <i class="fas fa-check me-1"></i>
                      Active

                    </span>

                  <% else %>

                    <span class="badge bg-secondary">

                      <i class="fas fa-pause me-1"></i>
                      <%= quiz.status %>

                    </span>

                  <% end %>

                </td>


                <!-- ACTIONS -->

                <td class="text-end pe-4">

                  <div class="d-flex justify-content-end gap-2">


                    <!-- VIEW -->

                    <%= link_to admin_course_quiz_path(
                                  @course,
                                  quiz
                                ),
                                class: "btn btn-sm btn-outline-primary",
                                title: "View Quiz" do %>

                      <i class="fas fa-eye"></i>

                    <% end %>


                    <!-- EDIT -->

                    <%= link_to edit_admin_course_quiz_path(
                                  @course,
                                  quiz
                                ),
                                class: "btn btn-sm btn-outline-warning",
                                title: "Edit Quiz" do %>

                      <i class="fas fa-pen"></i>

                    <% end %>


                    <!-- DELETE -->

                    <%= button_to admin_course_quiz_path(
                                    @course,
                                    quiz
                                  ),
                                  method: :delete,
                                  class: "btn btn-sm btn-outline-danger",
                                  form: {
                                    data: {
                                      turbo_confirm:
                                        "Are you sure you want to delete this quiz?"
                                    }
                                  },
                                  title: "Delete Quiz" do %>

                      <i class="fas fa-trash"></i>

                    <% end %>

                  </div>

                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

      </div>

    </div>


  <% else %>


    <!-- ==================================================
         EMPTY STATE
    ================================================== -->

    <div class="card border-0 shadow-sm rounded-4">

      <div class="card-body text-center py-5">

        <div class="empty-icon mb-3">

          <i class="fas fa-clipboard-question"></i>

        </div>

        <h4 class="fw-bold">
          No Quizzes Yet
        </h4>

        <p class="text-muted mb-4">

          This course does not have any quizzes yet.

        </p>


        <%= link_to new_admin_course_quiz_path(@course),
                    class: "btn btn-primary btn-lg" do %>

          <i class="fas fa-plus me-2"></i>

          Create First Quiz

        <% end %>

      </div>

    </div>


  <% end %>

</div>


<!-- ==================================================
     DESIGN
================================================== -->

<style>

.summary-card {

  transition: all 0.2s ease;

}


.summary-card:hover {

  transform: translateY(-3px);

  box-shadow:
    0 8px 25px rgba(0,0,0,0.08) !important;

}


.summary-icon {

  width: 48px;
  height: 48px;

  border-radius: 14px;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 20px;

}


.quiz-number {

  width: 34px;
  height: 34px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  border-radius: 10px;

  background: rgba(63,82,251,0.10);

  color: #3f52fb;

  font-weight: 700;

}


.table > :not(caption) > * > * {

  padding-top: 16px;
  padding-bottom: 16px;

}


.table tbody tr {

  transition: background 0.15s ease;

}


.table tbody tr:hover {

  background: rgba(63,82,251,0.035);

}


.empty-icon {

  width: 80px;
  height: 80px;

  margin: 0 auto;

  border-radius: 50%;

  display: flex;

  align-items: center;

  justify-content: center;

  background: rgba(63,82,251,0.10);

  color: #3f52fb;

  font-size: 34px;

}


</style>