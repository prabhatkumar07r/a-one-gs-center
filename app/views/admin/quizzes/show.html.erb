<% content_for :show_layout, true %>

<div class="admin-quiz-show-page">

  <!-- =====================================================
       HEADER
  ====================================================== -->

  <div class="quiz-page-header">

    <div>
      <div class="breadcrumb-text">
        Admin Panel / Courses / Quizzes / Quiz Details
      </div>

      <h2 class="page-title">
        <i class="fas fa-clipboard-question me-2"></i>
        <%= @quiz.title %>
      </h2>

      <p class="page-subtitle">
        Course:
        <strong>
          <%= @course.Course_name %>
        </strong>
      </p>
    </div>


    <div class="header-actions">

      <%= link_to admin_course_quizzes_path(@course),
                  class: "btn btn-light quiz-btn" do %>

        <i class="fas fa-arrow-left me-1"></i>
        Back to Quizzes

      <% end %>


      <%= link_to edit_admin_course_quiz_path(@course, @quiz),
                  class: "btn btn-warning quiz-btn" do %>

        <i class="fas fa-pen me-1"></i>
        Edit Quiz

      <% end %>

    </div>

  </div>


  <!-- =====================================================
       QUIZ INFORMATION
  ====================================================== -->

  <div class="row g-4 mb-4">


    <!-- DESCRIPTION -->

    <div class="col-lg-8">

      <div class="quiz-card h-100">

        <div class="quiz-card-header">

          <div>
            <h5>
              <i class="fas fa-circle-info me-2"></i>
              Quiz Information
            </h5>

            <small>
              Basic information about this quiz
            </small>
          </div>

        </div>


        <div class="quiz-card-body">

          <% if @quiz.description.present? %>

            <div class="description-box">

              <h6>
                Description
              </h6>

              <p>
                <%= simple_format(@quiz.description) %>
              </p>

            </div>

          <% else %>

            <div class="empty-description">

              <i class="fas fa-align-left"></i>

              <span>
                No description has been added for this quiz.
              </span>

            </div>

          <% end %>


          <!-- VIDEO -->

          <div class="quiz-info-row">

            <div class="info-label">
              <i class="fas fa-video me-2"></i>
              Quiz Type
            </div>

            <div class="info-value">

              <% if @quiz.video.present? %>

                <span class="badge bg-info-subtle text-info px-3 py-2">

                  <i class="fas fa-video me-1"></i>

                  Video-wise Quiz

                </span>

              <% else %>

                <span class="badge bg-primary-subtle text-primary px-3 py-2">

                  <i class="fas fa-graduation-cap me-1"></i>

                  Course Level Quiz

                </span>

              <% end %>

            </div>

          </div>


          <% if @quiz.video.present? %>

            <div class="quiz-info-row">

              <div class="info-label">
                <i class="fas fa-film me-2"></i>
                Video
              </div>

              <div class="info-value">

                <strong>
                  <%= @quiz.video.title %>
                </strong>

              </div>

            </div>

          <% end %>


          <!-- CREATED -->

          <div class="quiz-info-row">

            <div class="info-label">
              <i class="fas fa-calendar me-2"></i>
              Created
            </div>

            <div class="info-value">

              <%= @quiz.created_at.strftime("%d %b %Y, %I:%M %p") %>

            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- SETTINGS -->

    <div class="col-lg-4">

      <div class="quiz-card h-100">

        <div class="quiz-card-header">

          <div>

            <h5>
              <i class="fas fa-sliders me-2"></i>
              Quiz Settings
            </h5>

            <small>
              Quiz configuration
            </small>

          </div>

        </div>


        <div class="quiz-card-body">

          <!-- TIME -->

          <div class="setting-box">

            <div class="setting-icon bg-primary-subtle text-primary">

              <i class="fas fa-clock"></i>

            </div>

            <div>

              <small>
                Time Limit
              </small>

              <strong>
                <%= @quiz.time_limit %> minutes
              </strong>

            </div>

          </div>


          <!-- PASSING -->

          <div class="setting-box">

            <div class="setting-icon bg-warning-subtle text-warning">

              <i class="fas fa-percent"></i>

            </div>

            <div>

              <small>
                Passing Percentage
              </small>

              <strong>
                <%= @quiz.passing_percentage %>%
              </strong>

            </div>

          </div>


          <!-- STATUS -->

          <div class="setting-box">

            <% if @quiz.status == "Active" %>

              <div class="setting-icon bg-success-subtle text-success">

                <i class="fas fa-check-circle"></i>

              </div>

              <div>

                <small>
                  Status
                </small>

                <strong class="text-success">
                  Active
                </strong>

              </div>

            <% else %>

              <div class="setting-icon bg-secondary-subtle text-secondary">

                <i class="fas fa-pause-circle"></i>

              </div>

              <div>

                <small>
                  Status
                </small>

                <strong class="text-secondary">
                  <%= @quiz.status %>
                </strong>

              </div>

            <% end %>

          </div>


          <!-- QUESTIONS -->

          <div class="setting-box">

            <div class="setting-icon bg-info-subtle text-info">

              <i class="fas fa-circle-question"></i>

            </div>

            <div>

              <small>
                Total Questions
              </small>

              <strong>
                <%= @questions.size %>
              </strong>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- =====================================================
       QUESTIONS HEADER
  ====================================================== -->

  <div class="questions-header">

    <div>

      <h4>

        <i class="fas fa-list-check text-primary me-2"></i>

        Questions

        <span class="question-count">
          <%= @questions.size %>
        </span>

      </h4>

      <p>
        Manage questions and answer options for this quiz.
      </p>

    </div>


    <!-- ADD QUESTION -->

      <%= link_to new_admin_course_quiz_question_path(@course, @quiz),
            class: "btn btn-primary add-question-btn" do %>

  <i class="fas fa-plus me-2"></i>
  Add Question

<% end %>

  </div>


  <!-- =====================================================
       QUESTIONS
  ====================================================== -->

  <% if @questions.any? %>

    <div class="questions-list">

      <% @questions.each_with_index do |question, index| %>

        <div class="question-card">


          <!-- QUESTION HEADER -->

          <div class="question-top">

            <div class="question-number">

              <%= index + 1 %>

            </div>


            <div class="question-content">

              <div class="question-title">

                <%= question.question_text %>

              </div>

              <% if question.respond_to?(:marks) && question.marks.present? %>

                <span class="question-marks">

                  <i class="fas fa-star me-1"></i>

                  <%= question.marks %> marks

                </span>

              <% end %>

            </div>


            <div class="question-actions">

                <%= link_to edit_admin_course_quiz_question_path(
                @course,
                @quiz,
                  question
                  ),
                class: "btn btn-outline-primary btn-sm" do %>

               <i class="fas fa-edit me-1"></i>
               Edit Question

              <% end %>


              <%= button_to "#",
                            method: :delete,
                            class: "btn btn-sm btn-outline-danger",
                            form: {
                              data: {
                                turbo_confirm:
                                  "Are you sure you want to delete this question?"
                              }
                            },
                            title: "Delete Question" do %>

                <i class="fas fa-trash"></i>

              <% end %>

            </div>

          </div>


          <!-- OPTIONS -->

          <% if question.options.any? %>

            <div class="options-container">

              <% question.options.each_with_index do |option, option_index| %>

                <div class="option-row
                  <%= 'correct-option' if option.respond_to?(:correct?) && option.correct? %>">


                  <div class="option-letter">

                    <%= (65 + option_index).chr %>

                  </div>


                  <div class="option-text">

                    <%= option.option_text %>

                  </div>


                  <% if option.respond_to?(:correct?) && option.correct? %>

                    <span class="correct-badge">

                      <i class="fas fa-check-circle me-1"></i>

                      Correct Answer

                    </span>

                  <% end %>

                </div>

              <% end %>

            </div>

          <% else %>

            <div class="no-options">

              <i class="fas fa-triangle-exclamation me-2"></i>

              No answer options have been added to this question.

            </div>

          <% end %>


        </div>

      <% end %>

    </div>


  <% else %>


    <!-- =====================================================
         EMPTY QUESTIONS
    ====================================================== -->

    <div class="empty-questions">

      <div class="empty-question-icon">

        <i class="fas fa-circle-question"></i>

      </div>

      <h4>
        No Questions Yet
      </h4>

      <p>
        This quiz has been created, but no questions have been
        added yet.
      </p>


      <%= link_to "#",
                  class: "btn btn-primary btn-lg" do %>

        <i class="fas fa-plus me-2"></i>

        Add First Question

      <% end %>

    </div>

  <% end %>


  <!-- =====================================================
       BOTTOM ACTIONS
  ====================================================== -->

  <div class="bottom-actions">

    <%= link_to admin_course_quizzes_path(@course),
                class: "btn btn-outline-secondary" do %>

      <i class="fas fa-arrow-left me-2"></i>

      Back to Quizzes

    <% end %>


    <%= link_to edit_admin_course_quiz_path(@course, @quiz),
                class: "btn btn-warning" do %>

      <i class="fas fa-pen me-2"></i>

      Edit Quiz

    <% end %>

  </div>

</div>


<!-- =========================================================
     DESIGN
========================================================= -->

<style>

.admin-quiz-show-page {

  padding: 30px;

  background: #f6f7fb;

  min-height: 100vh;

}


/* =========================================================
   HEADER
========================================================= */

.quiz-page-header {

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 20px;

  margin-bottom: 25px;

}


.breadcrumb-text {

  color: #8a8f98;

  font-size: 13px;

  margin-bottom: 8px;

}


.page-title {

  font-size: 28px;

  font-weight: 800;

  color: #20232a;

  margin: 0;

}


.page-subtitle {

  color: #737983;

  margin: 6px 0 0;

}


.header-actions {

  display: flex;

  gap: 10px;

  flex-wrap: wrap;

}


.quiz-btn {

  border-radius: 11px;

  padding: 10px 18px;

  font-weight: 700;

}


/* =========================================================
   CARD
========================================================= */

.quiz-card {

  background: #fff;

  border-radius: 20px;

  border: 1px solid #edf0f4;

  box-shadow: 0 5px 20px rgba(25, 35, 55, 0.06);

  overflow: hidden;

}


.quiz-card-header {

  display: flex;

  align-items: center;

  padding: 20px 22px;

  border-bottom: 1px solid #edf0f4;

}


.quiz-card-header h5 {

  margin: 0;

  font-weight: 800;

  color: #252932;

}


.quiz-card-header small {

  color: #8b9099;

}


.quiz-card-body {

  padding: 22px;

}


/* =========================================================
   DESCRIPTION
========================================================= */

.description-box {

  background: #f7f8fc;

  border-radius: 14px;

  padding: 17px;

  margin-bottom: 18px;

}


.description-box h6 {

  font-weight: 800;

  margin-bottom: 8px;

}


.description-box p {

  margin: 0;

  color: #656b75;

}


.empty-description {

  display: flex;

  align-items: center;

  gap: 10px;

  color: #9298a1;

  background: #f8f9fb;

  border-radius: 13px;

  padding: 15px;

  margin-bottom: 18px;

}


/* =========================================================
   INFO
========================================================= */

.quiz-info-row {

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 15px;

  padding: 13px 0;

  border-bottom: 1px solid #f0f1f4;

}


.quiz-info-row:last-child {

  border-bottom: none;

}


.info-label {

  color: #777d87;

  font-weight: 600;

}


.info-value {

  text-align: right;

  color: #252932;

}


/* =========================================================
   SETTINGS
========================================================= */

.setting-box {

  display: flex;

  align-items: center;

  gap: 14px;

  padding: 14px;

  border-radius: 14px;

  background: #f8f9fc;

  margin-bottom: 12px;

}


.setting-box:last-child {

  margin-bottom: 0;

}


.setting-icon {

  width: 44px;

  height: 44px;

  border-radius: 12px;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 18px;

}


.setting-box small {

  display: block;

  color: #8b9099;

  margin-bottom: 3px;

}


.setting-box strong {

  display: block;

  color: #252932;

  font-size: 16px;

}


/* =========================================================
   QUESTIONS HEADER
========================================================= */

.questions-header {

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 20px;

  margin: 30px 0 18px;

}


.questions-header h4 {

  font-weight: 800;

  margin: 0;

}


.questions-header p {

  color: #858b94;

  margin: 5px 0 0;

}


.question-count {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-width: 32px;

  height: 28px;

  padding: 0 9px;

  border-radius: 9px;

  background: rgba(63,82,251,0.10);

  color: #3f52fb;

  font-size: 14px;

  vertical-align: middle;

}


.add-question-btn {

  border-radius: 11px;

  padding: 11px 18px;

  font-weight: 700;

}


/* =========================================================
   QUESTION CARD
========================================================= */

.questions-list {

  display: flex;

  flex-direction: column;

  gap: 18px;

}


.question-card {

  background: #fff;

  border: 1px solid #edf0f4;

  border-radius: 18px;

  overflow: hidden;

  box-shadow: 0 5px 18px rgba(25,35,55,0.05);

}


.question-top {

  display: flex;

  align-items: flex-start;

  gap: 15px;

  padding: 20px;

}


.question-number {

  min-width: 40px;

  height: 40px;

  border-radius: 12px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: rgba(63,82,251,0.10);

  color: #3f52fb;

  font-weight: 800;

}


.question-content {

  flex: 1;

}


.question-title {

  color: #252932;

  font-size: 16px;

  font-weight: 700;

  line-height: 1.5;

}


.question-marks {

  display: inline-block;

  margin-top: 7px;

  font-size: 12px;

  color: #8b9099;

}


.question-actions {

  display: flex;

  gap: 7px;

}


/* =========================================================
   OPTIONS
========================================================= */

.options-container {

  padding: 0 20px 20px 75px;

}


.option-row {

  display: flex;

  align-items: center;

  gap: 12px;

  padding: 12px 14px;

  margin-top: 8px;

  border: 1px solid #edf0f4;

  border-radius: 11px;

  background: #fafbfc;

}


.option-letter {

  min-width: 30px;

  height: 30px;

  border-radius: 8px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #eef0f5;

  color: #606670;

  font-weight: 800;

}


.option-text {

  flex: 1;

  color: #454a53;

}


.correct-option {

  background: #f0faf4;

  border-color: #b8e3c8;

}


.correct-option .option-letter {

  background: #d9f3e2;

  color: #198754;

}


.correct-badge {

  color: #198754;

  font-size: 12px;

  font-weight: 700;

  white-space: nowrap;

}


.no-options {

  margin: 0 20px 20px 75px;

  padding: 13px;

  border-radius: 11px;

  background: #fff8e6;

  color: #997515;

  font-size: 13px;

}


/* =========================================================
   EMPTY
========================================================= */

.empty-questions {

  background: #fff;

  border: 1px solid #edf0f4;

  border-radius: 20px;

  text-align: center;

  padding: 65px 25px;

  box-shadow: 0 5px 18px rgba(25,35,55,0.05);

}


.empty-question-icon {

  width: 82px;

  height: 82px;

  margin: 0 auto 18px;

  border-radius: 50%;

  display: flex;

  align-items: center;

  justify-content: center;

  background: rgba(63,82,251,0.10);

  color: #3f52fb;

  font-size: 34px;

}


.empty-questions h4 {

  font-weight: 800;

}


.empty-questions p {

  color: #858b94;

  margin-bottom: 25px;

}


/* =========================================================
   BOTTOM
========================================================= */

.bottom-actions {

  display: flex;

  justify-content: space-between;

  margin-top: 25px;

  padding-top: 20px;

  border-top: 1px solid #e6e8ed;

}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 767px) {

  .admin-quiz-show-page {

    padding: 15px;

  }


  .quiz-page-header {

    flex-direction: column;

    align-items: flex-start;

  }


  .header-actions {

    width: 100%;

  }


  .quiz-btn {

    flex: 1;

  }


  .questions-header {

    flex-direction: column;

    align-items: flex-start;

  }


  .add-question-btn {

    width: 100%;

  }


  .question-top {

    flex-wrap: wrap;

  }


  .question-content {

    min-width: calc(100% - 55px);

  }


  .question-actions {

    width: 100%;

    margin-left: 55px;

  }


  .options-container {

    padding: 0 15px 15px;

  }


  .no-options {

    margin: 0 15px 15px;

  }


  .quiz-info-row {

    align-items: flex-start;

    flex-direction: column;

  }


  .info-value {

    text-align: left;

  }


  .bottom-actions {

    flex-direction: column;

    gap: 10px;

  }


  .bottom-actions .btn {

    width: 100%;

  }

}

</style>