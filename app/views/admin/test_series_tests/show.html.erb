<style nonce="<%= content_security_policy_nonce %>">

.admin-ts-page {
  color: #292938;
}

body:not(.admin-ts-dark):has(.admin-ts-page),
body:not(.admin-ts-dark):has(.admin-ts-page) main,
body:not(.admin-ts-dark):has(.admin-ts-page) .main-content,
body:not(.admin-ts-dark):has(.admin-ts-page) .admin-main,
body:not(.admin-ts-dark):has(.admin-ts-page) .content-wrapper {
  background: #f3f5ff !important;
}

body.admin-ts-dark:has(.admin-ts-page),
body.admin-ts-dark:has(.admin-ts-page) main,
body.admin-ts-dark:has(.admin-ts-page) .main-content,
body.admin-ts-dark:has(.admin-ts-page) .admin-main,
body.admin-ts-dark:has(.admin-ts-page) .content-wrapper {
  background: #0e1222 !important;
}

.admin-ts-info-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 18px;
}

.admin-ts-info-card {
  padding: 12px 14px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 9px;
  box-shadow: 0 2px 8px rgba(25, 25, 50, .025);
}

.admin-ts-info-card span {
  display: block;
  margin-bottom: 4px;
  color: #7b8194;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
}

.admin-ts-info-card strong {
  display: block;
  color: #292938;
  font-size: 14px;
  font-weight: 750;
  line-height: 1.3;
}

.admin-ts-question-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin: 12px 0 10px;
}

.admin-ts-filter-left {
  display: flex;
  align-items: center;
  gap: 7px;
  flex-wrap: wrap;
  min-width: 0;
}

.admin-ts-filter-search {
  position: relative;
  width: 250px;
}

.admin-ts-filter-search i {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  color: #8b91a3;
  font-size: 11px;
  pointer-events: none;
}

.admin-ts-filter-search input {
  width: 100%;
  height: 34px;
  padding: 6px 10px 6px 30px;
  color: #292938;
  background: #ffffff;
  border: 1px solid #dfe3eb;
  border-radius: 7px;
  outline: none;
  font-family: inherit;
  font-size: 10px;
  transition: .18s ease;
}

.admin-ts-filter-search input:focus {
  border-color: #8b7cf6;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, .09);
}

.admin-ts-filter-select {
  height: 34px;
  padding: 6px 28px 6px 10px;
  color: #4b5563;
  background: #ffffff;
  border: 1px solid #dfe3eb;
  border-radius: 7px;
  outline: none;
  font-family: inherit;
  font-size: 10px;
  font-weight: 650;
  cursor: pointer;
}

.admin-ts-filter-select:focus {
  border-color: #8b7cf6;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, .09);
}

.admin-ts-question-count {
  color: #73798c;
  font-size: 10px;
  font-weight: 650;
  white-space: nowrap;
}

.admin-ts-question-list {
  display: flex;
  flex-direction: column;
  gap: 7px;
  width: 100%;
}

.admin-ts-question-card {
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #e1e4ec;
  border-radius: 9px;
  box-shadow: 0 2px 7px rgba(25, 25, 50, .025);
  transition:
    border-color .16s ease,
    box-shadow .16s ease,
    transform .16s ease;
}

.admin-ts-question-card:hover {
  border-color: #d3ceff;
  box-shadow: 0 4px 12px rgba(25, 25, 50, .045);
}

.admin-ts-question-main {
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) auto;
  align-items: start;
  gap: 10px;
  padding: 9px 10px;
}

.admin-ts-question-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 31px;
  min-height: 28px;
  margin-top: 1px;
  color: #4f46e5;
  font-size: 10px;
  font-weight: 800;
  white-space: nowrap;
}

.admin-ts-question-content {
  min-width: 0;
}

.admin-ts-question-heading {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  min-width: 0;
  margin-bottom: 5px;
}

.admin-ts-question-text {
  min-width: 0;
  color: #252536;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.45;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.admin-ts-question-hindi {
  margin-top: 2px;
  color: #73798c;
  font-size: 10px;
  font-weight: 500;
  line-height: 1.4;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.admin-ts-mark {
  flex: 0 0 auto;
  padding: 3px 6px;
  color: #626b7d;
  background: #f7f8fb;
  border: 1px solid #e3e6ed;
  border-radius: 5px;
  font-size: 8px;
  font-weight: 700;
  white-space: nowrap;
}

.admin-ts-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 5px 7px;
  margin-top: 5px;
}

.admin-ts-option {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 6px;
  min-height: 29px;
  padding: 4px 7px;
  color: #596174;
  background: #f8f9fc;
  border: 1px solid #e4e7ee;
  border-radius: 5px;
  font-size: 9px;
  line-height: 1.35;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.admin-ts-option > strong {
  flex: 0 0 auto;
  color: #6366f1;
  font-size: 9px;
  font-weight: 800;
}

.admin-ts-option > span:not(.admin-ts-correct) {
  min-width: 0;
}

.admin-ts-option.correct {
  color: #166534;
  background: #f3fff6;
  border-color: #b9e8c2;
}

.admin-ts-option.correct > strong {
  color: #15803d;
}

.admin-ts-correct {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  padding: 2px 5px;
  color: #15803d;
  background: #ecfdf3;
  border: 1px solid #b9e8c2;
  border-radius: 4px;
  font-size: 7px;
  font-weight: 800;
  white-space: nowrap;
}

.admin-ts-question-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  padding: 7px 9px;
  background: #fafbfc;
  border-top: 1px solid #edf0f4;
}

.admin-ts-question-actions form {
  margin: 0;
  padding: 0;
}

.admin-ts-question-actions .admin-ts-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  min-height: 27px;
  padding: 4px 8px;
  border-radius: 5px;
  font-family: inherit;
  font-size: 8px;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
  transition: .16s ease;
}

.admin-ts-question-actions .admin-ts-action.view {
  color: #2563eb;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
}

.admin-ts-question-actions .admin-ts-action.view:hover {
  color: #1d4ed8;
  background: #dbeafe;
}

.admin-ts-question-actions .admin-ts-action.edit {
  color: #4f46e5;
  background: #f5f3ff;
  border: 1px solid #ddd6fe;
}

.admin-ts-question-actions .admin-ts-action.edit:hover {
  color: #4338ca;
  background: #ede9fe;
}

.admin-ts-question-actions .admin-ts-action.delete {
  color: #dc2626;
  background: #fff7f7;
  border: 1px solid #fecaca;
  cursor: pointer;
}

.admin-ts-question-actions .admin-ts-action.delete:hover {
  color: #b91c1c;
  background: #fef2f2;
}

.admin-ts-no-results {
  display: none;
  padding: 28px 20px;
  color: #7b8194;
  background: #ffffff;
  border: 1px dashed #d9dce5;
  border-radius: 9px;
  text-align: center;
  font-size: 11px;
}

.admin-ts-no-results i {
  display: block;
  margin-bottom: 7px;
  color: #8b7cf6;
  font-size: 22px;
}

.admin-ts-empty {
  padding: 45px 20px;
  text-align: center;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
}

.admin-ts-empty i {
  display: block;
  margin-bottom: 10px;
  color: #6366f1;
  font-size: 32px;
}

.admin-ts-empty h3 {
  margin: 0 0 5px;
  color: #292938;
  font-size: 16px;
}

.admin-ts-empty p {
  margin: 0;
  color: #7b8194;
  font-size: 11px;
}

.admin-ts-add-question {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 12px !important;
  color: #ffffff !important;
  background: linear-gradient(135deg, #7c3aed, #4f46e5) !important;
  border: 1px solid #6d28d9 !important;
  border-radius: 7px !important;
  font-size: 10px;
  font-weight: 700;
  text-decoration: none !important;
  box-shadow: 0 4px 10px rgba(79, 70, 229, .16);
}

.admin-ts-add-question:hover {
  color: #ffffff !important;
  background: linear-gradient(135deg, #6d28d9, #4338ca) !important;
}

.admin-ts-header-actions {
  display: flex;
  align-items: center;
  gap: 7px;
}

.admin-ts-edit-test-btn,
.admin-ts-back-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 34px;
  padding: 7px 11px;
  border-radius: 7px;
  font-size: 10px;
  font-weight: 700;
  text-decoration: none !important;
}

.admin-ts-edit-test-btn {
  color: #ffffff !important;
  background: linear-gradient(135deg, #7c3aed, #4f46e5) !important;
  border: 1px solid #6d28d9 !important;
}

.admin-ts-back-btn {
  color: #4b5563 !important;
  background: #ffffff !important;
  border: 1px solid #dfe3eb !important;
}

.admin-ts-back-btn:hover {
  color: #4f46e5 !important;
  background: #f5f3ff !important;
}

.admin-ts-theme-toggle {
  width: 34px !important;
  height: 34px !important;
  min-width: 34px;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
  color: #5b21b6 !important;
  background: #ffffff !important;
  border: 1px solid #dfe3eb !important;
  border-radius: 7px !important;
  font-size: 12px;
  cursor: pointer;
}

body.admin-ts-dark .admin-ts-page {
  color: #f3f4f6;
}

body.admin-ts-dark .admin-ts-info-card,
body.admin-ts-dark .admin-ts-question-card,
body.admin-ts-dark .admin-ts-empty,
body.admin-ts-dark .admin-ts-no-results {
  background: #191e33 !important;
  border-color: #303852 !important;
  box-shadow: 0 4px 14px rgba(0, 0, 0, .16);
}

body.admin-ts-dark .admin-ts-info-card span,
body.admin-ts-dark .admin-ts-question-count {
  color: #929ab3;
}

body.admin-ts-dark .admin-ts-info-card strong {
  color: #f4f5fb;
}

body.admin-ts-dark .admin-ts-filter-search input,
body.admin-ts-dark .admin-ts-filter-select {
  color: #eef1f8;
  background: #151a2c;
  border-color: #343c58;
}

body.admin-ts-dark .admin-ts-filter-search input::placeholder {
  color: #737c96;
}

body.admin-ts-dark .admin-ts-filter-search i {
  color: #8d96ae;
}

body.admin-ts-dark .admin-ts-question-card:hover {
  border-color: #5146a8 !important;
}

body.admin-ts-dark .admin-ts-question-number {
  color: #a78bfa;
}

body.admin-ts-dark .admin-ts-question-text {
  color: #f1f3f8;
}

body.admin-ts-dark .admin-ts-question-hindi {
  color: #a8afc2;
}

body.admin-ts-dark .admin-ts-mark {
  color: #b4bbce;
  background: #20263c;
  border-color: #39415d;
}

body.admin-ts-dark .admin-ts-option {
  color: #c5cada;
  background: #151a2c;
  border-color: #343c58;
}

body.admin-ts-dark .admin-ts-option > strong {
  color: #a78bfa;
}

body.admin-ts-dark .admin-ts-option.correct {
  color: #b7efc6;
  background: #12271d;
  border-color: #28623a;
}

body.admin-ts-dark .admin-ts-option.correct > strong {
  color: #4ade80;
}

body.admin-ts-dark .admin-ts-correct {
  color: #86efac;
  background: #153522;
  border-color: #28623a;
}

body.admin-ts-dark .admin-ts-question-actions {
  background: #151a2c;
  border-top-color: #303852;
}

body.admin-ts-dark .admin-ts-question-actions .admin-ts-action.view {
  color: #93c5fd;
  background: #172641;
  border-color: #315b91;
}

body.admin-ts-dark .admin-ts-question-actions .admin-ts-action.edit {
  color: #c4b5fd;
  background: #252044;
  border-color: #5146a8;
}

body.admin-ts-dark .admin-ts-question-actions .admin-ts-action.delete {
  color: #fca5a5;
  background: #351b22;
  border-color: #71313d;
}

body.admin-ts-dark .admin-ts-header h1 {
  color: #f5f7ff;
}

body.admin-ts-dark .admin-ts-header p,
body.admin-ts-dark .admin-ts-breadcrumb {
  color: #a7aec2;
}

body.admin-ts-dark .admin-ts-breadcrumb a {
  color: #a78bfa;
}

body.admin-ts-dark .admin-ts-theme-toggle {
  color: #fbbf24 !important;
  background: #191e33 !important;
  border-color: #3b4565 !important;
}

body.admin-ts-dark .admin-ts-empty i {
  color: #a78bfa;
}

body.admin-ts-dark .admin-ts-empty h3 {
  color: #f4f5fb;
}

body.admin-ts-dark .admin-ts-empty p,
body.admin-ts-dark .admin-ts-no-results {
  color: #9ca5bc;
}

@media (max-width: 950px) {
  .admin-ts-info-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 800px) {
  .admin-ts-question-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .admin-ts-filter-left {
    width: 100%;
  }

  .admin-ts-filter-search {
    width: 100%;
  }

  .admin-ts-filter-select {
    flex: 1;
  }

  .admin-ts-question-main {
    grid-template-columns: 30px minmax(0, 1fr);
  }

  .admin-ts-question-actions {
    grid-column: 1 / -1;
    justify-content: flex-start;
  }
}

@media (max-width: 600px) {
  .admin-ts-info-grid {
    grid-template-columns: 1fr 1fr;
    gap: 7px;
  }

  .admin-ts-info-card {
    padding: 10px;
  }

  .admin-ts-info-card strong {
    font-size: 12px;
  }

  .admin-ts-question-main {
    grid-template-columns: 27px minmax(0, 1fr);
    gap: 7px;
    padding: 8px;
  }

  .admin-ts-question-text {
    font-size: 11px;
  }

  .admin-ts-question-hindi {
    font-size: 9px;
  }

  .admin-ts-options {
    grid-template-columns: 1fr;
  }

  .admin-ts-question-actions {
    padding: 6px 8px;
  }

  .admin-ts-question-actions .admin-ts-action {
    flex: 1;
  }

  .admin-ts-header-actions {
    flex-wrap: wrap;
  }
}

@media (max-width: 400px) {
  .admin-ts-info-grid {
    grid-template-columns: 1fr;
  }

  .admin-ts-filter-left {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .admin-ts-filter-search {
    grid-column: 1 / -1;
  }

  .admin-ts-question-actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .admin-ts-question-actions .admin-ts-action {
    width: 100%;
  }
}

</style>

<div class="admin-ts-page">

  <div class="admin-ts-header">

    <div>

      <div class="admin-ts-breadcrumb">
        <%= link_to @test_series.title,
                    admin_test_series_path(@test_series) %>
        /
        <%= @test_series_test.title %>
      </div>

      <h1>
        <%= @test_series_test.title %>
      </h1>

      <p>
        <%= @test_series_test.description.presence ||
            "No description available." %>
      </p>

    </div>

    <div class="admin-ts-header-actions">

      <%= link_to edit_admin_test_series_test_path(
                    @test_series,
                    @test_series_test
                  ),
                  class: "admin-ts-edit-test-btn" do %>
        <i class="fas fa-edit"></i>
        Edit Test
      <% end %>

      <%= link_to admin_test_series_path(@test_series),
                  class: "admin-ts-back-btn" do %>
        <i class="fas fa-arrow-left"></i>
        Back
      <% end %>

      <button type="button"
              class="admin-ts-theme-toggle"
              id="adminTsThemeToggle"
              aria-label="Switch to night mode"
              title="Switch to night mode">
        <i class="fas fa-moon"
           id="adminTsThemeIcon"></i>
      </button>

    </div>

  </div>

  <div class="admin-ts-info-grid">

    <div class="admin-ts-info-card">
      <span>Test Number</span>
      <strong>
        <%= @test_series_test.test_number %>
      </strong>
    </div>

    <div class="admin-ts-info-card">
      <span>Duration</span>
      <strong>
        <%= @test_series_test.duration %> Minutes
      </strong>
    </div>

    <div class="admin-ts-info-card">
      <span>Questions</span>
      <strong>
        <%= @questions.count %>
      </strong>
    </div>

    <div class="admin-ts-info-card">
      <span>Status</span>
      <strong>
        <%= @test_series_test.status %>
      </strong>
    </div>

  </div>

  <div class="admin-ts-section-header">

    <%= link_to new_admin_test_series_test_question_path(
                  @test_series,
                  @test_series_test
                ),
                class: "admin-ts-btn admin-ts-add-question" do %>
      <i class="fas fa-plus"></i>
      Add Question
    <% end %>

    <div>
      <h2>Questions</h2>
      <p>
        <%= @questions.count %> question(s)
      </p>
    </div>

  </div>

  <% if @questions.any? %>

    <div class="admin-ts-question-toolbar">

      <div class="admin-ts-filter-left">

        <div class="admin-ts-filter-search">

          <i class="fas fa-search"></i>

          <input
            type="search"
            id="adminQuestionSearch"
            placeholder="Search question..."
            autocomplete="off">

        </div>

        <select
          id="adminQuestionLanguage"
          class="admin-ts-filter-select">

          <option value="all">All Languages</option>
          <option value="english">English</option>
          <option value="hindi">Hindi</option>
          <option value="both">English + Hindi</option>

        </select>

        <select
          id="adminQuestionOrder"
          class="admin-ts-filter-select">

          <option value="asc">Old → New</option>
          <option value="desc">New → Old</option>

        </select>

      </div>

      <div class="admin-ts-question-count">

        <span id="adminQuestionVisibleCount">
          <%= @questions.count %>
        </span>

        of

        <%= @questions.count %>

        Questions

      </div>

    </div>

    <div
      class="admin-ts-question-list"
      id="adminQuestionList">

      <% @questions.each_with_index do |question, index| %>

        <%
          english_text = question.question_text.to_s
          hindi_text = question.question_text_hindi.to_s

          english_has_text =
            english_text.match?(/[A-Za-z]/)

          hindi_has_text =
            hindi_text.match?(/[\u0900-\u097F]/)

          main_hindi =
            english_text.match?(/[\u0900-\u097F]/)

          main_english =
            english_text.match?(/[A-Za-z]/)

          if english_has_text && hindi_has_text
            question_language = "both"
          elsif hindi_has_text || main_hindi
            question_language = "hindi"
          elsif english_has_text || main_english
            question_language = "english"
          else
            question_language = "other"
          end

          search_text = [
            question.question_text,
            question.question_text_hindi,
            question.marks,
            index + 1,
            question.test_series_options.map(&:option_text)
          ].flatten.compact.join(" ").downcase
        %>

        <div
          class="admin-ts-question-card"
          data-question-index="<%= index %>"
          data-question-language="<%= question_language %>"
          data-question-search="<%= search_text %>">

          <div class="admin-ts-question-main">

            <div class="admin-ts-question-number">
              Q<%= index + 1 %>.
            </div>

            <div class="admin-ts-question-content">

              <div class="admin-ts-question-heading">

                <div class="admin-ts-question-text">
                  <%= question.question_text %>
                </div>

                <span class="admin-ts-mark">
                  <%= question.marks %> Mark
                </span>

              </div>

              <% if question.question_text_hindi.present? %>

                <div class="admin-ts-question-hindi">
                  <%= question.question_text_hindi %>
                </div>

              <% end %>

              <div class="admin-ts-options">

                <% question.test_series_options
                          .order(position: :asc)
                          .each_with_index do |option, option_index| %>

                  <div class="admin-ts-option <%= "correct" if option.is_correct? %>">

                    <strong>
                      <%= ("A".ord + option_index).chr %>.
                    </strong>

                    <span>
                      <%= option.option_text %>
                    </span>

                    <% if option.is_correct? %>

                      <span class="admin-ts-correct">
                        ✓ Correct
                      </span>

                    <% end %>

                  </div>

                <% end %>

              </div>

            </div>

          </div>

          <div class="admin-ts-question-actions">

            <%= link_to admin_test_series_test_question_path(
                          @test_series,
                          @test_series_test,
                          question
                        ),
                        class: "admin-ts-action view" do %>
              <i class="fas fa-eye"></i>
              View
            <% end %>

            <%= link_to edit_admin_test_series_test_question_path(
                          @test_series,
                          @test_series_test,
                          question
                        ),
                        class: "admin-ts-action edit" do %>
              <i class="fas fa-edit"></i>
              Edit
            <% end %>

            <%= button_to admin_test_series_test_question_path(
                            @test_series,
                            @test_series_test,
                            question
                          ),
                          method: :delete,
                          class: "admin-ts-action delete",
                          form: {
                            data: {
                              turbo_confirm:
                                "Delete this question?"
                            }
                          } do %>
              <i class="fas fa-trash"></i>
              Delete
            <% end %>

          </div>

        </div>

      <% end %>

    </div>

    <div
      class="admin-ts-no-results"
      id="adminQuestionNoResults">

      <i class="fas fa-search"></i>

      No matching questions found.

    </div>

  <% else %>

    <div class="admin-ts-empty">

      <i class="fas fa-question-circle"></i>

      <h3>No Questions</h3>

      <p>Add the first question.</p>

    </div>

  <% end %>

</div>

<script nonce="<%= content_security_policy_nonce %>">
(function() {

  function applyAdminTsTheme() {

    const isDark =
      localStorage.getItem("admin-ts-theme") === "dark";

    const icon =
      document.getElementById("adminTsThemeIcon");

    const toggle =
      document.getElementById("adminTsThemeToggle");

    document.body.classList.toggle(
      "admin-ts-dark",
      isDark
    );

    if (icon) {

      icon.classList.remove(
        "fa-moon",
        "fa-sun"
      );

      icon.classList.add(
        isDark ? "fa-sun" : "fa-moon"
      );

    }

    if (toggle) {

      toggle.setAttribute(
        "aria-label",
        isDark
          ? "Switch to day mode"
          : "Switch to night mode"
      );

      toggle.setAttribute(
        "title",
        isDark
          ? "Switch to day mode"
          : "Switch to night mode"
      );

    }

  }

  function initAdminTsTheme() {

    applyAdminTsTheme();

    const toggle =
      document.getElementById("adminTsThemeToggle");

    if (
      !toggle ||
      toggle.dataset.themeReady === "true"
    ) {
      return;
    }

    toggle.dataset.themeReady = "true";

    toggle.addEventListener(
      "click",
      function() {

        const isDark =
          !document.body.classList.contains(
            "admin-ts-dark"
          );

        document.body.classList.toggle(
          "admin-ts-dark",
          isDark
        );

        localStorage.setItem(
          "admin-ts-theme",
          isDark ? "dark" : "light"
        );

        applyAdminTsTheme();

      }
    );

  }

  function initAdminQuestionFilter() {

    const search =
      document.getElementById(
        "adminQuestionSearch"
      );

    const language =
      document.getElementById(
        "adminQuestionLanguage"
      );

    const order =
      document.getElementById(
        "adminQuestionOrder"
      );

    const list =
      document.getElementById(
        "adminQuestionList"
      );

    const count =
      document.getElementById(
        "adminQuestionVisibleCount"
      );

    const noResults =
      document.getElementById(
        "adminQuestionNoResults"
      );

    if (
      !search ||
      !language ||
      !order ||
      !list
    ) {
      return;
    }

    if (
      list.dataset.filterReady === "true"
    ) {
      return;
    }

    list.dataset.filterReady = "true";

    const cards = Array.from(
      list.querySelectorAll(
        ".admin-ts-question-card"
      )
    );

    function matchesLanguage(
      card,
      selectedLanguage
    ) {

      if (
        selectedLanguage === "all"
      ) {
        return true;
      }

      const cardLanguage =
        card.dataset.questionLanguage ||
        "other";

      if (
        selectedLanguage === "english"
      ) {
        return (
          cardLanguage === "english" ||
          cardLanguage === "both"
        );
      }

      if (
        selectedLanguage === "hindi"
      ) {
        return (
          cardLanguage === "hindi" ||
          cardLanguage === "both"
        );
      }

      if (
        selectedLanguage === "both"
      ) {
        return cardLanguage === "both";
      }

      return true;
    }

    function filterQuestions() {

      const query =
        search.value
          .trim()
          .toLowerCase();

      const selectedLanguage =
        language.value;

      const selectedOrder =
        order.value;

      cards.sort(function(a, b) {

        const indexA =
          Number(
            a.dataset.questionIndex
          );

        const indexB =
          Number(
            b.dataset.questionIndex
          );

        return selectedOrder === "desc"
          ? indexB - indexA
          : indexA - indexB;

      });

      cards.forEach(function(card) {

        list.appendChild(card);

      });

      let visible = 0;

      cards.forEach(function(card) {

        const text =
          card.dataset.questionSearch ||
          "";

        const searchMatch =
          !query ||
          text.includes(query);

        const languageMatch =
          matchesLanguage(
            card,
            selectedLanguage
          );

        const matched =
          searchMatch &&
          languageMatch;

        card.style.display =
          matched ? "" : "none";

        if (matched) {
          visible++;
        }

      });

      if (count) {

        count.textContent =
          visible;

      }

      if (noResults) {

        noResults.style.display =
          visible === 0
            ? "block"
            : "none";

      }

    }

    search.addEventListener(
      "input",
      filterQuestions
    );

    language.addEventListener(
      "change",
      filterQuestions
    );

    order.addEventListener(
      "change",
      filterQuestions
    );

    filterQuestions();

  }

  document.addEventListener(
    "turbo:load",
    function() {
      initAdminTsTheme();
      initAdminQuestionFilter();
    }
  );

  document.addEventListener(
    "DOMContentLoaded",
    function() {
      initAdminTsTheme();
      initAdminQuestionFilter();
    }
  );

  initAdminTsTheme();
  initAdminQuestionFilter();

})();
</script>