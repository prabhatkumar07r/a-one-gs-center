<style>
  /* =========================================================
   ADMIN TEST SERIES — TEST CREATE / EDIT FORM
   ========================================================= */

.admin-ts-form {
  width: 100%;
  max-width: 1000px;
}

/* =========================================================
   ERROR MESSAGE
   ========================================================= */

.admin-ts-errors {
  margin-bottom: 22px;
  padding: 15px 18px;

  background: #fff7f7;
  border: 1px solid #fecaca;
  border-left: 4px solid #dc2626;
  border-radius: 10px;

  color: #991b1b;
}

.admin-ts-errors strong {
  display: block;
  margin-bottom: 8px;

  font-size: 14px;
  font-weight: 700;
}

.admin-ts-errors ul {
  margin: 0;
  padding-left: 20px;
}

.admin-ts-errors li {
  margin-bottom: 3px;

  font-size: 13px;
  line-height: 1.5;
}

/* =========================================================
   FORM GRID
   ========================================================= */

.admin-ts-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;

  padding: 24px;

  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;

  box-shadow: 0 4px 16px rgba(25, 25, 50, 0.04);
}

.admin-ts-field {
  min-width: 0;
}

.admin-ts-field.full {
  grid-column: 1 / -1;
}

/* =========================================================
   LABEL
   ========================================================= */

.admin-ts-field label {
  display: block;
  margin-bottom: 7px;

  color: #303044;

  font-size: 13px;
  font-weight: 650;
}

/* =========================================================
   INPUT / SELECT
   ========================================================= */

.admin-ts-input {
  width: 100%;
  min-height: 43px;

  padding: 10px 12px;

  color: #252536;
  background: #ffffff;

  border: 1px solid #dfe2ea;
  border-radius: 8px;

  outline: none;

  font-family: inherit;
  font-size: 14px;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background-color 0.2s ease;
}

.admin-ts-input:hover {
  border-color: #c9cdd8;
}

.admin-ts-input:focus {
  border-color: #6366f1;

  box-shadow:
    0 0 0 3px rgba(99, 102, 241, 0.10);
}

.admin-ts-input::placeholder {
  color: #a1a6b5;
}

/* =========================================================
   SELECT
   ========================================================= */

select.admin-ts-input {
  cursor: pointer;
}

/* =========================================================
   TEXTAREA
   ========================================================= */

.admin-ts-textarea {
  min-height: 140px;

  resize: vertical;

  line-height: 1.6;
}

/* =========================================================
   FORM ACTIONS
   ========================================================= */

.admin-ts-form-actions {
  display: flex;
  align-items: center;
  gap: 10px;

  margin-top: 22px;
}

/* =========================================================
   BUTTONS
   ========================================================= */

.admin-ts-form-actions .admin-ts-btn {
  min-height: 40px;

  padding: 9px 16px;

  border-radius: 8px;

  font-size: 13px;
  font-weight: 650;

  text-decoration: none;

  cursor: pointer;

  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.admin-ts-form-actions .admin-ts-btn:hover {
  transform: translateY(-1px);
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 800px) {

  .admin-ts-form-grid {
    grid-template-columns: 1fr;
    gap: 17px;

    padding: 20px;
  }

  .admin-ts-field.full {
    grid-column: auto;
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

  .admin-ts-form {
    max-width: 100%;
  }

  .admin-ts-form-grid {
    padding: 16px;

    border-radius: 11px;
  }

  .admin-ts-field label {
    font-size: 12px;
  }

  .admin-ts-input {
    min-height: 41px;

    font-size: 13px;
  }

  .admin-ts-textarea {
    min-height: 120px;
  }

  .admin-ts-form-actions {
    flex-direction: column;
    align-items: stretch;

    width: 100%;
  }

  .admin-ts-form-actions .admin-ts-btn {
    width: 100%;

    justify-content: center;
    text-align: center;
  }
}

/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 400px) {

  .admin-ts-form-grid {
    padding: 13px;
  }

  .admin-ts-input {
    font-size: 13px;
  }
}
</style>


<%= form_with(
      url: @test_series_test.new_record? ?
        admin_test_series_tests_path(@test_series) :
        admin_test_series_test_path(@test_series, @test_series_test),
      model: @test_series_test,
      local: true,
      class: "admin-ts-form"
    ) do |form| %>


  <% if @test_series_test.errors.any? %>

    <div class="admin-ts-errors">

      <strong>
        <%= pluralize(
              @test_series_test.errors.count,
              "error"
            ) %> prevented saving:
      </strong>

      <ul>
        <% @test_series_test.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>

    </div>

  <% end %>


  <div class="admin-ts-form-grid">

    <div class="admin-ts-field full">

      <%= form.label :title, "Test Title" %>

      <%= form.text_field :title,
            class: "admin-ts-input",
            placeholder: "Test 1",
            required: true %>

    </div>


    <div class="admin-ts-field">

      <%= form.label :test_number, "Test Number" %>

      <%= form.number_field :test_number,
            class: "admin-ts-input",
            min: 1,
            required: true %>

    </div>


    <div class="admin-ts-field">

      <%= form.label :duration,
                    "Duration (Minutes)" %>

      <%= form.number_field :duration,
            class: "admin-ts-input",
            min: 1,
            required: true %>

    </div>


    <div class="admin-ts-field">

      <%= form.label :status, "Status" %>

      <%= form.select :status,
            [
              ["Active", "Active"],
              ["Inactive", "Inactive"]
            ],
            {},
            class: "admin-ts-input" %>

    </div>


    <div class="admin-ts-field full">

      <%= form.label :description, "Description" %>

      <%= form.text_area :description,
            class: "admin-ts-input admin-ts-textarea",
            rows: 6 %>

    </div>

  </div>


  <div class="admin-ts-form-actions">

    <%= form.submit(
          @test_series_test.persisted? ?
            "Update Test" :
            "Create Test",
          class: "admin-ts-btn admin-ts-btn-primary"
        ) %>

    <%= link_to "Cancel",
                @test_series_test.persisted? ?
                  admin_test_series_test_path(
                    @test_series,
                    @test_series_test
                  ) :
                  admin_test_series_path(@test_series),
                class: "admin-ts-btn admin-ts-btn-light" %>

  </div>

<% end %>