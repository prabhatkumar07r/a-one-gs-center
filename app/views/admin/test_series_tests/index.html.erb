@media (max-width: 1100px) {

  .admin-ts-question-card {
    grid-template-columns: 42px minmax(0, 1fr) auto;
  }

  .admin-ts-options {
    grid-template-columns: repeat(2, minmax(130px, 1fr));
  }

  .admin-ts-action {
    padding: 4px 6px;
  }

}

@media (max-width: 850px) {

  .admin-ts-question-filter {
    align-items: stretch;
    flex-direction: column;
  }

  .admin-ts-filter-left {
    width: 100%;
  }

  .admin-ts-question-search {
    width: 100%;
  }

  .admin-ts-question-filter-count {
    text-align: right;
  }

  .admin-ts-question-card {
    grid-template-columns: 42px minmax(0, 1fr);
  }

  .admin-ts-question-actions {
    grid-column: 1 / -1;
    justify-content: flex-end;
  }

}

@media (max-width: 650px) {

  .admin-ts-header {
    flex-direction: column;
  }

  .admin-ts-header-actions {
    width: 100%;
  }

  .admin-ts-header-actions .admin-ts-btn {
    flex: 1;
  }

  .admin-ts-filter-left {
    flex-direction: column;
    align-items: stretch;
  }

  .admin-ts-language-filter {
    width: 100%;
    overflow-x: auto;
  }

  .admin-ts-language-filter button {
    flex: 1;
    min-width: 65px;
  }

  .admin-ts-question-card {
    grid-template-columns: 38px minmax(0, 1fr);
    padding: 8px;
  }

  .admin-ts-question-top {
    min-width: 38px;
  }

  .admin-ts-question-text {
    font-size: 10px;
  }

  .admin-ts-question-hindi {
    font-size: 8px;
  }

  .admin-ts-options {
    grid-template-columns: 1fr;
  }

  .admin-ts-question-actions {
    grid-column: 1 / -1;
  }

  .admin-ts-question-actions .admin-ts-action {
    flex: 1;
  }

}

</style>

<div class="admin-ts-page">

  <div class="admin-ts-header">

    <div>

      <div class="admin-ts-breadcrumb">
        <%= link_to "Test Series",
                    admin_test_series_index_path %>
        /
        <%= @test_series.title %>
        /
        <%= link_to "Tests",
                    admin_test_series_path(@test_series) %>
        /
        <%= @test.title %>
      </div>

      <h1>Questions</h1>

      <p>
        Manage questions for this test.
      </p>

    </div>

    <div class="admin-ts-header-actions">

      <%= link_to new_admin_test_series_test_question_path(
                    @test_series,
                    @test_series_test
                  ),
                  class: "admin-ts-add-question" do %>
        <i class="fas fa-plus"></i>
        Add Question
      <% end %>

    </div>

  </div>

  <div class="admin-ts-section-header">

    <div>
      <h2>Questions</h2>
      <p>
        <%= @questions.count %> question(s)
      </p>
    </div>

  </div>

  <% if @questions.any? %>

    <div class="admin-ts-question-filter">

      <div class="admin-ts-filter-left">

        <div class="admin-ts-question-search">

          <i class="fas fa-search"></i>

          <input
            type="search"
            id="adminQuestionSearch"
            placeholder="Search question, Hindi, Hinglish or option..."
            autocomplete="off">

        </div>

        <div
          class="admin-ts-language-filter"
          id="adminQuestionLanguageFilter">

          <button
            type="button"
            class="active"
            data-language="all">
            All
          </button>

          <button
            type="button"
            data-language="hindi">
            Hindi
          </button>

          <button
            type="button"
            data-language="hinglish">
            Hinglish
          </button>

          <button
            type="button"
            data-language="english">
            English
          </button>

        </div>

      </div>

      <div class="admin-ts-question-filter-count">

        <span id="adminQuestionVisibleCount">
          <%= @questions.count %>
        </span>

        of

        <%= @questions.count %>

        Questions

      </div>

    </div>

    <div
      class="admin-ts-question-list"
      id="adminQuestionList">

      <% @questions.each_with_index do |question, question_index| %>

        <% option_texts = question.test_series_options.map { |option| option.option_text rescue nil }.compact %>

        <% searchable_text = [
             question.position,
             question.question_text,
             question.question_text_hindi,
             question.marks,
             option_texts
           ].flatten.compact.join(" ") %>

        <div
          class="admin-ts-question-card"
          data-question-search="<%= searchable_text.downcase %>"
          data-question-language="<%= question.question_text.to_s.match?(/[\u0900-\u097F]/) ? 'hindi' : 'english' %>"
          data-question-has-hindi="<%= question.question_text.to_s.match?(/[\u0900-\u097F]/) || question.question_text_hindi.to_s.match?(/[\u0900-\u097F]/) %>"
          data-question-has-latin-hindi="<%= searchable_text.downcase.match?(/\b(ka|ki|ke|kya|hai|hain|tha|thi|the|ko|se|me|mein|par|aur|ya|ye|woh|is|us|kis|kise|kaun|kyun|kab|kahan|kitna|kitne|hoga|hoti|hona|kar|karo|karke|wala|wali|wale|nahi|nahin|sab|ek|do|seva|samaj|bharat|rajya|desh|itihas|vigyan)\b/) %>">

          <div class="admin-ts-question-top">

            <strong>
              Q<%= question.position || question_index + 1 %>.
            </strong>

            <span>
              <%= question.marks %> Mark
            </span>

          </div>

          <div class="admin-ts-question-body">

            <p class="admin-ts-question-text"
               title="<%= question.question_text %>">
              <%= question.question_text %>
            </p>

            <% if question.question_text_hindi.present? %>

              <p
                class="admin-ts-question-hindi"
                title="<%= question.question_text_hindi %>">
                <%= question.question_text_hindi %>
              </p>

            <% end %>

            <div class="admin-ts-options">

              <% question.test_series_options.each_with_index do |option, option_index| %>

                <div class="admin-ts-option <%= 'correct' if option.is_correct? %>">

                  <strong>
                    <%= ("A".ord + option_index).chr %>.
                  </strong>

                  <span
                    class="admin-ts-option-text"
                    title="<%= option.option_text %>">
                    <%= option.option_text %>
                  </span>

                  <% if option.is_correct? %>

                    <span class="admin-ts-correct">
                      <i class="fas fa-check"></i>
                      Correct
                    </span>

                  <% end %>

                </div>

              <% end %>

            </div>

          </div>

          <div class="admin-ts-question-actions">

            <%= link_to admin_test_series_test_question_path(
                          @test_series,
                          @test_series_test,
                          question
                        ),
                        class: "admin-ts-action view" do %>
              <i class="fas fa-eye"></i>
              View
            <% end %>

            <%= link_to edit_admin_test_series_test_question_path(
                          @test_series,
                          @test_series_test,
                          question
                        ),
                        class: "admin-ts-action edit" do %>
              <i class="fas fa-edit"></i>
              Edit
            <% end %>

            <%= button_to admin_test_series_test_question_path(
                            @test_series,
                            @test_series_test,
                            question
                          ),
                          method: :delete,
                          class: "admin-ts-action delete",
                          form: {
                            data: {
                              turbo_confirm: "Delete this question?"
                            }
                          } do %>
              <i class="fas fa-trash"></i>
              Delete
            <% end %>

          </div>

        </div>

      <% end %>

    </div>

    <div
      class="admin-ts-question-no-results"
      id="adminQuestionNoResults">

      <i class="fas fa-search"></i>

      <strong>
        No matching questions found
      </strong>

      <span>
        Try another question, Hindi, Hinglish, English or option.
      </span>

    </div>

  <% else %>

    <div class="admin-ts-empty">

      <i class="fas fa-question-circle"></i>

      <h3>
        No Questions
      </h3>

      <p>
        Add the first question to this test.
      </p>

    </div>

  <% end %>

</div>

<script nonce="<%= content_security_policy_nonce %>">
(function() {

  function initAdminQuestionFilter() {

    const search =
      document.getElementById("adminQuestionSearch");

    const items =
      document.querySelectorAll(".admin-ts-question-card");

    const count =
      document.getElementById("adminQuestionVisibleCount");

    const noResults =
      document.getElementById("adminQuestionNoResults");

    const languageFilter =
      document.getElementById("adminQuestionLanguageFilter");

    if (!search || !items.length) {
      return;
    }

    if (search.dataset.filterReady === "true") {
      return;
    }

    search.dataset.filterReady = "true";

    let selectedLanguage = "all";

    function detectLanguage(item) {

      const hasHindi =
        item.dataset.questionHasHindi === "true";

      const hasLatinHindi =
        item.dataset.questionHasLatinHindi === "true";

      if (selectedLanguage === "hindi") {
        return hasHindi;
      }

      if (selectedLanguage === "hinglish") {
        return hasLatinHindi && !hasHindi;
      }

      if (selectedLanguage === "english") {
        return !hasHindi && !hasLatinHindi;
      }

      return true;
    }

    function filterQuestions() {

      const query =
        search.value
          .trim()
          .toLowerCase();

      let visible = 0;

      items.forEach(function(item) {

        const searchableText =
          item.dataset.questionSearch || "";

        const textMatch =
          !query ||
          searchableText.includes(query);

        const languageMatch =
          detectLanguage(item);

        const matched =
          textMatch && languageMatch;

        item.style.display =
          matched ? "" : "none";

        if (matched) {
          visible++;
        }

      });

      if (count) {
        count.textContent = visible;
      }

      if (noResults) {
        noResults.style.display =
          visible === 0 ? "flex" : "none";
      }

    }

    search.addEventListener(
      "input",
      filterQuestions
    );

    if (languageFilter) {

      languageFilter
        .querySelectorAll("button")
        .forEach(function(button) {

          button.addEventListener(
            "click",
            function() {

              languageFilter
                .querySelectorAll("button")
                .forEach(function(item) {
                  item.classList.remove("active");
                });

              button.classList.add("active");

              selectedLanguage =
                button.dataset.language || "all";

              filterQuestions();

            }
          );

        });

    }

    filterQuestions();

  }

  document.addEventListener(
    "turbo:load",
    initAdminQuestionFilter
  );

  document.addEventListener(
    "DOMContentLoaded",
    initAdminQuestionFilter
  );

  initAdminQuestionFilter();

})();
</script>