<style nonce="<%= content_security_policy_nonce %>">

.admin-ts-page {
  width: 100%;
  color: #202033;
}

.admin-ts-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 18px;
}

.admin-ts-header > div:first-child {
  min-width: 0;
}

.admin-ts-breadcrumb {
  margin-bottom: 7px;
  color: #858b9d;
  font-size: 10px;
  font-weight: 600;
}

.admin-ts-breadcrumb a {
  color: #6366f1;
  text-decoration: none;
}

.admin-ts-breadcrumb a:hover {
  text-decoration: underline;
}

.admin-ts-header h1 {
  margin: 0 0 5px;
  color: #202033;
  font-size: 26px;
  font-weight: 800;
  line-height: 1.2;
}

.admin-ts-header p {
  margin: 0;
  color: #73798c;
  font-size: 12px;
}

.admin-ts-header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.admin-ts-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 36px;
  padding: 8px 13px;
  border-radius: 8px;
  font-family: inherit;
  font-size: 11px;
  font-weight: 700;
  text-decoration: none !important;
  transition:
    background .18s ease,
    border-color .18s ease,
    color .18s ease,
    transform .18s ease;
}

.admin-ts-btn-primary {
  color: #ffffff !important;
  background: linear-gradient(135deg, #7c3aed, #4f46e5) !important;
  border: 1px solid #6d28d9 !important;
  box-shadow: 0 5px 14px rgba(79, 70, 229, .18);
}

.admin-ts-btn-primary:hover {
  color: #ffffff !important;
  background: linear-gradient(135deg, #6d28d9, #4338ca) !important;
  transform: translateY(-1px);
}

.admin-ts-section-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
}

.admin-ts-section-header > div {
  min-width: 0;
}

.admin-ts-section-header h2 {
  margin: 0 0 2px;
  color: #25263a;
  font-size: 15px;
  font-weight: 800;
}

.admin-ts-section-header p {
  margin: 0;
  color: #7b8194;
  font-size: 10px;
}

.admin-ts-add-question {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 9px 15px !important;
  color: #ffffff !important;
  background: linear-gradient(135deg, #7c3aed, #4f46e5) !important;
  border: 1px solid #6d28d9 !important;
  border-radius: 8px !important;
  font-size: 11px;
  font-weight: 700;
  text-decoration: none !important;
  box-shadow: 0 5px 14px rgba(79, 70, 229, .20);
  transition:
    transform .2s ease,
    box-shadow .2s ease,
    background .2s ease;
}

.admin-ts-add-question:hover {
  color: #ffffff !important;
  background: linear-gradient(135deg, #6d28d9, #4338ca) !important;
  transform: translateY(-1px);
  box-shadow: 0 8px 18px rgba(79, 70, 229, .28);
}

.admin-ts-question-filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin: 0 0 10px;
  padding: 8px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 9px;
  box-shadow: 0 2px 8px rgba(25, 25, 50, .025);
}

.admin-ts-filter-left {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  flex: 1;
}

.admin-ts-question-search {
  position: relative;
  width: 310px;
  max-width: 100%;
}

.admin-ts-question-search i {
  position: absolute;
  left: 11px;
  top: 50%;
  transform: translateY(-50%);
  color: #8b91a3;
  font-size: 11px;
  pointer-events: none;
}

.admin-ts-question-search input {
  width: 100%;
  height: 34px;
  padding: 7px 11px 7px 31px;
  color: #25263a;
  background: #f8f9fc;
  border: 1px solid #dfe3eb;
  border-radius: 7px;
  outline: none;
  font-family: inherit;
  font-size: 10px;
  transition: .18s ease;
}

.admin-ts-question-search input:hover {
  border-color: #cfd3df;
}

.admin-ts-question-search input:focus {
  border-color: #8b7cf6;
  background: #ffffff;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, .10);
}

.admin-ts-question-search input::placeholder {
  color: #9aa0b1;
}

.admin-ts-language-filter {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}

.admin-ts-language-filter button {
  min-height: 31px;
  padding: 5px 10px;
  color: #6b7280;
  background: #f8f9fc;
  border: 1px solid #e1e4eb;
  border-radius: 6px;
  font-family: inherit;
  font-size: 9px;
  font-weight: 700;
  cursor: pointer;
  transition:
    color .16s ease,
    background .16s ease,
    border-color .16s ease;
}

.admin-ts-language-filter button:hover {
  color: #4f46e5;
  background: #f5f3ff;
  border-color: #c4b5fd;
}

.admin-ts-language-filter button.active {
  color: #ffffff;
  background: linear-gradient(135deg, #7c3aed, #4f46e5);
  border-color: #6d28d9;
}

.admin-ts-question-filter-count {
  color: #73798c;
  font-size: 10px;
  font-weight: 700;
  white-space: nowrap;
  padding-right: 3px;
}

.admin-ts-question-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.admin-ts-question-card {
  display: grid;
  grid-template-columns: 46px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-height: 58px;
  padding: 8px 10px;
  background: #ffffff;
  border: 1px solid #e3e6ed;
  border-radius: 8px;
  box-shadow: 0 2px 7px rgba(25, 25, 50, .025);
  transition:
    border-color .16s ease,
    box-shadow .16s ease,
    transform .16s ease;
}

.admin-ts-question-card:hover {
  border-color: #d6d1ff;
  box-shadow: 0 4px 12px rgba(25, 25, 50, .05);
  transform: translateY(-1px);
}

.admin-ts-question-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  min-width: 46px;
  padding: 0;
  background: transparent;
  border: 0;
}

.admin-ts-question-top strong {
  color: #4f46e5;
  font-size: 11px;
  font-weight: 800;
  white-space: nowrap;
}

.admin-ts-question-top span {
  display: inline-flex;
  align-items: center;
  min-height: 23px;
  padding: 3px 6px;
  color: #636b7d;
  background: #f5f6fa;
  border: 1px solid #e0e3ea;
  border-radius: 5px;
  font-size: 8px;
  font-weight: 700;
  white-space: nowrap;
}

.admin-ts-question-body {
  min-width: 0;
}

.admin-ts-question-text {
  margin: 0;
  color: #25263a;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-ts-question-hindi {
  margin: 3px 0 0;
  color: #73798c;
  font-size: 9px;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-ts-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(170px, 1fr));
  gap: 4px 6px;
  margin-top: 6px;
}

.admin-ts-option {
  display: flex;
  align-items: center;
  gap: 5px;
  min-width: 0;
  min-height: 27px;
  padding: 4px 7px;
  color: #596174;
  background: #f8f9fc;
  border: 1px solid #e2e5ec;
  border-radius: 5px;
  font-size: 9px;
  line-height: 1.25;
}

.admin-ts-option > strong {
  flex-shrink: 0;
  color: #6366f1;
  font-size: 9px;
}

.admin-ts-option-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-ts-option.correct {
  color: #166534;
  background: #effcf3;
  border-color: #86efac;
}

.admin-ts-option.correct > strong {
  color: #16a34a;
}

.admin-ts-correct {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
  margin-left: auto;
  padding: 3px 5px;
  color: #15803d;
  background: #dcfce7;
  border: 1px solid #86efac;
  border-radius: 4px;
  font-size: 7px;
  font-weight: 800;
}

.admin-ts-question-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  padding: 0;
  background: transparent;
  border: 0;
}

.admin-ts-question-actions form {
  margin: 0;
  padding: 0;
}

.admin-ts-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  min-height: 27px;
  padding: 4px 8px;
  border-radius: 5px;
  font-family: inherit;
  font-size: 9px;
  font-weight: 700;
  text-decoration: none !important;
  white-space: nowrap;
  transition:
    background .16s ease,
    border-color .16s ease,
    color .16s ease;
}

.admin-ts-action.view {
  color: #2563eb;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
}

.admin-ts-action.view:hover {
  color: #1d4ed8;
  background: #dbeafe;
  border-color: #93c5fd;
}

.admin-ts-action.edit {
  color: #4f46e5;
  background: #f5f3ff;
  border: 1px solid #ddd6fe;
}

.admin-ts-action.edit:hover {
  color: #4338ca;
  background: #ede9fe;
  border-color: #c4b5fd;
}

.admin-ts-action.delete {
  color: #dc2626;
  background: #fff7f7;
  border: 1px solid #fecaca;
  cursor: pointer;
}

.admin-ts-action.delete:hover {
  color: #b91c1c;
  background: #fef2f2;
  border-color: #fca5a5;
}

.admin-ts-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 170px;
  padding: 25px;
  background: #ffffff;
  border: 1px dashed #d9dce5;
  border-radius: 10px;
  text-align: center;
}

.admin-ts-empty i {
  margin-bottom: 9px;
  color: #a5a9b8;
  font-size: 25px;
}

.admin-ts-empty h3 {
  margin: 0 0 5px;
  color: #303044;
  font-size: 15px;
  font-weight: 700;
}

.admin-ts-empty p {
  margin: 0;
  color: #7b8194;
  font-size: 11px;
}

.admin-ts-question-no-results {
  display: none;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4px;
  min-height: 110px;
  margin-top: 6px;
  padding: 20px;
  color: #7b8194;
  background: #ffffff;
  border: 1px dashed #dfe2eb;
  border-radius: 8px;
  text-align: center;
}

.admin-ts-question-no-results i {
  margin-bottom: 3px;
  color: #8b7cf6;
  font-size: 20px;
}

.admin-ts-question-no-results strong {
  color: #303044;
  font-size: 12px;
}

.admin-ts-question-no-results span {
  color: #858b9d;
  font-size: 10px;
}

