<style>
  /* =========================================================
     A ONE GS CENTER
     ADMIN VIDEO SHOW / VIDEO PARTIAL
  ========================================================= */

  .admin-video-item {
    background: #ffffff;
    border: 1px solid #ebe7f2;
    border-radius: 18px;
    padding: 22px;
    box-shadow: 0 8px 24px rgba(43, 35, 70, 0.07);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .admin-video-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(43, 35, 70, 0.11);
  }

  .admin-video-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 20px;
  }

  .admin-video-title-wrapper {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .admin-video-icon {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: linear-gradient(135deg, #8009e2, #5b08a8);
    color: #ffffff;
    font-size: 19px;
  }

  .admin-video-title {
    margin: 0;
    color: #29233b;
    font-size: 18px;
    font-weight: 700;
  }

  .admin-video-id {
    margin-top: 3px;
    color: #8a8497;
    font-size: 12px;
  }

  .admin-video-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .admin-video-detail {
    padding: 13px 15px;
    background: #faf9fc;
    border: 1px solid #eeeaf4;
    border-radius: 11px;
  }

  .admin-video-detail-label {
    display: block;
    margin-bottom: 4px;
    color: #858092;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .03em;
  }

  .admin-video-detail-value {
    color: #342d45;
    font-size: 14px;
    font-weight: 600;
    word-break: break-word;
  }

  .admin-video-description {
    margin-top: 12px;
    padding: 15px;
    background: #faf8ff;
    border-left: 3px solid #8009e2;
    border-radius: 10px;
  }

  .admin-video-description p {
    margin: 5px 0 0;
    color: #5f596b;
    font-size: 14px;
    line-height: 1.6;
  }

  .admin-video-course {
    color: #8009e2;
  }

  @media (max-width: 650px) {

    .admin-video-item {
      padding: 17px;
    }

    .admin-video-top {
      flex-direction: column;
    }

    .admin-video-details {
      grid-template-columns: 1fr;
    }

  }
</style>


<div id="<%= dom_id video %>" class="admin-video-item">

  <!-- HEADER -->
  <div class="admin-video-top">

    <div class="admin-video-title-wrapper">

      <div class="admin-video-icon">
        🎥
      </div>

      <div>

        <h4 class="admin-video-title">
          <%= video.title.presence || "Untitled Video" %>
        </h4>

        <div class="admin-video-id">
          Video ID:
          #<%= video.id %>
        </div>

      </div>

    </div>

  </div>


  <!-- DETAILS -->
  <div class="admin-video-details">

    <!-- DURATION -->
    <div class="admin-video-detail">

      <span class="admin-video-detail-label">
        Duration
      </span>

      <span class="admin-video-detail-value">

        <% if video.duration.present? %>
          ⏱️ <%= video.duration %>
        <% else %>
          —
        <% end %>

      </span>

    </div>


    <!-- COURSE -->
    <div class="admin-video-detail">

      <span class="admin-video-detail-label">
        Course
      </span>

      <span class="admin-video-detail-value admin-video-course">

        <% if video.course_id.present? %>
          Course #<%= video.course_id %>
        <% else %>
          —
        <% end %>

      </span>

    </div>

  </div>


  <!-- DESCRIPTION -->
  <% if video.description.present? %>

    <div class="admin-video-description">

      <span class="admin-video-detail-label">
        Description
      </span>

      <p>
        <%= video.description %>
      </p>

    </div>

  <% end %>

</div>