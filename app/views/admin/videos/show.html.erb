<% content_for :title, @video.title %>

<style>
  /* =========================================================
     A ONE GS CENTER
     ADMIN VIDEO DETAILS
     PURPLE ADMIN THEME
  ========================================================= */

  .admin-video-page {
    max-width: 1150px;
    margin: 0 auto;
    padding: 10px 0 40px;
  }

  .admin-video-card {
    overflow: hidden;
    border: 1px solid #e8e3f0;
    border-radius: 20px;
    background: #ffffff;
    box-shadow: 0 12px 35px rgba(43, 35, 70, .08);
  }

  /* HEADER */
  .admin-video-show-header {
    position: relative;
    padding: 28px 32px;
    overflow: hidden;
    color: #ffffff;
    background: linear-gradient(
      135deg,
      #8009e2 0%,
      #6d19c7 50%,
      #5b08a8 100%
    );
  }

  .admin-video-show-header::before {
    content: "";
    position: absolute;
    width: 220px;
    height: 220px;
    top: -120px;
    right: -60px;
    border-radius: 50%;
    background: rgba(255,255,255,.08);
  }

  .admin-video-show-header::after {
    content: "";
    position: absolute;
    width: 130px;
    height: 130px;
    bottom: -80px;
    right: 170px;
    border-radius: 50%;
    background: rgba(255,255,255,.06);
  }

  .admin-video-header-content {
    position: relative;
    z-index: 2;
  }

  .admin-video-header-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    border-radius: 14px;
    background: rgba(255,255,255,.16);
    font-size: 24px;
  }

  .admin-video-show-header h2 {
    margin: 0;
    font-size: 25px;
    font-weight: 700;
  }

  .admin-video-show-header p {
    margin: 7px 0 0;
    opacity: .85;
    font-size: 14px;
  }

  /* BODY */
  .admin-video-show-body {
    padding: 30px;
  }

  /* INFORMATION GRID */
  .video-info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
    margin-bottom: 28px;
  }

  .video-info-item {
    padding: 16px 18px;
    border: 1px solid #eeeaf4;
    border-radius: 12px;
    background: #faf9fc;
  }

  .video-info-label {
    display: block;
    margin-bottom: 5px;
    color: #8a8497;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .video-info-value {
    color: #302940;
    font-size: 15px;
    font-weight: 600;
    word-break: break-word;
  }

  .video-info-value.purple {
    color: #8009e2;
  }

  /* DESCRIPTION */
  .video-description-box {
    margin-bottom: 28px;
    padding: 18px;
    border-left: 4px solid #8009e2;
    border-radius: 12px;
    background: #faf8ff;
  }

  .video-description-box h6 {
    margin-bottom: 8px;
    color: #342d45;
    font-weight: 700;
  }

  .video-description-box p {
    margin: 0;
    color: #615a6d;
    line-height: 1.7;
    white-space: pre-line;
  }

  /* THUMBNAIL */
  .video-thumbnail-section {
    margin-bottom: 28px;
  }

  .video-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    color: #342d45;
    font-size: 17px;
    font-weight: 700;
  }

  .video-section-title i {
    color: #8009e2;
  }

  .video-thumbnail-wrapper {
    display: flex;
    justify-content: center;
    padding: 15px;
    border: 1px solid #eeeaf4;
    border-radius: 14px;
    background: #faf9fc;
  }

  .video-thumbnail {
    max-width: 100%;
    max-height: 330px;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 8px 22px rgba(0,0,0,.10);
  }

  /* PLAYER */
  .video-player-section {
    margin-top: 28px;
  }

  .video-player-wrapper {
    overflow: hidden;
    border-radius: 15px;
    background: #111;
    box-shadow: 0 10px 30px rgba(0,0,0,.15);
  }

  .video-player-wrapper iframe {
    display: block;
    width: 100%;
    min-height: 500px;
    border: 0;
  }

  /* NO VIDEO */
  .video-no-content {
    padding: 45px 20px;
    border: 1px dashed #d9d2e5;
    border-radius: 14px;
    background: #faf9fc;
    text-align: center;
  }

  .video-no-content-icon {
    margin-bottom: 10px;
    font-size: 42px;
  }

  .video-no-content h5 {
    color: #3b3449;
    font-weight: 700;
  }

  .video-no-content p {
    margin: 0;
    color: #817a8d;
  }

  /* FOOTER */
  .admin-video-show-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 20px 30px;
    border-top: 1px solid #eeeaf4;
    background: #fcfbfd;
  }

  .admin-video-action {
    min-height: 44px;
    padding: 10px 18px;
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
    border: 0;
    transition:
      transform .2s ease,
      box-shadow .2s ease;
  }

  .admin-video-action:hover {
    transform: translateY(-1px);
  }

  .admin-video-edit {
    background: #ffc107;
    color: #332b00;
  }

  .admin-video-back {
    background: #eeeaf3;
    color: #4e475b;
  }

  .admin-video-delete {
    background: #dc3545;
    color: #ffffff;
  }

  .admin-video-edit:hover {
    color: #332b00;
    box-shadow: 0 6px 16px rgba(255,193,7,.20);
  }

  .admin-video-back:hover {
    color: #342d45;
    box-shadow: 0 6px 16px rgba(0,0,0,.08);
  }

  .admin-video-delete:hover {
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(220,53,69,.20);
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {

    .admin-video-page {
      padding-left: 10px;
      padding-right: 10px;
    }

    .admin-video-show-header {
      padding: 23px 20px;
    }

    .admin-video-show-header h2 {
      font-size: 21px;
    }

    .admin-video-show-body {
      padding: 20px;
    }

    .video-info-grid {
      grid-template-columns: 1fr;
    }

    .video-player-wrapper iframe {
      min-height: 300px;
    }

    .admin-video-show-footer {
      padding: 18px 20px;
    }

    .admin-video-action {
      width: 100%;
      text-align: center;
    }
  }
</style>


<div class="admin-video-page">

  <div class="admin-video-card">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="admin-video-show-header">

      <div class="admin-video-header-content">

        <div class="admin-video-header-icon">
          🎥
        </div>

        <h2>
          <%= @video.title.presence || "Untitled Video" %>
        </h2>

        <p>
          Video details and playback management
        </p>

      </div>

    </div>


    <!-- =====================================================
         BODY
    ====================================================== -->

    <div class="admin-video-show-body">


      <!-- COURSE / PLAYLIST / DURATION / POSITION -->

      <div class="video-info-grid">

        <!-- COURSE -->

        <div class="video-info-item">

          <span class="video-info-label">
            Course
          </span>

          <span class="video-info-value purple">
            <%= @course.Course_name %>
          </span>

        </div>


        <!-- PLAYLIST -->

        <div class="video-info-item">

          <span class="video-info-label">
            Playlist
          </span>

          <span class="video-info-value">

            <%= @video.playlist&.title || "Not Assigned" %>

          </span>

        </div>


        <!-- DURATION -->

        <div class="video-info-item">

          <span class="video-info-label">
            Duration
          </span>

          <span class="video-info-value">

            <% if @video.duration.present? %>
              ⏱️ <%= @video.duration %>
            <% else %>
              —
            <% end %>

          </span>

        </div>


        <!-- POSITION -->

        <div class="video-info-item">

          <span class="video-info-label">
            Position
          </span>

          <span class="video-info-value">

            <%= @video.position.presence || "—" %>

          </span>

        </div>


        <!-- STATUS -->

        <div class="video-info-item">

          <span class="video-info-label">
            Status
          </span>

          <span class="video-info-value">

            <% if @video.active? %>

              <span class="badge bg-success">
                ● Active
              </span>

            <% else %>

              <span class="badge bg-secondary">
                ● Inactive
              </span>

            <% end %>

          </span>

        </div>


        <!-- VIDEO ID -->

        <div class="video-info-item">

          <span class="video-info-label">
            Video ID
          </span>

          <span class="video-info-value">
            #<%= @video.id %>
          </span>

        </div>

      </div>


      <!-- =====================================================
           DESCRIPTION
      ====================================================== -->

      <% if @video.description.present? %>

        <div class="video-description-box">

          <h6>
            📝 Description
          </h6>

          <p>
            <%= @video.description %>
          </p>

        </div>

      <% end %>


      <!-- =====================================================
           THUMBNAIL
      ====================================================== -->

      <% if @video.thumbnail.attached? ||
            (@video.video_url.present? &&
             @video.youtube_thumbnail.present?) %>

        <div class="video-thumbnail-section">

          <div class="video-section-title">
            🖼️ Video Thumbnail
          </div>

          <div class="video-thumbnail-wrapper">

            <% if @video.thumbnail.attached? %>

              <%= image_tag @video.thumbnail,
                  class: "video-thumbnail",
                  alt: @video.title %>

            <% elsif @video.youtube_thumbnail.present? %>

              <%= image_tag @video.youtube_thumbnail,
                  class: "video-thumbnail",
                  alt: @video.title %>

            <% end %>

          </div>

        </div>

      <% end %>


      <!-- =====================================================
           VIDEO PLAYER
      ====================================================== -->

      <div class="video-player-section">

        <div class="video-section-title">
          ▶️ Video Preview
        </div>


        <% if @video.video_url.present? %>

          <%
            youtube_id =
              if @video.video_url.match?(/youtu\.be\//)
                @video.video_url.split("youtu.be/").last.split("?").first
              elsif @video.video_url.match?(/[?&]v=/)
                @video.video_url[/[?&]v=([^&]+)/, 1]
              elsif @video.video_url.include?("/embed/")
                @video.video_url.split("/embed/").last.split("?").first
              end
          %>


          <% if youtube_id.present? %>

            <div
              class="video-player-wrapper"
              id="admin-video-player"
            >

              <iframe
                src="https://www.youtube.com/embed/<%= youtube_id %>"
                title="<%= @video.title %>"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen>
              </iframe>

            </div>

          <% else %>

            <div class="video-no-content">

              <div class="video-no-content-icon">
                ⚠️
              </div>

              <h5>
                Invalid YouTube URL
              </h5>

              <p>
                The video URL could not be converted into a YouTube player.
              </p>

            </div>

          <% end %>


        <% else %>

          <div class="video-no-content">

            <div class="video-no-content-icon">
              🎬
            </div>

            <h5>
              No Video Available
            </h5>

            <p>
              This video does not have a YouTube URL yet.
            </p>

          </div>

        <% end %>

      </div>

    </div>


    <!-- =====================================================
         FOOTER ACTIONS
    ====================================================== -->

    <div class="admin-video-show-footer">

      <% if @video.playlist.present? %>

        <%= link_to(
              edit_admin_course_playlist_video_path(
                @course,
                @video.playlist,
                @video
              ),
              class: "admin-video-action admin-video-edit"
            ) do %>
          ✏️ Edit Video
        <% end %>


        <%= link_to(
              admin_course_playlist_videos_path(
                @course,
                @video.playlist
              ),
              class: "admin-video-action admin-video-back"
            ) do %>
          ← Back to Videos
        <% end %>


        <%= button_to(
              admin_course_playlist_video_path(
                @course,
                @video.playlist,
                @video
              ),
              method: :delete,
              data: {
                turbo_confirm:
                  "Are you sure you want to delete this video?"
              },
              class: "admin-video-action admin-video-delete"
            ) do %>
          🗑️ Delete Video
        <% end %>


      <% else %>

        <div class="alert alert-warning mb-0 w-100">
          ⚠️ This video is not assigned to any playlist.
        </div>

      <% end %>

    </div>

  </div>

</div>


<script>
  document.addEventListener("turbo:load", function () {

    const player =
      document.getElementById("admin-video-player");

    if (!player) return;


    /* =====================================================
       PLAYER ENTRANCE ANIMATION
    ===================================================== */

    player.style.opacity = "0";
    player.style.transform = "translateY(10px)";
    player.style.transition =
      "opacity .45s ease, transform .45s ease";

    requestAnimationFrame(function () {

      player.style.opacity = "1";
      player.style.transform = "translateY(0)";

    });


    /* =====================================================
       RESPONSIVE PLAYER
    ===================================================== */

    const iframe =
      player.querySelector("iframe");

    function resizePlayer() {

      if (!iframe) return;

      if (window.innerWidth <= 576) {
        iframe.style.minHeight = "240px";
      } else if (window.innerWidth <= 768) {
        iframe.style.minHeight = "300px";
      } else {
        iframe.style.minHeight = "500px";
      }

    }

    resizePlayer();

    window.addEventListener(
      "resize",
      resizePlayer
    );

  });
</script>