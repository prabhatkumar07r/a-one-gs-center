<style>
  /* =========================================================
     A ONE GS CENTER
     ADMIN VIDEO FORM
     PURPLE ADMIN THEME
  ========================================================= */

  .admin-video-form {
    max-width: 1050px;
    margin: 0 auto;
  }

  /* FORM CARD */
  .video-form-card {
    background: #ffffff;
    border: 1px solid #e9e7f2;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(43, 35, 70, 0.08);
  }

  /* HEADER */
  .video-form-header {
    position: relative;
    padding: 26px 30px;
    color: #ffffff;
    background: linear-gradient(
      135deg,
      #8009e2 0%,
      #6d19c7 50%,
      #5b08a8 100%
    );
    overflow: hidden;
  }

  .video-form-header::before {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    right: -60px;
    top: -80px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
  }

  .video-form-header::after {
    content: "";
    position: absolute;
    width: 120px;
    height: 120px;
    right: 100px;
    bottom: -80px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
  }

  .video-form-header-content {
    position: relative;
    z-index: 2;
  }

  .video-form-icon {
    width: 52px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    margin-bottom: 12px;
    background: rgba(255, 255, 255, 0.16);
    font-size: 24px;
  }

  .video-form-header h3 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
  }

  .video-form-header p {
    margin: 6px 0 0;
    opacity: 0.85;
    font-size: 14px;
  }

  /* BODY */
  .video-form-body {
    padding: 32px;
  }

  /* COURSE / PLAYLIST INFO */
  .video-context-box {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    margin-bottom: 26px;
    background: #faf8ff;
    border: 1px solid #eee6ff;
    border-left: 4px solid #8009e2;
    border-radius: 12px;
  }

  .video-context-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    background: #8009e2;
    color: #ffffff;
    font-size: 18px;
  }

  .video-context-text {
    min-width: 0;
  }

  .video-context-text strong {
    color: #27213a;
  }

  .video-context-text small {
    color: #77718a;
  }

  /* SECTION */
  .form-section {
    margin-top: 28px;
  }

  .form-section:first-of-type {
    margin-top: 0;
  }

  .form-section-title {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 18px;
    padding-bottom: 10px;
    border-bottom: 1px solid #eeeaf5;
    color: #2d2542;
    font-size: 16px;
    font-weight: 700;
  }

  .form-section-title i {
    color: #8009e2;
    font-size: 18px;
  }

  /* LABELS */
  .video-field {
    margin-bottom: 20px;
  }

  .video-field label {
    display: block;
    margin-bottom: 8px;
    color: #332b48;
    font-size: 14px;
    font-weight: 600;
  }

  .video-field label .required {
    color: #dc3545;
    margin-left: 2px;
  }

  /* INPUTS */
  .video-form-control,
  .video-form-select,
  .video-form-textarea {
    width: 100%;
    border: 1px solid #ddd8e8;
    border-radius: 11px;
    background: #ffffff;
    color: #29233b;
    padding: 12px 14px;
    font-size: 14px;
    outline: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .video-form-control,
  .video-form-select {
    min-height: 48px;
  }

  .video-form-textarea {
    min-height: 125px;
    resize: vertical;
  }

  .video-form-control:focus,
  .video-form-select:focus,
  .video-form-textarea:focus {
    border-color: #8009e2;
    box-shadow: 0 0 0 4px rgba(128, 9, 226, 0.10);
  }

  .video-form-control::placeholder,
  .video-form-textarea::placeholder {
    color: #aaa5b5;
  }

  /* FILE INPUT */
  .video-file-input {
    padding: 9px 12px;
    cursor: pointer;
  }

  .video-file-input::file-selector-button {
    border: 0;
    border-radius: 8px;
    padding: 7px 12px;
    margin-right: 10px;
    background: #f0e7ff;
    color: #6d19c7;
    font-weight: 600;
    cursor: pointer;
  }

  /* HELP TEXT */
  .video-help-text {
    display: block;
    margin-top: 6px;
    color: #8a8497;
    font-size: 12px;
  }

  /* URL FIELD */
  .video-url-wrapper {
    position: relative;
  }

  .video-url-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #8009e2;
    pointer-events: none;
  }

  .video-url-input {
    padding-left: 42px !important;
  }

  /* ERROR */
  .video-errors {
    margin-bottom: 24px;
    padding: 16px 18px;
    border: 1px solid #f5c2c7;
    border-radius: 12px;
    background: #fff5f5;
    color: #842029;
  }

  .video-errors-title {
    margin-bottom: 8px;
    font-weight: 700;
  }

  .video-errors ul {
    margin: 0;
    padding-left: 20px;
  }

  /* BUTTONS */
  .video-form-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid #eeeaf5;
  }

  .video-btn {
    min-height: 46px;
    padding: 11px 21px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .video-btn:hover {
    transform: translateY(-1px);
  }

  .video-btn-save {
    background: linear-gradient(135deg, #8009e2, #6d19c7);
    color: #ffffff;
    box-shadow: 0 7px 18px rgba(128, 9, 226, 0.22);
  }

  .video-btn-save:hover {
    color: #ffffff;
    background: linear-gradient(135deg, #7108ca, #5b08a8);
    box-shadow: 0 9px 22px rgba(128, 9, 226, 0.28);
  }

  .video-btn-back {
    background: #f4f2f8;
    color: #514a61;
    border: 1px solid #e3deec;
  }

  .video-btn-back:hover {
    background: #ebe7f2;
    color: #342d45;
  }

  /* LOADING */
  .video-btn-saving {
    pointer-events: none;
    opacity: 0.75;
  }

  .video-spinner {
    display: inline-block;
    width: 15px;
    height: 15px;
    margin-right: 7px;
    vertical-align: -2px;
    border: 2px solid rgba(255,255,255,.4);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: videoSpin .7s linear infinite;
  }

  @keyframes videoSpin {
    to {
      transform: rotate(360deg);
    }
  }

  /* MOBILE */
  @media (max-width: 768px) {

    .video-form-body {
      padding: 22px 18px;
    }

    .video-form-header {
      padding: 22px 20px;
    }

    .video-form-header h3 {
      font-size: 21px;
    }

    .video-context-box {
      align-items: flex-start;
    }

    .video-form-actions {
      flex-direction: column-reverse;
      align-items: stretch;
    }

    .video-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>


<div class="admin-video-form">

  <div class="video-form-card">

    <!-- HEADER -->
    <div class="video-form-header">

      <div class="video-form-header-content">

        <div class="video-form-icon">
          🎥
        </div>

        <h3>
          <%= @video.persisted? ? "Edit Video" : "Add New Video" %>
        </h3>

        <p>
          Add and manage course video content
        </p>

      </div>

    </div>


    <!-- BODY -->
    <div class="video-form-body">

      <!-- COURSE CONTEXT -->
      <div class="video-context-box">

        <div class="video-context-icon">
          📚
        </div>

        <div class="video-context-text">

          <div>
            <small>Course</small><br>
            <strong>
              <%= @course.Course_name %>
            </strong>
          </div>

          <% if @playlist.present? %>
            <div class="mt-1">
              <small>
                Playlist:
                <strong><%= @playlist.title %></strong>
              </small>
            </div>
          <% end %>

        </div>

      </div>


      <%= form_with(
            model: [:admin, @course, @playlist, @video],
            local: true,
            html: {
              multipart: true,
              id: "admin-video-form"
            }
          ) do |form| %>


        <!-- ERRORS -->
        <% if @video.errors.any? %>

          <div class="video-errors">

            <div class="video-errors-title">
              ⚠️
              <%= pluralize(
                    @video.errors.count,
                    "error"
                  ) %>
              prevented this video from being saved.
            </div>

            <ul>
              <% @video.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>

          </div>

        <% end %>


        <!-- BASIC INFORMATION -->
        <div class="form-section">

          <div class="form-section-title">
            <i class="bi bi-info-circle-fill"></i>
            Basic Information
          </div>


          <div class="video-field">

            <%= form.label :title do %>
              Video Title
              <span class="required">*</span>
            <% end %>

            <%= form.text_field :title,
                  class: "video-form-control",
                  placeholder: "Enter video title",
                  autocomplete: "off" %>

          </div>


          <div class="video-field">

            <%= form.label :playlist_id, "Playlist" %>

            <%= form.collection_select :playlist_id,
                  @playlists,
                  :id,
                  :title,
                  { prompt: "Select Playlist" },
                  {
                    class: "video-form-select",
                    id: "video_playlist_id"
                  } %>

            <small class="video-help-text">
              Select the playlist where this video should appear.
            </small>

          </div>


          <div class="video-field">

            <%= form.label :description, "Description" %>

            <%= form.text_area :description,
                  rows: 5,
                  class: "video-form-textarea",
                  placeholder: "Write a short description of this video..." %>

          </div>

        </div>


        <!-- VIDEO SETTINGS -->
        <div class="form-section">

          <div class="form-section-title">
            <i class="bi bi-sliders"></i>
            Video Settings
          </div>


          <div class="row">

            <div class="col-md-4">

              <div class="video-field">

                <%= form.label :duration, "Duration" %>

                <%= form.text_field :duration,
                      class: "video-form-control",
                      placeholder: "15 Minutes" %>

              </div>

            </div>


            <div class="col-md-4">

              <div class="video-field">

             <label class="video-field-label">
              Position
             </label>

            <div class="video-context-box mb-0" style="padding: 10px 12px;">
                   <span style="color:#8009e2; font-weight:700;">
                   📌
              </span>

       <small>
        Position is assigned automatically.
      </small>
    </div>

    </div>

   </div>


            <div class="col-md-4">

              <div class="video-field">

                <%= form.label :status, "Status" %>

                <%= form.select :status,
                      Video.statuses.keys.map {
                        |s| [s.titleize, s]
                      },
                      {},
                      class: "video-form-select" %>

              </div>

            </div>

          </div>

        </div>


        <!-- VIDEO SOURCE -->
        <div class="form-section">

          <div class="form-section-title">
            <i class="bi bi-youtube"></i>
            Video Source
          </div>


          <div class="video-field">

            <%= form.label :video_url, "YouTube Video URL" %>

            <div class="video-url-wrapper">

              <span class="video-url-icon">
                ▶
              </span>

              <%= form.text_field :video_url,
                    class: "video-form-control video-url-input",
                    placeholder: "https://www.youtube.com/watch?v=..." %>

            </div>

            <small class="video-help-text">
              Paste the complete YouTube video URL.
            </small>

          </div>


          <div class="video-field">

            <%= form.label :thumbnail, "Video Thumbnail" %>

            <%= form.file_field :thumbnail,
                  class: "video-form-control video-file-input",
                  accept: "image/*" %>

            <small class="video-help-text">
              Upload a JPG, PNG or WEBP thumbnail.
            </small>

          </div>

        </div>


        <!-- ACTIONS -->
        <div class="video-form-actions">

          <%= link_to(
                admin_course_playlist_videos_path(
                  @course,
                  @playlist
                ),
                class: "video-btn video-btn-back"
              ) do %>
            ← Back
          <% end %>


          <%= form.submit(
                @video.persisted? ? "Update Video" : "Save Video",
                class: "video-btn video-btn-save",
                id: "video-submit-button"
              ) %>

        </div>


      <% end %>

    </div>

  </div>

</div>


<script>
  document.addEventListener("turbo:load", function () {

    const form = document.getElementById("admin-video-form");
    const submitButton = document.getElementById("video-submit-button");

    if (!form || !submitButton) return;


    /* =====================================================
       PREVENT DOUBLE SUBMISSION
    ===================================================== */

    form.addEventListener("submit", function () {

      if (form.dataset.submitting === "true") {
        return;
      }

      form.dataset.submitting = "true";

      submitButton.disabled = true;
      submitButton.classList.add("video-btn-saving");

      const isEdit = <%= @video.persisted? ? "true" : "false" %>;

      submitButton.innerHTML =
        '<span class="video-spinner"></span>' +
        (isEdit ? "Updating Video..." : "Saving Video...");

    });


    /* =====================================================
       TITLE CLEANUP
    ===================================================== */

    const titleInput =
      form.querySelector("#video_title");

    if (titleInput) {

      titleInput.addEventListener("input", function () {

        this.value = this.value
          .replace(/\s{2,}/g, " ");

      });

    }


    /* =====================================================
       YOUTUBE URL VALIDATION
    ===================================================== */

    const urlInput =
      form.querySelector("#video_video_url");

    if (urlInput) {

      urlInput.addEventListener("blur", function () {

        const value = this.value.trim();

        if (
          value !== "" &&
          !(
            value.includes("youtube.com") ||
            value.includes("youtu.be")
          )
        ) {

          this.style.borderColor = "#dc3545";

        } else {

          this.style.borderColor = "";

        }

      });

    }


    /* =====================================================
       THUMBNAIL FILE VALIDATION
    ===================================================== */

    const thumbnailInput =
      form.querySelector("#video_thumbnail");

    if (thumbnailInput) {

      thumbnailInput.addEventListener("change", function () {

        const file = this.files[0];

        if (!file) return;

        const allowedTypes = [
          "image/jpeg",
          "image/png",
          "image/webp"
        ];

        if (!allowedTypes.includes(file.type)) {

          alert(
            "Please select a JPG, PNG or WEBP image."
          );

          this.value = "";

          return;

        }


        /* 5 MB maximum */

        if (file.size > 5 * 1024 * 1024) {

          alert(
            "Thumbnail size must be less than 5 MB."
          );

          this.value = "";

        }

      });

    }

  });
</script>