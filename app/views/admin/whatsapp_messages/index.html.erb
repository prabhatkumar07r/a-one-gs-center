<% content_for :title, "WhatsApp Chats" %>

<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   A ONE GS CENTER
   WHATSAPP WEB STYLE ADMIN INBOX
========================================================= */

:root {
  --wa-bg: #0b141a;
  --wa-panel: #202c33;
  --wa-panel-2: #111b21;
  --wa-border: #344047;
  --wa-text: #e9edef;
  --wa-muted: #8696a0;
  --wa-green: #005c4b;
  --wa-green-2: #008069;
  --wa-blue: #53bdeb;
  --wa-input: #2a3942;
  --wa-hover: #202c33;
}

/* =========================================================
   FULL SCREEN
========================================================= */

.aone-whatsapp-page {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999;

  background: var(--wa-bg);

  overflow: hidden;
}

/* =========================================================
   SHELL
========================================================= */

.wa-shell {
  width: 100%;
  height: 100%;

  display: grid;

  grid-template-columns:
    370px minmax(0, 1fr);

  overflow: hidden;

  background: var(--wa-bg);
}

/* =========================================================
   SIDEBAR
========================================================= */

.wa-sidebar {
  min-width: 0;

  display: flex;
  flex-direction: column;

  background: #111b21;

  border-right:
    1px solid var(--wa-border);
}

.wa-sidebar-header {
  height: 72px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 18px;

  background: #202c33;

  border-bottom:
    1px solid var(--wa-border);
}

.wa-sidebar-title {
  color: #fff;

  font-size: 22px;
  font-weight: 700;
}

.wa-sidebar-actions {
  display: flex;
  gap: 10px;
}

.wa-icon-button {
  width: 40px;
  height: 40px;

  border: 0;
  border-radius: 50%;

  background: transparent;

  color: #d1d7db;

  font-size: 22px;

  cursor: pointer;

  transition: 0.2s ease;
}

.wa-icon-button:hover {
  background: #2a3942;
}

/* =========================================================
   SEARCH
========================================================= */

.wa-search-wrap {
  padding: 10px;
  background: #111b21;
}

.wa-search {
  width: 100%;

  height: 44px;

  border: 0;
  border-radius: 8px;

  outline: none;

  background: #202c33;

  color: #e9edef;

  padding: 0 16px;

  font-size: 14px;
}

.wa-search::placeholder {
  color: #8696a0;
}

/* =========================================================
   CONVERSATION LIST
========================================================= */

.wa-conversation-list {
  flex: 1;

  min-height: 0;

  overflow-y: auto;
}

.wa-conversation-link {
  display: flex;

  align-items: center;

  gap: 12px;

  min-height: 78px;

  padding: 10px 14px;

  text-decoration: none;

  color: inherit;

  border-bottom:
    1px solid rgba(255,255,255,.04);

  cursor: pointer;

  transition:
    background .15s ease;
}

.wa-conversation-link:hover {
  background: #202c33;
}

.wa-conversation-link.active {
  background: #2a3942;
}

.wa-avatar {
  width: 54px;
  height: 54px;

  flex: 0 0 54px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #a855f7
    );

  color: #fff;

  font-size: 21px;
  font-weight: 700;
}

.wa-conversation-content {
  flex: 1;

  min-width: 0;
}

.wa-conversation-top {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.wa-conversation-name {
  color: #e9edef;

  font-weight: 700;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}

.wa-conversation-time {
  color: #8696a0;

  font-size: 12px;

  white-space: nowrap;
}

.wa-conversation-preview {
  margin-top: 5px;

  color: #8696a0;

  font-size: 13px;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}

.wa-unread {
  min-width: 20px;
  height: 20px;

  padding: 0 6px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  border-radius: 999px;

  background: #25d366;

  color: #111b21;

  font-size: 11px;
  font-weight: 700;
}

/* =========================================================
   CHAT
========================================================= */

.wa-chat {
  min-width: 0;

  min-height: 0;

  display: flex;

  flex-direction: column;

  background: var(--wa-bg);
}

/* =========================================================
   CHAT HEADER
========================================================= */

.wa-chat-header {
  height: 72px;

  flex: 0 0 72px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 0 18px;

  background: #202c33;

  border-bottom:
    1px solid var(--wa-border);
}

.wa-header-left {
  display: flex;

  align-items: center;

  gap: 12px;

  min-width: 0;
}

.wa-header-avatar {
  width: 48px;
  height: 48px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #a855f7
    );

  color: #fff;

  font-weight: 700;

  font-size: 18px;
}

.wa-contact {
  min-width: 0;
}

.wa-contact-name {
  color: #e9edef;

  font-weight: 700;

  font-size: 16px;
}

.wa-contact-phone {
  margin-top: 3px;

  color: #8696a0;

  font-size: 12px;
}

.wa-header-actions {
  display: flex;
  gap: 6px;
}

/* =========================================================
   CHAT BODY
========================================================= */

.wa-chat-body {
  flex: 1;

  min-height: 0;

  overflow-y: auto;

  background:
    radial-gradient(
      circle at 20% 20%,
      rgba(255,255,255,.02),
      transparent 30%
    ),
    #0b141a;
}

.wa-messages-container {
  min-height: 100%;

  padding: 16px 24px 24px;

  display: flex;

  flex-direction: column;

  gap: 4px;
}

/* =========================================================
   DATE
========================================================= */

.wa-date-divider {
  align-self: center;

  margin: 10px 0;

  padding: 6px 12px;

  border-radius: 8px;

  background: #182229;

  color: #8696a0;

  font-size: 11px;
}

/* =========================================================
   MESSAGE ROW
========================================================= */

.wa-message-row {
  display: flex;

  width: 100%;

  margin: 2px 0;
}

.wa-message-row.incoming {
  justify-content: flex-start;
}

.wa-message-row.outgoing {
  justify-content: flex-end;
}

/* =========================================================
   BUBBLE
========================================================= */

.wa-bubble {
  position: relative;

  max-width: min(70%, 700px);

  padding: 9px 11px 6px;

  border-radius: 9px;

  color: #e9edef;

  font-size: 14px;

  line-height: 1.45;

  word-break: break-word;
}

.wa-message-row.incoming
.wa-bubble {
  background: #202c33;

  border-top-left-radius: 3px;
}

.wa-message-row.outgoing
.wa-bubble {
  background: #005c4b;

  border-top-right-radius: 3px;
}

.wa-message-body {
  white-space: pre-wrap;
}

.wa-message-meta {
  display: flex;

  align-items: center;

  justify-content: flex-end;

  gap: 4px;

  margin-top: 4px;

  font-size: 10px;

  color: #8696a0;
}

/* =========================================================
   MESSAGE STATUS
   IMPORTANT:
   Do NOT use negative letter-spacing here.
   It makes ✓✓ visually overlap and look like ✓.
========================================================= */

.wa-status {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-width: 20px;

  font-size: 14px;

  line-height: 1;

  letter-spacing: 0;

  white-space: nowrap;

  color: #aebac1;

  transition:
    color .15s ease,
    transform .15s ease;
}

/* =========================================================
   SENT
========================================================= */

.wa-status.is-sent {
  color: #aebac1;
}

/* =========================================================
   DELIVERED
========================================================= */

.wa-status.is-delivered {
  color: #aebac1;
}

/* =========================================================
   READ
========================================================= */

.wa-status.is-read {
  color: #53bdeb !important;
}

/* Extra protection if class gets changed dynamically */
.wa-status[data-status="read"] {
  color: #53bdeb !important;
}

/* =========================================================
   FAILED
========================================================= */

.wa-status.is-failed {
  color: #ff6b6b;

  letter-spacing: 0;
}

/* =========================================================
   EMPTY STATE
========================================================= */

.wa-empty {
  flex: 1;

  display: flex;

  align-items: center;

  justify-content: center;

  text-align: center;

  color: #8696a0;
}

.wa-empty-inner {
  max-width: 420px;
}

.wa-empty-icon {
  font-size: 54px;

  margin-bottom: 16px;
}

.wa-empty-title {
  color: #e9edef;

  font-size: 24px;

  font-weight: 600;

  margin-bottom: 8px;
}

.wa-empty-text {
  font-size: 14px;
}

/* =========================================================
   QUICK REPLIES
========================================================= */

.wa-quick-replies {
  flex: 0 0 auto;

  display: flex;

  gap: 8px;

  padding: 9px 16px;

  background: #202c33;

  overflow-x: auto;

  border-top:
    1px solid var(--wa-border);
}

.wa-quick-reply {
  border: 1px solid #3b4a54;

  background: #263640;

  color: #e9edef;

  border-radius: 18px;

  padding: 8px 14px;

  cursor: pointer;

  white-space: nowrap;

  font-size: 13px;
}

.wa-quick-reply:hover {
  background: #344955;
}

/* =========================================================
   INFO BAR
========================================================= */

.wa-info-bar {
  flex: 0 0 auto;

  text-align: center;

  padding: 7px;

  color: #8696a0;

  background: #202c33;

  font-size: 11px;

  border-top:
    1px solid var(--wa-border);
}

/* =========================================================
   COMPOSER
========================================================= */

.wa-composer {
  flex: 0 0 auto;

  padding: 10px 14px;

  background: #202c33;

  border-top:
    1px solid var(--wa-border);
}

.wa-message-form {
  display: flex;

  align-items: center;

  gap: 10px;
}

.wa-message-input {
  flex: 1;

  min-width: 0;

  height: 48px;

  border: 0;

  outline: none;

  resize: none;

  border-radius: 8px;

  background: #2a3942;

  color: #e9edef;

  padding: 14px 16px;

  font-size: 14px;
}

.wa-message-input::placeholder {
  color: #8696a0;
}

.wa-send-button {
  width: 48px;
  height: 48px;

  flex: 0 0 48px;

  border: 0;

  border-radius: 50%;

  background: #7c3aed;

  color: #fff;

  font-size: 21px;

  cursor: pointer;

  transition:
    transform .15s ease,
    opacity .15s ease;
}

.wa-send-button:hover {
  transform: scale(1.04);
}

.wa-send-button:disabled {
  opacity: .55;

  cursor: not-allowed;
}

/* =========================================================
   OPTIMISTIC MESSAGE
========================================================= */

.wa-message-row.optimistic {
  opacity: .75;
}

.wa-message-row.optimistic
.wa-status {
  color: #8696a0;
}

/* =========================================================
   DARK / LIGHT TOGGLE
========================================================= */

.aone-whatsapp-page.wa-light {
  --wa-bg: #efeae2;
  --wa-panel: #f0f2f5;
  --wa-panel-2: #ffffff;
  --wa-border: #d1d7db;
  --wa-text: #111b21;
  --wa-muted: #667781;
  --wa-input: #ffffff;
  --wa-hover: #f5f6f6;
}

.aone-whatsapp-page.wa-light
.wa-sidebar,
.aone-whatsapp-page.wa-light
.wa-chat-header,
.aone-whatsapp-page.wa-light
.wa-quick-replies,
.aone-whatsapp-page.wa-light
.wa-info-bar,
.aone-whatsapp-page.wa-light
.wa-composer {
  background: #f0f2f5;
}

.aone-whatsapp-page.wa-light
.wa-search,
.aone-whatsapp-page.wa-light
.wa-message-input {
  background: #fff;

  color: #111b21;
}

.aone-whatsapp-page.wa-light
.wa-chat-body {
  background: #efeae2;
}

.aone-whatsapp-page.wa-light
.wa-contact-name,
.aone-whatsapp-page.wa-light
.wa-conversation-name,
.aone-whatsapp-page.wa-light
.wa-empty-title {
  color: #111b21;
}

.aone-whatsapp-page.wa-light
.wa-conversation-preview,
.aone-whatsapp-page.wa-light
.wa-contact-phone {
  color: #667781;
}

.aone-whatsapp-page.wa-light
.wa-message-row.incoming
.wa-bubble {
  background: #fff;

  color: #111b21;
}

.aone-whatsapp-page.wa-light
.wa-message-row.outgoing
.wa-bubble {
  background: #d9fdd3;

  color: #111b21;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 850px) {

  .wa-shell {
    grid-template-columns:
      300px minmax(0, 1fr);
  }

  .wa-bubble {
    max-width: 82%;
  }

}

@media (max-width: 650px) {

  .wa-shell {
    grid-template-columns: 1fr;
  }

  .wa-sidebar {
    display: none;
  }

  .wa-bubble {
    max-width: 88%;
  }

}

</style>


<div
  class="aone-whatsapp-page"
  id="aoneWhatsappPage"
>

  <div class="wa-shell">

    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="wa-sidebar">

      <div class="wa-sidebar-header">

        <div class="wa-sidebar-title">
          WhatsApp Chats
        </div>

        <div class="wa-sidebar-actions">

          <button
            type="button"
            class="wa-icon-button"
            id="waSidebarTheme"
            title="Toggle theme"
          >
            🌙
          </button>

        </div>

      </div>


      <div class="wa-search-wrap">

        <input
          type="search"
          id="waChatSearch"
          class="wa-search"
          placeholder="Search chats"
          autocomplete="off"
        >

      </div>


      <div
        class="wa-conversation-list"
        id="waConversationList"
      >

        <% @conversations.each do |conversation| %>

          <% phone =
               conversation.phone_number.to_s
                 .gsub(/\D/, "") %>

          <% name =
               conversation.sender_name.presence ||
               phone %>

          <% unread =
               @unread_counts[conversation.phone_number].to_i %>

          <a
            class="wa-conversation-link <%= 'active' if @phone.to_s == phone %>"
            href="<%= admin_whatsapp_conversation_path(phone: phone) %>"
            data-phone="<%= phone %>"
            data-name="<%= name %>"
          >

            <div class="wa-avatar">
              <%= name.to_s.first.to_s.upcase %>
            </div>

            <div class="wa-conversation-content">

              <div class="wa-conversation-top">

                <div class="wa-conversation-name">
                  <%= name %>
                </div>

                <div class="wa-conversation-time">
                  <%= conversation.created_at&.strftime("%H:%M") %>
                </div>

              </div>

              <div class="wa-conversation-preview">

                <%= conversation.body.presence ||
                    "[#{conversation.message_type}]" %>

                <% if unread.positive? %>

                  <span class="wa-unread">
                    <%= unread %>
                  </span>

                <% end %>

              </div>

            </div>

          </a>

        <% end %>

      </div>

    </aside>


    <!-- =====================================================
         CHAT
    ====================================================== -->

    <section class="wa-chat">

      <% if @phone.present? %>

        <% conversation_messages =
             @messages.to_a %>

        <% contact_name =
             @user&.name.presence ||
             conversation_messages.last&.sender_name.presence ||
             @phone %>


        <!-- =================================================
             HEADER
        ================================================== -->

        <header class="wa-chat-header">

          <div class="wa-header-left">

            <div class="wa-header-avatar">
              <%= contact_name.to_s.first.to_s.upcase %>
            </div>

            <div class="wa-contact">

              <div class="wa-contact-name">
                <%= contact_name %>
              </div>

              <div class="wa-contact-phone">
                <%= @phone %> · Support Team
              </div>

            </div>

          </div>


          <div class="wa-header-actions">

            <button
              type="button"
              class="wa-icon-button"
              id="waSearchMessages"
              title="Search messages"
            >
              🔍
            </button>

            <button
              type="button"
              class="wa-icon-button"
              id="waHeaderTheme"
              title="Toggle theme"
            >
              🌙
            </button>

            <button
              type="button"
              class="wa-icon-button"
              id="waMoreOptions"
              title="More"
            >
              ⋮
            </button>

          </div>

        </header>


        <!-- =================================================
             MESSAGES
        ================================================== -->

        <main
          class="wa-chat-body"
          id="waChatBody"
        >

          <div
            class="wa-messages-container"
            id="waMessagesContainer"
          >

            <% previous_date = nil %>

            <% conversation_messages.each do |message| %>

              <% current_date =
                   (
                     message.whatsapp_timestamp ||
                     message.created_at ||
                     Time.current
                   ).to_date %>

              <% if previous_date != current_date %>

                <div class="wa-date-divider">

                  <%= current_date == Date.current ?
                        "Today" :
                        current_date.strftime("%d %b %Y") %>

                </div>

                <% previous_date = current_date %>

              <% end %>


              <% outgoing =
                   message.direction == "outgoing" %>

              <% status =
                   message.status.to_s.downcase.strip %>

              <% status_icon =
                   case status
                   when "read", "delivered"
                     "✓✓"
                   when "failed"
                     "!"
                   else
                     "✓"
                   end %>


              <div
                class="wa-message-row <%= outgoing ? 'outgoing' : 'incoming' %>"
                data-message-id="<%= message.id %>"
                data-client-message-id="<%= message.metadata&.dig('client_message_id') %>"
              >

                <div class="wa-bubble">

                  <div class="wa-message-body">
                    <%= message.body %>
                  </div>


                  <div class="wa-message-meta">

                    <span>
                      <%= (
                        message.whatsapp_timestamp ||
                        message.created_at ||
                        Time.current
                      ).strftime("%H:%M") %>
                    </span>


                    <% if outgoing %>

                      <span
                        class="wa-status <%= case status
                          when 'read'
                            'is-read'
                          when 'delivered'
                            'is-delivered'
                          when 'failed'
                            'is-failed'
                          else
                            'is-sent'
                        end %>"
                        data-status="<%= status.presence || 'sent' %>"
                        title="<%= status.present? ? status.capitalize : 'Sent' %>"
                      >
                        <%= status_icon %>
                      </span>

                    <% end %>

                  </div>

                </div>

              </div>

            <% end %>

          </div>

        </main>


        <!-- =================================================
             QUICK REPLIES
        ================================================== -->

        <div class="wa-quick-replies">

          <% [
            "👋 Hello",
            "Query",
            "Thank you",
            "Shortly"
          ].each do |reply| %>

            <button
              type="button"
              class="wa-quick-reply"
              data-message="<%= reply.sub(/\A👋 /, '') %>"
            >
              <%= reply %>
            </button>

          <% end %>

        </div>


        <!-- =================================================
             INFO
        ================================================== -->

        <div class="wa-info-bar">
          Messages are sent through official WhatsApp Business API.
        </div>


        <!-- =================================================
             COMPOSER
        ================================================== -->

        <div class="wa-composer">

          <%= form_with(
                url: admin_send_whatsapp_message_path(
                  phone: @phone
                ),
                method: :post,
                local: true,
                class: "wa-message-form",
                id: "waMessageForm"
              ) do |form| %>

            <%= form.text_area(
                  :body,
                  id: "waMessageInput",
                  class: "wa-message-input",
                  placeholder: "Type a message",
                  rows: 1,
                  autocomplete: "off"
                ) %>

            <button
              type="submit"
              class="wa-send-button"
              id="waSendButton"
              title="Send"
            >
              ➤
            </button>

          <% end %>

        </div>

      <% else %>

        <!-- =================================================
             EMPTY
        ================================================== -->

        <div class="wa-empty">

          <div class="wa-empty-inner">

            <div class="wa-empty-icon">
              💬
            </div>

            <div class="wa-empty-title">
              WhatsApp Chats
            </div>

            <div class="wa-empty-text">
              Select a conversation to start chatting.
            </div>

          </div>

        </div>

      <% end %>

    </section>

  </div>

</div>


<script nonce="<%= content_security_policy_nonce %>">

(() => {

  "use strict";


  /* =======================================================
     A ONE GS CENTER
     WHATSAPP INBOX - SINGLETON LIVE ENGINE
  ======================================================== */

  const GLOBAL_KEY =
    "__AONE_GS_WHATSAPP_INBOX__";


  /* =======================================================
     DESTROY PREVIOUS INSTANCE
  ======================================================== */

  const previousInstance =
    window[GLOBAL_KEY];

  if (
    previousInstance &&
    typeof previousInstance.destroy === "function"
  ) {

    previousInstance.destroy();

  }


  /* =======================================================
     ELEMENTS
  ======================================================== */

  const page =
    document.getElementById(
      "aoneWhatsappPage"
    );


  if (!page) {
    return;
  }


  const chatBody =
    document.getElementById(
      "waChatBody"
    );


  const messagesContainer =
    document.getElementById(
      "waMessagesContainer"
    );


  const form =
    document.getElementById(
      "waMessageForm"
    );


  const input =
    document.getElementById(
      "waMessageInput"
    );


  const sendButton =
    document.getElementById(
      "waSendButton"
    );


  const searchInput =
    document.getElementById(
      "waChatSearch"
    );


  const conversationList =
    document.getElementById(
      "waConversationList"
    );


  /* =======================================================
     CURRENT PHONE
  ======================================================== */

  const currentPhone =
    "<%= j(@phone.to_s) %>";


  /* =======================================================
     STATE
  ======================================================== */

  let destroyed =
    false;


  let messageTimer =
    null;


  let listTimer =
    null;


  let messageRequest =
    null;


  let listRequest =
    null;


  let latestMessageId =
    <%= @messages.to_a.last&.id.to_i %>;


  let statusCursor =
    "<%= j(
      @messages.to_a
        .map(&:status_updated_at)
        .compact
        .max
        &.iso8601(6)
        .to_s
    ) %>";


  /* =======================================================
     CSRF
  ======================================================== */

  const csrfToken =
    document.querySelector(
      'meta[name="csrf-token"]'
    )?.content || "";


  /* =======================================================
     CLEANUP
  ======================================================== */

  const cleanupFunctions = [];


  function registerCleanup(fn) {

    cleanupFunctions.push(fn);

  }


  function destroy() {

    if (destroyed) {
      return;
    }


    destroyed = true;


    if (messageTimer) {

      clearTimeout(
        messageTimer
      );

      messageTimer = null;

    }


    if (listTimer) {

      clearTimeout(
        listTimer
      );

      listTimer = null;

    }


    try {
      messageRequest?.abort();
    } catch (_) {}


    try {
      listRequest?.abort();
    } catch (_) {}


    messageRequest = null;
    listRequest = null;


    cleanupFunctions
      .splice(0)
      .forEach(
        cleanup => {

          try {
            cleanup();
          } catch (_) {}

        }
      );


    if (
      window[GLOBAL_KEY] === api
    ) {

      window[GLOBAL_KEY] = null;

    }

  }


  /* =======================================================
     PUBLIC API
  ======================================================== */

  const api = {
    destroy
  };


  window[GLOBAL_KEY] =
    api;


  /* =======================================================
     TIME
  ======================================================== */

  function formatTime(value) {

    if (!value) {
      return "";
    }


    const date =
      new Date(value);


    if (
      Number.isNaN(
        date.getTime()
      )
    ) {

      return "";

    }


    return date.toLocaleTimeString(
      [],
      {
        hour: "2-digit",
        minute: "2-digit"
      }
    );

  }


  /* =======================================================
     STATUS UI
     ALWAYS NORMALIZE META/DB STATUS
  ======================================================== */

  function statusDetails(status) {

    const normalized =
      String(
        status || "sent"
      )
      .toLowerCase()
      .trim();


    switch (normalized) {

      case "read":

        return {
          icon: "✓✓",
          className: "is-read",
          title: "Read"
        };


      case "delivered":

        return {
          icon: "✓✓",
          className: "is-delivered",
          title: "Delivered"
        };


      case "failed":

        return {
          icon: "!",
          className: "is-failed",
          title: "Failed"
        };


      case "sent":

      default:

        return {
          icon: "✓",
          className: "is-sent",
          title: "Sent"
        };

    }

  }


  /* =======================================================
     FIND MESSAGE ROW
  ======================================================== */

  function findMessageRow(messageId) {

    if (
      !messagesContainer ||
      messageId == null
    ) {

      return null;

    }


    const wantedId =
      String(messageId);


    return Array
      .from(
        messagesContainer.querySelectorAll(
          ".wa-message-row"
        )
      )
      .find(
        row =>
          String(
            row.dataset.messageId || ""
          ) === wantedId
      ) || null;

  }


  /* =======================================================
     UPDATE MESSAGE STATUS
  ======================================================== */

  function updateMessageStatus(message) {

    if (!message?.id) {
      return false;
    }


    const messageId =
      String(message.id);


    const row =
      findMessageRow(
        messageId
      );


    if (!row) {
      return false;
    }


    const outgoing =
      message.direction === "outgoing" ||
      row.classList.contains("outgoing");


    if (!outgoing) {
      return false;
    }


    const meta =
      row.querySelector(
        ".wa-message-meta"
      );


    if (!meta) {
      return false;
    }


    let statusElement =
      row.querySelector(
        ".wa-status"
      );


    /* -----------------------------------------------------
       Create status element if missing.
    ----------------------------------------------------- */

    if (!statusElement) {

      statusElement =
        document.createElement(
          "span"
        );


      statusElement.className =
        "wa-status";


      meta.appendChild(
        statusElement
      );

    }


    const normalizedStatus =
      String(
        message.status || "sent"
      )
      .toLowerCase()
      .trim();


    const details =
      statusDetails(
        normalizedStatus
      );


    statusElement.textContent =
      details.icon;


    statusElement.className =
      `wa-status ${details.className}`;


    statusElement.dataset.status =
      normalizedStatus;


    statusElement.title =
      details.title;


    /*
     * Force browser repaint so dynamic status
     * changes are immediately visible.
     */

    void statusElement.offsetWidth;


    return true;

  }


  /* =======================================================
     CREATE MESSAGE
  ======================================================== */

  function createMessageElement(message) {

    const row =
      document.createElement(
        "div"
      );


    const outgoing =
      message.direction ===
      "outgoing";


    row.className =
      `wa-message-row ${
        outgoing
          ? "outgoing"
          : "incoming"
      }`;


    row.dataset.messageId =
      String(
        message.id ?? ""
      );


    if (
      message.client_message_id
    ) {

      row.dataset.clientMessageId =
        String(
          message.client_message_id
        );

    }


    const bubble =
      document.createElement(
        "div"
      );


    bubble.className =
      "wa-bubble";


    const body =
      document.createElement(
        "div"
      );


    body.className =
      "wa-message-body";


    body.textContent =
      message.body || "";


    const meta =
      document.createElement(
        "div"
      );


    meta.className =
      "wa-message-meta";


    const time =
      document.createElement(
        "span"
      );


    time.textContent =
      formatTime(
        message.whatsapp_timestamp ||
        message.created_at
      );


    meta.appendChild(
      time
    );


    if (outgoing) {

      const status =
        document.createElement(
          "span"
        );


      const normalizedStatus =
        String(
          message.status || "sent"
        )
        .toLowerCase()
        .trim();


      const details =
        statusDetails(
          normalizedStatus
        );


      status.className =
        `wa-status ${details.className}`;


      status.textContent =
        details.icon;


      status.dataset.status =
        normalizedStatus;


      status.title =
        details.title;


      meta.appendChild(
        status
      );

    }


    bubble.appendChild(
      body
    );


    bubble.appendChild(
      meta
    );


    row.appendChild(
      bubble
    );


    return row;

  }


  /* =======================================================
     UPSERT MESSAGE
     
     Important:
     Existing messages must NOT be inserted again.
     Status changes must update the existing row.
  ======================================================== */

  function upsertMessage(message) {

    if (
      !messagesContainer ||
      !message
    ) {

      return;

    }


    const messageId =
      message.id != null
        ? String(message.id)
        : "";


    /* -----------------------------------------------------
       Existing real message
    ----------------------------------------------------- */

    let existingRow = null;


    if (
      messageId &&
      !messageId.startsWith(
        "optimistic-"
      )
    ) {

      existingRow =
        findMessageRow(
          messageId
        );

    }


    if (existingRow) {

      updateMessageStatus(
        message
      );

      return;

    }


    /* -----------------------------------------------------
       Optimistic message reconciliation
    ----------------------------------------------------- */

    if (
      message.client_message_id
    ) {

      const clientId =
        String(
          message.client_message_id
        );


      const optimistic =
        Array
          .from(
            messagesContainer.querySelectorAll(
              ".wa-message-row"
            )
          )
          .find(
            row =>
              String(
                row.dataset.clientMessageId || ""
              ) === clientId
          );


      if (optimistic) {

        optimistic.dataset.messageId =
          messageId;


        optimistic.classList.remove(
          "optimistic"
        );


        updateMessageStatus(
          message
        );


        return;

      }

    }


    /* -----------------------------------------------------
       Final duplicate protection
    ----------------------------------------------------- */

    if (
      messageId &&
      findMessageRow(
        messageId
      )
    ) {

      updateMessageStatus(
        message
      );

      return;

    }


    /* -----------------------------------------------------
       Create new message
    ----------------------------------------------------- */

    const element =
      createMessageElement(
        message
      );


    messagesContainer.appendChild(
      element
    );


    /*
     * Apply status again after insertion.
     * This keeps status handling identical for
     * server-rendered and dynamically inserted rows.
     */

    updateMessageStatus(
      message
    );

  }


  /* =======================================================
     SCROLL
  ======================================================== */

  function scrollToBottom(
    force = false
  ) {

    if (!chatBody) {
      return;
    }


    const distance =
      chatBody.scrollHeight -
      chatBody.scrollTop -
      chatBody.clientHeight;


    if (
      force ||
      distance < 220
    ) {

      chatBody.scrollTop =
        chatBody.scrollHeight;

    }

  }


  /* =======================================================
     UPDATE CURSORS
  ======================================================== */

  function updateCursors(
    messages,
    data
  ) {

    if (
      Array.isArray(messages)
    ) {

      messages.forEach(
        message => {

          if (
            Number(message.id) >
            Number(latestMessageId)
          ) {

            latestMessageId =
              Number(
                message.id
              );

          }


          if (
            message.status_updated_at
          ) {

            const oldTime =
              statusCursor
                ? new Date(
                    statusCursor
                  ).getTime()
                : 0;


            const newTime =
              new Date(
                message.status_updated_at
              ).getTime();


            if (
              Number.isFinite(newTime) &&
              newTime >= oldTime
            ) {

              statusCursor =
                message.status_updated_at;

            }

          }

        }
      );

    }


    if (
      data?.latest_id &&
      Number(data.latest_id) >
      Number(latestMessageId)
    ) {

      latestMessageId =
        Number(
          data.latest_id
        );

    }


    if (
      data?.status_cursor
    ) {

      const serverTime =
        new Date(
          data.status_cursor
        ).getTime();


      const localTime =
        statusCursor
          ? new Date(
              statusCursor
            ).getTime()
          : 0;


      if (
        Number.isFinite(serverTime) &&
        serverTime > localTime
      ) {

        statusCursor =
          data.status_cursor;

      }

    }

  }


  /* =======================================================
     POLL MESSAGES
  ======================================================== */

  async function pollMessages() {

    if (
      destroyed ||
      !currentPhone ||
      document.hidden
    ) {

      return;

    }


    if (messageRequest) {
      return;
    }


    const controller =
      new AbortController();


    messageRequest =
      controller;


    try {

      const params =
        new URLSearchParams();


      params.set(
        "after_id",
        String(
          latestMessageId
        )
      );


      if (statusCursor) {

        params.set(
          "status_after",
          statusCursor
        );

      }


      const url =
        "<%= admin_whatsapp_conversation_messages_path(
              phone: "__PHONE__"
            ) %>"
          .replace(
            "__PHONE__",
            encodeURIComponent(
              currentPhone
            )
          ) +
        "?" +
        params.toString();


      const response =
        await fetch(
          url,
          {
            method: "GET",

            cache: "no-store",

            signal:
              controller.signal,

            headers: {
              "Accept":
                "application/json",

              "Cache-Control":
                "no-cache"
            }
          }
        );


      if (!response.ok) {

        console.warn(
          "[WhatsApp polling] HTTP",
          response.status
        );

        return;

      }


      const data =
        await response.json();


      if (destroyed) {
        return;
      }


      const incoming =
        Array.isArray(
          data.messages
        )
          ? data.messages
          : [];


      const wasNearBottom =
        chatBody
          ? (
              chatBody.scrollHeight -
              chatBody.scrollTop -
              chatBody.clientHeight
            ) < 220
          : true;


      incoming.forEach(
        message => {

          upsertMessage(
            message
          );

        }
      );


      updateCursors(
        incoming,
        data
      );


      if (
        incoming.length &&
        wasNearBottom
      ) {

        scrollToBottom(
          true
        );

      }

    } catch (error) {

      if (
        error?.name !==
        "AbortError"
      ) {

        console.error(
          "[WhatsApp polling]",
          error
        );

      }

    } finally {

      if (
        messageRequest ===
        controller
      ) {

        messageRequest =
          null;

      }

    }

  }


  /* =======================================================
     MESSAGE POLLING SCHEDULER
  ======================================================== */

  function scheduleMessagePoll(
    delay = 2000
  ) {

    if (destroyed) {
      return;
    }


    if (messageTimer) {

      clearTimeout(
        messageTimer
      );

    }


    messageTimer =
      setTimeout(
        async () => {

          messageTimer =
            null;


          if (
            destroyed ||
            document.hidden
          ) {

            return;

          }


          await pollMessages();


          if (!destroyed) {

            scheduleMessagePoll(
              2000
            );

          }

        },
        delay
      );

  }


  /* =======================================================
     CONVERSATION LIST
  ======================================================== */

  async function pollConversationList() {

    if (
      destroyed ||
      !conversationList ||
      document.hidden
    ) {

      return;

    }


    if (listRequest) {
      return;
    }


    const controller =
      new AbortController();


    listRequest =
      controller;


    try {

      const url =
        "<%= admin_whatsapp_path(
              format: :json
            ) %>";


      const response =
        await fetch(
          url,
          {
            method: "GET",

            cache: "no-store",

            signal:
              controller.signal,

            headers: {
              "Accept":
                "application/json",

              "Cache-Control":
                "no-cache"
            }
          }
        );


      if (!response.ok) {

        console.warn(
          "[WhatsApp conversation polling] HTTP",
          response.status
        );

        return;

      }


      const data =
        await response.json();


      if (destroyed) {
        return;
      }


      renderConversationList(
        data.conversations || []
      );

    } catch (error) {

      if (
        error?.name !==
        "AbortError"
      ) {

        console.error(
          "[WhatsApp conversation polling]",
          error
        );

      }

    } finally {

      if (
        listRequest ===
        controller
      ) {

        listRequest =
          null;

      }

    }

  }


  /* =======================================================
     CONVERSATION LIST SCHEDULER
  ======================================================== */

  function scheduleListPoll(
    delay = 8000
  ) {

    if (destroyed) {
      return;
    }


    if (listTimer) {

      clearTimeout(
        listTimer
      );

    }


    listTimer =
      setTimeout(
        async () => {

          listTimer =
            null;


          if (
            destroyed ||
            document.hidden
          ) {

            return;

          }


          await pollConversationList();


          if (!destroyed) {

            scheduleListPoll(
              8000
            );

          }

        },
        delay
      );

  }


  /* =======================================================
     RENDER CONVERSATION LIST
  ======================================================== */

  function renderConversationList(
    conversations
  ) {

    if (!conversationList) {
      return;
    }


    const fragment =
      document.createDocumentFragment();


    conversations.forEach(
      conversation => {

        const phone =
          String(
            conversation.phone_number ||
            ""
          )
          .replace(
            /\D/g,
            ""
          );


        const name =
          conversation.sender_name ||
          phone ||
          "Unknown";


        const link =
          document.createElement(
            "a"
          );


        link.className =
          "wa-conversation-link";


        if (
          phone ===
          currentPhone
        ) {

          link.classList.add(
            "active"
          );

        }


        link.href =
          "<%= admin_whatsapp_conversation_path(
                phone: "__PHONE__"
              ) %>"
            .replace(
              "__PHONE__",
              encodeURIComponent(
                phone
              )
            );


        link.dataset.phone =
          phone;


        link.dataset.name =
          name;


        const avatar =
          document.createElement(
            "div"
          );


        avatar.className =
          "wa-avatar";


        avatar.textContent =
          name
            .charAt(0)
            .toUpperCase();


        const content =
          document.createElement(
            "div"
          );


        content.className =
          "wa-conversation-content";


        const top =
          document.createElement(
            "div"
          );


        top.className =
          "wa-conversation-top";


        const nameElement =
          document.createElement(
            "div"
          );


        nameElement.className =
          "wa-conversation-name";


        nameElement.textContent =
          name;


        const time =
          document.createElement(
            "div"
          );


        time.className =
          "wa-conversation-time";


        time.textContent =
          formatTime(
            conversation.created_at
          );


        top.appendChild(
          nameElement
        );


        top.appendChild(
          time
        );


        const preview =
          document.createElement(
            "div"
          );


        preview.className =
          "wa-conversation-preview";


        preview.textContent =
          conversation.body ||
          `[${conversation.message_type || "message"}]`;


        if (
          Number(
            conversation.unread_count || 0
          ) > 0
        ) {

          const unread =
            document.createElement(
              "span"
            );


          unread.className =
            "wa-unread";


          unread.textContent =
            conversation.unread_count;


          preview.appendChild(
            document.createTextNode(
              " "
            )
          );


          preview.appendChild(
            unread
          );

        }


        content.appendChild(
          top
        );


        content.appendChild(
          preview
        );


        link.appendChild(
          avatar
        );


        link.appendChild(
          content
        );


        fragment.appendChild(
          link
        );

      }
    );


    conversationList.replaceChildren(
      fragment
    );


    applyConversationSearch();

  }


  /* =======================================================
     CONVERSATION SEARCH
  ======================================================== */

  function applyConversationSearch() {

    if (!searchInput) {
      return;
    }


    const query =
      searchInput.value
        .toLowerCase()
        .trim();


    conversationList
      ?.querySelectorAll(
        ".wa-conversation-link"
      )
      .forEach(
        link => {

          const text =
            (
              link.dataset.name ||
              ""
            )
            .toLowerCase();


          const phone =
            (
              link.dataset.phone ||
              ""
            )
            .toLowerCase();


          link.style.display =
            !query ||
            text.includes(query) ||
            phone.includes(query)
              ? ""
              : "none";

        }
      );

  }


  /* =======================================================
     SEND MESSAGE
  ======================================================== */

  async function sendMessage(
    event
  ) {

    event.preventDefault();


    const body =
      input?.value
        .toString()
        .trim();


    if (!body) {
      return;
    }


    const clientMessageId =
      `client-${Date.now()}-${Math.random()
        .toString(36)
        .slice(2)}`;


    const optimistic = {

      id:
        `optimistic-${clientMessageId}`,

      direction:
        "outgoing",

      body:
        body,

      status:
        "sent",

      created_at:
        new Date().toISOString(),

      whatsapp_timestamp:
        new Date().toISOString(),

      client_message_id:
        clientMessageId

    };


    const element =
      createMessageElement(
        optimistic
      );


    element.classList.add(
      "optimistic"
    );


    messagesContainer?.appendChild(
      element
    );


    scrollToBottom(
      true
    );


    input.value =
      "";


    if (sendButton) {
      sendButton.disabled =
        true;
    }


    try {

      const response =
        await fetch(
          form.action,
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",

              "Accept":
                "application/json",

              "X-CSRF-Token":
                csrfToken
            },

            body:
              JSON.stringify({

                body:
                  body,

                client_message_id:
                  clientMessageId

              })
          }
        );


      const data =
        await response.json();


      if (
        !response.ok ||
        !data.success
      ) {

        throw new Error(
          data.error ||
          "Unable to send message."
        );

      }


      const optimisticRow =
        messagesContainer?.querySelector(
          `[data-client-message-id="${CSS.escape(
            clientMessageId
          )}"]`
        );


      if (optimisticRow) {

        optimisticRow.remove();

      }


      upsertMessage(
        data.message
      );


      if (
        Number(data.message.id) >
        Number(latestMessageId)
      ) {

        latestMessageId =
          Number(
            data.message.id
          );

      }


      if (
        data.message.status_updated_at
      ) {

        statusCursor =
          data.message.status_updated_at;

      }


      scrollToBottom(
        true
      );

    } catch (error) {

      console.error(
        "[WhatsApp send]",
        error
      );


      const optimisticRow =
        messagesContainer?.querySelector(
          `[data-client-message-id="${CSS.escape(
            clientMessageId
          )}"]`
        );


      if (optimisticRow) {

        const status =
          optimisticRow.querySelector(
            ".wa-status"
          );


        if (status) {

          status.textContent =
            "!";


          status.className =
            "wa-status is-failed";


          status.dataset.status =
            "failed";


          status.title =
            "Failed";

        }


        optimisticRow.classList.remove(
          "optimistic"
        );

      }


      alert(
        error.message ||
        "Unable to send message."
      );

    } finally {

      if (sendButton) {

        sendButton.disabled =
          false;

      }


      input?.focus();

    }

  }


  /* =======================================================
     EVENT LISTENERS
  ======================================================== */

  if (form) {

    form.addEventListener(
      "submit",
      sendMessage
    );


    registerCleanup(
      () => {

        form.removeEventListener(
          "submit",
          sendMessage
        );

      }
    );

  }


  /* =======================================================
     ENTER TO SEND
  ======================================================== */

  function handleInputKeydown(
    event
  ) {

    if (
      event.key === "Enter" &&
      !event.shiftKey
    ) {

      event.preventDefault();

      form?.requestSubmit();

    }

  }


  input?.addEventListener(
    "keydown",
    handleInputKeydown
  );


  registerCleanup(
    () => {

      input?.removeEventListener(
        "keydown",
        handleInputKeydown
      );

    }
  );


  /* =======================================================
     QUICK REPLIES
  ======================================================== */

  function handleQuickReplyClick(
    event
  ) {

    const button =
      event.currentTarget;


    if (!input) {
      return;
    }


    input.value =
      button.dataset.message ||
      "";


    input.focus();

  }


  document
    .querySelectorAll(
      ".wa-quick-reply"
    )
    .forEach(
      button => {

        button.addEventListener(
          "click",
          handleQuickReplyClick
        );


        registerCleanup(
          () => {

            button.removeEventListener(
              "click",
              handleQuickReplyClick
            );

          }
        );

      }
    );


  /* =======================================================
     CHAT SEARCH
  ======================================================== */

  if (searchInput) {

    searchInput.addEventListener(
      "input",
      applyConversationSearch
    );


    registerCleanup(
      () => {

        searchInput.removeEventListener(
          "input",
          applyConversationSearch
        );

      }
    );

  }


  /* =======================================================
     MESSAGE SEARCH
  ======================================================== */

  const messageSearchButton =
    document.getElementById(
      "waSearchMessages"
    );


  function handleMessageSearch() {

    const query =
      prompt(
        "Search messages"
      );


    if (!query) {
      return;
    }


    const wanted =
      query
        .toLowerCase()
        .trim();


    document
      .querySelectorAll(
        ".wa-message-row"
      )
      .forEach(
        row => {

          const text =
            row.textContent
              .toLowerCase();


          row.style.display =
            text.includes(wanted)
              ? ""
              : "none";

        }
      );

  }


  messageSearchButton?.addEventListener(
    "click",
    handleMessageSearch
  );


  registerCleanup(
    () => {

      messageSearchButton?.removeEventListener(
        "click",
        handleMessageSearch
      );

    }
  );


  /* =======================================================
     MORE OPTIONS
  ======================================================== */

  const moreButton =
    document.getElementById(
      "waMoreOptions"
    );


  function handleMoreOptions() {

    alert(
      "WhatsApp Business inbox"
    );

  }


  moreButton?.addEventListener(
    "click",
    handleMoreOptions
  );


  registerCleanup(
    () => {

      moreButton?.removeEventListener(
        "click",
        handleMoreOptions
      );

    }
  );


  /* =======================================================
     THEME
  ======================================================== */

  function updateThemeButtons() {

    const isLight =
      page.classList.contains(
        "wa-light"
      );


    const icon =
      isLight
        ? "🌙"
        : "☀️";


    document
      .querySelectorAll(
        "#waHeaderTheme, #waSidebarTheme"
      )
      .forEach(
        button => {

          button.textContent =
            icon;

        }
      );

  }


  function applyTheme() {

    const saved =
      localStorage.getItem(
        "aone-whatsapp-theme"
      );


    if (
      saved === "light"
    ) {

      page.classList.add(
        "wa-light"
      );

    } else {

      page.classList.remove(
        "wa-light"
      );

    }


    updateThemeButtons();

  }


  function toggleTheme() {

    page.classList.toggle(
      "wa-light"
    );


    localStorage.setItem(
      "aone-whatsapp-theme",
      page.classList.contains(
        "wa-light"
      )
        ? "light"
        : "dark"
    );


    updateThemeButtons();

  }


  const themeButtons =
    document.querySelectorAll(
      "#waHeaderTheme, #waSidebarTheme"
    );


  themeButtons.forEach(
    button => {

      button.addEventListener(
        "click",
        toggleTheme
      );


      registerCleanup(
        () => {

          button.removeEventListener(
            "click",
            toggleTheme
          );

        }
      );

    }
  );


  applyTheme();


  /* =======================================================
     VISIBILITY HANDLING
  ======================================================== */

  function handleVisibilityChange() {

    if (destroyed) {
      return;
    }


    if (document.hidden) {

      if (messageTimer) {

        clearTimeout(
          messageTimer
        );

        messageTimer = null;

      }


      if (listTimer) {

        clearTimeout(
          listTimer
        );

        listTimer = null;

      }


      try {
        messageRequest?.abort();
      } catch (_) {}


      try {
        listRequest?.abort();
      } catch (_) {}


      return;

    }


    /* -----------------------------------------------------
       Tab visible again
    ----------------------------------------------------- */

    if (currentPhone) {

      pollMessages()
        .finally(
          () => {

            if (!destroyed) {

              scheduleMessagePoll(
                2000
              );

            }

          }
        );

    }


    pollConversationList()
      .finally(
        () => {

          if (!destroyed) {

            scheduleListPoll(
              8000
            );

          }

        }
      );

  }


  document.addEventListener(
    "visibilitychange",
    handleVisibilityChange
  );


  registerCleanup(
    () => {

      document.removeEventListener(
        "visibilitychange",
        handleVisibilityChange
      );

    }
  );


  /* =======================================================
     INITIAL SCROLL
  ======================================================== */

  setTimeout(
    () => {

      if (!destroyed) {

        scrollToBottom(
          true
        );

      }

    },
    50
  );


  /* =======================================================
     START LIVE ENGINE
  ======================================================== */

  if (currentPhone) {

    pollMessages()
      .finally(
        () => {

          if (!destroyed) {

            scheduleMessagePoll(
              2000
            );

          }

        }
      );

  }


  pollConversationList()
    .finally(
      () => {

        if (!destroyed) {

          scheduleListPoll(
            8000
          );

        }

      }
    );


  /* =======================================================
     DEBUG
  ======================================================== */

  console.log(
    "[A ONE WhatsApp] Live engine started",
    {
      phone:
        currentPhone || null,

      latestMessageId:
        latestMessageId,

      statusCursor:
        statusCursor || null
    }
  );


})();

</script>