<% content_for :title, "WhatsApp Chats" %>

<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   A ONE GS CENTER
   WHATSAPP WEB STYLE ADMIN INBOX
========================================================= */

:root {
  --wa-bg: #0b141a;
  --wa-panel: #202c33;
  --wa-panel-2: #111b21;
  --wa-border: #344047;
  --wa-text: #e9edef;
  --wa-muted: #8696a0;
  --wa-green: #005c4b;
  --wa-green-2: #008069;
  --wa-blue: #53bdeb;
  --wa-input: #2a3942;
  --wa-hover: #202c33;
}

/* =========================================================
   FULL SCREEN
========================================================= */

.aone-whatsapp-page {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999;

  background: var(--wa-bg);

  overflow: hidden;
}

/* =========================================================
   SHELL
========================================================= */

.wa-shell {
  width: 100%;
  height: 100%;

  display: grid;

  grid-template-columns:
    370px minmax(0, 1fr);

  overflow: hidden;

  background: var(--wa-bg);
}

/* =========================================================
   SIDEBAR
========================================================= */
/* =========================================================
   SIDEBAR
========================================================= */

.wa-sidebar {
  min-width: 0;
  min-height: 0;
  height: 100%;

  display: flex;
  flex-direction: column;

  background: #111b21;

  border-right: 1px solid var(--wa-border);

  overflow: hidden;
}

.wa-sidebar-header {
  flex: 0 0 72px;
  height: 72px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 18px;

  background: #202c33;

  border-bottom: 1px solid var(--wa-border);
}

.wa-sidebar-title {
  color: #fff;

  font-size: 22px;
  font-weight: 700;
}

.wa-sidebar-actions {
  display: flex;
  gap: 10px;
}

/* =========================================================
   SEARCH
========================================================= */

.wa-search-wrap {
  flex: 0 0 auto;

  padding: 10px;

  background: #111b21;
}

.wa-search {
  width: 100%;
  height: 44px;

  box-sizing: border-box;

  border: 0;
  border-radius: 8px;

  outline: none;

  background: #202c33;
  color: #e9edef;

  padding: 0 16px;

  font-size: 14px;
}

.wa-search::placeholder {
  color: #8696a0;
}

/* =========================================================
   CONVERSATION LIST
   IMPORTANT:
   height: 0 + flex: 1 allows proper scrolling
========================================================= */

.wa-conversation-list {
  flex: 1 1 auto;

  min-width: 0;
  min-height: 0;

  height: 0;

  overflow-y: auto;
  overflow-x: hidden;

  overscroll-behavior: contain;

  -webkit-overflow-scrolling: touch;

  scrollbar-width: thin;
  scrollbar-color: #3b4a54 transparent;
}

.wa-conversation-list::-webkit-scrollbar {
  width: 7px;
}

.wa-conversation-list::-webkit-scrollbar-track {
  background: transparent;
}

.wa-conversation-list::-webkit-scrollbar-thumb {
  background: #3b4a54;
  border-radius: 10px;
}

.wa-conversation-list::-webkit-scrollbar-thumb:hover {
  background: #52636e;
}

/* =========================================================
   CONVERSATION ITEM
========================================================= */

.wa-conversation-link {
  display: flex;

  align-items: center;

  gap: 12px;

  min-height: 78px;

  padding: 10px 14px;

  box-sizing: border-box;

  text-decoration: none;

  color: inherit;

  border-bottom: 1px solid rgba(255,255,255,.04);

  cursor: pointer;

  transition: background .15s ease;
}

.wa-conversation-link:hover {
  background: #202c33;
}

.wa-conversation-link.active {
  background: #2a3942;
}

/* =========================================================
   AVATAR
========================================================= */

.wa-avatar {
  width: 54px;
  height: 54px;

  flex: 0 0 54px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #a855f7
    );

  color: #fff;

  font-size: 21px;
  font-weight: 700;
}

/* =========================================================
   CONTENT
========================================================= */

.wa-conversation-content {
  flex: 1 1 auto;

  min-width: 0;
  overflow: hidden;
}

.wa-conversation-top {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 10px;

  min-width: 0;
}

.wa-conversation-name {
  min-width: 0;

  color: #e9edef;

  font-weight: 700;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}

.wa-conversation-time {
  flex: 0 0 auto;

  color: #8696a0;

  font-size: 12px;

  white-space: nowrap;
}

/* =========================================================
   PREVIEW
   Example:
   You: Payment successful
   Rahul: Sir course kab start hoga?
========================================================= */

.wa-conversation-preview {
  margin-top: 5px;

  display: flex;
  align-items: center;

  min-width: 0;

  color: #8696a0;

  font-size: 13px;
  line-height: 20px;
}

.wa-conversation-sender {
  flex: 0 0 auto;

  margin-right: 4px;

  color: #b6c2c8;

  font-weight: 600;
}

.wa-conversation-sender.is-you {
  color: #53bdeb;
}

.wa-conversation-preview-text {
  min-width: 0;

  flex: 1 1 auto;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;
}

/* =========================================================
   UNREAD
========================================================= */

.wa-unread {
  flex: 0 0 auto;

  min-width: 20px;
  height: 20px;

  margin-left: 6px;

  padding: 0 6px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  border-radius: 999px;

  background: #25d366;

  color: #111b21;

  font-size: 11px;
  font-weight: 700;
}

/* =========================================================
   CHAT
========================================================= */

.wa-chat {
  min-width: 0;

  min-height: 0;

  display: flex;

  flex-direction: column;

  background: var(--wa-bg);
}

/* =========================================================
   CHAT HEADER
========================================================= */

.wa-chat-header {
  height: 72px;

  flex: 0 0 72px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 0 18px;

  background: #202c33;

  border-bottom:
    1px solid var(--wa-border);
}

.wa-header-left {
  display: flex;

  align-items: center;

  gap: 12px;

  min-width: 0;
}

.wa-header-avatar {
  width: 48px;
  height: 48px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #a855f7
    );

  color: #fff;

  font-weight: 700;

  font-size: 18px;
}

.wa-contact {
  min-width: 0;
}

.wa-contact-name {
  color: #e9edef;

  font-weight: 700;

  font-size: 16px;
}

.wa-contact-phone {
  margin-top: 3px;

  color: #8696a0;

  font-size: 12px;
}

.wa-header-actions {
  display: flex;
  gap: 6px;
}

/* =========================================================
   CHAT BODY
========================================================= */

.wa-chat-body {
  flex: 1;

  min-height: 0;

  overflow-y: auto;

  background:
    radial-gradient(
      circle at 20% 20%,
      rgba(255,255,255,.02),
      transparent 30%
    ),
    #0b141a;
}

.wa-messages-container {
  min-height: 100%;

  padding: 16px 24px 24px;

  display: flex;

  flex-direction: column;

  gap: 4px;
}

/* =========================================================
   DATE
========================================================= */

.wa-date-divider {
  align-self: center;

  margin: 10px 0;

  padding: 6px 12px;

  border-radius: 8px;

  background: #182229;

  color: #8696a0;

  font-size: 11px;
}

/* =========================================================
   MESSAGE ROW
========================================================= */

.wa-message-row {
  display: flex;

  width: 100%;

  margin: 2px 0;
}

.wa-message-row.incoming {
  justify-content: flex-start;
}

.wa-message-row.outgoing {
  justify-content: flex-end;
}

/* =========================================================
   BUBBLE
========================================================= */

.wa-bubble {
  position: relative;

  max-width: min(70%, 700px);

  padding: 9px 11px 6px;

  border-radius: 9px;

  color: #e9edef;

  font-size: 14px;

  line-height: 1.45;

  word-break: break-word;
}

.wa-message-row.incoming
.wa-bubble {
  background: #202c33;

  border-top-left-radius: 3px;
}

.wa-message-row.outgoing
.wa-bubble {
  background: #005c4b;

  border-top-right-radius: 3px;
}

.wa-message-body {
  white-space: pre-wrap;
}

.wa-message-meta {
  display: flex;

  align-items: center;

  justify-content: flex-end;

  gap: 4px;

  margin-top: 4px;

  font-size: 10px;

  color: #8696a0;
}

/* =========================================================
   MESSAGE STATUS
   IMPORTANT:
   Do NOT use negative letter-spacing here.
   It makes ✓✓ visually overlap and look like ✓.
========================================================= */

.wa-status {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-width: 20px;

  font-size: 14px;

  line-height: 1;

  letter-spacing: 0;

  white-space: nowrap;

  color: #aebac1;

  transition:
    color .15s ease,
    transform .15s ease;
}

/* =========================================================
   SENT
========================================================= */

.wa-status.is-sent {
  color: #aebac1;
}

/* =========================================================
   DELIVERED
========================================================= */

.wa-status.is-delivered {
  color: #aebac1;
}

/* =========================================================
   READ
========================================================= */

.wa-status.is-read {
  color: #53bdeb !important;
}

/* Extra protection if class gets changed dynamically */
.wa-status[data-status="read"] {
  color: #53bdeb !important;
}

/* =========================================================
   FAILED
========================================================= */

.wa-status.is-failed {
  color: #ff6b6b;

  letter-spacing: 0;
}

/* =========================================================
   EMPTY STATE
========================================================= */

.wa-empty {
  flex: 1;

  display: flex;

  align-items: center;

  justify-content: center;

  text-align: center;

  color: #8696a0;
}

.wa-empty-inner {
  max-width: 420px;
}

.wa-empty-icon {
  font-size: 54px;

  margin-bottom: 16px;
}

.wa-empty-title {
  color: #e9edef;

  font-size: 24px;

  font-weight: 600;

  margin-bottom: 8px;
}

.wa-empty-text {
  font-size: 14px;
}

/* =========================================================
   QUICK REPLIES
========================================================= */

.wa-quick-replies {
  flex: 0 0 auto;

  display: flex;

  gap: 8px;

  padding: 9px 16px;

  background: #202c33;

  overflow-x: auto;

  border-top:
    1px solid var(--wa-border);
}

.wa-quick-reply {
  border: 1px solid #3b4a54;

  background: #263640;

  color: #e9edef;

  border-radius: 18px;

  padding: 8px 14px;

  cursor: pointer;

  white-space: nowrap;

  font-size: 13px;
}

.wa-quick-reply:hover {
  background: #344955;
}

/* =========================================================
   INFO BAR
========================================================= */

.wa-info-bar {
  flex: 0 0 auto;

  text-align: center;

  padding: 7px;

  color: #8696a0;

  background: #202c33;

  font-size: 11px;

  border-top:
    1px solid var(--wa-border);
}

/* =========================================================
   COMPOSER
========================================================= */

.wa-composer {
  flex: 0 0 auto;

  padding: 10px 14px;

  background: #202c33;

  border-top:
    1px solid var(--wa-border);
}

.wa-message-form {
  display: flex;

  align-items: center;

  gap: 10px;
}

.wa-message-input {
  flex: 1;

  min-width: 0;

  height: 48px;

  border: 0;

  outline: none;

  resize: none;

  border-radius: 8px;

  background: #2a3942;

  color: #e9edef;

  padding: 14px 16px;

  font-size: 14px;
}

.wa-message-input::placeholder {
  color: #8696a0;
}

.wa-send-button {
  width: 48px;
  height: 48px;

  flex: 0 0 48px;

  border: 0;

  border-radius: 50%;

  background: #7c3aed;

  color: #fff;

  font-size: 21px;

  cursor: pointer;

  transition:
    transform .15s ease,
    opacity .15s ease;
}

.wa-send-button:hover {
  transform: scale(1.04);
}

.wa-send-button:disabled {
  opacity: .55;

  cursor: not-allowed;
}

/* =========================================================
   OPTIMISTIC MESSAGE
========================================================= */

.wa-message-row.optimistic {
  opacity: .75;
}

.wa-message-row.optimistic
.wa-status {
  color: #8696a0;
}

/* =========================================================
   DARK / LIGHT TOGGLE
========================================================= */

.aone-whatsapp-page.wa-light {
  --wa-bg: #efeae2;
  --wa-panel: #f0f2f5;
  --wa-panel-2: #ffffff;
  --wa-border: #d1d7db;
  --wa-text: #111b21;
  --wa-muted: #667781;
  --wa-input: #ffffff;
  --wa-hover: #f5f6f6;
}

.aone-whatsapp-page.wa-light
.wa-sidebar,
.aone-whatsapp-page.wa-light
.wa-chat-header,
.aone-whatsapp-page.wa-light
.wa-quick-replies,
.aone-whatsapp-page.wa-light
.wa-info-bar,
.aone-whatsapp-page.wa-light
.wa-composer {
  background: #f0f2f5;
}

.aone-whatsapp-page.wa-light
.wa-search,
.aone-whatsapp-page.wa-light
.wa-message-input {
  background: #fff;

  color: #111b21;
}

.aone-whatsapp-page.wa-light
.wa-chat-body {
  background: #efeae2;
}

.aone-whatsapp-page.wa-light
.wa-contact-name,
.aone-whatsapp-page.wa-light
.wa-conversation-name,
.aone-whatsapp-page.wa-light
.wa-empty-title {
  color: #111b21;
}

.aone-whatsapp-page.wa-light
.wa-conversation-preview,
.aone-whatsapp-page.wa-light
.wa-contact-phone {
  color: #667781;
}

.aone-whatsapp-page.wa-light
.wa-message-row.incoming
.wa-bubble {
  background: #fff;

  color: #111b21;
}

.aone-whatsapp-page.wa-light
.wa-message-row.outgoing
.wa-bubble {
  background: #d9fdd3;

  color: #111b21;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 850px) {

  .wa-shell {
    grid-template-columns:
      300px minmax(0, 1fr);
  }

  .wa-bubble {
    max-width: 82%;
  }

}

@media (max-width: 650px) {

  .wa-shell {
    grid-template-columns: 1fr;
  }

  .wa-sidebar {
    display: none;
  }

  .wa-bubble {
    max-width: 88%;
  }

}

</style>


<div
  class="aone-whatsapp-page"
  id="aoneWhatsappPage"
>

  <div class="wa-shell">

    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="wa-sidebar">

      <div class="wa-sidebar-header">

        <div class="wa-sidebar-title">
          WhatsApp Chats
        </div>

        <div class="wa-sidebar-actions">

          <button
            type="button"
            class="wa-icon-button"
            id="waSidebarTheme"
            title="Toggle theme"
          >
            🌙
          </button>

        </div>

      </div>


      <div class="wa-search-wrap">

        <input
          type="search"
          id="waChatSearch"
          class="wa-search"
          placeholder="Search chats"
          autocomplete="off"
        >

      </div>


      <div
        class="wa-conversation-list"
        id="waConversationList"
      >

        <% @conversations.each do |conversation| %>

          <% phone =
               conversation.phone_number.to_s
                 .gsub(/\D/, "") %>

          <% name =
               conversation.sender_name.presence ||
               phone %>

          <% unread =
               @unread_counts[conversation.phone_number].to_i %>

          <a
            class="wa-conversation-link <%= 'active' if @phone.to_s == phone %>"
            href="<%= admin_whatsapp_conversation_path(phone: phone) %>"
            data-phone="<%= phone %>"
            data-name="<%= name %>"
          >

            <div class="wa-avatar">
              <%= name.to_s.first.to_s.upcase %>
            </div>

            <div class="wa-conversation-content">

              <div class="wa-conversation-top">

                <div class="wa-conversation-name">
                  <%= name %>
                </div>

                <div class="wa-conversation-time">
                  <%= conversation.created_at&.strftime("%H:%M") %>
                </div>

              </div>


                <div class="wa-conversation-preview">

                             <% if conversation.direction.to_s == "outgoing" %>

                            <span class="wa-conversation-sender is-you">
                              You:
                             </span>

                 <% else %>

                         <span class="wa-conversation-sender">
                         <%= name %>:
                        </span>

                      <% end %>

                     <span class="wa-conversation-preview-text">

                        <%= conversation.body.presence ||
                              "[#{conversation.message_type}]" %>

                       </span>

                     <% if unread.positive? %>

                     <span class="wa-unread">
                             <%= unread %>
                         </span>

                        <% end %>

                      </div>

                  </div>

              </a>

        <% end %>

      </div>

    </aside>


    <!-- =====================================================
         CHAT
    ====================================================== -->

    <section class="wa-chat">

      <% if @phone.present? %>

        <% conversation_messages =
             @messages.to_a %>

        <% contact_name =
             @user&.name.presence ||
             conversation_messages.last&.sender_name.presence ||
             @phone %>


        <!-- =================================================
             HEADER
        ================================================== -->

        <header class="wa-chat-header">

          <div class="wa-header-left">

            <div class="wa-header-avatar">
              <%= contact_name.to_s.first.to_s.upcase %>
            </div>

            <div class="wa-contact">

              <div class="wa-contact-name">
                <%= contact_name %>
              </div>

              <div class="wa-contact-phone">
                <%= @phone %> · Support Team
              </div>

            </div>

          </div>


          <div class="wa-header-actions">

            <button
              type="button"
              class="wa-icon-button"
              id="waSearchMessages"
              title="Search messages"
            >
              🔍
            </button>

            <button
              type="button"
              class="wa-icon-button"
              id="waHeaderTheme"
              title="Toggle theme"
            >
              🌙
            </button>

            <button
              type="button"
              class="wa-icon-button"
              id="waMoreOptions"
              title="More"
            >
              ⋮
            </button>

          </div>

        </header>


        <!-- =================================================
             MESSAGES
        ================================================== -->

        <main
          class="wa-chat-body"
          id="waChatBody"
        >

          <div
            class="wa-messages-container"
            id="waMessagesContainer"
          >

            <% previous_date = nil %>

            <% conversation_messages.each do |message| %>

              <% current_date =
                   (
                     message.whatsapp_timestamp ||
                     message.created_at ||
                     Time.current
                   ).to_date %>

              <% if previous_date != current_date %>

                <div class="wa-date-divider">

                  <%= current_date == Date.current ?
                        "Today" :
                        current_date.strftime("%d %b %Y") %>

                </div>

                <% previous_date = current_date %>

              <% end %>


              <% outgoing =
                   message.direction == "outgoing" %>

              <% status =
                   message.status.to_s.downcase.strip %>

              <% status_icon =
                   case status
                   when "read", "delivered"
                     "✓✓"
                   when "failed"
                     "!"
                   else
                     "✓"
                   end %>


              <div
                class="wa-message-row <%= outgoing ? 'outgoing' : 'incoming' %>"
                data-message-id="<%= message.id %>"
                data-client-message-id="<%= message.metadata&.dig('client_message_id') %>"
              >

                <div class="wa-bubble">

                  <div class="wa-message-body">
                    <%= message.body %>
                  </div>


                  <div class="wa-message-meta">

                    <span>
                      <%= (
                        message.whatsapp_timestamp ||
                        message.created_at ||
                        Time.current
                      ).strftime("%H:%M") %>
                    </span>


                    <% if outgoing %>

                      <span
                        class="wa-status <%= case status
                          when 'read'
                            'is-read'
                          when 'delivered'
                            'is-delivered'
                          when 'failed'
                            'is-failed'
                          else
                            'is-sent'
                        end %>"
                        data-status="<%= status.presence || 'sent' %>"
                        title="<%= status.present? ? status.capitalize : 'Sent' %>"
                      >
                        <%= status_icon %>
                      </span>

                    <% end %>

                  </div>

                </div>

              </div>

            <% end %>

          </div>

        </main>


        <!-- =================================================
             QUICK REPLIES
        ================================================== -->

        <div class="wa-quick-replies">

          <% [
            "👋 Hello",
            "Query",
            "Thank you",
            "Shortly"
          ].each do |reply| %>

            <button
              type="button"
              class="wa-quick-reply"
              data-message="<%= reply.sub(/\A👋 /, '') %>"
            >
              <%= reply %>
            </button>

          <% end %>

        </div>


        <!-- =================================================
             INFO
        ================================================== -->

        <div class="wa-info-bar">
          Messages are sent through official WhatsApp Business API.
        </div>


        <!-- =================================================
             COMPOSER
        ================================================== -->

        <div class="wa-composer">

          <%= form_with(
                url: admin_send_whatsapp_message_path(
                  phone: @phone
                ),
                method: :post,
                local: true,
                class: "wa-message-form",
                id: "waMessageForm"
              ) do |form| %>

            <%= form.text_area(
                  :body,
                  id: "waMessageInput",
                  class: "wa-message-input",
                  placeholder: "Type a message",
                  rows: 1,
                  autocomplete: "off"
                ) %>

            <button
              type="submit"
              class="wa-send-button"
              id="waSendButton"
              title="Send"
            >
              ➤
            </button>

          <% end %>

        </div>

      <% else %>

        <!-- =================================================
             EMPTY
        ================================================== -->

        <div class="wa-empty">

          <div class="wa-empty-inner">

            <div class="wa-empty-icon">
              💬
            </div>

            <div class="wa-empty-title">
              WhatsApp Chats
            </div>

            <div class="wa-empty-text">
              Select a conversation to start chatting.
            </div>

          </div>

        </div>

      <% end %>

    </section>

  </div>

</div>

<script nonce="<%= content_security_policy_nonce %>">
(() => {

  "use strict";

  /* =========================================================
     ELEMENTS
  ========================================================= */

  const page =
    document.getElementById("aoneWhatsappPage");

  if (!page) {
    return;
  }

  const conversationList =
    document.getElementById("waConversationList");

  const searchInput =
    document.getElementById("waChatSearch");

  const searchMessagesInput =
    document.getElementById("waSearchMessages");

  const headerThemeButton =
    document.getElementById("waHeaderTheme");

  const sidebarThemeButton =
    document.getElementById("waSidebarTheme");

  const moreOptionsButton =
    document.getElementById("waMoreOptions");

  const chatMessages =
    document.getElementById("waChatMessages");

  const messageForm =
    document.getElementById("waMessageForm");

  const messageInput =
    document.getElementById("waMessageInput");

  const sendButton =
    document.getElementById("waSendButton");


  /* =========================================================
     CLEANUP
  ========================================================= */

  const cleanupFunctions = [];

  function registerCleanup(fn) {
    if (typeof fn === "function") {
      cleanupFunctions.push(fn);
    }
  }

  function cleanup() {
    cleanupFunctions.forEach(fn => {
      try {
        fn();
      } catch (error) {
        console.warn(
          "WhatsApp cleanup error:",
          error
        );
      }
    });

    cleanupFunctions.length = 0;
  }


  /* =========================================================
     CONVERSATION SEARCH
  ========================================================= */

  function applyConversationSearch() {

    if (!searchInput || !conversationList) {
      return;
    }

    const query =
      searchInput.value
        .toLowerCase()
        .trim();

    const links =
      conversationList.querySelectorAll(
        ".wa-conversation-link"
      );

    links.forEach(link => {

      const name =
        (
          link.dataset.name ||
          ""
        )
        .toLowerCase();

      const phone =
        (
          link.dataset.phone ||
          ""
        )
        .toLowerCase();

      const preview =
        (
          link.dataset.preview ||
          link.textContent ||
          ""
        )
        .toLowerCase();

      const matches =
        !query ||
        name.includes(query) ||
        phone.includes(query) ||
        preview.includes(query);

      link.style.display =
        matches ? "" : "none";

    });
  }


  /* =========================================================
     MESSAGE SEARCH
  ========================================================= */

  function applyMessageSearch() {

    if (
      !searchMessagesInput ||
      !chatMessages
    ) {
      return;
    }

    const query =
      searchMessagesInput.value
        .toLowerCase()
        .trim();

    const messages =
      chatMessages.querySelectorAll(
        ".wa-message-row, .wa-bubble"
      );

    messages.forEach(message => {

      if (!query) {
        message.style.display = "";
        return;
      }

      const text =
        (
          message.textContent ||
          ""
        )
        .toLowerCase();

      message.style.display =
        text.includes(query)
          ? ""
          : "none";

    });
  }


  /* =========================================================
     THEME
  ========================================================= */

  function updateThemeButtons() {

    const isLight =
      page.classList.contains("wa-light");

    const icon =
      isLight ? "🌙" : "☀️";

    const buttons =
      document.querySelectorAll(
        "#waHeaderTheme, #waSidebarTheme"
      );

    buttons.forEach(button => {

      button.textContent = icon;

      button.setAttribute(
        "aria-label",
        isLight
          ? "Switch to dark mode"
          : "Switch to light mode"
      );

      button.setAttribute(
        "title",
        isLight
          ? "Switch to dark mode"
          : "Switch to light mode"
      );

    });
  }


  function applyTheme() {

    let savedTheme = null;

    try {
      savedTheme =
        localStorage.getItem(
          "aone-whatsapp-theme"
        );
    } catch (error) {
      console.warn(
        "Unable to read theme preference.",
        error
      );
    }

    if (savedTheme === "light") {

      page.classList.add(
        "wa-light"
      );

    } else {

      page.classList.remove(
        "wa-light"
      );

    }

    updateThemeButtons();
  }


  function toggleTheme(event) {

    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }

    page.classList.toggle(
      "wa-light"
    );

    const theme =
      page.classList.contains(
        "wa-light"
      )
        ? "light"
        : "dark";

    try {

      localStorage.setItem(
        "aone-whatsapp-theme",
        theme
      );

    } catch (error) {

      console.warn(
        "Unable to save theme preference.",
        error
      );

    }

    updateThemeButtons();
  }


  /* =========================================================
     THEME EVENTS
  ========================================================= */

  if (headerThemeButton) {

    headerThemeButton.addEventListener(
      "click",
      toggleTheme
    );

    registerCleanup(() => {

      headerThemeButton.removeEventListener(
        "click",
        toggleTheme
      );

    });

  }


  if (sidebarThemeButton) {

    sidebarThemeButton.addEventListener(
      "click",
      toggleTheme
    );

    registerCleanup(() => {

      sidebarThemeButton.removeEventListener(
        "click",
        toggleTheme
      );

    });

  }


  /* =========================================================
     SEARCH EVENTS
  ========================================================= */

  if (searchInput) {

    searchInput.addEventListener(
      "input",
      applyConversationSearch
    );

    registerCleanup(() => {

      searchInput.removeEventListener(
        "input",
        applyConversationSearch
      );

    });

  }


  if (searchMessagesInput) {

    searchMessagesInput.addEventListener(
      "input",
      applyMessageSearch
    );

    registerCleanup(() => {

      searchMessagesInput.removeEventListener(
        "input",
        applyMessageSearch
      );

    });

  }


  /* =========================================================
     MORE OPTIONS
  ========================================================= */

  function handleMoreOptions(event) {

    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }

    const existingMenu =
      document.querySelector(
        ".wa-more-options-menu"
      );

    if (existingMenu) {
      existingMenu.remove();
      return;
    }

    if (!moreOptionsButton) {
      return;
    }

    const menu =
      document.createElement("div");

    menu.className =
      "wa-more-options-menu";

    menu.innerHTML = `
      <button type="button" data-action="clear-search">
        Clear Search
      </button>

      <button type="button" data-action="refresh">
        Refresh
      </button>
    `;

    document.body.appendChild(menu);

    const rect =
      moreOptionsButton.getBoundingClientRect();

    menu.style.position = "fixed";
    menu.style.top =
      `${rect.bottom + 6}px`;

    menu.style.right =
      `${Math.max(
        10,
        window.innerWidth - rect.right
      )}px`;

    menu.style.zIndex = "100000";


    function menuAction(e) {

      const action =
        e.target.dataset.action;

      if (action === "clear-search") {

        if (searchMessagesInput) {
          searchMessagesInput.value = "";
          applyMessageSearch();
        }

        if (searchInput) {
          searchInput.value = "";
          applyConversationSearch();
        }

        menu.remove();

      }

      if (action === "refresh") {

        window.location.reload();

      }

    }


    menu.addEventListener(
      "click",
      menuAction
    );

    registerCleanup(() => {

      menu.removeEventListener(
        "click",
        menuAction
      );

      menu.remove();

    });

  }


  if (moreOptionsButton) {

    moreOptionsButton.addEventListener(
      "click",
      handleMoreOptions
    );

    registerCleanup(() => {

      moreOptionsButton.removeEventListener(
        "click",
        handleMoreOptions
      );

    });

  }


  /* =========================================================
     CLOSE MORE OPTIONS WHEN CLICKING OUTSIDE
  ========================================================= */

  function closeMoreOptions(event) {

    const menu =
      document.querySelector(
        ".wa-more-options-menu"
      );

    if (!menu) {
      return;
    }

    if (
      menu.contains(event.target) ||
      moreOptionsButton?.contains(
        event.target
      )
    ) {
      return;
    }

    menu.remove();
  }


  document.addEventListener(
    "click",
    closeMoreOptions
  );

  registerCleanup(() => {

    document.removeEventListener(
      "click",
      closeMoreOptions
    );

  });


  /* =========================================================
     SEND MESSAGE
  ========================================================= */

  async function sendMessage(event) {

    if (event) {
      event.preventDefault();
    }

    if (!messageInput) {
      return;
    }

    const message =
      messageInput.value.trim();

    if (!message) {
      return;
    }

    /*
     * If your existing Rails form has its own
     * submit handling, allow normal submission.
     */

    if (!messageForm) {
      return;
    }

    const formAction =
      messageForm.getAttribute(
        "action"
      );

    if (!formAction) {
      return;
    }

    const formData =
      new FormData(messageForm);

    try {

      if (sendButton) {
        sendButton.disabled = true;
      }

      const response =
        await fetch(
          formAction,
          {
            method:
              messageForm.method ||
              "POST",

            body:
              formData,

            headers: {
              "X-Requested-With":
                "XMLHttpRequest",

              "Accept":
                "text/html, application/json"
            },

            credentials:
              "same-origin"
          }
        );


      if (!response.ok) {

        throw new Error(
          `HTTP ${response.status}`
        );

      }


      /*
       * Clear message box after successful send.
       */

      messageInput.value = "";

      messageInput.focus();


    } catch (error) {

      console.error(
        "Message send failed:",
        error
      );

      /*
       * If AJAX sending is not supported by
       * your controller, submit normally.
       */

      try {

        messageForm.removeEventListener(
          "submit",
          sendMessage
        );

        messageForm.submit();

      } catch (fallbackError) {

        console.error(
          "Fallback message submission failed:",
          fallbackError
        );

      }

    } finally {

      if (sendButton) {
        sendButton.disabled = false;
      }

    }

  }


  if (messageForm) {

    messageForm.addEventListener(
      "submit",
      sendMessage
    );

    registerCleanup(() => {

      messageForm.removeEventListener(
        "submit",
        sendMessage
      );

    });

  }


  /* =========================================================
     ENTER TO SEND
  ========================================================= */

  function handleMessageKeydown(event) {

    if (
      event.key === "Enter" &&
      !event.shiftKey
    ) {

      event.preventDefault();

      if (messageForm) {

        if (
          typeof messageForm.requestSubmit ===
          "function"
        ) {

          messageForm.requestSubmit();

        } else {

          sendMessage(event);

        }

      }

    }

  }


  if (messageInput) {

    messageInput.addEventListener(
      "keydown",
      handleMessageKeydown
    );

    registerCleanup(() => {

      messageInput.removeEventListener(
        "keydown",
        handleMessageKeydown
      );

    });

  }


  /* =========================================================
     CONVERSATION LIST
  ========================================================= */

  function renderConversationList(
    html
  ) {

    if (!conversationList) {
      return;
    }

    const previousScrollTop =
      conversationList.scrollTop;

    conversationList.innerHTML =
      html;

    conversationList.scrollTop =
      previousScrollTop;

    /*
     * IMPORTANT:
     * Re-apply search after the list
     * has been replaced.
     */

    applyConversationSearch();
  }


  /* =========================================================
     INITIAL STATE
  ========================================================= */

  applyTheme();

  applyConversationSearch();

  applyMessageSearch();


  /* =========================================================
     DEBUG
  ========================================================= */

  console.log(
    "A One GS WhatsApp UI initialized."
  );

  console.log(
    "Conversation search:",
    !!searchInput
  );

  console.log(
    "Sidebar theme button:",
    !!sidebarThemeButton
  );

  console.log(
    "Header theme button:",
    !!headerThemeButton
  );


  /* =========================================================
     PAGE UNLOAD CLEANUP
  ========================================================= */

  window.addEventListener(
    "pagehide",
    cleanup,
    {
      once: true
    }
  );

  registerCleanup(() => {

    window.removeEventListener(
      "pagehide",
      cleanup
    );

  });


})();
</script>