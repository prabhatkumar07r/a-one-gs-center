/* =========================================================
   MODAL
========================================================= */

.playlist-modal-overlay {
  position: fixed;

  inset: 0;

  z-index: 9999;

  display: none;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background: rgba(15, 23, 42, .55);

  backdrop-filter: blur(5px);
}

.playlist-modal-overlay.active {
  display: flex;
}

.playlist-modal {
  width: min(440px, 100%);

  padding: 30px;

  border-radius: 20px;

  background: #fff;

  box-shadow:
    0 25px 70px rgba(15, 23, 42, .25);

  text-align: center;

  animation: playlistModalIn .2s ease;
}

@keyframes playlistModalIn {
  from {
    opacity: 0;
    transform: translateY(12px) scale(.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-warning-icon {
  width: 60px;
  height: 60px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin: 0 auto 16px;

  border-radius: 50%;

  background: #fee2e2;
  color: #dc2626;

  font-size: 25px;
}

.playlist-modal h2 {
  margin: 0 0 10px;

  color: #111827;

  font-size: 21px;
}

.playlist-modal p {
  margin: 0;

  color: #64748b;

  font-size: 14px;
  line-height: 1.7;
}

.modal-actions {
  display: flex;
  justify-content: center;
  gap: 10px;

  margin-top: 24px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1000px) {

  .playlist-content-grid {
    grid-template-columns: 1fr;
  }

  .playlist-sidebar-column {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

}


@media (max-width: 700px) {

  .playlist-show-page {
    padding: 20px 15px;
  }

  .playlist-show-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .playlist-header-actions {
    width: 100%;
  }

  .playlist-header-actions .playlist-btn {
    flex: 1;
  }

  .playlist-title-area h1 {
    font-size: 23px;
  }

  .playlist-sidebar-column {
    display: flex;
  }

  .playlist-card {
    padding: 18px;
  }

}


@media (max-width: 480px) {

  .playlist-title-area {
    align-items: flex-start;
  }

  .playlist-icon {
    width: 50px;
    height: 50px;
    font-size: 21px;
  }

  .playlist-header-actions {
    flex-direction: column;
  }

  .playlist-header-actions .playlist-btn {
    width: 100%;
  }

  .playlist-video-item {
    padding: 10px;
  }

  .video-number {
    display: none;
  }

}


/* =========================================================
   DARK MODE SUPPORT
========================================================= */

@media (prefers-color-scheme: dark) {

  .playlist-show-page {
    background: #0f172a;
    color: #f8fafc;
  }

  .playlist-title-area h1,
  .playlist-card h2,
  .playlist-video-item h3,
  .playlist-modal h2 {
    color: #f8fafc;
  }

  .playlist-card,
  .playlist-modal {
    background: #111827;
    border-color: #1e293b;
  }

  .playlist-card-header {
    border-color: #1e293b;
  }

  .playlist-description {
    color: #cbd5e1;
  }

  .playlist-video-item {
    background: #111827;
    border-color: #1e293b;
  }

  .course-box,
  .empty-description {
    background: #1e293b;
  }

  .course-box strong,
  .manage-action strong {
    color: #e2e8f0;
  }

  .playlist-stat {
    border-color: #1e293b;
  }

}

</style>

<script>

document.addEventListener("DOMContentLoaded", function () {

  const deleteButton =
    document.getElementById("deletePlaylistBtn");

  const cancelButton =
    document.getElementById("cancelDeleteBtn");

  const modal =
    document.getElementById("deletePlaylistModal");


  if (!deleteButton || !modal) {
    return;
  }


  function openDeleteModal() {

    modal.classList.add("active");

    document.body.style.overflow = "hidden";

  }


  function closeDeleteModal() {

    modal.classList.remove("active");

    document.body.style.overflow = "";

  }


  deleteButton.addEventListener(
    "click",
    openDeleteModal
  );


  if (cancelButton) {

    cancelButton.addEventListener(
      "click",
      closeDeleteModal
    );

  }


  modal.addEventListener(
    "click",
    function (event) {

      if (event.target === modal) {
        closeDeleteModal();
      }

    }
  );


  document.addEventListener(
    "keydown",
    function (event) {

      if (event.key === "Escape") {
        closeDeleteModal();
      }

    }
  );

});

</script>
