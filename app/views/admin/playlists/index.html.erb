
<% content_for :title, "#{@course.Course_name} Playlists" %>

<style>
  .playlist-page {
    padding: 10px 0 30px;
  }

  .playlist-header {
    background: linear-gradient(135deg, #7c3aed, #5b21b6);
    color: #fff;
    border-radius: 18px;
    padding: 24px 28px;
    margin-bottom: 24px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, .10);
  }

  .playlist-header h2 {
    margin: 0;
    font-weight: 700;
  }

  .playlist-header p {
    margin-top: 6px;
    margin-bottom: 0;
    opacity: .85;
  }

  .playlist-header .btn {
    border-radius: 10px;
    font-weight: 600;
    padding: 10px 18px;
  }

  .playlist-card {
    border: 0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, .07);
  }

  .playlist-card .card-body {
    padding: 0;
  }

  .playlist-table {
    margin-bottom: 0;
  }

  .playlist-table thead th {
    padding: 15px 14px;
    white-space: nowrap;
    font-size: 14px;
  }

  .playlist-table tbody td {
    padding: 15px 14px;
  }

  .playlist-title {
    font-weight: 600;
    color: #1f2937;
  }

  .playlist-description {
    font-size: 13px;
    color: #6b7280;
    margin-top: 4px;
  }

  .position-badge {
    min-width: 32px;
    display: inline-block;
    text-align: center;
  }

  .count-badge {
    min-width: 35px;
    display: inline-block;
    text-align: center;
  }

  .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .action-buttons .btn {
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
  }

  .empty-state {
    padding: 70px 20px;
    text-align: center;
  }

  .empty-icon {
    font-size: 55px;
    margin-bottom: 15px;
  }

  .empty-state h5 {
    font-weight: 700;
    color: #374151;
  }

  .empty-state p {
    color: #6b7280;
  }

  @media (max-width: 768px) {
    .playlist-header {
      padding: 20px;
    }

    .playlist-header .header-content {
      flex-direction: column;
      align-items: flex-start !important;
      gap: 15px;
    }

    .playlist-header .btn {
      width: 100%;
    }

    .playlist-table {
      min-width: 850px;
    }
  }
</style>

<div class="container-fluid playlist-page">

  <!-- HEADER -->
  <div class="playlist-header">

    <div class="d-flex justify-content-between align-items-center header-content">

      <div>
        <h2>📚 Playlist Management</h2>

        <p>
          Course:
          <strong><%= @course.Course_name %></strong>
        </p>
      </div>

      <%= link_to new_admin_course_playlist_path(@course),
          class: "btn btn-light" do %>
        ➕ Add Playlist
      <% end %>

    </div>

  </div>


  <!-- PLAYLIST CARD -->
  <div class="card playlist-card">

    <div class="card-body">

      <% if @playlists.any? %>

        <div class="table-responsive">

          <table class="table table-hover align-middle playlist-table">

            <thead class="table-dark">

              <tr>
                <th>#</th>
                <th>Title</th>
                <th>Position</th>
                <th>Videos</th>
                <th>Resources</th>
                <th style="min-width:320px;">Actions</th>
              </tr>

            </thead>

            <tbody>

              <% @playlists.each_with_index do |playlist, index| %>

                <tr>

                  <!-- NUMBER -->
                  <td>
                    <strong><%= index + 1 %></strong>
                  </td>


                  <!-- TITLE -->
                  <td>

                    <div class="playlist-title">
                      <%= playlist.title %>
                    </div>

                    <% if playlist.description.present? %>

                      <div class="playlist-description">
                        <%= truncate(
                              playlist.description,
                              length: 60
                            ) %>
                      </div>

                    <% end %>

                  </td>


                  <!-- POSITION -->
                  <td>

                    <span class="badge bg-primary position-badge">
                      <%= playlist.position %>
                    </span>

                  </td>


                  <!-- VIDEOS -->
                  <td>

                    <span class="badge bg-success count-badge">
                      <%= playlist.videos.count %>
                    </span>

                  </td>


                  <!-- RESOURCES -->
                  <td>

                    <span class="badge bg-info count-badge">
                      <%= playlist.resources.count %>
                    </span>

                  </td>


                  <!-- ACTIONS -->
                  <td>

                    <div class="action-buttons">

                      <%= link_to admin_course_playlist_videos_path(
                            @course,
                            playlist
                          ),
                          class: "btn btn-info btn-sm text-white",
                          title: "Manage Videos" do %>
                        🎥 Videos
                      <% end %>


                      <%= link_to edit_admin_course_playlist_path(
                            @course,
                            playlist
                          ),
                          class: "btn btn-warning btn-sm",
                          title: "Edit Playlist" do %>
                        ✏️ Edit
                      <% end %>


                      <%= link_to admin_course_playlist_path(
                            @course,
                            playlist
                          ),
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: "Delete this playlist?"
                          },
                          class: "btn btn-danger btn-sm",
                          title: "Delete Playlist" do %>
                        🗑 Delete
                      <% end %>

                    </div>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      <% else %>

        <!-- EMPTY STATE -->

        <div class="empty-state">

          <div class="empty-icon">
            📚
          </div>

          <h5>No Playlists Found</h5>

          <p>
            This course does not have any playlists yet.
          </p>

          <%= link_to new_admin_course_playlist_path(@course),
              class: "btn btn-primary mt-2" do %>
            ➕ Create First Playlist
          <% end %>

        </div>

      <% end %>

    </div>

  </div>

</div>


<script>
  document.addEventListener("turbo:load", function () {

    const actionButtons =
      document.querySelectorAll(".action-buttons .btn");

    actionButtons.forEach(function (button) {

      button.addEventListener("click", function () {

        button.style.opacity = "0.65";

        setTimeout(function () {
          button.style.opacity = "1";
        }, 500);

      });

    });

  });
</script>
