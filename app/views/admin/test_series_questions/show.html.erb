<style nonce="<%= content_security_policy_nonce %>">

.admin-ts-detail-card {
  width: 100%;
  margin-bottom: 16px;
  padding: 17px 18px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  box-shadow: 0 2px 9px rgba(25, 25, 50, .035);
}

.admin-ts-detail-label {
  margin-bottom: 6px;
  color: #73798c;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
}

.admin-ts-detail-question {
  margin-bottom: 15px;
  color: #202033;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.admin-ts-detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  padding-top: 12px;
  border-top: 1px solid #eef0f4;
}

.admin-ts-detail-meta span {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 5px 8px;
  color: #6b7280;
  background: #f8f9fc;
  border: 1px solid #e7e9ef;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 600;
}

.admin-ts-detail-meta strong {
  color: #4f46e5;
  font-weight: 700;
}

.admin-ts-options-large {
  display: flex;
  flex-direction: column;
  gap: 7px;
  width: 100%;
  margin-bottom: 18px;
}

.admin-ts-option-large {
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 9px;
  width: 100%;
  min-height: 43px;
  padding: 7px 9px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(25, 25, 50, .025);
  transition: border-color .18s ease, box-shadow .18s ease;
}

.admin-ts-option-large:hover {
  border-color: #d7d4ff;
  box-shadow: 0 4px 10px rgba(25, 25, 50, .05);
}

.admin-ts-option-large.correct {
  background: #f8fff9;
  border-color: #bbebc4;
}

.admin-ts-option-letter {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 29px;
  height: 29px;
  color: #4f46e5;
  background: #f2f1ff;
  border: 1px solid #ddd9ff;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 800;
}

.admin-ts-option-large.correct .admin-ts-option-letter {
  color: #15803d;
  background: #ecfdf3;
  border-color: #bbebc4;
}

.admin-ts-option-content {
  min-width: 0;
}

.admin-ts-option-content strong {
  display: block;
  color: #292938;
  font-size: 12px;
  font-weight: 650;
  line-height: 1.4;
  word-break: break-word;
}

.admin-ts-correct {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 55px;
  padding: 4px 7px;
  color: #15803d;
  background: #ecfdf3;
  border: 1px solid #bbebc4;
  border-radius: 5px;
  font-size: 9px;
  font-weight: 700;
  white-space: nowrap;
}

.admin-ts-option-large .admin-ts-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 28px;
  padding: 5px 8px;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 650;
  text-decoration: none;
  white-space: nowrap;
  transition: background-color .18s ease, border-color .18s ease, color .18s ease;
}

.admin-ts-option-large .admin-ts-action.edit {
  color: #4f46e5;
  background: #f5f3ff;
  border: 1px solid #ddd6fe;
}

.admin-ts-option-large .admin-ts-action.edit:hover {
  color: #4338ca;
  background: #ede9fe;
  border-color: #c4b5fd;
}

.admin-ts-option-large .admin-ts-action.delete {
  color: #dc2626;
  background: #fff7f7;
  border: 1px solid #fecaca;
  cursor: pointer;
}

.admin-ts-option-large .admin-ts-action.delete:hover {
  color: #b91c1c;
  background: #fef2f2;
  border-color: #fca5a5;
}

.admin-ts-option-large form {
  margin: 0;
  padding: 0;
}

.admin-ts-detail-card h2 {
  margin: 0 0 14px;
  color: #202033;
  font-size: 16px;
  font-weight: 700;
}

.admin-ts-detail-card p {
  margin: 0;
  color: #4b5563;
  font-size: 12px;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.admin-ts-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin: 18px 0 11px;
}

.admin-ts-section-header h2 {
  margin: 0;
  color: #292938;
  font-size: 16px;
  font-weight: 700;
}

.admin-ts-section-header p {
  margin: 3px 0 0;
  color: #7b8194;
  font-size: 11px;
}

.admin-ts-section-header .admin-ts-btn {
  flex-shrink: 0;
}

.admin-ts-page .admin-ts-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.admin-ts-header-actions {
  display: flex;
  align-items: center;
  gap: 7px;
  flex-shrink: 0;
}

.admin-ts-theme-toggle {
  width: 38px !important;
  height: 38px !important;
  min-width: 38px !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
  color: #5b21b6 !important;
  background: #ffffff !important;
  border: 1px solid #dfe3eb !important;
  border-radius: 8px !important;
  font-size: 13px !important;
  cursor: pointer !important;
  box-shadow: 0 3px 9px rgba(50, 60, 110, .07);
  transition: .18s ease;
}

.admin-ts-theme-toggle:hover {
  color: #4f46e5 !important;
  background: #f5f3ff !important;
  border-color: #c4b5fd !important;
  transform: translateY(-1px);
}

body.admin-ts-dark {
  background: #0e1222 !important;
}

body.admin-ts-dark .admin-ts-page,
body.admin-ts-dark main,
body.admin-ts-dark .main-content,
body.admin-ts-dark .admin-main,
body.admin-ts-dark .content-wrapper {
  background: #0e1222 !important;
}

body.admin-ts-dark .admin-ts-detail-card,
body.admin-ts-dark .admin-ts-option-large {
  background: #191e33 !important;
  border-color: #303852 !important;
  box-shadow: 0 3px 12px rgba(0, 0, 0, .16);
}

body.admin-ts-dark .admin-ts-detail-label {
  color: #8f98b1;
}

body.admin-ts-dark .admin-ts-detail-question {
  color: #f2f4f9;
}

body.admin-ts-dark .admin-ts-detail-meta {
  border-top-color: #303852;
}

body.admin-ts-dark .admin-ts-detail-meta span {
  color: #aeb6ca;
  background: #151a2c;
  border-color: #343c58;
}

body.admin-ts-dark .admin-ts-detail-meta strong {
  color: #a78bfa;
}

body.admin-ts-dark .admin-ts-section-header h2 {
  color: #f1f3f8;
}

body.admin-ts-dark .admin-ts-section-header p {
  color: #9da6bd;
}

body.admin-ts-dark .admin-ts-option-large:hover {
  border-color: #5146a8;
}

body.admin-ts-dark .admin-ts-option-content strong {
  color: #edf0f7;
}

body.admin-ts-dark .admin-ts-option-letter {
  color: #c4b5fd;
  background: #252044;
  border-color: #5146a8;
}

body.admin-ts-dark .admin-ts-option-large.correct {
  background: #12271d !important;
  border-color: #28623a !important;
}

body.admin-ts-dark .admin-ts-option-large.correct .admin-ts-option-letter {
  color: #4ade80;
  background: #153522;
  border-color: #28623a;
}

body.admin-ts-dark .admin-ts-correct {
  color: #86efac;
  background: #153522;
  border-color: #28623a;
}

body.admin-ts-dark .admin-ts-detail-card h2 {
  color: #f1f3f8;
}

body.admin-ts-dark .admin-ts-detail-card p {
  color: #b5bdd0;
}

body.admin-ts-dark .admin-ts-option-large .admin-ts-action.edit {
  color: #c4b5fd;
  background: #252044;
  border-color: #5146a8;
}

body.admin-ts-dark .admin-ts-option-large .admin-ts-action.edit:hover {
  color: #ddd6fe;
  background: #30285a;
}

body.admin-ts-dark .admin-ts-option-large .admin-ts-action.delete {
  color: #fca5a5;
  background: #351b22;
  border-color: #71313d;
}

body.admin-ts-dark .admin-ts-option-large .admin-ts-action.delete:hover {
  color: #fecaca;
  background: #46202a;
}

body.admin-ts-dark .admin-ts-theme-toggle {
  color: #fbbf24 !important;
  background: #191e33 !important;
  border-color: #3b4565 !important;
}

body.admin-ts-dark .admin-ts-theme-toggle:hover {
  color: #fcd34d !important;
  background: #252b43 !important;
  border-color: #596582 !important;
}

body:not(.admin-ts-dark):has(.admin-ts-page),
body:not(.admin-ts-dark):has(.admin-ts-page) main,
body:not(.admin-ts-dark):has(.admin-ts-page) .main-content,
body:not(.admin-ts-dark):has(.admin-ts-page) .admin-main,
body:not(.admin-ts-dark):has(.admin-ts-page) .content-wrapper {
  background: #f3f5ff !important;
}

@media (max-width: 800px) {
  .admin-ts-option-large {
    grid-template-columns: 31px minmax(0, 1fr) auto;
  }

  .admin-ts-option-large .admin-ts-correct {
    grid-column: 3;
  }

  .admin-ts-option-large .admin-ts-action.edit {
    grid-column: 2;
    justify-self: start;
  }

  .admin-ts-option-large .admin-ts-action.delete {
    grid-column: 3;
    justify-self: end;
  }
}

@media (max-width: 600px) {
  .admin-ts-page .admin-ts-header {
    align-items: flex-start;
  }

  .admin-ts-header-actions {
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .admin-ts-detail-card {
    padding: 14px;
    border-radius: 8px;
  }

  .admin-ts-detail-question {
    font-size: 13px;
  }

  .admin-ts-option-large {
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 8px;
    padding: 8px;
  }

  .admin-ts-option-content {
    grid-column: 2;
  }

  .admin-ts-option-large .admin-ts-correct {
    grid-column: 2;
    justify-self: start;
  }

  .admin-ts-option-large .admin-ts-action.edit,
  .admin-ts-option-large .admin-ts-action.delete {
    grid-column: 2;
    justify-self: start;
  }

  .admin-ts-section-header {
    align-items: flex-start;
  }
}

@media (max-width: 430px) {
  .admin-ts-header-actions {
    gap: 5px;
  }

  .admin-ts-header-actions .admin-ts-btn {
    min-height: 32px;
    padding: 6px 8px;
    font-size: 10px;
  }

  .admin-ts-theme-toggle {
    width: 34px !important;
    height: 34px !important;
    min-width: 34px !important;
  }
}

</style>

<div class="admin-ts-page">

  <div class="admin-ts-header">

    <div>

      <div class="admin-ts-breadcrumb">
        <%= @test_series.title %>
        /
        <%= @test.title %>
        /
        Question
      </div>

      <h1>Question</h1>

    </div>

    <div class="admin-ts-header-actions">

      <%= link_to edit_admin_test_series_test_question_path(
                    @test_series,
                    @test,
                    @question
                  ),
                  class: "admin-ts-btn admin-ts-btn-primary" do %>
        <i class="fas fa-edit"></i>
        Edit Question
      <% end %>

      <%= link_to admin_test_series_test_path(
                    @test_series,
                    @test
                  ),
                  class: "admin-ts-btn admin-ts-btn-light" do %>
        <i class="fas fa-arrow-left"></i>
        Back
      <% end %>

      <button
        type="button"
        class="admin-ts-theme-toggle"
        id="adminTsThemeToggle"
        aria-label="Switch to night mode"
        title="Switch to night mode">
        <i
          class="fas fa-moon"
          id="adminTsThemeIcon">
        </i>
      </button>

    </div>

  </div>

  <div class="admin-ts-detail-card">

    <div class="admin-ts-detail-label">
      प्रश्न
    </div>

    <div class="admin-ts-detail-question">
      <%= @question.question_text_hindi %>
    </div>

    <div class="admin-ts-detail-meta">

      <span>
        अंक:
        <strong>
          <%= @question.marks %>
        </strong>
      </span>

      <span>
        प्रश्न संख्या:
        <strong>
          <%= @question.position %>
        </strong>
      </span>

    </div>

  </div>

  <div class="admin-ts-section-header">

    <div>
      <h2>विकल्प</h2>
      <p>सही उत्तर को हरे रंग में दिखाया गया है।</p>
    </div>

    <%= link_to new_admin_test_series_test_question_option_path(
                  @test_series,
                  @test,
                  @question
                ),
                class: "admin-ts-btn admin-ts-btn-primary" do %>
      <i class="fas fa-plus"></i>
      विकल्प जोड़ें
    <% end %>

  </div>

  <div class="admin-ts-options-large">

    <% @options.each_with_index do |option, index| %>

      <div class="admin-ts-option-large <%= "correct" if option.is_correct? %>">

        <div class="admin-ts-option-letter">
          <%= ("A".ord + index).chr %>
        </div>

        <div class="admin-ts-option-content">

          <strong>
            <%= option.option_text_hindi %>
          </strong>

        </div>

        <% if option.is_correct? %>

          <span class="admin-ts-correct">
            सही उत्तर
          </span>

        <% end %>

        <%= link_to edit_admin_test_series_test_question_option_path(
                      @test_series,
                      @test,
                      @question,
                      option
                    ),
                    class: "admin-ts-action edit" do %>
          <i class="fas fa-edit"></i>
          Edit
        <% end %>

        <%= button_to admin_test_series_test_question_option_path(
                        @test_series,
                        @test,
                        @question,
                        option
                      ),
                      method: :delete,
                      class: "admin-ts-action delete",
                      form: {
                        data: {
                          turbo_confirm:
                            "Delete this option?"
                        }
                      } do %>
          <i class="fas fa-trash"></i>
          Delete
        <% end %>

      </div>

    <% end %>

  </div>

  <% if @question.explanation_hindi.present? %>

    <div class="admin-ts-detail-card">

      <h2>व्याख्या</h2>

      <div class="admin-ts-detail-label">
        समाधान
      </div>

      <p>
        <%= @question.explanation_hindi %>
      </p>

    </div>

  <% end %>

</div>

<script nonce="<%= content_security_policy_nonce %>">
(function() {
  function applyAdminQuestionTheme() {
    const isDark = localStorage.getItem("admin-ts-theme") === "dark";
    const icon = document.getElementById("adminTsThemeIcon");
    const toggle = document.getElementById("adminTsThemeToggle");

    document.body.classList.toggle("admin-ts-dark", isDark);

    if (icon) {
      icon.classList.remove("fa-moon", "fa-sun");
      icon.classList.add(isDark ? "fa-sun" : "fa-moon");
    }

    if (toggle) {
      toggle.setAttribute(
        "aria-label",
        isDark ? "Switch to day mode" : "Switch to night mode"
      );

      toggle.setAttribute(
        "title",
        isDark ? "Switch to day mode" : "Switch to night mode"
      );
    }
  }

  function initAdminQuestionTheme() {
    applyAdminQuestionTheme();

    const toggle = document.getElementById("adminTsThemeToggle");

    if (!toggle || toggle.dataset.themeReady === "true") {
      return;
    }

    toggle.dataset.themeReady = "true";

    toggle.addEventListener("click", function() {
      const isDark =
        !document.body.classList.contains("admin-ts-dark");

      localStorage.setItem(
        "admin-ts-theme",
        isDark ? "dark" : "light"
      );

      applyAdminQuestionTheme();
    });
  }

  document.addEventListener(
    "turbo:load",
    initAdminQuestionTheme
  );

  document.addEventListener(
    "DOMContentLoaded",
    initAdminQuestionTheme
  );

  initAdminQuestionTheme();
})();
</script>