    padding: 9px;
  }

  .admin-ts-form-title {
    font-size: 19px;
  }

  .admin-ts-form-breadcrumb {
    font-size: 9px;
  }

  .admin-ts-form-subtitle {
    display: none;
  }

  .admin-ts-form-card {
    padding: 10px;
  }

  .admin-ts-form-grid {
    padding: 11px;
  }

  .admin-ts-option-form {
    padding: 9px;
    gap: 8px;
  }
}


