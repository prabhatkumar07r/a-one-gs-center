<style nonce="<%= content_security_policy_nonce %>">

.admin-ts-form-page {
  width: 100%;
  min-height: calc(100vh - 70px);
  padding: 24px;
}

.admin-ts-form-shell {
  width: 100%;
  max-width: 1050px;
  margin: 0 auto;
}

.admin-ts-form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 18px;
}

.admin-ts-form-breadcrumb {
  margin-bottom: 7px;
  color: #7b8194;
  font-size: 11px;
  font-weight: 600;
}

.admin-ts-form-breadcrumb a {
  color: #6366f1;
  text-decoration: none;
}

.admin-ts-form-breadcrumb a:hover {
  color: #4f46e5;
}

.admin-ts-form-title {
  margin: 0;
  color: #202033;
  font-size: 25px;
  font-weight: 800;
  line-height: 1.2;
}

.admin-ts-form-subtitle {
  margin: 6px 0 0;
  color: #7b8194;
  font-size: 12px;
}

.admin-ts-form-header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.admin-ts-form-back,
.admin-ts-form-theme {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 38px;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 700;
  transition: .2s ease;
}

.admin-ts-form-back {
  padding: 8px 13px;
  color: #4b5563 !important;
  background: #ffffff !important;
  border: 1px solid #dfe3eb !important;
  text-decoration: none !important;
}

.admin-ts-form-back:hover {
  color: #4f46e5 !important;
  background: #f5f3ff !important;
  border-color: #c4b5fd !important;
  transform: translateY(-1px);
}

.admin-ts-form-theme {
  width: 38px;
  min-width: 38px;
  padding: 0;
  color: #5b21b6 !important;
  background: #ffffff !important;
  border: 1px solid #dfe3eb !important;
  cursor: pointer;
}

.admin-ts-form-theme:hover {
  color: #4f46e5 !important;
  background: #f5f3ff !important;
  border-color: #c4b5fd !important;
  transform: translateY(-1px);
}

.admin-ts-form-card {
  width: 100%;
  padding: 22px;
  background: #ffffff;
  border: 1px solid #e3e6ee;
  border-radius: 15px;
  box-shadow: 0 7px 25px rgba(25, 25, 50, .045);
}

.admin-ts-form {
  width: 100%;
}

.admin-ts-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 17px;
  padding: 20px;
  background: #ffffff;
  border: 1px solid #e3e6ee;
  border-radius: 13px;
}

.admin-ts-field {
  min-width: 0;
}

.admin-ts-field.full {
  grid-column: 1 / -1;
}

.admin-ts-field label {
  display: block;
  margin-bottom: 7px;
  color: #303446;
  font-size: 11px;
  font-weight: 700;
}

.admin-ts-input,
.admin-ts-textarea {
  width: 100%;
  padding: 10px 12px;
  color: #25283a;
  background: #ffffff;
  border: 1px solid #dfe3eb;
  border-radius: 8px;
  outline: none;
  font-size: 12px;
  font-family: inherit;
  transition: .2s ease;
  box-sizing: border-box;
}

.admin-ts-input {
  min-height: 40px;
}

.admin-ts-textarea {
  min-height: 105px;
  resize: vertical;
  line-height: 1.6;
}

.admin-ts-input:hover,
.admin-ts-textarea:hover {
  border-color: #bfc5d4;
}

.admin-ts-input:focus,
.admin-ts-textarea:focus {
  border-color: #818cf8;
  box-shadow: 0 0 0 3px rgba(129, 140, 248, .12);
}

.admin-ts-input::placeholder,
.admin-ts-textarea::placeholder {
  color: #9aa1b2;
}

.admin-ts-section-header.form-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 22px 0 12px;
}

.admin-ts-section-header.form-section h2 {
  margin: 0;
  color: #242638;
  font-size: 15px;
  font-weight: 800;
}

.admin-ts-section-header.form-section p {
  margin: 4px 0 0;
  color: #858b9d;
  font-size: 10px;
}

#adminOptionsContainer {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.admin-ts-option-form {
  display: grid;
  grid-template-columns: 38px minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
  padding: 12px;
  background: #ffffff;
  border: 1px solid #e2e5ed;
  border-radius: 10px;
  transition: .2s ease;
}

.admin-ts-option-form:hover {
  border-color: #c8ccef;
  box-shadow: 0 5px 16px rgba(50, 60, 110, .05);
}

.admin-ts-option-number {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5b21b6;
  background: #f1ecff;
  border: 1px solid #ddd2ff;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 800;
}

.admin-ts-option-fields {
  min-width: 0;
}

.admin-ts-option-fields label {
  display: block;
  margin-bottom: 6px;
  color: #343746;
  font-size: 10px;
  font-weight: 700;
}

.admin-ts-option-correct {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 7px;
}

.admin-ts-option-correct label {
  margin: 0;
  color: #5f6575;
  font-size: 10px;
  font-weight: 600;
}

.admin-ts-option-correct input[type="radio"] {
  accent-color: #6366f1;
}

.admin-ts-remove-option {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  min-height: 34px;
  padding: 7px 10px;
  color: #dc2626 !important;
  background: #fff5f5 !important;
  border: 1px solid #fecaca !important;
  border-radius: 7px;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
  transition: .2s ease;
}

.admin-ts-remove-option:hover {
  color: #b91c1c !important;
  background: #fee2e2 !important;
  border-color: #fca5a5 !important;
}

.admin-ts-form #adminAddOption {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 36px;
  padding: 8px 13px;
  color: #4f46e5 !important;
  background: #ffffff !important;
  border: 1px solid #dfe3eb !important;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  transition: .2s ease;
}

.admin-ts-form #adminAddOption:hover {
  color: #4338ca !important;
  background: #f5f3ff !important;
  border-color: #c4b5fd !important;
  transform: translateY(-1px);
}

.admin-ts-errors {
  margin-bottom: 16px;
  padding: 12px 14px;
  color: #b91c1c;
  background: #fff5f5;
  border: 1px solid #fecaca;
  border-left: 4px solid #ef4444;
  border-radius: 8px;
  font-size: 11px;
}

.admin-ts-form-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 9px;
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid #e7e9ef;
}

.admin-ts-form-actions .admin-ts-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 38px;
  padding: 8px 14px;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 700;
  text-decoration: none !important;
  cursor: pointer;
  transition: .2s ease;
}

.admin-ts-form-actions .admin-ts-btn-primary {
  color: #ffffff !important;
  background: linear-gradient(135deg, #7c3aed, #4f46e5) !important;
  border: 1px solid #6d28d9 !important;
  box-shadow: 0 5px 14px rgba(79, 70, 229, .18);
}

.admin-ts-form-actions .admin-ts-btn-primary:hover {
  color: #ffffff !important;
  background: linear-gradient(135deg, #6d28d9, #4338ca) !important;
  transform: translateY(-1px);
}

.admin-ts-form-actions .admin-ts-btn-light {
  color: #4b5563 !important;
  background: #ffffff !important;
  border: 1px solid #dfe3eb !important;
}

.admin-ts-form-actions .admin-ts-btn-light:hover {
  color: #4f46e5 !important;
  background: #f5f3ff !important;
  border-color: #c4b5fd !important;
}

body:not(.admin-ts-dark):has(.admin-ts-form-page),
