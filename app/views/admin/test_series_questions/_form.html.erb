@media (max-width: 800px) {
  .admin-ts-form-grid {
    grid-template-columns: 1fr;
  }

  .admin-ts-field.full {
    grid-column: auto;
  }

  .admin-ts-option-form {
    grid-template-columns: 36px minmax(0, 1fr);
  }

  .admin-ts-remove-option {
    grid-column: 2;
    justify-self: start;
  }
}

@media (max-width: 600px) {
  .admin-ts-form-page {
    padding: 14px;
  }

  .admin-ts-form-header {
    align-items: flex-start;
  }

  .admin-ts-form-title {
    font-size: 21px;
  }

  .admin-ts-form-card {
    padding: 14px;
    border-radius: 12px;
  }

  .admin-ts-form-grid {
    padding: 14px;
  }

  .admin-ts-section-header.form-section {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-ts-form-actions {
    flex-direction: column-reverse;
    align-items: stretch;
  }

  .admin-ts-form-actions .admin-ts-btn {
    width: 100%;
  }

  .admin-ts-form-back {
    width: 38px;
    padding: 0;
  }

  .admin-ts-form-back span {
    display: none;
  }
}

@media (max-width: 430px) {
