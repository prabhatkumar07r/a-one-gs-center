<style nonce="<%= content_security_policy_nonce %>">
.admin-ts-form-page{width:100%;min-height:calc(100vh - 70px);padding:24px;box-sizing:border-box}
.admin-ts-form-shell{width:100%;max-width:1050px;margin:0 auto}
.admin-ts-form-header{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:18px}
.admin-ts-form-breadcrumb{margin-bottom:7px;color:#7b8194;font-size:11px;font-weight:600}
.admin-ts-form-breadcrumb a{color:#6366f1;text-decoration:none}
.admin-ts-form-breadcrumb a:hover{color:#4f46e5}
.admin-ts-form-title{margin:0;color:#202033;font-size:25px;font-weight:800;line-height:1.2}
.admin-ts-form-subtitle{margin:6px 0 0;color:#7b8194;font-size:12px}
.admin-ts-form-header-actions{display:flex;align-items:center;gap:8px}
.admin-ts-form-back,.admin-ts-form-theme{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:38px;border-radius:8px;font-size:11px;font-weight:700;transition:.2s ease}
.admin-ts-form-back{padding:8px 13px;color:#4b5563!important;background:#fff!important;border:1px solid #dfe3eb!important;text-decoration:none!important}
.admin-ts-form-back:hover{color:#4f46e5!important;background:#f5f3ff!important;border-color:#c4b5fd!important}
.admin-ts-form-theme{width:38px;min-width:38px;padding:0;color:#5b21b6!important;background:#fff!important;border:1px solid #dfe3eb!important;cursor:pointer}
.admin-ts-form-card{width:100%;padding:22px;background:#fff;border:1px solid #e3e6ee;border-radius:15px;box-shadow:0 7px 25px rgba(25,25,50,.045);box-sizing:border-box}
.admin-ts-form{width:100%}
.admin-ts-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px;padding:20px;background:#fff;border:1px solid #e3e6ee;border-radius:13px}
.admin-ts-field{min-width:0}
.admin-ts-field.full{grid-column:1/-1}
.admin-ts-field label,.admin-ts-option-fields label{display:block;margin-bottom:7px;color:#303446;font-size:11px;font-weight:700}
.admin-ts-input,.admin-ts-textarea{display:block;width:100%;padding:10px 12px;color:#25283a;background:#fff;border:1px solid #dfe3eb;border-radius:8px;outline:none;font-size:12px;font-family:inherit;transition:.2s ease;box-sizing:border-box}
.admin-ts-input{min-height:40px}
.admin-ts-textarea{min-height:105px;resize:vertical;line-height:1.6}
.admin-ts-input:focus,.admin-ts-textarea:focus{border-color:#818cf8;box-shadow:0 0 0 3px rgba(129,140,248,.12)}
.admin-ts-input::placeholder,.admin-ts-textarea::placeholder{color:#9aa1b2}
.admin-ts-section-header.form-section{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:22px 0 12px}
.admin-ts-section-header.form-section h2{margin:0;color:#242638;font-size:15px;font-weight:800}
.admin-ts-section-header.form-section p{margin:4px 0 0;color:#858b9d;font-size:10px}
#adminOptionsContainer{display:flex;flex-direction:column;gap:12px}
.admin-ts-option-form{display:grid;grid-template-columns:38px minmax(0,1fr);gap:12px;align-items:start;padding:15px;background:#fff;border:1px solid #e2e5ed;border-radius:11px;box-shadow:0 2px 8px rgba(30,35,60,.035)}
.admin-ts-option-number{width:34px;height:34px;display:flex;align-items:center;justify-content:center;color:#5b21b6;background:#f1ecff;border:1px solid #ddd2ff;border-radius:8px;font-size:11px;font-weight:800;box-sizing:border-box}
.admin-ts-option-fields{min-width:0;width:100%}
.admin-ts-option-fields label{margin-bottom:6px}
.admin-ts-option-fields .admin-ts-input{min-height:40px}
.admin-ts-option-correct{display:flex;align-items:center;gap:7px;margin-top:9px}
.admin-ts-option-correct label{margin:0;color:#5f6575;font-size:10px;font-weight:600}
.admin-ts-option-correct input[type=radio]{width:15px;height:15px;margin:0;accent-color:#6366f1}
.admin-ts-remove-option{grid-column:2;justify-self:start;display:inline-flex;align-items:center;gap:5px;min-height:32px;margin-top:-2px;padding:6px 10px;color:#dc2626!important;background:#fff5f5!important;border:1px solid #fecaca!important;border-radius:7px;font-size:10px;font-weight:700;cursor:pointer}
.admin-ts-remove-option:hover{background:#fee2e2!important}
.admin-ts-form #adminAddOption{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:8px 13px;color:#4f46e5!important;background:#fff!important;border:1px solid #dfe3eb!important;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer}
.admin-ts-errors{margin-bottom:16px;padding:12px 14px;color:#b91c1c;background:#fff5f5;border:1px solid #fecaca;border-left:4px solid #ef4444;border-radius:8px;font-size:11px}
.admin-ts-form-actions{display:flex;align-items:center;justify-content:flex-end;gap:9px;margin-top:18px;padding-top:16px;border-top:1px solid #e7e9ef}
.admin-ts-form-actions .admin-ts-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:38px;padding:8px 14px;border-radius:8px;font-size:11px;font-weight:700;text-decoration:none!important;cursor:pointer}
.admin-ts-form-actions .admin-ts-btn-primary{color:#fff!important;background:linear-gradient(135deg,#7c3aed,#4f46e5)!important;border:1px solid #6d28d9!important}
.admin-ts-form-actions .admin-ts-btn-light{color:#4b5563!important;background:#fff!important;border:1px solid #dfe3eb!important}
body:not(.admin-ts-dark):has(.admin-ts-form-page),body:not(.admin-ts-dark):has(.admin-ts-form-page) main,body:not(.admin-ts-dark):has(.admin-ts-form-page) .main-content,body:not(.admin-ts-dark):has(.admin-ts-form-page) .admin-main,body:not(.admin-ts-dark):has(.admin-ts-form-page) .content-wrapper{background:#f3f5ff!important}
body.admin-ts-dark:has(.admin-ts-form-page),body.admin-ts-dark:has(.admin-ts-form-page) main,body.admin-ts-dark:has(.admin-ts-form-page) .main-content,body.admin-ts-dark:has(.admin-ts-form-page) .admin-main,body.admin-ts-dark:has(.admin-ts-form-page) .content-wrapper{background:#0e1222!important}
body.admin-ts-dark .admin-ts-form-card,body.admin-ts-dark .admin-ts-form-grid,body.admin-ts-dark .admin-ts-option-form{background:#191e33!important;border-color:#303852!important}
body.admin-ts-dark .admin-ts-form-title,body.admin-ts-dark .admin-ts-field label,body.admin-ts-dark .admin-ts-option-fields label,body.admin-ts-dark .admin-ts-section-header.form-section h2{color:#f1f3f8}
body.admin-ts-dark .admin-ts-form-breadcrumb,body.admin-ts-dark .admin-ts-form-subtitle,body.admin-ts-dark .admin-ts-section-header.form-section p{color:#9da6bd}
body.admin-ts-dark .admin-ts-form-breadcrumb a{color:#a78bfa}
body.admin-ts-dark .admin-ts-input,body.admin-ts-dark .admin-ts-textarea{color:#f1f3f8;background:#151a2c;border-color:#39415d}
body.admin-ts-dark .admin-ts-option-number{color:#c4b5fd;background:#252044;border-color:#5146a8}
body.admin-ts-dark .admin-ts-option-correct label{color:#c8cede}
body.admin-ts-dark .admin-ts-form-back,body.admin-ts-dark .admin-ts-form-theme,body.admin-ts-dark .admin-ts-form #adminAddOption,body.admin-ts-dark .admin-ts-form-actions .admin-ts-btn-light{color:#c7ccda!important;background:#191e33!important;border-color:#3b4565!important}
