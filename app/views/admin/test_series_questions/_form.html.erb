<div class="admin-ts-form-page">

  <div class="admin-ts-form-shell">

    <div class="admin-ts-form-header">

      <div>

        <div class="admin-ts-form-breadcrumb">

          <%= link_to @test_series.title,
                      admin_test_series_path(@test_series) %>

          /

          <%= link_to @test.title,
                      admin_test_series_test_path(
                        @test_series,
                        @test
                      ) %>

          /

          <%= @question.persisted? ? "Edit Question" : "Add Question" %>

        </div>

        <h1 class="admin-ts-form-title">
          <%= @question.persisted? ? "Edit Question" : "Add New Question" %>
        </h1>

        <p class="admin-ts-form-subtitle">
          Create the question and answer options in Hindi.
        </p>

      </div>

      <div class="admin-ts-form-header-actions">

        <%= link_to admin_test_series_test_path(
                      @test_series,
                      @test
                    ),
                    class: "admin-ts-form-back" do %>

          <i class="fas fa-arrow-left"></i>

          <span>Back</span>

        <% end %>

        <button
          type="button"
          class="admin-ts-form-theme"
          id="adminTsFormThemeToggle"
          aria-label="Switch to night mode"
          title="Switch to night mode">

          <i class="fas fa-moon"
             id="adminTsFormThemeIcon"></i>

        </button>

      </div>

    </div>

    <div class="admin-ts-form-card">

      <%= form_with(
            model: @question,
            url: @question.persisted? ?
              admin_test_series_test_question_path(
                @test_series,
                @test,
                @question
              ) :
              admin_test_series_test_questions_path(
                @test_series,
                @test
              ),
            method: @question.persisted? ? :patch : :post,
            local: true,
            class: "admin-ts-form",
            id: "adminQuestionForm"
          ) do |form| %>

        <% if @question.errors.any? %>

          <div class="admin-ts-errors">

            <strong>
              Please correct the following errors:
            </strong>

            <ul>
              <% @question.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>

          </div>

        <% end %>

        <div class="admin-ts-form-grid">

          <div class="admin-ts-field full">

            <%= form.label :question_text_hindi, "Question" %>

            <%= form.text_area :question_text_hindi,
                  class: "admin-ts-textarea",
                  rows: 4,
                  placeholder: "Enter question in Hindi" %>

          </div>

          <div class="admin-ts-field">

            <%= form.label :marks, "Marks" %>

            <%= form.number_field :marks,
                  class: "admin-ts-input",
                  min: 1,
                  step: 1,
                  placeholder: "e.g. 1" %>

          </div>

          <div class="admin-ts-field">

            <%= form.label :position, "Question Number" %>

            <%= form.number_field :position,
                  class: "admin-ts-input",
                  min: 1,
                  step: 1,
                  placeholder: "e.g. 1" %>

          </div>

          <div class="admin-ts-field">

            <%= form.label :question_type, "Question Type" %>

            <%= form.text_field :question_type,
                  class: "admin-ts-input",
                  placeholder: "MCQ" %>

          </div>

          <div class="admin-ts-field full">

            <%= form.label :explanation_hindi, "Explanation" %>

            <%= form.text_area :explanation_hindi,
                  class: "admin-ts-textarea",
                  rows: 4,
                  placeholder: "Enter the explanation for the correct answer in Hindi" %>

          </div>

        </div>

        <div class="admin-ts-section-header form-section">

          <div>

            <h2>
              Answer Options
            </h2>

            <p>
              Add at least two options and select only one correct answer.
            </p>

          </div>

          <button
            type="button"
            id="adminAddOption">

            <i class="fas fa-plus"></i>

            Add Option

          </button>

        </div>

        <div id="adminOptionsContainer">

          <% @question.test_series_options.each_with_index do |option, index| %>

            <div class="admin-ts-option-form">

              <div class="admin-ts-option-number">
                <%= index + 1 %>
              </div>

              <div class="admin-ts-option-fields">

                <%= form.fields_for :test_series_options, option do |option_form| %>

                  <%= option_form.hidden_field :id if option.persisted? %>

                  <%= option_form.label :option_text_hindi, "Option" %>

                  <%= option_form.text_field :option_text_hindi,
                        class: "admin-ts-input",
                        placeholder: "Enter option in Hindi" %>

                  <div class="admin-ts-option-correct">

                    <%= option_form.radio_button :is_correct,
                          true,
                          class: "admin-correct-radio" %>

                    <%= option_form.label :is_correct,
                          "Correct Answer" %>

                  </div>

                <% end %>

              </div>

              <button
                type="button"
                class="admin-ts-remove-option">

                <i class="fas fa-trash-alt"></i>

                Remove

              </button>

            </div>

          <% end %>

        </div>

        <div class="admin-ts-form-actions">

          <%= link_to admin_test_series_test_path(
                        @test_series,
                        @test
                      ),
                      class: "admin-ts-btn admin-ts-btn-light" do %>

            <i class="fas fa-times"></i>

            Cancel

          <% end %>

          <%= form.submit(
                @question.persisted? ?
                  "Update Question" :
                  "Create Question",
                class: "admin-ts-btn admin-ts-btn-primary"
              ) %>

        </div>

      <% end %>

    </div>

  </div>

</div>

<script nonce="<%= content_security_policy_nonce %>">
(function() {

  function applyAdminTsFormTheme() {

    const isDark =
      localStorage.getItem("admin-ts-theme") === "dark";

    const icon =
      document.getElementById("adminTsFormThemeIcon");

    const toggle =
      document.getElementById("adminTsFormThemeToggle");

    document.body.classList.toggle(
      "admin-ts-dark",
      isDark
    );

    if (icon) {

      icon.classList.remove(
        "fa-moon",
        "fa-sun"
      );

      icon.classList.add(
        isDark ? "fa-sun" : "fa-moon"
      );

    }

    if (toggle) {

      const label =
        isDark
          ? "Switch to day mode"
          : "Switch to night mode";

      toggle.setAttribute(
        "aria-label",
        label
      );

      toggle.setAttribute(
        "title",
        label
      );

    }

  }

  function initAdminTsFormTheme() {

    applyAdminTsFormTheme();

    const toggle =
      document.getElementById(
        "adminTsFormThemeToggle"
      );

    if (
      !toggle ||
      toggle.dataset.themeReady === "true"
    ) {
      return;
    }

    toggle.dataset.themeReady = "true";

    toggle.addEventListener(
      "click",
      function() {

        const isDark =
          !document.body.classList.contains(
            "admin-ts-dark"
          );

        document.body.classList.toggle(
          "admin-ts-dark",
          isDark
        );

        localStorage.setItem(
          "admin-ts-theme",
          isDark ? "dark" : "light"
        );

        applyAdminTsFormTheme();

      }
    );

  }

  function initializeAdminQuestionForm() {

    const container =
      document.getElementById(
        "adminOptionsContainer"
      );

    const addButton =
      document.getElementById(
        "adminAddOption"
      );

    const form =
      document.getElementById(
        "adminQuestionForm"
      );

    if (!container || !addButton || !form) {
      return;
    }

    if (
      form.dataset.questionFormReady === "true"
    ) {
      return;
    }

    form.dataset.questionFormReady = "true";

    function getActiveRows() {

      return Array.from(
        container.querySelectorAll(
          ".admin-ts-option-form"
        )
      );

    }

    function updatePositions() {

      getActiveRows().forEach(
        function(row, index) {

          const number =
            row.querySelector(
              ".admin-ts-option-number"
            );

          if (number) {
            number.textContent = index + 1;
          }

        }
      );

    }

    function enforceSingleCorrect(selectedRadio) {

      const radios =
        container.querySelectorAll(
          'input[type="radio"].admin-correct-radio, input[type="radio"].admin-dynamic-correct-radio'
        );

      radios.forEach(
        function(radio) {

          if (radio !== selectedRadio) {
            radio.checked = false;
          }

        }
      );

    }

    function nextIndex() {

      return container.querySelectorAll(
        ".admin-ts-option-form"
      ).length;

    }

    function addOption() {

      const index =
        nextIndex();

      const wrapper =
        document.createElement("div");

      wrapper.className =
        "admin-ts-option-form";

      wrapper.innerHTML = `
        <div class="admin-ts-option-number">
          ${index + 1}
        </div>

        <div class="admin-ts-option-fields">

          <label>
            Option
          </label>

          <input
            type="text"
            name="question[test_series_options_attributes][${index}][option_text_hindi]"
            class="admin-ts-input"
            placeholder="Enter option in Hindi"
          >

          <input
            type="hidden"
            name="question[test_series_options_attributes][${index}][is_correct]"
            value="0"
            class="admin-hidden-correct"
          >

          <div class="admin-ts-option-correct">

            <input
              type="radio"
              name="admin_correct_option"
              value="${index}"
              class="admin-dynamic-correct-radio"
              data-correct-option="${index}"
            >

            <label>
              Correct Answer
            </label>

          </div>

        </div>

        <button
          type="button"
          class="admin-ts-remove-option">

          <i class="fas fa-trash-alt"></i>

          Remove

        </button>
      `;

      container.appendChild(wrapper);

      updatePositions();

    }

    addButton.addEventListener(
      "click",
      function() {
        addOption();
      }
    );

    container.addEventListener(
      "click",
      function(event) {

        const removeButton =
          event.target.closest(
            ".admin-ts-remove-option"
          );

        if (!removeButton) {
          return;
        }

        const rows =
          getActiveRows();

        if (rows.length <= 2) {

          alert(
            "At least 2 options are required."
          );

          return;
        }

        const row =
          removeButton.closest(
            ".admin-ts-option-form"
          );

        if (row) {
          row.remove();
        }

        updatePositions();

      }
    );

    container.addEventListener(
      "change",
      function(event) {

        const radio =
          event.target.closest(
            'input[type="radio"].admin-correct-radio, input[type="radio"].admin-dynamic-correct-radio'
          );

        if (!radio) {
          return;
        }

        enforceSingleCorrect(radio);

        getActiveRows().forEach(
          function(row) {

            const correctRadio =
              row.querySelector(
                'input[type="radio"].admin-correct-radio, input[type="radio"].admin-dynamic-correct-radio'
              );

            const hidden =
              row.querySelector(
                ".admin-hidden-correct"
              );

            if (hidden) {

              hidden.value =
                correctRadio &&
                correctRadio.checked
                  ? "1"
                  : "0";

            }

          }
        );

      }
    );

    form.addEventListener(
      "submit",
      function(event) {

        const rows =
          getActiveRows();

        if (rows.length < 2) {

          event.preventDefault();

          alert(
            "At least 2 options are required."
          );

          return;

        }

        const checked =
          container.querySelectorAll(
            'input[type="radio"].admin-correct-radio:checked, input[type="radio"].admin-dynamic-correct-radio:checked'
          );

        if (checked.length !== 1) {

          event.preventDefault();

          alert(
            "Please select only one correct answer."
          );

          return;

        }

        rows.forEach(
          function(row) {

            const correctRadio =
              row.querySelector(
                'input[type="radio"].admin-correct-radio, input[type="radio"].admin-dynamic-correct-radio'
              );

            const hidden =
              row.querySelector(
                ".admin-hidden-correct"
              );

            if (hidden) {

              hidden.value =
                correctRadio &&
                correctRadio.checked
                  ? "1"
                  : "0";

            }

          }
        );

      }
    );

    updatePositions();

  }

  document.addEventListener(
    "turbo:load",
    function() {

      initAdminTsFormTheme();
      initializeAdminQuestionForm();

    }
  );

  document.addEventListener(
    "DOMContentLoaded",
    function() {

      initAdminTsFormTheme();
      initializeAdminQuestionForm();

    }
  );

  initAdminTsFormTheme();
  initializeAdminQuestionForm();

})();
</script>