<div class="admin-enrollment-show">

  <!-- =====================================================
       HEADER
  ====================================================== -->

  <div class="show-header">

    <div>

      <div class="breadcrumb-text">

        <%= link_to "Enrollments",
              admin_enrollments_path %>

        <i class="bi bi-chevron-right"></i>

        Enrollment Details

      </div>

      <h2>
        <i class="bi bi-person-vcard-fill"></i>
        Enrollment Details
      </h2>

      <p>
        View complete enrollment information
      </p>

    </div>


    <div class="header-actions">

      <%= link_to admin_enrollments_path,
            class: "btn-back" do %>

        <i class="bi bi-arrow-left"></i>
        Back

      <% end %>


      <%= link_to edit_admin_enrollment_path(@enrollment),
            class: "btn-edit" do %>

        <i class="bi bi-pencil-fill"></i>
        Edit

      <% end %>

    </div>

  </div>


  <!-- =====================================================
       MAIN CARD
  ====================================================== -->

  <div class="details-card">


    <!-- ===================================================
         STUDENT INFORMATION
    ==================================================== -->

    <div class="details-section">

      <div class="section-title">

        <i class="bi bi-person-fill"></i>

        <h5>
          Student Information
        </h5>

      </div>


      <div class="student-profile">

        <div class="large-avatar">

          <i class="bi bi-person-fill"></i>

        </div>


        <div>

          <h4>
            <%= @enrollment.user&.name.presence || "Unknown Student" %>
          </h4>

          <p>

            <i class="bi bi-envelope"></i>

            <%= @enrollment.user&.email || "No email available" %>

          </p>

        </div>

      </div>

    </div>


    <!-- ===================================================
         COURSE INFORMATION
    ==================================================== -->

    <div class="details-section">

      <div class="section-title">

        <i class="bi bi-book-fill"></i>

        <h5>
          Course Information
        </h5>

      </div>


      <div class="info-grid">

        <div class="info-item">

          <span>
            Course Name
          </span>

          <strong>

            <%= @enrollment.course&.Course_name ||
                "Course unavailable" %>

          </strong>

        </div>


        <% if @enrollment.course&.respond_to?(:fee) %>

          <div class="info-item">

            <span>
              Course Fee
            </span>

            <strong>

              ₹<%= number_with_precision(
                    @enrollment.course.fee,
                    precision: 2
                  ) %>

            </strong>

          </div>

        <% end %>

      </div>

    </div>


    <!-- ===================================================
         ENROLLMENT INFORMATION
    ==================================================== -->

    <div class="details-section">

      <div class="section-title">

        <i class="bi bi-clipboard-check-fill"></i>

        <h5>
          Enrollment Information
        </h5>

      </div>


      <div class="info-grid">


        <!-- ENROLLMENT ID -->

        <div class="info-item">

          <span>
            Enrollment ID
          </span>

          <strong>
            #<%= @enrollment.id %>
          </strong>

        </div>


        <!-- STATUS -->

        <div class="info-item">

          <span>
            Status
          </span>

          <div>

            <% if @enrollment.status == "Approved" %>

              <span class="status approved">

                <i class="bi bi-check-circle-fill"></i>

                Approved

              </span>

            <% elsif @enrollment.status == "Pending" %>

              <span class="status pending">

                <i class="bi bi-clock-fill"></i>

                Pending

              </span>

            <% else %>

              <span class="status cancelled">

                <i class="bi bi-x-circle-fill"></i>

                <%= @enrollment.status.presence || "Cancelled" %>

              </span>

            <% end %>

          </div>

        </div>


        <!-- ENROLLED DATE -->

        <div class="info-item">

          <span>
            Enrolled On
          </span>

          <strong>

            <%= @enrollment.created_at.strftime("%d %B %Y") %>

          </strong>

        </div>


        <!-- UPDATED DATE -->

        <div class="info-item">

          <span>
            Last Updated
          </span>

          <strong>

            <%= @enrollment.updated_at.strftime("%d %B %Y") %>

          </strong>

        </div>

      </div>

    </div>


    <!-- ===================================================
         ACTIONS
    ==================================================== -->

    <div class="bottom-actions">


      <%= link_to edit_admin_enrollment_path(@enrollment),
            class: "primary-action" do %>

        <i class="bi bi-pencil-fill"></i>

        Edit Enrollment

      <% end %>


      <%= link_to admin_enrollment_path(@enrollment),
            data: {
              turbo_method: :delete,
              turbo_confirm: "Delete this enrollment permanently?"
            },
            class: "danger-action" do %>

        <i class="bi bi-trash-fill"></i>

        Delete Enrollment

      <% end %>

    </div>

  </div>

</div>


<!-- =========================================================
     CSS
========================================================= -->

<style>

.admin-enrollment-show {

  min-height: 100vh;

  padding: 30px;

  background: #f6f8fc;

  font-family:
    "Poppins",
    Arial,
    sans-serif;
}


/* =========================================================
   HEADER
========================================================= */

.show-header {

  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 20px;

  margin-bottom: 25px;
}


.breadcrumb-text {

  margin-bottom: 8px;

  color: #8a94a6;

  font-size: 13px;
}


.breadcrumb-text a {

  color: #0d6efd;

  text-decoration: none;
}


.breadcrumb-text a:hover {

  text-decoration: underline;
}


.breadcrumb-text i {

  margin: 0 6px;

  font-size: 10px;
}


.show-header h2 {

  margin: 0;

  color: #172033;

  font-size: 28px;

  font-weight: 700;
}


.show-header h2 i {

  color: #0d6efd;

  margin-right: 8px;
}


.show-header p {

  margin: 5px 0 0;

  color: #7b8494;

  font-size: 14px;
}


/* =========================================================
   HEADER BUTTONS
========================================================= */

.header-actions {

  display: flex;

  gap: 10px;
}


.btn-back,
.btn-edit {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  padding: 10px 17px;

  border-radius: 9px;

  text-decoration: none;

  font-weight: 600;

  font-size: 14px;

  transition: 0.2s ease;
}


.btn-back {

  background: #ffffff;

  color: #495057;

  border: 1px solid #dfe5ee;
}


.btn-back:hover {

  background: #f8fafc;

  color: #172033;
}


.btn-edit {

  background: #0d6efd;

  color: #ffffff;

  border: 1px solid #0d6efd;
}


.btn-edit:hover {

  background: #0b5ed7;

  color: #ffffff;

  transform: translateY(-1px);
}


/* =========================================================
   CARD
========================================================= */

.details-card {

  max-width: 1000px;

  background: #ffffff;

  border: 1px solid #e8edf5;

  border-radius: 18px;

  box-shadow:
    0 10px 30px
    rgba(15, 23, 42, 0.06);

  overflow: hidden;
}


/* =========================================================
   SECTION
========================================================= */

.details-section {

  padding: 25px;

  border-bottom: 1px solid #edf0f5;
}


.section-title {

  display: flex;

  align-items: center;

  gap: 10px;

  margin-bottom: 20px;
}


.section-title i {

  color: #0d6efd;

  font-size: 19px;
}


.section-title h5 {

  margin: 0;

  color: #172033;

  font-weight: 700;

  font-size: 17px;
}


/* =========================================================
   STUDENT
========================================================= */

.student-profile {

  display: flex;

  align-items: center;

  gap: 16px;
}


.large-avatar {

  width: 65px;

  height: 65px;

  flex-shrink: 0;

  border-radius: 50%;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #e8f1ff;

  color: #0d6efd;

  font-size: 28px;
}


.student-profile h4 {

  margin: 0 0 6px;

  color: #172033;

  font-size: 19px;

  font-weight: 700;
}


.student-profile p {

  margin: 0;

  color: #6b7280;

  font-size: 14px;
}


.student-profile p i {

  margin-right: 5px;
}


/* =========================================================
   INFORMATION GRID
========================================================= */

.info-grid {

  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 20px;
}


.info-item {

  padding: 16px;

  background: #f8fafc;

  border: 1px solid #edf0f5;

  border-radius: 12px;
}


.info-item > span {

  display: block;

  color: #8a94a6;

  font-size: 12px;

  margin-bottom: 6px;

  font-weight: 600;
}


.info-item strong {

  color: #172033;

  font-size: 15px;

  font-weight: 700;
}


/* =========================================================
   STATUS
========================================================= */

.status {

  display: inline-flex;

  align-items: center;

  gap: 6px;

  padding: 6px 12px;

  border-radius: 20px;

  font-size: 12px;

  font-weight: 700;
}


.status.approved {

  background: #e5f8ed;

  color: #198754;
}


.status.pending {

  background: #fff4d6;

  color: #a56b00;
}


.status.cancelled {

  background: #fde8e8;

  color: #dc3545;
}


/* =========================================================
   BOTTOM ACTIONS
========================================================= */

.bottom-actions {

  display: flex;

  gap: 10px;

  padding: 22px 25px;

  background: #ffffff;
}


.primary-action,
.danger-action {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  padding: 11px 18px;

  border-radius: 9px;

  text-decoration: none;

  font-weight: 600;

  font-size: 14px;

  transition: 0.2s ease;
}


.primary-action {

  background: #0d6efd;

  color: #ffffff;
}


.primary-action:hover {

  background: #0b5ed7;

  color: #ffffff;

  transform: translateY(-1px);
}


.danger-action {

  background: #fde8e8;

  color: #dc3545;

  border: 1px solid #f5c2c7;
}


.danger-action:hover {

  background: #f8d7da;

  color: #b02a37;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

  .admin-enrollment-show {

    padding: 15px;

  }


  .show-header {

    align-items: flex-start;

    flex-direction: column;

  }


  .show-header h2 {

    font-size: 23px;

  }


  .header-actions {

    width: 100%;

  }


  .btn-back,
  .btn-edit {

    flex: 1;

    text-align: center;

  }


  .details-section {

    padding: 20px 16px;

  }


  .info-grid {

    grid-template-columns: 1fr;

    gap: 12px;

  }


  .bottom-actions {

    flex-direction: column;

    padding: 18px 16px;

  }


  .primary-action,
  .danger-action {

    width: 100%;

    text-align: center;

  }

}


@media (max-width: 480px) {

  .student-profile {

    align-items: flex-start;

  }


  .large-avatar {

    width: 52px;

    height: 52px;

    font-size: 22px;

  }


  .student-profile h4 {

    font-size: 16px;

  }

}

</style>