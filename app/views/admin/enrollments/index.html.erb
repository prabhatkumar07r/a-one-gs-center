
<div class="admin-enrollments-page">

  <!-- =========================================================
       HEADER
  ========================================================== -->

  <div class="page-header">
    <div>
      <h2>
        <i class="bi bi-mortarboard-fill"></i>
        Enrollment Management
      </h2>

      <p>
        Manage student course enrollments
      </p>
    </div>
  </div>


  <!-- =========================================================
       STATISTICS
  ========================================================== -->

  <div class="row g-4 mb-4">

    <div class="col-md-4">
      <div class="stat-card total-card">
        <div class="stat-icon">
          <i class="bi bi-people-fill"></i>
        </div>

        <div>
          <span>Total Enrollments</span>
          <strong><%= @total_enrollments || 0 %></strong>
        </div>
      </div>
    </div>


    <div class="col-md-4">
      <div class="stat-card pending-card">
        <div class="stat-icon">
          <i class="bi bi-hourglass-split"></i>
        </div>

        <div>
          <span>Pending</span>
          <strong><%= @pending || 0 %></strong>
        </div>
      </div>
    </div>


    <div class="col-md-4">
      <div class="stat-card approved-card">
        <div class="stat-icon">
          <i class="bi bi-check-circle-fill"></i>
        </div>

        <div>
          <span>Approved</span>
          <strong><%= @approved || 0 %></strong>
        </div>
      </div>
    </div>

  </div>


  <!-- =========================================================
       SEARCH
  ========================================================== -->

  <div class="search-card">

    <%= form_with url: admin_enrollments_path,
                  method: :get,
                  local: true do %>

      <div class="search-wrapper">

        <div class="search-input">

          <i class="bi bi-search"></i>

          <%= text_field_tag :search,
                params[:search],
                placeholder: "Search student name or email...",
                autocomplete: "off" %>

        </div>

        <%= submit_tag "Search",
              class: "search-button" %>


        <% if params[:search].present? %>

          <%= link_to admin_enrollments_path,
                class: "clear-button" do %>

            <i class="bi bi-x-lg"></i>
            Clear

          <% end %>

        <% end %>

      </div>

    <% end %>

  </div>


  <!-- =========================================================
       TABLE
  ========================================================== -->

  <div class="enrollment-table-card">

    <div class="table-header">

      <div>
        <h5>All Enrollments</h5>

        <small>
          Student enrollment records
        </small>
      </div>

      <span class="record-count">
        <%= @enrollments.respond_to?(:total_count) ? @enrollments.total_count : @enrollments.size %>
      </span>

    </div>


    <div class="table-responsive">

      <table class="enrollment-table">

        <thead>
          <tr>
            <th>#</th>
            <th>Student</th>
            <th>Course</th>
            <th>Status</th>
            <th>Enrolled On</th>
            <th>Actions</th>
          </tr>
        </thead>


        <tbody>

          <% if @enrollments.present? %>

            <% @enrollments.each_with_index do |enrollment, index| %>

              <tr>

                <!-- NUMBER -->

                <td>
                  <span class="row-number">
                    <%= index + 1 %>
                  </span>
                </td>


                <!-- STUDENT -->

                <td>

                  <div class="student-info">

                    <div class="student-avatar">
                      <i class="bi bi-person-fill"></i>
                    </div>

                    <div>

                      <strong>
                        <%= enrollment.user&.name.presence || "Unknown Student" %>
                      </strong>

                      <small>
                        <%= enrollment.user&.email.presence || "No email available" %>
                      </small>

                    </div>

                  </div>

                </td>


                <!-- COURSE -->

                <td>

                  <% if enrollment.course.present? %>

                    <div class="course-info">

                      <i class="bi bi-book-fill"></i>

                      <span>
                        <%= enrollment.course.Course_name %>
                      </span>

                    </div>

                  <% else %>

                    <span class="text-muted">
                      Course unavailable
                    </span>

                  <% end %>

                </td>


                <!-- STATUS -->

                <td>

                  <% if enrollment.status == "Approved" %>

                    <span class="status-badge approved">
                      <i class="bi bi-check-circle-fill"></i>
                      Approved
                    </span>

                  <% elsif enrollment.status == "Pending" %>

                    <span class="status-badge pending">
                      <i class="bi bi-clock-fill"></i>
                      Pending
                    </span>

                  <% elsif enrollment.status == "Cancelled" %>

                    <span class="status-badge cancelled">
                      <i class="bi bi-x-circle-fill"></i>
                      Cancelled
                    </span>

                  <% else %>

                    <span class="status-badge cancelled">
                      <%= enrollment.status.presence || "Unknown" %>
                    </span>

                  <% end %>

                </td>


                <!-- DATE -->

                <td>

                  <span class="date-text">
                    <%= enrollment.created_at&.strftime("%d %b %Y") || "—" %>
                  </span>

                </td>


                <!-- ACTIONS -->

                <td>

                  <div class="action-buttons">

                    <%= link_to admin_enrollment_path(enrollment),
                          class: "action-btn view-btn",
                          title: "View Enrollment" do %>

                      <i class="bi bi-eye-fill"></i>

                    <% end %>


                    <%= link_to edit_admin_enrollment_path(enrollment),
                          class: "action-btn edit-btn",
                          title: "Edit Enrollment" do %>

                      <i class="bi bi-pencil-fill"></i>

                    <% end %>


                    <%= link_to admin_enrollment_path(enrollment),
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: "Delete this enrollment?"
                          },
                          class: "action-btn delete-btn",
                          title: "Delete Enrollment" do %>

                      <i class="bi bi-trash-fill"></i>

                    <% end %>

                  </div>

                </td>

              </tr>

            <% end %>

          <% else %>

            <!-- EMPTY STATE -->

            <tr>

              <td colspan="6">

                <div class="empty-state">

                  <i class="bi bi-inbox"></i>

                  <h5>
                    No enrollments found
                  </h5>

                  <p>
                    There are no enrollment records matching your search.
                  </p>

                  <% if params[:search].present? %>

                    <%= link_to "Clear Search",
                          admin_enrollments_path,
                          class: "empty-clear-btn" %>

                  <% end %>

                </div>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>


    <!-- PAGINATION -->

    <% if @enrollments.respond_to?(:total_pages) &&
          @enrollments.total_pages > 1 %>

      <div class="pagination-wrapper">
        <%= paginate @enrollments %>
      </div>

    <% end %>

  </div>

</div>


<!-- =============================================================
     CSS
============================================================= -->

<style>

.admin-enrollments-page {
  padding: 25px;
  background: #f6f8fc;
  min-height: 100vh;
  font-family: "Poppins", Arial, sans-serif;
}


/* HEADER */

.page-header {
  margin-bottom: 25px;
}

.page-header h2 {
  margin: 0;
  color: #172033;
  font-size: 27px;
  font-weight: 700;
}

.page-header h2 i {
  color: #8009e2;
  margin-right: 8px;
}

.page-header p {
  margin: 5px 0 0;
  color: #7b8494;
}


/* STAT CARDS */

.stat-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 22px;
  background: #fff;
  border-radius: 16px;
  border: 1px solid #e8edf5;
  box-shadow: 0 8px 25px rgba(15, 23, 42, .06);
  transition: .2s ease;
}

.stat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 30px rgba(15, 23, 42, .09);
}

.stat-icon {
  width: 54px;
  height: 54px;
  flex-shrink: 0;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
}

.total-card .stat-icon {
  background: #f1e5ff;
  color: #8009e2;
}

.pending-card .stat-icon {
  background: #fff4d6;
  color: #d99a00;
}

.approved-card .stat-icon {
  background: #e5f8ed;
  color: #198754;
}

.stat-card span {
  display: block;
  color: #6b7280;
  font-size: 13px;
}

.stat-card strong {
  display: block;
  margin-top: 3px;
  font-size: 27px;
  color: #172033;
}


/* SEARCH */

.search-card {
  background: #fff;
  padding: 18px;
  border-radius: 16px;
  border: 1px solid #e8edf5;
  margin-bottom: 20px;
}

.search-wrapper {
  display: flex;
  gap: 10px;
}

.search-input {
  flex: 1;
  position: relative;
}

.search-input i {
  position: absolute;
  left: 15px;
  top: 50%;
  transform: translateY(-50%);
  color: #8a94a6;
  pointer-events: none;
}

.search-input input {
  width: 100%;
  height: 46px;
  padding: 0 15px 0 42px;
  border: 1px solid #dce2eb;
  border-radius: 10px;
  outline: none;
  transition: .2s ease;
}

.search-input input:focus {
  border-color: #8009e2;
  box-shadow: 0 0 0 3px rgba(128, 9, 226, .10);
}

.search-button {
  border: none;
  padding: 0 25px;
  border-radius: 10px;
  background: #8009e2;
  color: #fff;
  font-weight: 600;
  cursor: pointer;
  transition: .2s ease;
}

.search-button:hover {
  background: #6807b8;
}

.clear-button {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 15px;
  border-radius: 10px;
  background: #f1f3f5;
  color: #495057;
  text-decoration: none;
}


/* TABLE */

.enrollment-table-card {
  background: #fff;
  border-radius: 16px;
  border: 1px solid #e8edf5;
  overflow: hidden;
  box-shadow: 0 8px 25px rgba(15, 23, 42, .05);
}

.table-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 22px;
  border-bottom: 1px solid #edf0f5;
}

.table-header h5 {
  margin: 0;
  font-weight: 700;
  color: #172033;
}

.table-header small {
  color: #8a94a6;
}

.record-count {
  background: #f1e5ff;
  color: #8009e2;
  padding: 6px 12px;
  border-radius: 20px;
  font-weight: 600;
}

.enrollment-table {
  width: 100%;
  border-collapse: collapse;
}

.enrollment-table th {
  background: #172033;
  color: #fff;
  padding: 14px 16px;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  text-align: left;
}

.enrollment-table td {
  padding: 15px 16px;
  border-bottom: 1px solid #edf0f5;
  vertical-align: middle;
}

.enrollment-table tbody tr:hover {
  background: #faf8ff;
}

.row-number {
  color: #8a94a6;
  font-weight: 600;
}


/* STUDENT */

.student-info {
  display: flex;
  align-items: center;
  gap: 11px;
}

.student-avatar {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1e5ff;
  color: #8009e2;
}

.student-info strong {
  display: block;
  color: #172033;
  font-size: 14px;
}

.student-info small {
  display: block;
  margin-top: 2px;
  color: #8a94a6;
  font-size: 12px;
}


/* COURSE */

.course-info {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #374151;
  font-weight: 600;
}

.course-info i {
  color: #8009e2;
}


/* STATUS */

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 11px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.status-badge.approved {
  background: #e5f8ed;
  color: #198754;
}

.status-badge.pending {
  background: #fff4d6;
  color: #a56b00;
}

.status-badge.cancelled {
  background: #fde8e8;
  color: #dc3545;
}


/* DATE */

.date-text {
  color: #6b7280;
  font-size: 13px;
  white-space: nowrap;
}


/* ACTIONS */

.action-buttons {
  display: flex;
  gap: 6px;
}

.action-btn {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: .2s ease;
}

.action-btn:hover {
  transform: translateY(-2px);
}

.view-btn {
  background: #e8f1ff;
  color: #0d6efd;
}

.edit-btn {
  background: #fff4d6;
  color: #a56b00;
}

.delete-btn {
  background: #fde8e8;
  color: #dc3545;
}


/* EMPTY */

.empty-state {
  padding: 60px 20px;
  text-align: center;
}

.empty-state i {
  font-size: 45px;
  color: #c7ced9;
}

.empty-state h5 {
  margin-top: 15px;
  color: #495057;
}

.empty-state p {
  color: #8a94a6;
}

.empty-clear-btn {
  display: inline-flex;
  padding: 9px 18px;
  border-radius: 9px;
  background: #8009e2;
  color: #fff;
  text-decoration: none;
  font-weight: 600;
}


/* PAGINATION */

.pagination-wrapper {
  padding: 20px;
  display: flex;
  justify-content: center;
}


/* MOBILE */

@media (max-width: 768px) {

  .admin-enrollments-page {
    padding: 15px;
  }

  .page-header h2 {
    font-size: 22px;
  }

  .search-wrapper {
    flex-direction: column;
  }

  .search-button,
  .clear-button {
    min-height: 45px;
    justify-content: center;
  }

  .enrollment-table {
    min-width: 950px;
  }

}

</style>


<!-- =============================================================
     JAVASCRIPT
============================================================= -->

<script>

document.addEventListener("DOMContentLoaded", function () {

  const searchInput =
    document.querySelector(
      ".admin-enrollments-page .search-input input"
    );

  if (searchInput) {

    searchInput.addEventListener("keydown", function (event) {

      if (event.key === "Escape") {

        searchInput.value = "";
        searchInput.focus();

      }

    });

  }


  document
    .querySelectorAll(".admin-enrollments-page .action-btn")
    .forEach(function (button) {

      button.addEventListener("click", function () {

        button.classList.add("clicked");

        setTimeout(function () {
          button.classList.remove("clicked");
        }, 200);

      });

    });

});

</script>

