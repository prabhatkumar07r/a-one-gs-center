<% content_for :page_title, "Manage PDFs" %>

<style nonce="<%= content_security_policy_nonce %>">

.admin-ebook-files-page {
  min-height: 100vh;
  padding: 32px 20px 60px;
  background: #f6f8fc;
  font-family: Inter, system-ui, -apple-system,
    BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.admin-ebook-files-wrapper {
  width: 100%;
  max-width: 1150px;
  margin: 0 auto;
}

/* ================================
   HEADER
================================ */

.ebook-files-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  margin-bottom: 22px;
}

.ebook-files-header-left {
  min-width: 0;
}

.ebook-files-kicker {
  display: block;

  margin-bottom: 5px;

  color: #2563eb;

  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.ebook-files-header h1 {
  margin: 0;

  color: #0f172a;

  font-size: 28px;
  font-weight: 750;
}

.ebook-files-header p {
  margin: 6px 0 0;

  color: #64748b;

  font-size: 13px;
}

/* ================================
   BUTTONS
================================ */

.ebook-files-actions {
  display: flex;
  gap: 10px;
  flex-shrink: 0;
}

.ebook-files-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  min-height: 44px;
  padding: 0 16px;

  border-radius: 10px;

  font-size: 13px;
  font-weight: 700;

  text-decoration: none;

  transition: all 0.2s ease;
}

.ebook-files-btn.secondary {
  color: #475569;
  background: #ffffff;
  border: 1px solid #cbd5e1;
}

.ebook-files-btn.secondary:hover {
  color: #1e293b;
  background: #f8fafc;
}

.ebook-files-btn.primary {
  color: #ffffff;
  background: #2563eb;
  border: 1px solid #2563eb;
}

.ebook-files-btn.primary:hover {
  background: #1d4ed8;
  border-color: #1d4ed8;
  transform: translateY(-1px);
}

/* ================================
   E-BOOK CONTEXT
================================ */

.ebook-files-context {
  display: flex;
  align-items: center;
  gap: 14px;

  margin-bottom: 22px;
  padding: 16px 18px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  box-shadow: 0 5px 18px rgba(15, 23, 42, 0.04);
}

.ebook-files-context-icon {
  width: 46px;
  height: 46px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  color: #2563eb;
  background: #dbeafe;

  border-radius: 12px;
}

.ebook-files-context-content {
  min-width: 0;
  flex: 1;
}

.ebook-files-context-label {
  display: block;

  color: #94a3b8;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

.ebook-files-context-content strong {
  display: block;

  overflow: hidden;

  margin-top: 3px;

  color: #1e293b;

  font-size: 15px;
  font-weight: 700;

  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ================================
   FILE LIST
================================ */

.ebook-files-card {
  overflow: hidden;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 18px;

  box-shadow:
    0 10px 30px rgba(15, 23, 42, 0.05),
    0 2px 8px rgba(15, 23, 42, 0.03);
}

.ebook-files-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 20px 22px;

  border-bottom: 1px solid #e5e7eb;
}

.ebook-files-card-header h2 {
  margin: 0;

  color: #0f172a;

  font-size: 17px;
  font-weight: 750;
}

.ebook-files-count {
  padding: 6px 10px;

  color: #1d4ed8;
  background: #eff6ff;

  border-radius: 20px;

  font-size: 11px;
  font-weight: 800;
}

/* ================================
   PDF ITEM
================================ */

.ebook-file-item {
  display: flex;
  align-items: center;
  gap: 16px;

  padding: 18px 22px;

  border-bottom: 1px solid #f1f5f9;

  transition: background 0.2s ease;
}

.ebook-file-item:last-child {
  border-bottom: 0;
}

.ebook-file-item:hover {
  background: #f8fafc;
}

.ebook-file-position {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  color: #475569;
  background: #f1f5f9;

  border-radius: 10px;

  font-size: 12px;
  font-weight: 800;
}

.ebook-file-pdf-icon {
  width: 46px;
  height: 46px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  color: #dc2626;
  background: #fef2f2;

  border: 1px solid #fecaca;
  border-radius: 11px;
}

.ebook-file-pdf-icon i {
  font-size: 23px;
}

.ebook-file-info {
  min-width: 0;
  flex: 1;
}

.ebook-file-info h3 {
  overflow: hidden;

  margin: 0;

  color: #1e293b;

  font-size: 14px;
  font-weight: 750;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.ebook-file-info p {
  overflow: hidden;

  margin: 4px 0 0;

  color: #64748b;

  font-size: 11px;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.ebook-file-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;

  margin-top: 7px;
}

.ebook-file-meta span {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  color: #64748b;

  font-size: 10px;
  font-weight: 600;
}

.ebook-file-meta .active {
  color: #166534;
}

.ebook-file-meta .inactive {
  color: #92400e;
}

/* ================================
   ACTIONS
================================ */

.ebook-file-item-actions {
  display: flex;
  align-items: center;
  gap: 7px;

  flex-shrink: 0;
}

.ebook-file-action {
  width: 38px;
  height: 38px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  text-decoration: none;

  transition: all 0.2s ease;
}

.ebook-file-action.edit {
  color: #2563eb;
  background: #eff6ff;
}

.ebook-file-action.edit:hover {
  color: #ffffff;
  background: #2563eb;
}

.ebook-file-action.delete {
  color: #dc2626;
  background: #fef2f2;

  border: 0;

  cursor: pointer;
}

.ebook-file-action.delete:hover {
  color: #ffffff;
  background: #dc2626;
}

/* ================================
   EMPTY
================================ */

.ebook-files-empty {
  padding: 65px 25px;

  text-align: center;
}

.ebook-files-empty-icon {
  width: 64px;
  height: 64px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin: 0 auto 15px;

  color: #64748b;
  background: #f1f5f9;

  border-radius: 16px;
}

.ebook-files-empty-icon i {
  font-size: 27px;
}

.ebook-files-empty h3 {
  margin: 0;

  color: #334155;

  font-size: 17px;
}

.ebook-files-empty p {
  margin: 7px 0 20px;

  color: #64748b;

  font-size: 13px;
}

/* ================================
   MOBILE
================================ */

@media (max-width: 768px) {

  .admin-ebook-files-page {
    padding: 20px 14px 40px;
  }

  .ebook-files-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .ebook-files-actions {
    width: 100%;
  }

  .ebook-files-btn {
    flex: 1;
  }

  .ebook-file-item {
    align-items: flex-start;
    padding: 15px;
  }

  .ebook-file-position {
    width: 32px;
    height: 32px;
  }

  .ebook-file-pdf-icon {
    width: 40px;
    height: 40px;
  }

  .ebook-file-item-actions {
    flex-direction: column;
  }
}

@media (max-width: 480px) {

  .admin-ebook-files-page {
    padding: 14px 10px 30px;
  }

  .ebook-files-header h1 {
    font-size: 22px;
  }

  .ebook-files-context {
    padding: 13px;
  }

  .ebook-file-item {
    gap: 9px;
  }

  .ebook-file-info h3 {
    font-size: 12px;
  }

  .ebook-file-info p {
    font-size: 10px;
  }

  .ebook-file-meta {
    gap: 6px;
  }
}

</style>

<div class="admin-ebook-files-page">

  <div class="admin-ebook-files-wrapper">

    <!-- HEADER -->

    <div class="ebook-files-header">

      <div class="ebook-files-header-left">

        <span class="ebook-files-kicker">
          BOOK KHAJANA
        </span>

        <h1>
          Manage PDFs
        </h1>

        <p>
          Manage all PDF files included in this E-Book.
        </p>

      </div>

      <div class="ebook-files-actions">

        <%= link_to admin_ebook_path(@ebook),
                    class: "ebook-files-btn secondary" do %>

          <i class="bi bi-arrow-left"></i>
          E-Book

        <% end %>

        <%= link_to new_admin_ebook_ebook_file_path(@ebook),
                    class: "ebook-files-btn primary" do %>

          <i class="bi bi-plus-lg"></i>
          Add PDF

        <% end %>

      </div>

    </div>


    <!-- E-BOOK CONTEXT -->

    <div class="ebook-files-context">

      <div class="ebook-files-context-icon">
        <i class="bi bi-book"></i>
      </div>

      <div class="ebook-files-context-content">

        <span class="ebook-files-context-label">
          E-BOOK
        </span>

        <strong>
          <%= @ebook.title %>
        </strong>

      </div>

    </div>


    <!-- PDF LIST -->

    <div class="ebook-files-card">

      <div class="ebook-files-card-header">

        <h2>
          PDF Files
        </h2>

        <span class="ebook-files-count">
          <%= @ebook_files.count %>
          Files
        </span>

      </div>


      <% if @ebook_files.any? %>

        <% @ebook_files.each do |ebook_file| %>

          <div class="ebook-file-item">

            <div class="ebook-file-position">
              #<%= ebook_file.position %>
            </div>


            <div class="ebook-file-pdf-icon">
              <i class="bi bi-file-earmark-pdf-fill"></i>
            </div>


            <div class="ebook-file-info">

              <h3>
                <%= ebook_file.title %>
              </h3>

              <% if ebook_file.description.present? %>

                <p>
                  <%= ebook_file.description %>
                </p>

              <% else %>

                <p>
                  No description added.
                </p>

              <% end %>


              <div class="ebook-file-meta">

                <% if ebook_file.pdf.attached? %>

                  <span>
                    <i class="bi bi-filetype-pdf"></i>
                    PDF
                  </span>

                  <span>
                    <i class="bi bi-hdd"></i>
                    <%= number_to_human_size(
                          ebook_file.pdf.blob.byte_size
                        ) %>
                  </span>

                <% else %>

                  <span>
                    <i class="bi bi-exclamation-circle"></i>
                    No PDF
                  </span>

                <% end %>


                <% if ebook_file.status == "active" %>

                  <span class="active">
                    <i class="bi bi-check-circle-fill"></i>
                    Active
                  </span>

                <% else %>

                  <span class="inactive">
                    <i class="bi bi-pause-circle-fill"></i>
                    Inactive
                  </span>

                <% end %>

              </div>

            </div>


            <div class="ebook-file-item-actions">

              <%= link_to edit_admin_ebook_ebook_file_path(
                            @ebook,
                            ebook_file
                          ),
                          class: "ebook-file-action edit",
                          title: "Edit PDF" do %>

                <i class="bi bi-pencil"></i>

              <% end %>


              <%= button_to admin_ebook_ebook_file_path(
                              @ebook,
                              ebook_file
                            ),
                            method: :delete,
                            class: "ebook-file-action delete",
                            title: "Delete PDF",
                            form: {
                              data: {
                                turbo_confirm:
                                  "Delete this PDF?"
                              }
                            } do %>

                <i class="bi bi-trash3"></i>

              <% end %>

            </div>

          </div>

        <% end %>

      <% else %>

        <div class="ebook-files-empty">

          <div class="ebook-files-empty-icon">
            <i class="bi bi-file-earmark-pdf"></i>
          </div>

          <h3>
            No PDF files yet
          </h3>

          <p>
            Add your first PDF to this E-Book.
          </p>

          <%= link_to new_admin_ebook_ebook_file_path(@ebook),
                      class: "ebook-files-btn primary" do %>

            <i class="bi bi-plus-lg"></i>
            Add First PDF

          <% end %>

        </div>

      <% end %>

    </div>

  </div>

</div>