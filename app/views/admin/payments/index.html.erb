<% content_for :title, "Payment Management" %>

<style nonce="<%= content_security_policy_nonce %>">
:root {
  --payment-primary: #8009e2;
  --payment-primary-dark: #6507b5;
  --payment-primary-soft: rgba(128, 9, 226, 0.10);
  --payment-success: #16a34a;
  --payment-warning: #f59e0b;
  --payment-danger: #dc2626;
  --payment-info: #2563eb;
  --payment-text: #172033;
  --payment-muted: #64748b;
  --payment-border: #e5e7eb;
  --payment-bg: #f6f7fb;
  --payment-card: #ffffff;
  --payment-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
}

.admin-payment-page {
  min-height: 100vh;
  padding: 28px;
  background: var(--payment-bg);
  color: var(--payment-text);
}

.payment-page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 26px;
}

.payment-page-header-left {
  min-width: 0;
}

.payment-page-title {
  margin: 0;
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -0.5px;
}

.payment-page-subtitle {
  margin: 7px 0 0;
  color: var(--payment-muted);
  font-size: 14px;
}

.payment-theme-toggle {
  width: 44px;
  height: 44px;
  border: 1px solid var(--payment-border);
  border-radius: 13px;
  background: var(--payment-card);
  color: var(--payment-text);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: 0.2s ease;
  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
}

.payment-theme-toggle:hover {
  transform: translateY(-1px);
  border-color: var(--payment-primary);
  color: var(--payment-primary);
}

.payment-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 24px;
}

.payment-stat-card {
  background: var(--payment-card);
  border: 1px solid var(--payment-border);
  border-radius: 18px;
  padding: 20px;
  box-shadow: var(--payment-shadow);
  display: flex;
  align-items: center;
  gap: 15px;
}

.payment-stat-icon {
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--payment-primary-soft);
  color: var(--payment-primary);
  font-size: 20px;
}

.payment-stat-card.success .payment-stat-icon {
  background: rgba(22, 163, 74, 0.10);
  color: var(--payment-success);
}

.payment-stat-card.warning .payment-stat-icon {
  background: rgba(245, 158, 11, 0.12);
  color: var(--payment-warning);
}

.payment-stat-card.danger .payment-stat-icon {
  background: rgba(220, 38, 38, 0.10);
  color: var(--payment-danger);
}

.payment-stat-content {
  min-width: 0;
}

.payment-stat-label {
  color: var(--payment-muted);
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 5px;
}

.payment-stat-value {
  font-size: 23px;
  font-weight: 800;
  line-height: 1.1;
}

.payment-filter-card {
  background: var(--payment-card);
  border: 1px solid var(--payment-border);
  border-radius: 18px;
  padding: 20px;
  box-shadow: var(--payment-shadow);
  margin-bottom: 18px;
}

.payment-filter-form {
  display: grid;
  grid-template-columns: minmax(220px, 1.6fr) minmax(150px, 1fr) minmax(180px, 1fr) auto auto;
  gap: 12px;
  align-items: end;
}

.payment-filter-group {
  min-width: 0;
}

.payment-filter-label {
  display: block;
  margin-bottom: 7px;
  color: var(--payment-text);
  font-size: 12px;
  font-weight: 700;
}

.payment-filter-input,
.payment-filter-select {
  width: 100%;
  height: 44px;
  padding: 0 13px;
  border: 1px solid var(--payment-border);
  border-radius: 11px;
  background: var(--payment-card);
  color: var(--payment-text);
  outline: none;
  transition: 0.2s ease;
}

.payment-filter-input:focus,
.payment-filter-select:focus {
  border-color: var(--payment-primary);
  box-shadow: 0 0 0 3px rgba(128, 9, 226, 0.10);
}

.payment-filter-btn,
.payment-reset-btn {
  height: 44px;
  border-radius: 11px;
  padding: 0 17px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
  transition: 0.2s ease;
}

.payment-filter-btn {
  border: 1px solid var(--payment-primary);
  background: var(--payment-primary);
  color: #fff;
}

.payment-filter-btn:hover {
  background: var(--payment-primary-dark);
  border-color: var(--payment-primary-dark);
}

.payment-reset-btn {
  border: 1px solid var(--payment-border);
  background: var(--payment-card);
  color: var(--payment-text);
}

.payment-reset-btn:hover {
  border-color: var(--payment-primary);
  color: var(--payment-primary);
}

.payment-filter-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
  padding: 13px 16px;
  border-radius: 13px;
  background: var(--payment-primary-soft);
  color: var(--payment-text);
  font-size: 13px;
}

.payment-filter-info strong {
  color: var(--payment-primary);
}

.payment-table-card {
  background: var(--payment-card);
  border: 1px solid var(--payment-border);
  border-radius: 18px;
  box-shadow: var(--payment-shadow);
  overflow: hidden;
}

.payment-table-header {
  padding: 19px 20px;
  border-bottom: 1px solid var(--payment-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.payment-table-title {
  margin: 0;
  font-size: 17px;
  font-weight: 800;
}

.payment-table-count {
  color: var(--payment-muted);
  font-size: 13px;
}

.bulk-payment-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 20px;
  background: rgba(128, 9, 226, 0.045);
  border-bottom: 1px solid var(--payment-border);
}

.bulk-payment-left {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.bulk-select-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 700;
  color: var(--payment-text);
  cursor: pointer;
}

.bulk-selected-count {
  color: var(--payment-muted);
  font-size: 13px;
  font-weight: 700;
}

.bulk-payment-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.bulk-payment-btn {
  min-height: 38px;
  border: 0;
  border-radius: 10px;
  padding: 0 13px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s ease;
}

.bulk-payment-btn:hover:not(:disabled) {
  transform: translateY(-1px);
}

.bulk-payment-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  transform: none;
}

.bulk-email-btn {
  background: #2563eb;
}

.bulk-whatsapp-btn {
  background: #16a34a;
}

.bulk-both-btn {
  background: var(--payment-primary);
}

.payment-select-column {
  width: 48px;
  min-width: 48px;
  text-align: center !important;
}

.payment-checkbox {
  width: 16px;
  height: 16px;
  margin: 0;
  accent-color: var(--payment-primary);
  cursor: pointer;
  vertical-align: middle;
}

.payment-locked {
  width: 27px;
  height: 27px;
  margin: 0 auto;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(22, 163, 74, 0.10);
  color: var(--payment-success);
  font-size: 13px;
}

.payment-select-hint {
  color: var(--payment-muted);
  font-size: 12px;
}

.payment-table-wrapper {
  width: 100%;
  overflow-x: auto;
}

.payment-management-table {
  width: 100%;
  min-width: 1150px;
  border-collapse: collapse;
}

.payment-management-table th {
  padding: 13px 15px;
  background: rgba(100, 116, 139, 0.045);
  color: var(--payment-muted);
  border-bottom: 1px solid var(--payment-border);
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  text-align: left;
  white-space: nowrap;
}

.payment-management-table td {
  padding: 15px;
  border-bottom: 1px solid var(--payment-border);
  color: var(--payment-text);
  font-size: 13px;
  vertical-align: middle;
}

.payment-management-table tbody tr {
  transition: 0.18s ease;
}

.payment-management-table tbody tr:hover {
  background: rgba(128, 9, 226, 0.025);
}

.payment-management-table tbody tr:last-child td {
  border-bottom: 0;
}

.payment-student {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 170px;
}

.payment-student-avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  overflow: hidden;
  flex: 0 0 38px;
  background: var(--payment-primary-soft);
  color: var(--payment-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.payment-student-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.payment-student-info {
  min-width: 0;
}

.payment-student-name {
  font-weight: 750;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 190px;
}

.payment-student-email {
  margin-top: 3px;
  color: var(--payment-muted);
  font-size: 11px;
  max-width: 190px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.payment-course-info {
  max-width: 210px;
}

.payment-course-name {
  font-weight: 700;
  line-height: 1.4;
}

.payment-id {
  font-weight: 700;
  color: var(--payment-primary);
}

.payment-order-id,
.payment-razorpay-id {
  color: var(--payment-muted);
  font-size: 11px;
  max-width: 150px;
  word-break: break-word;
}

.payment-amount {
  font-weight: 800;
  white-space: nowrap;
}

.payment-status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 75px;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
  text-transform: capitalize;
}

.payment-status-badge.paid {
  background: rgba(22, 163, 74, 0.11);
  color: var(--payment-success);
}

.payment-status-badge.created,
.payment-status-badge.pending {
  background: rgba(245, 158, 11, 0.12);
  color: #b45309;
}

.payment-status-badge.failed,
.payment-status-badge.cancelled {
  background: rgba(220, 38, 38, 0.10);
  color: var(--payment-danger);
}

.payment-date {
  color: var(--payment-muted);
  white-space: nowrap;
  font-size: 12px;
}

.payment-action-buttons {
  display: flex;
  align-items: center;
  gap: 7px;
  flex-wrap: wrap;
  min-width: 190px;
}

.payment-view-btn,
.payment-email-btn,
.payment-reminder-btn {
  min-height: 34px;
  padding: 0 10px;
  border-radius: 9px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  text-decoration: none;
  font-size: 11px;
  font-weight: 750;
  border: 1px solid transparent;
  transition: 0.2s ease;
}

.payment-view-btn {
  background: var(--payment-primary-soft);
  color: var(--payment-primary);
  border-color: rgba(128, 9, 226, 0.15);
}

.payment-view-btn:hover {
  background: var(--payment-primary);
  color: #fff;
}

.payment-email-btn {
  background: rgba(37, 99, 235, 0.10);
  color: var(--payment-info);
  border-color: rgba(37, 99, 235, 0.15);
}

.payment-email-btn:hover {
  background: var(--payment-info);
  color: #fff;
}

.payment-reminder-btn {
  background: rgba(22, 163, 74, 0.10);
  color: var(--payment-success);
  border-color: rgba(22, 163, 74, 0.15);
}

.payment-reminder-btn:hover {
  background: var(--payment-success);
  color: #fff;
}

.payment-empty-state {
  padding: 65px 25px;
  text-align: center;
}

.payment-empty-icon {
  width: 62px;
  height: 62px;
  margin: 0 auto 15px;
  border-radius: 18px;
  background: var(--payment-primary-soft);
  color: var(--payment-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25px;
}

.payment-empty-title {
  margin: 0 0 7px;
  font-size: 18px;
  font-weight: 800;
}

.payment-empty-text {
  margin: 0;
  color: var(--payment-muted);
  font-size: 13px;
}

.payment-table-footer {
  padding: 15px 20px;
  border-top: 1px solid var(--payment-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.payment-footer-text {
  color: var(--payment-muted);
  font-size: 12px;
}

.payment-pagination {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.payment-pagination a,
.payment-pagination span {
  min-width: 34px;
  height: 34px;
  padding: 0 9px;
  border: 1px solid var(--payment-border);
  border-radius: 8px;
  background: var(--payment-card);
  color: var(--payment-text);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  font-size: 12px;
  font-weight: 700;
}

.payment-pagination a:hover {
  border-color: var(--payment-primary);
  color: var(--payment-primary);
}

.payment-pagination .current {
  background: var(--payment-primary);
  border-color: var(--payment-primary);
  color: #fff;
}

body.payment-page-dark .admin-payment-page {
  --payment-text: #e5e7eb;
  --payment-muted: #94a3b8;
  --payment-border: rgba(148, 163, 184, 0.15);
  --payment-bg: #0b1120;
  --payment-card: #111827;
  --payment-shadow: 0 12px 35px rgba(0, 0, 0, 0.22);
}

body.payment-page-dark .payment-management-table th {
  background: rgba(255, 255, 255, 0.025);
}

body.payment-page-dark .payment-management-table tbody tr:hover {
  background: rgba(128, 9, 226, 0.06);
}

body.payment-page-dark .bulk-payment-toolbar {
  background: rgba(128, 9, 226, 0.08);
}

body.payment-page-dark .payment-filter-input,
body.payment-page-dark .payment-filter-select {
  background: #0f172a;
}

body.payment-page-dark .payment-status-badge.created,
body.payment-page-dark .payment-status-badge.pending {
  color: #fbbf24;
}

@media (max-width: 1100px) {
  .payment-stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .payment-filter-form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .payment-filter-form .payment-filter-actions {
    display: flex;
    gap: 10px;
  }
}

@media (max-width: 700px) {
  .admin-payment-page {
    padding: 18px 13px;
  }

  .payment-page-header {
    align-items: flex-start;
  }

  .payment-page-title {
    font-size: 23px;
  }

  .payment-stats-grid {
    grid-template-columns: 1fr;
  }

  .payment-filter-form {
    grid-template-columns: 1fr;
  }

  .payment-filter-form .payment-filter-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .bulk-payment-toolbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .bulk-payment-actions {
    width: 100%;
  }

  .bulk-payment-btn {
    flex: 1;
  }

  .payment-table-footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 420px) {
  .payment-page-header {
    gap: 10px;
  }

  .payment-theme-toggle {
    width: 40px;
    height: 40px;
  }

  .payment-stat-card {
    padding: 16px;
  }

  .payment-filter-card {
    padding: 15px;
  }

  .payment-table-header {
    padding: 15px;
  }

  .bulk-payment-toolbar {
    padding: 13px 15px;
  }

  .bulk-payment-actions {
    display: grid;
    grid-template-columns: 1fr;
  }

  .bulk-payment-btn {
    width: 100%;
  }
}
</style>

<div class="admin-payment-page">

  <div class="payment-page-header">
    <div class="payment-page-header-left">
      <h1 class="payment-page-title">Payment Management</h1>
      <p class="payment-page-subtitle">
        Manage student payments, confirmations and payment reminders.
      </p>
    </div>

    <button type="button"
            class="payment-theme-toggle"
            id="paymentThemeToggle"
            aria-label="Toggle theme">
      <i class="bi bi-moon-stars-fill" id="paymentThemeIcon"></i>
    </button>
  </div>

  <div class="payment-stats-grid">

    <div class="payment-stat-card">
      <div class="payment-stat-icon">
        <i class="bi bi-credit-card"></i>
      </div>
      <div class="payment-stat-content">
        <div class="payment-stat-label">Total Payments</div>
        <div class="payment-stat-value">
          <%= @total_payments || 0 %>
        </div>
      </div>
    </div>

    <div class="payment-stat-card success">
      <div class="payment-stat-icon">
        <i class="bi bi-check-circle"></i>
      </div>
      <div class="payment-stat-content">
        <div class="payment-stat-label">Successful</div>
        <div class="payment-stat-value">
          <%= @successful_payments || 0 %>
        </div>
      </div>
    </div>

    <div class="payment-stat-card warning">
      <div class="payment-stat-icon">
        <i class="bi bi-hourglass-split"></i>
      </div>
      <div class="payment-stat-content">
        <div class="payment-stat-label">Pending</div>
        <div class="payment-stat-value">
          <%= @pending_payments || 0 %>
        </div>
      </div>
    </div>

    <div class="payment-stat-card">
      <div class="payment-stat-icon">
        <i class="bi bi-currency-rupee"></i>
      </div>
      <div class="payment-stat-content">
        <div class="payment-stat-label">Total Revenue</div>
        <div class="payment-stat-value">
          ₹<%= number_with_precision(@total_revenue || 0, precision: 2, delimiter: ",") %>
        </div>
      </div>
    </div>

  </div>

  <div class="payment-filter-card">
    <%= form_with url: admin_payments_path,
                  method: :get,
                  local: true,
                  class: "payment-filter-form" do %>

      <div class="payment-filter-group">
        <label class="payment-filter-label">Search</label>
        <%= text_field_tag :search,
                           params[:search],
                           class: "payment-filter-input",
                           placeholder: "Student, email, payment ID..." %>
      </div>

      <div class="payment-filter-group">
        <label class="payment-filter-label">Status</label>
        <%= select_tag :status,
                       options_for_select(
                         [
                           ["All Status", ""],
                           ["Paid", "paid"],
                           ["Created", "created"],
                           ["Pending", "pending"],
                           ["Failed", "failed"],
                           ["Cancelled", "cancelled"]
                         ],
                         params[:status]
                       ),
                       class: "payment-filter-select" %>
      </div>

      <div class="payment-filter-group">
        <label class="payment-filter-label">Course</label>
        <%= select_tag :course_id,
                       options_for_select(
                         [["All Courses", ""]] +
                         Array(@courses).map { |course| [course.Course_name, course.id] },
                         params[:course_id]
                       ),
                       class: "payment-filter-select" %>
      </div>

      <div class="payment-filter-actions">
        <%= submit_tag "Filter",
                       class: "payment-filter-btn" %>

        <%= link_to admin_payments_path,
                    class: "payment-reset-btn" do %>
          <i class="bi bi-arrow-counterclockwise"></i>
          Reset
        <% end %>
      </div>

    <% end %>
  </div>

  <div class="payment-filter-info">
    <div>
      Showing
      <strong><%= @payments.respond_to?(:total_count) ? @payments.total_count : @payments.size %></strong>
      payment(s)
    </div>

    <% if params[:status].present? || params[:search].present? || params[:course_id].present? %>
      <div>
        Active filters applied
      </div>
    <% end %>
  </div>

  <div class="payment-table-card">

    <div class="payment-table-header">
      <div>
        <h2 class="payment-table-title">Payment Records</h2>
        <div class="payment-table-count">
          <%= @payments.size %> record(s) on this page
        </div>
      </div>
    </div>

    <% selectable_payments = @payments.select { |payment| !payment.paid? } %>

    <% if selectable_payments.present? %>
      <div class="bulk-payment-toolbar">

        <div class="bulk-payment-left">
          <label class="bulk-select-label">
            <input type="checkbox"
                   id="selectAllPayments"
                   class="payment-checkbox">
            <span>Select All</span>
          </label>

          <span class="bulk-selected-count"
                id="bulkSelectedCount">
            0 selected
          </span>
        </div>

        <div class="bulk-payment-actions">

          <button type="button"
                  class="bulk-payment-btn bulk-email-btn"
                  id="bulkEmailButton"
                  disabled>
            <i class="bi bi-envelope"></i>
            Send Email
          </button>

          <button type="button"
                  class="bulk-payment-btn bulk-whatsapp-btn"
                  id="bulkWhatsappButton"
                  disabled>
            <i class="bi bi-whatsapp"></i>
            Send WhatsApp
          </button>

          <button type="button"
                  class="bulk-payment-btn bulk-both-btn"
                  id="bulkBothButton"
                  disabled>
            <i class="bi bi-send"></i>
            Send Both
          </button>

        </div>

      </div>
    <% end %>

    <form id="bulkReminderForm"
          action="<%= bulk_send_reminders_admin_payments_path %>"
          method="post"
          style="display:none;">

      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

      <input type="hidden"
             name="channel"
             id="bulkChannel">

      <div id="bulkPaymentIds"></div>

    </form>

    <% if @payments.present? %>

      <div class="payment-table-wrapper">

        <table class="payment-management-table">

          <thead>
            <tr>
              <th class="payment-select-column">
                <span class="visually-hidden">Select</span>
              </th>
              <th>Student</th>
              <th>Course</th>
              <th>Payment ID</th>
              <th>Order ID</th>
              <th>Razorpay ID</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Date & Time</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>

            <% @payments.each do |payment| %>

              <% enrollment = payment.enrollment %>
              <% student = enrollment&.user %>
              <% course = enrollment&.course %>

              <tr>

                <td class="payment-select-column">

                  <% if payment.paid? %>

                    <span class="payment-locked"
                          title="Paid payments cannot receive payment reminders">
                      <i class="bi bi-check"></i>
                    </span>

                  <% else %>

                    <input type="checkbox"
                           class="payment-checkbox payment-row-checkbox"
                           value="<%= payment.id %>"
                           data-payment-id="<%= payment.id %>"
                           data-student-name="<%= student&.name.to_s %>">

                  <% end %>

                </td>

                <td>

                  <div class="payment-student">

                    <div class="payment-student-avatar">

                      <% if student&.image&.attached? %>

                        <%= image_tag student.image,
                                      alt: student.name.to_s %>

                      <% else %>

                        <%= student&.name.to_s.first&.upcase || "S" %>

                      <% end %>

                    </div>

                    <div class="payment-student-info">

                      <div class="payment-student-name">
                        <%= student&.name.presence || "Unknown Student" %>
                      </div>

                      <% if student&.email.present? %>
                        <div class="payment-student-email">
                          <%= student.email %>
                        </div>
                      <% end %>

                    </div>

                  </div>

                </td>

                <td>

                  <div class="payment-course-info">
                    <div class="payment-course-name">
                      <%= course&.Course_name.presence || "Unknown Course" %>
                    </div>
                  </div>

                </td>

                <td>
                  <span class="payment-id">
                    #<%= payment.id %>
                  </span>
                </td>

                <td>
                  <div class="payment-order-id">
                    <%= payment.respond_to?(:razorpay_order_id) ? payment.razorpay_order_id.presence || "—" : "—" %>
                  </div>
                </td>

                <td>
                  <div class="payment-razorpay-id">
                    <%= payment.respond_to?(:razorpay_payment_id) ? payment.razorpay_payment_id.presence || "—" : "—" %>
                  </div>
                </td>

                <td>
                  <span class="payment-amount">
                    ₹<%= number_with_precision(payment.amount || 0, precision: 2) %>
                  </span>
                </td>

                <td>

                  <span class="payment-status-badge <%= payment.status.to_s.downcase %>">
                    <%= payment.status.to_s.humanize %>
                  </span>

                </td>

                <td>

                  <div class="payment-date">
                    <%= payment.created_at.strftime("%d %b %Y") %>
                    <br>
                    <%= payment.created_at.strftime("%I:%M %p") %>
                  </div>

                </td>

                <td>

                  <div class="payment-action-buttons">

                    <%= link_to admin_payment_path(payment),
                                class: "payment-view-btn" do %>
                      <i class="bi bi-eye"></i>
                      View
                    <% end %>

                    <% if payment.paid? %>

                      <% if student&.email.present? %>

                        <%= button_to send_email_admin_payment_path(payment),
                                      method: :post,
                                      class: "payment-email-btn",
                                      form: {
                                        data: {
                                          turbo_confirm: "Send payment confirmation email to #{student.email}?"
                                        }
                                      } do %>
                          <i class="bi bi-envelope"></i>
                          Confirmation
                        <% end %>

                      <% end %>

                    <% else %>

                      <% if student&.email.present? || student&.mobile.present? || student&.phone.present? %>

                        <%= button_to send_reminder_admin_payment_path(payment),
                                      method: :post,
                                      class: "payment-reminder-btn",
                                      form: {
                                        data: {
                                          turbo_confirm: "Send payment reminder by Email and WhatsApp?"
                                        }
                                      } do %>
                          <i class="bi bi-send"></i>
                          Reminder
                        <% end %>

                      <% end %>

                    <% end %>

                  </div>

                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

      </div>

    <% else %>

      <div class="payment-empty-state">

        <div class="payment-empty-icon">
          <i class="bi bi-credit-card-2-front"></i>
        </div>

        <h3 class="payment-empty-title">
          No payments found
        </h3>

        <p class="payment-empty-text">
          No payment records match your current filters.
        </p>

      </div>

    <% end %>

    <% if @payments.present? %>

      <div class="payment-table-footer">

        <div class="payment-footer-text">
          Page <%= @payments.respond_to?(:current_page) ? @payments.current_page : 1 %>
        </div>

        <div class="payment-pagination">

          <% if @payments.respond_to?(:total_pages) && @payments.total_pages > 1 %>

            <% current_page = @payments.current_page %>

            <% if current_page > 1 %>
              <%= link_to "‹",
                          admin_payments_path(
                            request.query_parameters.merge(page: current_page - 1)
                          ) %>
            <% end %>

            <% first_page = [current_page - 2, 1].max %>
            <% last_page = [first_page + 4, @payments.total_pages].min %>

            <% (first_page..last_page).each do |page| %>

              <% if page == current_page %>

                <span class="current">
                  <%= page %>
                </span>

              <% else %>

                <%= link_to page,
                            admin_payments_path(
                              request.query_parameters.merge(page: page)
                            ) %>

              <% end %>

            <% end %>

            <% if current_page < @payments.total_pages %>
              <%= link_to "›",
                          admin_payments_path(
                            request.query_parameters.merge(page: current_page + 1)
                          ) %>
            <% end %>

          <% end %>

        </div>

      </div>

    <% end %>

  </div>

</div>

<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener("DOMContentLoaded", function () {
  const body = document.body;
  const toggle = document.getElementById("paymentThemeToggle");
  const icon = document.getElementById("paymentThemeIcon");
  const storageKey = "aone-payment-theme";

  function applyTheme(theme) {
    if (theme === "dark") {
      body.classList.add("payment-page-dark");
      if (icon) {
        icon.className = "bi bi-sun-fill";
      }
    } else {
      body.classList.remove("payment-page-dark");
      if (icon) {
        icon.className = "bi bi-moon-stars-fill";
      }
    }
  }

  const savedTheme = localStorage.getItem(storageKey) || "light";
  applyTheme(savedTheme);

  if (toggle) {
    toggle.addEventListener("click", function () {
      const nextTheme = body.classList.contains("payment-page-dark")
        ? "light"
        : "dark";

      localStorage.setItem(storageKey, nextTheme);
      applyTheme(nextTheme);
    });
  }
});
</script>

<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener("DOMContentLoaded", function () {
  const selectAll = document.getElementById("selectAllPayments");
  const rowCheckboxes = Array.from(
    document.querySelectorAll(".payment-row-checkbox")
  );

  const selectedCount = document.getElementById("bulkSelectedCount");
  const emailButton = document.getElementById("bulkEmailButton");
  const whatsappButton = document.getElementById("bulkWhatsappButton");
  const bothButton = document.getElementById("bulkBothButton");

  const form = document.getElementById("bulkReminderForm");
  const channelInput = document.getElementById("bulkChannel");
  const paymentIdsContainer = document.getElementById("bulkPaymentIds");

  if (
    !selectAll ||
    !selectedCount ||
    !emailButton ||
    !whatsappButton ||
    !bothButton ||
    !form ||
    !channelInput ||
    !paymentIdsContainer
  ) {
    return;
  }

  function getSelectedPayments() {
    return rowCheckboxes.filter(function (checkbox) {
      return checkbox.checked;
    });
  }

  function updateBulkUI() {
    const selected = getSelectedPayments();
    const count = selected.length;

    selectedCount.textContent = `${count} selected`;

    emailButton.disabled = count === 0;
    whatsappButton.disabled = count === 0;
    bothButton.disabled = count === 0;

    if (rowCheckboxes.length === 0) {
      selectAll.checked = false;
      selectAll.indeterminate = false;
      return;
    }

    selectAll.checked = count === rowCheckboxes.length;
    selectAll.indeterminate =
      count > 0 && count < rowCheckboxes.length;
  }

  selectAll.addEventListener("change", function () {
    rowCheckboxes.forEach(function (checkbox) {
      checkbox.checked = selectAll.checked;
    });

    updateBulkUI();
  });

  rowCheckboxes.forEach(function (checkbox) {
    checkbox.addEventListener("change", updateBulkUI);
  });

  function sendBulkReminder(channel) {
    const selected = getSelectedPayments();

    if (selected.length === 0) {
      window.alert("Please select at least one unpaid payment.");
      return;
    }

    let channelName;

    if (channel === "email") {
      channelName = "Email";
    } else if (channel === "whatsapp") {
      channelName = "WhatsApp";
    } else {
      channelName = "Email and WhatsApp";
    }

    const confirmed = window.confirm(
      `Send payment reminder by ${channelName} to ${selected.length} selected student(s)?`
    );

    if (!confirmed) {
      return;
    }

    paymentIdsContainer.innerHTML = "";

    selected.forEach(function (checkbox) {
      const input = document.createElement("input");

      input.type = "hidden";
      input.name = "payment_ids[]";
      input.value = checkbox.dataset.paymentId;

      paymentIdsContainer.appendChild(input);
    });

    channelInput.value = channel;

    emailButton.disabled = true;
    whatsappButton.disabled = true;
    bothButton.disabled = true;

    form.submit();
  }

  emailButton.addEventListener("click", function () {
    sendBulkReminder("email");
  });

  whatsappButton.addEventListener("click", function () {
    sendBulkReminder("whatsapp");
  });

  bothButton.addEventListener("click", function () {
    sendBulkReminder("both");
  });

  updateBulkUI();
});
</script>