<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   ADMIN PAYMENT PAGE
========================================================= */

.admin-payment-page {
    min-height: 100vh;
    padding: 25px 5px 60px;

    background:
        radial-gradient(
            circle at 85% 8%,
            rgba(128, 9, 226, 0.08),
            transparent 25%
        ),
        radial-gradient(
            circle at 5% 70%,
            rgba(99, 102, 241, 0.06),
            transparent 25%
        ),
        linear-gradient(
            135deg,
            #ffffff,
            #f8f7fc,
            #ffffff
        );
}


/* =========================================================
   HEADER
========================================================= */

.payment-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
}

.payment-header-left {
    padding-left: 5px;
}

.payment-kicker {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 6px 12px;

    border-radius: 999px;

    background: rgba(128, 9, 226, 0.08);
    border: 1px solid rgba(128, 9, 226, 0.10);

    color: #8009e2;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.8px;
}

.payment-page-header h1 {
    margin: 9px 0 5px;

    color: #172554;

    font-size: 31px;
    font-weight: 850;
    letter-spacing: -0.7px;
}

.payment-page-header p {
    margin: 0;

    color: #64748b;

    font-size: 13px;
}

.payment-header-icon {
    width: 76px;
    height: 76px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 22px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f1eaff
        );

    border: 1px solid rgba(128, 9, 226, 0.12);

    color: #8009e2;

    font-size: 31px;

    box-shadow:
        0 8px 18px rgba(128, 9, 226, 0.08),
        0 22px 45px rgba(30, 20, 60, 0.08);
}


/* =========================================================
   STATISTICS
========================================================= */

.payment-stats-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 18px;

    margin-bottom: 22px;
}

.payment-stat-card {
    position: relative;

    min-height: 155px;

    padding: 20px;

    overflow: hidden;

    border-radius: 18px;

    background: rgba(255,255,255,0.88);

    border: 1px solid rgba(128,9,226,0.08);

    box-shadow:
        0 3px 8px rgba(30,20,60,0.03),
        0 12px 28px rgba(30,20,60,0.07),
        0 25px 55px rgba(30,20,60,0.05);

    transition:
        transform .25s ease,
        box-shadow .25s ease;
}

.payment-stat-card::after {
    content: "";

    position: absolute;

    width: 130px;
    height: 130px;

    right: -55px;
    bottom: -65px;

    border-radius: 50%;

    background: rgba(128,9,226,0.07);

    pointer-events: none;
}

.payment-stat-card:hover {
    transform: translateY(-4px);

    box-shadow:
        0 8px 15px rgba(30,20,60,0.05),
        0 20px 40px rgba(30,20,60,0.09);
}

.payment-stat-top {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 15px;
}

.payment-stat-icon {
    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 14px;

    font-size: 18px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #eee7ff
        );

    color: #8009e2;

    box-shadow:
        0 6px 15px rgba(128,9,226,.13),
        inset 0 1px 2px rgba(255,255,255,.8);
}

.success-card .payment-stat-icon {
    color: #059669;
    background: #eafff6;
}

.pending-card .payment-stat-icon {
    color: #d97706;
    background: #fff7e8;
}

.failed-card .payment-stat-icon {
    color: #dc2626;
    background: #fff0f3;
}

.payment-stat-live {
    display: inline-flex;
    align-items: center;
    gap: 5px;

    padding: 5px 9px;

    border-radius: 999px;

    background: #ecfdf5;

    color: #059669;

    font-size: 9px;
    font-weight: 800;
}

.payment-stat-live::before {
    content: "";

    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #10b981;
}

.payment-stat-label {
    display: block;

    margin-bottom: 5px;

    color: #172554;

    font-size: 12px;
    font-weight: 700;
}

.payment-stat-card h2 {
    margin: 0 0 4px;

    color: #111b4d;

    font-size: 25px;
    font-weight: 850;
}

.payment-stat-card small {
    color: #94a3b8;

    font-size: 10px;
}


/* =========================================================
   FILTER CARD
========================================================= */

.payment-filter-card {
    display: grid;

    grid-template-columns:
        2fr 1fr 1fr auto;

    align-items: end;

    gap: 14px;

    padding: 17px;

    margin-bottom: 22px;

    background: rgba(255,255,255,.88);

    border: 1px solid rgba(128,9,226,.08);

    border-radius: 17px;

    box-shadow:
        0 6px 18px rgba(30,20,60,.05),
        0 18px 40px rgba(30,20,60,.04);
}

.payment-search-box {
    position: relative;
}

.payment-search-box i {
    position: absolute;

    left: 14px;
    top: 50%;

    transform: translateY(-50%);

    color: #8009e2;

    font-size: 15px;

    pointer-events: none;
}

.payment-search-box input,
.payment-filter-select select {
    width: 100%;

    height: 43px;

    padding: 0 14px;

    border-radius: 10px;

    border: 1px solid #e2e5f0;

    background: #ffffff;

    color: #334155;

    font-size: 11px;

    outline: none;

    box-shadow:
        inset 0 1px 2px rgba(0,0,0,.02),
        0 3px 10px rgba(30,20,60,.03);
}

.payment-search-box input {
    padding-left: 40px;
}

.payment-search-box input::placeholder {
    color: #94a3b8;
}

.payment-search-box input:focus,
.payment-filter-select select:focus {
    border-color: rgba(128,9,226,.35);

    box-shadow:
        0 0 0 3px rgba(128,9,226,.07);
}

.payment-filter-select label {
    display: block;

    margin-bottom: 5px;

    color: #475569;

    font-size: 10px;
    font-weight: 700;
}

.payment-filter-btn {
    height: 43px;

    padding: 0 20px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    border: 0;

    border-radius: 10px;

    background:
        linear-gradient(
            135deg,
            #8009e2,
            #6512d8
        );

    color: #ffffff;

    font-size: 11px;
    font-weight: 750;

    text-decoration: none;

    box-shadow:
        0 7px 15px rgba(128,9,226,.22);

    cursor: pointer;

    transition: all .2s ease;
}

.payment-filter-btn:hover {
    transform: translateY(-2px);

    color: #ffffff;

    box-shadow:
        0 10px 22px rgba(128,9,226,.28);
}

.payment-reset-btn {
    height: 43px;

    padding: 0 15px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;

    border-radius: 10px;

    background: #ffffff;

    border: 1px solid #e2e5f0;

    color: #64748b;

    font-size: 10px;
    font-weight: 750;

    text-decoration: none;

    transition: all .2s ease;
}

.payment-reset-btn:hover {
    color: #8009e2;

    border-color: rgba(128,9,226,.25);

    background: #faf8ff;
}


/* =========================================================
   ACTIVE FILTER INFO
========================================================= */

.payment-filter-info {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 12px;

    margin: -10px 0 18px;

    padding: 0 4px;

    color: #94a3b8;

    font-size: 10px;
}

.payment-filter-info strong {
    color: #475569;
}

.payment-active-filter {
    display: inline-flex;

    align-items: center;

    gap: 5px;

    padding: 5px 9px;

    border-radius: 999px;

    background: #f1eaff;

    color: #6d28d9;

    font-size: 9px;
    font-weight: 750;
}


/* =========================================================
   TABLE CARD
========================================================= */

.payment-table-card {
    overflow: hidden;

    background: rgba(255,255,255,.94);

    border: 1px solid rgba(128,9,226,.08);

    border-radius: 19px;

    box-shadow:
        0 5px 12px rgba(30,20,60,.04),
        0 18px 42px rgba(30,20,60,.07);
}

.payment-table-header {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 15px;

    padding: 20px 21px 17px;
}

.payment-table-title {
    display: flex;

    align-items: center;

    gap: 12px;
}

.payment-table-title-icon {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 11px;

    background:
        linear-gradient(
            135deg,
            #8009e2,
            #6614d6
        );

    color: #ffffff;

    box-shadow:
        0 7px 15px rgba(128,9,226,.20);
}

.payment-table-title h3 {
    margin: 0 0 3px;

    color: #172554;

    font-size: 15px;
    font-weight: 800;
}

.payment-table-title p {
    margin: 0;

    color: #94a3b8;

    font-size: 10px;
}

.payment-count-badge {
    padding: 7px 12px;

    border-radius: 999px;

    background: #f1eaff;

    color: #6d28d9;

    font-size: 10px;
    font-weight: 750;

    white-space: nowrap;
}


/* =========================================================
   TABLE
========================================================= */

.payment-table-wrapper {
    width: 100%;

    overflow-x: auto;

    padding: 0 12px;

    scrollbar-width: thin;
    scrollbar-color: #d8c9f5 transparent;
}

.payment-management-table {
    width: 100%;

    min-width: 1100px;

    border-collapse: separate;

    border-spacing: 0;
}

.payment-management-table thead th {
    padding: 12px 10px;

    background: #f7f5ff;

    color: #64748b;

    border-top: 1px solid rgba(128,9,226,.05);
    border-bottom: 1px solid rgba(128,9,226,.07);

    font-size: 9px;
    font-weight: 800;

    white-space: nowrap;
}

.payment-management-table tbody td {
    padding: 13px 10px;

    border-bottom: 1px solid #f0eff5;

    vertical-align: middle;

    font-size: 10px;
}

.payment-management-table tbody tr {
    transition:
        background .18s ease;
}

.payment-management-table tbody tr:hover {
    background: #fbfaff;
}


/* =========================================================
   STUDENT
========================================================= */

.payment-student {
    display: flex;

    align-items: center;

    gap: 9px;

    min-width: 155px;
}

.payment-avatar {
    width: 34px;
    height: 34px;

    min-width: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 11px;

    background:
        linear-gradient(
            135deg,
            #8b5cf6,
            #6d28d9
        );

    color: white;

    font-size: 12px;
    font-weight: 800;

    box-shadow:
        0 4px 10px rgba(109,40,217,.20);
}

.payment-avatar img {
    width: 100%;
    height: 100%;

    object-fit: cover;
}

.payment-student-info strong {
    display: block;

    color: #1e293b;

    font-size: 10px;
    font-weight: 750;
}

.payment-student-info small {
    display: block;

    max-width: 125px;

    margin-top: 2px;

    overflow: hidden;

    color: #94a3b8;

    font-size: 8px;

    text-overflow: ellipsis;
    white-space: nowrap;
}


/* =========================================================
   COURSE
========================================================= */

.payment-course-info {
    max-width: 145px;
}

.payment-course-info strong {
    display: block;

    color: #334155;

    font-size: 10px;
    font-weight: 700;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}

.payment-course-info small {
    color: #94a3b8;

    font-size: 8px;
}


/* =========================================================
   IDS
========================================================= */

.payment-id {
    color: #172554;

    font-weight: 800;

    white-space: nowrap;
}

.payment-transaction-id {
    display: block;

    max-width: 125px;

    overflow: hidden;

    color: #64748b;

    font-family: monospace;

    font-size: 8px;

    text-overflow: ellipsis;

    white-space: nowrap;
}


/* =========================================================
   AMOUNT
========================================================= */

.payment-amount {
    color: #172554;

    font-size: 10px;

    white-space: nowrap;
}


/* =========================================================
   STATUS
========================================================= */

.payment-status-badge {
    display: inline-flex;

    align-items: center;

    gap: 4px;

    padding: 6px 9px;

    border-radius: 999px;

    font-size: 8px;
    font-weight: 800;

    white-space: nowrap;
}

.payment-status-badge.paid {
    background: #dff9ef;
    color: #059669;
}

.payment-status-badge.created {
    background: #fff1d9;
    color: #d97706;
}

.payment-status-badge.pending {
    background: #fff1d9;
    color: #d97706;
}

.payment-status-badge.failed,
.payment-status-badge.cancelled {
    background: #ffe5eb;
    color: #dc2626;
}


/* =========================================================
   DATE
========================================================= */

.payment-date strong {
    display: block;

    color: #475569;

    font-size: 9px;

    white-space: nowrap;
}

.payment-date small {
    display: block;

    margin-top: 2px;

    color: #94a3b8;

    font-size: 8px;
}


/* =========================================================
   VIEW DETAILS
========================================================= */

.payment-view-btn {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 5px;

    padding: 7px 10px;

    border-radius: 8px;

    background: #ffffff;

    border: 1px solid rgba(128,9,226,.18);

    color: #6d28d9;

    text-decoration: none;

    font-size: 8px;
    font-weight: 800;

    white-space: nowrap;

    box-shadow:
        0 3px 8px rgba(128,9,226,.04);

    transition: all .2s ease;
}

.payment-view-btn:hover {
    background: #8009e2;

    border-color: #8009e2;

    color: #ffffff;

    transform: translateY(-1px);

    box-shadow:
        0 6px 14px rgba(128,9,226,.20);
}


/* =========================================================
   EMPTY STATE
========================================================= */

.payment-empty-state {
    padding: 65px 20px;

    text-align: center;
}

.payment-empty-icon {
    width: 58px;
    height: 58px;

    margin: 0 auto 12px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 17px;

    background: #f1eaff;

    color: #8009e2;

    font-size: 23px;
}

.payment-empty-state h4 {
    margin: 0 0 5px;

    color: #334155;

    font-size: 14px;
}

.payment-empty-state p {
    margin: 0;

    color: #94a3b8;

    font-size: 10px;
}


/* =========================================================
   PAGINATION
========================================================= */

.payment-table-footer {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 15px;

    padding: 15px 20px;

    color: #94a3b8;

    font-size: 10px;
}

.payment-table-footer strong {
    color: #475569;
}

.payment-pagination {
    display: flex;

    align-items: center;

    gap: 5px;
}

.payment-page-link {
    min-width: 31px;
    height: 31px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 8px;

    border: 1px solid #e8e5f1;

    border-radius: 8px;

    background: #ffffff;

    color: #64748b;

    font-size: 10px;
    font-weight: 700;

    text-decoration: none;

    transition: all .18s ease;
}

.payment-page-link:hover {
    border-color: rgba(128,9,226,.25);

    background: #faf8ff;

    color: #8009e2;
}

.payment-page-link.active {
    background: #8009e2;

    border-color: #8009e2;

    color: #ffffff;

    box-shadow:
        0 5px 12px rgba(128,9,226,.20);
}

.payment-page-link.disabled {
    opacity: .45;

    pointer-events: none;

    cursor: default;
}

.payment-page-dots {
    min-width: 25px;

    text-align: center;

    color: #94a3b8;

    font-size: 11px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1100px) {

    .payment-stats-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .payment-filter-card {
        grid-template-columns:
            1fr 1fr;
    }

    .payment-filter-btn,
    .payment-reset-btn {
        width: 100%;
    }
}


@media (max-width: 700px) {

    .admin-payment-page {
        padding: 18px 10px 40px;
    }

    .payment-page-header {
        align-items: flex-start;
    }

    .payment-page-header h1 {
        font-size: 24px;
    }

    .payment-page-header p {
        max-width: 240px;
        line-height: 1.5;
    }

    .payment-header-icon {
        width: 55px;
        height: 55px;

        font-size: 22px;

        border-radius: 17px;
    }

    .payment-stats-grid {
        grid-template-columns: 1fr;
    }

    .payment-filter-card {
        grid-template-columns: 1fr;

        padding: 14px;
    }

    .payment-filter-info {
        align-items: flex-start;

        flex-direction: column;

        margin-top: -5px;
    }

    .payment-table-header {
        align-items: flex-start;

        flex-direction: column;
    }

    .payment-count-badge {
        display: inline-flex;
    }

    .payment-table-footer {
        flex-direction: column;

        align-items: flex-start;
    }

    .payment-pagination {
        width: 100%;

        overflow-x: auto;

        padding-bottom: 3px;
    }
}


@media (max-width: 420px) {

    .payment-page-header {
        gap: 12px;
    }

    .payment-page-header h1 {
        font-size: 21px;
    }

    .payment-kicker {
        font-size: 9px;
    }

    .payment-stat-card {
        min-height: 140px;

        padding: 17px;
    }

    .payment-stat-card h2 {
        font-size: 22px;
    }

    .payment-table-title h3 {
        font-size: 14px;
    }

    .payment-page-link {
        min-width: 29px;
        height: 29px;
    }
}

</style>


<div class="admin-payment-page">

  <!-- =====================================================
       PAGE HEADER
  ====================================================== -->

  <div class="payment-page-header">

    <div class="payment-header-left">

      <span class="payment-kicker">
        <i class="bi bi-credit-card-2-front"></i>
        PAYMENTS
      </span>

      <h1>
        Payment Management
      </h1>

      <p>
        Track and manage all course payment transactions
      </p>

    </div>

    <div class="payment-header-icon">
      <i class="bi bi-wallet2"></i>
    </div>

  </div>


  <!-- =====================================================
       STATISTICS
  ====================================================== -->

  <div class="payment-stats-grid">

    <!-- TOTAL REVENUE -->

    <div class="payment-stat-card revenue-card">

      <div class="payment-stat-top">

        <div class="payment-stat-icon">
          <i class="bi bi-currency-rupee"></i>
        </div>

        <span class="payment-stat-live">
          Live
        </span>

      </div>

      <span class="payment-stat-label">
        Total Revenue
      </span>

      <h2>
        ₹ <%= number_with_precision(
          @total_revenue,
          precision: 2
        ) %>
      </h2>

      <small>
        From all successful payments
      </small>

    </div>


    <!-- SUCCESSFUL -->

    <div class="payment-stat-card success-card">

      <div class="payment-stat-top">

        <div class="payment-stat-icon">
          <i class="bi bi-check-lg"></i>
        </div>

      </div>

      <span class="payment-stat-label">
        Successful Payments
      </span>

      <h2>
        <%= @successful_payments %>
      </h2>

      <small>
        Completed transactions
      </small>

    </div>


    <!-- CREATED -->

    <div class="payment-stat-card pending-card">

      <div class="payment-stat-top">

        <div class="payment-stat-icon">
          <i class="bi bi-clock"></i>
        </div>

      </div>

      <span class="payment-stat-label">
        Created Payments
      </span>

      <h2>
        <%= @pending_payments %>
      </h2>

      <small>
        Awaiting payment completion
      </small>

    </div>


    <!-- FAILED -->

    <div class="payment-stat-card failed-card">

      <div class="payment-stat-top">

        <div class="payment-stat-icon">
          <i class="bi bi-x-lg"></i>
        </div>

      </div>

      <span class="payment-stat-label">
        Failed Payments
      </span>

      <h2>
        <%= @failed_payments %>
      </h2>

      <small>
        Failed or cancelled
      </small>

    </div>

  </div>


  <!-- =====================================================
       SERVER-SIDE FILTER
  ====================================================== -->

  <form
    method="get"
    action="<%= admin_payments_path %>"
    class="payment-filter-card"
  >

    <!-- SEARCH -->

    <div class="payment-search-box">

      <i class="bi bi-search"></i>

      <input
        type="text"
        name="search"
        value="<%= params[:search].to_s %>"
        placeholder="Search student, email, course, payment ID..."
        autocomplete="off"
      >

    </div>


    <!-- STATUS -->

    <div class="payment-filter-select">

      <label for="paymentStatusFilter">
        Status
      </label>

      <select
        id="paymentStatusFilter"
        name="status"
      >

        <option value="">
          All Status
        </option>

        <option
          value="paid"
          <%= "selected" if params[:status] == "paid" %>
        >
          Paid
        </option>

        <option
          value="created"
          <%= "selected" if params[:status] == "created" %>
        >
          Created
        </option>

        <option
          value="pending"
          <%= "selected" if params[:status] == "pending" %>
        >
          Pending
        </option>

        <option
          value="failed"
          <%= "selected" if params[:status] == "failed" %>
        >
          Failed
        </option>

        <option
          value="cancelled"
          <%= "selected" if params[:status] == "cancelled" %>
        >
          Cancelled
        </option>

      </select>

    </div>


    <!-- COURSE -->

    <div class="payment-filter-select">

      <label for="paymentCourseFilter">
        Course
      </label>

      <select
        id="paymentCourseFilter"
        name="course"
      >

        <option value="">
          All Courses
        </option>

        <% @payment_courses.each do |course| %>

          <option
            value="<%= course.Course_name %>"
            <%= "selected" if params[:course].to_s == course.Course_name.to_s %>
          >
            <%= course.Course_name %>
          </option>

        <% end %>

      </select>

    </div>


    <!-- ACTIONS -->

    <div
      style="
        display:flex;
        gap:7px;
        align-items:center;
      "
    >

      <button
        type="submit"
        class="payment-filter-btn"
      >

        <i class="bi bi-funnel"></i>

        Filter

      </button>


      <% if params[:search].present? ||
            params[:status].present? ||
            params[:course].present? %>

        <%= link_to(
          admin_payments_path,
          class: "payment-reset-btn",
          title: "Clear filters"
        ) do %>

          <i class="bi bi-x-circle"></i>

          Reset

        <% end %>

      <% end %>

    </div>

  </form>


  <!-- =====================================================
       FILTER INFORMATION
  ====================================================== -->

  <div class="payment-filter-info">

    <div>

      <% if params[:search].present? ||
            params[:status].present? ||
            params[:course].present? %>

        <span class="payment-active-filter">

          <i class="bi bi-funnel-fill"></i>

          Filters active

        </span>

        &nbsp;

      <% end %>

      Showing

      <strong>
        <%= @filtered_payments_count %>
      </strong>

      matching payment<%= "s" unless @filtered_payments_count == 1 %>

    </div>


    <div>

      <strong>
        <%= @total_payments %>
      </strong>

      total payments

    </div>

  </div>


  <!-- =====================================================
       PAYMENT TABLE
  ====================================================== -->

  <div class="payment-table-card">

    <!-- TABLE HEADER -->

    <div class="payment-table-header">

      <div class="payment-table-title">

        <div class="payment-table-title-icon">
          <i class="bi bi-receipt"></i>
        </div>

        <div>

          <h3>
            Payment Transactions
          </h3>

          <p>
            Course payment transaction history
          </p>

        </div>

      </div>


      <span class="payment-count-badge">

        <%= @filtered_payments_count %>
        Payments

      </span>

    </div>


    <!-- TABLE -->

    <div class="payment-table-wrapper">

      <% if @payments.present? %>

        <table class="payment-management-table">

          <thead>

            <tr>

              <th>
                Student
              </th>

              <th>
                Course
              </th>

              <th>
                Payment ID
              </th>

              <th>
                Order ID
              </th>

              <th>
                Razorpay ID
              </th>

              <th>
                Amount
              </th>

              <th>
                Status
              </th>

              <th>
                Date & Time
              </th>

              <th>
                Action
              </th>

            </tr>

          </thead>


          <tbody>

            <% @payments.each do |payment| %>

              <% enrollment = payment.enrollment %>
              <% student = enrollment&.user %>
              <% course = enrollment&.course %>

              <% status =
                   payment.status.to_s.downcase %>

              <% course_name =
                   course&.Course_name.to_s %>


              <tr>

                <!-- =========================================
                     STUDENT
                ========================================== -->

                <td>

                  <div class="payment-student">

                    <div class="payment-avatar">

                      <% if student&.image&.attached? %>

                        <%= image_tag(
                          student.image,
                          alt: student.name.to_s
                        ) %>

                      <% else %>

                        <%= student&.name
                              .to_s
                              .first
                              .upcase
                              .presence || "S" %>

                      <% end %>

                    </div>


                    <div class="payment-student-info">

                      <strong>

                        <%= student&.name.presence ||
                            "Unknown Student" %>

                      </strong>

                      <small>

                        <%= student&.email.presence ||
                            "—" %>

                      </small>

                    </div>

                  </div>

                </td>


                <!-- =========================================
                     COURSE
                ========================================== -->

                <td>

                  <div class="payment-course-info">

                    <strong
                      title="<%= course_name %>"
                    >

                      <%= course_name.presence ||
                          "Unknown Course" %>

                    </strong>

                    <small>

                      Enrollment #
                      <%= enrollment&.id || "—" %>

                    </small>

                  </div>

                </td>


                <!-- =========================================
                     PAYMENT ID
                ========================================== -->

                <td>

                  <span class="payment-id">

                    #<%= payment.id %>

                  </span>

                </td>


                <!-- =========================================
                     ORDER ID
                ========================================== -->

                <td>

                  <span
                    class="payment-transaction-id"
                    title="<%= payment.razorpay_order_id.presence || "—" %>"
                  >

                    <%= payment.razorpay_order_id.presence || "—" %>

                  </span>

                </td>


                <!-- =========================================
                     RAZORPAY PAYMENT ID
                ========================================== -->

                <td>

                  <span
                    class="payment-transaction-id"
                    title="<%= payment.razorpay_payment_id.presence || "—" %>"
                  >

                    <%= payment.razorpay_payment_id.presence || "—" %>

                  </span>

                </td>


                <!-- =========================================
                     AMOUNT
                ========================================== -->

                <td>

                  <strong class="payment-amount">

                    ₹ <%= number_with_precision(
                      payment.amount,
                      precision: 2
                    ) %>

                  </strong>

                </td>


                <!-- =========================================
                     STATUS
                ========================================== -->

                <td>

                  <span
                    class="payment-status-badge <%= status %>"
                  >

                    <% if status == "paid" %>

  <span class="payment-status-badge paid">
    <i class="bi bi-check-circle-fill"></i>
    Paid
  </span>

<% elsif status == "created" %>

  <span class="payment-status-badge created">
    <i class="bi bi-clock-fill"></i>
    Created
  </span>

<% elsif status == "pending" %>

  <span class="payment-status-badge pending">
    <i class="bi bi-hourglass-split"></i>
    Pending
  </span>

<% elsif status == "failed" %>

  <span class="payment-status-badge failed">
    <i class="bi bi-x-circle-fill"></i>
    Failed
  </span>

<% elsif status == "cancelled" %>

  <span class="payment-status-badge cancelled">
    <i class="bi bi-slash-circle-fill"></i>
    Cancelled
  </span>

<% else %>

  <span class="payment-status-badge">

    <i class="bi bi-info-circle-fill"></i>

    <%= payment.status.to_s.titleize.presence || "Unknown" %>

  </span>

<% end %>

                  </span>

                </td>


                <!-- =========================================
                     DATE
                ========================================== -->

                <td>

                  <div class="payment-date">

                    <strong>

                      <%= payment.created_at.strftime(
                        "%d %b %Y"
                      ) %>

                    </strong>

                    <small>

                      <%= payment.created_at.strftime(
                        "%I:%M %p"
                      ) %>

                    </small>

                  </div>

                </td>


                <!-- =========================================
                     ACTION
                ========================================== -->

                <td>

                  <%= link_to(
                    admin_payment_path(payment),
                    class: "payment-view-btn"
                  ) do %>

                    <i class="bi bi-eye"></i>

                    <span>
                      View Details
                    </span>

                  <% end %>

                </td>

              </tr>

            <% end %>

          </tbody>

        </table>


      <% else %>

        <!-- ===============================================
             EMPTY STATE
        ================================================ -->

        <div class="payment-empty-state">

          <div class="payment-empty-icon">

            <% if params[:search].present? ||
                  params[:status].present? ||
                  params[:course].present? %>

              <i class="bi bi-search"></i>

            <% else %>

              <i class="bi bi-wallet2"></i>

            <% end %>

          </div>


          <h4>

            <% if params[:search].present? ||
                  params[:status].present? ||
                  params[:course].present? %>

              No Matching Payments

            <% else %>

              No Payments Found

            <% end %>

          </h4>


          <p>

            <% if params[:search].present? ||
                  params[:status].present? ||
                  params[:course].present? %>

              Try changing your search or filters.

            <% else %>

              Payment transactions will appear here.

            <% end %>

          </p>


          <% if params[:search].present? ||
                params[:status].present? ||
                params[:course].present? %>

            <div style="margin-top:15px;">

              <%= link_to(
                admin_payments_path,
                class: "payment-reset-btn"
              ) do %>

                <i class="bi bi-arrow-counterclockwise"></i>

                Clear Filters

              <% end %>

            </div>

          <% end %>

        </div>

      <% end %>

    </div>


    <!-- =====================================================
         PAGINATION FOOTER
    ====================================================== -->

    <% if @filtered_payments_count > 0 %>

      <div class="payment-table-footer">

        <div>

          <% first_record =
     ((@page - 1) * @per_page) + 1 %>

 <% last_record =
     [
       @page * @per_page,
       @filtered_payments_count
     ].min %>


          Showing

          <strong>
            <%= first_record %>
          </strong>

          –

          <strong>
            <%= last_record %>
          </strong>

          of

          <strong>
            <%= @filtered_payments_count %>
          </strong>

          payments

        </div>


        <!-- ===============================================
             PAGINATION
        ================================================ -->

        <% if @total_pages > 1 %>

          <div class="payment-pagination">

            <!-- PREVIOUS -->

            <% if @page > 1 %>

              <%= link_to(
                admin_payments_path(
                  request.query_parameters.merge(
                    page: @page - 1
                  )
                ),
                class: "payment-page-link",
                aria: {
                  label: "Previous page"
                }
              ) do %>

                <i class="bi bi-chevron-left"></i>

              <% end %>

            <% else %>

              <span
                class="payment-page-link disabled"
                aria-disabled="true"
              >

                <i class="bi bi-chevron-left"></i>

              </span>

            <% end %>


            <!-- PAGE NUMBERS -->

            <% if @total_pages <= 7 %>

              <% (1..@total_pages).each do |page_number| %>

                <% if page_number == @page %>

                  <span
                    class="payment-page-link active"
                    aria-current="page"
                  >
                    <%= page_number %>
                  </span>

                <% else %>

                  <%= link_to(
                    page_number,
                    admin_payments_path(
                      request.query_parameters.merge(
                        page: page_number
                      )
                    ),
                    class: "payment-page-link"
                  ) %>

                <% end %>

              <% end %>

            <% else %>

              <!-- FIRST PAGE -->

              <% if @page == 1 %>

                <span
                  class="payment-page-link active"
                  aria-current="page"
                >
                  1
                </span>

              <% else %>

                <%= link_to(
                  "1",
                  admin_payments_path(
                    request.query_parameters.merge(
                      page: 1
                    )
                  ),
                  class: "payment-page-link"
                ) %>

              <% end %>


              <!-- LEFT DOTS -->

              <% if @page > 4 %>

                <span class="payment-page-dots">
                  …
                </span>

              <% end %>


              <!-- MIDDLE PAGES -->

              <% start_page =
                   [
                     2,
                     @page - 1
                   ].max %>

              <% end_page =
                   [
                     @total_pages - 1,
                     @page + 1
                   ].min %>


              <% (start_page..end_page).each do |page_number| %>

                <% next if page_number <= 1 ||
                           page_number >= @total_pages %>


                <% if page_number == @page %>

                  <span
                    class="payment-page-link active"
                    aria-current="page"
                  >
                    <%= page_number %>
                  </span>

                <% else %>

                  <%= link_to(
                    page_number,
                    admin_payments_path(
                      request.query_parameters.merge(
                        page: page_number
                      )
                    ),
                    class: "payment-page-link"
                  ) %>

                <% end %>

              <% end %>


              <!-- RIGHT DOTS -->

              <% if @page < @total_pages - 3 %>

                <span class="payment-page-dots">
                  …
                </span>

              <% end %>


              <!-- LAST PAGE -->

              <% if @page == @total_pages %>

                <span
                  class="payment-page-link active"
                  aria-current="page"
                >
                  <%= @total_pages %>
                </span>

              <% else %>

                <%= link_to(
                  @total_pages,
                  admin_payments_path(
                    request.query_parameters.merge(
                      page: @total_pages
                    )
                  ),
                  class: "payment-page-link"
                ) %>

              <% end %>

            <% end %>


            <!-- NEXT -->

            <% if @page < @total_pages %>

              <%= link_to(
                admin_payments_path(
                  request.query_parameters.merge(
                    page: @page + 1
                  )
                ),
                class: "payment-page-link",
                aria: {
                  label: "Next page"
                }
              ) do %>

                <i class="bi bi-chevron-right"></i>

              <% end %>

            <% else %>

              <span
                class="payment-page-link disabled"
                aria-disabled="true"
              >

                <i class="bi bi-chevron-right"></i>

              </span>

            <% end %>

          </div>

        <% end %>

      </div>

    <% end %>

  </div>

</div>