<%# =========================================================
    A ONE GS CENTER
    PREMIUM ADMIN PAYMENT DETAILS
========================================================= %>

<%
  enrollment = @payment.enrollment
  student    = enrollment&.user
  course     = enrollment&.course

  status = @payment.status.to_s.downcase.presence || "unknown"

  if status == "paid"
    status_label = "Paid"
    status_class = "paid"
    status_icon = "bi-check-circle-fill"
    timeline_icon = "bi-check-circle-fill"

  elsif status == "created"
    status_label = "Created"
    status_class = "created"
    status_icon = "bi-clock-fill"
    timeline_icon = "bi-hourglass-split"

  elsif status == "pending"
    status_label = "Pending"
    status_class = "pending"
    status_icon = "bi-clock-fill"
    timeline_icon = "bi-hourglass-split"

  elsif status == "failed"
    status_label = "Failed"
    status_class = "failed"
    status_icon = "bi-x-circle-fill"
    timeline_icon = "bi-x-circle-fill"

  elsif status == "cancelled"
    status_label = "Cancelled"
    status_class = "cancelled"
    status_icon = "bi-x-circle-fill"
    timeline_icon = "bi-x-circle-fill"

  else
    status_label = status.titleize.presence || "Unknown"
    status_class = "unknown"
    status_icon = "bi-info-circle-fill"
    timeline_icon = "bi-hourglass-split"
  end
%>


<div class="premium-payment-page">

  <!-- =====================================================
       PREMIUM PAGE HEADER
  ====================================================== -->

  <header class="premium-payment-header">

    <div class="premium-breadcrumb">

      <%= link_to admin_payments_path,
          class: "premium-breadcrumb-link" do %>

        <i class="bi bi-credit-card-2-front"></i>

        <span>Payments</span>

      <% end %>

      <i class="bi bi-chevron-right"></i>

      <span>
        Payment #<%= @payment.id %>
      </span>

    </div>


    <div class="premium-header-row">

      <div class="premium-title-area">

        <div class="premium-eyebrow">

          <span class="premium-eyebrow-dot"></span>

          PAYMENT MANAGEMENT

        </div>


        <h1>
          Payment Details
        </h1>


        <p>
          Complete transaction, student and enrollment information
        </p>

      </div>


      <%= link_to admin_payments_path,
          class: "premium-back-button" do %>

        <i class="bi bi-arrow-left"></i>

        <span>Back to Payments</span>

      <% end %>

    </div>

  </header>



  <!-- =====================================================
       PAYMENT SUMMARY
  ====================================================== -->

  <section class="premium-summary-grid">


    <!-- AMOUNT -->

    <article class="premium-summary-card">

      <div class="summary-card-icon amount-icon">

        <i class="bi bi-currency-rupee"></i>

      </div>


      <div class="summary-card-content">

        <span class="summary-label">
          Payment Amount
        </span>


        <strong class="summary-value">

          ₹<%= number_with_precision(
            @payment.amount,
            precision: 2
          ) %>

        </strong>


        <span class="summary-caption">
          Transaction amount
        </span>

      </div>

    </article>



    <!-- STATUS -->

    <article class="premium-summary-card">

      <div class="summary-card-icon status-icon">

        <i class="bi <%= status_icon %>"></i>

      </div>


      <div class="summary-card-content">

        <span class="summary-label">
          Payment Status
        </span>


        <span class="premium-status <%= status_class %>">

          <span class="status-dot"></span>

          <%= status_label %>

        </span>


        <span class="summary-caption">
          Current transaction status
        </span>

      </div>

    </article>



    <!-- RECORD -->

    <article class="premium-summary-card">

      <div class="summary-card-icon record-icon">

        <i class="bi bi-receipt"></i>

      </div>


      <div class="summary-card-content">

        <span class="summary-label">
          Payment Record
        </span>


        <strong class="summary-value record-value">

          #<%= @payment.id %>

        </strong>


        <span class="summary-caption">
          Internal payment ID
        </span>

      </div>

    </article>

  </section>



  <!-- =====================================================
       STUDENT + COURSE
  ====================================================== -->

  <section class="premium-two-column">


    <!-- STUDENT -->

    <article class="premium-card">

      <div class="premium-card-header">

        <div class="premium-section-icon">

          <i class="bi bi-person"></i>

        </div>


        <div>

          <h2>
            Student Information
          </h2>

          <p>
            Student associated with this transaction
          </p>

        </div>

      </div>


      <div class="premium-profile">

        <div class="premium-avatar">

          <% if student&.image&.attached? %>

            <%= image_tag(
              student.image,
              alt: student.name.to_s.presence || "Student",
              loading: "lazy"
            ) %>

          <% else %>

            <%= student&.name
                  .to_s
                  .strip
                  .first
                  .to_s
                  .upcase
                  .presence || "S" %>

          <% end %>

        </div>


        <div class="premium-profile-info">

          <h3>
            <%= student&.name.presence || "Unknown Student" %>
          </h3>


          <div class="profile-line">

            <i class="bi bi-envelope"></i>

            <span>
              <%= student&.email.presence || "Email not available" %>
            </span>

          </div>


          <% if student&.mobile.present? %>

            <div class="profile-line">

              <i class="bi bi-phone"></i>

              <span>
                <%= student.mobile %>
              </span>

            </div>

          <% end %>


          <div class="profile-line">

            <i class="bi bi-person-badge"></i>

            <span>
              User ID
              <strong>#<%= student&.id || "—" %></strong>
            </span>

          </div>

        </div>

      </div>

    </article>



    <!-- COURSE -->

    <article class="premium-card">

      <div class="premium-card-header">

        <div class="premium-section-icon">

          <i class="bi bi-book"></i>

        </div>


        <div>

          <h2>
            Course Information
          </h2>

          <p>
            Course connected to this enrollment
          </p>

        </div>

      </div>


      <div class="premium-profile">

        <div class="premium-course-icon">

          <i class="bi bi-mortarboard-fill"></i>

        </div>


        <div class="premium-profile-info">

          <h3>
            <%= course&.Course_name.presence || "Unknown Course" %>
          </h3>


          <div class="profile-line">

            <i class="bi bi-link-45deg"></i>

            <span>
              Enrollment
              <strong>#<%= enrollment&.id || "—" %></strong>
            </span>

          </div>


          <% if course&.id.present? %>

            <div class="profile-line">

              <i class="bi bi-bookmark"></i>

              <span>
                Course ID
                <strong>#<%= course.id %></strong>
              </span>

            </div>

          <% end %>

        </div>

      </div>

    </article>

  </section>



  <!-- =====================================================
       PAYMENT INFORMATION
  ====================================================== -->

  <section class="premium-card premium-full-card">

    <div class="premium-card-header">

      <div class="premium-section-icon">

        <i class="bi bi-receipt-cutoff"></i>

      </div>


      <div>

        <h2>
          Payment Information
        </h2>

        <p>
          Internal transaction information
        </p>

      </div>

    </div>


    <div class="premium-information-grid">


      <div class="information-item">

        <span>
          Payment Record ID
        </span>

        <strong class="mono">
          #<%= @payment.id %>
        </strong>

      </div>


      <div class="information-item">

        <span>
          Amount
        </span>

        <strong class="money">

          ₹<%= number_with_precision(
            @payment.amount,
            precision: 2
          ) %>

        </strong>

      </div>


      <div class="information-item">

        <span>
          Status
        </span>

        <span class="premium-status <%= status_class %>">

          <span class="status-dot"></span>

          <%= status_label %>

        </span>

      </div>


      <div class="information-item">

        <span>
          Enrollment
        </span>

        <strong class="mono">
          #<%= enrollment&.id || "—" %>
        </strong>

      </div>


      <div class="information-item">

        <span>
          Created At
        </span>

        <strong>

          <%= @payment.created_at&.strftime(
            "%d %b %Y, %I:%M %p"
          ) || "—" %>

        </strong>

      </div>


      <div class="information-item">

        <span>
          Last Updated
        </span>

        <strong>

          <%= @payment.updated_at&.strftime(
            "%d %b %Y, %I:%M %p"
          ) || "—" %>

        </strong>

      </div>

    </div>

  </section>



  <!-- =====================================================
       RAZORPAY INFORMATION
  ====================================================== -->

  <section class="premium-card premium-full-card">

    <div class="premium-card-header">

      <div class="premium-section-icon razorpay-section-icon">

        <i class="bi bi-credit-card-2-front"></i>

      </div>


      <div>

        <h2>
          Razorpay Information
        </h2>

        <p>
          Payment gateway transaction details
        </p>

      </div>

    </div>


    <div class="premium-information-grid">


      <div class="information-item">

        <span>
          Razorpay Order ID
        </span>

        <strong
          class="mono break-text"
          title="<%= @payment.razorpay_order_id.presence || "Not available" %>"
        >

          <%= @payment.razorpay_order_id.presence || "—" %>

        </strong>

      </div>


      <div class="information-item">

        <span>
          Razorpay Payment ID
        </span>

        <strong
          class="mono break-text"
          title="<%= @payment.razorpay_payment_id.presence || "Not available" %>"
        >

          <%= @payment.razorpay_payment_id.presence || "—" %>

        </strong>

      </div>


      <div class="information-item">

        <span>
          Razorpay QR ID
        </span>

        <strong
          class="mono break-text"
          title="<%= @payment.razorpay_qr_id.presence || "Not available" %>"
        >

          <%= @payment.razorpay_qr_id.presence || "—" %>

        </strong>

      </div>


      <div class="information-item">

        <span>
          Razorpay Signature
        </span>


        <% if @payment.razorpay_signature.present? %>

          <strong
            class="mono signature-value"
            title="Payment signature is securely stored"
          >

            <%= @payment.razorpay_signature.to_s.first(8) %>

            ••••••••••••

          </strong>

        <% else %>

          <strong>
            —
          </strong>

        <% end %>

      </div>

    </div>

  </section>



  <!-- =====================================================
       TIMELINE
  ====================================================== -->

  <section class="premium-card premium-full-card">

    <div class="premium-card-header">

      <div class="premium-section-icon">

        <i class="bi bi-clock-history"></i>

      </div>


      <div>

        <h2>
          Payment Timeline
        </h2>

        <p>
          Important transaction timestamps
        </p>

      </div>

    </div>


    <div class="premium-timeline">


      <div class="timeline-row">

        <div class="timeline-marker">

          <i class="bi bi-plus-lg"></i>

        </div>


        <div class="timeline-body">

          <strong>
            Payment Created
          </strong>

          <span>

            <%= @payment.created_at&.strftime(
              "%d %B %Y · %I:%M %p"
            ) || "—" %>

          </span>

        </div>

      </div>



      <div class="timeline-row">

        <div class="timeline-marker">

          <i class="bi bi-arrow-repeat"></i>

        </div>


        <div class="timeline-body">

          <strong>
            Last Updated
          </strong>

          <span>

            <%= @payment.updated_at&.strftime(
              "%d %B %Y · %I:%M %p"
            ) || "—" %>

          </span>

        </div>

      </div>



      <div class="timeline-row">

        <div class="timeline-marker current <%= status_class %>">

          <i class="bi <%= timeline_icon %>"></i>

        </div>


        <div class="timeline-body">

          <strong>
            Current Payment Status
          </strong>

          <span>
            <%= status_label %>
          </span>

        </div>

      </div>

    </div>

  </section>



  <!-- =====================================================
       SECURITY INFORMATION
  ====================================================== -->

  <div class="premium-security-note">

    <div class="security-note-icon">

      <i class="bi bi-shield-lock-fill"></i>

    </div>


    <div>

      <strong>
        Payment information protected
      </strong>

      <p>
        Gateway identifiers are displayed for administrative
        verification. Sensitive payment signatures are masked.
      </p>

    </div>

  </div>

</div>



<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   PREMIUM WHITE PAYMENT PAGE
   A ONE GS CENTER
========================================================= */


/* =========================================================
   HIDE ADMIN MAIN BACKGROUND
========================================================= */

.admin-payment-details-page,
.premium-payment-page {

  background: #ffffff !important;

}


/*
   These selectors intentionally override common admin
   content wrappers without changing the global admin layout.
*/

.admin-content,
.admin-main,
.admin-main-content,
.admin-page-content,
.admin-layout-content,
.content-wrapper,
.main-content {

  background: transparent !important;

}


/* =========================================================
   MAIN PAGE
========================================================= */

.premium-payment-page {

  width: 100%;

  min-height: calc(100vh - 1px);

  max-width: 1480px;

  margin: 0 auto;

  padding: 24px 30px 60px;

  color: #172033;

  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

}


/* =========================================================
   HEADER
========================================================= */

.premium-payment-header {

  margin-bottom: 26px;

}

.premium-breadcrumb {

  display: flex;

  align-items: center;

  gap: 8px;

  margin-bottom: 18px;

  color: #9ca3af;

  font-size: 11px;

  font-weight: 600;

}

.premium-breadcrumb-link {

  display: inline-flex;

  align-items: center;

  gap: 7px;

  color: #8009e2;

  text-decoration: none;

  transition: color .2s ease;

}

.premium-breadcrumb-link:hover {

  color: #6200ad;

}

.premium-breadcrumb > i {

  color: #cbd0d8;

  font-size: 9px;

}

.premium-header-row {

  display: flex;

  align-items: flex-end;

  justify-content: space-between;

  gap: 24px;

}

.premium-title-area {

  min-width: 0;

}

.premium-eyebrow {

  display: inline-flex;

  align-items: center;

  gap: 8px;

  color: #8009e2;

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 1.5px;

}

.premium-eyebrow-dot {

  width: 6px;

  height: 6px;

  border-radius: 50%;

  background: #8009e2;

}

.premium-title-area h1 {

  margin: 8px 0 5px;

  color: #111827;

  font-size: 31px;

  line-height: 1.15;

  font-weight: 800;

  letter-spacing: -.7px;

}

.premium-title-area p {

  margin: 0;

  color: #8a93a1;

  font-size: 13px;

}

.premium-back-button {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  min-height: 42px;

  padding: 0 17px;

  border: 1px solid #e8e2ef;

  border-radius: 11px;

  background: #ffffff;

  color: #8009e2;

  text-decoration: none;

  font-size: 12px;

  font-weight: 700;

  white-space: nowrap;

  box-shadow:
    0 3px 12px rgba(20,20,40,.035);

  transition:
    color .2s ease,
    background .2s ease,
    border-color .2s ease,
    box-shadow .2s ease,
    transform .2s ease;

}

.premium-back-button:hover {

  background: #8009e2;

  border-color: #8009e2;

  color: #ffffff;

  transform: translateY(-1px);

  box-shadow:
    0 8px 20px rgba(128,9,226,.16);

}


/* =========================================================
   SUMMARY
========================================================= */

.premium-summary-grid {

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 15px;

  margin-bottom: 18px;

}

.premium-summary-card {

  display: flex;

  align-items: center;

  gap: 15px;

  min-height: 116px;

  padding: 20px;

  background: #ffffff;

  border: 1px solid #eeeaf2;

  border-radius: 16px;

  box-shadow:
    0 5px 20px rgba(26,20,45,.035);

  transition:
    transform .2s ease,
    box-shadow .2s ease;

}

.premium-summary-card:hover {

  transform: translateY(-2px);

  box-shadow:
    0 10px 28px rgba(26,20,45,.07);

}

.summary-card-icon {

  width: 48px;

  height: 48px;

  min-width: 48px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 13px;

  font-size: 18px;

}

.amount-icon {

  background: #f5effb;

  color: #8009e2;

}

.status-icon {

  background: #ecfdf5;

  color: #059669;

}

.record-icon {

  background: #eef2ff;

  color: #4f46e5;

}

.summary-card-content {

  min-width: 0;

}

.summary-label {

  display: block;

  margin-bottom: 5px;

  color: #98a0ac;

  font-size: 9px;

  font-weight: 800;

  letter-spacing: .7px;

  text-transform: uppercase;

}

.summary-value {

  display: block;

  color: #172033;

  font-size: 21px;

  line-height: 1.2;

  font-weight: 800;

}

.record-value {

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

}

.summary-caption {

  display: block;

  margin-top: 5px;

  color: #aeb4bd;

  font-size: 10px;

}


/* =========================================================
   STATUS
========================================================= */

.premium-status {

  display: inline-flex;

  align-items: center;

  gap: 7px;

  width: fit-content;

  padding: 5px 9px;

  border-radius: 999px;

  font-size: 10px;

  font-weight: 800;

}

.status-dot {

  width: 6px;

  height: 6px;

  border-radius: 50%;

  background: currentColor;

}

.premium-status.paid {

  background: #ecfdf5;

  color: #047857;

}

.premium-status.created {

  background: #eff6ff;

  color: #2563eb;

}

.premium-status.pending {

  background: #fffbeb;

  color: #b45309;

}

.premium-status.failed,
.premium-status.cancelled {

  background: #fef2f2;

  color: #dc2626;

}

.premium-status.unknown {

  background: #f3f4f6;

  color: #6b7280;

}


/* =========================================================
   TWO COLUMNS
========================================================= */

.premium-two-column {

  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 16px;

  margin-bottom: 16px;

}


/* =========================================================
   CARD
========================================================= */

.premium-card {

  background: #ffffff;

  border: 1px solid #eeeaf2;

  border-radius: 17px;

  box-shadow:
    0 5px 20px rgba(26,20,45,.035);

  overflow: hidden;

}

.premium-full-card {

  margin-bottom: 16px;

}

.premium-card-header {

  display: flex;

  align-items: center;

  gap: 12px;

  padding: 19px 21px;

  border-bottom: 1px solid #f1eef4;

}

.premium-section-icon {

  width: 38px;

  height: 38px;

  min-width: 38px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 11px;

  background: #f5effb;

  color: #8009e2;

  font-size: 15px;

}

.razorpay-section-icon {

  background: #eef4ff;

  color: #2563eb;

}

.premium-card-header h2 {

  margin: 0 0 3px;

  color: #202635;

  font-size: 14px;

  font-weight: 800;

}

.premium-card-header p {

  margin: 0;

  color: #9ca3af;

  font-size: 10px;

}


/* =========================================================
   PROFILE
========================================================= */

.premium-profile {

  display: flex;

  align-items: center;

  gap: 15px;

  padding: 21px;

}

.premium-avatar {

  width: 62px;

  height: 62px;

  min-width: 62px;

  display: flex;

  align-items: center;

  justify-content: center;

  overflow: hidden;

  border-radius: 16px;

  background: #f5effb;

  color: #8009e2;

  font-size: 21px;

  font-weight: 800;

}

.premium-avatar img {

  width: 100%;

  height: 100%;

  object-fit: cover;

}

.premium-course-icon {

  width: 58px;

  height: 58px;

  min-width: 58px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 15px;

  background: #f5effb;

  color: #8009e2;

  font-size: 21px;

}

.premium-profile-info {

  min-width: 0;

}

.premium-profile-info h3 {

  margin: 0 0 8px;

  color: #202635;

  font-size: 14px;

  font-weight: 800;

  overflow-wrap: anywhere;

}

.profile-line {

  display: flex;

  align-items: center;

  gap: 7px;

  margin-top: 5px;

  color: #7d8692;

  font-size: 10px;

}

.profile-line i {

  width: 14px;

  color: #8009e2;

  text-align: center;

}

.profile-line strong {

  color: #4b5563;

}


/* =========================================================
   INFORMATION GRID
========================================================= */

.premium-information-grid {

  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 11px;

  padding: 20px 21px 21px;

}

.information-item {

  min-width: 0;

  min-height: 68px;

  padding: 13px 14px;

  border: 1px solid #f0edf3;

  border-radius: 11px;

  background: #fdfcfe;

}

.information-item > span:first-child {

  display: block;

  margin-bottom: 7px;

  color: #9ca3af;

  font-size: 8px;

  font-weight: 800;

  letter-spacing: .7px;

  text-transform: uppercase;

}

.information-item strong {

  display: block;

  color: #374151;

  font-size: 11px;

  line-height: 1.5;

  overflow-wrap: anywhere;

}

.information-item .mono {

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 10px;

}

.information-item .money {

  color: #172033;

  font-size: 14px;

  font-weight: 800;

}

.break-text {

  word-break: break-all;

}

.signature-value {

  color: #64748b !important;

}


/* =========================================================
   TIMELINE
========================================================= */

.premium-timeline {

  padding: 20px 21px 22px;

}

.timeline-row {

  position: relative;

  display: flex;

  align-items: flex-start;

  gap: 13px;

  min-height: 59px;

}

.timeline-row:not(:last-child)::after {

  content: "";

  position: absolute;

  left: 17px;

  top: 35px;

  bottom: 0;

  width: 1px;

  background: #e8e2ed;

}

.timeline-marker {

  position: relative;

  z-index: 2;

  width: 35px;

  height: 35px;

  min-width: 35px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: #f5effb;

  color: #8009e2;

  font-size: 11px;

}

.timeline-marker.paid {

  background: #ecfdf5;

  color: #047857;

}

.timeline-marker.failed,
.timeline-marker.cancelled {

  background: #fef2f2;

  color: #dc2626;

}

.timeline-marker.created,
.timeline-marker.pending {

  background: #fffbeb;

  color: #b45309;

}

.timeline-body {

  padding-top: 2px;

}

.timeline-body strong {

  display: block;

  color: #374151;

  font-size: 11px;

  font-weight: 800;

}

.timeline-body span {

  display: block;

  margin-top: 4px;

  color: #9ca3af;

  font-size: 9px;

}


/* =========================================================
   SECURITY
========================================================= */

.premium-security-note {

  display: flex;

  align-items: flex-start;

  gap: 12px;

  padding: 15px 17px;

  border: 1px solid #e5edf9;

  border-radius: 14px;

  background: #fbfdff;

}

.security-note-icon {

  width: 32px;

  height: 32px;

  min-width: 32px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 9px;

  background: #eef5ff;

  color: #2563eb;

  font-size: 13px;

}

.premium-security-note strong {

  display: block;

  margin-bottom: 3px;

  color: #334155;

  font-size: 10px;

  font-weight: 800;

}

.premium-security-note p {

  margin: 0;

  color: #8a94a3;

  font-size: 9px;

  line-height: 1.5;

}


/* =========================================================
   REMOVE PAGE-LEVEL DARK / GLASS EFFECTS
========================================================= */

.premium-payment-page,
.premium-payment-page * {

  box-sizing: border-box;

}


/*
   Prevent inherited glass backgrounds from making
   this page look dark.
*/

.premium-payment-page {

  backdrop-filter: none !important;

  -webkit-backdrop-filter: none !important;

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1050px) {

  .premium-summary-grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

  }

  .premium-summary-card:last-child {

    grid-column: 1 / -1;

  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

  .premium-payment-page {

    padding: 18px 15px 45px;

  }

  .premium-header-row {

    align-items: stretch;

    flex-direction: column;

  }

  .premium-back-button {

    width: 100%;

  }

  .premium-summary-grid {

    grid-template-columns: 1fr;

  }

  .premium-summary-card:last-child {

    grid-column: auto;

  }

  .premium-two-column {

    grid-template-columns: 1fr;

  }

  .premium-information-grid {

    grid-template-columns: 1fr;

  }

  .premium-title-area h1 {

    font-size: 25px;

  }

}


