<div class="coupon-admin-page">

  <div class="coupon-page-header">

    <div>
      <span class="coupon-kicker">
        <i class="fa-solid fa-ticket"></i>
        COUPON MANAGEMENT
      </span>

      <h1>Coupons</h1>

      <p>
        Create and manage course discount coupons for students.
      </p>
    </div>

    <%= link_to new_admin_coupon_path,
                class: "coupon-create-button" do %>
      <i class="fa-solid fa-plus"></i>
      Create Coupon
    <% end %>

  </div>


  <div class="coupon-info-grid">

    <div class="coupon-info-card">
      <div class="coupon-info-icon">
        <i class="fa-solid fa-ticket"></i>
      </div>

      <div>
        <span>Total Coupons</span>
        <strong><%= @coupons.count %></strong>
      </div>
    </div>


    <div class="coupon-info-card">
      <div class="coupon-info-icon">
        <i class="fa-solid fa-toggle-on"></i>
      </div>

      <div>
        <span>Active Coupons</span>
        <strong>
          <%= @coupons.count(&:active?) %>
        </strong>
      </div>
    </div>


    <div class="coupon-info-card">
      <div class="coupon-info-icon">
        <i class="fa-solid fa-users"></i>
      </div>

      <div>
        <span>Everyone Coupons</span>
        <strong>
          <%= @coupons.count(&:everyone?) %>
        </strong>
      </div>
    </div>


    <div class="coupon-info-card">
      <div class="coupon-info-icon">
        <i class="fa-solid fa-user-lock"></i>
      </div>

      <div>
        <span>Personal Coupons</span>
        <strong>
          <%= @coupons.count(&:personal?) %>
        </strong>
      </div>
    </div>

  </div>


  <div class="coupon-table-card">

    <div class="coupon-table-header">
      <div>
        <h2>All Coupons</h2>
        <p>Manage your course discount codes.</p>
      </div>
    </div>


    <% if @coupons.any? %>

      <div class="coupon-table-wrapper">

        <table class="coupon-table">

          <thead>
            <tr>
              <th>Coupon</th>
              <th>Course</th>
              <th>Type</th>
              <th>Discount</th>
              <th>Usage</th>
              <th>Status</th>
              <th>Expiry</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>

            <% @coupons.each do |coupon| %>

              <tr>

                <td>
                  <div class="coupon-code">
                    <i class="fa-solid fa-ticket"></i>
                    <strong>
                      <%= coupon.code %>
                    </strong>
                  </div>
                </td>


                <td>
                  <div class="coupon-course">
                    <strong>
                      <%= coupon.course.Course_name %>
                    </strong>
                  </div>
                </td>


                <td>

                  <% if coupon.everyone? %>

                    <span class="coupon-type everyone">
                      <i class="fa-solid fa-users"></i>
                      Everyone
                    </span>

                  <% else %>

                    <span class="coupon-type personal">
                      <i class="fa-solid fa-user"></i>
                      Personal
                    </span>

                  <% end %>

                </td>


                <td>

                  <strong class="coupon-discount">

                    <% if coupon.discount_type == "percentage" %>

                      <%= coupon.discount_value.to_s
                          .sub(/\.0+$/, "") %>%

                    <% else %>

                      ₹<%= number_with_precision(
                        coupon.discount_value,
                        precision: 2
                      ) %>

                    <% end %>

                  </strong>

                </td>


                <td>

                  <div class="coupon-usage">

                    <strong>
                      <%= coupon.used_count %>
                    </strong>

                    <span>
                      /
                      <%= coupon.usage_limit || "∞" %>
                    </span>

                  </div>

                </td>


                <td>

                  <% if coupon.usable? %>

                    <span class="coupon-status active">
                      <span></span>
                      Active
                    </span>

                  <% elsif coupon.expired? %>

                    <span class="coupon-status expired">
                      <span></span>
                      Expired
                    </span>

                  <% elsif coupon.usage_exhausted? %>

                    <span class="coupon-status exhausted">
                      <span></span>
                      Used Up
                    </span>

                  <% else %>

                    <span class="coupon-status inactive">
                      <span></span>
                      Inactive
                    </span>

                  <% end %>

                </td>


                <td>

                  <% if coupon.expires_at.present? %>

                    <%= coupon.expires_at.strftime("%d %b %Y") %>

                  <% else %>

                    <span class="coupon-no-expiry">
                      No expiry
                    </span>

                  <% end %>

                </td>


                <td>

                  <div class="coupon-actions">

                    <%= link_to admin_coupon_path(coupon),
                                class: "coupon-action view",
                                title: "View" do %>
                      <i class="fa-solid fa-eye"></i>
                    <% end %>


                    <%= link_to edit_admin_coupon_path(coupon),
                                class: "coupon-action edit",
                                title: "Edit" do %>
                      <i class="fa-solid fa-pen"></i>
                    <% end %>


                    <%= button_to admin_coupon_path(coupon),
                                  method: :delete,
                                  class: "coupon-action delete",
                                  title: "Delete",
                                  form: {
                                    data: {
                                      turbo_confirm:
                                        "Are you sure you want to delete this coupon?"
                                    }
                                  } do %>
                      <i class="fa-solid fa-trash"></i>
                    <% end %>

                  </div>

                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

      </div>

    <% else %>

      <div class="coupon-empty">

        <div class="coupon-empty-icon">
          <i class="fa-solid fa-ticket"></i>
        </div>

        <h3>No coupons yet</h3>

        <p>
          Create your first course discount coupon.
        </p>

        <%= link_to new_admin_coupon_path,
                    class: "coupon-create-button" do %>
          <i class="fa-solid fa-plus"></i>
          Create First Coupon
        <% end %>

      </div>

    <% end %>

  </div>

</div>


<style nonce="<%= content_security_policy_nonce %>">

.coupon-admin-page {
  width: 100%;
  padding: 0 20px 40px 0;
}

.coupon-page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.coupon-kicker {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #c4b5fd;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.coupon-page-header h1 {
  margin: 6px 0 4px;
  color: #fff;
  font-size: 38px;
  font-weight: 900;
}

.coupon-page-header p {
  margin: 0;
  color: rgba(255,255,255,.72);
  font-size: 14px;
}

.coupon-create-button {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 12px 19px;
  border-radius: 13px;
  background: #fff;
  color: #5b21b6;
  text-decoration: none;
  font-size: 14px;
  font-weight: 800;
  box-shadow: 0 10px 25px rgba(0,0,0,.12);
  transition: .2s ease;
  white-space: nowrap;
}

.coupon-create-button:hover {
  color: #4c1d95;
  transform: translateY(-2px);
  box-shadow: 0 14px 30px rgba(0,0,0,.18);
}


.coupon-info-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.coupon-info-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 19px;
  border-radius: 17px;
  background: rgba(255,255,255,.97);
  color: #24113f;
  box-shadow:
    0 10px 25px rgba(0,0,0,.12),
    inset 0 1px 0 rgba(255,255,255,.9);
}

.coupon-info-icon {
  width: 45px;
  height: 45px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: #f3e8ff;
  color: #7c3aed;
}

.coupon-info-card span {
  display: block;
  color: #777;
  font-size: 12px;
  font-weight: 700;
}

.coupon-info-card strong {
  display: block;
  margin-top: 3px;
  color: #35105f;
  font-size: 24px;
  font-weight: 900;
}


.coupon-table-card {
  overflow: hidden;
  border-radius: 20px;
  background: rgba(255,255,255,.98);
  color: #24113f;
  box-shadow: 0 15px 40px rgba(0,0,0,.14);
}

.coupon-table-header {
  padding: 22px 24px;
  border-bottom: 1px solid #eee;
}

.coupon-table-header h2 {
  margin: 0;
  color: #35105f;
  font-size: 20px;
  font-weight: 900;
}

.coupon-table-header p {
  margin: 4px 0 0;
  color: #777;
  font-size: 13px;
}


.coupon-table-wrapper {
  width: 100%;
  overflow-x: auto;
}

.coupon-table {
  width: 100%;
  min-width: 1050px;
  border-collapse: collapse;
}

.coupon-table th {
  padding: 14px 18px;
  background: #faf7ff;
  color: #6b7280;
  text-align: left;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .7px;
  text-transform: uppercase;
  white-space: nowrap;
}

.coupon-table td {
  padding: 17px 18px;
  border-top: 1px solid #f0edf4;
  vertical-align: middle;
  font-size: 13px;
}

.coupon-code {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #5b21b6;
}

.coupon-code strong {
  letter-spacing: .5px;
}

.coupon-course strong {
  display: block;
  max-width: 220px;
  color: #35105f;
}

.coupon-type,
.coupon-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 9px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
}

.coupon-type.everyone {
  background: #ede9fe;
  color: #6d28d9;
}

.coupon-type.personal {
  background: #e0f2fe;
  color: #0369a1;
}

.coupon-discount {
  color: #6d28d9;
  font-size: 15px;
}

.coupon-usage strong {
  color: #35105f;
}

.coupon-usage span {
  color: #888;
}

.coupon-status span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
}

.coupon-status.active {
  background: #ecfdf5;
  color: #047857;
}

.coupon-status.active span {
  background: #10b981;
}

.coupon-status.expired {
  background: #fff7ed;
  color: #c2410c;
}

.coupon-status.expired span {
  background: #f97316;
}

.coupon-status.exhausted,
.coupon-status.inactive {
  background: #f3f4f6;
  color: #6b7280;
}

.coupon-status.exhausted span,
.coupon-status.inactive span {
  background: #9ca3af;
}

.coupon-no-expiry {
  color: #999;
  font-size: 12px;
}

.coupon-actions {
  display: flex;
  align-items: center;
  gap: 7px;
}

.coupon-action {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 9px;
  text-decoration: none;
  cursor: pointer;
  transition: .2s ease;
}

.coupon-action.view {
  background: #f3e8ff;
  color: #7c3aed;
}

.coupon-action.edit {
  background: #eff6ff;
  color: #2563eb;
}

.coupon-action.delete {
  background: #fef2f2;
  color: #dc2626;
}

.coupon-action:hover {
  transform: translateY(-2px);
}


.coupon-empty {
  padding: 70px 20px;
  text-align: center;
}

.coupon-empty-icon {
  width: 70px;
  height: 70px;
  display: grid;
  place-items: center;
  margin: 0 auto 15px;
  border-radius: 20px;
  background: #f3e8ff;
  color: #7c3aed;
  font-size: 27px;
}

.coupon-empty h3 {
  margin: 0 0 5px;
  color: #35105f;
  font-weight: 900;
}

.coupon-empty p {
  margin: 0 0 20px;
  color: #777;
}


@media (max-width: 1100px) {
  .coupon-info-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .coupon-page-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .coupon-page-header h1 {
    font-size: 30px;
  }

  .coupon-info-grid {
    grid-template-columns: 1fr;
  }

  .coupon-admin-page {
    padding-right: 0;
  }
}

</style>