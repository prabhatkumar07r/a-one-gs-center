<% content_for :show_layout, true %>

<style>
/* =========================================================
   ADMIN COURSE DETAILS
========================================================= */

.course-details-page {
  min-height: calc(100vh - 70px);
  padding: 30px;
  background:
    radial-gradient(
      circle at top right,
      rgba(99, 102, 241, 0.12),
      transparent 35%
    ),
    #f8fafc;
}

/* =========================================================
   HEADER
========================================================= */

.course-details-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 25px;
}

.course-details-title {
  margin: 0;
  color: #111827;
  font-size: 28px;
  font-weight: 800;
}

.course-details-subtitle {
  margin: 6px 0 0;
  color: #64748b;
  font-size: 14px;
}

.course-header-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

/* =========================================================
   MAIN CARD
========================================================= */

.course-main-card {
  overflow: hidden;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(226, 232, 240, 0.9);
  border-radius: 18px;
  box-shadow:
    0 12px 35px rgba(15, 23, 42, 0.08);
}

/* =========================================================
   COURSE HERO
========================================================= */

.course-hero {
  position: relative;
  padding: 30px;
  color: #fff;
  background:
    linear-gradient(
      135deg,
      #312e81,
      #4f46e5 55%,
      #2563eb
    );
}

.course-hero::after {
  content: "";

  position: absolute;

  width: 220px;
  height: 220px;

  right: -70px;
  top: -80px;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.08);
}

.course-hero-content {
  position: relative;
  z-index: 2;
}

.course-label {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  margin-bottom: 12px;
  padding: 6px 11px;

  background: rgba(255, 255, 255, 0.14);

  border: 1px solid rgba(255, 255, 255, 0.18);

  border-radius: 20px;

  font-size: 11px;
  font-weight: 700;

  text-transform: uppercase;
  letter-spacing: .6px;
}

.course-name {
  margin: 0;

  font-size: 30px;
  font-weight: 800;

  line-height: 1.25;
}

.course-id {
  margin-top: 8px;

  color: rgba(255, 255, 255, 0.75);

  font-size: 13px;
}

/* =========================================================
   COURSE INFORMATION
========================================================= */

.course-info-section {
  padding: 30px;
}

.course-info-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 16px;
}

.course-info-item {
  padding: 18px;

  background: #f8fafc;

  border: 1px solid #e2e8f0;

  border-radius: 13px;

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease;
}

.course-info-item:hover {
  transform: translateY(-3px);

  border-color: #c7d2fe;

  box-shadow:
    0 8px 22px rgba(15, 23, 42, .07);
}

.course-info-icon {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 12px;

  border-radius: 10px;

  background: #eef2ff;

  color: #4f46e5;

  font-size: 17px;
}

.course-info-label {
  margin-bottom: 4px;

  color: #64748b;

  font-size: 12px;
  font-weight: 600;

  text-transform: uppercase;
  letter-spacing: .4px;
}

.course-info-value {
  color: #111827;

  font-size: 16px;
  font-weight: 750;
}

/* =========================================================
   TEACHER
========================================================= */

.teacher-section {
  margin-top: 25px;

  padding: 22px;

  background: #ffffff;

  border: 1px solid #e2e8f0;

  border-radius: 14px;
}

.teacher-section-title {
  margin-bottom: 15px;

  color: #111827;

  font-size: 16px;
  font-weight: 800;
}

.teacher-box {
  display: flex;
  align-items: center;
  gap: 14px;
}

.teacher-avatar {
  width: 48px;
  height: 48px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #4f46e5,
      #7c3aed
    );

  color: #fff;

  font-size: 18px;
  font-weight: 800;
}

.teacher-name {
  color: #111827;

  font-size: 15px;
  font-weight: 750;
}

.teacher-role {
  margin-top: 3px;

  color: #64748b;

  font-size: 12px;
}

/* =========================================================
   QUICK ACTIONS
========================================================= */

.quick-actions {
  margin-top: 25px;
}

.quick-actions-title {
  margin-bottom: 15px;

  color: #111827;

  font-size: 18px;
  font-weight: 800;
}

.quick-actions-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 14px;
}

.quick-action {
  display: flex;
  align-items: center;
  gap: 12px;

  padding: 17px;

  background: #fff;

  border: 1px solid #e2e8f0;

  border-radius: 13px;

  color: #1e293b;

  text-decoration: none;

  transition:
    transform .2s ease,
    border-color .2s ease,
    box-shadow .2s ease;
}

.quick-action:hover {
  transform: translateY(-3px);

  color: #4f46e5;

  border-color: #c7d2fe;

  box-shadow:
    0 8px 25px rgba(15, 23, 42, .08);
}

.quick-action-icon {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex: 0 0 42px;

  border-radius: 11px;

  background: #eef2ff;

  color: #4f46e5;

  font-size: 18px;
}

.quick-action-text {
  min-width: 0;
}

.quick-action-text strong {
  display: block;

  color: #111827;

  font-size: 14px;
}

.quick-action-text small {
  display: block;

  margin-top: 3px;

  color: #64748b;

  font-size: 11px;
}

/* =========================================================
   STATUS
========================================================= */

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  padding: 6px 11px;

  border-radius: 20px;

  font-size: 12px;
  font-weight: 700;

  text-transform: capitalize;
}

.status-active {
  background: #dcfce7;
  color: #166534;
}

.status-inactive {
  background: #fee2e2;
  color: #991b1b;
}

/* =========================================================
   BUTTONS
========================================================= */

.course-btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  padding: 9px 14px;

  border-radius: 9px;

  font-size: 13px;
  font-weight: 700;

  text-decoration: none;

  transition: .2s ease;
}

.course-btn:hover {
  transform: translateY(-1px);
}

.course-btn-primary {
  background: #4f46e5;
  color: #fff;
}

.course-btn-primary:hover {
  background: #4338ca;
  color: #fff;
}

.course-btn-light {
  background: #fff;

  color: #334155;

  border: 1px solid #cbd5e1;
}

.course-btn-light:hover {
  background: #f8fafc;
  color: #111827;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1100px) {

  .course-info-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .quick-actions-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 768px) {

  .course-details-page {
    padding: 20px 15px;
  }

  .course-details-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .course-details-title {
    font-size: 23px;
  }

  .course-header-actions {
    width: 100%;
  }

  .course-header-actions .course-btn {
    flex: 1;
    justify-content: center;
  }

  .course-hero {
    padding: 24px 20px;
  }

  .course-name {
    font-size: 23px;
  }

  .course-info-section {
    padding: 20px;
  }

  .course-info-grid {
    grid-template-columns: 1fr;
  }

  .quick-actions-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 420px) {

  .course-header-actions {
    flex-direction: column;
  }

  .course-header-actions .course-btn {
    width: 100%;
  }
}
</style>


<div class="course-details-page">

  <!-- =====================================================
       PAGE HEADER
  ====================================================== -->

  <div class="course-details-header">

    <div>

      <h1 class="course-details-title">
        Course Details
      </h1>

      <p class="course-details-subtitle">
        View and manage complete course information.
      </p>

    </div>


    <div class="course-header-actions">

      <%= link_to admin_courses_path,
          class: "course-btn course-btn-light" do %>

        <i class="bi bi-arrow-left"></i>

        Back to Courses

      <% end %>


      <%= link_to edit_admin_course_path(@course),
          class: "course-btn course-btn-primary" do %>

        <i class="bi bi-pencil-square"></i>

        Edit Course

      <% end %>

    </div>

  </div>


  <!-- =====================================================
       MAIN CARD
  ====================================================== -->

  <div class="course-main-card">


    <!-- ===================================================
         COURSE HERO
    ==================================================== -->

    <div class="course-hero">

      <div class="course-hero-content">

        <div class="course-label">

          <i class="bi bi-book-fill"></i>

          Course

        </div>


        <h2 class="course-name">

          <%= @course.Course_name %>

        </h2>


        <div class="course-id">

          Course ID:
          #<%= @course.id %>

        </div>

      </div>

    </div>


    <!-- ===================================================
         COURSE INFORMATION
    ==================================================== -->

    <div class="course-info-section">

      <div class="course-info-grid">


        <!-- DURATION -->

        <div class="course-info-item">

          <div class="course-info-icon">

            <i class="bi bi-clock-history"></i>

          </div>

          <div class="course-info-label">
            Duration
          </div>

          <div class="course-info-value">

            <%= @course.duration.presence || "Not specified" %>

          </div>

        </div>


        <!-- FEE -->

        <div class="course-info-item">

          <div class="course-info-icon">

            <i class="bi bi-currency-rupee"></i>

          </div>

          <div class="course-info-label">
            Course Fee
          </div>

          <div class="course-info-value">

            ₹<%= @course.fee.presence || "0" %>

          </div>

        </div>


        <!-- STATUS -->

        <div class="course-info-item">

          <div class="course-info-icon">

            <i class="bi bi-toggle-on"></i>

          </div>

          <div class="course-info-label">
            Status
          </div>

          <div class="course-info-value">

            <% if @course.status.to_s.downcase == "active" %>

              <span class="status-badge status-active">

                <i class="bi bi-check-circle-fill"></i>

                Active

              </span>

            <% else %>

              <span class="status-badge status-inactive">

                <i class="bi bi-x-circle-fill"></i>

                <%= @course.status.presence || "Inactive" %>

              </span>

            <% end %>

          </div>

        </div>


        <!-- CREATED -->

        <div class="course-info-item">

          <div class="course-info-icon">

            <i class="bi bi-calendar3"></i>

          </div>

          <div class="course-info-label">
            Created
          </div>

          <div class="course-info-value">

            <%= @course.created_at.strftime("%d %b %Y") %>

          </div>

        </div>


      </div>


      <!-- =================================================
           TEACHER
      ================================================== -->

      <div class="teacher-section">

        <div class="teacher-section-title">

          <i class="bi bi-person-badge me-1"></i>

          Assigned Teacher

        </div>


        <div class="teacher-box">

          <div class="teacher-avatar">

            <%= @course.teacher&.name.to_s.first&.upcase || "T" %>

          </div>


          <div>

            <div class="teacher-name">

              <%= @course.teacher&.name || "Not Assigned" %>

            </div>


            <div class="teacher-role">

              Course Instructor

            </div>

          </div>

        </div>

      </div>


      <!-- =================================================
           QUICK ACTIONS
      ================================================== -->

      <div class="quick-actions">

        <div class="quick-actions-title">

          Course Management

        </div>


        <div class="quick-actions-grid">


          <!-- QUIZZES -->

          <%= link_to admin_course_quizzes_path(@course),
              class: "quick-action" do %>

            <div class="quick-action-icon">

              <i class="bi bi-patch-question-fill"></i>

            </div>

            <div class="quick-action-text">

              <strong>Quizzes</strong>

              <small>
                Manage course quizzes
              </small>

            </div>

          <% end %>


          <!-- PLAYLISTS -->

          <%= link_to admin_course_playlists_path(@course),
              class: "quick-action" do %>

            <div class="quick-action-icon">

              <i class="bi bi-collection-play-fill"></i>

            </div>

            <div class="quick-action-text">

              <strong>Playlists</strong>

              <small>
                Manage course playlists
              </small>

            </div>

          <% end %>


          <!-- STUDENTS -->

          <%= link_to admin_course_students_path(@course),
              class: "quick-action" do %>

            <div class="quick-action-icon">

              <i class="bi bi-people-fill"></i>

            </div>

            <div class="quick-action-text">

              <strong>Students</strong>

              <small>
                View enrolled students
              </small>

            </div>

          <% end %>


          <!-- EDIT -->

          <%= link_to edit_admin_course_path(@course),
              class: "quick-action" do %>

            <div class="quick-action-icon">

              <i class="bi bi-pencil-square"></i>

            </div>

            <div class="quick-action-text">

              <strong>Edit Course</strong>

              <small>
                Update course information
              </small>

            </div>

          <% end %>


        </div>

      </div>


    </div>

  </div>

</div>


<script>
document.addEventListener("turbo:load", function () {

  const cards =
    document.querySelectorAll(".course-info-item");

  cards.forEach(function (card) {

    card.addEventListener("mouseenter", function () {
      card.style.transform = "translateY(-3px)";
    });

    card.addEventListener("mouseleave", function () {
      card.style.transform = "";
    });

  });


  /*
   * Smooth click feedback
   */

  document
    .querySelectorAll(".quick-action, .course-btn")
    .forEach(function (link) {

      link.addEventListener("click", function () {

        link.style.transform = "scale(.98)";

        setTimeout(function () {
          link.style.transform = "";
        }, 120);

      });

    });

});
</script>