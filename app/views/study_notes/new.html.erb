<% content_for :hide_footer, true %>

<div class="study-note-upload-page">

  <!-- =====================================================
       BACKGROUND DECORATION
  ====================================================== -->

  <div class="glass-orb orb-one"></div>
  <div class="glass-orb orb-two"></div>
  <div class="glass-orb orb-three"></div>


  <!-- =====================================================
       FLOATING EDUCATION OBJECTS
  ====================================================== -->

  <div class="floating-object object-book">
    📚
  </div>

  <div class="floating-object object-pdf">
    📄
  </div>

  <div class="floating-object object-video">
    🎥
  </div>

  <div class="floating-object object-pencil">
    ✏️
  </div>


  <!-- =====================================================
       MAIN CONTAINER
  ====================================================== -->

  <div class="study-note-container">


    <!-- ===================================================
         HEADER
    ==================================================== -->

    <div class="study-note-heading">

      <div class="heading-icon">
        <i class="fas fa-book-open"></i>
      </div>

      <div>

        <span class="heading-kicker">
          A ONE GS CENTER
        </span>

        <h1>
          Upload Study Notes
        </h1>

        <p>
          Attach notes directly to a specific video lecture.
        </p>

      </div>

    </div>


    <!-- ===================================================
         ERROR MESSAGE
    ==================================================== -->

    <% if @note.errors.any? %>

      <div class="glass-error">

        <div class="error-icon">
          ⚠️
        </div>

        <div>

          <strong>
            <%= pluralize(
              @note.errors.count,
              "error"
            ) %>
            prevented this note from being saved.
          </strong>

          <ul>

            <% @note.errors.full_messages.each do |message| %>

              <li>
                <%= message %>
              </li>

            <% end %>

          </ul>

        </div>

      </div>

    <% end %>


    <!-- ===================================================
         GLASS CARD
    ==================================================== -->

    <div class="study-note-glass-card">


      <!-- ===============================================
           CARD TOP
      ================================================ -->

      <div class="glass-card-top">

        <div>

          <span class="section-label">
            VIDEO-WISE NOTES
          </span>

          <h2>
            Create Lecture Notes
          </h2>

          <p>
            Select the course, playlist and lecture
            before uploading your PDF.
          </p>

        </div>

        <div class="card-3d-icon">
          📖
        </div>

      </div>


      <%= form_with model: @note,
                    url: study_notes_path,
                    local: true,
                    multipart: true,
                    data: {
                      study_notes_form: true
                    } do |f| %>


        <!-- =============================================
             COURSE
        ============================================== -->

        <div class="form-section">

          <label
            for="course_select"
            class="glass-label">

            <span class="label-icon">
              🎓
            </span>

            Course

          </label>


          <select
            id="course_select"
            class="glass-select">

            <option value="">
              Select Course
            </option>

            <% @courses.each do |course| %>

              <option
                value="<%= course.id %>"
                <%= "selected" if
                    @note.video&.course_id == course.id %>>

                <%= course.Course_name %>

              </option>

            <% end %>

          </select>

          <div class="field-help">
            Choose the course containing the lecture.
          </div>

        </div>


        <!-- =============================================
             PLAYLIST
        ============================================== -->

        <div class="form-section">

          <label
            for="playlist_select"
            class="glass-label">

            <span class="label-icon">
              📂
            </span>

            Playlist

          </label>


          <%= f.select :playlist_id,

              [],

              {
                prompt: "Select Playlist"
              },

              {
                class: "glass-select",
                id: "playlist_select",
                required: true,
                disabled: @note.playlist_id.blank?
              } %>


          <div class="field-help">
            Select the playlist containing the lecture.
          </div>

        </div>


        <!-- =============================================
             VIDEO
        ============================================== -->

        <div class="form-section">

          <label
            for="video_select"
            class="glass-label">

            <span class="label-icon">
              🎥
            </span>

            Video / Lecture

          </label>


          <%= f.select :video_id,

              [],

              {
                prompt: "Select Video / Lecture"
              },

              {
                class: "glass-select",
                id: "video_select",
                required: true,
                disabled: @note.video_id.blank?
              } %>


          <div class="field-help">
            Your PDF will be attached to this specific lecture.
          </div>

        </div>


        <!-- =============================================
             VIDEO PREVIEW
        ============================================== -->

        <div
          id="video_preview"
          class="video-preview-card"
          hidden>

          <div class="video-preview-thumbnail">

            <img
              id="video_thumbnail"
              src=""
              alt="Video thumbnail">

            <div class="play-overlay">
              ▶
            </div>

          </div>

          <div class="video-preview-content">

            <span class="preview-kicker">
              SELECTED LECTURE
            </span>

            <h3 id="video_preview_title">
              Video title
            </h3>

            <p id="video_preview_position">
              Lecture
            </p>

          </div>

        </div>


        <!-- =============================================
             NOTE TITLE
        ============================================== -->

        <div class="form-section">

          <label
            for="note_title"
            class="glass-label">

            <span class="label-icon">
              📝
            </span>

            Note Title

          </label>


          <%= f.text_field :title,

              class: "glass-input",

              id: "note_title",

              placeholder:
                "Example: Indus Valley Civilization Notes",

              required: true %>


          <div class="field-help">
            Give your study material a clear title.
          </div>

        </div>


        <!-- =============================================
             DESCRIPTION
        ============================================== -->

        <div class="form-section">

          <label
            for="note_description"
            class="glass-label">

            <span class="label-icon">
              💡
            </span>

            Description

          </label>


          <%= f.text_area :description,

              rows: 4,

              class: "glass-input glass-textarea",

              id: "note_description",

              placeholder:
                "Enter a short description of these notes..." %>

        </div>


        <!-- =============================================
             PDF UPLOAD
        ============================================== -->

        <div class="form-section">

          <label
            for="note_pdf_file"
            class="glass-label">

            <span class="label-icon">
              📄
            </span>

            Study Notes PDF

          </label>


          <div
            class="pdf-drop-zone"
            id="pdf_drop_zone">


            <div class="pdf-upload-icon">
              📄
            </div>


            <div class="pdf-upload-text">

              <strong>
                Choose your PDF
              </strong>

              <span>
                or drag & drop it here
              </span>

            </div>


            <div class="pdf-upload-limit">
              PDF only • Maximum 10 MB
            </div>


            <%= f.file_field :pdf_file,

                class: "pdf-file-input",

                id: "note_pdf_file",

                accept: "application/pdf",

                required: true %>


            <div
              id="selected_pdf_name"
              class="selected-pdf-name"
              hidden>
            </div>

          </div>

        </div>


        <!-- =============================================
             ACTIONS
        ============================================== -->

        <div class="form-actions">

          <%= link_to study_notes_path,
                class: "glass-btn glass-btn-back" do %>

            <span>
              ←
            </span>

            Back

          <% end %>


          <%= f.submit "Upload Study Notes",

              class:
                "glass-btn glass-btn-upload",

              id:
                "upload_notes_button" %>

        </div>


      <% end %>

    </div>


    <!-- =================================================
         BOTTOM INFO
    ================================================== -->

    <div class="upload-info-row">

      <div class="info-pill">
        🔒 Secure PDF Storage
      </div>

      <div class="info-pill">
        🎥 Video-wise Notes
      </div>

      <div class="info-pill">
        📄 PDF up to 10MB
      </div>

    </div>


  </div>

</div>


<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   RESET
========================================================= */

.study-note-upload-page,
.study-note-upload-page * {
  box-sizing: border-box;
}


/* =========================================================
   PAGE
========================================================= */

.study-note-upload-page {

  position: relative;

  min-height: 100vh;

  overflow: hidden;

  padding: 55px 20px 80px;

  background:
    radial-gradient(
      circle at 10% 20%,
      rgba(168, 85, 247, .45),
      transparent 32%
    ),
    radial-gradient(
      circle at 90% 10%,
      rgba(59, 130, 246, .35),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      #18002f,
      #3b0878 45%,
      #140026
    );

  font-family:
    "Poppins",
    system-ui,
    sans-serif;

}


/* =========================================================
   ORBS
========================================================= */

.glass-orb {

  position: absolute;

  border-radius: 50%;

  filter: blur(2px);

  opacity: .5;

  pointer-events: none;

}

.orb-one {

  width: 260px;
  height: 260px;

  top: 5%;
  left: -100px;

  background:
    radial-gradient(
      circle at 35% 30%,
      rgba(255,255,255,.4),
      rgba(168,85,247,.15),
      transparent 70%
    );

}

.orb-two {

  width: 330px;
  height: 330px;

  right: -140px;
  top: 30%;

  background:
    radial-gradient(
      circle at 35% 30%,
      rgba(255,255,255,.3),
      rgba(59,130,246,.15),
      transparent 70%
    );

}

.orb-three {

  width: 200px;
  height: 200px;

  bottom: -80px;
  left: 25%;

  background:
    radial-gradient(
      circle,
      rgba(217,70,239,.3),
      transparent 70%
    );

}


/* =========================================================
   FLOATING OBJECTS
========================================================= */

.floating-object {

  position: absolute;

  display: flex;

  align-items: center;
  justify-content: center;

  width: 72px;
  height: 72px;

  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.22),
      rgba(255,255,255,.05)
    );

  border:
    1px solid rgba(255,255,255,.22);

  box-shadow:
    0 20px 45px rgba(0,0,0,.25),
    inset 0 1px 1px rgba(255,255,255,.3);

  backdrop-filter: blur(16px);

  font-size: 34px;

  transform:
    perspective(700px)
    rotateX(12deg)
    rotateY(-12deg);

  animation:
    floatingObject 5s ease-in-out infinite;

  z-index: 1;

}

.object-book {

  top: 15%;
  left: 4%;

}

.object-pdf {

  top: 65%;
  left: 6%;

  animation-delay: -1.5s;

}

.object-video {

  top: 20%;
  right: 5%;

  animation-delay: -2.5s;

}

.object-pencil {

  bottom: 12%;
  right: 7%;

  animation-delay: -3.5s;

}


@keyframes floatingObject {

  0%,
  100% {

    transform:
      perspective(700px)
      translateY(0)
      rotateX(12deg)
      rotateY(-12deg);

  }

  50% {

    transform:
      perspective(700px)
      translateY(-18px)
      rotateX(18deg)
      rotateY(8deg);

  }

}


/* =========================================================
   MAIN CONTAINER
========================================================= */

.study-note-container {

  position: relative;

  z-index: 5;

  width: min(920px, 100%);

  margin: 0 auto;

}


/* =========================================================
   HEADING
========================================================= */

.study-note-heading {

  display: flex;

  align-items: center;

  gap: 20px;

  margin-bottom: 28px;

  color: white;

}

.heading-icon {

  width: 70px;
  height: 70px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.28),
      rgba(255,255,255,.08)
    );

  border:
    1px solid rgba(255,255,255,.25);

  box-shadow:
    0 18px 40px rgba(0,0,0,.25),
    inset 0 1px 1px rgba(255,255,255,.35);

  backdrop-filter: blur(18px);

  font-size: 29px;

}

.heading-kicker {

  display: block;

  margin-bottom: 4px;

  font-size: 11px;

  letter-spacing: 2px;

  text-transform: uppercase;

  opacity: .65;

}

.study-note-heading h1 {

  margin: 0;

  font-size: clamp(28px, 5vw, 42px);

  font-weight: 800;

  letter-spacing: -.8px;

}

.study-note-heading p {

  margin: 5px 0 0;

  color: rgba(255,255,255,.68);

}


/* =========================================================
   ERROR
========================================================= */

.glass-error {

  display: flex;

  gap: 14px;

  margin-bottom: 22px;

  padding: 18px;

  color: white;

  border-radius: 18px;

  background:
    rgba(220,38,38,.18);

  border:
    1px solid rgba(248,113,113,.35);

  backdrop-filter: blur(16px);

}

.error-icon {

  font-size: 25px;

}

.glass-error ul {

  margin:
    8px 0 0;

  padding-left: 20px;

}


/* =========================================================
   GLASS CARD
========================================================= */

.study-note-glass-card {

  position: relative;

  overflow: hidden;

  padding: clamp(24px, 5vw, 42px);

  border-radius: 32px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.19),
      rgba(255,255,255,.06)
    );

  border:
    1px solid rgba(255,255,255,.22);

  box-shadow:
    0 35px 80px rgba(0,0,0,.35),
    inset 0 1px 1px rgba(255,255,255,.28);

  backdrop-filter:
    blur(25px);

}

.study-note-glass-card::before {

  content: "";

  position: absolute;

  width: 400px;
  height: 400px;

  top: -260px;
  right: -200px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(255,255,255,.14),
      transparent 70%
    );

  pointer-events: none;

}


/* =========================================================
   CARD TOP
========================================================= */

.glass-card-top {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

  margin-bottom: 35px;

  color: white;

}

.section-label {

  font-size: 10px;

  letter-spacing: 2px;

  font-weight: 700;

  color: rgba(255,255,255,.55);

}

.glass-card-top h2 {

  margin: 5px 0;

  font-size: 26px;

  font-weight: 750;

}

.glass-card-top p {

  margin: 0;

  color: rgba(255,255,255,.62);

  font-size: 14px;

}

.card-3d-icon {

  flex-shrink: 0;

  width: 78px;
  height: 78px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 25px;

  font-size: 40px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.23),
      rgba(255,255,255,.04)
    );

  box-shadow:
    0 18px 30px rgba(0,0,0,.2),
    inset 0 1px 2px rgba(255,255,255,.3);

  transform:
    perspective(500px)
    rotateY(-12deg)
    rotateX(8deg);

}


/* =========================================================
   FORM
========================================================= */

.form-section {

  margin-bottom: 24px;

}

.glass-label {

  display: flex;

  align-items: center;

  gap: 9px;

  margin-bottom: 9px;

  color: white;

  font-size: 14px;

  font-weight: 650;

}

.label-icon {

  font-size: 17px;

}

.glass-select,
.glass-input {

  width: 100%;

  min-height: 54px;

  padding: 14px 16px;

  border-radius: 16px;

  border:
    1px solid rgba(255,255,255,.18);

  outline: none;

  background:
    rgba(10,4,25,.32);

  color: white;

  font-family: inherit;

  font-size: 14px;

  box-shadow:
    inset 0 1px 1px rgba(255,255,255,.07),
    0 8px 20px rgba(0,0,0,.08);

  transition:
    border-color .25s ease,
    box-shadow .25s ease,
    transform .25s ease;

}

.glass-select:focus,
.glass-input:focus {

  border-color:
    rgba(255,255,255,.55);

  box-shadow:
    0 0 0 4px rgba(255,255,255,.06),
    0 15px 30px rgba(0,0,0,.15);

  transform:
    translateY(-1px);

}

.glass-select:disabled {

  cursor: not-allowed;

  opacity: .5;

}

.glass-select option {

  background: #281044;

  color: white;

}

.glass-input::placeholder {

  color:
    rgba(255,255,255,.4);

}

.glass-textarea {

  resize: vertical;

  min-height: 120px;

}

.field-help {

  margin-top: 6px;

  color:
    rgba(255,255,255,.43);

  font-size: 11px;

}


/* =========================================================
   VIDEO PREVIEW
========================================================= */

.video-preview-card {

  display: flex;

  gap: 18px;

  align-items: center;

  margin:
    -4px 0 25px;

  padding: 14px;

  border-radius: 20px;

  background:
    rgba(0,0,0,.20);

  border:
    1px solid rgba(255,255,255,.15);

  box-shadow:
    inset 0 1px 1px rgba(255,255,255,.08);

}

.video-preview-thumbnail {

  position: relative;

  flex-shrink: 0;

  width: 150px;

  height: 84px;

  overflow: hidden;

  border-radius: 13px;

  background: rgba(0,0,0,.3);

}

.video-preview-thumbnail img {

  width: 100%;
  height: 100%;

  object-fit: cover;

}

.play-overlay {

  position: absolute;

  inset: 0;

  display: flex;

  align-items: center;
  justify-content: center;

  background:
    rgba(0,0,0,.20);

  color: white;

  font-size: 25px;

}

.video-preview-content {

  min-width: 0;

  color: white;

}

.preview-kicker {

  font-size: 9px;

  letter-spacing: 1.5px;

  opacity: .5;

}

.video-preview-content h3 {

  margin: 4px 0;

  font-size: 16px;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;

}

.video-preview-content p {

  margin: 0;

  color:
    rgba(255,255,255,.55);

  font-size: 12px;

}


/* =========================================================
   PDF DROP ZONE
========================================================= */

.pdf-drop-zone {

  position: relative;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  min-height: 190px;

  padding: 25px;

  text-align: center;

  border-radius: 22px;

  border:
    1.5px dashed rgba(255,255,255,.3);

  background:
    rgba(255,255,255,.045);

  transition:
    .25s ease;

  cursor: pointer;

}

.pdf-drop-zone:hover,
.pdf-drop-zone.drag-over {

  background:
    rgba(255,255,255,.09);

  border-color:
    rgba(255,255,255,.65);

  transform:
    translateY(-2px);

  box-shadow:
    0 18px 40px rgba(0,0,0,.15);

}

.pdf-upload-icon {

  width: 62px;
  height: 62px;

  display: flex;

  align-items: center;
  justify-content: center;

  margin-bottom: 12px;

  border-radius: 19px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.22),
      rgba(255,255,255,.06)
    );

  box-shadow:
    0 12px 25px rgba(0,0,0,.2);

  font-size: 28px;

}

.pdf-upload-text {

  display: flex;

  flex-direction: column;

  color: white;

}

.pdf-upload-text strong {

  font-size: 15px;

}

.pdf-upload-text span {

  margin-top: 3px;

  color:
    rgba(255,255,255,.5);

  font-size: 12px;

}

.pdf-upload-limit {

  margin-top: 10px;

  color:
    rgba(255,255,255,.35);

  font-size: 10px;

}

.pdf-file-input {

  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  opacity: 0;

  cursor: pointer;

}

.selected-pdf-name {

  margin-top: 12px;

  padding: 8px 14px;

  border-radius: 30px;

  background:
    rgba(34,197,94,.15);

  border:
    1px solid rgba(134,239,172,.25);

  color:
    #dcfce7;

  font-size: 11px;

}


/* =========================================================
   ACTIONS
========================================================= */

.form-actions {

  display: flex;

  justify-content: space-between;

  gap: 15px;

  margin-top: 35px;

}

.glass-btn {

  min-height: 52px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 9px;

  padding:
    12px 23px;

  border-radius: 15px;

  text-decoration: none;

  border:
    1px solid rgba(255,255,255,.18);

  font-family: inherit;

  font-size: 13px;

  font-weight: 650;

  cursor: pointer;

  transition:
    .25s ease;

}

.glass-btn-back {

  color: white;

  background:
    rgba(255,255,255,.07);

}

.glass-btn-back:hover {

  color: white;

  background:
    rgba(255,255,255,.13);

  transform:
    translateY(-2px);

}

.glass-btn-upload {

  color: white;

  background:
    linear-gradient(
      135deg,
      rgba(168,85,247,.85),
      rgba(79,70,229,.85)
    );

  box-shadow:
    0 12px 30px rgba(79,70,229,.25),
    inset 0 1px 1px rgba(255,255,255,.25);

}

.glass-btn-upload:hover {

  transform:
    translateY(-3px);

  box-shadow:
    0 18px 40px rgba(79,70,229,.35),
    inset 0 1px 1px rgba(255,255,255,.3);

}


/* =========================================================
   INFO PILLS
========================================================= */

.upload-info-row {

  display: flex;

  justify-content: center;

  flex-wrap: wrap;

  gap: 10px;

  margin-top: 22px;

}

.info-pill {

  padding:
    8px 14px;

  border-radius: 30px;

  color:
    rgba(255,255,255,.6);

  background:
    rgba(255,255,255,.055);

  border:
    1px solid rgba(255,255,255,.1);

  backdrop-filter:
    blur(10px);

  font-size: 10px;

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

  .study-note-upload-page {

    padding:
      30px 12px 50px;

  }

  .study-note-heading {

    align-items: flex-start;

  }

  .heading-icon {

    width: 55px;
    height: 55px;

    flex-shrink: 0;

  }

  .study-note-heading h1 {

    font-size: 27px;

  }

  .study-note-heading p {

    font-size: 12px;

  }

  .study-note-glass-card {

    padding:
      22px 17px;

    border-radius: 24px;

  }

  .glass-card-top {

    align-items: flex-start;

  }

  .card-3d-icon {

    width: 55px;
    height: 55px;

    font-size: 27px;

  }

  .glass-card-top h2 {

    font-size: 21px;

  }

  .glass-card-top p {

    font-size: 12px;

  }

  .video-preview-card {

    align-items: flex-start;

  }

  .video-preview-thumbnail {

    width: 105px;
    height: 65px;

  }

  .video-preview-content h3 {

    font-size: 13px;

    white-space: normal;

  }

  .form-actions {

    flex-direction: column-reverse;

  }

  .glass-btn {

    width: 100%;

  }

  .floating-object {

    display: none;

  }

}

</style>


<script nonce="<%= content_security_policy_nonce %>">

(function () {

  "use strict";


  /* =======================================================
     INITIALIZE
  ======================================================== */

  function initializeStudyNotesForm() {

    const courseSelect =
      document.getElementById(
        "course_select"
      );

    const playlistSelect =
      document.getElementById(
        "playlist_select"
      );

    const videoSelect =
      document.getElementById(
        "video_select"
      );

    const videoPreview =
      document.getElementById(
        "video_preview"
      );

    const videoThumbnail =
      document.getElementById(
        "video_thumbnail"
      );

    const videoTitle =
      document.getElementById(
        "video_preview_title"
      );

    const videoPosition =
      document.getElementById(
        "video_preview_position"
      );

    const pdfInput =
      document.getElementById(
        "note_pdf_file"
      );

    const pdfDropZone =
      document.getElementById(
        "pdf_drop_zone"
      );

    const pdfName =
      document.getElementById(
        "selected_pdf_name"
      );


    if (
      !courseSelect ||
      !playlistSelect ||
      !videoSelect
    ) {
      return;
    }


    /* =====================================================
       PREVENT DUPLICATE INITIALIZATION
    ====================================================== */

    if (
      courseSelect.dataset.initialized === "true"
    ) {
      return;
    }

    courseSelect.dataset.initialized = "true";


    /* =====================================================
       HELPER — RESET SELECT
    ====================================================== */

    function resetSelect(
      select,
      text
    ) {

      select.innerHTML =
        "";

      const option =
        document.createElement(
          "option"
        );

      option.value =
        "";

      option.textContent =
        text;

      select.appendChild(
        option
      );

      select.disabled =
        true;

    }


    /* =====================================================
       HELPER — LOAD PLAYLISTS
    ====================================================== */

    function loadPlaylists(
      courseId
    ) {

      resetSelect(
        playlistSelect,
        "Loading playlists..."
      );

      resetSelect(
        videoSelect,
        "Select Video / Lecture"
      );


      if (!courseId) {

        resetSelect(
          playlistSelect,
          "Select Playlist"
        );

        return;

      }


      fetch(
        "/study_notes/playlists?course_id=" +
        encodeURIComponent(courseId),
        {
          headers: {
            "Accept":
              "application/json"
          }
        }
      )

      .then(function (response) {

        if (!response.ok) {

          throw new Error(
            "Unable to load playlists"
          );

        }

        return response.json();

      })

      .then(function (data) {

        if (
          !document.documentElement
            .contains(playlistSelect)
        ) {
          return;
        }


        resetSelect(
          playlistSelect,
          "Select Playlist"
        );


        if (
          !Array.isArray(data) ||
          data.length === 0
        ) {

          resetSelect(
            playlistSelect,
            "No playlists found"
          );

          return;

        }


        data.forEach(
          function (item) {

            const option =
              document.createElement(
                "option"
              );

            option.value =
              item.id;

            option.textContent =
              item.title;

            playlistSelect.appendChild(
              option
            );

          }
        );


        playlistSelect.disabled =
          false;

      })

      .catch(function (error) {

        console.error(
          "Playlist loading error:",
          error
        );


        resetSelect(
          playlistSelect,
          "Unable to load playlists"
        );

      });

    }


    /* =====================================================
       HELPER — LOAD VIDEOS
    ====================================================== */

    function loadVideos(
      playlistId
    ) {

      resetSelect(
        videoSelect,
        "Loading videos..."
      );


      if (!playlistId) {

        resetSelect(
          videoSelect,
          "Select Video / Lecture"
        );

        hideVideoPreview();

        return;

      }


      fetch(
        "/study_notes/videos?playlist_id=" +
        encodeURIComponent(playlistId),
        {
          headers: {
            "Accept":
              "application/json"
          }
        }
      )

      .then(function (response) {

        if (!response.ok) {

          throw new Error(
            "Unable to load videos"
          );

        }

        return response.json();

      })

      .then(function (data) {

        if (
          !document.documentElement
            .contains(videoSelect)
        ) {
          return;
        }


        resetSelect(
          videoSelect,
          "Select Video / Lecture"
        );


        if (
          !Array.isArray(data) ||
          data.length === 0
        ) {

          resetSelect(
            videoSelect,
            "No active videos found"
          );

          hideVideoPreview();

          return;

        }


        data.forEach(
          function (item) {

            const option =
              document.createElement(
                "option"
              );

            option.value =
              item.id;

            option.textContent =
              item.position +
              ". " +
              item.title;

            option.dataset.title =
              item.title;

            option.dataset.position =
              item.position;

            option.dataset.thumbnail =
              item.thumbnail || "";

            videoSelect.appendChild(
              option
            );

          }
        );


        videoSelect.disabled =
          false;

      })

      .catch(function (error) {

        console.error(
          "Video loading error:",
          error
        );


        resetSelect(
          videoSelect,
          "Unable to load videos"
        );

        hideVideoPreview();

      });

    }


    /* =====================================================
       COURSE CHANGE
    ====================================================== */

    courseSelect.addEventListener(
      "change",
      function () {

        loadPlaylists(
          this.value
        );

      }
    );


    /* =====================================================
       PLAYLIST CHANGE
    ====================================================== */

    playlistSelect.addEventListener(
      "change",
      function () {

        loadVideos(
          this.value
        );

      }
    );


    /* =====================================================
       VIDEO CHANGE
    ====================================================== */

    videoSelect.addEventListener(
      "change",
      function () {

        const selected =
          this.options[
            this.selectedIndex
          ];


        if (
          !selected ||
          !selected.value
        ) {

          hideVideoPreview();

          return;

        }


        const title =
          selected.dataset.title ||
          selected.textContent;

        const position =
          selected.dataset.position ||
          "";

        const thumbnail =
          selected.dataset.thumbnail ||
          "";


        videoTitle.textContent =
          title;

        videoPosition.textContent =
          "Lecture " +
          position;


        if (thumbnail) {

          videoThumbnail.src =
            thumbnail;

          videoThumbnail.style.display =
            "block";

        } else {

          videoThumbnail.removeAttribute(
            "src"
          );

        }


        videoPreview.hidden =
          false;

      }
    );


    /* =====================================================
       HIDE VIDEO PREVIEW
    ====================================================== */

    function hideVideoPreview() {

      if (videoPreview) {

        videoPreview.hidden =
          true;

      }

    }


    /* =====================================================
       PDF NAME
    ====================================================== */

    if (pdfInput) {

      pdfInput.addEventListener(
        "change",
        function () {

          const file =
            this.files &&
            this.files[0];


          if (!file) {

            pdfName.hidden =
              true;

            pdfName.textContent =
              "";

            return;

          }


          if (
            file.type !==
            "application/pdf"
          ) {

            pdfName.textContent =
              "⚠️ Please select a PDF file.";

            pdfName.hidden =
              false;

            return;

          }


          if (
            file.size >
            10 * 1024 * 1024
          ) {

            pdfName.textContent =
              "⚠️ PDF must be less than 10MB.";

            pdfName.hidden =
              false;

            return;

          }


          pdfName.textContent =
            "✓ " + file.name;

          pdfName.hidden =
            false;

        }
      );

    }


    /* =====================================================
       DRAG & DROP
    ====================================================== */

    if (pdfDropZone) {

      [
        "dragenter",
        "dragover"
      ].forEach(
        function (eventName) {

          pdfDropZone.addEventListener(
            eventName,
            function (event) {

              event.preventDefault();

              pdfDropZone.classList.add(
                "drag-over"
              );

            }
          );

        }
      );


      [
        "dragleave",
        "drop"
      ].forEach(
        function (eventName) {

          pdfDropZone.addEventListener(
            eventName,
            function (event) {

              event.preventDefault();

              pdfDropZone.classList.remove(
                "drag-over"
              );

            }
          );

        }
      );

    }


    /* =====================================================
       EXISTING EDIT VALUE SUPPORT
    ====================================================== */

    const existingCourseId =
      courseSelect.value;


    const existingPlaylistId =
      playlistSelect.dataset.selected ||
      playlistSelect.value;


    const existingVideoId =
      videoSelect.dataset.selected ||
      videoSelect.value;


    /*
     * For a NEW record there are no values,
     * so nothing happens here.
     *
     * This section is useful when the same
     * form is later reused for EDIT.
     */

    if (
      existingCourseId &&
      existingPlaylistId
    ) {

      loadPlaylists(
        existingCourseId
      );

    }

  }


  /* =======================================================
     TURBO
  ======================================================== */

  document.addEventListener(
    "turbo:load",
    initializeStudyNotesForm
  );


  /* =======================================================
     NORMAL LOAD
  ======================================================== */

  if (
    document.readyState !==
    "loading"
  ) {

    initializeStudyNotesForm();

  } else {

    document.addEventListener(
      "DOMContentLoaded",
      initializeStudyNotesForm,
      {
        once: true
      }
    );

  }

})();

</script>