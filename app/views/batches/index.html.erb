<style>
  .back-btn{
    display:inline-flex;
    align-items:center;
    gap:5px;
    padding:6px 10px;   /* Small horizontal padding */
    width:auto;         /* Only as wide as its content */
    white-space:nowrap;
    font-size:14px;
    font-weight:500;
    border-radius:10px;
}

.back-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 4px 12px rgba(0,0,0,.12);
}

.back-btn i{
    font-size:15px;

  } 
</style>


<div class="container-fluid">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h2 class="fw-bold text-primary">
        <i class="bi bi-people-fill"></i>
        Batch Management
      </h2>

      <p class="text-muted mb-0">
        Manage all batches, timings and schedules.
      </p>
    </div>

   <%= link_to new_batch_path,
    class: "btn btn-outline-secondary back-btn" do %>

  <i class="bi bi-plus"></i>
  Add New Batch

<% end %>

  </div>


  <div class="card shadow-lg border-0">

    <div class="card-header bg-primary text-white">

      <h5 class="mb-0">
        <i class="bi bi-list-check"></i>
        All Batches
      </h5>

    </div>

    <div class="card-body p-0">

      <% if @batches.any? %>

      <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

          <thead class="table-light">

            <tr>

              <th>#</th>

              <th>Batch Name</th>

              <th>Course</th>

              <th>Start Date</th>

              <th>End Date</th>

              <th>Timing</th>

              <th>Status</th>

              <th class="text-center">Actions</th>

            </tr>

          </thead>

          <tbody>

            <% @batches.each_with_index do |batch, index| %>

            <tr>

              <td>
                <%= index + 1 %>
              </td>

             <td class="fw-bold">
  <%= link_to batch.batch_name,
      batch_path(batch),
      class: "text-decoration-none" %>
</td>

              <td>
                <%= batch.course.Course_name %>
              </td>

              <td>
                <%= batch.start_date.strftime("%d %b %Y") if batch.start_date %>
              </td>

              <td>
                <%= batch.end_date.strftime("%d %b %Y") if batch.end_date %>
              </td>

              <td>
                <%= batch.timing %>
              </td>

              <td>

                <% if batch.status == "Active" %>

                  <span class="badge bg-success">
                    Active
                  </span>

                <% else %>

                  <span class="badge bg-danger">
                    Inactive
                  </span>

                <% end %>

              </td>

              <td class="text-center">

                <%= link_to edit_batch_path(batch),
                    class: "btn btn-sm btn-warning" do %>

                  <i class="bi bi-pencil-square"></i>

                <% end %>

                <%= link_to batch_path(batch),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Delete this batch?"
                    },
                    class: "btn btn-sm btn-danger" do %>

                  <i class="bi bi-trash-fill"></i>

                <% end %>

              </td>

            </tr>

            <% end %>

          </tbody>

        </table>

      </div>

      <% else %>

      <div class="text-center py-5">

        <i class="bi bi-calendar2-x display-2 text-secondary"></i>

        <h4 class="mt-3">
          No Batches Found
        </h4>

        <p class="text-muted">
          Click the button above to create your first batch.
        </p>

        <%#  <%= link_to new_batch_path,
    class: "btn btn-outline-secondary back-btn" do %>

  <%# <i class="bi bi-plus-circle-fill"></i>
  Add New Batch

<% end %> 

      </div>

      <% end %>

    </div>

  </div>

</div>