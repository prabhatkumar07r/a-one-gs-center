  display: inline-flex;

  align-items: center;

  gap: 7px;

  margin-bottom: 12px;

  color: #1261d8;

  text-decoration: none;

  font-size: 13px;

  font-weight: 600;

  transition:
    color .2s ease,
    transform .2s ease;

}

.payment-back-link:hover {

  color: #0b4fac;

  transform: translateX(-2px);

}


/* =========================================================
   HEADER
========================================================= */

.payment-page-header {

  margin-bottom: 20px;

}

.payment-page-header h1 {

  margin: 0;

  color: #172033;

  font-size: 28px;

  font-weight: 800;

  letter-spacing: -.3px;

}

