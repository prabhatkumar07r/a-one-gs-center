    20px
    50px;

  background:
    linear-gradient(
      135deg,
      #f4f7fb,
      #eef3ff
    );

  font-family:
    "Poppins",
    Arial,
    sans-serif;

}


.payment-wrapper {

  width: 100%;

  max-width: 850px;

  margin: 0 auto;

}


/* =========================================================
   BACK LINK
========================================================= */

