<div class="payment-page">

  <div class="payment-wrapper">

    <!-- =====================================================
         BACK TO COURSE
    ====================================================== -->

    <%= link_to course_details_path(@course),
          class: "payment-back-link" do %>

      <i class="bi bi-arrow-left"></i>
      Back to Course

    <% end %>


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="payment-page-header">

      <h1>Payment</h1>

      <p>
        Complete your payment to access the course
      </p>

    </div>


    <!-- =====================================================
         COURSE SUMMARY
    ====================================================== -->

    <div class="payment-course-card">

      <div class="payment-course-icon">
        <i class="bi bi-book-fill"></i>
      </div>


      <div class="payment-course-info">

        <span class="payment-course-label">
          COURSE
        </span>

        <h2>
          <%= @course.Course_name %>
        </h2>

        <p>
          <i class="bi bi-person-fill"></i>
          <%= @course.teacher&.name || current_user.name %>
        </p>

        <div class="payment-course-meta">

          <span>
            <i class="bi bi-play-circle"></i>
            Course Access
          </span>

          <span>
            <i class="bi bi-patch-check"></i>
            Certificate
          </span>

        </div>

      </div>


      <!-- CURRENT PAYABLE AMOUNT -->

      <div class="payment-course-price">

        <span>
          Payable
        </span>

        <strong>
          ₹<%= number_with_precision(
                @payable_amount.to_d,
                precision: 2
              ) %>
        </strong>

      </div>

    </div>


    <!-- =====================================================
         COUPON
    ====================================================== -->

    <div class="payment-section coupon-section">

      <div class="payment-section-title">

        <i class="bi bi-ticket-perforated-fill"></i>

        <h3>
          Have a Coupon?
        </h3>

      </div>


      <% if @enrollment.coupon.present? %>

        <div class="coupon-applied-box">

          <div class="coupon-applied-icon">
            <i class="bi bi-check-circle-fill"></i>
          </div>

          <div class="coupon-applied-content">

            <strong>
              <%= @enrollment.coupon.code %>
            </strong>

            <span>
              Coupon applied successfully
            </span>

          </div>

          <div class="coupon-applied-discount">

            -₹<%= number_with_precision(
                  @coupon_discount_amount.to_d,
                  precision: 2
                ) %>

          </div>

        </div>

      <% else %>

        <%= form_with url: apply_coupon_path(@enrollment),
                      method: :post,
                      local: true,
                      class: "coupon-form" do |form| %>

          <div class="coupon-input-wrapper">

            <%= form.text_field :coupon_code,
                  placeholder: "Enter coupon code",
                  class: "coupon-input",
                  autocomplete: "off",
                  maxlength: 50 %>

            <%= form.submit "Apply Coupon",
                  class: "coupon-apply-button" %>

          </div>

        <% end %>

        <p class="coupon-help-text">

          <i class="bi bi-info-circle"></i>

          Enter a valid coupon code to get a discount on this course.

        </p>

      <% end %>

    </div>


    <!-- =====================================================
         ORDER SUMMARY
    ====================================================== -->

    <div class="payment-section">

      <div class="payment-section-title">

        <i class="bi bi-receipt"></i>

        <h3>
          Order Summary
        </h3>

      </div>


      <!-- COURSE PRICE -->

      <div class="order-row">

        <span>
          Course Price
        </span>

        <strong>
          ₹<%= number_with_precision(
                @total_fee.to_d,
                precision: 2
              ) %>
        </strong>

      </div>


      <!-- COURSE DISCOUNT -->

      <% if @course_discount_amount.to_d > 0 %>

        <div class="order-row discount-row">

          <span>
            Course Discount
          </span>

          <strong>
            - ₹<%= number_with_precision(
                    @course_discount_amount.to_d,
                    precision: 2
                  ) %>
          </strong>

        </div>

      <% end %>


      <!-- COUPON DISCOUNT -->

      <% if @coupon_discount_amount.to_d > 0 %>

        <div class="order-row coupon-discount-row">

          <span>

            Coupon Discount

            <% if @enrollment.coupon.present? %>

              <small>
                (<%= @enrollment.coupon.code %>)
              </small>

            <% end %>

          </span>

          <strong>
            - ₹<%= number_with_precision(
                    @coupon_discount_amount.to_d,
                    precision: 2
                  ) %>
          </strong>

        </div>

      <% end %>


      <div class="order-divider"></div>


      <!-- FINAL PAYABLE -->

      <div class="order-row total-row">

        <span>
          Total Amount
        </span>

        <strong>
          ₹<%= number_with_precision(
                @payable_amount.to_d,
                precision: 2
              ) %>
        </strong>

      </div>

    </div>


    <!-- =====================================================
         PAYMENT METHOD
    ====================================================== -->

    <div class="payment-section">

      <div class="payment-section-title">

        <i class="bi bi-credit-card"></i>

        <h3>
          Choose Payment Method
        </h3>

      </div>


      <!-- UPI -->

      <div class="payment-method active">

        <div class="method-icon upi-icon">
          <i class="bi bi-phone"></i>
        </div>

        <div class="method-content">

          <strong>
            UPI
          </strong>

          <span>
            Google Pay, PhonePe, Paytm, etc.
          </span>

        </div>

        <i class="bi bi-check-circle-fill method-check"></i>

      </div>


      <!-- CARD -->

      <div class="payment-method">

        <div class="method-icon">
          <i class="bi bi-credit-card"></i>
        </div>

        <div class="method-content">

          <strong>
            Credit / Debit Card
          </strong>

        </div>

        <i class="bi bi-circle method-radio"></i>

      </div>


      <!-- NET BANKING -->

      <div class="payment-method">

        <div class="method-icon">
          <i class="bi bi-bank"></i>
        </div>

        <div class="method-content">

          <strong>
            Net Banking
          </strong>

        </div>

        <i class="bi bi-circle method-radio"></i>

      </div>


      <!-- WALLET -->

      <div class="payment-method">

        <div class="method-icon">
          <i class="bi bi-wallet2"></i>
        </div>

        <div class="method-content">

          <strong>
            Wallet
          </strong>

          <span>
            Paytm, Mobikwik, etc.
          </span>

        </div>

        <i class="bi bi-circle method-radio"></i>

      </div>

    </div>


    <!-- =====================================================
         SECURITY
    ====================================================== -->

    <div class="payment-security">

      <div class="security-icon">
        <i class="bi bi-lock-fill"></i>
      </div>

      <div>

        <strong>
          Your payment is 100% secure
        </strong>

        <p>
          We use industry-standard encryption to keep
          your information safe.
        </p>

      </div>

    </div>


    <!-- =====================================================
         PAYMENT BUTTON
    ====================================================== -->

    <% if @payment.present? %>

      <button
        type="button"
        id="pay-button"
        class="pay-button">

        <span id="pay-icon">
          <i class="bi bi-credit-card-fill"></i>
        </span>

        <span id="pay-text">

          Pay Now

          ₹<%= number_with_precision(
                @payment.amount.to_d,
                precision: 2
              ) %>

        </span>

      </button>


    <% else %>

      <%= form_with url: create_payment_path(@enrollment),
                    method: :post,
                    local: true,
                    id: "create-payment-form" do %>

        <button
          type="submit"
          class="pay-button"
          id="create-payment-button">

          <i class="bi bi-credit-card-fill"></i>

          <span>
            Continue to Payment
          </span>

          <strong>
            ₹<%= number_with_precision(
                  @payable_amount.to_d,
                  precision: 2
                ) %>
          </strong>

        </button>

      <% end %>

    <% end %>


    <!-- =====================================================
         TERMS
    ====================================================== -->

    <p class="payment-terms">

      By proceeding, you agree to our

      <a href="#">
        Terms & Conditions
      </a>

      and

      <a href="#">
        Privacy Policy
      </a>.

    </p>


    <!-- =====================================================
         BENEFITS
    ====================================================== -->

    <div class="payment-benefits">

      <div class="payment-benefit">

        <div class="benefit-icon">
          <i class="bi bi-play-circle-fill"></i>
        </div>

        <strong>
          Lifetime Access
        </strong>

        <span>
          Learn at your own pace
        </span>

      </div>


      <div class="payment-benefit">

        <div class="benefit-icon">
          <i class="bi bi-award-fill"></i>
        </div>

        <strong>
          Certificate
        </strong>

        <span>
          Get verified certificate
        </span>

      </div>


      <div class="payment-benefit">

        <div class="benefit-icon">
          <i class="bi bi-headset"></i>
        </div>

        <strong>
          24/7 Support
        </strong>

        <span>
          We're here to help
        </span>

      </div>

    </div>

  </div>

</div>


<!-- =========================================================
     RAZORPAY CHECKOUT
========================================================= -->

<% if @payment.present? %>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <script nonce="<%= content_security_policy_nonce %>">

    (function () {

      function initializePaymentPage() {

        const payButton =
          document.getElementById("pay-button");

        if (!payButton) return;


        /*
         * Prevent duplicate Turbo listeners
         */

        if (
          payButton.dataset.paymentInitialized === "true"
        ) {
          return;
        }

        payButton.dataset.paymentInitialized = "true";


        payButton.addEventListener("click", function () {

          if (payButton.disabled) {
            return;
          }


          payButton.disabled = true;

          payButton.classList.add("loading");


          /*
           * Check Razorpay
           */

          if (typeof Razorpay === "undefined") {

            console.error(
              "Razorpay checkout.js is not loaded."
            );

            payButton.disabled = false;

            payButton.classList.remove("loading");

            alert(
              "Payment service is temporarily unavailable. Please refresh the page and try again."
            );

            return;
          }


          /*
           * Razorpay options
           */

          const options = {

            key:
              "<%= ENV.fetch("RAZORPAY_KEY_ID") %>",

            /*
             * Payment.amount is the actual amount
             * stored for this Razorpay order.
             */

            amount:
              <%= (@payment.amount.to_d * 100).to_i %>,

            currency:
              "INR",

            name:
              "A One GS Center",

            description:
              "<%= j @course.Course_name %>",

            order_id:
              "<%= @payment.razorpay_order_id %>",


            /*
             * Customer details
             */

            prefill: {

              name:
                "<%= j current_user.name.to_s %>",

              email:
                "<%= j current_user.email.to_s %>"

            },


            /*
             * Theme
             */

            theme: {

              color:
                "#1261d8"

            },


            /*
             * Successful payment
             */

            handler:
              function (response) {

                const form =
                  document.createElement("form");

                form.method =
                  "POST";

                form.action =
                  "<%= verify_payment_path(@enrollment) %>";


                const csrf =
                  document.querySelector(
                    'meta[name="csrf-token"]'
                  );


                function addField(name, value) {

                  const input =
                    document.createElement("input");

                  input.type =
                    "hidden";

                  input.name =
                    name;

                  input.value =
                    value || "";

                  form.appendChild(input);

                }


                addField(
                  "authenticity_token",
                  csrf ? csrf.content : ""
                );


                addField(
                  "razorpay_payment_id",
                  response.razorpay_payment_id
                );


                addField(
                  "razorpay_order_id",
                  response.razorpay_order_id
                );


                addField(
                  "razorpay_signature",
                  response.razorpay_signature
                );


                document.body.appendChild(form);

                form.submit();

              },


            /*
             * Razorpay modal closed
             */

            modal: {

              ondismiss:
                function () {

                  payButton.disabled =
                    false;

                  payButton.classList.remove(
                    "loading"
                  );

                }

            }

          };


          /*
           * Open Razorpay
           */

          try {

            const razorpay =
              new Razorpay(options);


            /*
             * Payment failed
             */

            razorpay.on(
              "payment.failed",
              function () {

                window.location.href =
                  "<%= payment_failed_path(@enrollment) %>";

              }
            );


            razorpay.open();


          } catch (error) {

            console.error(
              "Razorpay initialization failed:",
              error
            );

            payButton.disabled =
              false;

            payButton.classList.remove(
              "loading"
            );

            alert(
              "Unable to open payment gateway. Please try again."
            );

          }

        });

      }


      /*
       * Turbo
       */

      document.addEventListener(
        "turbo:load",
        initializePaymentPage
      );


      /*
       * Normal page load
       */

      if (document.readyState !== "loading") {

        initializePaymentPage();

      } else {

        document.addEventListener(
          "DOMContentLoaded",
          initializePaymentPage,
          { once: true }
        );

      }

    })();

  </script>

<% end %>


