<div class="payment-page">

  <div class="payment-wrapper">

    <div class="payment-card">

      <!-- =====================================================
           HEADER
      ====================================================== -->

      <div class="payment-header">

        <div class="payment-icon">
          <i class="bi bi-shield-lock-fill"></i>
        </div>

        <div class="payment-header-content">

          <h2>
            Complete Your Payment
          </h2>

          <p>
            Secure your enrollment with A ONE GS CENTER
          </p>

        </div>

      </div>


      <!-- =====================================================
           COURSE
      ====================================================== -->

      <div class="course-section">

        <div class="course-icon">
          <i class="bi bi-book-fill"></i>
        </div>

        <div class="course-info">

          <span class="course-label">
            COURSE
          </span>

          <h3>
            <%= @course.Course_name %>
          </h3>

          <p>
            <i class="bi bi-person-fill"></i>

            <%= @customer_name %>
          </p>

        </div>

      </div>


      <!-- =====================================================
           PRICE
      ====================================================== -->

      <div class="price-section">

        <div class="price-label">

          <span>
            Total Course Fee
          </span>

          <small>
            Amount payable
          </small>

        </div>

        <strong>
          ₹<%= number_with_precision(
                @payment.amount,
                precision: 2
              ) %>
        </strong>

      </div>


      <!-- =====================================================
           RAZORPAY CHECKOUT
      ====================================================== -->

      <div class="checkout-section">

        <div class="checkout-icon">

          <i class="bi bi-credit-card-fill"></i>

        </div>

        <h3>
          Secure Online Payment
        </h3>

        <p>
          Pay securely using UPI, credit card, debit card,
          net banking or supported wallets.
        </p>

        <div class="payment-method-list">

          <span>
            <i class="bi bi-qr-code"></i>
            UPI
          </span>

          <span>
            <i class="bi bi-credit-card"></i>
            Cards
          </span>

          <span>
            <i class="bi bi-bank"></i>
            Net Banking
          </span>

          <span>
            <i class="bi bi-wallet2"></i>
            Wallets
          </span>

        </div>

      </div>


      <!-- =====================================================
           SECURITY
      ====================================================== -->

      <div class="security-box">

        <div class="security-icon">
          <i class="bi bi-shield-check"></i>
        </div>

        <div>

          <strong>
            Secure Payment
          </strong>

          <p>
            Your payment is securely processed by Razorpay.
            Your payment credentials are handled by Razorpay
            and are never stored on our server.
          </p>

        </div>

      </div>


      <!-- =====================================================
           PAY BUTTON
      ====================================================== -->

      <% if @razorpay_order_id.present? %>

        <button
          type="button"
          class="pay-button"
          id="pay-button">

          <span id="pay-icon">
            <i class="bi bi-lock-fill"></i>
          </span>

          <span id="pay-text">
            Pay ₹<%= number_with_precision(
                      @payment.amount,
                      precision: 2
                    ) %> Securely
          </span>

        </button>

      <% else %>

        <div class="payment-error">

          <i class="bi bi-exclamation-triangle-fill"></i>

          <div>

            <strong>
              Payment order unavailable
            </strong>

            <p>
              Please refresh the page and try again.
            </p>

          </div>

        </div>

      <% end %>


      <!-- =====================================================
           VERIFICATION FORM
      ====================================================== -->

      <%= form_with(
            url: verify_payment_path(@enrollment),
            method: :post,
            local: true,
            id: "razorpay-verification-form"
          ) do %>

        <%= hidden_field_tag(
              :razorpay_payment_id,
              "",
              id: "razorpay_payment_id"
            ) %>

        <%= hidden_field_tag(
              :razorpay_order_id,
              "",
              id: "razorpay_order_id"
            ) %>

        <%= hidden_field_tag(
              :razorpay_signature,
              "",
              id: "razorpay_signature"
            ) %>

      <% end %>


      <!-- =====================================================
           BACK
      ====================================================== -->

      <%= link_to course_details_path(@course),
            class: "cancel-button" do %>

        <i class="bi bi-arrow-left"></i>

        Back to Course

      <% end %>


      <!-- =====================================================
           FOOTER
      ====================================================== -->

      <div class="payment-footer">

        <div>

          <i class="bi bi-lock-fill"></i>

          Secure & encrypted payment

        </div>

        <span>
          Powered by Razorpay
        </span>

      </div>

    </div>

  </div>

</div>


<!-- =========================================================
     RAZORPAY STANDARD CHECKOUT
========================================================= -->

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>


<script>
document.addEventListener("DOMContentLoaded", function () {

  "use strict";


  /* =========================================================
     ELEMENTS
  ========================================================= */

  const button =
    document.getElementById("pay-button");

  const icon =
    document.getElementById("pay-icon");

  const text =
    document.getElementById("pay-text");

  const verificationForm =
    document.getElementById(
      "razorpay-verification-form"
    );

  const paymentIdField =
    document.getElementById(
      "razorpay_payment_id"
    );

  const orderIdField =
    document.getElementById(
      "razorpay_order_id"
    );

  const signatureField =
    document.getElementById(
      "razorpay_signature"
    );


  /* =========================================================
     STOP IF BUTTON DOES NOT EXIST
  ========================================================= */

  if (!button) {
    return;
  }


  /* =========================================================
     RAZORPAY CONFIGURATION
  ========================================================= */

  const razorpayKey =
    "<%= j @razorpay_key_id.to_s %>";

  const razorpayOrderId =
    "<%= j @razorpay_order_id.to_s %>";

  const amount =
    <%= @razorpay_amount.to_i %>;

  const customerName =
    "<%= j @customer_name.to_s %>";

  const customerEmail =
    "<%= j @customer_email.to_s %>";

  const customerPhone =
    "<%= j @customer_phone.to_s %>";


  /* =========================================================
     VALIDATE CONFIGURATION
  ========================================================= */

  if (!razorpayKey) {

    console.error(
      "RAZORPAY_KEY_ID is missing."
    );

    button.disabled = true;

    text.textContent =
      "Payment Configuration Error";

    return;
  }


  if (!razorpayOrderId) {

    console.error(
      "Razorpay Order ID is missing."
    );

    button.disabled = true;

    text.textContent =
      "Payment Order Unavailable";

    return;
  }


  if (!amount || amount <= 0) {

    console.error(
      "Invalid Razorpay payment amount:",
      amount
    );

    button.disabled = true;

    text.textContent =
      "Invalid Payment Amount";

    return;
  }


  /* =========================================================
     CHECKOUT SCRIPT
  ========================================================= */

  if (typeof Razorpay === "undefined") {

    console.error(
      "Razorpay Checkout script was not loaded."
    );

    button.disabled = true;

    text.textContent =
      "Payment Service Unavailable";

    return;
  }


  /* =========================================================
     CHECKOUT OPTIONS
  ========================================================= */

  const options = {

    key: razorpayKey,

    amount: amount,

    currency: "INR",

    name: "A ONE GS CENTER",

    description:
      "<%= j @course.Course_name.to_s %>",

    order_id:
      razorpayOrderId,


    /* =======================================================
       PREFILL
    ======================================================= */

    prefill: {

      name:
        customerName,

      email:
        customerEmail,

      contact:
        customerPhone

    },


    /* =======================================================
       NOTES
    ======================================================= */

    notes: {

      enrollment_id:
        "<%= @enrollment.id %>",

      course_id:
        "<%= @course.id %>",

      payment_id:
        "<%= @payment.id %>"

    },


    /* =======================================================
       THEME
    ======================================================= */

    theme: {

      color: "#198754"

    },


    /* =======================================================
       MODAL
    ======================================================= */

    modal: {

      ondismiss: function () {

        button.disabled = false;

        button.classList.remove(
          "loading"
        );

        if (icon) {

          icon.innerHTML =
            '<i class="bi bi-lock-fill"></i>';

        }

        if (text) {

          text.textContent =
            "Pay ₹<%= number_with_precision(
                      @payment.amount,
                      precision: 2
                    ) %> Securely";

        }

      }

    },


    /* =======================================================
       SUCCESS HANDLER
    ======================================================= */

    handler: function (response) {

      console.log(
        "Razorpay payment response:",
        response
      );


      if (
        !response ||
        !response.razorpay_payment_id ||
        !response.razorpay_order_id ||
        !response.razorpay_signature
      ) {

        alert(
          "Payment information is incomplete."
        );

        button.disabled = false;

        return;
      }


      /* -----------------------------------------------------
         Show verification state
      ----------------------------------------------------- */

      button.disabled = true;

      button.classList.add(
        "loading"
      );


      if (icon) {

        icon.innerHTML =
          '<i class="bi bi-arrow-repeat"></i>';

      }


      if (text) {

        text.textContent =
          "Verifying Payment...";

      }


      /* -----------------------------------------------------
         Populate verification form
      ----------------------------------------------------- */

      paymentIdField.value =
        response.razorpay_payment_id;

      orderIdField.value =
        response.razorpay_order_id;

      signatureField.value =
        response.razorpay_signature;


      /* -----------------------------------------------------
         Submit to Rails
      ----------------------------------------------------- */

      verificationForm.submit();

    }

  };


  /* =========================================================
     INITIALIZE CHECKOUT
  ========================================================= */

  let razorpay;

  try {

    razorpay =
      new Razorpay(options);

  } catch (error) {

    console.error(
      "Razorpay initialization failed:",
      error
    );

    button.disabled = false;

    text.textContent =
      "Payment Unavailable";

    return;
  }


  /* =========================================================
     PAYMENT FAILED
  ========================================================= */

  razorpay.on(
    "payment.failed",
    function (response) {

      console.error(
        "Razorpay payment failed:",
        response
      );

      const failedUrl =
        "<%= payment_failed_path(@enrollment) %>";

      window.location.href =
        failedUrl;
    }
  );


  /* =========================================================
     OPEN CHECKOUT
  ========================================================= */

  button.addEventListener(
    "click",
    function () {

      if (button.disabled) {
        return;
      }


      button.disabled = true;

      button.classList.add(
        "loading"
      );


      if (icon) {

        icon.innerHTML =
          '<i class="bi bi-arrow-repeat"></i>';

      }


      if (text) {

        text.textContent =
          "Opening Secure Checkout...";

      }


      try {

        razorpay.open();

      } catch (error) {

        console.error(
          "Razorpay Checkout Error:",
          error
        );

        button.disabled = false;

        button.classList.remove(
          "loading"
        );

        if (icon) {

          icon.innerHTML =
            '<i class="bi bi-lock-fill"></i>';

        }

        if (text) {

          text.textContent =
            "Pay ₹<%= number_with_precision(
                      @payment.amount,
                      precision: 2
                    ) %> Securely";

        }

      }

    }
  );

});
</script>


<style>

/* =========================================================
   PAYMENT PAGE
========================================================= */

.payment-page {

  min-height: 100vh;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 40px 20px;

  background:
    linear-gradient(
      135deg,
      #f4f7fb 0%,
      #eef3ff 100%
    );

  font-family:
    "Poppins",
    Arial,
    sans-serif;
}


.payment-wrapper {

  width: 100%;

  max-width: 580px;
}


.payment-card {

  width: 100%;

  box-sizing: border-box;

  background: #ffffff;

  border: 1px solid #e5eaf2;

  border-radius: 24px;

  padding: 32px;

  box-shadow:
    0 18px 50px
    rgba(15, 23, 42, 0.12);
}


/* =========================================================
   HEADER
========================================================= */

.payment-header {

  display: flex;

  align-items: center;

  gap: 16px;

  margin-bottom: 26px;
}


.payment-icon {

  width: 58px;

  height: 58px;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 16px;

  background: #e8f1ff;

  color: #0d6efd;

  font-size: 25px;
}


.payment-header h2 {

  margin: 0;

  color: #172033;

  font-size: 24px;

  font-weight: 700;
}


.payment-header p {

  margin: 5px 0 0;

  color: #6b7280;

  font-size: 13px;
}


/* =========================================================
   COURSE
========================================================= */

.course-section {

  display: flex;

  align-items: center;

  gap: 15px;

  padding: 18px;

  margin-bottom: 20px;

  background: #f8fafc;

  border: 1px solid #edf0f5;

  border-radius: 16px;
}


.course-icon {

  width: 52px;

  height: 52px;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 14px;

  background: #0d6efd;

  color: #ffffff;

  font-size: 21px;
}


.course-info {

  min-width: 0;
}


.course-label {

  display: block;

  color: #6b7280;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: 1.2px;
}


.course-info h3 {

  margin: 4px 0;

  color: #172033;

  font-size: 18px;

  font-weight: 700;

  word-break: break-word;
}


.course-info p {

  margin: 0;

  color: #6b7280;

  font-size: 13px;
}


/* =========================================================
   PRICE
========================================================= */

.price-section {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

  padding: 18px 0;

  margin-bottom: 20px;

  border-bottom: 1px solid #e5e7eb;
}


.price-label span {

  display: block;

  color: #4b5563;

  font-size: 14px;

  font-weight: 600;
}


.price-label small {

  display: block;

  margin-top: 3px;

  color: #9ca3af;

  font-size: 11px;
}


.price-section strong {

  color: #198754;

  font-size: 29px;

  font-weight: 800;

  white-space: nowrap;
}


/* =========================================================
   CHECKOUT
========================================================= */

.checkout-section {

  padding: 24px;

  margin-bottom: 20px;

  text-align: center;

  background:
    linear-gradient(
      135deg,
      #f8fffb,
      #effff6
    );

  border: 1px solid #ccefdc;

  border-radius: 18px;
}


.checkout-icon {

  width: 55px;

  height: 55px;

  margin: 0 auto 12px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 15px;

  background: #dcfce7;

  color: #198754;

  font-size: 24px;
}


.checkout-section h3 {

  margin: 0;

  color: #166534;

  font-size: 18px;

  font-weight: 700;
}


.checkout-section p {

  max-width: 420px;

  margin: 7px auto 15px;

  color: #6b7280;

  font-size: 12px;

  line-height: 1.6;
}


/* =========================================================
   PAYMENT METHODS
========================================================= */

.payment-method-list {

  display: flex;

  flex-wrap: wrap;

  justify-content: center;

  gap: 8px;
}


.payment-method-list span {

  display: inline-flex;

  align-items: center;

  gap: 5px;

  padding: 7px 10px;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 8px;

  color: #6b7280;

  font-size: 10px;
}


.payment-method-list i {

  color: #198754;
}


/* =========================================================
   SECURITY
========================================================= */

.security-box {

  display: flex;

  align-items: flex-start;

  gap: 12px;

  padding: 14px 16px;

  margin-bottom: 20px;

  background: #f0fdf4;

  border: 1px solid #d1fae5;

  border-radius: 13px;
}


.security-icon {

  color: #198754;

  font-size: 22px;
}


.security-box strong {

  display: block;

  color: #166534;

  font-size: 13px;
}


.security-box p {

  margin: 4px 0 0;

  color: #4b5563;

  font-size: 11px;

  line-height: 1.5;
}


/* =========================================================
   PAY BUTTON
========================================================= */

.pay-button {

  width: 100%;

  min-height: 56px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 10px;

  border: none;

  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      #198754,
      #157347
    );

  color: #ffffff;

  font-size: 16px;

  font-weight: 700;

  cursor: pointer;

  box-shadow:
    0 8px 20px
    rgba(25, 135, 84, 0.22);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    opacity 0.2s ease;
}


.pay-button:hover {

  transform: translateY(-2px);

  box-shadow:
    0 12px 25px
    rgba(25, 135, 84, 0.28);
}


.pay-button:disabled {

  cursor: wait;
}


.pay-button.loading {

  opacity: 0.75;

  cursor: wait;
}


/* =========================================================
   SPINNER
========================================================= */

.bi-arrow-repeat {

  display: inline-block;

  animation:
    payment-spin 1s linear infinite;
}


@keyframes payment-spin {

  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }

}


/* =========================================================
   ERROR
========================================================= */

.payment-error {

  display: flex;

  align-items: flex-start;

  gap: 12px;

  padding: 15px;

  margin-bottom: 20px;

  background: #fff7ed;

  border: 1px solid #fed7aa;

  border-radius: 13px;
}


.payment-error > i {

  color: #ea580c;

  font-size: 21px;
}


.payment-error strong {

  display: block;

  color: #9a3412;

  font-size: 13px;
}


.payment-error p {

  margin: 4px 0 0;

  color: #6b7280;

  font-size: 11px;
}


/* =========================================================
   CANCEL
========================================================= */

.cancel-button {

  width: 100%;

  min-height: 46px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  margin-top: 10px;

  border-radius: 11px;

  color: #6b7280;

  text-decoration: none;

  font-size: 13px;

  font-weight: 600;

  transition: 0.2s ease;
}


.cancel-button:hover {

  color: #172033;

  background: #f8fafc;
}


/* =========================================================
   FOOTER
========================================================= */

.payment-footer {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 10px;

  margin-top: 18px;

  padding-top: 17px;

  border-top: 1px solid #edf0f5;

  color: #9ca3af;

  font-size: 10px;
}


.payment-footer i {

  margin-right: 4px;

  color: #198754;
}


.payment-footer span {

  color: #b0b5bd;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 576px) {

  .payment-page {

    min-height: 100vh;

    padding: 20px 10px;

    align-items: flex-start;
  }


  .payment-card {

    margin-top: 15px;

    padding: 22px 16px;

    border-radius: 19px;
  }


  .payment-header {

    gap: 12px;
  }


  .payment-icon {

    width: 48px;

    height: 48px;

    font-size: 21px;

    border-radius: 13px;
  }


  .payment-header h2 {

    font-size: 20px;
  }


  .payment-header p {

    font-size: 11px;
  }


  .course-section {

    padding: 14px;
  }


  .course-icon {

    width: 45px;

    height: 45px;
  }


  .course-info h3 {

    font-size: 16px;
  }


  .price-section strong {

    font-size: 24px;
  }


  .checkout-section {

    padding: 18px 10px;
  }


  .payment-method-list {

    gap: 5px;
  }


  .payment-method-list span {

    font-size: 9px;

    padding: 6px 8px;
  }


  .payment-footer {

    flex-direction: column;

    justify-content: center;
  }

}

</style>