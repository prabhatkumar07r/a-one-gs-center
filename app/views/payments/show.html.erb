<div class="payment-page">

  <div class="payment-wrapper">

    <div class="payment-card">

      <!-- ===================================================
           HEADER
      ==================================================== -->

      <div class="payment-header">

        <div class="payment-icon">
          <i class="bi bi-shield-lock-fill"></i>
        </div>

        <div>

          <h2>
            Complete Your Payment
          </h2>

          <p>
            Secure your enrollment
          </p>

        </div>

      </div>


      <!-- ===================================================
           COURSE INFORMATION
      ==================================================== -->

      <div class="course-section">

        <div class="course-icon">
          <i class="bi bi-book-fill"></i>
        </div>

        <div class="course-info">

          <span class="course-label">
            COURSE
          </span>

          <h3>
            <%= @course.Course_name %>
          </h3>

          <p>
            <i class="bi bi-person-fill"></i>

            <%= @enrollment.user.name %>
          </p>

        </div>

      </div>


      <!-- ===================================================
           PRICE
      ==================================================== -->

      <div class="price-section">

        <span>
          Total Course Fee
        </span>

        <strong>
          ₹<%= number_with_precision(
                @course.fee,
                precision: 2
              ) %>
        </strong>

      </div>


      <!-- ===================================================
           SECURITY
      ==================================================== -->

      <div class="security-box">

        <i class="bi bi-shield-check"></i>

        <div>

          <strong>
            Secure Payment
          </strong>

          <p>
            Your payment is securely processed by Razorpay.
            UPI, QR, cards and other available payment
            methods are supported by Razorpay Checkout.
          </p>

        </div>

      </div>


      <!-- ===================================================
           PAYMENT SECTION
      ==================================================== -->

      <% if @order_id.present? %>


        <!-- =================================================
             RAZORPAY CHECKOUT BUTTON
        ================================================== -->

        <button
          type="button"
          class="pay-button"
          id="pay-button">

          <span id="pay-icon">
            <i class="bi bi-credit-card-fill"></i>
          </span>

          <span id="pay-text">

            Pay ₹<%= number_with_precision(
                      @course.fee,
                      precision: 2
                    ) %> Securely

          </span>

        </button>


      <% else %>


        <!-- =================================================
             CREATE RAZORPAY ORDER
        ================================================== -->

        <%= form_with(
              url: payment_path(@enrollment),
              method: :post,
              local: true,
              id: "payment-form"
            ) do %>

          <button
            type="submit"
            class="pay-button"
            id="create-order-button">

            <span id="create-order-icon">
              <i class="bi bi-credit-card-fill"></i>
            </span>

            <span id="create-order-text">

              Pay ₹<%= number_with_precision(
                        @course.fee,
                        precision: 2
                      ) %> Securely

            </span>

          </button>

        <% end %>


      <% end %>


      <!-- ===================================================
           RAZORPAY VERIFICATION FORM
           
           IMPORTANT:
           This replaces fetch().
           
           Razorpay handler fills these hidden fields and
           submits this normal Rails POST form.
      ==================================================== -->

      <%= form_with(
            url: verify_payment_path(@enrollment),
            method: :post,
            local: true,
            id: "razorpay-verification-form"
          ) do %>

        <%= hidden_field_tag(
              :razorpay_payment_id,
              "",
              id: "razorpay_payment_id"
            ) %>

        <%= hidden_field_tag(
              :razorpay_order_id,
              "",
              id: "razorpay_order_id"
            ) %>

        <%= hidden_field_tag(
              :razorpay_signature,
              "",
              id: "razorpay_signature"
            ) %>

      <% end %>


      <!-- ===================================================
           CANCEL
      ==================================================== -->

      <%= link_to course_details_path(@course),
            class: "cancel-button",
            id: "cancel-button" do %>

        <i class="bi bi-arrow-left"></i>

        Back to Course

      <% end %>


      <!-- ===================================================
           FOOTER
      ==================================================== -->

      <div class="payment-footer">

        <i class="bi bi-lock-fill"></i>

        Secure & encrypted payment

      </div>

    </div>

  </div>

</div>


<!-- =========================================================
     RAZORPAY CHECKOUT
========================================================= -->

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>


<script>

document.addEventListener(
  "DOMContentLoaded",
  function () {


    /* =====================================================
       ELEMENTS
    ====================================================== */

    const paymentForm =
      document.getElementById(
        "payment-form"
      );


    const button =
      document.getElementById(
        "pay-button"
      );


    const createOrderButton =
      document.getElementById(
        "create-order-button"
      );


    const icon =
      document.getElementById(
        "pay-icon"
      );


    const text =
      document.getElementById(
        "pay-text"
      );


    const createOrderIcon =
      document.getElementById(
        "create-order-icon"
      );


    const createOrderText =
      document.getElementById(
        "create-order-text"
      );


    const verificationForm =
      document.getElementById(
        "razorpay-verification-form"
      );


    const paymentIdField =
      document.getElementById(
        "razorpay_payment_id"
      );


    const orderIdField =
      document.getElementById(
        "razorpay_order_id"
      );


    const signatureField =
      document.getElementById(
        "razorpay_signature"
      );


    /* =====================================================
       CREATE ORDER FORM
    ====================================================== */

    if (paymentForm) {

      paymentForm.addEventListener(
        "submit",
        function () {

          if (createOrderButton) {

            createOrderButton.disabled =
              true;

          }


          if (createOrderIcon) {

            createOrderIcon.innerHTML =
              '<i class="bi bi-arrow-repeat"></i>';

          }


          if (createOrderText) {

            createOrderText.textContent =
              "Creating Secure Payment...";

          }

        }
      );

    }


    /* =====================================================
       NO RAZORPAY ORDER YET
       
       Rails will create it first.
       
       After redirect, this page will have @order_id.
    ====================================================== */

    const razorpayOrderId =
      "<%= j @order_id.to_s %>";


    if (!razorpayOrderId) {

      return;

    }


    /* =====================================================
       PAYMENT BUTTON MUST EXIST
    ====================================================== */

    if (!button) {

      console.error(
        "Razorpay payment button not found."
      );

      return;

    }


    /* =====================================================
       RAZORPAY KEY
       
       ONLY PUBLIC KEY IS SENT TO BROWSER.
       
       NEVER send RAZORPAY_KEY_SECRET here.
    ====================================================== */

    const razorpayKey =
      "<%= j ENV["RAZORPAY_KEY_ID"].to_s %>";


    if (!razorpayKey) {

      console.error(
        "RAZORPAY_KEY_ID is missing."
      );


      button.disabled =
        false;


      if (text) {

        text.textContent =
          "Payment Configuration Error";

      }


      alert(
        "Razorpay configuration is missing. Please contact support."
      );


      return;

    }


    /* =====================================================
       PAYMENT AMOUNT
       
       Razorpay amount must be in paise.
    ====================================================== */

    const amount =
      <%= (@payment&.amount || @course.fee).to_d * 100 %>;


    /* =====================================================
       RAZORPAY CHECKOUT OPTIONS
    ====================================================== */

    const options = {

      key:
        razorpayKey,


      amount:
        Math.round(amount),


      currency:
        "INR",


      name:
        "A ONE GS CENTER",


      description:
        "<%= j @course.Course_name.to_s %>",


      order_id:
        razorpayOrderId,


      /* ===================================================
         PREFILL USER DETAILS
      ==================================================== */

      prefill: {

        name:
          "<%= j @enrollment.user.name.to_s %>",

        email:
          "<%= j @enrollment.user.email.to_s %>",

        contact:
          "<%= j @enrollment.user.mobile.to_s %>"

      },


      /* ===================================================
         NOTES
      ==================================================== */

      notes: {

        enrollment_id:
          "<%= @enrollment.id %>",

        course_id:
          "<%= @course.id %>"

      },


      /* ===================================================
         THEME
      ==================================================== */

      theme: {

        color:
          "#198754"

      },


      /* ===================================================
         PAYMENT SUCCESS
      ==================================================== */

      handler:
        function (response) {


          console.log(
            "Razorpay payment completed:",
            response
          );


          /* -----------------------------------------------
             Validate response
          ------------------------------------------------ */

          if (
            !response ||
            !response.razorpay_payment_id ||
            !response.razorpay_order_id ||
            !response.razorpay_signature
          ) {

            console.error(
              "Incomplete Razorpay response:",
              response
            );


            alert(
              "Razorpay returned incomplete payment information. Please contact support."
            );


            return;

          }


          /* -----------------------------------------------
             Update button
          ------------------------------------------------ */

          button.disabled =
            true;


          button.classList.add(
            "loading"
          );


          if (icon) {

            icon.innerHTML =
              '<i class="bi bi-check-circle-fill"></i>';

          }


          if (text) {

            text.textContent =
              "Verifying Payment...";

          }


          /* -----------------------------------------------
             Fill Rails verification form
          ------------------------------------------------ */

          if (!verificationForm) {

            console.error(
              "Verification form not found."
            );


            alert(
              "Payment verification form is missing."
            );


            return;

          }


          paymentIdField.value =
            response.razorpay_payment_id;


          orderIdField.value =
            response.razorpay_order_id;


          signatureField.value =
            response.razorpay_signature;


          /* -----------------------------------------------
             NORMAL RAILS POST
             
             NO FETCH
             NO document.write
             NO AJAX
          ------------------------------------------------ */

          verificationForm.submit();

        },


      /* ===================================================
         PAYMENT FAILED
      ==================================================== */

      modal: {

        ondismiss:
          function () {


            console.log(
              "Razorpay checkout closed."
            );


            if (button) {

              button.disabled =
                false;

              button.classList.remove(
                "loading"
              );

            }


            if (icon) {

              icon.innerHTML =
                '<i class="bi bi-credit-card-fill"></i>';

            }


            if (text) {

              text.textContent =
                "Pay ₹<%= number_with_precision(
                          @course.fee,
                          precision: 2
                        ) %> Securely";

            }

          }

      }

    };


    /* =====================================================
       CHECK RAZORPAY SCRIPT
    ====================================================== */

    if (
      typeof Razorpay ===
      "undefined"
    ) {

      console.error(
        "Razorpay Checkout script was not loaded."
      );


      button.disabled =
        false;


      if (text) {

        text.textContent =
          "Payment Service Unavailable";

      }


      alert(
        "Razorpay Checkout could not be loaded. Please refresh and try again."
      );


      return;

    }


    /* =====================================================
       CREATE RAZORPAY INSTANCE
    ====================================================== */

    let razorpay;


    try {

      razorpay =
        new Razorpay(
          options
        );

    }

    catch (error) {

      console.error(
        "Unable to initialize Razorpay:",
        error
      );


      button.disabled =
        false;


      if (text) {

        text.textContent =
          "Payment Unavailable";

      }


      alert(
        "Unable to initialize Razorpay Checkout. Please try again."
      );


      return;

    }


    /* =====================================================
       PAYMENT FAILED EVENT
    ====================================================== */

    razorpay.on(
      "payment.failed",
      function (response) {


        console.error(
          "Razorpay payment failed:",
          response
        );


        const failedUrl =
          "<%= payment_failed_path(@enrollment) %>";


        window.location.href =
          failedUrl;

      }
    );


    /* =====================================================
       OPEN RAZORPAY CHECKOUT
    ====================================================== */

    button.addEventListener(
      "click",
      function () {


        if (
          button.disabled
        ) {

          return;

        }


        button.disabled =
          true;


        button.classList.add(
          "loading"
        );


        if (icon) {

          icon.innerHTML =
            '<i class="bi bi-arrow-repeat"></i>';

        }


        if (text) {

          text.textContent =
            "Opening Secure Checkout...";

        }


        try {

          razorpay.open();

        }

        catch (error) {

          console.error(
            "Razorpay Checkout Error:",
            error
          );


          button.disabled =
            false;


          button.classList.remove(
            "loading"
          );


          if (icon) {

            icon.innerHTML =
              '<i class="bi bi-credit-card-fill"></i>';

          }


          if (text) {

            text.textContent =
              "Pay ₹<%= number_with_precision(
                        @course.fee,
                        precision: 2
                      ) %> Securely";

          }


          alert(
            "Unable to open Razorpay Checkout. Please try again."
          );

        }

      }
    );

  }

);

</script>


<style>

/* =========================================================
   PAYMENT PAGE
========================================================= */

.payment-page {

  min-height: 100vh;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 40px 20px;

  background:
    linear-gradient(
      135deg,
      #f4f7fb 0%,
      #eef3ff 100%
    );

  font-family:
    "Poppins",
    Arial,
    sans-serif;

}


/* =========================================================
   WRAPPER
========================================================= */

.payment-wrapper {

  width: 100%;

  max-width: 560px;

}


/* =========================================================
   CARD
========================================================= */

.payment-card {

  background: #ffffff;

  border-radius: 22px;

  padding: 32px;

  box-shadow:
    0 15px 45px
    rgba(15, 23, 42, 0.12);

  border:
    1px solid #e8edf5;

}


/* =========================================================
   HEADER
========================================================= */

.payment-header {

  display: flex;

  align-items: center;

  gap: 16px;

  margin-bottom: 28px;

}


.payment-icon {

  width: 58px;

  height: 58px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 16px;

  background: #e8f1ff;

  color: #0d6efd;

  font-size: 25px;

  flex-shrink: 0;

}


.payment-header h2 {

  margin: 0;

  font-size: 24px;

  font-weight: 700;

  color: #172033;

}


.payment-header p {

  margin: 4px 0 0;

  color: #6b7280;

  font-size: 14px;

}


/* =========================================================
   COURSE
========================================================= */

.course-section {

  display: flex;

  align-items: center;

  gap: 15px;

  padding: 18px;

  background: #f8fafc;

  border:
    1px solid #edf0f5;

  border-radius: 16px;

  margin-bottom: 20px;

}


.course-icon {

  width: 52px;

  height: 52px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 14px;

  background: #0d6efd;

  color: white;

  font-size: 22px;

  flex-shrink: 0;

}


.course-info {

  min-width: 0;

}


.course-label {

  font-size: 11px;

  font-weight: 700;

  letter-spacing: 1px;

  color: #6b7280;

}


.course-info h3 {

  margin: 3px 0;

  font-size: 18px;

  font-weight: 700;

  color: #172033;

  word-break: break-word;

}


.course-info p {

  margin: 0;

  color: #6b7280;

  font-size: 13px;

}


.course-info p i {

  color: #0d6efd;

  margin-right: 4px;

}


/* =========================================================
   PRICE
========================================================= */

.price-section {

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 20px 0;

  border-bottom:
    1px solid #e5e7eb;

  margin-bottom: 20px;

}


.price-section span {

  font-size: 15px;

  color: #6b7280;

}


.price-section strong {

  font-size: 30px;

  font-weight: 800;

  color: #198754;

}


/* =========================================================
   SECURITY
========================================================= */

.security-box {

  display: flex;

  align-items: flex-start;

  gap: 12px;

  padding: 14px 16px;

  border-radius: 12px;

  background: #f0fdf4;

  border:
    1px solid #d1fae5;

  margin-bottom: 22px;

}


.security-box > i {

  color: #198754;

  font-size: 22px;

  margin-top: 2px;

}


.security-box strong {

  display: block;

  color: #166534;

  font-size: 14px;

}


.security-box p {

  margin: 3px 0 0;

  color: #4b5563;

  font-size: 12px;

  line-height: 1.5;

}


/* =========================================================
   PAY BUTTON
========================================================= */

.pay-button {

  width: 100%;

  min-height: 56px;

  border: none;

  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      #198754,
      #157347
    );

  color: #ffffff;

  font-size: 16px;

  font-weight: 700;

  cursor: pointer;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 10px;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    opacity 0.2s ease;

  box-shadow:
    0 8px 20px
    rgba(25, 135, 84, 0.22);

}


.pay-button:hover {

  transform:
    translateY(-2px);

  box-shadow:
    0 12px 25px
    rgba(25, 135, 84, 0.28);

}


.pay-button:active {

  transform:
    translateY(0);

}


.pay-button:disabled {

  cursor: wait;

}


.pay-button.loading {

  opacity: 0.75;

  cursor: wait;

  transform: none;

}


/* =========================================================
   SPINNER
========================================================= */

.bi-arrow-repeat {

  display: inline-block;

  animation:
    payment-spin 1s linear infinite;

}


@keyframes payment-spin {

  from {

    transform:
      rotate(0deg);

  }

  to {

    transform:
      rotate(360deg);

  }

}


/* =========================================================
   CANCEL
========================================================= */

.cancel-button {

  width: 100%;

  margin-top: 12px;

  min-height: 48px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  border-radius: 12px;

  color: #6b7280;

  text-decoration: none;

  font-size: 14px;

  font-weight: 600;

  transition:
    0.2s ease;

}


.cancel-button:hover {

  color: #172033;

  background: #f8fafc;

}


/* =========================================================
   FOOTER
========================================================= */

.payment-footer {

  margin-top: 22px;

  padding-top: 18px;

  border-top:
    1px solid #edf0f5;

  text-align: center;

  color: #9ca3af;

  font-size: 12px;

}


.payment-footer i {

  margin-right: 5px;

  color: #198754;

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 576px) {

  .payment-page {

    padding:
      20px 12px;

    align-items:
      flex-start;

  }


  .payment-card {

    margin-top: 20px;

    padding:
      22px 18px;

    border-radius:
      18px;

  }


  .payment-header h2 {

    font-size:
      20px;

  }


  .payment-header {

    margin-bottom:
      22px;

  }


  .payment-icon {

    width:
      50px;

    height:
      50px;

    font-size:
      21px;

  }


  .course-section {

    padding:
      14px;

  }


  .course-icon {

    width:
      46px;

    height:
      46px;

    font-size:
      19px;

  }


  .course-info h3 {

    font-size:
      16px;

  }


  .price-section strong {

    font-size:
      25px;

  }

}

</style>