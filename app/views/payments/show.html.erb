<div class="payment-page">

  <div class="payment-wrapper">

    <!-- =====================================================
         BACK TO COURSE
    ====================================================== -->

    <%= link_to course_details_path(@course),
          class: "payment-back-link" do %>

      <i class="bi bi-arrow-left"></i>

      Back to Course

    <% end %>


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="payment-page-header">

      <h1>
        Payment
      </h1>

      <p>
        Complete your payment to access the course
      </p>

    </div>


    <!-- =====================================================
         COURSE SUMMARY
    ====================================================== -->

    <div class="payment-course-card">

      <div class="payment-course-icon">

        <i class="bi bi-book-fill"></i>

      </div>


      <div class="payment-course-info">

        <span class="payment-course-label">
          COURSE
        </span>

        <h2>
          <%= @course.Course_name %>
        </h2>

        <p>
          <i class="bi bi-person-fill"></i>

          <%= @course.teacher&.name || current_user.name %>
        </p>


        <div class="payment-course-meta">

          <span>
            <i class="bi bi-play-circle"></i>
            Course Access
          </span>

          <span>
            <i class="bi bi-patch-check"></i>
            Certificate
          </span>

        </div>

      </div>


      <!-- CURRENT AMOUNT -->

      <div class="payment-course-price">

        <span>
          Total
        </span>

        <strong>
          ₹<%= number_with_delimiter(
                @payable_amount.to_i
              ) %>
        </strong>

      </div>

    </div>



    <!-- =====================================================
         ORDER SUMMARY
    ====================================================== -->

    <div class="payment-section">

      <div class="payment-section-title">

        <i class="bi bi-receipt"></i>

        <h3>
          Order Summary
        </h3>

      </div>


      <div class="order-row">

        <span>
          Course Price
        </span>

        <strong>
          ₹<%= number_with_delimiter(
                @total_fee.to_i
              ) %>
        </strong>

      </div>


      <% if @discount_amount.to_d > 0 %>

        <div class="order-row discount-row">

          <span>
            Discount
          </span>

          <strong>
            - ₹<%= number_with_delimiter(
                    @discount_amount.to_i
                  ) %>
          </strong>

        </div>

      <% end %>


      <div class="order-divider"></div>


      <div class="order-row total-row">

        <span>
          Total Amount
        </span>

        <strong>
          ₹<%= number_with_delimiter(
                @payable_amount.to_i
              ) %>
        </strong>

      </div>

    </div>



    <!-- =====================================================
         PAYMENT METHOD
    ====================================================== -->

    <div class="payment-section">

      <div class="payment-section-title">

        <i class="bi bi-credit-card"></i>

        <h3>
          Choose Payment Method
        </h3>

      </div>


      <!-- UPI -->

      <div class="payment-method active">

        <div class="method-icon upi-icon">

          <i class="bi bi-phone"></i>

        </div>

        <div class="method-content">

          <strong>
            UPI
          </strong>

          <span>
            Google Pay, PhonePe, Paytm, etc.
          </span>

        </div>

        <i class="bi bi-check-circle-fill method-check"></i>

      </div>


      <!-- CARD -->

      <div class="payment-method">

        <div class="method-icon">

          <i class="bi bi-credit-card"></i>

        </div>

        <div class="method-content">

          <strong>
            Credit / Debit Card
          </strong>

        </div>

        <i class="bi bi-circle method-radio"></i>

      </div>


      <!-- NET BANKING -->

      <div class="payment-method">

        <div class="method-icon">

          <i class="bi bi-bank"></i>

        </div>

        <div class="method-content">

          <strong>
            Net Banking
          </strong>

        </div>

        <i class="bi bi-circle method-radio"></i>

      </div>


      <!-- WALLET -->

      <div class="payment-method">

        <div class="method-icon">

          <i class="bi bi-wallet2"></i>

        </div>

        <div class="method-content">

          <strong>
            Wallet
          </strong>

          <span>
            Paytm, Mobikwik, etc.
          </span>

        </div>

        <i class="bi bi-circle method-radio"></i>

      </div>

    </div>



    <!-- =====================================================
         SECURITY
    ====================================================== -->

    <div class="payment-security">

      <div class="security-icon">

        <i class="bi bi-lock-fill"></i>

      </div>

      <div>

        <strong>
          Your payment is 100% secure
        </strong>

        <p>
          We use industry-standard encryption to keep
          your information safe.
        </p>

      </div>

    </div>



    <!-- =====================================================
         PAYMENT BUTTON
    ====================================================== -->

    <% if @payment.present? %>

      <button
        type="button"
        id="pay-button"
        class="pay-button">

        <span id="pay-icon">

          <i class="bi bi-credit-card-fill"></i>

        </span>

        <span id="pay-text">

          Pay Now
          ₹<%= number_with_delimiter(
                @payment.amount.to_i
              ) %>

        </span>

      </button>


    <% else %>

      <%= form_with url: create_payment_path(@enrollment),
                    method: :post,
                    local: true,
                    id: "create-payment-form" do %>

        <button
          type="submit"
          class="pay-button"
          id="create-payment-button">

          <i class="bi bi-credit-card-fill"></i>

          Continue to Payment

          <span>
            ₹<%= number_with_delimiter(
                  @payable_amount.to_i
                ) %>
          </span>

        </button>

      <% end %>

    <% end %>



    <!-- =====================================================
         TERMS
    ====================================================== -->

    <p class="payment-terms">

      By proceeding, you agree to our
      <a href="#">
        Terms & Conditions
      </a>
      and
      <a href="#">
        Privacy Policy
      </a>.

    </p>



    <!-- =====================================================
         BENEFITS
    ====================================================== -->

    <div class="payment-benefits">

      <div class="payment-benefit">

        <div class="benefit-icon">

          <i class="bi bi-play-circle-fill"></i>

        </div>

        <strong>
          Lifetime Access
        </strong>

        <span>
          Learn at your own pace
        </span>

      </div>


      <div class="payment-benefit">

        <div class="benefit-icon">

          <i class="bi bi-award-fill"></i>

        </div>

        <strong>
          Certificate
        </strong>

        <span>
          Get verified certificate
        </span>

      </div>


      <div class="payment-benefit">

        <div class="benefit-icon">

          <i class="bi bi-headset"></i>

        </div>

        <strong>
          24/7 Support
        </strong>

        <span>
          We're here to help
        </span>

      </div>

    </div>

  </div>

</div>



<!-- =========================================================
     RAZORPAY CHECKOUT
========================================================= -->

<% if @payment.present? %>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

 <script nonce="<%= content_security_policy_nonce %>">

  document.addEventListener("DOMContentLoaded", function () {

      const payButton =
        document.getElementById("pay-button");

      if (!payButton) return;


      if (payButton.dataset.initialized === "true") {
        return;
      }

      payButton.dataset.initialized = "true";


      payButton.addEventListener("click", function () {

        payButton.disabled = true;

        payButton.classList.add("loading");


        const options = {

          key: "<%= ENV.fetch("RAZORPAY_KEY_ID") %>",

          amount: <%= @payment.amount.to_d * 100 %>,

          currency: "INR",

          name: "A One GS Center",

          description:
            "<%= j @course.Course_name %>",

          order_id:
            "<%= @payment.razorpay_order_id %>",


          prefill: {

            name:
              "<%= j current_user.name.to_s %>",

            email:
              "<%= j current_user.email.to_s %>"

          },


          theme: {

            color: "#1261d8"

          },


          handler: function (response) {

            const form =
              document.createElement("form");

            form.method = "POST";

            form.action =
              "<%= verify_payment_path(@enrollment) %>";


            const csrf =
              document.querySelector(
                'meta[name="csrf-token"]'
              );


            function addField(name, value) {

              const input =
                document.createElement("input");

              input.type = "hidden";

              input.name = name;

              input.value = value;

              form.appendChild(input);

            }


            addField(
              "authenticity_token",
              csrf ? csrf.content : ""
            );


            addField(
              "razorpay_payment_id",
              response.razorpay_payment_id
            );


            addField(
              "razorpay_order_id",
              response.razorpay_order_id
            );


            addField(
              "razorpay_signature",
              response.razorpay_signature
            );


            document.body.appendChild(form);

            form.submit();

          },


          modal: {

            ondismiss: function () {

              payButton.disabled = false;

              payButton.classList.remove("loading");

            }

          }

        };


        const razorpay =
          new Razorpay(options);


        razorpay.on(
          "payment.failed",
          function () {

            window.location.href =
              "<%= payment_failed_path(@enrollment) %>";

          }
        );


        razorpay.open();

      });

    });

  </script>

<% end %>



<style nonce="<%= content_security_policy_nonce %>">

/* =========================================================
   PAYMENT PAGE
========================================================= */

.payment-page {

  min-height: 100vh;

  padding: 30px 20px 50px;

  background:
    linear-gradient(
      135deg,
      #f4f7fb,
      #eef3ff
    );

  font-family:
    "Poppins",
    Arial,
    sans-serif;
    padding-top: 100px;

}


/* =========================================================
   WRAPPER
========================================================= */

.payment-wrapper {

  width: 100%;

  max-width: 850px;

  margin: 0 auto;

}


/* =========================================================
   BACK
========================================================= */

.payment-back-link {

  display: inline-flex;

  align-items: center;

  gap: 7px;

  margin-bottom: 12px;

  color: #1261d8;

  text-decoration: none;

  font-size: 13px;

  font-weight: 600;

}

.payment-back-link:hover {

  color: #0b4fac;

}


/* =========================================================
   HEADER
========================================================= */

.payment-page-header {

  margin-bottom: 20px;

}

.payment-page-header h1 {

  margin: 0;

  font-size: 28px;

  font-weight: 800;

  color: #172033;

}

.payment-page-header p {

  margin: 4px 0 0;

  color: #6b7280;

  font-size: 14px;

}


/* =========================================================
   COURSE CARD
========================================================= */

.payment-course-card {

  display: grid;

  grid-template-columns:
    115px
    minmax(0, 1fr)
    auto;

  align-items: center;

  gap: 18px;

  padding: 18px;

  background: #ffffff;

  border: 1px solid #e4eaf2;

  border-radius: 12px;

  box-shadow:
    0 5px 18px rgba(15, 23, 42, .05);

  margin-bottom: 16px;

}


/* =========================================================
   COURSE ICON
========================================================= */

.payment-course-icon {

  width: 115px;

  height: 100px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 8px;

  background:
    linear-gradient(
      135deg,
      #1261d8,
      #174a91
    );

  color: #ffffff;

  font-size: 42px;

}


/* =========================================================
   COURSE INFO
========================================================= */

.payment-course-info {

  min-width: 0;

}

.payment-course-label {

  display: block;

  margin-bottom: 4px;

  color: #64748b;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: 1px;

}

.payment-course-info h2 {

  margin: 0;

  color: #172033;

  font-size: 19px;

  font-weight: 800;

  line-height: 1.3;

}

.payment-course-info p {

  margin: 6px 0;

  color: #64748b;

  font-size: 13px;

}

.payment-course-info p i {

  margin-right: 4px;

  color: #1261d8;

}


/* =========================================================
   COURSE META
========================================================= */

.payment-course-meta {

  display: flex;

  flex-wrap: wrap;

  gap: 15px;

  margin-top: 10px;

}

.payment-course-meta span {

  display: inline-flex;

  align-items: center;

  gap: 5px;

  color: #64748b;

  font-size: 11px;

}

.payment-course-meta i {

  color: #1261d8;

}


/* =========================================================
   COURSE PRICE
========================================================= */

.payment-course-price {

  min-width: 110px;

  text-align: right;

}

.payment-course-price span {

  display: block;

  color: #64748b;

  font-size: 11px;

}

.payment-course-price strong {

  display: block;

  margin-top: 3px;

  color: #172033;

  font-size: 25px;

  font-weight: 800;

}


/* =========================================================
   PAYMENT SECTION
========================================================= */

.payment-section {

  background: #ffffff;

  border: 1px solid #e4eaf2;

  border-radius: 12px;

  padding: 18px;

  margin-bottom: 16px;

  box-shadow:
    0 5px 18px rgba(15, 23, 42, .04);

}


/* =========================================================
   SECTION TITLE
========================================================= */

.payment-section-title {

  display: flex;

  align-items: center;

  gap: 9px;

  margin-bottom: 15px;

}

.payment-section-title > i {

  color: #1261d8;

  font-size: 18px;

}

.payment-section-title h3 {

  margin: 0;

  color: #172033;

  font-size: 16px;

  font-weight: 800;

}


/* =========================================================
   ORDER SUMMARY
========================================================= */

.order-row {

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 7px 0;

  color: #64748b;

  font-size: 14px;

}

.order-row strong {

  color: #334155;

}

.discount-row strong {

  color: #198754;

}

.order-divider {

  height: 1px;

  background: #e5e7eb;

  margin: 7px 0;

}

.total-row {

  padding-top: 11px;

  color: #172033;

  font-size: 15px;

  font-weight: 700;

}

.total-row strong {

  color: #172033;

  font-size: 21px;

}


/* =========================================================
   PAYMENT METHOD
========================================================= */

.payment-method {

  min-height: 55px;

  display: flex;

  align-items: center;

  gap: 12px;

  padding: 9px 12px;

  margin-bottom: 8px;

  border: 1px solid #e5eaf1;

  border-radius: 9px;

  background: #ffffff;

}

.payment-method:last-child {

  margin-bottom: 0;

}

.payment-method.active {

  border-color: #b7d2f8;

  background: #f7fbff;

}


/* =========================================================
   METHOD ICON
========================================================= */

.method-icon {

  width: 38px;

  height: 38px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 8px;

  background: #edf5ff;

  color: #1261d8;

  font-size: 19px;

}

.upi-icon {

  background: #eefbf4;

  color: #198754;

}


/* =========================================================
   METHOD CONTENT
========================================================= */

.method-content {

  flex: 1;

  min-width: 0;

}

.method-content strong {

  display: block;

  color: #334155;

  font-size: 13px;

}

.method-content span {

  display: block;

  margin-top: 2px;

  color: #64748b;

  font-size: 11px;

}


/* =========================================================
   METHOD CHECK
========================================================= */

.method-check {

  color: #1261d8;

  font-size: 18px;

}

.method-radio {

  color: #cbd5e1;

  font-size: 17px;

}


/* =========================================================
   SECURITY
========================================================= */

.payment-security {

  display: flex;

  align-items: center;

  gap: 12px;

  padding: 12px 14px;

  margin-bottom: 14px;

  border: 1px solid #cfe3fb;

  border-radius: 9px;

  background: #edf6ff;

}

.security-icon {

  width: 38px;

  height: 38px;

  flex-shrink: 0;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 8px;

  background: #dcecff;

  color: #1261d8;

  font-size: 18px;

}

.payment-security strong {

  display: block;

  color: #14529b;

  font-size: 13px;

}

.payment-security p {

  margin: 2px 0 0;

  color: #64748b;

  font-size: 11px;

}


/* =========================================================
   PAY BUTTON
========================================================= */

.pay-button {

  width: 100%;

  min-height: 50px;

  border: 0;

  border-radius: 8px;

  background:
    linear-gradient(
      135deg,
      #1261d8,
      #0754c7
    );

  color: #ffffff;

  font-size: 15px;

  font-weight: 700;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  cursor: pointer;

  box-shadow:
    0 7px 18px rgba(18, 97, 216, .20);

  transition: .2s ease;

}

.pay-button:hover {

  transform: translateY(-1px);

  box-shadow:
    0 10px 22px rgba(18, 97, 216, .27);

}

.pay-button:disabled {

  cursor: wait;

}

.pay-button.loading {

  opacity: .7;

  transform: none;

}


/* =========================================================
   TERMS
========================================================= */

.payment-terms {

  margin: 10px 0 18px;

  text-align: center;

  color: #94a3b8;

  font-size: 10px;

  line-height: 1.5;

}

.payment-terms a {

  color: #1261d8;

}


/* =========================================================
   BENEFITS
========================================================= */

.payment-benefits {

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  background: #ffffff;

  border: 1px solid #e4eaf2;

  border-radius: 10px;

  overflow: hidden;

}


.payment-benefit {

  min-height: 100px;

  padding: 15px 10px;

  text-align: center;

  border-right: 1px solid #edf0f5;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

}

.payment-benefit:last-child {

  border-right: 0;

}


.benefit-icon {

  margin-bottom: 6px;

  color: #1261d8;

  font-size: 23px;

}

.payment-benefit strong {

  color: #334155;

  font-size: 12px;

}

.payment-benefit span {

  margin-top: 3px;

  color: #94a3b8;

  font-size: 10px;

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

  .payment-page {

    padding: 20px 12px 35px;

  }


  .payment-course-card {

    grid-template-columns: 75px minmax(0, 1fr);

    gap: 12px;

  }


  .payment-course-icon {

    width: 75px;

    height: 75px;

    font-size: 28px;

  }


  .payment-course-price {

    grid-column: 2;

    text-align: left;

    min-width: 0;

    margin-top: -5px;

  }


  .payment-course-price strong {

    font-size: 22px;

  }


  .payment-page-header h1 {

    font-size: 24px;

  }


  .payment-section {

    padding: 15px;

  }

}


@media (max-width: 500px) {

  .payment-benefits {

    grid-template-columns: 1fr;

  }


  .payment-benefit {

    min-height: 75px;

    border-right: 0;

    border-bottom: 1px solid #edf0f5;

  }


  .payment-benefit:last-child {

    border-bottom: 0;

  }


  .payment-course-meta {

    flex-direction: column;

    gap: 5px;

  }

}

</style>