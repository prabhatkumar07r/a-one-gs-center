<div class="payment-page">

  <div class="payment-wrapper">

    <!-- =====================================================
         PAYMENT CARD
    ====================================================== -->

    <div class="payment-card">

      <!-- ===================================================
           HEADER
      ==================================================== -->

      <div class="payment-header">

        <div class="payment-icon">
          <i class="bi bi-shield-lock-fill"></i>
        </div>

        <div>

          <h2>
            Complete Your Payment
          </h2>

          <p>
            Secure your enrollment
          </p>

        </div>

      </div>


      <!-- ===================================================
           COURSE INFORMATION
      ==================================================== -->

      <div class="course-section">

        <div class="course-icon">
          <i class="bi bi-book-fill"></i>
        </div>

        <div class="course-info">

          <span class="course-label">
            COURSE
          </span>

          <h3>
            <%= @course.Course_name %>
          </h3>

          <p>

            <i class="bi bi-person-fill"></i>

            <%= @enrollment.user.name %>

          </p>

        </div>

      </div>


      <!-- ===================================================
           PRICE
      ==================================================== -->

      <div class="price-section">

        <span>
          Total Course Fee
        </span>

        <strong>

          ₹<%= number_with_precision(
                @course.fee,
                precision: 2
              ) %>

        </strong>

      </div>


      <!-- ===================================================
           SECURITY
      ==================================================== -->

      <div class="security-box">

        <i class="bi bi-shield-check"></i>

        <div>

          <strong>
            Secure Payment
          </strong>

          <p>
            Your payment is securely processed by Razorpay.
          </p>

        </div>

      </div>


      <!-- ===================================================
           PAYMENT BUTTON
      ==================================================== -->

      <% if @order_id.present? %>

        <button
          type="button"
          class="pay-button"
          id="pay-button">

          <span id="pay-icon">
            <i class="bi bi-credit-card-fill"></i>
          </span>

          <span id="pay-text">

            Pay ₹<%= number_with_precision(
                      @course.fee,
                      precision: 2
                    ) %> Securely

          </span>

        </button>

      <% else %>

        <%= form_with
              url: payment_path(@enrollment),
              method: :post,
              local: true,
              id: "payment-form" do %>

          <button
            type="submit"
            class="pay-button"
            id="create-order-button">

            <span>

              <i class="bi bi-credit-card-fill"></i>

            </span>

            <span>

              Continue to Payment

            </span>

          </button>

        <% end %>

      <% end %>


      <!-- ===================================================
           CANCEL
      ==================================================== -->

      <%= link_to course_details_path(@course),
            class: "cancel-button" do %>

        <i class="bi bi-arrow-left"></i>

        Back to Course

      <% end %>


      <!-- ===================================================
           FOOTER
      ==================================================== -->

      <div class="payment-footer">

        <i class="bi bi-lock-fill"></i>

        Secure & encrypted payment

      </div>

    </div>

  </div>

</div>


<!-- =========================================================
     RAZORPAY CHECKOUT
========================================================= -->

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>


<script>

document.addEventListener(
  "DOMContentLoaded",
  function () {


    /* ======================================================
       ELEMENTS
    ====================================================== */

    const form =
      document.getElementById(
        "payment-form"
      );


    const button =
      document.getElementById(
        "pay-button"
      );


    const createOrderButton =
      document.getElementById(
        "create-order-button"
      );


    const icon =
      document.getElementById(
        "pay-icon"
      );


    const text =
      document.getElementById(
        "pay-text"
      );


    /* ======================================================
       CREATE ORDER FORM
    ====================================================== */

    if (form) {

      form.addEventListener(
        "submit",
        function () {

          if (createOrderButton) {

            createOrderButton.disabled =
              true;

            createOrderButton.innerHTML =
              '<i class="bi bi-arrow-repeat"></i> Creating Secure Payment...';

          }

        }
      );

    }


    /* ======================================================
       RAZORPAY ORDER ID
    ====================================================== */

    const razorpayOrderId =
      "<%= j @order_id.to_s %>";


    /*
      No order yet.

      Rails will create the order first.
    */

    if (!razorpayOrderId) {

      return;

    }


    /* ======================================================
       RAZORPAY KEY
    ====================================================== */

    const razorpayKey =
      "<%= j ENV["RAZORPAY_KEY_ID"].to_s %>";


    if (!razorpayKey) {

      console.error(
        "RAZORPAY_KEY_ID is missing."
      );

      if (button) {

        button.disabled =
          false;

      }

      alert(
        "Razorpay configuration is missing. Please contact support."
      );

      return;

    }


    /* ======================================================
       PAYMENT AMOUNT
    ====================================================== */

    const amount =
      <%= (@payment&.amount || @course.fee).to_d * 100 %>;


    /* ======================================================
       RAZORPAY OPTIONS
    ====================================================== */

    const options = {

      key:
        razorpayKey,


      amount:
        Math.round(amount),


      currency:
        "INR",


      name:
        "A ONE GS CENTER",


      description:
        "<%= j @course.Course_name.to_s %>",


      order_id:
        razorpayOrderId,


      /* ====================================================
         PREFILL
      ==================================================== */

      prefill: {

        name:
          "<%= j @enrollment.user.name.to_s %>",

        email:
          "<%= j @enrollment.user.email.to_s %>",

        contact:
          "<%= j @enrollment.user.mobile.to_s %>"

      },


      /* ====================================================
         PAYMENT METHOD CONFIGURATION
      ==================================================== */

      config: {

        display: {

          blocks: {

            upi_block: {

              name:
                "Pay via UPI",

              instruments: [

                {
                  method: "upi"
                }

              ]

            },

            other_block: {

              name:
                "Other Payment Methods",

              instruments: [

                {
                  method: "card"
                },

                {
                  method: "netbanking"
                },

                {
                  method: "wallet"
                }

              ]

            }

          },


          sequence: [

            "block.upi_block",

            "block.other_block"

          ],


          preferences: {

            show_default_blocks:
              false

          }

        }

      },


      /* ====================================================
         THEME
      ==================================================== */

      theme: {

        color:
          "#198754"

      },


      /* ====================================================
         PAYMENT SUCCESS
      ==================================================== */

      handler:
        function (response) {

          console.log(
            "Razorpay payment response:",
            response
          );


          if (button) {

            button.disabled =
              true;

            button.classList.add(
              "loading"
            );

          }


          if (icon) {

            icon.innerHTML =
              '<i class="bi bi-arrow-repeat"></i>';

          }


          if (text) {

            text.textContent =
              "Verifying Payment...";

          }


          /* ================================================
             VERIFY URL
          ================================================= */

          const verifyUrl =
            "<%= verify_payment_path(@enrollment) %>";


          /* ================================================
             CSRF TOKEN
          ================================================= */

          const csrfElement =
            document.querySelector(
              'meta[name="csrf-token"]'
            );


          const csrfToken =
            csrfElement
              ? csrfElement.content
              : "";


          /* ================================================
             VERIFY PAYMENT
          ================================================= */

          fetch(

            verifyUrl,

            {

              method:
                "POST",


              headers: {

                "Content-Type":
                  "application/json",

                "X-CSRF-Token":
                  csrfToken,

                "Accept":
                  "text/html"

              },


              body:
                JSON.stringify({

                  razorpay_payment_id:
                    response.razorpay_payment_id,

                  razorpay_order_id:
                    response.razorpay_order_id,

                  razorpay_signature:
                    response.razorpay_signature

                })

            }

          )

          .then(
            function (response) {

              if (
                response.redirected
              ) {

                window.location.href =
                  response.url;

                return null;

              }

              return response.text();

            }
          )

          .then(
            function (html) {

              if (html) {

                document.open();

                document.write(html);

                document.close();

              }

            }
          )

          .catch(
            function (error) {

              console.error(
                "Payment verification error:",
                error
              );


              if (button) {

                button.disabled =
                  false;

                button.classList.remove(
                  "loading"
                );

              }


              if (icon) {

                icon.innerHTML =
                  '<i class="bi bi-exclamation-circle-fill"></i>';

              }


              if (text) {

                text.textContent =
                  "Verification Failed - Try Again";

              }


              alert(
                "Unable to verify payment. Please contact support."
              );

            }
          );

        },


      /* ====================================================
         CHECKOUT CLOSED
      ==================================================== */

      modal: {

        ondismiss:
          function () {

            if (button) {

              button.disabled =
                false;

              button.classList.remove(
                "loading"
              );

            }


            if (icon) {

              icon.innerHTML =
                '<i class="bi bi-credit-card-fill"></i>';

            }


            if (text) {

              text.textContent =
                "Pay ₹<%= number_with_precision(
                          @course.fee,
                          precision: 2
                        ) %> Securely";

            }

          }

      }

    };


    /* ======================================================
       CHECK RAZORPAY SCRIPT
    ====================================================== */

    if (
      typeof Razorpay ===
      "undefined"
    ) {

      console.error(
        "Razorpay Checkout script was not loaded."
      );


      if (button) {

        button.disabled =
          false;

      }


      alert(
        "Razorpay Checkout could not be loaded. Please refresh and try again."
      );


      return;

    }


    /* ======================================================
       CREATE RAZORPAY INSTANCE
    ====================================================== */

    const razorpay =
      new Razorpay(
        options
      );


    /* ======================================================
       PAYMENT FAILURE
    ====================================================== */

    razorpay.on(
      "payment.failed",
      function (response) {

        console.error(
          "Razorpay payment failed:",
          response.error
        );


        window.location.href =
          "<%= payment_failed_path(@enrollment) %>";

      }
    );


    /* ======================================================
       OPEN CHECKOUT
    ====================================================== */

    if (button) {

      button.addEventListener(
        "click",
        function () {

          button.disabled =
            true;

          button.classList.add(
            "loading"
          );


          if (icon) {

            icon.innerHTML =
              '<i class="bi bi-arrow-repeat"></i>';

          }


          if (text) {

            text.textContent =
              "Opening Secure Checkout...";

          }


          try {

            razorpay.open();

          }

          catch (error) {

            console.error(
              "Razorpay Checkout Error:",
              error
            );


            button.disabled =
              false;

            button.classList.remove(
              "loading"
            );


            if (icon) {

              icon.innerHTML =
                '<i class="bi bi-credit-card-fill"></i>';

            }


            if (text) {

              text.textContent =
                "Pay ₹<%= number_with_precision(
                          @course.fee,
                          precision: 2
                        ) %> Securely";

            }


            alert(
              "Unable to open Razorpay Checkout. Please try again."
            );

          }

        }
      );

    }

  }
);

</script>