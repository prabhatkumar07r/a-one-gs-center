<div class="payment-page">

  <div class="payment-wrapper">

    <div class="payment-card">

      <!-- HEADER -->
      <div class="payment-header">

        <div class="payment-icon">
          <i class="bi bi-shield-lock-fill"></i>
        </div>

        <div>
          <h2>Complete Your Payment</h2>
          <p>Secure your enrollment</p>
        </div>

      </div>


      <!-- COURSE -->
      <div class="course-section">

        <div class="course-icon">
          <i class="bi bi-book-fill"></i>
        </div>

        <div class="course-info">

          <span class="course-label">
            COURSE
          </span>

          <h3>
            <%= @course.Course_name %>
          </h3>

          <p>
            <i class="bi bi-person-fill"></i>
            <%= current_user.name %>
          </p>

        </div>

      </div>


      <!-- PRICE -->
      <div class="price-section">

        <span>Total Course Fee</span>

        <strong>
          ₹<%= number_with_precision(
                @course.fee,
                precision: 2
              ) %>
        </strong>

      </div>


      <!-- SECURITY -->
      <div class="security-box">

        <i class="bi bi-shield-check"></i>

        <div>

          <strong>Secure Payment</strong>

          <p>
            Your payment is securely processed by Razorpay.
          </p>

        </div>

      </div>


      <!-- PAYMENT BUTTON -->

      <% if @payment.present? %>

        <button
          type="button"
          id="pay-button"
          class="pay-button">

          <span id="pay-icon">
            <i class="bi bi-credit-card-fill"></i>
          </span>

          <span id="pay-text">
            Pay ₹<%= number_with_precision(@course.fee, precision: 2) %> Securely
          </span>

        </button>

      <% else %>

        <%= form_with url: create_payment_path(@enrollment),
                      method: :post,
                      local: true,
                      id: "create-payment-form" do %>

          <button
            type="submit"
            class="pay-button"
            id="create-payment-button">

            <i class="bi bi-credit-card-fill"></i>

            Continue to Payment

          </button>

        <% end %>

      <% end %>


      <!-- CANCEL -->

      <%= link_to course_details_path(@course),
            class: "cancel-button" do %>

        <i class="bi bi-arrow-left"></i>

        Back to Course

      <% end %>


      <!-- FOOTER -->

      <div class="payment-footer">

        <i class="bi bi-lock-fill"></i>

        Secure & encrypted payment

      </div>

    </div>

  </div>

</div>


<!-- =========================================================
     RAZORPAY CHECKOUT
========================================================= -->

<% if @payment.present? %>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <script>

    document.addEventListener("DOMContentLoaded", function () {

      const payButton =
        document.getElementById("pay-button");

      if (!payButton) return;


      payButton.addEventListener("click", function () {

        payButton.disabled = true;

        payButton.classList.add("loading");


        const options = {

          key: "<%= ENV.fetch("RAZORPAY_KEY_ID") %>",

          amount: <%= @payment.amount %>,

          currency: "INR",

          name: "A One GS Center",

          description:
            "<%= j @course.Course_name %>",

          order_id:
            "<%= @payment.razorpay_order_id %>",


          prefill: {

            name:
              "<%= j current_user.name.to_s %>",

            email:
              "<%= j current_user.email.to_s %>"

          },


          theme: {

            color: "#198754"

          },


          handler: function (response) {

            /*
             * Send Razorpay response to Rails
             * for server-side signature verification.
             */

            const form =
              document.createElement("form");

            form.method = "POST";

            form.action =
              "<%= verify_payment_path(@enrollment) %>";


            const csrf =
              document.querySelector(
                'meta[name="csrf-token"]'
              );


            function addField(name, value) {

              const input =
                document.createElement("input");

              input.type = "hidden";

              input.name = name;

              input.value = value;

              form.appendChild(input);

            }


            addField(
              "authenticity_token",
              csrf ? csrf.content : ""
            );


            addField(
              "razorpay_payment_id",
              response.razorpay_payment_id
            );


            addField(
              "razorpay_order_id",
              response.razorpay_order_id
            );


            addField(
              "razorpay_signature",
              response.razorpay_signature
            );


            document.body.appendChild(form);

            form.submit();

          },


          modal: {

            ondismiss: function () {

              payButton.disabled = false;

              payButton.classList.remove("loading");

            }

          }

        };


        const razorpay =
          new Razorpay(options);


        razorpay.on(
          "payment.failed",
          function () {

            window.location.href =
              "<%= payment_failed_path(@enrollment) %>";

          }
        );


        razorpay.open();

      });

    });

  </script>

<% end %>


<style>

/* =========================================================
   PAYMENT PAGE
========================================================= */

.payment-page {

  min-height: 100vh;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 40px 20px;

  background:
    linear-gradient(
      135deg,
      #f4f7fb,
      #eef3ff
    );

  font-family:
    "Poppins",
    Arial,
    sans-serif;

}


/* =========================================================
   WRAPPER
========================================================= */

.payment-wrapper {

  width: 100%;

  max-width: 560px;

}


/* =========================================================
   CARD
========================================================= */

.payment-card {

  background: #ffffff;

  border-radius: 22px;

  padding: 32px;

  border: 1px solid #e8edf5;

  box-shadow:
    0 15px 45px
    rgba(15, 23, 42, 0.12);

}


/* =========================================================
   HEADER
========================================================= */

.payment-header {

  display: flex;

  align-items: center;

  gap: 16px;

  margin-bottom: 28px;

}


.payment-icon {

  width: 58px;

  height: 58px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 16px;

  background: #e8f1ff;

  color: #0d6efd;

  font-size: 25px;

}


.payment-header h2 {

  margin: 0;

  font-size: 24px;

  font-weight: 700;

  color: #172033;

}


.payment-header p {

  margin: 4px 0 0;

  color: #6b7280;

  font-size: 14px;

}


/* =========================================================
   COURSE
========================================================= */

.course-section {

  display: flex;

  align-items: center;

  gap: 15px;

  padding: 18px;

  background: #f8fafc;

  border: 1px solid #edf0f5;

  border-radius: 16px;

  margin-bottom: 20px;

}


.course-icon {

  width: 52px;

  height: 52px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 14px;

  background: #0d6efd;

  color: white;

  font-size: 22px;

}


.course-info {

  min-width: 0;

}


.course-label {

  font-size: 11px;

  font-weight: 700;

  letter-spacing: 1px;

  color: #6b7280;

}


.course-info h3 {

  margin: 3px 0;

  font-size: 18px;

  font-weight: 700;

  color: #172033;

  word-break: break-word;

}


.course-info p {

  margin: 0;

  color: #6b7280;

  font-size: 13px;

}


/* =========================================================
   PRICE
========================================================= */

.price-section {

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 20px 0;

  border-bottom: 1px solid #e5e7eb;

  margin-bottom: 20px;

}


.price-section span {

  color: #6b7280;

  font-size: 15px;

}


.price-section strong {

  color: #198754;

  font-size: 30px;

  font-weight: 800;

}


/* =========================================================
   SECURITY
========================================================= */

.security-box {

  display: flex;

  align-items: flex-start;

  gap: 12px;

  padding: 14px 16px;

  border-radius: 12px;

  background: #f0fdf4;

  border: 1px solid #d1fae5;

  margin-bottom: 22px;

}


.security-box > i {

  color: #198754;

  font-size: 22px;

}


.security-box strong {

  display: block;

  color: #166534;

  font-size: 14px;

}


.security-box p {

  margin: 3px 0 0;

  color: #4b5563;

  font-size: 12px;

}


/* =========================================================
   PAYMENT BUTTON
========================================================= */

.pay-button {

  width: 100%;

  min-height: 56px;

  border: none;

  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      #198754,
      #157347
    );

  color: #ffffff;

  font-size: 16px;

  font-weight: 700;

  cursor: pointer;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 10px;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    opacity 0.2s ease;

  box-shadow:
    0 8px 20px
    rgba(25, 135, 84, 0.22);

}


.pay-button:hover {

  transform: translateY(-2px);

  box-shadow:
    0 12px 25px
    rgba(25, 135, 84, 0.28);

}


.pay-button:active {

  transform: translateY(0);

}


.pay-button:disabled {

  cursor: wait;

}


.pay-button.loading {

  opacity: 0.75;

  transform: none;

}


/* =========================================================
   CANCEL
========================================================= */

.cancel-button {

  width: 100%;

  margin-top: 12px;

  min-height: 48px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  border-radius: 12px;

  color: #6b7280;

  text-decoration: none;

  font-size: 14px;

  font-weight: 600;

}


.cancel-button:hover {

  color: #172033;

  background: #f8fafc;

}


/* =========================================================
   FOOTER
========================================================= */

.payment-footer {

  margin-top: 22px;

  padding-top: 18px;

  border-top: 1px solid #edf0f5;

  text-align: center;

  color: #9ca3af;

  font-size: 12px;

}


.payment-footer i {

  color: #198754;

  margin-right: 5px;

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 576px) {

  .payment-page {

    padding: 20px 12px;

    align-items: flex-start;

  }


  .payment-card {

    margin-top: 20px;

    padding: 22px 18px;

    border-radius: 18px;

  }


  .payment-header h2 {

    font-size: 20px;

  }


  .payment-icon {

    width: 50px;

    height: 50px;

    font-size: 21px;

  }


  .course-section {

    padding: 14px;

  }


  .course-icon {

    width: 46px;

    height: 46px;

    font-size: 19px;

  }


  .course-info h3 {

    font-size: 16px;

  }


  .price-section strong {

    font-size: 25px;

  }

}

</style>