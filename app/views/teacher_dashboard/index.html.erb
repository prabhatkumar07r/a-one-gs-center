<div class="container-fluid">

  <!-- Heading -->

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>

      <h2 class="fw-bold">
        Teacher Dashboard
      </h2>

      <p class="text-muted mb-0">
        Welcome,
        <strong><%= current_user.name.presence || current_user.email %></strong>
      </p>

    </div>

    <div>

      <%= link_to courses_path,
          class: "btn btn-primary" do %>

        <i class="bi bi-book-fill"></i>

        Manage Courses

      <% end %>

    </div>

  </div>

  <!-- Statistics -->

  <div class="row g-4">

    <div class="col-lg-3 col-md-6">

      <div class="card shadow border-0 bg-primary text-white">

        <div class="card-body d-flex justify-content-between">

          <div>

            <h6>Total Courses</h6>

            <h2><%= @courses_count %></h2>

          </div>

          <i class="bi bi-book-fill display-4"></i>

        </div>

      </div>

    </div>

    <div class="col-lg-3 col-md-6">

      <div class="card shadow border-0 bg-success text-white">

        <div class="card-body d-flex justify-content-between">

          <div>

            <h6>Total Students</h6>

            <h2><%= @students %></h2>

          </div>

          <i class="bi bi-mortarboard-fill display-4"></i>

        </div>

      </div>

    </div>

    <div class="col-lg-3 col-md-6">

      <div class="card shadow border-0 bg-warning">

        <div class="card-body d-flex justify-content-between">

          <div>

            <h6>Total Videos</h6>

            <h2><%= @videos %></h2>

          </div>

          <i class="bi bi-play-circle-fill display-4"></i>

        </div>

      </div>

    </div>

    <div class="col-lg-3 col-md-6">

      <div class="card shadow border-0 bg-info text-white">

        <div class="card-body d-flex justify-content-between">

          <div>

            <h6>Total Playlists</h6>

            <h2><%= @playlists %></h2>

          </div>

          <i class="bi bi-collection-play-fill display-4"></i>

        </div>

      </div>

    </div>

  </div>

  <!-- Quick Actions -->

  <div class="card shadow mt-4">

    <div class="card-header bg-white">

      <h5 class="mb-0">

        Quick Actions

      </h5>

    </div>

    <div class="card-body">

      <div class="row g-3">

        <div class="col-md-4">

          <%= link_to new_course_path,
              class:"btn btn-primary w-100 py-3" do %>

            <i class="bi bi-plus-circle-fill"></i><br>

            Add Course

          <% end %>

        </div>

        <div class="col-md-4">

          <%= link_to students_path,
              class:"btn btn-success w-100 py-3" do %>

            <i class="bi bi-people-fill"></i><br>

            View Students

          <% end %>

        </div>

        <div class="col-md-4">

          <%= link_to notes_path,
              class:"btn btn-warning w-100 py-3" do %>

            <i class="bi bi-journal-bookmark-fill"></i><br>

            Notes

          <% end %>

        </div>

      </div>

    </div>

  </div>

  <!-- Latest Courses -->

  <div class="card shadow mt-4">

    <div class="card-header bg-primary text-white">

      Latest Courses

    </div>

    <div class="table-responsive">

      <table class="table table-hover mb-0">

        <thead>

          <tr>

            <th>Course</th>

            <th>Fee</th>

            <th>Duration</th>

            <th>Status</th>

          </tr>

        </thead>

        <tbody>

          <% @courses.limit(5).each do |course| %>

            <tr>

              <td><%= course.Course_name %></td>

              <td>₹ <%= course.fee %></td>

              <td><%= course.duration %></td>

              <td>

                <span class="badge bg-success">

                  <%= course.status %>

                </span>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>

</div>