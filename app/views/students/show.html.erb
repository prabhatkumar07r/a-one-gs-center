<div class="container py-4">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>
      <h2 class="fw-bold text-primary">
        <i class="fas fa-user-graduate"></i>
        Student Profile
      </h2>

      <p class="text-muted">
        Complete student information
      </p>
    </div>

    <%= link_to students_path, class: "btn btn-secondary" do %>
      <i class="fas fa-arrow-left"></i>
      Back
    <% end %>

  </div>


  <div class="row">

    <!-- Profile Image -->
    <div class="col-lg-4">

      <div class="card shadow border-0">

        <div class="card-body text-center">

          <% if @student.image.attached? %>

            <%= image_tag @student.image,
                class: "rounded-circle border shadow",
                width: 150,
                height: 150 %>

          <% else %>

            <img src="https://ui-avatars.com/api/?name=<%= @student.name %>&size=150&background=0D6EFD&color=fff"
                 class="rounded-circle shadow">

          <% end %>


          <h3 class="mt-3">
            <%= @student.name %>
          </h3>


          <span class="badge bg-success fs-6">
            <%= @student.role&.capitalize || "Student" %>
          </span>


        </div>

      </div>

    </div>



    <!-- Student Information -->
    <div class="col-lg-8">

      <div class="card shadow border-0">


        <div class="card-header bg-primary text-white">

          <h5 class="mb-0">
            Student Information
          </h5>

        </div>


        <div class="card-body">


          <table class="table table-bordered">


            <tr>
              <th width="220">
                Student ID
              </th>

              <td>
                <%= @student.id %>
              </td>
            </tr>


            <tr>
              <th>
                Full Name
              </th>

              <td>
                <%= @student.name %>
              </td>
            </tr>



            <tr>
              <th>
                Email
              </th>

              <td>
                <%= @student.email %>
              </td>
            </tr>



            <% if @student.respond_to?(:mobile) %>

            <tr>
              <th>
                Mobile
              </th>

              <td>
                <%= @student.mobile %>
              </td>
            </tr>

            <% end %>



            <% if @student.respond_to?(:gender) %>

            <tr>
              <th>
                Gender
              </th>

              <td>
                <%= @student.gender %>
              </td>
            </tr>

            <% end %>



            <tr>
              <th>
                Role
              </th>

              <td>

                <span class="badge bg-success">
                  <%= @student.role %>
                </span>

              </td>

            </tr>



            <tr>
              <th>
                Registered On
              </th>

              <td>
                <%= @student.created_at.strftime("%d %B %Y") %>
              </td>

            </tr>



            <tr>

              <th>
                Last Updated
              </th>

              <td>
                <%= @student.updated_at.strftime("%d %B %Y") %>
              </td>

            </tr>


          </table>


        </div>


      </div>


    </div>


  </div>




  <!-- Enrolled Courses -->

  <div class="card shadow border-0 mt-4">


    <div class="card-header bg-success text-white">

      <h5 class="mb-0">
        Enrolled Courses
      </h5>

    </div>



    <div class="card-body">


      <% if @student.respond_to?(:enrollments) && @student.enrollments.any? %>


        <table class="table table-hover">


          <thead>

            <tr>
              <th>
                Course
              </th>

              <th>
                Status
              </th>

            </tr>

          </thead>



          <tbody>


            <% @student.enrollments.each do |enrollment| %>


              <tr>


                <td>

                  <%= enrollment.course.Course_name %>

                </td>



                <td>

                  <% if enrollment.status == "Approved" %>

                    <span class="badge bg-success">
                      Approved
                    </span>


                  <% elsif enrollment.status == "Pending" %>

                    <span class="badge bg-warning text-dark">
                      Pending
                    </span>


                  <% else %>

                    <span class="badge bg-danger">
                      <%= enrollment.status %>
                    </span>


                  <% end %>


                </td>


              </tr>


            <% end %>


          </tbody>


        </table>


      <% else %>


        <div class="text-center py-4">


          <i class="fas fa-book fa-3x text-muted mb-3"></i>


          <h5>
            No Courses Enrolled
          </h5>


        </div>


      <% end %>


    </div>


  </div>



</div>